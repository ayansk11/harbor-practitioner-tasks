+"""Activity features over trailing windows (orders, spend, tickets) and simple time‑since features.
+
+The original implementation aggregated events per calendar day and then used a closed="both"
+rolling window.  That unintentionally included events that occurred **after** the prediction
+timestamp on the same day, violating the strict‑before rule described in `FEATURES.md`.
+
+The new implementation works directly with timestamps and uses `pd.merge_asof` to obtain
+cumulative counts/sums strictly before each `as_of`.  For a window `[t‑W, t)` we compute:
+
+```
+count(t) = cum_count(t‑) - cum_count(t‑W‑)
+```
+
+where `cum_count(t‑)` is the cumulative count of events with timestamp < t.  This approach
+guarantees that events at exactly `t` are excluded and that only information available
+strictly before the prediction is used.
+"""
+
+import numpy as np
+import pandas as pd
+
+
+def _cumulative(events, ts_col, amount_col=None):
+    """Return a DataFrame with cumulative count and (optional) cumulative sum per customer.
+
+    The returned DataFrame is sorted by ``customer_id`` and the timestamp column and contains
+    the original timestamp column, plus ``cum_cnt`` and optionally ``cum_sum``.
+    """
+    ev = events[["customer_id", ts_col]].copy()
+    ev = ev.sort_values(["customer_id", ts_col])
+    ev["cum_cnt"] = ev.groupby("customer_id").cumcount() + 1
+    if amount_col:
+        ev["cum_sum"] = events.loc[ev.index, amount_col].groupby(events["customer_id"]).cumsum()
+    return ev
+
