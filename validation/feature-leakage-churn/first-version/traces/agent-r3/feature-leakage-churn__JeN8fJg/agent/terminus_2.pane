[?2004l[?2004h> 
[?2004l[?2004h> def activity_features(points, orders, tickets):
[?2004l[?2004h>     """Return a DataFrame containing all activity‑related features.
[?2004l[?2004h> 
[?2004l[?2004h>     Columns produced:
[?2004l[?2004h>         - orders_7d
[?2004l[?2004h>         - orders_30d
[?2004l[?2004h>         - spend_30d_cents
[?2004l[?2004h>         - tickets_30d
[?2004l[?2004h>         - days_since_last_order (strictly before the prediction)
[?2004l[?2004h>     """
[?2004l[?2004h>     out = points[["customer_id", "as_of"]].copy()
[?2004l[?2004h> 
[?2004l[?2004h>     # orders_7d (window = 7 days)
[?2004l[?2004h>     out["orders_7d"], _ = _window_counts(points, orders, "ordered_at", days=7)
[?2004l[?2004h>     # orders_30d and spend_30d_cents (window = 30 days)
[?2004l[?2004h>     out["orders_30d"], out["spend_30d_cents"] = _window_counts(
[?2004l[?2004h>         points, orders, "ordered_at", amount_col="amount_cents", days=30
[?2004l[?2004h> +    )
[?2004l[?2004h> +    # tickets_30d (window = 30 days)
[?2004l[?2004h> +    out["tickets_30d"], _ = _window_counts(points, tickets, "opened_at", days=30)
[?2004l[?2004h> +
[?2004l[?2004h> +    # days_since_last_order – strictly before as_of
[?2004l[?2004h> +    orders_sorted = orders.sort_values("ordered_at")[["customer_id", "ordered_at"]]
[?2004l[?2004h> +    left = out[["customer_id", "as_of"]].reset_index().sort_values("as_of")
[?2004l[?2004h> +    last = pd.merge_asof(
[?2004l[?2004h> +        left,
[?2004l[?2004h> +        orders_sorted,
[?2004l[?2004h> +        left_on="as_of",
[?2004l[?2004h> +        right_on="ordered_at",
[?2004l[?2004h> +        by="customer_id",
[?2004l[?2004h> +        allow_exact_matches=False,
[?2004l[?2004h> +    ).set_index("index").sort_index()["ordered_at"]
[?2004l[?2004h> +    out["days_since_last_order"] = (out["as_of"] - last).dt.total_seconds() / 86400
[?2004l[?2004h> +
[?2004l[?2004h> +    return out
[?2004l[?2004h> PY
[?2004l[?2004hroot@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# cat > churn/status.py <<'PY'
[?2004l[?2004h> """Account status from the billing system's status snapshots.
[?2004l[?2004h> 
[?2004l[?2004h> The specification requires using the latest snapshot whose ``snapshot_date`` is strictly
[?2004l[?2004h> before the *date* of the prediction (`as_of`).  The previous implementation ignored `as_of`
[?2004l[?2004h> and always returned the globally most recent snapshot, causing leakage.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def latest_status(points, snapshots):
[?2004l[?2004h>     """Return a Series of the most recent status before the prediction date.
[?2004l[?2004h> 
[?2004l[?2004h>     Parameters
[?2004l[?2004h>     ----------
[?2004l[?2004h>     points : DataFrame with ``customer_id`` and ``as_of``.
[?2004l[?2004h>     snapshots : DataFrame with ``customer_id``, ``snapshot_date`` (UTC datetime) and ``status``.
[?2004l[?2004h>     """
[?2004l[?2004h>     # Ensure snapshots are sorted for merge_asof
[?2004l[?2004h>     snaps = snapshots.sort_values(["customer_id", "snapshot_date"])
[?2004l[?2004h>     pts = points[["customer_id", "as_of"]].copy()
[?2004l[?2004h>     pts["pred_date"] = pts["as_of"].dt.floor("D")  # snapshot_date represents end of day D
[?2004l[?2004h>     merged = pd.merge_asof(
[?2004l[?2004h> +        pts.sort_values(["customer_id", "pred_date"]),
[?2004l[?2004h> +        snaps,
[?2004l[?2004h> +        left_on="pred_date",
[?2004l[?2004h> +        right_on="snapshot_date",
[?2004l[?2004h> +        by="customer_id",
[?2004l[?2004h> +        direction="backward",
[?2004l[?2004h> +        allow_exact_matches=False,
[?2004l[?2004h> +    )
[?2004l[?2004h> +    return merged["status"]
[?2004l[?2004h> PY
[?2004l[?2004hroot@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# cat > churn/impute.py <<'PY'
[?2004l[?2004h> """Gap filling for upstream readings.
[?2004l[?2004h> 
[?2004l[?2004h> The original implementation performed a backward‑fill followed by a forward‑fill, which
[?2004l[?2004h> could leak future `app_minutes_7d` values into earlier predictions.  The corrected version
[?2004l[?2004h> only forward‑fills within each customer, ensuring that a missing value is replaced by the
[?2004l[?2004h> most recent *earlier* reading (or remains NaN if none exists).
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def fill_app_minutes(points):
[?2004l[?2004h>     """Forward‑fill missing `app_minutes_7d` per customer.
[?2004l[?2004h> 
[?2004l[?2004h>     Returns a Series aligned with the original `points` DataFrame.
[?2004l[?2004h>     """
[?2004l[?2004h>     pts = points.sort_values(["customer_id", "as_of"])
[?2004l[?2004h>     filled = pts.groupby("customer_id")["app_minutes_7d"].transform(lambda s: s.ffill())
[?2004l[?2004h>     return filled.reindex(points.index)
[?2004l[?2004h> PY
[?2004l[?2004hroot@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# cat > churn/encoding.py <<'PY'
[?2004l[?2004h> """Target encoding of high‑cardinality categoricals.
[?2004l[?2004h> 
[?2004l[?2004h> `te_district` must be computed using only label rows whose `label_available_at` is strictly
[?2004l[?2004h> before the prediction's `as_of`.  The original code ignored this timing constraint, causing
[?2004l[?2004h> leakage.  The implementation below builds cumulative sums/counts per district and a global
[?2004l[?2004h> cumulative prior, then merges the latest cumulative statistics that are available before each
[?2004l[?2004h> prediction.  The smoothed encoding follows:
[?2004l[?2004h> 
[?2004l[?2004h>     te = (s + m * p) / (n + m)
[?2004l[?2004h> 
[?2004l[?2004h> where `s` and `n` are the district‑specific cumulative sum and count, `p` is the global
[?2004l[?2004h> prior mean (computed from the same set of available labels), and `m` is the prior weight.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> PRIOR_WEIGHT = 20
[?2004l[?2004h> DEFAULT_PRIOR = 0.05
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):
[?2004l[?2004h>     """Compute the district target encoding respecting label availability.
[?2004l[?2004h> 
[?2004l[?2004h>     Parameters
[?2004l[?2004h>     ----------
[?2004l[?2004h>     points : DataFrame with ``customer_id`` and ``as_of``.
[?2004l[?2004h>     labels : DataFrame with ``customer_id``, ``churned_30d`` and ``label_available_at``.
[?2004l[?2004h>     customers : DataFrame with ``customer_id`` and ``postcode_district``.
[?2004l[?2004h>     m : int, optional
[?2004l[?2004h>         Prior weight (default 20).
[?2004l[?2004h>     """
[?2004l[?2004h>     # Map each customer to its district
[?2004l[?2004h>     district_map = customers.set_index("customer_id")["postcode_district"]
[?2004l[?2004h>     pts = points.copy()
[?2004l[?2004h>     pts["district"] = pts["customer_id"].map(district_map)
[?2004l[?2004h> 
[?2004l[?2004h>     # Attach district to label rows
[?2004l[?2004h>     lbl = labels.copy()
[?2004l[?2004h>     lbl["district"] = lbl["customer_id"].map(district_map)
[?2004l[?2004h>     lbl = lbl.dropna(subset=["district"]).sort_values("label_available_at")
[?2004l[?2004h> 
[?2004l[?2004h>     # Cumulative per‑district statistics
[?2004l[?2004h>     lbl["cum_sum"] = lbl.groupby("district")["churned_30d"].cumsum()
[?2004l[?2004h>     lbl["cum_cnt"] = lbl.groupby("district").cumcount() + 1
[?2004l[?2004h> 
[?2004l[?2004h>     # Global cumulative statistics for the prior mean
[?2004l[?2004h>     lbl["global_cum_sum"] = lbl["churned_30d"].cumsum()
[?2004l[?2004h>     lbl["global_cum_cnt"] = range(1, len(lbl) + 1)
[?2004l[?2004h> 
[?2004l[?2004h>     # Merge‑asof to get the latest cumulative stats before each as_of, per district
[?2004l[?2004h>     pts_sorted = pts.sort_values(["district", "as_of"]).reset_index()
[?2004l[?2004h>     merged = pd.merge_asof(
[?2004l[?2004h> +        pts_sorted,
[?2004l[?2004h> +        lbl,
[?2004l[?2004h> +        left_on="as_of",
[?2004l[?2004h> +        right_on="label_available_at",
[?2004l[?2004h> +        by="district",
[?2004l[?2004h> +        direction="backward",
[?2004l[?2004h> +        allow_exact_matches=False,
[?2004l[?2004h> +    )
[?2004l[?2004h> +
[?2004l[?2004h> +    # Prior mean p(t) based on all labels available before as_of
[?2004l[?2004h> +    prior = merged["global_cum_sum"] / merged["global_cum_cnt"]
[?2004l[?2004h> +    prior = prior.fillna(DEFAULT_PRIOR)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Smoothed encoding per district
[?2004l[?2004h> +    te = (merged["cum_sum"] + m * prior) / (merged["cum_cnt"] + m)
[?2004l[?2004h> +    te = te.fillna(prior)  # districts with no prior rows get the global prior
[?2004l[?2004h> +
[?2004l[?2004h> +    # Re‑index to original order of points
[?2004l[?2004h> +    result = pd.Series(te.values, index=pts_sorted["index"]).reindex(points.index)
[?2004l[?2004h> +    return result.astype("float64")
[?2004l[?2004h> PY
