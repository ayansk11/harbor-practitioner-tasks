[?2004l[?2004h> 
[?2004l[?2004h>     # Ensure points are sorted for deterministic processing
[?2004l[?2004h>     pts = points[['customer_id', 'as_of']].reset_index()
[?2004l[?2004h>     pts = pts.sort_values(['customer_id', 'as_of']).reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h>     for cid, grp in pts.groupby('customer_id'):
[?2004l[?2004h>         # Snapshots for this customer, sorted by snapshot_date
