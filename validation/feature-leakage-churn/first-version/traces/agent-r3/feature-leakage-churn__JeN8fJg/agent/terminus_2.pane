[?2004hroot@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# cat > churn/extract.py <<'PY'
[?2004l[?2004h> """Load a warehouse extract (the CSV layout described in FEATURES.md) into pandas frames with UTC timestamps.
[?2004l[?2004h> 
[?2004l[?2004h> This implementation strips any leading/trailing whitespace (including newlines) from column names to ensure
[?2004l[?2004h> that column names match the specification exactly (e.g., ``app_minutes_7d`` without a trailing newline).
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> TIMESTAMPS = {
[?2004l[?2004h>     "customers": ["signup_at"],
[?2004l[?2004h>     "scoring_points": ["as_of"],
[?2004l[?2004h>     "orders": ["ordered_at"],
[?2004l[?2004h>     "tickets": ["opened_at"],
[?2004l[?2004h>     "status_snapshots": ["snapshot_date"],
[?2004l[?2004h>     "labels": ["as_of", "label_available_at"],
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _clean_columns(df):
[?2004l[?2004h>     """Strip whitespace from column names of a DataFrame."""
[?2004l[?2004h>     df.columns = df.columns.str.strip()
[?2004l[?2004h>     return df
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_extract(data_dir):
[?2004l[?2004h>     tables = {}
[?2004l[?2004h>     for name, cols in TIMESTAMPS.items():
[?2004l[?2004h>         df = pd.read_csv(os.path.join(data_dir, f"{name}.csv"), dtype={"postcode_district": "str"})
[?2004l[?2004h>         df = _clean_columns(df)
[?2004l[?2004h>         for c in cols:
[?2004l[?2004h>             df[c] = pd.to_datetime(df[c], utc=True)
[?2004l[?2004h>         tables[name] = df
[?2004l[?2004h>     # Ensure app_minutes_7d column is numeric after cleaning column names
[?2004l[?2004h>     tables["scoring_points"]["app_minutes_7d"] = tables["scoring_points"]["app_minutes_7d"].astype("float64")
[?2004l[?2004h>     return tables
[?2004l[?2004h> PY
