[?2004hroot@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# cat > churn/build_features.py <<'PY'
[?2004l[?2004h> """Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>"""
[?2004l[?2004h> import argparse
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> from churn.encoding import district_encoding
[?2004l[?2004h> from churn.impute import fill_app_minutes
[?2004l[?2004h> from churn.extract import load_extract
[?2004l[?2004h> from churn.status import latest_status
[?2004l[?2004h> from churn.windows import activity_features, tenure_days
[?2004l[?2004h> 
[?2004l[?2004h> FEATURE_COLUMNS = ["orders_7d", "orders_30d", "spend_30d_cents", "tickets_30d", "days_since_last_order",
[?2004l[?2004h>                    "tenure_days", "status", "app_minutes_7d", "te_district"]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build(data_dir):
[?2004l[?2004h>     t = load_extract(data_dir)
[?2004l[?2004h>     points = t["scoring_points"].reset_index(drop=True)
[?2004l[?2004h>     feats = activity_features(points, t["orders"], t["tickets"])
[?2004l[?2004h>     feats["tenure_days"] = tenure_days(points, t["customers"])
[?2004l[?2004h>     feats["status"] = latest_status(points, t["status_snapshots"])
[?2004l[?2004h>     # Fill app minutes and ensure the column name is exactly 'app_minutes_7d'
[?2004l[?2004h>     filled = fill_app_minutes(points)
[?2004l[?2004h>     feats["app_minutes_7d"] = filled
[?2004l[?2004h>     feats["te_district"] = district_encoding(points, t["labels"], t["customers"])
[?2004l[?2004h>     return feats[["customer_id", "as_of"] + FEATURE_COLUMNS]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     ap = argparse.ArgumentParser(description=__doc__)
[?2004l[?2004h>     ap.add_argument("--data", required=True, help="folder with the extract CSVs")
[?2004l[?2004h>     ap.add_argument("--out", required=True, help="output parquet file")
[?2004l[?2004h>     a = ap.parse_args()
[?2004l[?2004h>     feats = build(a.data)
[?2004l[?2004h>     os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
[?2004l[?2004h>     feats.to_parquet(a.out, index=False)
[?2004l[?2004h>     print(f"wrote {len(feats)} rows x {feats.shape[1]} columns to {a.out}")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     main()
[?2004l[?2004h> PY
