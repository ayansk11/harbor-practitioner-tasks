    return out


def tenure_days(points, customers):
    """Return the number of days between `as_of` and the customer's signup date.

    This function is unchanged from the original implementation and is required by
    `build_features.py`.
    """
    signup = points["customer_id"].map(customers.set_index("customer_id")["signup_at"])
    return (points["as_of"] - signup).dt.total_seconds() / 86400
