[?2004hroot@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# cat > churn/encoding.py <<'PY'
[?2004l[?2004h> """Target encoding of high‑cardinality categoricals.
[?2004l[?2004h> 
[?2004l[?2004h> `te_district` must be computed using only label rows whose `label_available_at`
[?2004l[?2004h> is strictly before the prediction's `as_of`. The original implementation ignored this
[?2004l[?2004h> temporal constraint, causing leakage. This version uses per‑district binary search
[?2004l[?2004h> to respect the strict‑before rule and applies the smoothed mean formula:
[?2004l[?2004h> 
[?2004l[?2004h>     te = (s + m * p) / (n + m)
[?2004l[?2004h> 
[?2004l[?2004h> where `s` and `n` are the district‑specific cumulative sum and count, `p` is the
[?2004l[?2004h> global prior mean (computed from all labels available before `as_of`), and `m`
[?2004l[?2004h> is the prior weight.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> PRIOR_WEIGHT = 20
[?2004l[?2004h> DEFAULT_PRIOR = 0.05
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):
[?2004l[?2004h>     """Return the smoothed churn rate per postcode district respecting label availability.
[?2004l[?2004h> 
[?2004l[?2004h>     Parameters
[?2004l[?2004h>     ----------
[?2004l[?2004h>     points : DataFrame with ``customer_id`` and ``as_of``.
[?2004l[?2004h>     labels : DataFrame with ``customer_id``, ``churned_30d`` and ``label_available_at``.
[?2004l[?2004h>     customers : DataFrame with ``customer_id`` and ``postcode_district``.
[?2004l[?2004h>     m : int, optional
[?2004l[?2004h>         Prior weight (default 20).
[?2004l[?2004h>     """
[?2004l[?2004h>     # Map customers to districts
[?2004l[?2004h>     district_map = customers.set_index('customer_id')['postcode_district']
[?2004l[?2004h>     pts = points.copy()
[?2004l[?2004h>     pts['district'] = pts['customer_id'].map(district_map)
[?2004l[?2004h>     # Drop rows where district cannot be resolved (should be rare)
[?2004l[?2004h>     pts = pts.reset_index()
[?2004l[?2004h>     pts = pts.dropna(subset=['district'])
[?2004l[?2004h>     # Prepare result array
[?2004l[?2004h>     result = np.empty(len(pts), dtype=np.float64)
[?2004l[?2004h>     result[:] = np.nan
[?2004l[?2004h> 
[?2004l[?2004h>     # Global cumulative stats (all labels irrespective of district)
[?2004l[?2004h>     lbl_global = labels.sort_values('label_available_at')
[?2004l[?2004h>     global_times = lbl_global['label_available_at'].values.astype('datetime64[ns]')
[?2004l[?2004h>     global_cum_sum = np.cumsum(lbl_global['churned_30d'].values.astype(np.float64))
[?2004l[?2004h>     global_cum_cnt = np.arange(1, len(lbl_global) + 1)
[?2004l[?2004h> 
[?2004l[?2004h>     # Process each district separately
[?2004l[?2004h>     for district, grp in pts.groupby('district'):
[?2004l[?2004h>         # Labels for this district
[?2004l[?2004h>         lbl = labels[labels['customer_id'].map(district_map) == district].copy()
[?2004l[?2004h>         if lbl.empty:
[?2004l[?2004h>             # No labels for district: use global prior for all points in this district
[?2004l[?2004h>             # Compute prior per point using global cumulative up to as_of
[?2004l[?2004h>             as_of_vals = grp['as_of'].values.astype('datetime64[ns]')
[?2004l[?2004h>             idx_global = np.searchsorted(global_times, as_of_vals, side='right') - 1
[?2004l[?2004h>             prior = np.full(len(as_of_vals), DEFAULT_PRIOR, dtype=np.float64)
[?2004l[?2004h>             valid = idx_global >= 0
[?2004l[?2004h>             prior[valid] = global_cum_sum[idx_global[valid]] / global_cum_cnt[idx_global[valid]]
[?2004l[?2004h>             result[grp['index'].values] = prior  # no district info, use prior directly
[?2004l[?2004h>             continue
[?2004l[?2004h>         lbl = lbl.sort_values('label_available_at')
[?2004l[?2004h>         times = lbl['label_available_at'].values.astype('datetime64[ns]')
[?2004l[?2004h>         cum_sum = np.cumsum(lbl['churned_30d'].values.astype(np.float64))
[?2004l[?2004h>         cum_cnt = np.arange(1, len(lbl) + 1)
[?2004l[?2004h>         as_of_vals = grp['as_of'].values.astype('datetime64[ns]')
[?2004l[?2004h>         # Find last label_available_at < as_of for district
[?2004l[?2004h>         idx = np.searchsorted(times, as_of_vals, side='right') - 1
[?2004l[?2004h>         # Global prior for each point
[?2004l[?2004h>         idx_global = np.searchsorted(global_times, as_of_vals, side='right') - 1
[?2004l[?2004h>         prior = np.full(len(as_of_vals), DEFAULT_PRIOR, dtype=np.float64)
[?2004l[?2004h>         valid_global = idx_global >= 0
[?2004l[?2004h>         prior[valid_global] = global_cum_sum[idx_global[valid_global]] / global_cum_cnt[idx_global[valid_global]]
[?2004l[?2004h>         # Compute smoothed encoding where district label exists
[?2004l[?2004h>         te = np.empty(len(as_of_vals), dtype=np.float64)
[?2004l[?2004h>         te[:] = prior  # fallback to prior
[?2004l[?2004h>         valid = idx >= 0
[?2004l[?2004h>         if np.any(valid):
[?2004l[?2004h>             s = cum_sum[idx[valid]]
[?2004l[?2004h>             n = cum_cnt[idx[valid]]
[?2004l[?2004h>             te[valid] = (s + m * prior[valid]) / (n + m)
[?2004l[?2004h>         result[grp['index'].values] = te
[?2004l[?2004h> 
[?2004l[?2004h>     # Align with original ordering of points
[?2004l[?2004h>     final_series = pd.Series(result, index=pts['index']).reindex(points.index)
[?2004l[?2004h>     return final_series.astype('float64')
[?2004l[?2004h> PY
