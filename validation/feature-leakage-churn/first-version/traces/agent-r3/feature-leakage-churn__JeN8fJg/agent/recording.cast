[59.731757, "i", "apply_patch <<'PATCH'\n*** Begin Patch: churn/encoding.py\n@@\n-\"\"\"Target encoding of high-cardinality categoricals.\"\"\"\n-import pandas as pd\n-\n-PRIOR_WEIGHT = 20\n-DEFAULT_PRIOR = 0.05\n-\n-\n-def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\n-    \"\"\"Smoothed churn rate of the customer's postcode district.\"\"\"\n-    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\n-    lab = labels.assign(district=labels[\"customer_id\"].map(district))\n-    prior = lab[\"churned_30d\"].mean() if len(lab) else DEFAULT_PRIOR\n-    stats = lab.groupby(\"district\")[\"churned_30d\"].agg([\"sum\", \"count\"])\n-    te = (stats[\"sum\"] + m * prior) / (stats[\"count\"] + m)\n-    return points[\"customer_id\"].map(district).map(te).fillna(prior).astype(\"float64\")\n+\"\"\"Target encoding of high‑cardinality categoricals.\n+\n+The specification for ``te_district`` requires that, for a prediction at time ``t``, only label rows\n+with ``label_available_at < t`` are considered.  The original implementation ignored both ``as_of``\n+and ``l"]
[59.731885, "i", "abel_available_at``, using *all* labels regardless of availability, which introduces leakage.\n+\n+The revised implementation computes, for each district, the cumulative sum and count of ``churned_30d``\n+over label rows ordered by ``label_available_at``.  For each prediction we merge the most recent\n+cumulative statistics that are strictly before the prediction's ``as_of`` timestamp, then apply the\n+smoothed formula:\n+\n+```\n+te = (s + m * p) / (n + m)\n+```\n+\n+where ``p`` is the overall prior mean computed from the same set of *available* label rows (i.e.\n+those with ``label_available_at < t``).  If no label rows are available for a given ``t`` we fall back\n+to the constant ``DEFAULT_PRIOR``.\n+\"\"\"\n+\n+import pandas as pd\n+\n+PRIOR_WEIGHT = 20\n+DEFAULT_PRIOR = 0.05\n+\n+\n+def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\n+    \"\"\"Return the smoothed churn rate per postcode district respecting label availability.\n+\n+    Parameters\n+    ----------\n+    points : DataFrame\n+        Scoring points with ``cu"]
[59.731945, "i", "stomer_id`` and ``as_of``.\n+    labels : DataFrame\n+        Label rows containing ``customer_id``, ``churned_30d`` and ``label_available_at``.\n+    customers : DataFrame\n+        Customer master with ``customer_id`` and ``postcode_district``.\n+    m : int, optional\n+        Prior weight (default 20).\n+    \"\"\"\n+    # Map customers to districts\n+    district_map = customers.set_index(\"customer_id\")[\"postcode_district\"]\n+    points = points.copy()\n+    points[\"district\"] = points[\"customer_id\"].map(district_map)\n+\n+    # Prepare labels with district information\n+    lbl = labels.copy()\n+    lbl[\"district\"] = lbl[\"customer_id\"].map(district_map)\n+    # Drop rows where district could not be resolved (should be rare)\n+    lbl = lbl.dropna(subset=[\"district\"])\n+\n+    # Sort labels by the time they become available\n+    lbl = lbl.sort_values(\"label_available_at\")\n+\n+    # Cumulative stats per district\n+    lbl[\"cum_sum\"] = lbl.groupby(\"district\")[\"churned_30d\"].cumsum()\n+    lbl[\"cum_cnt\"] = lbl.groupby(\"district\").c"]
[59.731979, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[59.732016, "i", "umcount() + 1\n+\n+    # Global cumulative stats for the prior mean (based on availability time)\n+    lbl[\"global_cum_sum\"] = lbl[\"churned_30d\"].cumsum()\n+    lbl[\"global_cum_cnt\"] = range(1, len(lbl) + 1)\n+\n+    # Merge-asof per district to get the latest cumulative stats before each as_of\n+    pts_sorted = points.sort_values([\"district\", \"as_of\"]).reset_index()\n+    merged = pd.merge_asof(\n+        pts_sorted,\n+        lbl,\n+        left_on=\"as_of\",\n+        right_on=\"label_available_at\",\n+        by=\"district\",\n+        direction=\"backward\",\n+        allow_exact_matches=False,\n+    )\n+\n+    # Compute prior mean p(t) = global_cum_sum / global_cum_cnt, handling the case of no prior rows\n+    prior = merged[\"global_cum_sum\"] / merged[\"global_cum_cnt\"]\n+    prior = prior.fillna(DEFAULT_PRIOR)\n+\n+    # Per‑district smoothed encoding\n+    te = (merged[\"cum_sum\"] + m * prior) / (merged[\"cum_cnt\"] + m)\n+    te = te.fillna(prior)  # districts with no prior rows get the global prior\n+\n+    # Align back to original o"]
[59.732046, "o", "\u001b[?2004h> "]
[59.732056, "i", "rdering\n+    result = pd.Series(te.values, index=pts_sorted[\"index\"]).reindex(points.index)\n+    return result.astype(\"float64\")\n*** End Patch\nPATCH\n"]
[59.732161, "o", "*** Begin Patch: churn/encoding.py\r\n\u001b[?2004l\r"]
[59.732203, "o", "\u001b[?2004h"]
[59.73233, "o", "> @@\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.732552, "o", "-\"\"\"Target encoding of high-cardinality categoricals.\"\"\"\r\n\u001b[?2004l\r"]
[59.732606, "o", "\u001b[?2004h"]
[59.732626, "o", "> "]
[59.732683, "o", "-import pandas as pd\r\n\u001b[?2004l\r"]
[59.732722, "o", "\u001b[?2004h> "]
[59.732765, "o", "-\r\n\u001b[?2004l\r"]
[59.732795, "o", "\u001b[?2004h> "]
[59.732854, "o", "-PRIOR_WEIGHT = 20\r\n\u001b[?2004l\r"]
[59.73288, "o", "\u001b[?2004h"]
[59.732906, "o", "> "]
[59.732986, "o", "-DEFAULT_PRIOR = 0.05\r\n\u001b[?2004l\r"]
[59.733019, "o", "\u001b[?2004h"]
[59.733045, "o", "> -\r\n"]
[59.733067, "o", "\u001b[?2004l\r\u001b[?2004h"]
[59.733087, "o", "> -\r\n"]
[59.733108, "o", "\u001b[?2004l\r"]
[59.733133, "o", "\u001b[?2004h> "]
[59.733403, "o", "-def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n\u001b[?2004l\r"]
[59.733447, "o", "\u001b[?2004h> "]
[59.733717, "o", "-    \"\"\"Smoothed churn rate of the customer's postcode district.\"\"\"\r\n\u001b[?2004l\r"]
[59.733757, "o", "\u001b[?2004h> "]
[59.734047, "o", "-    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n"]
[59.734084, "o", "\u001b[?2004l\r"]
[59.734119, "o", "\u001b[?2004h> "]
[59.734406, "o", "-    lab = labels.assign(district=labels[\"customer_id\"].map(district))\r\n\u001b[?2004l\r"]
[59.734452, "o", "\u001b[?2004h> "]
[59.73474, "o", "-    prior = lab[\"churned_30d\"].mean() if len(lab) else DEFAULT_PRIOR\r\n\u001b[?2004l\r"]
[59.734784, "o", "\u001b[?2004h> "]
[59.735083, "o", "-    stats = lab.groupby(\"district\")[\"churned_30d\"].agg([\"sum\", \"count\"])\r\n\u001b[?2004l\r"]
[59.735124, "o", "\u001b[?2004h> "]
[59.735392, "o", "-    te = (stats[\"sum\"] + m * prior) / (stats[\"count\"] + m)\r\n\u001b[?2004l\r"]
[59.735423, "o", "\u001b[?2004h"]
[59.735442, "o", "> "]
[59.7358, "o", "-    return points[\"customer_id\"].map(district).map(te).fillna(prior).astype(\"float64\")\r\n\u001b[?2004l\r"]
[59.735826, "o", "\u001b[?2004h"]
[59.735844, "o", "> "]
[59.736076, "o", "+\"\"\"Target encoding of high‑cardinality categoricals.\r\n"]
[59.736099, "o", "\u001b[?2004l\r"]
[59.736126, "o", "\u001b[?2004h"]
[59.736145, "o", "> +\r\n\u001b[?2004l\r"]
[59.736165, "o", "\u001b[?2004h> "]
[59.736602, "o", "+The specification for ``te_district`` requires that, for a prediction at time ``t``, only label rows\r\n\u001b[?2004l\r"]
[59.736627, "o", "\u001b[?2004h"]
[59.736648, "o", "> "]
[59.737062, "o", "+with ``label_available_at < t`` are considered.  The original implementation ignored both ``as_of``\r\n\u001b[?2004l\r"]
[59.737086, "o", "\u001b[?2004h"]
[59.73711, "o", "> "]
[59.737554, "o", "+and ``label_available_at``, using *all* labels regardless of availability, which introduces leakage.\r\n\u001b[?2004l\r"]
[59.737579, "o", "\u001b[?2004h"]
[59.737599, "o", "> "]
[59.737619, "o", "+\r\n\u001b[?2004l\r"]
[59.737636, "o", "\u001b[?2004h"]
[59.737654, "o", "> "]
[59.738103, "o", "+The revised implementation computes, for each district, the cumulative sum and count of ``churned_30d``\r\n\u001b[?2004l\r"]
[59.73813, "o", "\u001b[?2004h"]
[59.738144, "o", "> "]
[59.738576, "o", "+over label rows ordered by ``label_available_at``.  For each prediction we merge the most recent\r\n\u001b[?2004l\r"]
[59.738609, "o", "\u001b[?2004h"]
[59.738632, "o", "> "]
[59.739044, "o", "+cumulative statistics that are strictly before the prediction's ``as_of`` timestamp, then apply the\r\n\u001b[?2004l\r"]
[59.739086, "o", "\u001b[?2004h> "]
[59.739163, "o", "+smoothed formula:\r\n\u001b[?2004l\r"]
[59.739187, "o", "\u001b[?2004h"]
[59.739204, "o", "> "]
[59.739223, "o", "+\r\n\u001b[?2004l\r"]
[59.739246, "o", "\u001b[?2004h"]
[59.739266, "o", "> "]
[59.739285, "o", "+```\r\n\u001b[?2004l\r"]
[59.739308, "o", "\u001b[?2004h"]
[59.739326, "o", "> "]
[59.739432, "o", "+te = (s + m * p) / (n + m)\r\n\u001b[?2004l\r"]
[59.739454, "o", "\u001b[?2004h"]
[59.739475, "o", "> "]
[59.739491, "o", "+```\r\n"]
[59.73951, "o", "\u001b[?2004l\r"]
[59.739529, "o", "\u001b[?2004h> "]
[59.739546, "o", "+\r\n\u001b[?2004l\r"]
[59.739565, "o", "\u001b[?2004h"]
[59.739582, "o", "> "]
[59.739992, "o", "+where ``p`` is the overall prior mean computed from the same set of *available* label rows (i.e.\r\n\u001b[?2004l\r"]
[59.740016, "o", "\u001b[?2004h"]
[59.740032, "o", "> "]
[59.740477, "o", "+those with ``label_available_at < t``).  If no label rows are available for a given ``t`` we fall back\r\n\u001b[?2004l\r"]
[59.740512, "o", "\u001b[?2004h"]
[59.740529, "o", "> "]
[59.740677, "o", "+to the constant ``DEFAULT_PRIOR``.\r\n\u001b[?2004l\r"]
[59.7407, "o", "\u001b[?2004h"]
[59.740716, "o", "> "]
[59.740736, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[59.74076, "o", "\u001b[?2004h"]
[59.740777, "o", "> "]
[59.740794, "o", "+\r\n\u001b[?2004l\r"]
[59.740811, "o", "\u001b[?2004h"]
[59.740827, "o", "> "]
[59.740914, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[59.740939, "o", "\u001b[?2004h"]
[59.740954, "o", "> "]
[59.740977, "o", "+\r\n\u001b[?2004l\r"]
[59.740991, "o", "\u001b[?2004h"]
[59.741007, "o", "> "]
[59.74109, "o", "+PRIOR_WEIGHT = 20\r\n\u001b[?2004l\r"]
[59.741116, "o", "\u001b[?2004h"]
[59.741132, "o", "> "]
[59.741231, "o", "+DEFAULT_PRIOR = 0.05\r\n\u001b[?2004l\r"]
[59.74133, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.741353, "o", "> "]
[59.74137, "o", "+\r\n\u001b[?2004l\r"]
[59.741388, "o", "\u001b[?2004h"]
[59.741405, "o", "> "]
[59.741694, "o", "+def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n\u001b[?2004l\r"]
[59.741718, "o", "\u001b[?2004h"]
[59.741733, "o", "> "]
[59.742111, "o", "+    \"\"\"Return the smoothed churn rate per postcode district respecting label availability.\r\n\u001b[?2004l\r"]
[59.742133, "o", "\u001b[?2004h"]
[59.742151, "o", "> "]
[59.742167, "o", "+\r\n\u001b[?2004l\r"]
[59.742187, "o", "\u001b[?2004h"]
[59.742201, "o", "> "]
[59.742267, "o", "+    Parameters\r\n\u001b[?2004l\r"]
[59.742283, "o", "\u001b[?2004h"]
[59.742299, "o", "> "]
[59.742364, "o", "+    ----------\r\n\u001b[?2004l\r"]
[59.742387, "o", "\u001b[?2004h"]
[59.742402, "o", "> "]
[59.742505, "o", "+    points : DataFrame\r\n\u001b[?2004l\r"]
[59.742544, "o", "\u001b[?2004h> "]
[59.742822, "o", "+        Scoring points with ``customer_id`` and ``as_of``.\r\n\u001b[?2004l\r"]
[59.742848, "o", "\u001b[?2004h"]
[59.742868, "o", "> "]
[59.742954, "o", "+    labels : DataFrame\r\n\u001b[?2004l\r"]
[59.742981, "o", "\u001b[?2004h"]
[59.742999, "o", "> "]
[59.743394, "o", "+        Label rows containing ``customer_id``, ``churned_30d`` and ``label_available_at``.\r\n\u001b[?2004l\r"]
[59.743422, "o", "\u001b[?2004h"]
[59.74344, "o", "> "]
[59.743559, "o", "+    customers : DataFrame\r\n\u001b[?2004l\r"]
[59.743585, "o", "\u001b[?2004h"]
[59.743603, "o", "> "]
[59.743897, "o", "+        Customer master with ``customer_id`` and ``postcode_district``.\r\n\u001b[?2004l\r"]
[59.743926, "o", "\u001b[?2004h"]
[59.743944, "o", "> "]
[59.744043, "o", "+    m : int, optional\r\n\u001b[?2004l\r"]
[59.744062, "o", "\u001b[?2004h"]
[59.744081, "o", "> "]
[59.744232, "o", "+        Prior weight (default 20).\r\n\u001b[?2004l\r"]
[59.744283, "o", "\u001b[?2004h> "]
[59.744327, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[59.744353, "o", "\u001b[?2004h> "]
[59.744503, "o", "+    # Map customers to districts\r\n\u001b[?2004l\r"]
[59.744527, "o", "\u001b[?2004h"]
[59.744548, "o", "> "]
[59.744862, "o", "+    district_map = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[59.744887, "o", "\u001b[?2004h"]
[59.744907, "o", "> "]
[59.745019, "o", "+    points = points.copy()\r\n\u001b[?2004l\r"]
[59.745044, "o", "\u001b[?2004h"]
[59.745062, "o", "> "]
[59.745344, "o", "+    points[\"district\"] = points[\"customer_id\"].map(district_map)\r\n\u001b[?2004l\r"]
[59.745365, "o", "\u001b[?2004h"]
[59.745385, "o", "> "]
[59.745407, "o", "+\r\n\u001b[?2004l\r"]
[59.745428, "o", "\u001b[?2004h"]
[59.745449, "o", "> "]
[59.745633, "o", "+    # Prepare labels with district information\r\n\u001b[?2004l\r"]
[59.745655, "o", "\u001b[?2004h"]
[59.745673, "o", "> "]
[59.745776, "o", "+    lbl = labels.copy()\r\n\u001b[?2004l\r"]
[59.7458, "o", "\u001b[?2004h"]
[59.745819, "o", "> "]
[59.746067, "o", "+    lbl[\"district\"] = lbl[\"customer_id\"].map(district_map)\r\n\u001b[?2004l\r"]
[59.746091, "o", "\u001b[?2004h"]
[59.746109, "o", "> "]
[59.746423, "o", "+    # Drop rows where district could not be resolved (should be rare)\r\n\u001b[?2004l\r"]
[59.746449, "o", "\u001b[?2004h"]
[59.746466, "o", "> "]
[59.746645, "o", "+    lbl = lbl.dropna(subset=[\"district\"])\r\n\u001b[?2004l\r"]
[59.74667, "o", "\u001b[?2004h"]
[59.746689, "o", "> "]
[59.746708, "o", "+\r\n\u001b[?2004l\r"]
[59.746729, "o", "\u001b[?2004h> "]
[59.746971, "o", "+    # Sort labels by the time they become available\r\n\u001b[?2004l\r"]
[59.746996, "o", "\u001b[?2004h"]
[59.747015, "o", "> "]
[59.747225, "o", "+    lbl = lbl.sort_values(\"label_available_at\")\r\n\u001b[?2004l\r"]
[59.747253, "o", "\u001b[?2004h"]
[59.747278, "o", "> "]
[59.747298, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.747317, "o", "> "]
[59.747468, "o", "+    # Cumulative stats per district\r\n\u001b[?2004l\r"]
[59.747495, "o", "\u001b[?2004h"]
[59.747513, "o", "> "]
[59.747828, "o", "+    lbl[\"cum_sum\"] = lbl.groupby(\"district\")[\"churned_30d\"].cumsum()\r\n\u001b[?2004l\r"]
[59.747851, "o", "\u001b[?2004h"]
[59.74787, "o", "> "]
[59.748116, "o", "+    lbl[\"cum_cnt\"] = lbl.groupby(\"district\").cumcount() + 1\r\n\u001b[?2004l\r"]
[59.748144, "o", "\u001b[?2004h"]
[59.748162, "o", "> "]
[59.748181, "o", "+\r\n\u001b[?2004l\r"]
[59.748199, "o", "\u001b[?2004h"]
[59.748216, "o", "> "]
[59.748567, "o", "+    # Global cumulative stats for the prior mean (based on availability time)\r\n\u001b[?2004l\r"]
[59.748595, "o", "\u001b[?2004h"]
[59.748614, "o", "> "]
[59.748855, "o", "+    lbl[\"global_cum_sum\"] = lbl[\"churned_30d\"].cumsum()\r\n\u001b[?2004l\r"]
[59.74888, "o", "\u001b[?2004h"]
[59.748898, "o", "> "]
[59.74913, "o", "+    lbl[\"global_cum_cnt\"] = range(1, len(lbl) + 1)\r\n\u001b[?2004l\r"]
[59.749154, "o", "\u001b[?2004h"]
[59.749171, "o", "> "]
[59.749191, "o", "+\r\n\u001b[?2004l\r"]
[59.749212, "o", "\u001b[?2004h> "]
[59.749578, "o", "+    # Merge-asof per district to get the latest cumulative stats before each as_of\r\n\u001b[?2004l\r"]
[59.749602, "o", "\u001b[?2004h"]
[59.749621, "o", "> "]
[59.749933, "o", "+    pts_sorted = points.sort_values([\"district\", \"as_of\"]).reset_index()\r\n\u001b[?2004l\r"]
[59.74996, "o", "\u001b[?2004h"]
[59.749978, "o", "> "]
[59.750097, "o", "+    merged = pd.merge_asof(\r\n\u001b[?2004l\r"]
[59.750122, "o", "\u001b[?2004h"]
[59.750176, "o", "> "]
[59.750224, "o", "+        pts_sorted,\r\n\u001b[?2004l\r"]
[59.7503, "o", "\u001b[?2004h> "]
[59.750344, "o", "+        lbl,\r\n\u001b[?2004l\r"]
[59.750354, "o", "\u001b[?2004h"]
[59.750384, "o", "> "]
[59.750476, "o", "+        left_on=\"as_of\",\r\n"]
[59.750484, "o", "\u001b[?2004l\r"]
[59.750523, "o", "\u001b[?2004h"]
[59.750531, "o", "> "]
[59.750684, "o", "+        right_on=\"label_available_at\",\r\n\u001b[?2004l\r"]
[59.750716, "o", "\u001b[?2004h"]
[59.750725, "o", "> "]
[59.750826, "o", "+        by=\"district\",\r\n\u001b[?2004l\r"]
[59.750858, "o", "\u001b[?2004h"]
[59.750881, "o", "> "]
[59.750998, "o", "+        direction=\"backward\",\r\n\u001b[?2004l\r"]
[59.75103, "o", "\u001b[?2004h"]
[59.751054, "o", "> "]
[59.75119, "o", "+        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[59.751228, "o", "\u001b[?2004h> "]
[59.751374, "o", "+    )\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.751827, "o", "+    # Compute prior mean p(t) = global_cum_sum / global_cum_cnt, handling the case of no prior rows\r\n\u001b[?2004l\r"]
[59.751861, "o", "\u001b[?2004h"]
[59.751869, "o", "> "]
[59.752135, "o", "+    prior = merged[\"global_cum_sum\"] / merged[\"global_cum_cnt\"]\r\n\u001b[?2004l\r"]
[59.752163, "o", "\u001b[?2004h"]
[59.752199, "o", "> "]
[59.752378, "o", "+    prior = prior.fillna(DEFAULT_PRIOR)\r\n\u001b[?2004l\r"]
[59.752405, "o", "\u001b[?2004h"]
[59.75242, "o", "> "]
[59.752465, "o", "+\r\n\u001b[?2004l\r"]
[59.752487, "o", "\u001b[?2004h> "]
[59.752644, "o", "+    # Per‑district smoothed encoding\r\n\u001b[?2004l\r"]
[59.752678, "o", "\u001b[?2004h> "]
[59.752983, "o", "+    te = (merged[\"cum_sum\"] + m * prior) / (merged[\"cum_cnt\"] + m)\r\n\u001b[?2004l\r"]
[59.753015, "o", "\u001b[?2004h"]
[59.753024, "o", "> "]
[59.75337, "o", "+    te = te.fillna(prior)  # districts with no prior rows get the global prior\r\n\u001b[?2004l\r"]
[59.753402, "o", "\u001b[?2004h"]
[59.753411, "o", "> "]
[59.753456, "o", "+\r\n\u001b[?2004l\r"]
[59.753465, "o", "\u001b[?2004h> "]
[59.753639, "o", "+    # Align back to original ordering\r\n\u001b[?2004l\r"]
[59.753666, "o", "\u001b[?2004h"]
[59.753704, "o", "> "]
[59.754046, "o", "+    result = pd.Series(te.values, index=pts_sorted[\"index\"]).reindex(points.index)\r\n\u001b[?2004l\r"]
[59.754074, "o", "\u001b[?2004h"]
[59.754109, "o", "> "]
[59.75427, "o", "+    return result.astype(\"float64\")\r\n\u001b[?2004l\r"]
[59.754303, "o", "\u001b[?2004h"]
[59.754312, "o", "> "]
