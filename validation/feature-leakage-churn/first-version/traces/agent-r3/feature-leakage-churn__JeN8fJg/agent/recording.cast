[263.159491, "o", "> "]
[263.159986, "o", "        snap_dates = snap['snapshot_date'].values.astype('datetime64[ns]')\r\n\u001b[?2004l\r"]
[263.160034, "o", "\u001b[?2004h"]
[263.160086, "o", "> "]
[263.160574, "o", "        # For each prediction, find the last snapshot_date < date(as_of)\r\n\u001b[?2004l\r"]
[263.160625, "o", "\u001b[?2004h"]
[263.160677, "o", "> "]
[263.161114, "o", "        as_of_dates = grp['as_of'].values.astype('datetime64[ns]')\r\n\u001b[?2004l\r"]
[263.161175, "o", "\u001b[?2004h"]
[263.161233, "o", "> "]
[263.161729, "o", "        # Convert to date (midnight) because snapshot_date marks end of day\r\n\u001b[?2004l\r"]
[263.161783, "o", "\u001b[?2004h"]
[263.161835, "o", "> "]
[263.162452, "o", "        pred_dates = np.floor(as_of_dates.astype('datetime64[D]')).astype('datetime64[ns]')\r\n\u001b[?2004l\r"]
[263.162505, "o", "\u001b[?2004h"]
[263.162562, "o", "> "]
[263.163023, "o", "        idx = np.searchsorted(snap_dates, pred_dates, side='right') - 1\r\n\u001b[?2004l\r"]
[263.163076, "o", "\u001b[?2004h"]
[263.163133, "o", "> "]
[263.163285, "o", "        valid = idx >= 0\r\n\u001b[?2004l\r"]
[263.163339, "o", "\u001b[?2004h"]
[263.163393, "o", "> "]
[263.163717, "o", "        statuses = np.empty(len(grp), dtype=object)\r\n\u001b[?2004l\r"]
[263.163779, "o", "\u001b[?2004h"]
[263.163834, "o", "> "]
[263.164005, "o", "        statuses[:] = np.nan\r\n\u001b[?2004l\r"]
[263.164059, "o", "\u001b[?2004h"]
[263.164112, "o", "> "]
[263.164521, "o", "        statuses[valid] = snap['status'].values[idx[valid]]\r\n\u001b[?2004l\r"]
[263.164575, "o", "\u001b[?2004h"]
[263.164632, "o", "> "]
[263.164965, "o", "        result.iloc[grp['index'].values] = statuses\r\n\u001b[?2004l\r"]
[263.16502, "o", "\u001b[?2004h"]
[263.165073, "o", "> "]
[263.165173, "o", "    return result\r\n\u001b[?2004l\r"]
[263.165225, "o", "\u001b[?2004h"]
[263.165271, "o", "> PY\r\n"]
[263.165335, "o", "\u001b[?2004l\r"]
