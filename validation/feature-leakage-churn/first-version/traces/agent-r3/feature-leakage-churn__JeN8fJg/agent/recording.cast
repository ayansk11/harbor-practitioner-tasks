[237.293218, "o", "> "]
[237.293774, "o", "            # Subtract cumulative at start-1 where start_pos > 0\r\n\u001b[?2004l\r"]
[237.29383, "o", "\u001b[?2004h"]
[237.293884, "o", "> "]
[237.294214, "o", "            start_nonzero = start_pos > 0\r\n\u001b[?2004l\r"]
[237.294275, "o", "\u001b[?2004h"]
[237.294328, "o", "> "]
[237.294984, "o", "            sum_vals[start_nonzero] -= cum_amount[start_pos[start_nonzero] - 1]\r\n\u001b[?2004l\r"]
[237.29505, "o", "\u001b[?2004h"]
[237.295105, "o", "> "]
[237.295446, "o", "            sum_res[idxs] = sum_vals\r\n\u001b[?2004l\r"]
[237.29552, "o", "\u001b[?2004h"]
[237.295573, "o", "> "]
[237.295629, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.295682, "o", "> "]
[237.296314, "o", "    count_series = pd.Series(count_res, index=points.index).astype('int64')\r\n\u001b[?2004l\r"]
[237.296369, "o", "\u001b[?2004h"]
[237.296418, "o", "> "]
[237.297219, "o", "    sum_series = pd.Series(sum_res, index=points.index).astype('int64') if amount_col else None\r\n\u001b[?2004l\r"]
[237.297308, "o", "\u001b[?2004h"]
[237.297379, "o", "> "]
[237.297626, "o", "    return count_series, sum_series\r\n\u001b[?2004l\r"]
[237.297683, "o", "\u001b[?2004h"]
[237.297736, "o", "> \r\n\u001b[?2004l\r"]
[237.297782, "o", "\u001b[?2004h"]
[237.297832, "o", "> \r\n\u001b[?2004l\r"]
[237.297893, "o", "\u001b[?2004h> "]
[237.298342, "o", "def activity_features(points, orders, tickets):\r\n"]
[237.298398, "o", "\u001b[?2004l\r"]
[237.298453, "o", "\u001b[?2004h"]
[237.298502, "o", "> "]
[237.29901, "o", "    \"\"\"Compute activity related features for each scoring point.\r\n\u001b[?2004l\r"]
[237.299062, "o", "\u001b[?2004h"]
[237.299118, "o", "> \r\n\u001b[?2004l\r"]
[237.299169, "o", "\u001b[?2004h> "]
[237.29945, "o", "    Returns a DataFrame with columns:\r\n\u001b[?2004l\r"]
[237.299498, "o", "\u001b[?2004h"]
[237.29955, "o", "> "]
[237.300084, "o", "        orders_7d, orders_30d, spend_30d_cents, tickets_30d, days_since_last_order\r\n\u001b[?2004l\r"]
[237.300142, "o", "\u001b[?2004h> "]
[237.300206, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[237.300269, "o", "\u001b[?2004h> "]
[237.300656, "o", "    out = points[['customer_id', 'as_of']].copy()\r\n\u001b[?2004l\r"]
[237.300716, "o", "\u001b[?2004h> "]
[237.300912, "o", "    # orders and spend windows\r\n\u001b[?2004l\r"]
[237.300952, "o", "\u001b[?2004h"]
[237.301003, "o", "> "]
[237.301538, "o", "    out['orders_7d'], _ = _window_counts(points, orders, 'ordered_at', days=7)\r\n\u001b[?2004l\r"]
[237.301596, "o", "\u001b[?2004h> "]
[237.302042, "o", "    out['orders_30d'], out['spend_30d_cents'] = _window_counts(\r\n\u001b[?2004l\r"]
[237.302087, "o", "\u001b[?2004h"]
[237.302189, "o", "> "]
[237.302639, "o", "        points, orders, 'ordered_at', amount_col='amount_cents', days=30)\r\n\u001b[?2004l\r"]
[237.302695, "o", "\u001b[?2004h> "]
[237.302848, "o", "    # tickets window\r\n\u001b[?2004l\r"]
[237.302891, "o", "\u001b[?2004h"]
[237.302945, "o", "> "]
[237.303501, "o", "    out['tickets_30d'], _ = _window_counts(points, tickets, 'opened_at', days=30)\r\n\u001b[?2004l\r"]
[237.303554, "o", "\u001b[?2004h"]
[237.303602, "o", "> \r\n\u001b[?2004l\r"]
[237.303652, "o", "\u001b[?2004h> "]
[237.304025, "o", "    # days_since_last_order – strictly before as_of\r\n\u001b[?2004l\r"]
[237.304069, "o", "\u001b[?2004h"]
[237.304119, "o", "> "]
[237.304679, "o", "    orders_sorted = orders.sort_values('ordered_at')[['customer_id', 'ordered_at']]\r\n\u001b[?2004l\r"]
[237.304723, "o", "\u001b[?2004h"]
[237.304772, "o", "> "]
[237.30527, "o", "    left = out[['customer_id', 'as_of']].reset_index().sort_values('as_of')\r\n\u001b[?2004l\r"]
[237.305329, "o", "\u001b[?2004h"]
[237.305377, "o", "> "]
[237.305535, "o", "    last = pd.merge_asof(\r\n\u001b[?2004l\r"]
[237.305587, "o", "\u001b[?2004h> "]
[237.305701, "o", "        left,\r\n\u001b[?2004l\r"]
[237.305763, "o", "\u001b[?2004h> "]
[237.30592, "o", "        orders_sorted,\r\n\u001b[?2004l\r"]
[237.305961, "o", "\u001b[?2004h"]
[237.30602, "o", "> "]
[237.306159, "o", "        left_on='as_of',\r\n\u001b[?2004l\r"]
[237.306202, "o", "\u001b[?2004h"]
[237.306264, "o", "> "]
[237.306453, "o", "        right_on='ordered_at',\r\n\u001b[?2004l\r"]
[237.306495, "o", "\u001b[?2004h"]
[237.306536, "o", "> "]
[237.306701, "o", "        by='customer_id',\r\n\u001b[?2004l\r"]
[237.306743, "o", "\u001b[?2004h"]
[237.306779, "o", "> "]
[237.30701, "o", "        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[237.307054, "o", "\u001b[?2004h"]
[237.30709, "o", "> "]
[237.307449, "o", "    ).set_index('index').sort_index()['ordered_at']\r\n\u001b[?2004l\r"]
[237.307492, "o", "\u001b[?2004h"]
[237.307529, "o", "> "]
[237.308091, "o", "    out['days_since_last_order'] = (out['as_of'] - last).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[237.308136, "o", "\u001b[?2004h"]
[237.308183, "o", "> "]
[237.308282, "o", "    return out\r\n\u001b[?2004l\r"]
[237.308325, "o", "\u001b[?2004h"]
[237.308364, "o", "> \r\n"]
[237.308404, "o", "\u001b[?2004l\r\u001b[?2004h"]
[237.308441, "o", "> \r\n\u001b[?2004l\r"]
[237.308482, "o", "\u001b[?2004h"]
[237.308523, "o", "> "]
[237.308744, "o", "def tenure_days(points, customers):\r\n\u001b[?2004l\r"]
[237.308784, "o", "\u001b[?2004h"]
[237.30882, "o", "> "]
[237.309315, "o", "    \"\"\"Compute days between `as_of` and the customer's signup date.\"\"\"\r\n\u001b[?2004l\r"]
[237.309359, "o", "\u001b[?2004h"]
[237.309396, "o", "> "]
[237.310004, "o", "    signup = points['customer_id'].map(customers.set_index('customer_id')['signup_at'])\r\n\u001b[?2004l\r"]
[237.310046, "o", "\u001b[?2004h"]
[237.310083, "o", "> "]
[237.310585, "o", "    return (points['as_of'] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[237.310639, "o", "\u001b[?2004h"]
[237.310695, "o", "> "]
[237.310734, "o", "PY\r\n\u001b[?2004l\r"]
[237.33066, "o", "\u001b[?2004h"]
