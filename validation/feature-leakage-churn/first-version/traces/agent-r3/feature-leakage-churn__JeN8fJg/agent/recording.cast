[119.476953, "o", "    from churn.status import latest_status\r\n  File \"/app/churn/status.py\", line 26\r\n"]
[119.476977, "o", "    +        left_on=\"pred_date\",\r\n    ^^^^^^^^^^^^^^^^^\r\nSyntaxError: expression cannot contain assignment, perhaps you meant \"==\"?\r\n"]
[119.522421, "o", "\u001b[?2004hroot@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# "]
