[357.733249, "o", "\u001b[?2004l\r"]
[357.733288, "o", "\u001b[?2004h"]
[357.733316, "o", "> "]
[357.733882, "o", "        lbl = labels[labels['customer_id'].map(district_map) == district].copy()\r\n"]
[357.733905, "o", "\u001b[?2004l\r"]
[357.733935, "o", "\u001b[?2004h"]
[357.73396, "o", "> "]
[357.734121, "o", "        if lbl.empty:\r\n"]
[357.734138, "o", "\u001b[?2004l\r"]
[357.734172, "o", "\u001b[?2004h"]
[357.734201, "o", "> "]
[357.734848, "o", "            # No labels for district: use global prior for all points in this district\r\n\u001b[?2004l\r"]
[357.734903, "o", "\u001b[?2004h"]
[357.734944, "o", "> "]
[357.735453, "o", "            # Compute prior per point using global cumulative up to as_of\r\n\u001b[?2004l\r"]
[357.735489, "o", "\u001b[?2004h"]
[357.735509, "o", "> "]
[357.736032, "o", "            as_of_vals = grp['as_of'].values.astype('datetime64[ns]')\r\n\u001b[?2004l\r"]
[357.736085, "o", "\u001b[?2004h"]
[357.736126, "o", "> "]
[357.736676, "o", "            idx_global = np.searchsorted(global_times, as_of_vals, side='right') - 1\r\n\u001b[?2004l\r"]
[357.736715, "o", "\u001b[?2004h"]
[357.736745, "o", "> "]
[357.737295, "o", "            prior = np.full(len(as_of_vals), DEFAULT_PRIOR, dtype=np.float64)\r\n\u001b[?2004l\r"]
[357.737345, "o", "\u001b[?2004h"]
[357.73739, "o", "> "]
[357.737621, "o", "            valid = idx_global >= 0\r\n"]
[357.737666, "o", "\u001b[?2004l\r"]
[357.73771, "o", "\u001b[?2004h> "]
[357.738386, "o", "            prior[valid] = global_cum_sum[idx_global[valid]] / global_cum_cnt[idx_global[valid]]\r\n\u001b[?2004l\r"]
[357.738436, "o", "\u001b[?2004h"]
[357.738477, "o", "> "]
[357.739076, "o", "            result[grp['index'].values] = prior  # no district info, use prior directly\r\n\u001b[?2004l\r"]
[357.739158, "o", "\u001b[?2004h> "]
[357.739307, "o", "            continue\r\n\u001b[?2004l\r"]
[357.739342, "o", "\u001b[?2004h"]
[357.739377, "o", "> "]
[357.739732, "o", "        lbl = lbl.sort_values('label_available_at')\r\n\u001b[?2004l\r"]
[357.739775, "o", "\u001b[?2004h"]
[357.739809, "o", "> "]
[357.740327, "o", "        times = lbl['label_available_at'].values.astype('datetime64[ns]')\r\n\u001b[?2004l\r"]
[357.740375, "o", "\u001b[?2004h"]
[357.740399, "o", "> "]
[357.740916, "o", "        cum_sum = np.cumsum(lbl['churned_30d'].values.astype(np.float64))\r\n\u001b[?2004l\r"]
[357.740959, "o", "\u001b[?2004h"]
[357.740998, "o", "> "]
[357.741312, "o", "        cum_cnt = np.arange(1, len(lbl) + 1)\r\n\u001b[?2004l\r"]
[357.741352, "o", "\u001b[?2004h"]
[357.741373, "o", "> "]
[357.74184, "o", "        as_of_vals = grp['as_of'].values.astype('datetime64[ns]')\r\n\u001b[?2004l\r"]
[357.741887, "o", "\u001b[?2004h"]
[357.741922, "o", "> "]
[357.74235, "o", "        # Find last label_available_at < as_of for district\r\n\u001b[?2004l\r"]
[357.742386, "o", "\u001b[?2004h"]
[357.742412, "o", "> "]
[357.742883, "o", "        idx = np.searchsorted(times, as_of_vals, side='right') - 1\r\n\u001b[?2004l\r"]
[357.742928, "o", "\u001b[?2004h"]
[357.742959, "o", "> "]
[357.743218, "o", "        # Global prior for each point\r\n\u001b[?2004l\r"]
[357.743289, "o", "\u001b[?2004h> "]
[357.743859, "o", "        idx_global = np.searchsorted(global_times, as_of_vals, side='right') - 1\r\n\u001b[?2004l\r"]
[357.743899, "o", "\u001b[?2004h"]
[357.743926, "o", "> "]
[357.744455, "o", "        prior = np.full(len(as_of_vals), DEFAULT_PRIOR, dtype=np.float64)\r\n"]
[357.74448, "o", "\u001b[?2004l\r"]
[357.744504, "o", "\u001b[?2004h"]
[357.744526, "o", "> "]
[357.744851, "o", "        valid_global = idx_global >= 0\r\n\u001b[?2004l\r"]
[357.744917, "o", "\u001b[?2004h> "]
[357.745698, "o", "        prior[valid_global] = global_cum_sum[idx_global[valid_global]] / global_cum_cnt[idx_global[valid_global]]\r\n\u001b[?2004l\r"]
[357.745739, "o", "\u001b[?2004h"]
[357.745782, "o", "> "]
[357.746216, "o", "        # Compute smoothed encoding where district label exists\r\n\u001b[?2004l\r"]
[357.746266, "o", "\u001b[?2004h"]
[357.746302, "o", "> "]
[357.7467, "o", "        te = np.empty(len(as_of_vals), dtype=np.float64)\r\n\u001b[?2004l\r"]
[357.746805, "o", "\u001b[?2004h"]
[357.746858, "o", "> "]
[357.747067, "o", "        te[:] = prior  # fallback to prior\r\n\u001b[?2004l\r"]
[357.74711, "o", "\u001b[?2004h"]
[357.74715, "o", "> "]
[357.747335, "o", "        valid = idx >= 0\r\n\u001b[?2004l\r"]
[357.747378, "o", "\u001b[?2004h"]
[357.747438, "o", "> "]
[357.747591, "o", "        if np.any(valid):\r\n\u001b[?2004l\r"]
[357.747642, "o", "\u001b[?2004h"]
[357.747686, "o", "> "]
[357.747921, "o", "            s = cum_sum[idx[valid]]\r\n\u001b[?2004l\r"]
[357.747966, "o", "\u001b[?2004h"]
[357.748007, "o", "> "]
[357.74827, "o", "            n = cum_cnt[idx[valid]]\r\n\u001b[?2004l\r"]
[357.748375, "o", "\u001b[?2004h"]
[357.748442, "o", "> "]
[357.748753, "o", "            te[valid] = (s + m * prior[valid]) / (n + m)\r\n"]
[357.748802, "o", "\u001b[?2004l\r"]
[357.748866, "o", "\u001b[?2004h> "]
[357.749109, "o", "        result[grp['index'].values] = te\r\n\u001b[?2004l\r"]
[357.749167, "o", "\u001b[?2004h"]
[357.749217, "o", "> \r\n\u001b[?2004l\r"]
[357.749278, "o", "\u001b[?2004h> "]
[357.749573, "o", "    # Align with original ordering of points\r\n\u001b[?2004l\r"]
[357.749632, "o", "\u001b[?2004h> "]
[357.750228, "o", "    final_series = pd.Series(result, index=pts['index']).reindex(points.index)\r\n\u001b[?2004l\r"]
[357.750315, "o", "\u001b[?2004h> "]
[357.750603, "o", "    return final_series.astype('float64')\r\n\u001b[?2004l\r"]
[357.750652, "o", "\u001b[?2004h"]
[357.750701, "o", "> "]
[357.750755, "o", "PY\r\n\u001b[?2004l\r"]
[357.754072, "o", "\u001b[?2004h"]
