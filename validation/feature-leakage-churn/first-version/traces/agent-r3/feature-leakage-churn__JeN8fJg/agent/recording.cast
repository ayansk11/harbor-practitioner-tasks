[183.265096, "o", "\u001b[?2004h"]
[183.265122, "o", "> "]
[183.265279, "o", "    pts[\"pred_date\"] = pts[\"as_of\"].dt.floor(\"D\")\r\n\u001b[?2004l\r"]
[183.265315, "o", "\u001b[?2004h> "]
[183.265408, "o", "    merged = pd.merge_asof(\r\n\u001b[?2004l\r"]
[183.265439, "o", "\u001b[?2004h"]
[183.265471, "o", "> "]
[183.26563, "o", "        pts.sort_values([\"customer_id\", \"pred_date\"]),\r\n\u001b[?2004l\r"]
[183.265661, "o", "\u001b[?2004h> "]
[183.265718, "o", "        snaps,\r\n\u001b[?2004l\r"]
[183.265749, "o", "\u001b[?2004h"]
[183.265784, "o", "> "]
