[90.127283, "i", "cat > churn/windows.py <<'PY'\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time‑since features.\n\nThe original implementation aggregated events per calendar day and then used a closed=\"both\"\nrolling window, which inadvertently included events that occurred on the prediction day.  This\nviolates the strict‑before rule in `FEATURES.md`.\n\nThe rewritten version works directly with timestamps and uses cumulative counts/sums via\n`pd.merge_asof` to compute exact half‑open windows `[t‑W, t)`.  For a given window we take the\ncumulative values just before `t` and subtract the cumulative values just before `t‑W`.  This\nensures that events at exactly `t` are never visible to the prediction.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\n\ndef _cumulative(events, ts_col, amount_col=None):\n    \"\"\"Return a DataFrame with cumulative count and optional cumulative sum per customer.\n\n    The result contains the original timestamp column plus `cum_cnt` and, if `amount_col` is\n    provided, "]
[90.127392, "i", "`cum_sum`.  Rows are sorted by ``customer_id`` and the timestamp column.\n    \"\"\"\n    ev = events[[\"customer_id\", ts_col]].copy()\n    ev = ev.sort_values([\"customer_id\", ts_col])\n    ev[\"cum_cnt\"] = ev.groupby(\"customer_id\").cumcount() + 1\n    if amount_col:\n        ev[\"cum_sum\"] = events.loc[ev.index, amount_col].groupby(events[\"customer_id\"]).cumsum()\n    return ev\n\n\ndef _window_counts(points, events, ts_col, amount_col=None, days=7):\n    \"\"\"Calculate count (and optional sum) of `events` in the half‑open window `[t‑days, t)`.\n\n    Returns a Series of counts and, when `amount_col` is supplied, a Series of summed amounts.\n    Missing values are filled with 0 and cast to ``int64``.\n    \"\"\"\n    cum = _cumulative(events, ts_col, amount_col)\n    # Merge to get cumulative values strictly before each as_of\n    left = points[[\"customer_id\", \"as_of\"]].sort_values([\"customer_id\", \"as_of\"])\n    cur = pd.merge_asof(\n        left,\n        cum,\n        left_on=\"as_of\",\n        right_on=ts_col,\n        by=\"customer_id\","]
[90.127433, "i", "\n        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n    # Compute the start of the window\n    start = left.copy()\n    start[\"as_of\"] = start[\"as_of\"] - np.timedelta64(days, \"D\")\n    start_cum = pd.merge_asof(\n        start,\n        cum,\n        left_on=\"as_of\",\n        right_on=ts_col,\n        by=\"customer_id\",\n        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n    cnt = (cur[\"cum_cnt\"].fillna(0) - start_cum[\"cum_cnt\"].fillna(0)).astype(\"int64\")\n    if amount_col:\n        spend = (cur[\"cum_sum\"].fillna(0) - start_cum[\"cum_sum\"].fillna(0)).astype(\"int64\")\n        return cnt, spend\n    return cnt, None\n\n\ndef activity_features(points, orders, tickets):\n    \"\"\"Return a DataFrame containing all activity‑related features.\n\n    Columns produced:\n        - orders_7d\n        - orders_30d\n        - spend_30d_cents\n        - tickets_30d\n        - days_since_last_order (strictly before the prediction)\n    \"\"\"\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n\n    # orders_7d (win"]
[90.127462, "i", "dow = 7 days)\n    out[\"orders_7d\"], _ = _window_counts(points, orders, \"ordered_at\", days=7)\n    # orders_30d and spend_30d_cents (window = 30 days)\n    out[\"orders_30d\"], out[\"spend_30d_cents\"] = _window_counts(\n        points, orders, \"ordered_at\", amount_col=\"amount_cents\", days=30\n+    )\n+    # tickets_30d (window = 30 days)\n+    out[\"tickets_30d\"], _ = _window_counts(points, tickets, \"opened_at\", days=30)\n+\n+    # days_since_last_order – strictly before as_of\n+    orders_sorted = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\n+    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\n+    last = pd.merge_asof(\n+        left,\n+        orders_sorted,\n+        left_on=\"as_of\",\n+        right_on=\"ordered_at\",\n+        by=\"customer_id\",\n+        allow_exact_matches=False,\n+    ).set_index(\"index\").sort_index()[\"ordered_at\"]\n+    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\n+\n+    return out\nPY\n"]
