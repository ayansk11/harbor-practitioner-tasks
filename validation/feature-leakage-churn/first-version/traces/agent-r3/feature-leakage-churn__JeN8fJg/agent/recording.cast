[309.404144, "i", "cat > churn/status.py <<'PY'\n\"\"\"Account status from the billing system's status snapshots.\n\nFor each scoring point we need the status from the most recent snapshot whose\n`snapshot_date` is **strictly before** the date of the prediction (`as_of`).\nWe implement this with a per‑customer binary search to avoid pandas sorting\nrequirements.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Return a Series of the latest status before each prediction.\n\n    Parameters\n    ----------\n    points : DataFrame with ``customer_id`` and ``as_of``.\n    snapshots : DataFrame with ``customer_id``, ``snapshot_date`` (UTC datetime) and ``status``.\n    \"\"\"\n    # Prepare result Series with NaN default\n    result = pd.Series([np.nan] * len(points), index=points.index, dtype=object)\n\n    # Work on a sorted copy of points for deterministic processing\n    pts = points[['customer_id', 'as_of']].reset_index()\n    pts = pts.sort_values(['customer_id', 'as_of']).reset_index(drop=True)\n\n    for cid"]
[309.404267, "i", ", grp in pts.groupby('customer_id'):\n        # Snapshots for this customer, sorted by snapshot_date\n        snap = snapshots[snapshots['customer_id'] == cid].sort_values('snapshot_date')\n        if snap.empty:\n            continue\n        snap_dates = snap['snapshot_date'].values.astype('datetime64[ns]')\n        # For each prediction compute the date (midnight) of as_of\n        pred_dates = np.floor(grp['as_of'].values.astype('datetime64[ns]').astype('datetime64[D]')).astype('datetime64[ns]')\n        # Find rightmost snapshot_date < pred_date\n        idx = np.searchsorted(snap_dates, pred_dates, side='right') - 1\n        valid = idx >= 0\n        statuses = np.empty(len(grp), dtype=object)\n        statuses[:] = np.nan\n        statuses[valid] = snap['status'].values[idx[valid]]\n        result.iloc[grp['index'].values] = statuses\n    return result\nPY\n"]
