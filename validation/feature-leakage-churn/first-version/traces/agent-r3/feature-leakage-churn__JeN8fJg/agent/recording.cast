[183.265883, "o", "\u001b[?2004h> "]
[183.266004, "o", "        right_on=\"snapshot_date\",\r\n\u001b[?2004l\r"]
[183.266033, "o", "\u001b[?2004h> "]
[183.266129, "o", "        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[183.266163, "o", "\u001b[?2004h> "]
[183.266283, "o", "        direction=\"backward\",\r\n\u001b[?2004l\r"]
[183.266318, "o", "\u001b[?2004h> "]
[183.266438, "o", "        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[183.266463, "o", "\u001b[?2004h"]
[183.266494, "o", "> "]
[183.266521, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.266553, "o", "> "]
[183.266626, "o", "    return merged[\"status\"]\r\n\u001b[?2004l\r"]
[183.266656, "o", "\u001b[?2004h"]
