[237.263331, "i", "cat > churn/windows.py <<'PY'\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time‑since features.\n\nWe avoid pandas `merge_asof` and instead compute window counts by per‑customer binary search. This guarantees that the windows are half‑open `[t‑W, t)` and respects the strict‑before rule.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\n\ndef _window_counts(points, events, ts_col, amount_col=None, days=7):\n    \"\"\"Return count (and optional sum) of `events` in the half‑open window `[t‑days, t)`.\n\n    Parameters\n    ----------\n    points : DataFrame with ``customer_id`` and ``as_of``.\n    events : DataFrame containing ``customer_id`` and a timestamp column named `ts_col`.\n    amount_col : optional column name for a numeric amount to be summed (used for spend).\n    days : window length in days.\n\n    Returns a tuple ``(count_series, sum_series_or_None)`` aligned with `points`.\n    \"\"\"\n    # Prepare result arrays\n    count_res = np.zeros(len(points), dtype=np.int64)\n    sum_r"]
[237.263493, "i", "es = np.zeros(len(points), dtype=np.int64) if amount_col else None\n\n    # Ensure points are sorted for deterministic output\n    pts = points[['customer_id', 'as_of']].reset_index()\n    pts = pts.sort_values(['customer_id', 'as_of']).reset_index(drop=True)\n\n    # Group by customer for vectorised processing\n    for cid, grp in pts.groupby('customer_id'):\n        # Events for this customer, sorted by timestamp\n        ev = events[events['customer_id'] == cid].sort_values(ts_col)\n        if ev.empty:\n            # No events -> counts remain zero\n            continue\n        ev_ts = ev[ts_col].values.astype('datetime64[ns]')\n        # Cumulative sum if needed\n        if amount_col:\n            ev_amount = ev[amount_col].values.astype(np.int64)\n            cum_amount = np.cumsum(ev_amount)\n        else:\n            cum_amount = None\n\n        # Process each prediction point for this customer\n        idxs = grp['index'].values\n        as_of_vals = grp['as_of'].values.astype('datetime64[ns]')\n        start_vals = as_o"]
[237.26357, "i", "f_vals - np.timedelta64(days, 'D')\n        # Use searchsorted on the event timestamps (right side excludes exact matches at t)\n        end_pos = np.searchsorted(ev_ts, as_of_vals, side='right')\n        start_pos = np.searchsorted(ev_ts, start_vals, side='right')\n        counts = end_pos - start_pos\n        count_res[idxs] = counts\n        if amount_col:\n            # Sum of amounts in window = cum_amount[end-1] - cum_amount[start-1]\n            sum_vals = np.zeros_like(counts, dtype=np.int64)\n            # Where end_pos > 0, take cumulative at end-1\n            end_nonzero = end_pos > 0\n            sum_vals[end_nonzero] = cum_amount[end_pos[end_nonzero] - 1]\n            # Subtract cumulative at start-1 where start_pos > 0\n            start_nonzero = start_pos > 0\n            sum_vals[start_nonzero] -= cum_amount[start_pos[start_nonzero] - 1]\n            sum_res[idxs] = sum_vals\n\n    count_series = pd.Series(count_res, index=points.index).astype('int64')\n    sum_series = pd.Series(sum_res, index=points.index)."]
[237.263655, "i", "astype('int64') if amount_col else None\n    return count_series, sum_series\n\n\ndef activity_features(points, orders, tickets):\n    \"\"\"Compute activity related features for each scoring point.\n\n    Returns a DataFrame with columns:\n        orders_7d, orders_30d, spend_30d_cents, tickets_30d, days_since_last_order\n    \"\"\"\n    out = points[['customer_id', 'as_of']].copy()\n    # orders and spend windows\n    out['orders_7d'], _ = _window_counts(points, orders, 'ordered_at', days=7)\n    out['orders_30d'], out['spend_30d_cents'] = _window_counts(\n        points, orders, 'ordered_at', amount_col='amount_cents', days=30)\n    # tickets window\n    out['tickets_30d'], _ = _window_counts(points, tickets, 'opened_at', days=30)\n\n    # days_since_last_order – strictly before as_of\n    orders_sorted = orders.sort_values('ordered_at')[['customer_id', 'ordered_at']]\n    left = out[['customer_id', 'as_of']].reset_index().sort_values('as_of')\n    last = pd.merge_asof(\n        left,\n        orders_sorted,\n        left_on='as_of',"]
[237.263715, "i", "\n        right_on='ordered_at',\n        by='customer_id',\n        allow_exact_matches=False,\n    ).set_index('index').sort_index()['ordered_at']\n    out['days_since_last_order'] = (out['as_of'] - last).dt.total_seconds() / 86400\n    return out\n\n\ndef tenure_days(points, customers):\n    \"\"\"Compute days between `as_of` and the customer's signup date.\"\"\"\n    signup = points['customer_id'].map(customers.set_index('customer_id')['signup_at'])\n    return (points['as_of'] - signup).dt.total_seconds() / 86400\nPY\n"]
