[53.824688, "i", "window `[t‑W, t)` we compute:\n+\n+```\n+count(t) = cum_count(t‑) - cum_count(t‑W‑)\n+```\n+\n+where `cum_count(t‑)` is the cumulative count of events with timestamp < t.  This approach\n+guarantees that events at exactly `t` are excluded and that only information available\n+strictly before the prediction is used.\n+\"\"\"\n+\n+import numpy as np\n+import pandas as pd\n+\n+\n+def _cumulative(events, ts_col, amount_col=None):\n+    \"\"\"Return a DataFrame with cumulative count and (optional) cumulative sum per customer.\n+\n+    The returned DataFrame is sorted by ``customer_id`` and the timestamp column and contains\n+    the original timestamp column, plus ``cum_cnt`` and optionally ``cum_sum``.\n+    \"\"\"\n+    ev = events[[\"customer_id\", ts_col]].copy()\n+    ev = ev.sort_values([\"customer_id\", ts_col])\n+    ev[\"cum_cnt\"] = ev.groupby(\"customer_id\").cumcount() + 1\n+    if amount_col:\n+        ev[\"cum_sum\"] = events.loc[ev.index, amount_col].groupby(events[\"customer_id\"]).cumsum()\n+    return ev\n+\n+\n+def _window_counts(poin"]
