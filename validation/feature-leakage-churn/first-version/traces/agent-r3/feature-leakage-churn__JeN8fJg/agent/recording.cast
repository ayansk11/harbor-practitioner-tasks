[183.264173, "o", "\u001b[?2004h> "]
[183.264528, "o", "    snapshots : DataFrame with ``customer_id``, ``snapshot_date`` (UTC datetime) and ``status``.\r\n\u001b[?2004l\r"]
[183.264559, "o", "\u001b[?2004h> "]
