[183.263412, "o", "\u001b[?2004h"]
[183.263444, "o", "> "]
[183.263695, "o", "    \"\"\"Return a Series of the most recent status before the prediction date.\r\n\u001b[?2004l\r"]
[183.263724, "o", "\u001b[?2004h"]
[183.263761, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.263799, "o", "> "]
[183.263834, "o", "    Parameters\r\n\u001b[?2004l\r"]
