[127.401204, "o", "               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/pyarrow/parquet/core.py\", line 1915, in read_table\r\n"]
[127.40146, "o", "    dataset = ParquetDataset(\r\n              ^^^^^^^^^^^^^^^\r\n"]
[127.401486, "o", "  File \"/usr/local/lib/python3.12/site-packages/pyarrow/parquet/core.py\", line 1491, in __init__\r\n"]
[127.401703, "o", "    self._dataset = ds.dataset(path_or_paths, filesystem=filesystem,\r\n                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/pyarrow/dataset.py\", line 790, in dataset\r\n"]
[127.401806, "o", "    return _filesystem_dataset(source, **kwargs)\r\n"]
[127.401839, "o", "           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/pyarrow/dataset.py\", line 472, in _filesystem_dataset\r\n"]
[127.401937, "o", "    fs, paths_or_selector = _ensure_single_source(source, filesystem)\r\n"]
[127.401968, "o", "                            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n"]
[127.401997, "o", "  File \"/usr/local/lib/python3.12/site-packages/pyarrow/dataset.py\", line 437, in _ensure_single_source\r\n"]
[127.402034, "o", "    raise FileNotFoundError(path)\r\n"]
