[57.701628, "i", "apply_patch <<'PATCH'\n*** Begin Patch: churn/impute.py\n@@\n-\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\"\"\"\n-\n-\n-def fill_app_minutes(points):\n-    \"\"\"Fill missing app_minutes_7d from the nearest reading of the same customer.\"\"\"\n-    pts = points.sort_values([\"customer_id\", \"as_of\"])\n-    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(lambda s: s.bfill().ffill())\n-    return filled.reindex(points.index)\n+\"\"\"Gap filling for upstream readings that arrive with holes.\n+\n+The original implementation performed a bidirectional fill (``bfill`` followed by ``ffill``),\n+which could propagate a *future* ``app_minutes_7d`` value backward to earlier predictions – a clear\n+violation of the strict‑before rule.  The corrected version only forward‑fills so that a missing\n+value is replaced by the most recent earlier reading (if any); future readings never influence past\n+predictions.\n+\"\"\"\n+\n+import pandas as pd\n+\n+\n+def fill_app_minutes(points):"]
[57.701739, "i", "\n+    \"\"\"Forward‑fill missing ``app_minutes_7d`` within each customer.\n+\n+    Parameters\n+    ----------\n+    points : DataFrame\n+        Scoring points containing ``customer_id``, ``as_of`` and ``app_minutes_7d``.\n+    Returns\n+    -------\n+    pandas.Series\n+        A series aligned with ``points`` where NaNs have been forward‑filled per customer.\n+    \"\"\"\n+    # Ensure deterministic order\n+    pts = points.sort_values([\"customer_id\", \"as_of\"])\n+    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(lambda s: s.ffill())\n+    # Re‑index to original order\n+    return filled.reindex(points.index)\n*** End Patch\nPATCH\n"]
