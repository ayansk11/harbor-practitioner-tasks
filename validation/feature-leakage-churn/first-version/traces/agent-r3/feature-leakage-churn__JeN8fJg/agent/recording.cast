[94.125848, "i", "cat > churn/impute.py <<'PY'\n\"\"\"Gap filling for upstream readings.\n\nThe original implementation performed a backward‑fill followed by a forward‑fill, which\ncould leak future `app_minutes_7d` values into earlier predictions.  The corrected version\nonly forward‑fills within each customer, ensuring that a missing value is replaced by the\nmost recent *earlier* reading (or remains NaN if none exists).\n\"\"\"\n\nimport pandas as pd\n\n\ndef fill_app_minutes(points):\n    \"\"\"Forward‑fill missing `app_minutes_7d` per customer.\n\n    Returns a Series aligned with the original `points` DataFrame.\n    \"\"\"\n    pts = points.sort_values([\"customer_id\", \"as_of\"])\n    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(lambda s: s.ffill())\n    return filled.reindex(points.index)\nPY\n"]
