[205.772629, "o", "def tenure_days(points, customers):\r\n\u001b[?2004l\r"]
[205.772672, "o", "\u001b[?2004h> "]
[205.772947, "o", "    \"\"\"Return the number of days between `as_of` and the customer's signup date.\r\n\u001b[?2004l\r"]
[205.7731, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.773447, "o", "    This function is unchanged from the original implementation and is required by\r\n\u001b[?2004l\r\u001b[?2004h>     `build_features.py`.\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.773475, "o", "> "]
[205.773514, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[205.773523, "o", "\u001b[?2004h> "]
[205.773835, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[205.773874, "o", "\u001b[?2004h"]
[205.773883, "o", "> "]
[205.77411, "o", "    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
