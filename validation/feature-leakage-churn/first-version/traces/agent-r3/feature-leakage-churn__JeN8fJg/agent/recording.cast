[284.645694, "i", "cat > churn/status.py <<'PY'\n\"\"\"Account status from the billing system's status snapshots.\n\nFor each scoring point we need the status from the latest snapshot whose\n`snapshot_date` is **strictly before** the date of the prediction (`as_of`).\nThis implementation uses pandas `merge_asof` after sorting both inputs, which\navoids the \"left keys must be sorted\" error.\n\"\"\"\n\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Return a Series of the latest status before each prediction.\n\n    Parameters\n    ----------\n    points : DataFrame with ``customer_id`` and ``as_of``.\n    snapshots : DataFrame with ``customer_id``, ``snapshot_date`` (UTC datetime) and ``status``.\n    \"\"\"\n    # Prepare left table: prediction date (UTC date, not datetime) for comparison\n    left = points[['customer_id', 'as_of']].copy()\n    left['pred_date'] = left['as_of'].dt.floor('D')  # snapshot_date marks end of day D\n    left = left.sort_values(['customer_id', 'pred_date'])\n\n    # Ensure snapshots are sorted\n    right = snaps"]
[284.645827, "i", "hots.sort_values(['customer_id', 'snapshot_date'])\n\n    merged = pd.merge_asof(\n        left,\n        right,\n        left_on='pred_date',\n        right_on='snapshot_date',\n        by='customer_id',\n        direction='backward',\n        allow_exact_matches=False,\n    )\n    return merged['status']\nPY\n"]
