[403.214812, "i", "cat > churn/extract.py <<'PY'\n\"\"\"Load a warehouse extract (the CSV layout described in FEATURES.md) into pandas frames with UTC timestamps.\n\nThis implementation strips any leading/trailing whitespace (including newlines) from column names to ensure\nthat column names match the specification exactly (e.g., ``app_minutes_7d`` without a trailing newline).\n\"\"\"\n\nimport os\nimport pandas as pd\n\nTIMESTAMPS = {\n    \"customers\": [\"signup_at\"],\n    \"scoring_points\": [\"as_of\"],\n    \"orders\": [\"ordered_at\"],\n    \"tickets\": [\"opened_at\"],\n    \"status_snapshots\": [\"snapshot_date\"],\n    \"labels\": [\"as_of\", \"label_available_at\"],\n}\n\n\ndef _clean_columns(df):\n    \"\"\"Strip whitespace from column names of a DataFrame.\"\"\"\n    df.columns = df.columns.str.strip()\n    return df\n\n\ndef load_extract(data_dir):\n    tables = {}\n    for name, cols in TIMESTAMPS.items():\n        df = pd.read_csv(os.path.join(data_dir, f\"{name}.csv\"), dtype={\"postcode_district\": \"str\"})\n        df = _clean_columns(df)\n        for c in cols:\n            df[c] "]
[403.214928, "i", "= pd.to_datetime(df[c], utc=True)\n        tables[name] = df\n    # Ensure app_minutes_7d column is numeric after cleaning column names\n    tables[\"scoring_points\"][\"app_minutes_7d\"] = tables[\"scoring_points\"][\"app_minutes_7d\"].astype(\"float64\")\n    return tables\nPY\n"]
