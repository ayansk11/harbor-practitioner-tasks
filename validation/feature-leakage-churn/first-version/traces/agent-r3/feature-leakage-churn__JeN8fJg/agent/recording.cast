[127.40097, "o", "Traceback (most recent call last):\r\n  File \"<stdin>\", line 2, in <module>\r\n  File \"/usr/local/lib/python3.12/site-packages/pandas/io/parquet.py\", line 760, in read_parquet\r\n"]
[127.401103, "o", "    return impl.read(\r\n           ^^^^^^^^^^\r\n"]
