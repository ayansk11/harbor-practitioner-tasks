[3.926633, "o", "FEATURES.md  __init__.py  build_features.py  encoding.py  extract.py  impute.py  status.py  train.py  windows.py\r\n"]
[3.926662, "o", "\r\n./data:\r\ncustomers.csv  labels.csv  orders.csv  scoring_points.csv  status_snapshots.csv  tickets.csv\r\n"]
