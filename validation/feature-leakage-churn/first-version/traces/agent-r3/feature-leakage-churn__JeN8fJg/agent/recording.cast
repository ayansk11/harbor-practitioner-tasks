[53.864788, "o", "\u001b[?2004h"]
[53.86484, "o", "> "]
[53.865449, "o", "+guarantees that events at exactly `t` are excluded and that only information available\r\n\u001b[?2004l\r"]
[53.865511, "o", "\u001b[?2004h> "]
[53.865817, "o", "+strictly before the prediction is used.\r\n\u001b[?2004l\r"]
[53.86588, "o", "\u001b[?2004h> "]
[53.865937, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[53.865987, "o", "\u001b[?2004h"]
[53.866036, "o", "> "]
[53.866071, "o", "+\r\n\u001b[?2004l\r"]
[53.866113, "o", "\u001b[?2004h"]
[53.866153, "o", "> "]
[53.866288, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[53.866342, "o", "\u001b[?2004h"]
[53.866381, "o", "> "]
[53.866528, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[53.866585, "o", "\u001b[?2004h"]
[53.866625, "o", "> "]
[53.86666, "o", "+\r\n\u001b[?2004l\r"]
[53.866702, "o", "\u001b[?2004h"]
[53.866739, "o", "> +\r\n"]
[53.866779, "o", "\u001b[?2004l\r"]
[53.866838, "o", "\u001b[?2004h> "]
[53.867182, "o", "+def _cumulative(events, ts_col, amount_col=None):\r\n\u001b[?2004l\r"]
[53.86723, "o", "\u001b[?2004h"]
[53.867276, "o", "> "]
[53.867917, "o", "+    \"\"\"Return a DataFrame with cumulative count and (optional) cumulative sum per customer.\r\n"]
[53.867954, "o", "\u001b[?2004l\r"]
[53.867996, "o", "\u001b[?2004h"]
[53.868037, "o", "> +\r\n"]
[53.868077, "o", "\u001b[?2004l\r"]
[53.868112, "o", "\u001b[?2004h> "]
[53.868784, "o", "+    The returned DataFrame is sorted by ``customer_id`` and the timestamp column and contains\r\n\u001b[?2004l\r"]
[53.868841, "o", "\u001b[?2004h"]
[53.868878, "o", "> "]
[53.869447, "o", "+    the original timestamp column, plus ``cum_cnt`` and optionally ``cum_sum``.\r\n\u001b[?2004l\r"]
[53.869496, "o", "\u001b[?2004h"]
[53.869531, "o", "> "]
[53.869603, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[53.869652, "o", "\u001b[?2004h"]
[53.869693, "o", "> "]
[53.870035, "o", "+    ev = events[[\"customer_id\", ts_col]].copy()\r\n\u001b[?2004l\r"]
[53.870081, "o", "\u001b[?2004h"]
[53.870131, "o", "> "]
[53.870482, "o", "+    ev = ev.sort_values([\"customer_id\", ts_col])\r\n\u001b[?2004l\r"]
[53.870545, "o", "\u001b[?2004h"]
[53.870583, "o", "> "]
[53.871002, "o", "+    ev[\"cum_cnt\"] = ev.groupby(\"customer_id\").cumcount() + 1\r\n\u001b[?2004l\r"]
[53.871055, "o", "\u001b[?2004h"]
[53.871092, "o", "> "]
[53.871238, "o", "+    if amount_col:\r\n\u001b[?2004l\r"]
[53.871303, "o", "\u001b[?2004h"]
[53.871338, "o", "> "]
[53.872022, "o", "+        ev[\"cum_sum\"] = events.loc[ev.index, amount_col].groupby(events[\"customer_id\"]).cumsum()\r\n\u001b[?2004l\r"]
[53.872067, "o", "\u001b[?2004h"]
[53.872102, "o", "> "]
[53.872211, "o", "+    return ev\r\n\u001b[?2004l\r"]
[53.872278, "o", "\u001b[?2004h"]
[53.872319, "o", "> +\r\n"]
[53.872367, "o", "\u001b[?2004l\r"]
[53.872407, "o", "\u001b[?2004h> "]
[53.872449, "o", "+\r\n\u001b[?2004l\r"]
[53.872493, "o", "\u001b[?2004h"]
[53.872532, "o", "> "]
[53.873015, "o", "+def _window_counts(points, events, ts_col, amount_col=None, days=7):\r\n\u001b[?2004l\r"]
[53.873066, "o", "\u001b[?2004h"]
[53.873106, "o", "> "]
[53.873828, "o", "+    \"\"\"Calculate count (and optional sum) of ``events`` in the half‑open window ``[t‑days, t)``.\r\n\u001b[?2004l\r"]
[53.873878, "o", "\u001b[?2004h"]
[53.873914, "o", "> "]
[53.87395, "o", "+\r\n\u001b[?2004l\r"]
[53.873984, "o", "\u001b[?2004h"]
[53.874018, "o", "> "]
[53.874668, "o", "+    Returns a Series aligned with ``points`` containing the count and, if ``amount_col`` is\r\n\u001b[?2004l\r"]
[53.874714, "o", "\u001b[?2004h"]
[53.874749, "o", "> "]
[53.87542, "o", "+    supplied, the sum of the amount column.  The result is ``int64`` for counts and ``int64``\r\n\u001b[?2004l\r"]
[53.875466, "o", "\u001b[?2004h"]
[53.875511, "o", "> "]
[53.875864, "o", "+    for sums (with missing values filled with 0).\r\n\u001b[?2004l\r"]
[53.875919, "o", "\u001b[?2004h"]
[53.875954, "o", "> "]
[53.876022, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[53.876073, "o", "\u001b[?2004h"]
[53.876108, "o", "> "]
[53.876505, "o", "+    # cumulative up to (but not including) each as_of\r\n\u001b[?2004l\r"]
[53.876554, "o", "\u001b[?2004h"]
[53.876591, "o", "> "]
[53.876945, "o", "+    cum = _cumulative(events, ts_col, amount_col)\r\n\u001b[?2004l\r"]
[53.876993, "o", "\u001b[?2004h"]
[53.877028, "o", "> "]
[53.877063, "o", "+\r\n\u001b[?2004l\r"]
[53.877096, "o", "\u001b[?2004h"]
[53.877131, "o", "> "]
[53.877604, "o", "+    # merge_asof to get cumulative values strictly before as_of\r\n\u001b[?2004l\r"]
[53.877646, "o", "\u001b[?2004h"]
[53.877668, "o", "> "]
[53.878262, "o", "+    left = points[[\"customer_id\", \"as_of\"]].sort_values([\"customer_id\", \"as_of\"])\r\n\u001b[?2004l\r"]
[53.87831, "o", "\u001b[?2004h"]
[53.878356, "o", "> "]
[53.878597, "o", "+    merged_cur = pd.merge_asof(\r\n\u001b[?2004l\r"]
[53.87866, "o", "\u001b[?2004h"]
[53.878715, "o", "> "]
[53.878812, "o", "+        left,\r\n\u001b[?2004l\r"]
[53.878858, "o", "\u001b[?2004h"]
[53.878899, "o", "> "]
[53.879, "o", "+        cum,\r\n\u001b[?2004l\r"]
[53.879051, "o", "\u001b[?2004h"]
[53.879096, "o", "> "]
[53.879287, "o", "+        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[53.879343, "o", "\u001b[?2004h"]
[53.879379, "o", "> "]
[53.879514, "o", "+        right_on=ts_col,\r\n\u001b[?2004l\r"]
[53.879562, "o", "\u001b[?2004h> "]
[53.879657, "o", "+        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[53.879704, "o", "\u001b[?2004h> "]
[53.879813, "o", "+        direction=\"backward\",\r\n\u001b[?2004l\r"]
[53.87986, "o", "\u001b[?2004h> "]
[53.879986, "o", "+        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[53.880032, "o", "\u001b[?2004h> "]
[53.880073, "o", "+    )\r\n\u001b[?2004l\r"]
[53.880096, "o", "\u001b[?2004h"]
[53.880126, "o", "> +\r\n\u001b[?2004l\r"]
[53.88014, "o", "\u001b[?2004h> "]
[53.880352, "o", "+    # merge_asof for the start of the window (t - days)\r\n\u001b[?2004l\r"]
[53.880402, "o", "\u001b[?2004h> "]
[53.880505, "o", "+    left_start = left.copy()\r\n\u001b[?2004l\r"]
[53.880553, "o", "\u001b[?2004h> "]
[53.880811, "o", "+    left_start[\"as_of\"] = left_start[\"as_of\"] - np.timedelta64(days, \"D\")\r\n\u001b[?2004l\r"]
[53.880859, "o", "\u001b[?2004h> "]
[53.88098, "o", "+    merged_start = pd.merge_asof(\r\n\u001b[?2004l\r"]
[53.881027, "o", "\u001b[?2004h> "]
[53.881101, "o", "+        left_start,\r\n\u001b[?2004l\r"]
[53.881149, "o", "\u001b[?2004h> "]
[53.881198, "o", "+        cum,\r\n\u001b[?2004l\r"]
[53.881256, "o", "\u001b[?2004h> "]
[53.881343, "o", "+        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[53.881392, "o", "\u001b[?2004h> "]
[53.881482, "o", "+        right_on=ts_col,\r\n\u001b[?2004l\r"]
[53.881528, "o", "\u001b[?2004h> "]
[53.881624, "o", "+        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[53.881671, "o", "\u001b[?2004h> "]
[53.881779, "o", "+        direction=\"backward\",\r\n\u001b[?2004l\r"]
[53.881827, "o", "\u001b[?2004h> "]
[53.881951, "o", "+        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[53.881998, "o", "\u001b[?2004h> "]
[53.882043, "o", "+    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.88209, "o", "> +\r\n\u001b[?2004l\r"]
[53.882101, "o", "\u001b[?2004h> "]
[53.882457, "o", "+    cnt = (merged_cur[\"cum_cnt\"].fillna(0) - merged_start[\"cum_cnt\"].fillna(0)).astype(\"int64\")\r\n\u001b[?2004l\r"]
[53.882508, "o", "\u001b[?2004h> "]
[53.882576, "o", "+    if amount_col:\r\n\u001b[?2004l\r"]
[53.882622, "o", "\u001b[?2004h> "]
[53.882978, "o", "+        spend = (merged_cur[\"cum_sum\"].fillna(0) - merged_start[\"cum_sum\"].fillna(0)).astype(\"int64\")\r\n\u001b[?2004l\r"]
[53.883017, "o", "\u001b[?2004h> "]
[53.883112, "o", "+        return cnt, spend\r\n\u001b[?2004l\r"]
[53.883152, "o", "\u001b[?2004h"]
[53.883163, "o", "> "]
[53.883202, "o", "+    else:\r\n\u001b[?2004l\r"]
[53.883238, "o", "\u001b[?2004h> "]
[53.883336, "o", "+        return cnt, None\r\n\u001b[?2004l\r"]
[53.883385, "o", "\u001b[?2004h> "]
[53.883397, "o", "+\r\n\u001b[?2004l\r"]
[53.883458, "o", "\u001b[?2004h> "]
[53.883469, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.883649, "o", "+def activity_features(points, orders, tickets):\r\n\u001b[?2004l\r"]
[53.883701, "o", "\u001b[?2004h> "]
[53.88392, "o", "+    \"\"\"Return a DataFrame with all activity‑related features.\r\n\u001b[?2004l\r"]
[53.883961, "o", "\u001b[?2004h> "]
[53.883995, "o", "+\r\n\u001b[?2004l\r"]
[53.884006, "o", "\u001b[?2004h> "]
[53.884346, "o", "+    Columns produced: ``orders_7d``, ``orders_30d``, ``spend_30d_cents``, ``tickets_30d`` and\r\n\u001b[?2004l\r"]
[53.884388, "o", "\u001b[?2004h> "]
[53.88468, "o", "+    ``days_since_last_order``.  All calculations respect the strict‑before rule.\r\n\u001b[?2004l\r"]
[53.884718, "o", "\u001b[?2004h> "]
[53.884756, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[53.884794, "o", "\u001b[?2004h"]
[53.884827, "o", "> "]
[53.884985, "o", "+    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n\u001b[?2004l\r"]
[53.885018, "o", "\u001b[?2004h"]
[53.88505, "o", "> +\r\n"]
[53.885082, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.885115, "o", "> "]
[53.88515, "o", "+    # orders_7d\r\n\u001b[?2004l\r"]
[53.885187, "o", "\u001b[?2004h"]
[53.885211, "o", "> "]
[53.885496, "o", "+    out[\"orders_7d\"], _ = _window_counts(points, orders, \"ordered_at\", days=7)\r\n\u001b[?2004l\r"]
[53.885537, "o", "\u001b[?2004h> "]
[53.885672, "o", "+    # orders_30d and spend_30d_cents\r\n\u001b[?2004l\r"]
[53.885705, "o", "\u001b[?2004h"]
[53.885737, "o", "> "]
[53.885945, "o", "+    out[\"orders_30d\"], out[\"spend_30d_cents\"] = _window_counts(\r\n\u001b[?2004l\r"]
[53.885979, "o", "\u001b[?2004h"]
[53.88601, "o", "> "]
[53.886266, "o", "+        points, orders, \"ordered_at\", amount_col=\"amount_cents\", days=30\r\n\u001b[?2004l\r"]
[53.886278, "o", "\u001b[?2004h"]
[53.886319, "o", "> "]
[53.88633, "o", "+    )\r\n"]
[53.886372, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.886444, "o", "+    # tickets_30d\r\n\u001b[?2004l\r"]
[53.886478, "o", "\u001b[?2004h"]
[53.886489, "o", "> "]
[53.886775, "o", "+    out[\"tickets_30d\"], _ = _window_counts(points, tickets, \"opened_at\", days=30)\r\n\u001b[?2004l\r"]
[53.886808, "o", "\u001b[?2004h"]
[53.886833, "o", "> +\r\n"]
[53.886864, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.886878, "o", "> "]
[53.887037, "o", "+    # days_since_last_order (strictly before)\r\n\u001b[?2004l\r"]
[53.887084, "o", "\u001b[?2004h> "]
[53.887388, "o", "+    orders_sorted = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n\u001b[?2004l\r"]
[53.887431, "o", "\u001b[?2004h> "]
[53.887696, "o", "+    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n\u001b[?2004l\r"]
[53.887736, "o", "\u001b[?2004h"]
[53.887771, "o", "> "]
[53.887848, "o", "+    last = pd.merge_asof(\r\n\u001b[?2004l\r"]
[53.887879, "o", "\u001b[?2004h"]
[53.887892, "o", "> "]
[53.887933, "o", "+        left,\r\n\u001b[?2004l\r"]
[53.887975, "o", "\u001b[?2004h> "]
[53.88805, "o", "+        orders_sorted,\r\n\u001b[?2004l\r"]
[53.88809, "o", "\u001b[?2004h> "]
[53.888175, "o", "+        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[53.888221, "o", "\u001b[?2004h> "]
[53.888324, "o", "+        right_on=\"ordered_at\",\r\n\u001b[?2004l\r"]
[53.888366, "o", "\u001b[?2004h> "]
[53.88845, "o", "+        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[53.888495, "o", "\u001b[?2004h> "]
[53.888609, "o", "+        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[53.88865, "o", "\u001b[?2004h> "]
[53.888825, "o", "+    ).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n\u001b[?2004l\r"]
[53.888871, "o", "\u001b[?2004h> "]
[53.889157, "o", "+    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[53.889206, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[53.889218, "o", "\u001b[?2004h"]
[53.889285, "o", "> "]
[53.889314, "o", "+    return out\r\n\u001b[?2004l\r"]
[53.889349, "o", "\u001b[?2004h> "]
[53.889388, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[53.889416, "o", "\u001b[?2004h"]
[53.889452, "o", "> PATCH\r\n\u001b[?2004l\r"]
[53.889959, "o", "bash: apply_patch: command not found\r\n"]
[53.890285, "o", "\u001b[?2004h"]
[53.890297, "o", "root@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# "]
[55.640089, "i", "apply_patch <<'PATCH'\n*** Begin Patch: churn/status.py\n@@\n-\"\"\"Account status from the billing system's status snapshots.\"\"\"\n-\n-\n-def latest_status(points, snapshots):\n-    \"\"\"Status of the customer's latest snapshot.\"\"\"\n-    latest = (snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\n-              .drop_duplicates(\"customer_id\", keep=\"last\"))\n-    return points[[\"customer_id\"]].merge(latest[[\"customer_id\", \"status\"]], on=\"customer_id\", how=\"left\")[\"status\"]\n+\"\"\"Account status from the billing system's status snapshots.\n+\n+The specification requires that, for a prediction at time ``t`` (the ``as_of`` timestamp), we use the\n+status from the *latest* snapshot whose ``snapshot_date`` is **strictly before** ``date(t)``.  The\n+original implementation ignored ``as_of`` entirely and always returned the globally latest snapshot.\n+The corrected implementation performs a ``merge_asof`` on ``snapshot_date`` after converting the\n+prediction timestamp to a date (floored to UTC midnight).  This guarantees that snapsh"]
[55.640219, "i", "ots that are\n+recorded on the same day as the prediction are not visible to the model.\n+\"\"\"\n+\n+import pandas as pd\n+\n+\n+def latest_status(points, snapshots):\n+    \"\"\"Return a Series of the most recent status *before* the prediction date.\n+\n+    Parameters\n+    ----------\n+    points : DataFrame\n+        The scoring points containing ``customer_id`` and ``as_of``.\n+    snapshots : DataFrame\n+        Status snapshots with ``customer_id``, ``snapshot_date`` (as a UTC datetime) and ``status``.\n+    \"\"\"\n+    # Ensure snapshots are sorted for merge_asof\n+    snaps = snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\n+\n+    # Convert as_of to the *date* (midnight) that the snapshot would represent at the end of that day.\n+    pts = points[[\"customer_id\", \"as_of\"]].copy()\n+    pts[\"pred_date\"] = pts[\"as_of\"].dt.floor(\"D\")\n+\n+    merged = pd.merge_asof(\n+        pts.sort_values([\"customer_id\", \"pred_date\"]),\n+        snaps,\n+        left_on=\"pred_date\",\n+        right_on=\"snapshot_date\",\n+        by=\"customer_id\""]
[55.640275, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[55.6403, "i", ",\n+        direction=\"backward\",\n+        allow_exact_matches=False,\n+    )\n+    return merged[\"status\"]\n*** End Patch\nPATCH\n"]
[55.640325, "o", ",\r\n+        direction=\"backward\",\r\n+        allow_exact_matches=False,\r\n+    )\r\n+    return merged[\"status\"]\r\n*** End Patch\r\nPATCH\r\n"]
[55.640347, "o", "\u001b[?2004h> "]
[55.640472, "o", "*** Begin Patch: churn/status.py\r\n\u001b[?2004l\r"]
[55.640499, "o", "\u001b[?2004h"]
[55.64052, "o", "> "]
[55.640541, "o", "@@\r\n\u001b[?2004l\r"]
[55.640568, "o", "\u001b[?2004h"]
[55.640589, "o", "> "]
[55.640816, "o", "-\"\"\"Account status from the billing system's status snapshots.\"\"\"\r\n\u001b[?2004l\r"]
[55.640842, "o", "\u001b[?2004h"]
[55.640863, "o", "> "]
[55.640884, "o", "-\r\n\u001b[?2004l\r"]
[55.640913, "o", "\u001b[?2004h"]
[55.640937, "o", "> -\r\n\u001b[?2004l\r"]
[55.640958, "o", "\u001b[?2004h"]
[55.640979, "o", "> "]
[55.641117, "o", "-def latest_status(points, snapshots):\r\n\u001b[?2004l\r"]
[55.64116, "o", "\u001b[?2004h> "]
[55.641359, "o", "-    \"\"\"Status of the customer's latest snapshot.\"\"\"\r\n\u001b[?2004l\r"]
[55.641403, "o", "\u001b[?2004h> "]
[55.64166, "o", "-    latest = (snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\r\n\u001b[?2004l\r"]
[55.641705, "o", "\u001b[?2004h> "]
[55.641918, "o", "-              .drop_duplicates(\"customer_id\", keep=\"last\"))\r\n\u001b[?2004l\r"]
[55.641958, "o", "\u001b[?2004h"]
[55.641987, "o", "> "]
[55.642415, "o", "-    return points[[\"customer_id\"]].merge(latest[[\"customer_id\", \"status\"]], on=\"customer_id\", how=\"left\")[\"status\"]\r\n\u001b[?2004l\r"]
[55.642468, "o", "\u001b[?2004h> "]
[55.642689, "o", "+\"\"\"Account status from the billing system's status snapshots.\r\n\u001b[?2004l\r"]
[55.642722, "o", "\u001b[?2004h"]
[55.642744, "o", "> +\r\n"]
[55.642766, "o", "\u001b[?2004l\r"]
[55.642788, "o", "\u001b[?2004h"]
[55.642807, "o", "> "]
[55.643148, "o", "+The specification requires that, for a prediction at time ``t`` (the ``as_of`` timestamp), we use the\r\n\u001b[?2004l\r"]
[55.643196, "o", "\u001b[?2004h> "]
[55.643552, "o", "+status from the *latest* snapshot whose ``snapshot_date`` is **strictly before** ``date(t)``.  The\r\n\u001b[?2004l\r"]
[55.643602, "o", "\u001b[?2004h> "]
[55.643946, "o", "+original implementation ignored ``as_of`` entirely and always returned the globally latest snapshot.\r\n\u001b[?2004l\r"]
[55.643986, "o", "\u001b[?2004h> "]
[55.644339, "o", "+The corrected implementation performs a ``merge_asof`` on ``snapshot_date`` after converting the\r\n\u001b[?2004l\r"]
[55.644381, "o", "\u001b[?2004h> "]
[55.644727, "o", "+prediction timestamp to a date (floored to UTC midnight).  This guarantees that snapshots that are\r\n\u001b[?2004l\r"]
[55.644753, "o", "\u001b[?2004h"]
[55.644784, "o", "> "]
[55.645034, "o", "+recorded on the same day as the prediction are not visible to the model.\r\n\u001b[?2004l\r"]
[55.645078, "o", "\u001b[?2004h> "]
[55.645104, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[55.64513, "o", "\u001b[?2004h"]
[55.645154, "o", "> "]
[55.645206, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.645277, "o", "+import pandas as pd\r\n"]
[55.645302, "o", "\u001b[?2004l\r"]
[55.645335, "o", "\u001b[?2004h> "]
[55.645353, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.645385, "o", "> "]
[55.645396, "o", "+\r\n\u001b[?2004l\r"]
[55.64541, "o", "\u001b[?2004h"]
[55.645418, "o", "> "]
[55.645558, "o", "+def latest_status(points, snapshots):\r\n"]
[55.645588, "o", "\u001b[?2004l\r"]
[55.645624, "o", "\u001b[?2004h> "]
[55.645884, "o", "+    \"\"\"Return a Series of the most recent status *before* the prediction date.\r\n\u001b[?2004l\r"]
[55.645916, "o", "\u001b[?2004h> "]
[55.645937, "o", "+\r\n\u001b[?2004l\r"]
[55.64596, "o", "\u001b[?2004h"]
[55.645982, "o", "> "]
[55.646034, "o", "+    Parameters\r\n\u001b[?2004l\r"]
[55.646059, "o", "\u001b[?2004h"]
[55.646079, "o", "> "]
[55.646133, "o", "+    ----------\r\n\u001b[?2004l\r"]
[55.646157, "o", "\u001b[?2004h"]
[55.64618, "o", "> "]
[55.646273, "o", "+    points : DataFrame\r\n\u001b[?2004l\r"]
[55.646295, "o", "\u001b[?2004h"]
[55.646315, "o", "> "]
[55.646562, "o", "+        The scoring points containing ``customer_id`` and ``as_of``.\r\n\u001b[?2004l\r"]
[55.646587, "o", "\u001b[?2004h"]
[55.646604, "o", "> "]
[55.646703, "o", "+    snapshots : DataFrame\r\n\u001b[?2004l\r"]
[55.646726, "o", "\u001b[?2004h"]
[55.646741, "o", "> "]
[55.647097, "o", "+        Status snapshots with ``customer_id``, ``snapshot_date`` (as a UTC datetime) and ``status``.\r\n\u001b[?2004l\r"]
[55.647116, "o", "\u001b[?2004h"]
[55.647131, "o", "> "]
[55.647171, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[55.647192, "o", "\u001b[?2004h"]
[55.647209, "o", "> "]
[55.647394, "o", "+    # Ensure snapshots are sorted for merge_asof\r\n\u001b[?2004l\r"]
[55.647414, "o", "\u001b[?2004h"]
[55.647428, "o", "> "]
[55.647674, "o", "+    snaps = snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\r\n\u001b[?2004l\r"]
[55.647695, "o", "\u001b[?2004h"]
[55.647717, "o", "> "]
[55.647733, "o", "+\r\n\u001b[?2004l\r"]
[55.647749, "o", "\u001b[?2004h"]
[55.647759, "o", "> "]
[55.648124, "o", "+    # Convert as_of to the *date* (midnight) that the snapshot would represent at the end of that day.\r\n\u001b[?2004l\r"]
[55.64815, "o", "\u001b[?2004h"]
[55.648169, "o", "> "]
[55.648348, "o", "+    pts = points[[\"customer_id\", \"as_of\"]].copy()\r\n\u001b[?2004l\r"]
[55.64837, "o", "\u001b[?2004h"]
[55.648392, "o", "> "]
[55.64857, "o", "+    pts[\"pred_date\"] = pts[\"as_of\"].dt.floor(\"D\")\r\n\u001b[?2004l\r"]
[55.648591, "o", "\u001b[?2004h"]
[55.648606, "o", "> "]
[55.648621, "o", "+\r\n\u001b[?2004l\r"]
[55.648641, "o", "\u001b[?2004h"]
[55.648656, "o", "> "]
[55.648763, "o", "+    merged = pd.merge_asof(\r\n\u001b[?2004l\r"]
[55.648784, "o", "\u001b[?2004h"]
[55.648798, "o", "> "]
[55.648999, "o", "+        pts.sort_values([\"customer_id\", \"pred_date\"]),\r\n\u001b[?2004l\r"]
[55.649019, "o", "\u001b[?2004h"]
[55.649033, "o", "> "]
[55.649098, "o", "+        snaps,\r\n\u001b[?2004l\r"]
[55.649119, "o", "\u001b[?2004h"]
[55.649133, "o", "> "]
[55.64926, "o", "+        left_on=\"pred_date\",\r\n\u001b[?2004l\r"]
[55.649282, "o", "\u001b[?2004h"]
[55.649298, "o", "> "]
[55.649419, "o", "+        right_on=\"snapshot_date\",\r\n\u001b[?2004l\r"]
[55.64944, "o", "\u001b[?2004h"]
[55.649455, "o", "> "]
[55.649557, "o", "+        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[55.649577, "o", "\u001b[?2004h"]
[55.649592, "o", "> "]
[55.64971, "o", "+        direction=\"backward\",\r\n\u001b[?2004l\r"]
[55.64973, "o", "\u001b[?2004h"]
[55.649745, "o", "> "]
[55.649883, "o", "+        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[55.649904, "o", "\u001b[?2004h"]
[55.649918, "o", "> "]
[55.649952, "o", "+    )\r\n\u001b[?2004l\r"]
[55.649973, "o", "\u001b[?2004h"]
[55.649987, "o", "> "]
[55.650098, "o", "+    return merged[\"status\"]\r\n\u001b[?2004l\r"]
[55.650119, "o", "\u001b[?2004h"]
[55.650134, "o", "> "]
[55.650192, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[55.650294, "o", "\u001b[?2004h> PATCH\r\n\u001b[?2004l\r"]
