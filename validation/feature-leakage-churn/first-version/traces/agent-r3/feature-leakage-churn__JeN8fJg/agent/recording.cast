[96.043031, "i", "cat > churn/encoding.py <<'PY'\n\"\"\"Target encoding of high‑cardinality categoricals.\n\n`te_district` must be computed using only label rows whose `label_available_at` is strictly\nbefore the prediction's `as_of`.  The original code ignored this timing constraint, causing\nleakage.  The implementation below builds cumulative sums/counts per district and a global\ncumulative prior, then merges the latest cumulative statistics that are available before each\nprediction.  The smoothed encoding follows:\n\n    te = (s + m * p) / (n + m)\n\nwhere `s` and `n` are the district‑specific cumulative sum and count, `p` is the global\nprior mean (computed from the same set of available labels), and `m` is the prior weight.\n\"\"\"\n\nimport pandas as pd\n\nPRIOR_WEIGHT = 20\nDEFAULT_PRIOR = 0.05\n\n\ndef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\n    \"\"\"Compute the district target encoding respecting label availability.\n\n    Parameters\n    ----------\n    points : DataFrame with ``customer_id`` and ``as_of``.\n    labels : "]
[96.043154, "i", "DataFrame with ``customer_id``, ``churned_30d`` and ``label_available_at``.\n    customers : DataFrame with ``customer_id`` and ``postcode_district``.\n    m : int, optional\n        Prior weight (default 20).\n    \"\"\"\n    # Map each customer to its district\n    district_map = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    pts = points.copy()\n    pts[\"district\"] = pts[\"customer_id\"].map(district_map)\n\n    # Attach district to label rows\n    lbl = labels.copy()\n    lbl[\"district\"] = lbl[\"customer_id\"].map(district_map)\n    lbl = lbl.dropna(subset=[\"district\"]).sort_values(\"label_available_at\")\n\n    # Cumulative per‑district statistics\n    lbl[\"cum_sum\"] = lbl.groupby(\"district\")[\"churned_30d\"].cumsum()\n    lbl[\"cum_cnt\"] = lbl.groupby(\"district\").cumcount() + 1\n\n    # Global cumulative statistics for the prior mean\n    lbl[\"global_cum_sum\"] = lbl[\"churned_30d\"].cumsum()\n    lbl[\"global_cum_cnt\"] = range(1, len(lbl) + 1)\n\n    # Merge‑asof to get the latest cumulative stats before each as_of, per di"]
[96.04319, "i", "strict\n    pts_sorted = pts.sort_values([\"district\", \"as_of\"]).reset_index()\n    merged = pd.merge_asof(\n+        pts_sorted,\n+        lbl,\n+        left_on=\"as_of\",\n+        right_on=\"label_available_at\",\n+        by=\"district\",\n+        direction=\"backward\",\n+        allow_exact_matches=False,\n+    )\n+\n+    # Prior mean p(t) based on all labels available before as_of\n+    prior = merged[\"global_cum_sum\"] / merged[\"global_cum_cnt\"]\n+    prior = prior.fillna(DEFAULT_PRIOR)\n+\n+    # Smoothed encoding per district\n+    te = (merged[\"cum_sum\"] + m * prior) / (merged[\"cum_cnt\"] + m)\n+    te = te.fillna(prior)  # districts with no prior rows get the global prior\n+\n+    # Re‑index to original order of points\n+    result = pd.Series(te.values, index=pts_sorted[\"index\"]).reindex(points.index)\n+    return result.astype(\"float64\")\nPY\n"]
