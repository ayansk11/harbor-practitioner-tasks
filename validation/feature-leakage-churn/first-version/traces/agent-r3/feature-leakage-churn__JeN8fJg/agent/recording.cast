[90.153145, "o", "        points, orders, \"ordered_at\", amount_col=\"amount_cents\", days=30\r\n\u001b[?2004l\r"]
[90.153206, "o", "\u001b[?2004h> +    )\r\n\u001b[?2004l\r"]
[90.153274, "o", "\u001b[?2004h> "]
[90.153386, "o", "+    # tickets_30d (window = 30 days)\r\n\u001b[?2004l\r"]
[90.153441, "o", "\u001b[?2004h> "]
[90.153717, "o", "+    out[\"tickets_30d\"], _ = _window_counts(points, tickets, \"opened_at\", days=30)\r\n\u001b[?2004l\r"]
[90.153772, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.153825, "o", "> "]
[90.153992, "o", "+    # days_since_last_order – strictly before as_of\r\n\u001b[?2004l\r"]
[90.154046, "o", "\u001b[?2004h> "]
[90.154337, "o", "+    orders_sorted = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n\u001b[?2004l\r"]
[90.154393, "o", "\u001b[?2004h> "]
[90.154641, "o", "+    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n\u001b[?2004l\r"]
[90.154697, "o", "\u001b[?2004h> "]
