[181.366083, "o", "    start = left.copy()\r\n\u001b[?2004l\r"]
[181.366134, "o", "\u001b[?2004h"]
[181.366164, "o", "> "]
[181.366737, "o", "    start[\"as_of\"] = start[\"as_of\"] - np.timedelta64(days, \"D\")\r\n\u001b[?2004l\r"]
[181.36679, "o", "\u001b[?2004h"]
[181.366822, "o", "> "]
[181.36709, "o", "    start_cum = pd.merge_asof(\r\n\u001b[?2004l\r"]
[181.367139, "o", "\u001b[?2004h"]
[181.367171, "o", "> "]
[181.367316, "o", "        start,\r\n\u001b[?2004l\r"]
[181.367364, "o", "\u001b[?2004h"]
[181.367395, "o", "> "]
[181.367511, "o", "        cum,\r\n"]
[181.367557, "o", "\u001b[?2004l\r\u001b[?2004h"]
[181.367593, "o", "> "]
[181.367812, "o", "        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[181.367863, "o", "\u001b[?2004h"]
[181.367894, "o", "> "]
[181.36811, "o", "        right_on=ts_col,\r\n\u001b[?2004l\r"]
[181.368162, "o", "\u001b[?2004h"]
[181.368193, "o", "> "]
[181.368445, "o", "        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[181.368496, "o", "\u001b[?2004h"]
[181.368525, "o", "> "]
[181.368788, "o", "        direction=\"backward\",\r\n\u001b[?2004l\r"]
[181.368835, "o", "\u001b[?2004h"]
[181.368865, "o", "> "]
[181.369166, "o", "        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[181.369215, "o", "\u001b[?2004h"]
[181.369251, "o", "> "]
[181.369311, "o", "    )\r\n"]
[181.369334, "o", "\u001b[?2004l\r"]
[181.369362, "o", "\u001b[?2004h"]
[181.369391, "o", "> "]
[181.370135, "o", "    cnt = (cur[\"cum_cnt\"].fillna(0) - start_cum[\"cum_cnt\"].fillna(0)).astype(\"int64\")\r\n\u001b[?2004l\r"]
[181.370183, "o", "\u001b[?2004h"]
[181.370213, "o", "> "]
[181.370394, "o", "    if amount_col:\r\n\u001b[?2004l\r"]
[181.370442, "o", "\u001b[?2004h"]
[181.370497, "o", "> "]
[181.371283, "o", "        spend = (cur[\"cum_sum\"].fillna(0) - start_cum[\"cum_sum\"].fillna(0)).astype(\"int64\")\r\n\u001b[?2004l\r"]
[181.371341, "o", "\u001b[?2004h"]
[181.371353, "o", "> "]
[181.371586, "o", "        return cnt, spend\r\n\u001b[?2004l\r"]
[181.371636, "o", "\u001b[?2004h"]
[181.371675, "o", "> "]
[181.371851, "o", "    return cnt, None\r\n\u001b[?2004l\r"]
[181.371899, "o", "\u001b[?2004h"]
[181.37194, "o", "> "]
[181.371978, "o", "\r\n\u001b[?2004l\r"]
[181.371999, "o", "\u001b[?2004h"]
[181.372022, "o", "> \r\n\u001b[?2004l\r"]
[181.372076, "o", "\u001b[?2004h"]
[181.372114, "o", "> "]
[181.372534, "o", "def activity_features(points, orders, tickets):\r\n\u001b[?2004l\r"]
[181.372581, "o", "\u001b[?2004h"]
[181.372619, "o", "> "]
[181.373169, "o", "    \"\"\"Return a DataFrame with all activity‑related features.\r\n\u001b[?2004l\r"]
[181.373216, "o", "\u001b[?2004h"]
[181.373252, "o", "> "]
[181.373285, "o", "\r\n\u001b[?2004l\r"]
[181.373313, "o", "\u001b[?2004h"]
[181.373343, "o", "> "]
[181.374118, "o", "    Columns produced: ``orders_7d``, ``orders_30d``, ``spend_30d_cents``, ``tickets_30d``\r\n\u001b[?2004l\r"]
[181.374167, "o", "\u001b[?2004h"]
[181.374197, "o", "> "]
[181.374756, "o", "    and ``days_since_last_order`` (strictly before the prediction).\r\n\u001b[?2004l\r"]
[181.374799, "o", "\u001b[?2004h"]
[181.374832, "o", "> "]
[181.374883, "o", "    \"\"\"\r\n"]
[181.374892, "o", "\u001b[?2004l\r"]
[181.374926, "o", "\u001b[?2004h"]
[181.374958, "o", "> "]
[181.375304, "o", "    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n\u001b[?2004l\r"]
[181.375346, "o", "\u001b[?2004h"]
[181.375376, "o", "> "]
[181.375916, "o", "    out[\"orders_7d\"], _ = _window_counts(points, orders, \"ordered_at\", days=7)\r\n\u001b[?2004l\r"]
[181.375962, "o", "\u001b[?2004h"]
[181.375997, "o", "> "]
[181.376436, "o", "    out[\"orders_30d\"], out[\"spend_30d_cents\"] = _window_counts(\r\n\u001b[?2004l\r"]
[181.376477, "o", "\u001b[?2004h"]
[181.376511, "o", "> "]
[181.377003, "o", "        points, orders, \"ordered_at\", amount_col=\"amount_cents\", days=30\r\n\u001b[?2004l\r"]
[181.377044, "o", "\u001b[?2004h"]
[181.377077, "o", "> "]
[181.377114, "o", "    )\r\n"]
[181.377122, "o", "\u001b[?2004l\r"]
[181.37716, "o", "\u001b[?2004h"]
[181.377193, "o", "> "]
[181.377758, "o", "    out[\"tickets_30d\"], _ = _window_counts(points, tickets, \"opened_at\", days=30)\r\n\u001b[?2004l\r"]
[181.3778, "o", "\u001b[?2004h"]
[181.377832, "o", "> \r\n\u001b[?2004l\r"]
[181.377871, "o", "\u001b[?2004h"]
[181.377902, "o", "> "]
[181.37828, "o", "    # days_since_last_order – strictly before as_of\r\n\u001b[?2004l\r"]
[181.37832, "o", "\u001b[?2004h"]
[181.378361, "o", "> "]
[181.378917, "o", "    orders_sorted = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n\u001b[?2004l\r"]
[181.37896, "o", "\u001b[?2004h"]
[181.378994, "o", "> "]
[181.379545, "o", "    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n\u001b[?2004l\r"]
[181.379587, "o", "\u001b[?2004h"]
[181.37962, "o", "> "]
[181.379794, "o", "    last = pd.merge_asof(\r\n\u001b[?2004l\r"]
[181.379839, "o", "\u001b[?2004h"]
[181.379871, "o", "> "]
[181.379962, "o", "        left,\r\n\u001b[?2004l\r"]
[181.380003, "o", "\u001b[?2004h"]
[181.380035, "o", "> "]
[181.380191, "o", "        orders_sorted,\r\n"]
[181.380199, "o", "\u001b[?2004l\r"]
[181.380234, "o", "\u001b[?2004h"]
[181.380272, "o", "> "]
[181.380448, "o", "        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[181.380492, "o", "\u001b[?2004h"]
[181.380521, "o", "> "]
[181.380731, "o", "        right_on=\"ordered_at\",\r\n"]
[181.38074, "o", "\u001b[?2004l\r"]
[181.380775, "o", "\u001b[?2004h"]
[181.380807, "o", "> "]
[181.38098, "o", "        by=\"customer_id\",\r\n"]
[181.380989, "o", "\u001b[?2004l\r"]
[181.381025, "o", "\u001b[?2004h"]
[181.381052, "o", "> "]
[181.381308, "o", "        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[181.381352, "o", "\u001b[?2004h"]
[181.381392, "o", "> "]
[181.381737, "o", "    ).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n"]
[181.381746, "o", "\u001b[?2004l\r"]
[181.381779, "o", "\u001b[?2004h"]
[181.38181, "o", "> "]
[181.382421, "o", "    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[181.382462, "o", "\u001b[?2004h"]
[181.382495, "o", "> "]
[181.382596, "o", "    return out\r\n\u001b[?2004l\r"]
[181.382639, "o", "\u001b[?2004h"]
[181.382671, "o", "> "]
[181.382708, "o", "PY\r\n\u001b[?2004l\r"]
[181.384525, "o", "\u001b[?2004h"]
[181.384563, "o", "root@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# "]
[183.261488, "i", "cat > churn/status.py <<'PY'\n\"\"\"Account status from the billing system's status snapshots.\n\nThe specification requires using the latest snapshot whose ``snapshot_date`` is strictly before the *date* of the prediction (`as_of`). The previous implementation ignored `as_of` and always returned the globally most recent snapshot, causing leakage.\n\"\"\"\n\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Return a Series of the most recent status before the prediction date.\n\n    Parameters\n    ----------\n    points : DataFrame with ``customer_id`` and ``as_of``.\n    snapshots : DataFrame with ``customer_id``, ``snapshot_date`` (UTC datetime) and ``status``.\n    \"\"\"\n    snaps = snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\n    pts = points[[\"customer_id\", \"as_of\"]].copy()\n    pts[\"pred_date\"] = pts[\"as_of\"].dt.floor(\"D\")\n    merged = pd.merge_asof(\n        pts.sort_values([\"customer_id\", \"pred_date\"]),\n        snaps,\n        left_on=\"pred_date\",\n        right_on=\"snapshot_date\",\n        by=\"cu"]
[183.2616, "i", "stomer_id\",\n        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n    return merged[\"status\"]\nPY\n"]
[183.261679, "o", "cat > churn/status.py <<'PY'\r\n\u001b[?2004l\r"]
[183.261728, "o", "\u001b[?2004h"]
[183.261749, "o", "> "]
[183.261958, "o", "\"\"\"Account status from the billing system's status snapshots.\r\n\u001b[?2004l\r"]
[183.261984, "o", "\u001b[?2004h"]
[183.262004, "o", "> \r\n\u001b[?2004l\r"]
[183.262023, "o", "\u001b[?2004h"]
[183.262041, "o", "> "]
[183.262959, "o", "The specification requires using the latest snapshot whose ``snapshot_date`` is strictly before the *date* of the prediction (`as_of`). The previous implementation ignored `as_of` and always returned the globally most recent snapshot, causing leakage.\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.263018, "o", "> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.263056, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.263093, "o", "> "]
