[205.756776, "i", "cat > churn/windows.py <<'PY'\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time‑since features.\n\nThe original implementation aggregated events per day and used a closed=\"both\" rolling window, which included events that occurred on the prediction day—violating the strict‑before rule in `FEATURES.md`. The rewritten version works directly with timestamps and uses cumulative counts and sums via `pd.merge_asof` to compute half‑open windows `[t‑W, t)`.\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\n\ndef _cumulative(events, ts_col, amount_col=None):\n    \"\"\"Return a DataFrame with cumulative count and optional cumulative sum per customer.\n\n    The DataFrame contains the original timestamp column plus `cum_cnt` and, if `amount_col`\n    is provided, `cum_sum`. Rows are sorted by ``customer_id`` and the timestamp column.\n    \"\"\"\n    ev = events[[\"customer_id\", ts_col]].copy()\n    ev = ev.sort_values([\"customer_id\", ts_col])\n    ev[\"cum_cnt\"] = ev.groupby(\"customer_id\").cumcount()"]
[205.756908, "i", " + 1\n    if amount_col:\n        ev[\"cum_sum\"] = events.loc[ev.index, amount_col].groupby(events[\"customer_id\"]).cumsum()\n    return ev\n\n\ndef _window_counts(points, events, ts_col, amount_col=None, days=7):\n    \"\"\"Calculate count (and optional sum) of `events` in the half‑open window `[t‑days, t)`.\n\n    Returns a tuple ``(count_series, sum_series_or_None)`` aligned with `points`.\n    Missing values are filled with 0 and cast to ``int64``.\n    \"\"\"\n    cum = _cumulative(events, ts_col, amount_col)\n    left = points[[\"customer_id\", \"as_of\"]].sort_values([\"customer_id\", \"as_of\"])\n    cur = pd.merge_asof(\n        left,\n        cum,\n        left_on=\"as_of\",\n        right_on=ts_col,\n        by=\"customer_id\",\n        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n    start = left.copy()\n    start[\"as_of\"] = start[\"as_of\"] - np.timedelta64(days, \"D\")\n    start_cum = pd.merge_asof(\n        start,\n        cum,\n        left_on=\"as_of\",\n        right_on=ts_col,\n        by=\"customer_id\",\n        directio"]
[205.756944, "i", "n=\"backward\",\n        allow_exact_matches=False,\n    )\n    cnt = (cur[\"cum_cnt\"].fillna(0) - start_cum[\"cum_cnt\"].fillna(0)).astype(\"int64\")\n    if amount_col:\n        spend = (cur[\"cum_sum\"].fillna(0) - start_cum[\"cum_sum\"].fillna(0)).astype(\"int64\")\n        return cnt, spend\n    return cnt, None\n\n\ndef activity_features(points, orders, tickets):\n    \"\"\"Return a DataFrame with all activity‑related features.\n\n    Columns produced: ``orders_7d``, ``orders_30d``, ``spend_30d_cents``, ``tickets_30d``\n    and ``days_since_last_order`` (strictly before the prediction).\n    \"\"\"\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n    out[\"orders_7d\"], _ = _window_counts(points, orders, \"ordered_at\", days=7)\n    out[\"orders_30d\"], out[\"spend_30d_cents\"] = _window_counts(\n        points, orders, \"ordered_at\", amount_col=\"amount_cents\", days=30\n    )\n    out[\"tickets_30d\"], _ = _window_counts(points, tickets, \"opened_at\", days=30)\n\n    # days_since_last_order – strictly before as_of\n    orders_sorted = orders.sort_val"]
[205.756979, "o", "cat > churn/windows.py <<'PY'\r\n\u001b[?2004l\r"]
[205.757011, "i", "ues(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\n    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\n    last = pd.merge_asof(\n        left,\n        orders_sorted,\n        left_on=\"as_of\",\n        right_on=\"ordered_at\",\n        by=\"customer_id\",\n        allow_exact_matches=False,\n    ).set_index(\"index\").sort_index()[\"ordered_at\"]\n    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\n    return out\n\n\ndef tenure_days(points, customers):\n    \"\"\"Return the number of days between `as_of` and the customer's signup date.\n\n    This function is unchanged from the original implementation and is required by\n    `build_features.py`.\n    \"\"\"\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\n    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\nPY\n"]
[205.757044, "o", "ues(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n    left = out[[\"customer_id\", \""]
[205.757076, "o", "as_of\"]].reset_index().sort_values(\"as_of\")\r\n    last = pd.merge_asof(\r\n        left,\r\n        orders_sorted,\r\n"]
[205.757111, "o", "        left_on=\"as_of\",\r\n        right_on=\"ordered_at\",\r\n        by=\"customer_id\",\r\n        allow_exact_matches=False,\r\n    ).set_"]
[205.757142, "o", "index(\"index\").sort_index()[\"ordered_at\"]\r\n    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    return out\r\n\r\n\r\ndef tenure_days(point"]
[205.757171, "o", "s, customers):\r\n    \"\"\"Return the number of days between `as_of` and the customer's signup date.\r\n\r\n    This"]
[205.757201, "o", " function is unchanged from the original implementation and is required by\r\n    `build_features.py`.\r\n    \"\"\"\r\n    signup = points[\"customer_id\"].map(c"]
[205.757239, "o", "ustomers.set_index(\"customer_id\")[\"signup_at\"])\r\n    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\nPY\r\n"]
