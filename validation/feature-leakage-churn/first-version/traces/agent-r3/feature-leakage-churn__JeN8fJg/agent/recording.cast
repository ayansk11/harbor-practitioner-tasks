[90.155483, "o", "\u001b[?2004h> "]
[90.1556, "o", "+        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[90.155632, "o", "\u001b[?2004h> "]
[90.155834, "o", "+    ).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n\u001b[?2004l\r"]
[90.155861, "o", "\u001b[?2004h> "]
[90.156176, "o", "+    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[90.156211, "o", "\u001b[?2004h> "]
[90.156263, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.15633, "o", "+    return out\r\n\u001b[?2004l\r"]
[90.156371, "o", "\u001b[?2004h> "]
