[330.86171, "o", "\u001b[?2004h> "]
[330.862006, "o", "        pred_dates = grp['as_of'].dt.normalize().values.astype('datetime64[ns]')\r\n\u001b[?2004l\r"]
[330.862053, "o", "\u001b[?2004h> "]
[330.86223, "o", "        # Find rightmost snapshot_date < pred_date\r\n\u001b[?2004l\r"]
[330.862267, "o", "\u001b[?2004h"]
[330.86232, "o", "> "]
[330.862577, "o", "        idx = np.searchsorted(snap_dates, pred_dates, side='right') - 1\r\n\u001b[?2004l\r"]
[330.862626, "o", "\u001b[?2004h"]
[330.862669, "o", "> "]
[330.86272, "o", "        valid = idx >= 0\r\n\u001b[?2004l\r"]
[330.862766, "o", "\u001b[?2004h> "]
[330.862988, "o", "        statuses = np.empty(len(grp), dtype=object)\r\n\u001b[?2004l\r"]
[330.863092, "o", "\u001b[?2004h> "]
[330.863153, "o", "        statuses[:] = np.nan\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.863206, "o", "> "]
[330.863416, "o", "        statuses[valid] = snap['status'].values[idx[valid]]\r\n\u001b[?2004l\r"]
[330.863459, "o", "\u001b[?2004h> "]
[330.863641, "o", "        result.iloc[grp['index'].values] = statuses\r\n\u001b[?2004l\r"]
[330.863671, "o", "\u001b[?2004h> "]
[330.863743, "o", "    return result\r\n\u001b[?2004l\r"]
