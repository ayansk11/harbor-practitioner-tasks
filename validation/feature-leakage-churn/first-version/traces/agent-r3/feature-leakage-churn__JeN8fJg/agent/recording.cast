[381.206959, "o", "\u001b[?2004h> "]
[381.207228, "o", "    # Fill app minutes and ensure the column name is exactly 'app_minutes_7d'\r\n\u001b[?2004l\r"]
[381.207262, "o", "\u001b[?2004h"]
[381.20729, "o", "> "]
