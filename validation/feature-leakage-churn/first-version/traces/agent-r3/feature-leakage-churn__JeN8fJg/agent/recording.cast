[357.713409, "i", "cat > churn/encoding.py <<'PY'\n\"\"\"Target encoding of high‑cardinality categoricals.\n\n`te_district` must be computed using only label rows whose `label_available_at`\nis strictly before the prediction's `as_of`. The original implementation ignored this\ntemporal constraint, causing leakage. This version uses per‑district binary search\nto respect the strict‑before rule and applies the smoothed mean formula:\n\n    te = (s + m * p) / (n + m)\n\nwhere `s` and `n` are the district‑specific cumulative sum and count, `p` is the\nglobal prior mean (computed from all labels available before `as_of`), and `m`\nis the prior weight.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\nPRIOR_WEIGHT = 20\nDEFAULT_PRIOR = 0.05\n\n\ndef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\n    \"\"\"Return the smoothed churn rate per postcode district respecting label availability.\n\n    Parameters\n    ----------\n    points : DataFrame with ``customer_id`` and ``as_of``.\n    labels : DataFrame with ``customer_id``, ``churned_30d`` a"]
[357.713512, "i", "nd ``label_available_at``.\n    customers : DataFrame with ``customer_id`` and ``postcode_district``.\n    m : int, optional\n        Prior weight (default 20).\n    \"\"\"\n    # Map customers to districts\n    district_map = customers.set_index('customer_id')['postcode_district']\n    pts = points.copy()\n    pts['district'] = pts['customer_id'].map(district_map)\n    # Drop rows where district cannot be resolved (should be rare)\n    pts = pts.reset_index()\n    pts = pts.dropna(subset=['district'])\n    # Prepare result array\n    result = np.empty(len(pts), dtype=np.float64)\n    result[:] = np.nan\n\n    # Global cumulative stats (all labels irrespective of district)\n    lbl_global = labels.sort_values('label_available_at')\n    global_times = lbl_global['label_available_at'].values.astype('datetime64[ns]')\n    global_cum_sum = np.cumsum(lbl_global['churned_30d'].values.astype(np.float64))\n    global_cum_cnt = np.arange(1, len(lbl_global) + 1)\n\n    # Process each district separately\n    for district, grp in pts.groupby('di"]
[357.713543, "i", "strict'):\n        # Labels for this district\n        lbl = labels[labels['customer_id'].map(district_map) == district].copy()\n        if lbl.empty:\n            # No labels for district: use global prior for all points in this district\n            # Compute prior per point using global cumulative up to as_of\n            as_of_vals = grp['as_of'].values.astype('datetime64[ns]')\n            idx_global = np.searchsorted(global_times, as_of_vals, side='right') - 1\n            prior = np.full(len(as_of_vals), DEFAULT_PRIOR, dtype=np.float64)\n            valid = idx_global >= 0\n            prior[valid] = global_cum_sum[idx_global[valid]] / global_cum_cnt[idx_global[valid]]\n            result[grp['index'].values] = prior  # no district info, use prior directly\n            continue\n        lbl = lbl.sort_values('label_available_at')\n        times = lbl['label_available_at'].values.astype('datetime64[ns]')\n        cum_sum = np.cumsum(lbl['churned_30d'].values.astype(np.float64))\n        cum_cnt = np.arange(1, len(lbl) "]
[357.713566, "i", "+ 1)\n        as_of_vals = grp['as_of'].values.astype('datetime64[ns]')\n        # Find last label_available_at < as_of for district\n        idx = np.searchsorted(times, as_of_vals, side='right') - 1\n        # Global prior for each point\n        idx_global = np.searchsorted(global_times, as_of_vals, side='right') - 1\n        prior = np.full(len(as_of_vals), DEFAULT_PRIOR, dtype=np.float64)\n        valid_global = idx_global >= 0\n        prior[valid_global] = global_cum_sum[idx_global[valid_global]] / global_cum_cnt[idx_global[valid_global]]\n        # Compute smoothed encoding where district label exists\n        te = np.empty(len(as_of_vals), dtype=np.float64)\n        te[:] = prior  # fallback to prior\n        valid = idx >= 0\n        if np.any(valid):\n            s = cum_sum[idx[valid]]\n            n = cum_cnt[idx[valid]]\n            te[valid] = (s + m * prior[valid]) / (n + m)\n        result[grp['index'].values] = te\n\n    # Align with original ordering of points\n    final_series = pd.Series(result, index=pts['i"]
[357.71359, "i", "ndex']).reindex(points.index)\n    return final_series.astype('float64')\nPY\n"]
