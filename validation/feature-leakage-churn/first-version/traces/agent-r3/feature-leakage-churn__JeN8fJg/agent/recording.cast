[117.018425, "o", "> "]
[117.018718, "o", "where `s` and `n` are the district‑specific cumulative sum and count, `p` is the global\r\n\u001b[?2004l\r"]
[117.018738, "o", "\u001b[?2004h"]
[117.01876, "o", "> "]
[117.019068, "o", "prior mean (computed from the same set of available labels), and `m` is the prior weight.\r\n\u001b[?2004l\r"]
[117.0191, "o", "\u001b[?2004h> "]
[117.019128, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[117.019149, "o", "\u001b[?2004h"]
[117.019171, "o", "> \r\n\u001b[?2004l\r"]
[117.019193, "o", "\u001b[?2004h"]
[117.019216, "o", "> "]
[117.019278, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[117.019301, "o", "\u001b[?2004h"]
[117.019323, "o", "> "]
[117.019343, "o", "\r\n\u001b[?2004l\r"]
[117.019364, "o", "\u001b[?2004h> "]
[117.019424, "o", "PRIOR_WEIGHT = 20\r\n\u001b[?2004l\r"]
[117.019449, "o", "\u001b[?2004h"]
[117.019469, "o", "> "]
[117.019541, "o", "DEFAULT_PRIOR = 0.05\r\n\u001b[?2004l\r"]
[117.019564, "o", "\u001b[?2004h"]
[117.019587, "o", "> \r\n\u001b[?2004l\r"]
[117.019616, "o", "\u001b[?2004h"]
[117.019638, "o", "> \r\n\u001b[?2004l\r"]
[117.019659, "o", "\u001b[?2004h"]
[117.019682, "o", "> "]
[117.019896, "o", "def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n\u001b[?2004l\r"]
[117.019921, "o", "\u001b[?2004h"]
[117.01994, "o", "> "]
[117.020197, "o", "    \"\"\"Compute the district target encoding respecting label availability.\r\n\u001b[?2004l\r"]
[117.020265, "o", "\u001b[?2004h"]
[117.020311, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.020348, "o", "    Parameters\r\n"]
[117.020381, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[117.02042, "o", "    ----------\r\n\u001b[?2004l\r"]
[117.020457, "o", "\u001b[?2004h> "]
[117.020664, "o", "    points : DataFrame with ``customer_id`` and ``as_of``.\r\n\u001b[?2004l\r"]
[117.020702, "o", "\u001b[?2004h> "]
[117.021002, "o", "    labels : DataFrame with ``customer_id``, ``churned_30d`` and ``label_available_at``.\r\n\u001b[?2004l\r"]
[117.021042, "o", "\u001b[?2004h> "]
[117.021321, "o", "    customers : DataFrame with ``customer_id`` and ``postcode_district``.\r\n\u001b[?2004l\r"]
[117.021361, "o", "\u001b[?2004h> "]
[117.021429, "o", "    m : int, optional\r\n\u001b[?2004l\r"]
[117.021465, "o", "\u001b[?2004h> "]
[117.021583, "o", "        Prior weight (default 20).\r\n\u001b[?2004l\r"]
[117.02162, "o", "\u001b[?2004h> "]
[117.021645, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[117.021673, "o", "\u001b[?2004h"]
[117.021706, "o", "> "]
[117.021815, "o", "    # Map each customer to its district\r\n\u001b[?2004l\r"]
[117.021854, "o", "\u001b[?2004h> "]
[117.022106, "o", "    district_map = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[117.022151, "o", "\u001b[?2004h"]
[117.022187, "o", "> "]
[117.02223, "o", "    pts = points.copy()\r\n\u001b[?2004l\r"]
[117.022308, "o", "\u001b[?2004h"]
[117.022352, "o", "> "]
[117.022476, "o", "    pts[\"district\"] = pts[\"customer_id\"].map(district_map)\r\n\u001b[?2004l\r"]
[117.022524, "o", "\u001b[?2004h> "]
[117.022552, "o", "\r\n\u001b[?2004l\r"]
[117.022583, "o", "\u001b[?2004h> "]
[117.022811, "o", "    # Attach district to label rows and drop those without a district\r\n\u001b[?2004l\r"]
[117.022875, "o", "\u001b[?2004h> "]
[117.022943, "o", "    lbl = labels.copy()\r\n\u001b[?2004l\r"]
[117.02298, "o", "\u001b[?2004h"]
[117.023005, "o", "> "]
[117.023195, "o", "    lbl[\"district\"] = lbl[\"customer_id\"].map(district_map)\r\n\u001b[?2004l\r"]
[117.023233, "o", "\u001b[?2004h> "]
[117.023506, "o", "    lbl = lbl.dropna(subset=[\"district\"]).sort_values(\"label_available_at\")\r\n\u001b[?2004l\r"]
[117.023551, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.023577, "o", "\u001b[?2004h"]
[117.023605, "o", "> "]
[117.023743, "o", "    # Cumulative statistics per district\r\n\u001b[?2004l\r"]
[117.023775, "o", "\u001b[?2004h> "]
[117.02407, "o", "    lbl[\"cum_sum\"] = lbl.groupby(\"district\")[\"churned_30d\"].cumsum()\r\n\u001b[?2004l\r"]
[117.024101, "o", "\u001b[?2004h> "]
[117.024355, "o", "    lbl[\"cum_cnt\"] = lbl.groupby(\"district\").cumcount() + 1\r\n\u001b[?2004l\r"]
[117.02438, "o", "\u001b[?2004h"]
[117.024404, "o", "> \r\n\u001b[?2004l\r"]
[117.024425, "o", "\u001b[?2004h"]
[117.024449, "o", "> "]
[117.024714, "o", "    # Global cumulative statistics for the prior mean (based on availability time)\r\n\u001b[?2004l\r"]
[117.024736, "o", "\u001b[?2004h"]
[117.024758, "o", "> "]
[117.024939, "o", "    lbl[\"global_cum_sum\"] = lbl[\"churned_30d\"].cumsum()\r\n\u001b[?2004l\r"]
[117.024966, "o", "\u001b[?2004h"]
[117.024987, "o", "> "]
[117.025146, "o", "    lbl[\"global_cum_cnt\"] = range(1, len(lbl) + 1)\r\n\u001b[?2004l\r"]
[117.025164, "o", "\u001b[?2004h"]
[117.025183, "o", "> \r\n\u001b[?2004l\r"]
[117.025199, "o", "\u001b[?2004h"]
[117.025219, "o", "> "]
[117.025522, "o", "    # Merge‑asof to get the latest cumulative stats before each as_of, per district\r\n\u001b[?2004l\r"]
[117.025554, "o", "\u001b[?2004h"]
[117.025576, "o", "> "]
[117.025799, "o", "    pts_sorted = pts.sort_values([\"district\", \"as_of\"]).reset_index()\r\n\u001b[?2004l\r"]
[117.02582, "o", "\u001b[?2004h> "]
[117.025925, "o", "    merged = pd.merge_asof(\r\n\u001b[?2004l\r"]
[117.025944, "o", "\u001b[?2004h"]
[117.025965, "o", "> "]
[117.026026, "o", "        pts_sorted,\r\n\u001b[?2004l\r"]
[117.026047, "o", "\u001b[?2004h"]
[117.026066, "o", "> "]
[117.026106, "o", "        lbl,\r\n\u001b[?2004l\r"]
[117.026126, "o", "\u001b[?2004h"]
[117.026144, "o", "> "]
[117.026227, "o", "        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[117.026252, "o", "\u001b[?2004h"]
[117.026271, "o", "> "]
[117.0264, "o", "        right_on=\"label_available_at\",\r\n\u001b[?2004l\r"]
[117.02642, "o", "\u001b[?2004h"]
[117.026441, "o", "> "]
[117.026509, "o", "        by=\"district\",\r\n\u001b[?2004l\r"]
[117.026528, "o", "\u001b[?2004h"]
[117.026545, "o", "> "]
[117.026646, "o", "        direction=\"backward\",\r\n\u001b[?2004l\r"]
[117.026666, "o", "\u001b[?2004h"]
[117.026685, "o", "> "]
[117.026803, "o", "        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[117.026824, "o", "\u001b[?2004h"]
[117.026842, "o", "> "]
[117.026871, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.026893, "o", "> "]
[117.026914, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.027136, "o", "    # Prior mean p(t) using all labels available before as_of\r\n\u001b[?2004l\r"]
[117.02716, "o", "\u001b[?2004h> "]
[117.027432, "o", "    prior = merged[\"global_cum_sum\"] / merged[\"global_cum_cnt\"]\r\n\u001b[?2004l\r"]
[117.027458, "o", "\u001b[?2004h> "]
[117.027606, "o", "    prior = prior.fillna(DEFAULT_PRIOR)\r\n\u001b[?2004l\r"]
[117.027625, "o", "\u001b[?2004h> "]
[117.027645, "o", "\r\n\u001b[?2004l\r"]
[117.027664, "o", "\u001b[?2004h> "]
[117.027796, "o", "    # Smoothed encoding per district\r\n\u001b[?2004l\r"]
[117.027814, "o", "\u001b[?2004h"]
[117.027838, "o", "> "]
[117.028059, "o", "    te = (merged[\"cum_sum\"] + m * prior) / (merged[\"cum_cnt\"] + m)\r\n\u001b[?2004l\r"]
[117.028078, "o", "\u001b[?2004h"]
[117.028097, "o", "> "]
[117.028388, "o", "    te = te.fillna(prior)  # districts with no prior rows fall back to global prior\r\n\u001b[?2004l\r"]
[117.028411, "o", "\u001b[?2004h"]
[117.02843, "o", "> \r\n\u001b[?2004l\r"]
[117.028449, "o", "\u001b[?2004h> "]
[117.028625, "o", "    # Re‑index to the original order of points\r\n\u001b[?2004l\r"]
[117.028653, "o", "\u001b[?2004h> "]
[117.02895, "o", "    result = pd.Series(te.values, index=pts_sorted[\"index\"]).reindex(points.index)\r\n\u001b[?2004l\r"]
[117.028979, "o", "\u001b[?2004h> "]
[117.029108, "o", "    return result.astype(\"float64\")\r\n\u001b[?2004l\r"]
[117.029131, "o", "\u001b[?2004h"]
[117.029145, "o", "> "]
[117.029195, "o", "PY\r\n\u001b[?2004l\r"]
[117.030847, "o", "\u001b[?2004h"]
[117.030899, "o", "root@17a3e0e7-f835-42a4-9265-4eb0b35eea7d:/app# "]
[119.101982, "i", "python -m churn.build_features --data data --out features_fixed.parquet\n"]
[119.102343, "o", "python -m churn.build_features --data data --out features_fixed.parquet\r\n\u001b[?2004l\r"]
