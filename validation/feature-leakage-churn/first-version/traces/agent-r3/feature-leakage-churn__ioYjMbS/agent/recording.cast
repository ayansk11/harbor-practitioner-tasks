[142.031392, "i", "cat > churn/windows.py <<'EOF'\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time‑since features.\n\nThe original implementation used daily aggregation with pandas ``rolling`` using ``closed=\"both\"``\nwhich mistakenly included events occurring on the prediction day. According to ``FEATURES.md``\nwindows must be half‑open ``[t‑W, t)`` – events at exactly ``t`` or later in the same day must be\nexcluded. This implementation uses per‑customer ``numpy.searchsorted`` to compute counts and\nsums in the required half‑open intervals, handling customers with no events safely.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nimport pandas as pd\n\n\ndef _window_counts(\n    points: pd.DataFrame,\n    events: pd.DataFrame,\n    ts_col: str,\n    amount_col: str | None,\n    window_days: int,\n) -> tuple[pd.Series, pd.Series | None]:\n    \"\"\"Return count (and optional sum) series for events in ``[as_of‑W, as_of)``.\n\n    Parameters\n    ----------\n    points: DataFrame with ``custo"]
[142.031524, "i", "mer_id`` and ``as_of`` columns.\n    events: DataFrame containing the event timestamps in ``ts_col`` and optionally an amount column.\n    ts_col: Name of the timestamp column in ``events``.\n    amount_col: Column to sum (e.g. ``amount_cents``) or ``None`` for count only.\n    window_days: Length of the trailing window in days.\n    \"\"\"\n    # Minimal columns and proper datetime conversion\n    events = events[[\"customer_id\", ts_col] + ([amount_col] if amount_col else [])].copy()\n    events[ts_col] = pd.to_datetime(events[ts_col])\n    points = points[[\"customer_id\", \"as_of\"]].copy()\n    points[\"as_of\"] = pd.to_datetime(points[\"as_of\"])\n\n    # Sort events for efficient binary search\n    events = events.sort_values(ts_col)\n\n    # Prepare result containers\n    counts = np.empty(len(points), dtype=np.int64)\n    sums = np.empty(len(points), dtype=np.float64) if amount_col else None\n\n    # Group by customer\n    point_groups = points.groupby(\"customer_id\")\n    event_groups = events.groupby(\"customer_id\")\n\n    for cid, idx"]
[142.031565, "i", " in point_groups.groups.items():\n        pt_rows = points.loc[idx]\n        if cid in event_groups.groups:\n            ev = event_groups.get_group(cid)\n            ev_times = ev[ts_col].values.astype('datetime64[ns]')\n            ev_amounts = ev[amount_col].values if amount_col else None\n        else:\n            # No events for this customer – use empty arrays to avoid KeyError\n            ev_times = np.array([], dtype='datetime64[ns]')\n            ev_amounts = np.array([]) if amount_col else None\n\n        # Compute window boundaries (half‑open)\n        start = pt_rows[\"as_of\"] - pd.Timedelta(days=window_days)\n        lo = np.searchsorted(ev_times, start.values, side=\"left\")\n        hi = np.searchsorted(ev_times, pt_rows[\"as_of\"].values, side=\"left\")  # exclusive of as_of\n        cnt = hi - lo\n        counts[idx] = cnt\n        if amount_col:\n            row_sums = np.empty(len(idx), dtype=np.float64)\n            for i, (l, h) in enumerate(zip(lo, hi)):\n                row_sums[i] = ev_amounts[l:h].sum() i"]
