[97.80862, "i", "cat > churn/impute.py <<'EOF'\n\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\n\nThe original implementation performed a backward‑fill followed by a forward‑fill, which could\ninject future ``app_minutes_7d`` values into earlier predictions. The specification for the\n``app_minutes_7d`` feature states that we may only use the most recent earlier reading.\nTherefore we replace the logic with a simple forward‑fill (``ffill``) after sorting by\n``customer_id`` and ``as_of``.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pandas as pd\n\n\ndef fill_app_minutes(points: pd.DataFrame) -> pd.Series:\n    \"\"\"Forward‑fill missing ``app_minutes_7d`` values using the most recent earlier reading.\n\n    Parameters\n    ----------\n    points: DataFrame containing ``customer_id``, ``as_of`` and ``app_minutes_7d``.\n    Returns\n    -------\n    pandas.Series aligned with the original ``points`` index.\n    \"\"\"\n    pts = points.sort_values([\"customer_id\", \"as_of\"]).copy()\n    "]
[97.808746, "i", "filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(\"ffill\")\n    return filled.reindex(points.index)\n\nEOF\n"]
[97.808801, "o", "cat > churn/impute.py <<'EOF'\r\n\u001b[?2004l\r"]
[97.808872, "o", "\u001b[?2004h"]
[97.808919, "o", "> "]
[97.809261, "o", "\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\r\n\u001b[?2004l\r"]
[97.8093, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.80935, "o", "\u001b[?2004h> "]
[97.809921, "o", "The original implementation performed a backward‑fill followed by a forward‑fill, which could\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.810036, "o", "inject future ``app_minutes_7d`` values into earlier predictions. The specification for the\r\n\u001b[?2004l\r"]
[97.810452, "o", "\u001b[?2004h> "]
[97.810484, "o", "``app_minutes_7d`` feature states that we may only use the most recent earlier reading.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.810843, "o", "Therefore we replace the logic with a simple forward‑fill (``ffill``) after sorting by\r\n\u001b[?2004l\r\u001b[?2004h> ``customer_id`` and ``as_of``.\r\n"]
[97.810913, "o", "\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[97.810944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.810975, "o", "\u001b[?2004h> "]
[97.811301, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[97.811329, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[97.81136, "o", "> "]
[97.811546, "o", "def fill_app_minutes(points: pd.DataFrame) -> pd.Series:\r\n\u001b[?2004l\r"]
[97.811577, "o", "\u001b[?2004h> "]
[97.811934, "o", "    \"\"\"Forward‑fill missing ``app_minutes_7d`` values using the most recent earlier reading.\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.811966, "o", "> \r\n\u001b[?2004l\r"]
[97.812249, "o", "\u001b[?2004h>     Parameters\r\n\u001b[?2004l\r\u001b[?2004h>     ----------\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.812606, "o", "    points: DataFrame containing ``customer_id``, ``as_of`` and ``app_minutes_7d``.\r\n\u001b[?2004l\r\u001b[?2004h>     Returns\r\n\u001b[?2004l\r\u001b[?2004h>     -------\r\n\u001b[?2004l\r"]
[97.81265, "o", "\u001b[?2004h> "]
[97.812858, "o", "    pandas.Series aligned with the original ``points`` index.\r\n\u001b[?2004l\r"]
[97.812896, "o", "\u001b[?2004h> "]
[97.812922, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[97.812958, "o", "\u001b[?2004h> "]
[97.81319, "o", "    pts = points.sort_values([\"customer_id\", \"as_of\"]).copy()\r\n\u001b[?2004l\r"]
[97.813213, "o", "\u001b[?2004h"]
[97.813222, "o", "> "]
[97.813501, "o", "    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(\"ffill\")\r\n\u001b[?2004l\r"]
[97.813559, "o", "\u001b[?2004h> "]
[97.813681, "o", "    return filled.reindex(points.index)\r\n\u001b[?2004l\r"]
[97.813727, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.813739, "o", "\u001b[?2004h"]
[97.813786, "o", "> EOF\r\n"]
[97.81381, "o", "\u001b[?2004l\r"]
[97.815346, "o", "\u001b[?2004h"]
[97.815361, "o", "root@06fe72e0-cd7f-40a2-9ded-2df9a9bdb577:/app# "]
[98.133616, "i", "cat > churn/encoding.py <<'EOF'\n\"\"\"Target encoding of high‑cardinality categoricals (postcode districts).\n\nThe original implementation calculated the encoding using *all* label rows regardless of when the\nlabel became available. According to ``FEATURES.md`` a label row is only usable for a prediction at\ntime ``t`` if ``label_available_at < t``. The encoding must therefore be recomputed per prediction\nusing only the subset of labels that satisfy this condition.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nimport pandas as pd\n\nPRIOR_WEIGHT = 20\nDEFAULT_PRIOR = 0.05\n\n\ndef district_encoding(points: pd.DataFrame, labels: pd.DataFrame, customers: pd.DataFrame, m: int = PRIOR_WEIGHT) -> pd.Series:\n    \"\"\"Compute smoothed churn rate for each customer's postcode district.\n\n    The calculation follows ``FEATURES.md`` and respects causality – only label rows with\n    ``label_available_at`` strictly before the prediction ``as_of`` are used.\n    \"\"\"\n    # Map customer to district\n    district_map = cust"]
[98.13373, "i", "omers.set_index(\"customer_id\")[\"postcode_district\"]\n    pts = points.copy()\n    pts[\"district\"] = pts[\"customer_id\"].map(district_map)\n\n    # Prepare labels with proper datetime handling\n    lab = labels.copy()\n    lab[\"label_available_at\"] = pd.to_datetime(lab[\"label_available_at\"]).dt.tz_localize(None)\n    lab[\"district\"] = lab[\"customer_id\"].map(district_map)\n    lab = lab.sort_values(\"label_available_at\")\n\n    # Overall cumulative statistics for prior probability p\n    lab[\"overall_cum_sum\"] = lab[\"churned_30d\"].cumsum()\n    lab[\"overall_cum_cnt\"] = np.arange(1, len(lab) + 1)\n\n    # District‑specific cumulative statistics\n    lab[\"cum_sum\"] = lab.groupby(\"district\")[\"churned_30d\"].cumsum()\n    lab[\"cum_cnt\"] = lab.groupby(\"district\").cumcount() + 1\n\n    # Merge the latest available stats for each prediction (strictly before as_of)\n    merged = pd.merge_asof(\n        pts.sort_values([\"district\", \"as_of\"]),\n        lab,\n        left_on=\"as_of\",\n        right_on=\"label_available_at\",\n        by=\"district\","]
[98.133767, "i", "\n        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n\n    # Overall mean churn rate up to that point (fallback to DEFAULT_PRIOR)\n    p = merged[\"overall_cum_sum\"] / merged[\"overall_cum_cnt\"]\n    p = p.fillna(DEFAULT_PRIOR)\n\n    # District‑specific sums (s) and counts (n)\n    s = merged[\"cum_sum\"]\n    n = merged[\"cum_cnt\"]\n\n    # Smoothed encoding: (s + m * p) / (n + m)\n    te = (s + m * p) / (n + m)\n    te = te.fillna(p)  # districts with no prior labels fall back to overall prior\n\n    # Re‑align to original ordering of points\n    return te.reindex(points.index).astype(\"float64\")\n\nEOF\n"]
