[142.05089, "o", "> "]
[142.051137, "o", "    tickets_30d, _ = _window_counts(points, tickets, \"opened_at\", None, 30)\r\n\u001b[?2004l\r"]
[142.051153, "o", "\u001b[?2004h"]
[142.051173, "o", "> "]
[142.051347, "o", "    out[\"tickets_30d\"] = tickets_30d.astype(\"int64\")\r\n\u001b[?2004l\r"]
[142.051368, "o", "\u001b[?2004h"]
[142.051386, "o", "> \r\n\u001b[?2004l\r"]
[142.051404, "o", "\u001b[?2004h"]
[142.051421, "o", "> "]
[142.051716, "o", "    # days_since_last_order – strictly before as_of (original logic already correct)\r\n\u001b[?2004l\r"]
[142.051746, "o", "\u001b[?2004h"]
[142.051762, "o", "> "]
[142.052011, "o", "    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n\u001b[?2004l\r"]
[142.052029, "o", "\u001b[?2004h"]
[142.052048, "o", "> "]
[142.052304, "o", "    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n\u001b[?2004l\r"]
[142.052323, "o", "\u001b[?2004h"]
[142.05234, "o", "> "]
[142.052424, "o", "    last = pd.merge_asof(\r\n\u001b[?2004l\r"]
[142.052445, "o", "\u001b[?2004h"]
[142.052463, "o", "> "]
[142.052508, "o", "        left,\r\n\u001b[?2004l\r"]
[142.052528, "o", "\u001b[?2004h"]
[142.052546, "o", "> "]
[142.052579, "o", "        o,\r\n\u001b[?2004l\r"]
[142.052599, "o", "\u001b[?2004h"]
[142.052616, "o", "> "]
[142.052699, "o", "        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[142.05272, "o", "\u001b[?2004h"]
[142.052737, "o", "> "]
[142.05284, "o", "        right_on=\"ordered_at\",\r\n\u001b[?2004l\r"]
[142.05286, "o", "\u001b[?2004h"]
[142.052874, "o", "> "]
[142.052969, "o", "        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[142.052989, "o", "\u001b[?2004h"]
[142.053007, "o", "> "]
[142.053124, "o", "        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[142.053144, "o", "\u001b[?2004h"]
[142.053161, "o", "> "]
[142.053334, "o", "    ).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n\u001b[?2004l\r"]
[142.053354, "o", "\u001b[?2004h"]
[142.053371, "o", "> "]
[142.053655, "o", "    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[142.053675, "o", "\u001b[?2004h"]
[142.053693, "o", "> \r\n\u001b[?2004l\r"]
[142.053711, "o", "\u001b[?2004h"]
[142.053728, "o", "> "]
[142.053774, "o", "    return out\r\n\u001b[?2004l\r"]
[142.053795, "o", "\u001b[?2004h"]
[142.053812, "o", "> \r\n\u001b[?2004l\r"]
[142.05383, "o", "\u001b[?2004h"]
[142.053847, "o", "> \r\n\u001b[?2004l\r"]
[142.053869, "o", "\u001b[?2004h"]
[142.053888, "o", "> "]
[142.054145, "o", "def tenure_days(points: pd.DataFrame, customers: pd.DataFrame) -> pd.Series:\r\n\u001b[?2004l\r"]
[142.054166, "o", "\u001b[?2004h"]
[142.054183, "o", "> "]
[142.054445, "o", "    \"\"\"Tenure in days = as_of - signup_at (signup is always before as_of).\"\"\"\r\n\u001b[?2004l\r"]
[142.054466, "o", "\u001b[?2004h"]
[142.054483, "o", "> "]
[142.054787, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[142.054806, "o", "\u001b[?2004h"]
[142.054823, "o", "> "]
[142.055055, "o", "    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[142.055076, "o", "\u001b[?2004h"]
[142.055094, "o", "> \r\n\u001b[?2004l\r"]
[142.055111, "o", "\u001b[?2004h"]
[142.055129, "o", "> "]
[142.055147, "o", "EOF\r\n\u001b[?2004l\r"]
[142.05685, "o", "\u001b[?2004h"]
[142.056882, "o", "root@06fe72e0-cd7f-40a2-9ded-2df9a9bdb577:/app# "]
[142.380629, "i", "cat > churn/status.py <<'EOF'\n\"\"\"Account status from the billing system's status snapshots.\n\nThe specification requires that for a prediction at time ``t`` we use the latest snapshot\nwith ``snapshot_date < date(t)`` (the snapshot dated the same day as ``t`` is not visible).\nThe original implementation returned the globally latest snapshot per customer, causing\nleakage. This implementation uses ``merge_asof`` on the day level to enforce the rule.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pandas as pd\n\n\ndef latest_status(points: pd.DataFrame, snapshots: pd.DataFrame) -> pd.Series:\n    \"\"\"Return the status for each prediction respecting the half‑open rule.\n\n    Parameters\n    ----------\n    points: DataFrame with ``customer_id`` and ``as_of`` (datetime).\n    snapshots: DataFrame with ``customer_id``, ``snapshot_date`` (date string) and ``status``.\n    \"\"\"\n    # Normalize types\n    snapshots = snapshots.copy()\n    snapshots[\"snapshot_date\"] = pd.to_datetime(snapshots[\"snapshot_date\"]).dt.normalize()\n    p"]
[142.380728, "i", "oints = points.copy()\n    points[\"as_of\"] = pd.to_datetime(points[\"as_of\"]).dt.tz_localize(None)\n\n    # The snapshot dated D describes the end of day D, so it is only visible for predictions\n    # where date(as_of) > D. We therefore merge on the day floor and disallow exact matches.\n    points_day = points.assign(day=points[\"as_of\"].dt.floor(\"D\"))\n    points_day = points_day.sort_values([\"customer_id\", \"day\"])\n    snapshots = snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\n\n    merged = pd.merge_asof(\n        points_day,\n        snapshots,\n        left_on=\"day\",\n        right_on=\"snapshot_date\",\n        by=\"customer_id\",\n        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n    return merged[\"status\"]\n\nEOF\n"]
