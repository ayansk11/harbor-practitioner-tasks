[142.03186, "o", "\u001b[?2004h> "]
[142.032444, "o", "\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time‑since features.\r\n\u001b[?2004l\r"]
[142.032506, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.032544, "o", "\u001b[?2004h"]
[142.032576, "o", "> "]
[142.033084, "o", "The original implementation used daily aggregation with pandas ``rolling`` using ``closed=\"both\"``\r\n\u001b[?2004l\r"]
[142.033118, "o", "\u001b[?2004h"]
[142.033143, "o", "> "]
[142.033657, "o", "which mistakenly included events occurring on the prediction day. According to ``FEATURES.md``\r\n\u001b[?2004l\r"]
[142.033699, "o", "\u001b[?2004h> "]
[142.034175, "o", "windows must be half‑open ``[t‑W, t)`` – events at exactly ``t`` or later in the same day must be\r\n\u001b[?2004l\r"]
[142.034222, "o", "\u001b[?2004h> "]
[142.03459, "o", "excluded. This implementation uses per‑customer ``numpy.searchsorted`` to compute counts and\r\n\u001b[?2004l\r"]
[142.034635, "o", "\u001b[?2004h> "]
[142.034981, "o", "sums in the required half‑open intervals, handling customers with no events safely.\r\n\u001b[?2004l\r"]
[142.035021, "o", "\u001b[?2004h> "]
[142.035057, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[142.03507, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.035122, "o", "\u001b[?2004h> "]
[142.035246, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[142.035286, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.035326, "o", "\u001b[?2004h> "]
