[47.484379, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[47.484435, "o", "\u001b[?2004h> "]
[47.484528, "o", "*** Begin Patch\r\n\u001b[?2004l\r"]
