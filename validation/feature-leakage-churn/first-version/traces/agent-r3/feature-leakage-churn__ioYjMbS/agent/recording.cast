[183.466136, "i", "cat > churn/status.py <<'EOF'\n\"\"\"Account status from the billing system's status snapshots.\n\nThe specification requires that for a prediction at time ``t`` we use the latest snapshot\nwith ``snapshot_date < date(t)`` (the snapshot dated the same day as ``t`` is not visible).\nThe original implementation returned the globally latest snapshot per customer, causing\nleakage. This implementation removes any timezone information from ``as_of`` and uses\n``merge_asof`` on the day level to enforce the half‑open rule.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pandas as pd\n\n\ndef _make_naive(series: pd.Series) -> pd.Series:\n    \"\"\"Return a timezone‑naive series.\n    If the series is tz‑aware, convert to UTC then drop the tz; otherwise return as‑is.\n    \"\"\"\n    if series.dt.tz is not None:\n        # Convert to UTC then drop timezone information\n        return series.dt.tz_convert(\"UTC\").dt.tz_localize(None)\n    return series\n\n\ndef latest_status(points: pd.DataFrame, snapshots: pd.DataFrame) -> pd.Series:\n    \""]
[183.466308, "i", "\"\"Return the status for each prediction respecting the half‑open rule.\n\n    Parameters\n    ----------\n    points: DataFrame with ``customer_id`` and ``as_of`` (datetime, possibly tz‑aware).\n    snapshots: DataFrame with ``customer_id``, ``snapshot_date`` (date string) and ``status``.\n    \"\"\"\n    # Ensure snapshot dates are naive (they represent calendar dates)\n    snapshots = snapshots.copy()\n    snapshots[\"snapshot_date\"] = pd.to_datetime(snapshots[\"snapshot_date\"]).dt.normalize()\n\n    # Make ``as_of`` naive (strip any timezone) and compute the floor day\n    points = points.copy()\n    points[\"as_of\"] = _make_naive(points[\"as_of\"])\n    points_day = points.assign(day=points[\"as_of\"].dt.floor(\"D\"))\n\n    # Sort for merge_asof\n    points_day = points_day.sort_values([\"customer_id\", \"day\"])\n    snapshots = snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\n\n    merged = pd.merge_asof(\n        points_day,\n        snapshots,\n        left_on=\"day\",\n        right_on=\"snapshot_date\",\n        by=\"customer_id\",\n"]
[183.466373, "i", "        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n    return merged[\"status\"]\n\nEOF\n"]
[183.466433, "o", "cat > churn/status.py <<'EOF'\r\n\u001b[?2004l\r"]
[183.466494, "o", "\u001b[?2004h> "]
