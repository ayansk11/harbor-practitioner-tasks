[47.486055, "o", "root@06fe72e0-cd7f-40a2-9ded-2df9a9bdb577:/app# "]
[47.82975, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: churn/encoding.py\n+\"\"\"Target encoding of high‑cardinality categoricals (postcode districts).\n+\n+The original implementation calculated the encoding using *all* label rows regardless of when the\n+label became available. According to ``FEATURES.md`` a label row is only usable for a prediction at\n+time ``t`` if ``label_available_at < t``. The encoding must therefore be recomputed per prediction\n+using only the subset of labels that satisfy this condition.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import numpy as np\n+import pandas as pd\n+\n+PRIOR_WEIGHT = 20\n+DEFAULT_PRIOR = 0.05\n+\n+\n+def district_encoding(points: pd.DataFrame, labels: pd.DataFrame, customers: pd.DataFrame, m: int = PRIOR_WEIGHT) -> pd.Series:\n+    \"\"\"Compute the smoothed churn rate for each customer's postcode district.\n+\n+    The calculation follows the specification in ``FEATURES.md`` and respects causality – only\n+    label rows with ``label_available_at`` strictly before the predicti"]
[47.829788, "i", "on ``as_of`` are used.\n+    \"\"\"\n+    # Map each customer to its district\n+    district_map = customers.set_index(\"customer_id\")[\"postcode_district\"]\n+    points = points.copy()\n+    points[\"district\"] = points[\"customer_id\"].map(district_map)\n+\n+    # Prepare label data with proper datetime handling\n+    lab = labels.copy()\n+    lab[\"label_available_at\"] = pd.to_datetime(lab[\"label_available_at\"]).dt.tz_localize(None)\n+    lab[\"district\"] = lab[\"customer_id\"].map(district_map)\n+\n+    # Sort labels by availability time for cumulative statistics\n+    lab = lab.sort_values(\"label_available_at\")\n+\n+    # Overall cumulative sums for the prior probability p\n+    lab[\"overall_cum_sum\"] = lab[\"churned_30d\"].cumsum()\n+    lab[\"overall_cum_cnt\"] = np.arange(1, len(lab) + 1)\n+\n+    # District‑specific cumulative sums and counts\n+    lab[\"cum_sum\"] = lab.groupby(\"district\")[\"churned_30d\"].cumsum()\n+    lab[\"cum_cnt\"] = lab.groupby(\"district\").cumcount() + 1  # 1‑based cumulative count\n+\n+    # Merge the latest availa"]
[47.829889, "i", "ble label stats for each point (strictly before as_of)\n+    pts = points.sort_values([\"district\", \"as_of\"]).copy()\n+    merged = pd.merge_asof(\n+        pts,\n+        lab,\n+        left_on=\"as_of\",\n+        right_on=\"label_available_at\",\n+        by=\"district\",\n+        direction=\"backward\",\n+        allow_exact_matches=False,\n+    )\n+\n+    # Compute p – the overall mean churn rate up to that point (fallback to DEFAULT_PRIOR)\n+    p = merged[\"overall_cum_sum\"] / merged[\"overall_cum_cnt\"]\n+    p = p.fillna(DEFAULT_PRIOR)\n+\n+    # District‑specific statistics (s and n). When no prior label exists for the district, n is NaN.\n+    s = merged[\"cum_sum\"]\n+    n = merged[\"cum_cnt\"]\n+\n+    # Smoothed encoding per the formula: (s + m * p) / (n + m)\n+    te = (s + m * p) / (n + m)\n+    # If a district has never appeared in the label set up to ``as_of``, fall back to the overall prior p.\n+    te = te.fillna(p)\n+\n+    # Align the result back to the original order of ``points``\n+    result = te.reindex(points.index).a"]
[47.829916, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[47.829924, "i", "stype(\"float64\")\n+    return result\n+\n*** End Patch\nPATCH\n"]
[47.829958, "o", "stype(\"float64\")\r\n+    return result\r\n+\r\n*** End Patch\r\nPATCH\r\n"]
[47.829982, "o", "\u001b[?2004h"]
[47.830003, "o", "> "]
