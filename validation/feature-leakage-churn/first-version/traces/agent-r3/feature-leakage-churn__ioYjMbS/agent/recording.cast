[96.994764, "o", "> "]
[96.995125, "o", "    out[\"tickets_30d\"] = tickets_30d.astype(\"int64\")\r\n\u001b[?2004l\r"]
[96.995172, "o", "\u001b[?2004h"]
[96.995231, "o", "> \r\n\u001b[?2004l\r"]
[96.995284, "o", "\u001b[?2004h> "]
[96.995993, "o", "    # days_since_last_order – already correct in the original implementation (strictly before)\r\n\u001b[?2004l\r"]
[96.996046, "o", "\u001b[?2004h> "]
[96.996576, "o", "    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n\u001b[?2004l\r"]
[96.996625, "o", "\u001b[?2004h"]
[96.996672, "o", "> "]
[96.997174, "o", "    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n\u001b[?2004l\r"]
[96.997216, "o", "\u001b[?2004h"]
[96.997265, "o", "> "]
[96.997419, "o", "    last = pd.merge_asof(\r\n\u001b[?2004l\r"]
[96.997466, "o", "\u001b[?2004h"]
[96.997514, "o", "> "]
[96.997598, "o", "        left,\r\n\u001b[?2004l\r"]
[96.997647, "o", "\u001b[?2004h"]
[96.997699, "o", "> "]
[96.997755, "o", "        o,\r\n\u001b[?2004l\r"]
[96.997826, "o", "\u001b[?2004h> "]
[96.998018, "o", "        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[96.998067, "o", "\u001b[?2004h"]
[96.998116, "o", "> "]
[96.998311, "o", "        right_on=\"ordered_at\",\r\n\u001b[?2004l\r"]
[96.998366, "o", "\u001b[?2004h"]
[96.998414, "o", "> "]
[96.99858, "o", "        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[96.998626, "o", "\u001b[?2004h"]
[96.998673, "o", "> "]
[96.998914, "o", "        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[96.998972, "o", "\u001b[?2004h"]
[96.999022, "o", "> "]
[96.999368, "o", "    ).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n\u001b[?2004l\r"]
[96.999414, "o", "\u001b[?2004h"]
[96.999462, "o", "> "]
[97.000034, "o", "    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[97.000084, "o", "\u001b[?2004h"]
[97.000133, "o", "> \r\n\u001b[?2004l\r"]
[97.00018, "o", "\u001b[?2004h> "]
[97.000305, "o", "    return out\r\n\u001b[?2004l\r"]
[97.000355, "o", "\u001b[?2004h"]
[97.000407, "o", "> \r\n\u001b[?2004l\r"]
[97.000455, "o", "\u001b[?2004h> "]
[97.000502, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.000549, "o", "> "]
[97.001089, "o", "def tenure_days(points: pd.DataFrame, customers: pd.DataFrame) -> pd.Series:\r\n\u001b[?2004l\r"]
[97.00114, "o", "\u001b[?2004h"]
[97.001188, "o", "> "]
[97.001724, "o", "    \"\"\"Tenure in days = as_of - signup_at (signup is always before as_of).\"\"\"\r\n\u001b[?2004l\r"]
[97.001775, "o", "\u001b[?2004h"]
[97.001824, "o", "> "]
[97.002429, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[97.002474, "o", "\u001b[?2004h"]
[97.002523, "o", "> "]
[97.002977, "o", "    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n"]
[97.003061, "o", "\u001b[?2004l\r"]
[97.003114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.003167, "o", "EOF\r\n\u001b[?2004l\r"]
[97.004941, "o", "\u001b[?2004hroot@06fe72e0-cd7f-40a2-9ded-2df9a9bdb577:/app# "]
[97.440073, "i", "cat > churn/status.py <<'EOF'\n\"\"\"Account status from the billing system's status snapshots.\n\nThe specification requires that for a prediction at time ``t`` we use the latest snapshot\nwith ``snapshot_date < date(t)`` (the snapshot dated the same day as ``t`` is not visible).\nThe original implementation returned the globally latest snapshot per customer, ignoring the\nas_of timestamp, which introduced leakage.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pandas as pd\n\n\ndef latest_status(points: pd.DataFrame, snapshots: pd.DataFrame) -> pd.Series:\n    \"\"\"Return the status for each prediction respecting the half‑open rule.\n\n    Parameters\n    ----------\n    points: DataFrame containing ``customer_id`` and ``as_of`` (datetime).\n    snapshots: DataFrame with ``customer_id``, ``snapshot_date`` (date string) and ``status``.\n    \"\"\"\n    # Ensure datetime types\n    snapshots = snapshots.copy()\n    snapshots[\"snapshot_date\"] = pd.to_datetime(snapshots[\"snapshot_date\"]).dt.normalize()\n    points = points.copy()\n    p"]
[97.44017, "i", "oints[\"as_of\"] = pd.to_datetime(points[\"as_of\"]).dt.tz_localize(None)\n\n    # The snapshot dated D describes the end of day D, therefore it is visible only for\n    # predictions with as_of > D (i.e., date(as_of) > D). We use merge_asof on the day level.\n    points_day = points.assign(day=points[\"as_of\"].dt.floor(\"D\"))\n    points_day = points_day.sort_values([\"customer_id\", \"day\"])\n    snapshots = snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\n\n    merged = pd.merge_asof(\n        points_day,\n        snapshots,\n        left_on=\"day\",\n        right_on=\"snapshot_date\",\n        by=\"customer_id\",\n        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n    return merged[\"status\"]\n\nEOF\n"]
[97.440236, "o", "cat > churn/status.py <<'EOF'\r\n"]
