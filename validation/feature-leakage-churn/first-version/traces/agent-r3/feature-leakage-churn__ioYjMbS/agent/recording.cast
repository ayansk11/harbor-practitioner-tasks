[409.530061, "i", "python - <<'PY'\nimport pandas as pd, churn.extract as ext, numpy as np\n\ndef _make_naive(series: pd.Series) -> pd.Series:\n    if series.dt.tz is not None:\n        return series.dt.tz_convert('UTC').dt.tz_localize(None)\n    return series\n\nt = ext.load_extract('data')\npoints = t['scoring_points'][['customer_id','as_of']].copy()\ncustomers = t['customers']\nlabels = t['labels']\n\n# Build pts as in encoding.py\ndistrict_map = customers.set_index('customer_id')['postcode_district']\npts = points.copy()\npts['district'] = pts['customer_id'].map(district_map)\npts['as_of'] = _make_naive(pts['as_of'])\nprint('pts as_of dtype after naive conversion:', pts['as_of'].dtype)\n\nlab = labels.copy()\nlab['label_available_at'] = pd.to_datetime(lab['label_available_at']).dt.tz_localize(None)\nlab['district'] = lab['customer_id'].map(district_map)\nlab = lab.sort_values('label_available_at')\n\n# Sort pts\npts_sorted = pts.sort_values(['district','as_of']).reset_index(drop=True)\nprint('First rows of pts_sorted:')\nprint(pts_sorted.head())\n\n# At"]
[409.530186, "i", "tempt merge_asof\ntry:\n    merged = pd.merge_asof(\n        pts_sorted,\n        lab,\n        left_on='as_of',\n        right_on='label_available_at',\n        by='district',\n        direction='backward',\n        allow_exact_matches=False,\n    )\n    print('merge succeeded, merged head:')\n    print(merged.head())\nexcept Exception as e:\n    print('merge error:', e)\nPY\n"]
[409.530205, "o", "python - <<'PY'\r\n"]
