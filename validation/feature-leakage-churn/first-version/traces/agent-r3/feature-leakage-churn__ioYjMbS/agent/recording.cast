[45.177929, "o", "*** Begin Patch\r\n\u001b[?2004l\r"]
[45.177986, "o", "\u001b[?2004h> "]
[45.178342, "o", "*** Add File: churn/windows.py\r\n\u001b[?2004l\r"]
[45.178404, "o", "\u001b[?2004h"]
[45.178454, "o", "> "]
[45.179677, "o", "+\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time‑since features.\r\n\u001b[?2004l\r"]
[45.179757, "o", "\u001b[?2004h"]
[45.179806, "o", "> +\r\n\u001b[?2004l\r"]
[45.179857, "o", "\u001b[?2004h"]
[45.179931, "o", "> "]
[45.18082, "o", "+The original implementation used daily aggregation combined with pandas ``rolling`` using\r\n\u001b[?2004l\r"]
[45.180884, "o", "\u001b[?2004h"]
[45.180935, "o", "> "]
[45.181882, "o", "+``closed=\"both\"`` which inadvertently included events that occurred on the prediction day.\r\n\u001b[?2004l\r"]
[45.181939, "o", "\u001b[?2004h"]
[45.181995, "o", "> "]
[45.183067, "o", "+According to ``FEATURES.md`` the windows must be half‑open ``[t‑W, t)`` – events exactly at ``t``\r\n\u001b[?2004l\r"]
[45.183124, "o", "\u001b[?2004h"]
[45.183174, "o", "> "]
[45.184036, "o", "+must be excluded, and events later on the same calendar day must also be excluded.\r\n\u001b[?2004l\r"]
[45.184104, "o", "\u001b[?2004h"]
[45.184143, "o", "> +"]
[45.184178, "o", "\r\n\u001b[?2004l\r"]
[45.184229, "o", "\u001b[?2004h"]
[45.184282, "o", "> "]
[45.185209, "o", "+Because the data size is modest (a few thousand rows) we implement the window calculations\r\n\u001b[?2004l\r"]
[45.185266, "o", "\u001b[?2004h"]
[45.185315, "o", "> "]
[45.186242, "o", "+with a straightforward per‑customer ``numpy.searchsorted`` approach. This guarantees the\r\n\u001b[?2004l\r"]
[45.186322, "o", "\u001b[?2004h> "]
[45.18709, "o", "+correct half‑open behaviour and is fast enough for the 60‑second limit.\r\n\u001b[?2004l\r"]
[45.187162, "o", "\u001b[?2004h"]
[45.187195, "o", "> "]
[45.187241, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[45.187295, "o", "\u001b[?2004h"]
[45.187327, "o", "> "]
[45.187365, "o", "+\r\n\u001b[?2004l\r"]
[45.187393, "o", "\u001b[?2004h"]
[45.18742, "o", "> "]
[45.187797, "o", "+from __future__ import annotations\r\n\u001b[?2004l\r"]
[45.187851, "o", "\u001b[?2004h"]
[45.187888, "o", "> "]
[45.187916, "o", "+\r\n\u001b[?2004l\r"]
[45.18797, "o", "\u001b[?2004h"]
[45.187997, "o", "> "]
[45.188199, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[45.188255, "o", "\u001b[?2004h"]
[45.18829, "o", "> "]
[45.188494, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[45.18855, "o", "\u001b[?2004h"]
[45.188582, "o", "> "]
[45.188623, "o", "+\r\n\u001b[?2004l\r"]
[45.188667, "o", "\u001b[?2004h"]
[45.1887, "o", "> +"]
[45.18873, "o", "\r\n\u001b[?2004l\r"]
[45.188772, "o", "\u001b[?2004h"]
[45.188811, "o", "> "]
[45.189718, "o", "+def _window_counts(points: pd.DataFrame, events: pd.DataFrame, ts_col: str,\r\n\u001b[?2004l\r"]
[45.189805, "o", "\u001b[?2004h"]
[45.189857, "o", "> "]
[45.190603, "o", "+                   amount_col: str | None, window_days: int) -> pd.Series:\r\n\u001b[?2004l\r"]
[45.190671, "o", "\u001b[?2004h"]
[45.190709, "o", "> "]
[45.191758, "o", "+    \"\"\"Return a Series aligned with ``points`` containing the count (and optional sum) of ``events``\r\n\u001b[?2004l\r"]
[45.191831, "o", "\u001b[?2004h"]
[45.191872, "o", "> "]
[45.192893, "o", "+    that fall in the half‑open window ``[as_of - window_days, as_of)`` for each prediction row.\r\n\u001b[?2004l\r"]
[45.19294, "o", "\u001b[?2004h"]
[45.192967, "o", "> "]
[45.192994, "o", "+\r\n\u001b[?2004l\r"]
[45.193046, "o", "\u001b[?2004h"]
[45.193074, "o", "> "]
[45.19323, "o", "+    Parameters\r\n\u001b[?2004l\r"]
[45.19329, "o", "\u001b[?2004h"]
[45.19332, "o", "> "]
[45.193488, "o", "+    ----------\r\n\u001b[?2004l\r"]
[45.193546, "o", "\u001b[?2004h"]
[45.193578, "o", "> "]
[45.193699, "o", "+    points:\r\n\u001b[?2004l\r"]
[45.193755, "o", "\u001b[?2004h"]
[45.193789, "o", "> "]
[45.194591, "o", "+        DataFrame with columns ``customer_id`` and ``as_of`` (datetime64[ns]).\r\n\u001b[?2004l\r"]
[45.194647, "o", "\u001b[?2004h"]
[45.194674, "o", "> "]
[45.19481, "o", "+    events:\r\n\u001b[?2004l\r"]
[45.194876, "o", "\u001b[?2004h"]
[45.19493, "o", "> "]
[45.195883, "o", "+        DataFrame containing the event timestamps in ``ts_col`` and optionally an amount column.\r\n\u001b[?2004l\r"]
[45.195945, "o", "\u001b[?2004h"]
[45.195977, "o", "> "]
[45.196103, "o", "+    ts_col:\r\n\u001b[?2004l\r"]
[45.196162, "o", "\u001b[?2004h"]
[45.196195, "o", "> "]
[45.196715, "o", "+        Name of the timestamp column in ``events``.\r\n\u001b[?2004l\r"]
[45.196797, "o", "\u001b[?2004h"]
[45.196806, "o", "> "]
[45.196948, "o", "+    amount_col:\r\n"]
[45.196959, "o", "\u001b[?2004l\r"]
[45.197003, "o", "\u001b[?2004h"]
[45.197033, "o", "> "]
[45.197802, "o", "+        Name of the column to sum (e.g. ``amount_cents``) or ``None`` for a pure count.\r\n\u001b[?2004l\r"]
[45.197856, "o", "\u001b[?2004h"]
[45.197896, "o", "> "]
[45.198051, "o", "+    window_days:\r\n"]
[45.198069, "o", "\u001b[?2004l\r"]
[45.198104, "o", "\u001b[?2004h"]
[45.198131, "o", "> "]
[45.19855, "o", "+        Length of the trailing window in days.\r\n"]
[45.198569, "o", "\u001b[?2004l\r"]
[45.198606, "o", "\u001b[?2004h"]
[45.198636, "o", "> "]
[45.198717, "o", "+    \"\"\"\r\n"]
[45.198732, "o", "\u001b[?2004l\r"]
[45.19877, "o", "\u001b[?2004h"]
[45.1988, "o", "> "]
[45.199058, "o", "+    # Ensure proper dtypes\r\n"]
[45.199076, "o", "\u001b[?2004l\r"]
[45.199107, "o", "\u001b[?2004h"]
[45.199137, "o", "> "]
[45.199947, "o", "+    events = events[[\"customer_id\", ts_col] + ([amount_col] if amount_col else [])].copy()\r\n\u001b[?2004l\r"]
[45.199997, "o", "\u001b[?2004h"]
[45.200027, "o", "> "]
[45.20049, "o", "+    events[ts_col] = pd.to_datetime(events[ts_col])\r\n\u001b[?2004l\r"]
[45.200534, "o", "\u001b[?2004h"]
[45.200563, "o", "> "]
[45.201036, "o", "+    points = points[[\"customer_id\", \"as_of\"]].copy()\r\n"]
[45.201051, "o", "\u001b[?2004l\r"]
[45.201098, "o", "\u001b[?2004h"]
[45.201123, "o", "> "]
[45.201616, "o", "+    points[\"as_of\"] = pd.to_datetime(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[45.201666, "o", "\u001b[?2004h"]
[45.201697, "o", "> "]
[45.201719, "o", "+\r\n\u001b[?2004l\r"]
[45.201774, "o", "\u001b[?2004h"]
[45.2018, "o", "> "]
[45.202206, "o", "+    # Sort events for efficient searchsorted\r\n\u001b[?2004l\r"]
[45.202266, "o", "\u001b[?2004h"]
[45.2023, "o", "> "]
[45.202653, "o", "+    events = events.sort_values(ts_col)\r\n\u001b[?2004l\r"]
[45.202698, "o", "\u001b[?2004h"]
[45.20274, "o", "> "]
[45.202767, "o", "+\r\n\u001b[?2004l\r"]
[45.202799, "o", "\u001b[?2004h"]
[45.20283, "o", "> "]
[45.203173, "o", "+    # Prepare containers for results\r\n\u001b[?2004l\r"]
[45.20323, "o", "\u001b[?2004h"]
[45.203262, "o", "> "]
[45.203706, "o", "+    counts = np.empty(len(points), dtype=np.int64)\r\n\u001b[?2004l\r"]
[45.203756, "o", "\u001b[?2004h"]
[45.203789, "o", "> "]
[45.204459, "o", "+    sums = np.empty(len(points), dtype=np.float64) if amount_col else None\r\n\u001b[?2004l\r"]
[45.204514, "o", "\u001b[?2004h"]
[45.204536, "o", "> "]
[45.204562, "o", "+\r\n\u001b[?2004l\r"]
[45.204607, "o", "\u001b[?2004h"]
[45.204629, "o", "> "]
[45.204995, "o", "+    # Group by customer for independent searches\r\n\u001b[?2004l\r"]
[45.205044, "o", "\u001b[?2004h"]
[45.205071, "o", "> "]
[45.205424, "o", "+    point_groups = points.groupby(\"customer_id\")\r\n\u001b[?2004l\r"]
[45.205474, "o", "\u001b[?2004h"]
[45.205506, "o", "> "]
[45.205878, "o", "+    event_groups = events.groupby(\"customer_id\")\r\n\u001b[?2004l\r"]
[45.205933, "o", "\u001b[?2004h"]
[45.205962, "o", "> "]
[45.205992, "o", "+\r\n\u001b[?2004l\r"]
[45.206032, "o", "\u001b[?2004h"]
[45.206073, "o", "> "]
[45.206499, "o", "+    for cid, pt_idx in point_groups.groups.items():\r\n\u001b[?2004l\r"]
[45.206551, "o", "\u001b[?2004h"]
[45.206579, "o", "> "]
[45.206838, "o", "+        pt_rows = points.loc[pt_idx]\r\n\u001b[?2004l\r"]
[45.206902, "o", "\u001b[?2004h> "]
[45.207567, "o", "+        ev = event_groups.get_group(cid) if cid in event_groups.groups else pd.DataFrame()\r\n\u001b[?2004l\r"]
[45.207606, "o", "\u001b[?2004h"]
[45.207648, "o", "> "]
[45.207907, "o", "+        ev_times = ev[ts_col].values\r\n\u001b[?2004l\r"]
[45.207942, "o", "\u001b[?2004h"]
[45.207984, "o", "> "]
[45.208431, "o", "+        ev_amounts = ev[amount_col].values if amount_col else None\r\n\u001b[?2004l\r"]
[45.208471, "o", "\u001b[?2004h"]
[45.208491, "o", "> "]
[45.208527, "o", "+\r\n\u001b[?2004l\r"]
[45.208547, "o", "\u001b[?2004h"]
[45.20858, "o", "> "]
[45.208837, "o", "+        # Compute window boundaries\r\n\u001b[?2004l\r"]
[45.20888, "o", "\u001b[?2004h"]
[45.20891, "o", "> "]
[45.209369, "o", "+        start = pt_rows[\"as_of\"] - pd.Timedelta(days=window_days)\r\n\u001b[?2004l\r"]
[45.209408, "o", "\u001b[?2004h"]
[45.209448, "o", "> "]
[45.210151, "o", "+        # searchsorted uses side='left' for start (inclusive) and side='left' for as_of (exclusive)\r\n\u001b[?2004l\r"]
[45.2102, "o", "\u001b[?2004h"]
[45.210221, "o", "> "]
[45.2107, "o", "+        lo = np.searchsorted(ev_times, start.values, side=\"left\")\r\n\u001b[?2004l\r"]
[45.210777, "o", "\u001b[?2004h> "]
[45.212233, "o", "+        hi = np.searchsorted(ev_times, pt_rows[\"as_of\"].values, side=\"left\")\r\n\u001b[?2004l\r"]
[45.2123, "o", "\u001b[?2004h"]
[45.21237, "o", "> "]
[45.212442, "o", "+        cnt = hi - lo\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.212586, "o", "+        counts[pt_idx] = cnt\r\n\u001b[?2004l\r"]
[45.212636, "o", "\u001b[?2004h"]
[45.212688, "o", "> "]
[45.212758, "o", "+        if amount_col:\r\n\u001b[?2004l\r"]
[45.212801, "o", "\u001b[?2004h"]
[45.212851, "o", "> "]
[45.213076, "o", "+            # sum amounts in the slice for each row\r\n\u001b[?2004l\r"]
[45.213129, "o", "\u001b[?2004h> "]
[45.213426, "o", "+            row_sums = np.empty(len(pt_idx), dtype=np.float64)\r\n\u001b[?2004l\r"]
[45.213508, "o", "\u001b[?2004h> "]
[45.213747, "o", "+            for i, (l, h) in enumerate(zip(lo, hi)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.213827, "o", "> "]
[45.214122, "o", "+                row_sums[i] = ev_amounts[l:h].sum() if h > l else 0.0\r\n\u001b[?2004l\r"]
[45.214172, "o", "\u001b[?2004h> "]
[45.214345, "o", "+            sums[pt_idx] = row_sums\r\n\u001b[?2004l\r"]
[45.214383, "o", "\u001b[?2004h"]
[45.214438, "o", "> +\r\n\u001b[?2004l\r"]
[45.214475, "o", "\u001b[?2004h> "]
[45.214729, "o", "+    count_series = pd.Series(counts, index=points.index)\r\n\u001b[?2004l\r"]
[45.214777, "o", "\u001b[?2004h> "]
[45.214889, "o", "+    if amount_col:\r\n\u001b[?2004l\r"]
[45.214931, "o", "\u001b[?2004h> "]
[45.215218, "o", "+        sum_series = pd.Series(sums, index=points.index)\r\n\u001b[?2004l\r"]
[45.215271, "o", "\u001b[?2004h> "]
[45.215461, "o", "+        return count_series, sum_series\r\n\u001b[?2004l\r"]
[45.215511, "o", "\u001b[?2004h"]
[45.215551, "o", "> +    else:\r\n"]
[45.215589, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.215612, "o", "> "]
[45.215779, "o", "+        return count_series, None\r\n\u001b[?2004l\r"]
[45.215838, "o", "\u001b[?2004h"]
[45.215917, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.215963, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.216465, "o", "+def activity_features(points: pd.DataFrame, orders: pd.DataFrame, tickets: pd.DataFrame) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[45.216517, "o", "\u001b[?2004h"]
[45.216564, "o", "> "]
[45.216889, "o", "+    \"\"\"Compute the activity‑related columns required by ``FEATURES.md``.\r\n\u001b[?2004l\r"]
[45.216945, "o", "\u001b[?2004h"]
[45.217003, "o", "> +\r\n\u001b[?2004l\r"]
[45.217059, "o", "\u001b[?2004h> "]
[45.217451, "o", "+    The returned DataFrame contains the original ``customer_id`` and ``as_of`` columns plus:\r\n\u001b[?2004l\r"]
[45.217496, "o", "\u001b[?2004h"]
[45.21754, "o", "> "]
[45.218017, "o", "+    ``orders_7d``, ``orders_30d``, ``spend_30d_cents``, ``tickets_30d`` and ``days_since_last_order``.\r\n\u001b[?2004l\r"]
[45.218079, "o", "\u001b[?2004h> "]
[45.218459, "o", "+    All windows are half‑open and therefore respect the strict‑before rule.\r\n\u001b[?2004l\r"]
[45.218506, "o", "\u001b[?2004h"]
[45.218556, "o", "> "]
[45.218601, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.218663, "o", "> "]
[45.218845, "o", "+    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n\u001b[?2004l\r"]
[45.21891, "o", "\u001b[?2004h> "]
[45.218984, "o", "+\r\n\u001b[?2004l\r"]
[45.219029, "o", "\u001b[?2004h> "]
[45.219096, "o", "+    # orders count 7d\r\n\u001b[?2004l\r"]
[45.219143, "o", "\u001b[?2004h> "]
[45.219489, "o", "+    orders_7d, _ = _window_counts(points, orders, \"ordered_at\", None, 7)\r\n\u001b[?2004l\r"]
[45.219537, "o", "\u001b[?2004h"]
[45.219585, "o", "> "]
[45.219775, "o", "+    out[\"orders_7d\"] = orders_7d.astype(\"int64\")\r\n\u001b[?2004l\r"]
[45.219827, "o", "\u001b[?2004h"]
[45.21991, "o", "> +\r\n\u001b[?2004l\r"]
[45.219957, "o", "\u001b[?2004h> "]
[45.220051, "o", "+    # orders count 30d and spend\r\n\u001b[?2004l\r"]
[45.220098, "o", "\u001b[?2004h"]
[45.220155, "o", "> "]
[45.220553, "o", "+    orders_30d, spend_30d = _window_counts(points, orders, \"ordered_at\", \"amount_cents\", 30)\r\n\u001b[?2004l\r"]
[45.2206, "o", "\u001b[?2004h"]
[45.220648, "o", "> "]
[45.220853, "o", "+    out[\"orders_30d\"] = orders_30d.astype(\"int64\")\r\n\u001b[?2004l\r"]
[45.220927, "o", "\u001b[?2004h> "]
[45.221181, "o", "+    out[\"spend_30d_cents\"] = spend_30d.astype(\"int64\")\r\n\u001b[?2004l\r"]
[45.221232, "o", "\u001b[?2004h> +\r\n"]
[45.221291, "o", "\u001b[?2004l\r"]
[45.221348, "o", "\u001b[?2004h> "]
[45.221399, "o", "+    # tickets 30d\r\n\u001b[?2004l\r"]
[45.221447, "o", "\u001b[?2004h"]
[45.221503, "o", "> "]
[45.221814, "o", "+    tickets_30d, _ = _window_counts(points, tickets, \"opened_at\", None, 30)\r\n\u001b[?2004l\r"]
[45.221887, "o", "\u001b[?2004h"]
[45.221948, "o", "> "]
[45.222131, "o", "+    out[\"tickets_30d\"] = tickets_30d.astype(\"int64\")\r\n\u001b[?2004l\r"]
[45.222183, "o", "\u001b[?2004h"]
[45.222244, "o", "> +\r\n\u001b[?2004l\r"]
[45.222287, "o", "\u001b[?2004h> "]
[45.22269, "o", "+    # days_since_last_order – strictly before as_of (already correct in original code)\r\n\u001b[?2004l\r"]
[45.222777, "o", "\u001b[?2004h> "]
[45.223049, "o", "+    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n\u001b[?2004l\r"]
[45.223126, "o", "\u001b[?2004h> "]
[45.223339, "o", "+    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n\u001b[?2004l\r"]
[45.223379, "o", "\u001b[?2004h"]
[45.223424, "o", "> "]
[45.223471, "o", "+    last = pd.merge_asof(\r\n\u001b[?2004l\r"]
[45.223511, "o", "\u001b[?2004h> "]
[45.223559, "o", "+        left,\r\n\u001b[?2004l\r"]
[45.223595, "o", "\u001b[?2004h> "]
[45.223631, "o", "+        o,\r\n\u001b[?2004l\r"]
[45.223677, "o", "\u001b[?2004h> "]
[45.22376, "o", "+        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[45.223799, "o", "\u001b[?2004h> "]
[45.22391, "o", "+        right_on=\"ordered_at\",\r\n\u001b[?2004l\r"]
[45.223958, "o", "\u001b[?2004h> "]
[45.224033, "o", "+        by=\"customer_id\",\r\n\u001b[?2004l\r"]
[45.224103, "o", "\u001b[?2004h> "]
[45.224191, "o", "+        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[45.224232, "o", "\u001b[?2004h"]
[45.224271, "o", "> "]
[45.224411, "o", "+    ).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n\u001b[?2004l\r"]
[45.224452, "o", "\u001b[?2004h> "]
[45.224735, "o", "+    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[45.224778, "o", "\u001b[?2004h> "]
[45.224819, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.224857, "o", "> "]
[45.224919, "o", "+    return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.224959, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.224995, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.225265, "o", "+def tenure_days(points: pd.DataFrame, customers: pd.DataFrame) -> pd.Series:\r\n\u001b[?2004l\r"]
[45.225309, "o", "\u001b[?2004h"]
[45.225347, "o", "> "]
[45.225635, "o", "+    \"\"\"Return tenure in days = as_of - signup_at (strictly before not required for signup).\"\"\"\r\n\u001b[?2004l\r"]
[45.225684, "o", "\u001b[?2004h"]
[45.22573, "o", "> "]
[45.225982, "o", "+    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[45.226032, "o", "\u001b[?2004h> "]
[45.226247, "o", "+    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[45.226299, "o", "\u001b[?2004h> "]
[45.226338, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.226384, "o", "*** End Patch\r\n"]
[45.226439, "o", "\u001b[?2004l\r\u001b[?2004h> "]
