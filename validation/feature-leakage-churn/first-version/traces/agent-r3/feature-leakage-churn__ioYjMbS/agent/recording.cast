[96.976119, "o", "        ev = event_groups.get_group(cid) if cid in event_groups.groups else pd.DataFrame()\r\n\u001b[?2004l\r"]
[96.976168, "o", "\u001b[?2004h"]
[96.976207, "o", "> "]
