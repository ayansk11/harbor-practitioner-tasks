[304.497161, "i", "python - <<'PY'\nimport pandas as pd, churn.extract as ext\nt = ext.load_extract('data')\npoints = t['scoring_points'][['customer_id','as_of']].copy()\npoints['as_of'] = pd.to_datetime(points['as_of'])\n# apply the naive conversion as in latest_status\nif points['as_of'].dt.tz is not None:\n    points['as_of'] = points['as_of'].dt.tz_convert('UTC').dt.tz_localize(None)\npoints_day = points.assign(day=points['as_of'].dt.floor('D'))\npoints_day = points_day.sort_values(['customer_id','day']).reset_index(drop=True)\nprint('points_day dtypes:', points_day.dtypes)\nprint(points_day.head())\nsnapshots = t['status_snapshots'].copy()\nsnapshots['snapshot_date'] = pd.to_datetime(snapshots['snapshot_date']).dt.normalize().dt.tz_localize(None)\nsnapshots = snapshots.sort_values(['customer_id','snapshot_date']).reset_index(drop=True)\nprint('snapshots dtypes:', snapshots.dtypes)\nprint(snapshots.head())\nPY\n"]
[304.497425, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[304.497541, "o", "\u001b[?2004h"]
[304.497602, "o", "> "]
[304.497967, "o", "import pandas as pd, churn.extract as ext\r\n\u001b[?2004l\r"]
[304.49803, "o", "\u001b[?2004h"]
