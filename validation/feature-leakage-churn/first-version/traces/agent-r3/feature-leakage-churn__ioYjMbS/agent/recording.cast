[96.948791, "i", "cat > churn/windows.py <<'EOF'\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time‑since features.\n\nThe original implementation used daily aggregation combined with pandas ``rolling`` using\n``closed=\\\"both\\\"`` which inadvertently included events that occurred on the prediction day.\nAccording to ``FEATURES.md`` the windows must be half‑open ``[t‑W, t)`` – events exactly at ``t``\nmust be excluded, and events later on the same calendar day must also be excluded.\nBecause the data size is modest (a few thousand rows) we implement the window calculations\nwith a straightforward per‑customer ``numpy.searchsorted`` approach. This guarantees the\ncorrect half‑open behaviour and is fast enough for the 60‑second limit.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nimport pandas as pd\n\n\ndef _window_counts(points: pd.DataFrame, events: pd.DataFrame, ts_col: str,\n                   amount_col: str | None, window_days: int) -> tuple[pd.Series, pd.Series | None]:\n    "]
[96.94883, "i", "\"\"\"Return count (and optional sum) series for events in ``[as_of‑W, as_of)``.\n\n    Parameters\n    ----------\n    points: DataFrame with ``customer_id`` and ``as_of`` columns.\n    events: DataFrame containing the event timestamps in ``ts_col`` and optionally an amount column.\n    ts_col: Name of the timestamp column in ``events``.\n    amount_col: Column to sum (e.g. ``amount_cents``) or ``None`` for count only.\n    window_days: Length of the trailing window in days.\n    \"\"\"\n    # Prepare minimal columns and ensure datetime types\n    events = events[[\"customer_id\", ts_col] + ([amount_col] if amount_col else [])].copy()\n    events[ts_col] = pd.to_datetime(events[ts_col])\n    points = points[[\"customer_id\", \"as_of\"]].copy()\n    points[\"as_of\"] = pd.to_datetime(points[\"as_of\"])\n\n    # Sort events for binary search\n    events = events.sort_values(ts_col)\n\n    # Containers for results\n    counts = np.empty(len(points), dtype=np.int64)\n    sums = np.empty(len(points), dtype=np.float64) if amount_col else None\n\n    "]
[96.948843, "i", "# Group by customer\n    point_groups = points.groupby(\"customer_id\")\n    event_groups = events.groupby(\"customer_id\")\n\n    for cid, idx in point_groups.groups.items():\n        pt_rows = points.loc[idx]\n        ev = event_groups.get_group(cid) if cid in event_groups.groups else pd.DataFrame()\n        ev_times = ev[ts_col].values\n        ev_amounts = ev[amount_col].values if amount_col else None\n        # Compute window boundaries\n        start = pt_rows[\"as_of\"] - pd.Timedelta(days=window_days)\n        lo = np.searchsorted(ev_times, start.values, side=\"left\")\n        hi = np.searchsorted(ev_times, pt_rows[\"as_of\"].values, side=\"left\")  # exclusive of as_of\n        cnt = hi - lo\n        counts[idx] = cnt\n        if amount_col:\n            row_sums = np.empty(len(idx), dtype=np.float64)\n            for i, (l, h) in enumerate(zip(lo, hi)):\n                row_sums[i] = ev_amounts[l:h].sum() if h > l else 0.0\n            sums[idx] = row_sums\n\n    count_series = pd.Series(counts, index=points.index)\n    sum_series "]
[96.948961, "i", "= pd.Series(sums, index=points.index) if amount_col else None\n    return count_series, sum_series\n\n\ndef activity_features(points: pd.DataFrame, orders: pd.DataFrame, tickets: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Compute activity‑related columns required by ``FEATURES.md``.\n\n    Returns a DataFrame with ``customer_id``, ``as_of`` and the five activity features.\n    All windows are half‑open, satisfying the strict‑before rule.\n    \"\"\"\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n\n    # orders in last 7 days (count only)\n    orders_7d, _ = _window_counts(points, orders, \"ordered_at\", None, 7)\n    out[\"orders_7d\"] = orders_7d.astype(\"int64\")\n\n    # orders in last 30 days and spend\n    orders_30d, spend_30d = _window_counts(points, orders, \"ordered_at\", \"amount_cents\", 30)\n    out[\"orders_30d\"] = orders_30d.astype(\"int64\")\n    out[\"spend_30d_cents\"] = spend_30d.astype(\"int64\")\n\n    # tickets in last 30 days (count only)\n    tickets_30d, _ = _window_counts(points, tickets, \"opened_at\", None, 30)\n    ou"]
[96.949065, "i", "t[\"tickets_30d\"] = tickets_30d.astype(\"int64\")\n\n    # days_since_last_order – already correct in the original implementation (strictly before)\n    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\n    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\n    last = pd.merge_asof(\n        left,\n        o,\n        left_on=\"as_of\",\n        right_on=\"ordered_at\",\n        by=\"customer_id\",\n        allow_exact_matches=False,\n    ).set_index(\"index\").sort_index()[\"ordered_at\"]\n    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\n\n    return out\n\n\ndef tenure_days(points: pd.DataFrame, customers: pd.DataFrame) -> pd.Series:\n    \"\"\"Tenure in days = as_of - signup_at (signup is always before as_of).\"\"\"\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\n    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\n\nEOF\n"]
