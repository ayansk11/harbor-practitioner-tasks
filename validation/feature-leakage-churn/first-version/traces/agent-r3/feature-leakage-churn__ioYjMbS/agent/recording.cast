[396.697346, "o", "   customer_id                     as_of trigger  app_minutes_7d\r\n0       100001 2025-04-13 06:00:00+00:00   batch             NaN\r\n1       100001 2025-04-27 06:00:00+00:00   batch            56.0\r\n2       100001 2025-05-11 06:00:00+00:00   batch             NaN\r\n3       100001 2025-05-25 06:00:00+00:00   batch            52.0\r\n4       100001 2025-06-08 06:00:00+00:00   batch            59.0\r\n"]
