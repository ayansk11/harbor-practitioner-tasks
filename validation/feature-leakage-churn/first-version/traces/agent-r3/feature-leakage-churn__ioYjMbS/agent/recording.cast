[479.245155, "o", "    lab[\"overall_cum_cnt\"] = np.arange(1, len(lab) + 1)\r\n"]
[479.245175, "o", "\u001b[?2004l\r"]
[479.245238, "o", "\u001b[?2004h"]
[479.24528, "o", "> "]
[479.245766, "o", "    # District‑specific cumulative sum and count\r\n"]
[479.245775, "o", "\u001b[?2004l\r"]
[479.245957, "o", "\u001b[?2004h> "]
[479.246526, "o", "    lab[\"cum_sum\"] = lab.groupby(\"district\")[\"churned_30d\"].cumsum()\r\n"]
[479.246536, "o", "\u001b[?2004l\r"]
[479.246588, "o", "\u001b[?2004h"]
[479.246628, "o", "> "]
[479.247184, "o", "    lab[\"cum_cnt\"] = lab.groupby(\"district\").cumcount() + 1\r\n\u001b[?2004l\r"]
[479.247253, "o", "\u001b[?2004h"]
[479.247286, "o", "> "]
[479.247303, "o", "\r\n\u001b[?2004l\r"]
[479.247467, "o", "\u001b[?2004h> "]
[479.247934, "o", "    # Ensure prediction timestamps are naive as well\r\n\u001b[?2004l\r"]
[479.247997, "o", "\u001b[?2004h"]
[479.248043, "o", "> "]
[479.248454, "o", "    pts[\"as_of\"] = _make_naive(pts[\"as_of\"])\r\n"]
[479.24847, "o", "\u001b[?2004l\r"]
[479.248522, "o", "\u001b[?2004h"]
[479.248575, "o", "> \r\n\u001b[?2004l\r"]
[479.248639, "o", "\u001b[?2004h"]
[479.248692, "o", "> "]
[479.249145, "o", "    # Preserve original ordering to restore later\r\n"]
[479.249162, "o", "\u001b[?2004l\r"]
[479.249211, "o", "\u001b[?2004h"]
[479.249267, "o", "> "]
[479.24953, "o", "    original_idx = pts.index\r\n"]
[479.249546, "o", "\u001b[?2004l\r"]
[479.249594, "o", "\u001b[?2004h"]
[479.249635, "o", "> "]
[479.249683, "o", "\r\n\u001b[?2004l\r"]
[479.249741, "o", "\u001b[?2004h"]
[479.249792, "o", "> "]
[479.250556, "o", "    # Sort left DataFrame globally by the merge key (as_of) – required by merge_asof\r\n"]
[479.250574, "o", "\u001b[?2004l\r"]
[479.250637, "o", "\u001b[?2004h"]
[479.250683, "o", "> "]
[479.251273, "o", "    pts_sorted = pts.sort_values(\"as_of\").reset_index(drop=True)\r\n\u001b[?2004l\r"]
[479.251336, "o", "\u001b[?2004h"]
[479.251385, "o", "> "]
[479.251402, "o", "\r\n\u001b[?2004l\r"]
[479.251452, "o", "\u001b[?2004h"]
[479.251496, "o", "> "]
[479.252043, "o", "    # Perform asof merge using district as grouping key\r\n\u001b[?2004l\r"]
[479.252155, "o", "\u001b[?2004h"]
[479.252208, "o", "> "]
[479.252433, "o", "    merged = pd.merge_asof(\r\n"]
[479.252483, "o", "\u001b[?2004l\r"]
[479.252535, "o", "\u001b[?2004h"]
[479.252584, "o", "> "]
[479.252744, "o", "        pts_sorted,\r\n\u001b[?2004l\r"]
[479.25281, "o", "\u001b[?2004h"]
[479.252859, "o", "> "]
[479.252994, "o", "        lab,\r\n\u001b[?2004l\r"]
[479.253057, "o", "\u001b[?2004h"]
[479.253105, "o", "> "]
[479.253332, "o", "        left_on=\"as_of\",\r\n\u001b[?2004l\r"]
[479.253394, "o", "\u001b[?2004h"]
[479.253441, "o", "> "]
[479.253788, "o", "        right_on=\"label_available_at\",\r\n\u001b[?2004l\r"]
[479.253854, "o", "\u001b[?2004h"]
[479.253918, "o", "> "]
[479.254123, "o", "        by=\"district\",\r\n\u001b[?2004l\r"]
[479.254188, "o", "\u001b[?2004h"]
[479.254225, "o", "> "]
[479.254504, "o", "        direction=\"backward\",\r\n\u001b[?2004l\r"]
[479.254569, "o", "\u001b[?2004h"]
[479.254615, "o", "> "]
[479.254946, "o", "        allow_exact_matches=False,\r\n\u001b[?2004l\r"]
[479.25501, "o", "\u001b[?2004h"]
[479.255057, "o", "> "]
[479.255121, "o", "    )\r\n\u001b[?2004l\r"]
[479.255207, "o", "\u001b[?2004h"]
[479.255271, "o", "> \r\n\u001b[?2004l\r"]
[479.255324, "o", "\u001b[?2004h"]
[479.255373, "o", "> "]
[479.256068, "o", "    # Overall mean churn rate up to that point (fallback to DEFAULT_PRIOR)\r\n\u001b[?2004l\r"]
[479.256122, "o", "\u001b[?2004h"]
[479.256177, "o", "> "]
[479.256838, "o", "    p = merged[\"overall_cum_sum\"] / merged[\"overall_cum_cnt\"]\r\n"]
[479.256855, "o", "\u001b[?2004l\r"]
[479.256947, "o", "\u001b[?2004h"]
[479.257004, "o", "> "]
[479.257277, "o", "    p = p.fillna(DEFAULT_PRIOR)\r\n\u001b[?2004l\r"]
[479.257349, "o", "\u001b[?2004h"]
[479.257404, "o", "> \r\n\u001b[?2004l\r"]
[479.257449, "o", "\u001b[?2004h"]
[479.257503, "o", "> "]
[479.257953, "o", "    # District‑specific sums (s) and counts (n)\r\n\u001b[?2004l\r"]
[479.258017, "o", "\u001b[?2004h"]
[479.258073, "o", "> "]
[479.258301, "o", "    s = merged[\"cum_sum\"]\r\n\u001b[?2004l\r"]
[479.258364, "o", "\u001b[?2004h"]
[479.258406, "o", "> "]
[479.258678, "o", "    n = merged[\"cum_cnt\"]\r\n"]
[479.258745, "o", "\u001b[?2004l\r"]
[479.258788, "o", "\u001b[?2004h"]
[479.258844, "o", "> \r\n\u001b[?2004l\r"]
[479.258899, "o", "\u001b[?2004h"]
[479.258956, "o", "> "]
[479.259347, "o", "    # Smoothed encoding: (s + m * p) / (n + m)\r\n\u001b[?2004l\r"]
[479.259412, "o", "\u001b[?2004h"]
[479.259464, "o", "> "]
[479.259755, "o", "    te = (s + m * p) / (n + m)\r\n\u001b[?2004l\r"]
[479.259824, "o", "\u001b[?2004h"]
[479.25992, "o", "> "]
[479.260515, "o", "    te = te.fillna(p)  # fallback for districts with no prior label data\r\n\u001b[?2004l\r"]
[479.260571, "o", "\u001b[?2004h"]
[479.260608, "o", "> "]
[479.260645, "o", "\r\n\u001b[?2004l\r"]
[479.260681, "o", "\u001b[?2004h"]
[479.260718, "o", "> "]
[479.261328, "o", "    # Re‑align to the original row order of the input points DataFrame\r\n\u001b[?2004l\r"]
[479.261384, "o", "\u001b[?2004h"]
[479.261424, "o", "> "]
[479.261968, "o", "    te_aligned = pd.Series(te.values, index=pts_sorted.index)\r\n\u001b[?2004l\r"]
[479.262019, "o", "\u001b[?2004h"]
[479.262073, "o", "> "]
[479.262611, "o", "    result = te_aligned.reindex(original_idx).astype(\"float64\")\r\n\u001b[?2004l\r"]
[479.262666, "o", "\u001b[?2004h"]
[479.262704, "o", "> "]
[479.262858, "o", "    return result\r\n\u001b[?2004l\r"]
[479.262923, "o", "\u001b[?2004h"]
[479.262974, "o", "> \r\n\u001b[?2004l\r"]
[479.263019, "o", "\u001b[?2004h"]
[479.263059, "o", "> "]
[479.263103, "o", "EOF\r\n"]
[479.263147, "o", "\u001b[?2004l\r"]
[479.26615, "o", "\u001b[?2004h"]
[479.266191, "o", "root@06fe72e0-cd7f-40a2-9ded-2df9a9bdb577:/app# "]
[479.590666, "i", "python -m churn.build_features --data data --out fixed_features.parquet\n"]
[479.590969, "o", "python -m churn.build_features --data data --out fixed_features.parquet\r\n"]
[479.591006, "o", "\u001b[?2004l\r"]
[483.162171, "o", "wrote 48966 rows x 11 columns to fixed_features.parquet\r\n"]
[483.223053, "o", "\u001b[?2004hroot@06fe72e0-cd7f-40a2-9ded-2df9a9bdb577:/app# "]
[509.589341, "i", "ls -lh fixed_features.parquet\n"]
[509.589701, "o", "ls -lh fixed_features.parquet\r\n\u001b[?2004l\r"]
[509.59146, "o", "-rw-r--r-- 1 root root 1.2M Oct 30 14:46 fixed_features.parquet\r\n"]
