[47.1405, "o", "\u001b[?2004h"]
[47.140534, "o", "> "]
[47.141159, "o", "+        A Series aligned with ``points`` containing the filled values.\r\n\u001b[?2004l\r"]
[47.141207, "o", "\u001b[?2004h"]
[47.141239, "o", "> "]
[47.14132, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[47.141378, "o", "\u001b[?2004h"]
[47.141408, "o", "> "]
[47.141966, "o", "+    pts = points.sort_values([\"customer_id\", \"as_of\"]).copy()\r\n\u001b[?2004l\r"]
[47.142018, "o", "\u001b[?2004h"]
[47.142049, "o", "> "]
[47.142907, "o", "+    # Forward fill propagates the last known value forward; do not backfill to avoid using future data.\r\n\u001b[?2004l\r"]
[47.142962, "o", "\u001b[?2004h"]
[47.142997, "o", "> "]
[47.143538, "o", "+    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(\"ffill\")\r\n\u001b[?2004l\r"]
[47.143577, "o", "\u001b[?2004h"]
[47.143598, "o", "> "]
[47.14392, "o", "+    return filled.reindex(points.index)\r\n\u001b[?2004l\r"]
[47.143962, "o", "\u001b[?2004h"]
[47.143984, "o", "> "]
[47.144012, "o", "+\r\n\u001b[?2004l\r"]
[47.144056, "o", "\u001b[?2004h"]
[47.144084, "o", "> "]
[47.144184, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[47.144223, "o", "\u001b[?2004h"]
[47.144244, "o", "> "]
