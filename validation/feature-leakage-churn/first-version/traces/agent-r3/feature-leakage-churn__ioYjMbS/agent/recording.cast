[47.128438, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: churn/impute.py\n+\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\n+\n+The original implementation performed a backward‑fill followed by a forward‑fill, which could\n+inject future ``app_minutes_7d`` values into earlier predictions. The specification for the\n+``app_minutes_7d`` feature states that we may only use the most recent earlier reading.\n+Therefore we replace the logic with a simple forward‑fill (``ffill``) after sorting by\n+``customer_id`` and ``as_of``.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import pandas as pd\n+\n+\n+def fill_app_minutes(points: pd.DataFrame) -> pd.Series:\n+    \"\"\"Fill missing ``app_minutes_7d`` from the most recent *earlier* reading for the same customer.\n+\n+    Parameters\n+    ----------\n+    points:\n+        The ``scoring_points`` DataFrame (must contain ``customer_id``, ``as_of`` and\n+        ``app_minutes_7d`` columns).\n+    Returns\n+    -------\n+    pandas.Serie"]
[47.128473, "i", "s\n+        A Series aligned with ``points`` containing the filled values.\n+    \"\"\"\n+    pts = points.sort_values([\"customer_id\", \"as_of\"]).copy()\n+    # Forward fill propagates the last known value forward; do not backfill to avoid using future data.\n+    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(\"ffill\")\n+    return filled.reindex(points.index)\n+\n*** End Patch\nPATCH\n"]
[47.128742, "o", "apply_patch <<'PATCH'\r\n"]
