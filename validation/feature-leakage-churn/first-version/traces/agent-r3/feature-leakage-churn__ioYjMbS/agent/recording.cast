[46.432502, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: churn/status.py\n+\"\"\"Account status from the billing system's status snapshots.\n+\n+The specification requires that for a prediction at time ``t`` we use the latest snapshot\n+with ``snapshot_date < date(t)`` (the snapshot dated the same day as ``t`` is not visible).\n+The original implementation returned the globally latest snapshot per customer, ignoring the\n+as_of timestamp, which introduced leakage.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import pandas as pd\n+\n+\n+def latest_status(points: pd.DataFrame, snapshots: pd.DataFrame) -> pd.Series:\n+    \"\"\"Return a Series of status values respecting the half‑open rule.\n+\n+    Parameters\n+    ----------\n+    points:\n+        DataFrame containing ``customer_id`` and ``as_of`` (datetime).\n+    snapshots:\n+        DataFrame with ``customer_id``, ``snapshot_date`` (YYYY‑MM‑DD string or date) and ``status``.\n+    \"\"\"\n+    # Ensure proper datetime types\n+    snapshots = snapshots.copy()\n+    snapshots[\"snapshot"]
[46.432538, "i", "_date\"] = pd.to_datetime(snapshots[\"snapshot_date\"]).dt.normalize()\n+    points = points.copy()\n+    points[\"as_of\"] = pd.to_datetime(points[\"as_of\"]).dt.tz_localize(None)\n+    # Convert as_of to the date that the snapshot would represent (the end of that day).\n+    # We need the date *strictly before* that day, so we take the floor date and use\n+    # merge_asof with allow_exact_matches=False.\n+    points_day = points.assign(day=points[\"as_of\"].dt.floor(\"D\"))\n+\n+    # Sort both sides for merge_asof\n+    points_day = points_day.sort_values([\"customer_id\", \"day\"])\n+    snapshots = snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\n+\n+    merged = pd.merge_asof(\n+        points_day,\n+        snapshots,\n+        left_on=\"day\",\n+        right_on=\"snapshot_date\",\n+        by=\"customer_id\",\n+        direction=\"backward\",\n+        allow_exact_matches=False,\n+    )\n+    return merged[\"status\"]\n+\n*** End Patch\nPATCH\n"]
