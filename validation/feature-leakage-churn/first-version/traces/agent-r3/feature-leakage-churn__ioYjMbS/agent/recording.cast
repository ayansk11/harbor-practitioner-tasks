[360.16586, "i", "cat > churn/encoding.py <<'EOF'\n\"\"\"Target encoding of high‑cardinality categoricals (postcode districts).\n\nThe original implementation calculated the encoding using *all* label rows regardless of when the\nlabel became available. According to ``FEATURES.md`` a label row is only usable for a prediction at\ntime ``t`` if ``label_available_at < t``. The encoding must therefore be recomputed per prediction\nusing only the subset of labels that satisfy this condition.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nimport pandas as pd\n\nPRIOR_WEIGHT = 20\nDEFAULT_PRIOR = 0.05\n\n\ndef _make_naive(series: pd.Series) -> pd.Series:\n    \"\"\"Return a timezone‑naive series.\n    If the series is tz‑aware, convert to UTC then drop the timezone; otherwise return as‑is.\n    \"\"\"\n    if series.dt.tz is not None:\n        return series.dt.tz_convert(\"UTC\").dt.tz_localize(None)\n    return series\n\n\ndef district_encoding(points: pd.DataFrame, labels: pd.DataFrame, customers: pd.DataFrame, m: int = PRIOR_WEIGHT) -> pd.Se"]
[360.166007, "i", "ries:\n    \"\"\"Compute smoothed churn rate for each customer's postcode district.\n\n    The calculation follows ``FEATURES.md`` and respects causality – only label rows with\n    ``label_available_at`` strictly before the prediction ``as_of`` are used.\n    \"\"\"\n    # Map customer to district\n    district_map = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    pts = points.copy()\n    pts[\"district\"] = pts[\"customer_id\"].map(district_map)\n\n    # Prepare labels with proper datetime handling (make naive)\n    lab = labels.copy()\n    lab[\"label_available_at\"] = pd.to_datetime(lab[\"label_available_at\"]).dt.tz_localize(None)\n    lab[\"district\"] = lab[\"customer_id\"].map(district_map)\n    lab = lab.sort_values(\"label_available_at\")\n\n    # Ensure the prediction timestamps are naive as well\n    pts[\"as_of\"] = _make_naive(pts[\"as_of\"])\n\n    # Overall cumulative statistics for prior probability p\n    lab[\"overall_cum_sum\"] = lab[\"churned_30d\"].cumsum()\n    lab[\"overall_cum_cnt\"] = np.arange(1, len(lab) + 1)\n\n    # D"]
[360.166076, "o", "cat > churn/encoding.py <<'EOF'\r\n\u001b[?2004l\r"]
[360.166117, "i", "istrict‑specific cumulative statistics\n    lab[\"cum_sum\"] = lab.groupby(\"district\")[\"churned_30d\"].cumsum()\n    lab[\"cum_cnt\"] = lab.groupby(\"district\").cumcount() + 1\n\n    # Merge the latest available stats for each prediction (strictly before as_of)\n    merged = pd.merge_asof(\n        pts.sort_values([\"district\", \"as_of\"]),\n        lab,\n        left_on=\"as_of\",\n        right_on=\"label_available_at\",\n        by=\"district\",\n        direction=\"backward\",\n        allow_exact_matches=False,\n    )\n\n    # Overall mean churn rate up to that point (fallback to DEFAULT_PRIOR)\n    p = merged[\"overall_cum_sum\"] / merged[\"overall_cum_cnt\"]\n    p = p.fillna(DEFAULT_PRIOR)\n\n    # District‑specific sums (s) and counts (n)\n    s = merged[\"cum_sum\"]\n    n = merged[\"cum_cnt\"]\n\n    # Smoothed encoding: (s + m * p) / (n + m)\n    te = (s + m * p) / (n + m)\n    te = te.fillna(p)  # districts with no prior labels fall back to overall prior\n\n    # Re‑align to original ordering of points\n    return te.reindex(points.index).ast"]
[360.166169, "o", "\u001b[?2004h> "]
[360.166211, "i", "ype(\"float64\")\n\nEOF\n"]
