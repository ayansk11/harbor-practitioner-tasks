[?2004l[?2004h>     ``label_available_at`` strictly before the prediction ``as_of`` are used.
[?2004l[?2004h>     """
[?2004l[?2004h>     # Map each customer to its district
[?2004l[?2004h>     district_map = customers.set_index("customer_id")["postcode_district"]
[?2004l[?2004h>     pts = points.copy()
[?2004l[?2004h>     pts["district"] = pts["customer_id"].map(district_map)
[?2004l[?2004h> 
[?2004l[?2004h>     # Prepare labels with naive timestamps
[?2004l[?2004h>     lab = labels.copy()
[?2004l[?2004h>     lab["label_available_at"] = pd.to_datetime(lab["label_available_at"]).dt.tz_localize(None)
[?2004l[?2004h>     lab["district"] = lab["customer_id"].map(district_map)
[?2004l[?2004h>     lab = lab.sort_values("label_available_at")
[?2004l[?2004h> 
[?2004l[?2004h>     # Compute cumulative statistics required for the encoding
[?2004l[?2004h>     # Overall cumulative sum and count (for the prior probability p)
[?2004l[?2004h>     lab["overall_cum_sum"] = lab["churned_30d"].cumsum()
[?2004l[?2004h>     lab["overall_cum_cnt"] = np.arange(1, len(lab) + 1)
[?2004l[?2004h>     # District‑specific cumulative sum and count
[?2004l[?2004h>     lab["cum_sum"] = lab.groupby("district")["churned_30d"].cumsum()
[?2004l[?2004h>     lab["cum_cnt"] = lab.groupby("district").cumcount() + 1
[?2004l[?2004h> 
[?2004l[?2004h>     # Ensure prediction timestamps are naive as well
[?2004l[?2004h>     pts["as_of"] = _make_naive(pts["as_of"])
[?2004l[?2004h> 
[?2004l[?2004h>     # Preserve original ordering to restore later
[?2004l[?2004h>     original_idx = pts.index
[?2004l[?2004h> 
[?2004l[?2004h>     # Sort left DataFrame globally by the merge key (as_of) – required by merge_asof
[?2004l[?2004h>     pts_sorted = pts.sort_values("as_of").reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h>     # Perform asof merge using district as grouping key
[?2004l[?2004h>     merged = pd.merge_asof(
[?2004l[?2004h>         pts_sorted,
[?2004l[?2004h>         lab,
[?2004l[?2004h>         left_on="as_of",
[?2004l[?2004h>         right_on="label_available_at",
[?2004l[?2004h>         by="district",
[?2004l[?2004h>         direction="backward",
[?2004l[?2004h>         allow_exact_matches=False,
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # Overall mean churn rate up to that point (fallback to DEFAULT_PRIOR)
[?2004l[?2004h>     p = merged["overall_cum_sum"] / merged["overall_cum_cnt"]
[?2004l[?2004h>     p = p.fillna(DEFAULT_PRIOR)
[?2004l[?2004h> 
[?2004l[?2004h>     # District‑specific sums (s) and counts (n)
[?2004l[?2004h>     s = merged["cum_sum"]
[?2004l[?2004h>     n = merged["cum_cnt"]
[?2004l[?2004h> 
[?2004l[?2004h>     # Smoothed encoding: (s + m * p) / (n + m)
[?2004l[?2004h>     te = (s + m * p) / (n + m)
[?2004l[?2004h>     te = te.fillna(p)  # fallback for districts with no prior label data
[?2004l[?2004h> 
[?2004l[?2004h>     # Re‑align to the original row order of the input points DataFrame
[?2004l[?2004h>     te_aligned = pd.Series(te.values, index=pts_sorted.index)
[?2004l[?2004h>     result = te_aligned.reindex(original_idx).astype("float64")
[?2004l[?2004h>     return result
