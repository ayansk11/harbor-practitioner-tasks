[?2004l[?2004h> +"""Target encoding of high‑cardinality categoricals (postcode districts).
[?2004l[?2004h> +
[?2004l[?2004h> +The original implementation calculated the encoding using *all* label rows regardless of when the
[?2004l[?2004h> +label became available. According to ``FEATURES.md`` a label row is only usable for a prediction at
[?2004l[?2004h> +time ``t`` if ``label_available_at < t``. The encoding must therefore be recomputed per prediction
[?2004l[?2004h> +using only the subset of labels that satisfy this condition.
[?2004l[?2004h> +"""
[?2004l[?2004h> +
[?2004l[?2004h> +from __future__ import annotations
[?2004l[?2004h> +
[?2004l[?2004h> +import numpy as np
[?2004l[?2004h> +import pandas as pd
[?2004l[?2004h> +
[?2004l[?2004h> +PRIOR_WEIGHT = 20
[?2004l[?2004h> +DEFAULT_PRIOR = 0.05
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def district_encoding(points: pd.DataFrame, labels: pd.DataFrame, customers: pd.DataFrame, m: int = PRIOR_WEIGHT) -> pd.Series:
[?2004l[?2004h> +    """Compute the smoothed churn rate for each customer's postcode district.
[?2004l[?2004h> +
[?2004l[?2004h> +    The calculation follows the specification in ``FEATURES.md`` and respects causality – only
[?2004l[?2004h> +    label rows with ``label_available_at`` strictly before the prediction ``as_of`` are used.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    # Map each customer to its district
[?2004l[?2004h> +    district_map = customers.set_index("customer_id")["postcode_district"]
[?2004l[?2004h> +    points = points.copy()
[?2004l[?2004h> +    points["district"] = points["customer_id"].map(district_map)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Prepare label data with proper datetime handling
[?2004l[?2004h> +    lab = labels.copy()
[?2004l[?2004h> +    lab["label_available_at"] = pd.to_datetime(lab["label_available_at"]).dt.tz_localize(None)
[?2004l[?2004h> +    lab["district"] = lab["customer_id"].map(district_map)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Sort labels by availability time for cumulative statistics
[?2004l[?2004h> +    lab = lab.sort_values("label_available_at")
[?2004l[?2004h> +
[?2004l[?2004h> +    # Overall cumulative sums for the prior probability p
[?2004l[?2004h> +    lab["overall_cum_sum"] = lab["churned_30d"].cumsum()
[?2004l[?2004h> +    lab["overall_cum_cnt"] = np.arange(1, len(lab) + 1)
[?2004l[?2004h> +
[?2004l[?2004h> +    # District‑specific cumulative sums and counts
[?2004l[?2004h> +    lab["cum_sum"] = lab.groupby("district")["churned_30d"].cumsum()
[?2004l[?2004h> +    lab["cum_cnt"] = lab.groupby("district").cumcount() + 1  # 1‑based cumulative count
[?2004l[?2004h> +
[?2004l[?2004h> +    # Merge the latest available label stats for each point (strictly before as_of)
[?2004l[?2004h> +    pts = points.sort_values(["district", "as_of"]).copy()
[?2004l[?2004h> +    merged = pd.merge_asof(
[?2004l[?2004h> +        pts,
[?2004l[?2004h> +        lab,
[?2004l[?2004h> +        left_on="as_of",
[?2004l[?2004h> +        right_on="label_available_at",
[?2004l[?2004h> +        by="district",
[?2004l[?2004h> +        direction="backward",
[?2004l[?2004h> +        allow_exact_matches=False,
[?2004l[?2004h> +    )
[?2004l[?2004h> +
[?2004l[?2004h> +    # Compute p – the overall mean churn rate up to that point (fallback to DEFAULT_PRIOR)
[?2004l[?2004h> +    p = merged["overall_cum_sum"] / merged["overall_cum_cnt"]
[?2004l[?2004h> +    p = p.fillna(DEFAULT_PRIOR)
[?2004l[?2004h> +
[?2004l[?2004h> +    # District‑specific statistics (s and n). When no prior label exists for the district, n is NaN.
[?2004l[?2004h> +    s = merged["cum_sum"]
[?2004l[?2004h> +    n = merged["cum_cnt"]
[?2004l[?2004h> +
[?2004l[?2004h> +    # Smoothed encoding per the formula: (s + m * p) / (n + m)
[?2004l[?2004h> +    te = (s + m * p) / (n + m)
[?2004l[?2004h> +    # If a district has never appeared in the label set up to ``as_of``, fall back to the overall prior p.
[?2004l[?2004h> +    te = te.fillna(p)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Align the result back to the original order of ``points``
[?2004l[?2004h> +    result = te.reindex(points.index).astype("float64")
[?2004l[?2004h> +    return result
[?2004l[?2004h> +
