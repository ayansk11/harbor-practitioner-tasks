[?2004l[?2004h> """Account status from the billing system's status snapshots.
[?2004l[?2004h> 
[?2004l[?2004h> The specification requires that for a prediction at time ``t`` we use the latest snapshot
[?2004l[?2004h> with ``snapshot_date < date(t)`` (the snapshot dated the same day as ``t`` is not visible).
[?2004l[?2004h> The original implementation returned the globally latest snapshot per customer, ignoring the
[?2004l[?2004h> as_of timestamp, which introduced leakage.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def latest_status(points: pd.DataFrame, snapshots: pd.DataFrame) -> pd.Series:
[?2004l[?2004h>     """Return the status for each prediction respecting the half‑open rule.
[?2004l[?2004h> 
[?2004l[?2004h>     Parameters
[?2004l[?2004h>     ----------
[?2004l[?2004h>     points: DataFrame containing ``customer_id`` and ``as_of`` (datetime).
[?2004l[?2004h>     snapshots: DataFrame with ``customer_id``, ``snapshot_date`` (date string) and ``status``.
[?2004l[?2004h>     """
[?2004l[?2004h>     # Ensure datetime types
[?2004l[?2004h>     snapshots = snapshots.copy()
[?2004l[?2004h>     snapshots["snapshot_date"] = pd.to_datetime(snapshots["snapshot_date"]).dt.normalize()
[?2004l[?2004h>     points = points.copy()
[?2004l[?2004h>     points["as_of"] = pd.to_datetime(points["as_of"]).dt.tz_localize(None)
[?2004l[?2004h> 
[?2004l[?2004h>     # The snapshot dated D describes the end of day D, therefore it is visible only for
[?2004l[?2004h>     # predictions with as_of > D (i.e., date(as_of) > D). We use merge_asof on the day level.
[?2004l[?2004h>     points_day = points.assign(day=points["as_of"].dt.floor("D"))
[?2004l[?2004h>     points_day = points_day.sort_values(["customer_id", "day"])
[?2004l[?2004h>     snapshots = snapshots.sort_values(["customer_id", "snapshot_date"])
[?2004l[?2004h> 
[?2004l[?2004h>     merged = pd.merge_asof(
[?2004l[?2004h>         points_day,
[?2004l[?2004h>         snapshots,
[?2004l[?2004h>         left_on="day",
[?2004l[?2004h>         right_on="snapshot_date",
[?2004l[?2004h>         by="customer_id",
[?2004l[?2004h>         direction="backward",
[?2004l[?2004h>         allow_exact_matches=False,
[?2004l[?2004h>     )
[?2004l[?2004h>     return merged["status"]
[?2004l[?2004h> 
