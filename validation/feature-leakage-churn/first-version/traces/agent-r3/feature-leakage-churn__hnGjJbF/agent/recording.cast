[62.886296, "i", "cat > churn/encoding.py <<'EOF'\n\"\"\"Target encoding of high-cardinality categoricals.\"\"\"\nimport pandas as pd\n\nPRIOR_WEIGHT = 20\nDEFAULT_PRIOR = 0.05\n\n\ndef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\n    \"\"\"Target‑encode ``postcode_district`` using only labels that are *available*.\n\n    A label row is available at time ``t`` when ``label_available_at < t``. For each\n    prediction we compute a smoothed churn rate for the customer's district based\n    on all such available rows.\n    \"\"\"\n    # Map customer -> district\n    cust_district = customers.set_index(\"customer_id\")['postcode_district']\n    pts = points.copy()\n    pts['district'] = pts['customer_id'].map(cust_district)\n\n    def encode_one(row):\n        # Labels known strictly before this prediction\n        avail = labels[labels['label_available_at'] < row['as_of']]\n        if avail.empty:\n            return DEFAULT_PRIOR\n        prior = avail['churned_30d'].mean()\n        # Aggregate by district for the available set\n        agg = (\n    "]
[62.886407, "i", "        avail.assign(district=avail['customer_id'].map(cust_district))\n            .groupby('district')['churned_30d']\n            .agg(['sum', 'count'])\n        )\n        d = row['district']\n        if d in agg.index:\n            s = agg.loc[d, 'sum']\n            n = agg.loc[d, 'count']\n            return (s + m * prior) / (n + m)\n        else:\n            return prior\n\n    encoded = pts.apply(encode_one, axis=1)\n    return encoded.astype('float64')\nEOF\n"]
[62.88667, "o", "cat > churn/encoding.py <<'EOF'\r\n"]
[62.886684, "o", "\u001b[?2004l\r"]
[62.886781, "o", "\u001b[?2004h"]
[62.886815, "o", "> "]
[62.887325, "o", "\"\"\"Target encoding of high-cardinality categoricals.\"\"\"\r\n"]
[62.887358, "o", "\u001b[?2004l\r"]
