[35.651716, "o", "+def _rolling(daily, cols, window):\r\n\u001b[?2004l\r"]
[35.651763, "o", "\u001b[?2004h> "]
[35.651947, "o", "+    \"\"\"Roll a daily aggregation over a trailing window.\r\n\u001b[?2004l\r"]
[35.65201, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[35.65207, "o", "\u001b[?2004h> "]
[35.652321, "o", "+    The feature specification states that windows are half‑open ``[t - W, t)`` –\r\n\u001b[?2004l\r"]
[35.652372, "o", "\u001b[?2004h> "]
[35.652625, "o", "+    events that occur exactly at the prediction time ``t`` must **not** be\r\n\u001b[?2004l\r"]
[35.652685, "o", "\u001b[?2004h> "]
[35.652914, "o", "+    counted.  Pandas ``rolling`` supports this via the ``closed`` argument.\r\n\u001b[?2004l\r"]
[35.652963, "o", "\u001b[?2004h> "]
[35.653219, "o", "+    ``closed=\"left\"`` excludes the right‑hand endpoint, which matches the\r\n\u001b[?2004l\r"]
[35.653272, "o", "\u001b[?2004h> "]
[35.653514, "o", "+    specification.  The previous implementation used ``closed=\"both\"`` and\r\n\u001b[?2004l\r"]
[35.653564, "o", "\u001b[?2004h> "]
[35.65378, "o", "+    therefore leaked information from the prediction day.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.653838, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.65391, "o", "+    rolled = (\r\n\u001b[?2004l\r"]
[35.653963, "o", "\u001b[?2004h> "]
[35.654056, "o", "+        daily.set_index(\"day\")\r\n\u001b[?2004l\r"]
[35.654123, "o", "\u001b[?2004h> "]
[35.654227, "o", "+        .groupby(\"customer_id\")[cols]\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.654271, "o", "> "]
[35.654398, "o", "+        .rolling(window, closed=\"left\")\r\n\u001b[?2004l\r"]
[35.654438, "o", "\u001b[?2004h> "]
[35.654519, "o", "+        .sum()\r\n\u001b[?2004l\r"]
[35.654562, "o", "\u001b[?2004h> "]
[35.654615, "o", "+        .reset_index()\r\n\u001b[?2004l\r"]
[35.654659, "o", "\u001b[?2004h> "]
[35.654709, "o", "+    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.654764, "o", "> "]
[35.654812, "o", "+    return rolled\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.654863, "o", "> "]
[35.654909, "o", "*** End Patch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.654967, "o", "PATCH\r\n\u001b[?2004l\r"]
