[61.386707, "i", "cat > churn/impute.py <<'EOF'\n\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\"\"\"\n\n\ndef fill_app_minutes(points):\n    \"\"\"Forward‑fill missing ``app_minutes_7d`` values.\n\n    The spec says to use the most recent earlier reading for the same customer.\n    A backward fill would introduce future information, so we only apply a\n    forward fill after sorting by ``as_of``.\n    \"\"\"\n    pts = points.sort_values([\"customer_id\", \"as_of\"]).copy()\n    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(\"ffill\")\n    # Re‑index to the original order of ``points``\n    return filled.reindex(points.index)\nEOF\n"]
