[62.887666, "o", "\u001b[?2004l\r"]
[62.887702, "o", "\u001b[?2004h"]
[62.887726, "o", "> "]
[62.887754, "o", "\r\n\u001b[?2004l\r"]
[62.887776, "o", "\u001b[?2004h"]
[62.887808, "o", "> "]
[62.887974, "o", "PRIOR_WEIGHT = 20\r\n"]
[62.888001, "o", "\u001b[?2004l\r"]
[62.888026, "o", "\u001b[?2004h"]
[62.888056, "o", "> "]
[62.888247, "o", "DEFAULT_PRIOR = 0.05\r\n"]
[62.888271, "o", "\u001b[?2004l\r"]
[62.888299, "o", "\u001b[?2004h"]
[62.88833, "o", "> "]
[62.888354, "o", "\r\n\u001b[?2004l\r"]
[62.888391, "o", "\u001b[?2004h"]
[62.88842, "o", "> "]
[62.888447, "o", "\r\n\u001b[?2004l\r"]
[62.888496, "o", "\u001b[?2004h"]
[62.88853, "o", "> "]
[62.889058, "o", "def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n\u001b[?2004l\r"]
[62.889096, "o", "\u001b[?2004h"]
[62.88912, "o", "> "]
[62.88976, "o", "    \"\"\"Target‑encode ``postcode_district`` using only labels that are *available*.\r\n\u001b[?2004l\r"]
[62.889793, "o", "\u001b[?2004h"]
[62.889826, "o", "> "]
[62.889863, "o", "\r\n\u001b[?2004l\r"]
[62.889899, "o", "\u001b[?2004h"]
[62.889931, "o", "> "]
[62.890633, "o", "    A label row is available at time ``t`` when ``label_available_at < t``. For each\r\n\u001b[?2004l\r"]
[62.890678, "o", "\u001b[?2004h"]
[62.890723, "o", "> "]
[62.8913, "o", "    prediction we compute a smoothed churn rate for the customer's district based\r\n\u001b[?2004l\r"]
[62.891353, "o", "\u001b[?2004h"]
[62.891395, "o", "> "]
[62.891656, "o", "    on all such available rows.\r\n\u001b[?2004l\r"]
[62.891704, "o", "\u001b[?2004h"]
[62.891747, "o", "> "]
[62.891815, "o", "    \"\"\"\r\n"]
[62.891828, "o", "\u001b[?2004l\r"]
[62.891904, "o", "\u001b[?2004h> "]
[62.892143, "o", "    # Map customer -> district\r\n\u001b[?2004l\r"]
[62.892198, "o", "\u001b[?2004h"]
[62.892248, "o", "> "]
[62.892792, "o", "    cust_district = customers.set_index(\"customer_id\")['postcode_district']\r\n\u001b[?2004l\r"]
[62.892839, "o", "\u001b[?2004h"]
[62.892879, "o", "> "]
[62.893055, "o", "    pts = points.copy()\r\n\u001b[?2004l\r"]
[62.893106, "o", "\u001b[?2004h"]
[62.893144, "o", "> "]
[62.893613, "o", "    pts['district'] = pts['customer_id'].map(cust_district)\r\n\u001b[?2004l\r"]
[62.893664, "o", "\u001b[?2004h"]
[62.893675, "o", "> \r\n\u001b[?2004l\r"]
[62.893728, "o", "\u001b[?2004h"]
[62.893767, "o", "> "]
[62.893967, "o", "    def encode_one(row):\r\n"]
[62.893979, "o", "\u001b[?2004l\r"]
[62.89406, "o", "\u001b[?2004h"]
[62.894078, "o", "> "]
[62.894502, "o", "        # Labels known strictly before this prediction\r\n\u001b[?2004l\r"]
[62.894557, "o", "\u001b[?2004h"]
[62.894613, "o", "> "]
[62.895164, "o", "        avail = labels[labels['label_available_at'] < row['as_of']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.895357, "o", "        if avail.empty:\r\n\u001b[?2004l\r"]
[62.895434, "o", "\u001b[?2004h> "]
[62.895704, "o", "            return DEFAULT_PRIOR\r\n\u001b[?2004l\r"]
[62.895748, "o", "\u001b[?2004h"]
[62.895784, "o", "> "]
[62.896087, "o", "        prior = avail['churned_30d'].mean()\r\n"]
[62.896114, "o", "\u001b[?2004l\r"]
[62.896154, "o", "\u001b[?2004h"]
[62.896199, "o", "> "]
[62.896575, "o", "        # Aggregate by district for the available set\r\n\u001b[?2004l\r"]
[62.896633, "o", "\u001b[?2004h"]
[62.896665, "o", "> "]
[62.896786, "o", "        agg = (\r\n\u001b[?2004l\r"]
[62.89684, "o", "\u001b[?2004h"]
[62.896879, "o", "> "]
[62.897399, "o", "            avail.assign(district=avail['customer_id'].map(cust_district))\r\n"]
[62.897407, "o", "\u001b[?2004l\r"]
[62.897468, "o", "\u001b[?2004h"]
[62.897516, "o", "> "]
[62.897844, "o", "            .groupby('district')['churned_30d']\r\n"]
[62.897888, "o", "\u001b[?2004l\r"]
[62.89792, "o", "\u001b[?2004h"]
[62.897938, "o", "> "]
[62.898197, "o", "            .agg(['sum', 'count'])\r\n\u001b[?2004l\r"]
[62.898249, "o", "\u001b[?2004h"]
[62.898289, "o", "> "]
[62.898369, "o", "        )\r\n"]
[62.898378, "o", "\u001b[?2004l\r"]
[62.898421, "o", "\u001b[?2004h"]
[62.898467, "o", "> "]
[62.898676, "o", "        d = row['district']\r\n\u001b[?2004l\r"]
[62.898728, "o", "\u001b[?2004h"]
[62.898767, "o", "> "]
[62.898963, "o", "        if d in agg.index:\r\n"]
[62.898972, "o", "\u001b[?2004l\r"]
[62.899014, "o", "\u001b[?2004h"]
[62.899055, "o", "> "]
[62.8993, "o", "            s = agg.loc[d, 'sum']\r\n"]
[62.899308, "o", "\u001b[?2004l\r"]
[62.899357, "o", "\u001b[?2004h"]
[62.899392, "o", "> "]
[62.899659, "o", "            n = agg.loc[d, 'count']\r\n\u001b[?2004l\r"]
[62.899708, "o", "\u001b[?2004h"]
[62.899744, "o", "> "]
[62.900065, "o", "            return (s + m * prior) / (n + m)\r\n\u001b[?2004l\r"]
[62.900112, "o", "\u001b[?2004h"]
[62.900147, "o", "> "]
[62.900259, "o", "        else:\r\n\u001b[?2004l\r"]
[62.900311, "o", "\u001b[?2004h"]
[62.900357, "o", "> "]
[62.900545, "o", "            return prior\r\n"]
[62.900554, "o", "\u001b[?2004l\r"]
[62.900598, "o", "\u001b[?2004h"]
[62.900647, "o", "> \r\n"]
[62.900673, "o", "\u001b[?2004l\r"]
[62.900692, "o", "\u001b[?2004h"]
[62.90074, "o", "> "]
[62.901053, "o", "    encoded = pts.apply(encode_one, axis=1)\r\n\u001b[?2004l\r"]
[62.901103, "o", "\u001b[?2004h"]
[62.901142, "o", "> "]
[62.901408, "o", "    return encoded.astype('float64')\r\n"]
[62.901417, "o", "\u001b[?2004l\r"]
[62.901527, "o", "\u001b[?2004h> "]
[62.901538, "o", "EOF\r\n"]
[62.901586, "o", "\u001b[?2004l\r"]
[62.90433, "o", "\u001b[?2004h"]
[62.904352, "o", "root@a1227658-4fa7-4bbe-860c-4345cc3e1321:/app# "]
