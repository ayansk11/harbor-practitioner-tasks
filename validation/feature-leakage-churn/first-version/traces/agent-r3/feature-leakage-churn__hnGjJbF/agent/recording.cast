[36.651954, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: churn/impute.py\n@@\n-def fill_app_minutes(points):\n-    \"\"\"Fill missing app_minutes_7d from the nearest reading of the same customer.\"\"\"\n-    pts = points.sort_values([\"customer_id\", \"as_of\"])\n-    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(lambda s: s.bfill().ffill())\n-    return filled.reindex(points.index)\n+def fill_app_minutes(points):\n+    \"\"\"Forward‑fill missing ``app_minutes_7d`` values.\n+\n+    The specification says that a missing value should be filled from the\n+    *most recent* earlier row for the same customer.  The previous\n+    implementation used ``bfill`` followed by ``ffill``, which could pull in a\n+    future reading (back‑fill) and thus violate the strict‑before rule.\n+    We keep only a forward fill after sorting by ``as_of``.\n+    \"\"\"\n+    pts = points.sort_values([\"customer_id\", \"as_of\"])\n+    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(\"ffill\")\n+    # Preserve the original order of ``poi"]
[36.651991, "i", "nts``\n+    return filled.reindex(points.index)\n*** End Patch\nPATCH\n"]
