[36.130752, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: churn/status.py\n@@\n-def latest_status(points, snapshots):\n-    \"\"\"Status of the customer's latest snapshot.\"\"\"\n-    latest = (snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\n-              .drop_duplicates(\"customer_id\", keep=\"last\"))\n-    return points[[\"customer_id\"]].merge(latest[[\"customer_id\", \"status\"]], on=\"customer_id\", how=\"left\")[\"status\"]\n+def latest_status(points, snapshots):\n+    \"\"\"Status of the customer's latest snapshot **strictly before** the prediction.\n+\n+    The contract in ``FEATURES.md`` requires using the most recent snapshot\n+    where ``snapshot_date < date(t)`` (the calendar day of the prediction).\n+    ``snapshot_date`` is a date representing the *end* of that day, so a\n+    snapshot dated the same calendar day as the prediction is not yet known.\n+\n+    We perform a merge‑asof on the ``as_of`` timestamps, then discard matches\n+    that fall on the same day as the prediction.\n+    \"\"\"\n+    # Ensure the inputs are sorted"]
[36.131, "i", " for merge_asof\n+    pts = points.copy()\n+    snap = snapshots.copy()\n+\n+    pts = pts.sort_values([\"customer_id\", \"as_of\"]).reset_index(drop=False)\n+    snap = snap.sort_values([\"customer_id\", \"snapshot_date\"]).reset_index(drop=False)\n+\n+    # Merge the most recent snapshot *on or before* the as_of timestamp\n+    merged = pd.merge_asof(\n+        pts,\n+        snap,\n+        left_on=\"as_of\",\n+        right_on=\"snapshot_date\",\n+        by=\"customer_id\",\n+        direction=\"backward\",\n+        allow_exact_matches=True,\n+    )\n+\n+    # A snapshot whose date equals the calendar day of the prediction must be ignored\n+    pred_day = merged[\"as_of\"].dt.floor(\"D\")\n+    merged.loc[merged[\"snapshot_date\"] == pred_day, \"status\"] = pd.NA\n+\n+    # Restore original order using the saved index\n+    merged = merged.set_index(\"index\").sort_index()\n+    return merged[\"status\"]\n*** End Patch\nPATCH\n"]
