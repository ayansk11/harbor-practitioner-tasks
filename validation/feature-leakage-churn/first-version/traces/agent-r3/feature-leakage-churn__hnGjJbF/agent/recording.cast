[57.405008, "o", "def activity_features(points, orders, tickets):\r\n\u001b[?2004l\r"]
[57.405074, "o", "\u001b[?2004h"]
[57.405124, "o", "> "]
[57.40559, "o", "    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n\u001b[?2004l\r"]
[57.40565, "o", "\u001b[?2004h"]
[57.405702, "o", "> "]
[57.406085, "o", "    out[\"day\"] = out[\"as_of\"].dt.floor(\"D\")\r\n\u001b[?2004l\r"]
[57.406148, "o", "\u001b[?2004h"]
[57.406201, "o", "> "]
[57.406251, "o", "\r\n\u001b[?2004l\r"]
[57.406301, "o", "\u001b[?2004h> "]
[57.406858, "o", "    od = _daily(points, orders, \"ordered_at\", \"amount_cents\")\r\n\u001b[?2004l\r"]
[57.406921, "o", "\u001b[?2004h"]
[57.406973, "o", "> "]
[57.40759, "o", "    r7 = _rolling(od, [\"n\"], \"7D\").rename(columns={\"n\": \"orders_7d\"})\r\n\u001b[?2004l\r"]
[57.407653, "o", "\u001b[?2004h"]
[57.407712, "o", "> "]
[57.408684, "o", "    r30 = _rolling(od, [\"n\", \"amount\"], \"30D\").rename(columns={\"n\": \"orders_30d\", \"amount\": \"spend_30d_cents\"})\r\n\u001b[?2004l\r"]
[57.408752, "o", "\u001b[?2004h"]
[57.408808, "o", "> "]
[57.409206, "o", "    td = _daily(points, tickets, \"opened_at\")\r\n\u001b[?2004l\r"]
[57.409281, "o", "\u001b[?2004h"]
[57.409332, "o", "> "]
[57.409994, "o", "    t30 = _rolling(td, [\"n\"], \"30D\").rename(columns={\"n\": \"tickets_30d\"})\r\n\u001b[?2004l\r"]
[57.410047, "o", "\u001b[?2004h"]
[57.410105, "o", "> "]
[57.410378, "o", "    for part in (r7, r30, t30):\r\n\u001b[?2004l\r"]
[57.410472, "o", "\u001b[?2004h"]
[57.410538, "o", "> "]
[57.411109, "o", "        out = out.merge(part, on=[\"customer_id\", \"day\"], how=\"left\")\r\n\u001b[?2004l\r"]
[57.411174, "o", "\u001b[?2004h"]
[57.411219, "o", "> "]
[57.411888, "o", "    for c in (\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\"):\r\n\u001b[?2004l\r"]
[57.411981, "o", "\u001b[?2004h"]
[57.41205, "o", "> "]
[57.412403, "o", "        out[c] = out[c].fillna(0).astype(\"int64\")\r\n\u001b[?2004l\r"]
[57.41247, "o", "\u001b[?2004h"]
[57.412527, "o", "> "]
[57.412577, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.412628, "o", "> "]
[57.41313, "o", "    # time since the last order strictly before the prediction\r\n\u001b[?2004l\r"]
[57.413187, "o", "\u001b[?2004h"]
[57.413238, "o", "> "]
[57.413888, "o", "    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n\u001b[?2004l\r"]
[57.413977, "o", "\u001b[?2004h> "]
[57.41466, "o", "    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n\u001b[?2004l\r"]
[57.414717, "o", "\u001b[?2004h"]
[57.414776, "o", "> "]
[57.415007, "o", "    last = pd.merge_asof(\r\n\u001b[?2004l\r"]
[57.41507, "o", "\u001b[?2004h"]
[57.415114, "o", "> "]
[57.416017, "o", "        left, o, left_on=\"as_of\", right_on=\"ordered_at\", by=\"customer_id\", allow_exact_matches=False\r\n\u001b[?2004l\r"]
[57.416077, "o", "\u001b[?2004h"]
[57.416122, "o", "> "]
[57.416593, "o", "    ).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n\u001b[?2004l\r"]
[57.416651, "o", "\u001b[?2004h"]
[57.416706, "o", "> "]
[57.417496, "o", "    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[57.417552, "o", "\u001b[?2004h"]
[57.417608, "o", "> "]
[57.417928, "o", "    return out.drop(columns=[\"day\"])\r\n\u001b[?2004l\r"]
[57.417986, "o", "\u001b[?2004h"]
[57.41804, "o", "> \r\n\u001b[?2004l\r"]
[57.418092, "o", "\u001b[?2004h"]
[57.418142, "o", "> "]
[57.418198, "o", "\r\n\u001b[?2004l\r"]
[57.418253, "o", "\u001b[?2004h"]
[57.418308, "o", "> "]
[57.41859, "o", "def tenure_days(points, customers):\r\n\u001b[?2004l\r"]
[57.418649, "o", "\u001b[?2004h"]
[57.418704, "o", "> "]
[57.419493, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[57.419556, "o", "\u001b[?2004h"]
[57.419601, "o", "> "]
[57.420185, "o", "    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[57.420243, "o", "\u001b[?2004h"]
[57.420305, "o", "> "]
[57.42036, "o", "EOF\r\n\u001b[?2004l\r"]
[57.422781, "o", "\u001b[?2004h"]
[57.422872, "o", "root@a1227658-4fa7-4bbe-860c-4345cc3e1321:/app# "]
[59.470609, "i", "cat > churn/status.py <<'EOF'\n\"\"\"Account status from the billing system's status snapshots.\"\"\"\n\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Status of the customer's latest snapshot **strictly before** the prediction.\n\n    The spec requires using the most recent snapshot where ``snapshot_date`` is\n    earlier than the calendar day of ``as_of``. ``snapshot_date`` records the\n    end of that day, so a snapshot dated the same day as the prediction is not\n    yet known.\n    \"\"\"\n    # Prepare sorted frames for merge_asof\n    pts = points.copy().sort_values([\"customer_id\", \"as_of\"]).reset_index(drop=False)\n    snap = snapshots.copy().sort_values([\"customer_id\", \"snapshot_date\"]).reset_index(drop=False)\n\n    merged = pd.merge_asof(\n        pts,\n        snap,\n        left_on=\"as_of\",\n        right_on=\"snapshot_date\",\n        by=\"customer_id\",\n        direction=\"backward\",\n        allow_exact_matches=True,\n    )\n\n    # Drop snapshots that fall on the same calendar day as the prediction\n    pred_d"]
[59.470746, "i", "ay = merged[\"as_of\"].dt.floor(\"D\")\n    merged.loc[merged[\"snapshot_date\"] == pred_day, \"status\"] = pd.NA\n\n    # Restore original row order\n    merged = merged.set_index(\"index\").sort_index()\n    return merged[\"status\"]\nEOF\n"]
