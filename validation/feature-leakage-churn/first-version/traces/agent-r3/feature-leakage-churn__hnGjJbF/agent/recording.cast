[37.143831, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: churn/encoding.py\n@@\n-def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\n-    \"\"\"Smoothed churn rate of the customer's postcode district.\"\"\"\n-    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\n-    lab = labels.assign(district=labels[\"customer_id\"].map(district))\n-    prior = lab[\"churned_30d\"].mean() if len(lab) else DEFAULT_PRIOR\n-    stats = lab.groupby(\"district\")[\"churned_30d\"].agg([\"sum\", \"count\"])\n-    te = (stats[\"sum\"] + m * prior) / (stats[\"count\"] + m)\n-    return points[\"customer_id\"].map(district).map(te).fillna(prior).astype(\"float64\")\n+def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\n+    \"\"\"Target‑encode ``postcode_district`` using only *available* label rows.\n+\n+    A label row is considered available at time ``t`` when\n+    ``label_available_at < t``.  For each prediction we need the smoothed\n+    churn rate for the customer's district based on **all** label rows that\n+    satisfy thi"]
[37.143936, "i", "s condition.  The formula from ``FEATURES.md`` is:\n+\n+    ``te = (s + m * p) / (n + m)`` where ``p`` is the overall mean churn rate\n+    among the available rows, ``n`` and ``s`` are the count and sum of\n+    ``churned_30d`` for the specific district.\n+\n+    Because the dataset is modest (< 10 k rows), we compute the encoding per\n+    prediction with a straightforward ``apply`` – performance is acceptable\n+    and the logic stays clear.\n+    \"\"\"\n+    # Map customers to their district\n+    cust_district = customers.set_index(\"customer_id\")[\"postcode_district\"]\n+    points = points.copy()\n+    points[\"district\"] = points[\"customer_id\"].map(cust_district)\n+\n+    def encode_one(row):\n+        # Labels that are known strictly before this prediction time\n+        available = labels[labels[\"label_available_at\"] < row[\"as_of\"]]\n+        if available.empty:\n+            prior = DEFAULT_PRIOR\n+            return prior\n+        prior = available[\"churned_30d\"].mean()\n+        # Aggregate by district for the availa"]
[37.14397, "i", "ble set\n+        agg = (\n+            available.assign(district=available[\"customer_id\"].map(cust_district))\n+            .groupby(\"district\")[\"churned_30d\"]\n+            .agg([\"sum\", \"count\"])\n+        )\n+        d = row[\"district\"]\n+        if d in agg.index:\n+            s = agg.loc[d, \"sum\"]\n+            n = agg.loc[d, \"count\"]\n+            return (s + m * prior) / (n + m)\n+        else:\n+            return prior\n+\n+    encoded = points.apply(encode_one, axis=1)\n+    return encoded.astype(\"float64\")\n*** End Patch\nPATCH\n"]
