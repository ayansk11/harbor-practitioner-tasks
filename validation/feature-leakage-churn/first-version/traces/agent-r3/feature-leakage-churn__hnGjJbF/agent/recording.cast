[77.740951, "i", "cat > churn/status.py <<'EOF'\n\"\"\"Account status from the billing system's status snapshots.\"\"\"\n\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Status of the customer's latest snapshot **strictly before** the prediction.\n\n    The spec requires using the most recent snapshot where ``snapshot_date`` is\n    earlier than the calendar day of ``as_of``. ``snapshot_date`` records the end\n    of that day, so a snapshot dated the same day as the prediction is not yet\n    known.\n    \"\"\"\n    # Preserve original row order\n    pts = points.copy()\n    pts['_orig_idx'] = pts.index\n\n    # Sort the frames for merge_asof\n    pts = pts.sort_values(['customer_id', 'as_of']).reset_index(drop=True)\n    snap = snapshots.copy().sort_values(['customer_id', 'snapshot_date']).reset_index(drop=True)\n\n    merged = pd.merge_asof(\n        pts,\n        snap,\n        left_on='as_of',\n        right_on='snapshot_date',\n        by='customer_id',\n        direction='backward',\n        allow_exact_matches=True,\n    )\n\n    # Drop"]
[77.741123, "i", " snapshots that fall on the same calendar day as the prediction\n    pred_day = merged['as_of'].dt.floor('D')\n    merged.loc[merged['snapshot_date'] == pred_day, 'status'] = pd.NA\n\n    # Restore original order using the temporary index column\n    merged = merged.set_index('_orig_idx').sort_index()\n    return merged['status']\nEOF\n"]
[77.741314, "o", "cat > churn/status.py <<'EOF'\r\n\u001b[?2004l\r"]
