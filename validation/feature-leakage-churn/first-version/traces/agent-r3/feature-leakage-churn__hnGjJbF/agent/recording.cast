[132.548664, "i", "cat > churn/status.py <<'EOF'\n\"\"\"Account status from the billing system's status snapshots.\"\"\"\n\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Status of the customer's latest snapshot **strictly before** the prediction.\n\n    A snapshot dated the same calendar day as the prediction is not yet known,\n    because `snapshot_date` represents the *end* of that day. The function\n    returns the most recent snapshot with ``snapshot_date < date(as_of)`` for\n    each customer.\n    \"\"\"\n    # Preserve original row order\n    pts = points.copy()\n    pts['_orig_idx'] = pts.index\n\n    # Global sort on the left key required by merge_asof\n    pts = pts.sort_values('as_of').reset_index(drop=True)\n\n    # Right side sorted by its key\n    snap = snapshots.copy().sort_values('snapshot_date').reset_index(drop=True)\n\n    merged = pd.merge_asof(\n        pts,\n        snap,\n        left_on='as_of',\n        right_on='snapshot_date',\n        by='customer_id',\n        direction='backward',\n        allow_exact_matches=Tr"]
[132.5488, "i", "ue,\n    )\n\n    # Exclude snapshots that fall on the same calendar day as the prediction\n    pred_day = merged['as_of'].dt.floor('D')\n    merged.loc[merged['snapshot_date'].dt.floor('D') == pred_day, 'status'] = pd.NA\n\n    # Restore original order\n    merged = merged.set_index('_orig_idx').sort_index()\n    return merged['status']\nEOF\n"]
