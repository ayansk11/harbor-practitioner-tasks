[13.777311, "o", "sed -n '1,200p' churn/status.py\r\n"]
[13.77734, "o", "\u001b[?2004l\r"]
[13.778952, "o", "\"\"\"Account status from the billing system's status snapshots.\"\"\"\r\n\r\n\r\ndef latest_status(points, snapshots):\r\n    \"\"\"Status of the customer's latest snapshot.\"\"\"\r\n    latest = (snapshots.sort_values([\"customer_id\", \"snapshot_date\"])\r\n              .drop_duplicates(\"customer_id\", keep=\"last\"))\r\n    return points[[\"customer_id\"]].merge(latest[[\"customer_id\", \"status\"]], on=\"customer_id\", how=\"left\")[\"status\"]\r\n"]
[13.779192, "o", "\u001b[?2004h"]
[13.779211, "o", "root@a1227658-4fa7-4bbe-860c-4345cc3e1321:/app# "]
[14.105529, "i", "sed -n '1,200p' churn/impute.py\n"]
[14.105719, "o", "sed -n '1,200p' churn/impute.py\r\n\u001b[?2004l\r"]
[14.108405, "o", "\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\"\"\"\r\n\r\n\r\ndef fill_app_minutes(points):\r\n    \"\"\"Fill missing app_minutes_7d from the nearest reading of the same customer.\"\"\"\r\n"]
[14.108459, "o", "    pts = points.sort_values([\"customer_id\", \"as_of\"])\r\n    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].transform(lambda s: s.bfill().ffill())\r\n    return filled.reindex(points.index)\r\n"]
[14.10889, "o", "\u001b[?2004h"]
[14.108917, "o", "root@a1227658-4fa7-4bbe-860c-4345cc3e1321:/app# "]
[14.479899, "i", "sed -n '1,200p' churn/encoding.py\n"]
[14.480124, "o", "sed -n '1,200p' churn/encoding.py\r\n\u001b[?2004l\r"]
[14.483304, "o", "\"\"\"Target encoding of high-cardinality categoricals.\"\"\"\r\nimport pandas as pd\r\n\r\nPRIOR_WEIGHT = 20\r\nDEFAULT_PRIOR = 0.05\r\n\r\n\r\ndef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n    \"\"\"Smoothed churn rate of the customer's postcode district.\"\"\""]
[14.48339, "o", "\r\n    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n    lab = labels.assign(district=labels[\"customer_id\"].map(district))\r\n    prior = lab[\"churned_30d\"].mean() if len(lab) else DEFAULT_PRIOR\r\n    stats = lab.groupby(\"district\")[\"churned_30d\"].agg([\"sum\", \"count\"])\r\n    te = (stats[\"sum\"] + m * prior) / (stats[\"count\"] + m)\r\n    return points[\"customer_id\"].map(district).map(te).fillna(prior).astype(\"float64\")\r\n"]
[14.483768, "o", "\u001b[?2004hroot@a1227658-4fa7-4bbe-860c-4345cc3e1321:/app# "]
[14.830551, "i", "sed -n '1,200p' churn/extract.py\n"]
[14.830769, "o", "sed -n '1,200p' churn/extract.py\r\n\u001b[?2004l\r"]
[14.832261, "o", "\"\"\"Load a warehouse extract (the CSV layout described in FEATURES.md) into pandas frames with UTC timestamps.\"\"\"\r\nimport os\r\nimport pandas as pd\r\n\r\nTIMESTAMPS = {\r\n    \"customers\": [\"signup_at\"],\r\n    \"scoring_points\": [\"as_of\"],\r\n    \"orders\": [\"ordered_at\"],\r\n    \"tickets\": [\"opened_at\"],\r\n    \"status_snapshots\": [\"snapshot_date\"],\r\n    \"labels\": [\"as_of\", \"label_available_at\"],\r\n"]
[14.832303, "o", "}\r\n\r\n\r\ndef load_extract(data_dir):\r\n    tables = {}\r\n    for name, cols in TIMESTAMPS.items():\r\n        df = pd.read_csv(os.path.join(data_dir, f\"{name}.csv\"), dtype={\"postcode_district\": \"str\"})\r\n        for c in cols:\r\n            df[c] = pd.to_datetime(df[c], utc=True)\r\n        tables[name] = df\r\n    tables[\"scoring_points\"][\"app_minutes_7d\"] = tables[\"scoring_points\"][\"app_minutes_7d\"].astype(\"float64\")\r\n    return tables\r\n"]
[14.832587, "o", "\u001b[?2004hroot@a1227658-4fa7-4bbe-860c-4345cc3e1321:/app# "]
[35.649778, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: churn/windows.py\n@@\n-def _rolling(daily, cols, window):\n-    # daily buckets keep this fast; the window covers the last `window` including the prediction day\n-    rolled = (daily.set_index(\"day\").groupby(\"customer_id\")[cols]\n-              .rolling(window, closed=\"both\").sum().reset_index())\n-    return rolled\n+def _rolling(daily, cols, window):\n+    \"\"\"Roll a daily aggregation over a trailing window.\n+\n+    The feature specification states that windows are half‑open ``[t - W, t)`` –\n+    events that occur exactly at the prediction time ``t`` must **not** be\n+    counted.  Pandas ``rolling`` supports this via the ``closed`` argument.\n+    ``closed=\"left\"`` excludes the right‑hand endpoint, which matches the\n+    specification.  The previous implementation used ``closed=\"both\"`` and\n+    therefore leaked information from the prediction day.\n+    \"\"\"\n+    rolled = (\n+        daily.set_index(\"day\")\n+        .groupby(\"customer_id\")[cols]\n+        .rolli"]
[35.649963, "i", "ng(window, closed=\"left\")\n+        .sum()\n+        .reset_index()\n+    )\n+    return rolled\n*** End Patch\nPATCH\n"]
[35.650033, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\rng(window, closed=\"left\")\r\n+        .sum()\r\n+        .reset_index()\r\n+   "]
[35.65011, "o", " )\r\n+    return rolled\r\n*** End Patch\r\nPATCH\r\n\u001b[?2004h> "]
