[98.361484, "i", "cat > churn/status.py <<'EOF'\n\"\"\"Account status from the billing system's status snapshots.\"\"\"\n\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Status of the customer's latest snapshot **strictly before** the prediction.\n\n    According to the spec, a snapshot dated the same calendar day as the\n    prediction is not yet known, because `snapshot_date` represents the *end* of\n    that day. Therefore we must select the most recent snapshot with\n    `snapshot_date < date(as_of)` for each customer.\n    \"\"\"\n    # Preserve original row order\n    pts = points.copy()\n    pts['_orig_idx'] = pts.index\n\n    # Global sort required by pandas.merge_asof on the left key\n    pts = pts.sort_values('as_of').reset_index(drop=True)\n\n    # Snapshots need to be sorted by the merge key within each customer\n    snap = snapshots.copy().sort_values(['customer_id', 'snapshot_date']).reset_index(drop=True)\n\n    merged = pd.merge_asof(\n        pts,\n        snap,\n        left_on='as_of',\n        right_on='snapshot_date',\n"]
[98.361584, "i", "        by='customer_id',\n        direction='backward',\n        allow_exact_matches=True,\n    )\n\n    # Remove snapshots that fall on the same calendar day as the prediction\n    pred_day = merged['as_of'].dt.floor('D')\n    merged.loc[merged['snapshot_date'].dt.floor('D') == pred_day, 'status'] = pd.NA\n\n    # Restore original order using the temporary index column\n    merged = merged.set_index('_orig_idx').sort_index()\n    return merged['status']\nEOF\n"]
