[?2004l[?2004h> +def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):
[?2004l[?2004h> +    """Target‑encode ``postcode_district`` using only *available* label rows.
[?2004l[?2004h> +
[?2004l[?2004h> +    A label row is considered available at time ``t`` when
[?2004l[?2004h> +    ``label_available_at < t``.  For each prediction we need the smoothed
[?2004l[?2004h> +    churn rate for the customer's district based on **all** label rows that
[?2004l[?2004h> +    satisfy this condition.  The formula from ``FEATURES.md`` is:
[?2004l[?2004h> +
[?2004l[?2004h> +    ``te = (s + m * p) / (n + m)`` where ``p`` is the overall mean churn rate
[?2004l[?2004h> +    among the available rows, ``n`` and ``s`` are the count and sum of
[?2004l[?2004h> +    ``churned_30d`` for the specific district.
[?2004l[?2004h> +
[?2004l[?2004h> +    Because the dataset is modest (< 10 k rows), we compute the encoding per
[?2004l[?2004h> +    prediction with a straightforward ``apply`` – performance is acceptable
[?2004l[?2004h> +    and the logic stays clear.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    # Map customers to their district
[?2004l[?2004h> +    cust_district = customers.set_index("customer_id")["postcode_district"]
[?2004l[?2004h> +    points = points.copy()
[?2004l[?2004h> +    points["district"] = points["customer_id"].map(cust_district)
[?2004l[?2004h> +
[?2004l[?2004h> +    def encode_one(row):
[?2004l[?2004h> +        # Labels that are known strictly before this prediction time
[?2004l[?2004h> +        available = labels[labels["label_available_at"] < row["as_of"]]
[?2004l[?2004h> +        if available.empty:
[?2004l[?2004h> +            prior = DEFAULT_PRIOR
[?2004l[?2004h> +            return prior
[?2004l[?2004h> +        prior = available["churned_30d"].mean()
[?2004l[?2004h> +        # Aggregate by district for the available set
[?2004l[?2004h> +        agg = (
[?2004l[?2004h> +            available.assign(district=available["customer_id"].map(cust_district))
[?2004l[?2004h> +            .groupby("district")["churned_30d"]
[?2004l[?2004h> +            .agg(["sum", "count"])
[?2004l[?2004h> +        )
[?2004l[?2004h> +        d = row["district"]
[?2004l[?2004h> +        if d in agg.index:
[?2004l[?2004h> +            s = agg.loc[d, "sum"]
[?2004l[?2004h> +            n = agg.loc[d, "count"]
[?2004l[?2004h> +            return (s + m * prior) / (n + m)
[?2004l[?2004h> +        else:
[?2004l[?2004h> +            return prior
[?2004l[?2004h> +
[?2004l[?2004h> +    encoded = points.apply(encode_one, axis=1)
