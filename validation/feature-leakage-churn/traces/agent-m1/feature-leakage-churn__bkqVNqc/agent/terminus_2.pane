[?2004l[?2004h>     
[?2004l[?2004h>     # Optimization: sort points and use a sliding window of visible labels
[?2004l[?2004h>     pts_sorted = points.sort_values("as_of").reset_index()
[?2004l[?2004h>     labels_sorted = labels.copy()
[?2004l[?2004h>     labels_sorted["vis_time"] = np.maximum(labels_sorted["_loaded_at"], labels_sorted["as_of"] + pd.Timedelta(days=LABEL_WINDOW_DAYS))
