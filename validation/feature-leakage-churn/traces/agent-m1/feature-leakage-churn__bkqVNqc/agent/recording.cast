[173.505835, "o", "    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[173.505866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[173.505893, "o", "\u001b[?2004h> "]
[173.506039, "o", "def activity_features(points, orders, tickets):\r\n\u001b[?2004l\r"]
[173.506072, "o", "\u001b[?2004h> "]
[173.506242, "o", "    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n\u001b[?2004l\r"]
[173.506276, "o", "\u001b[?2004h> "]
[173.506304, "o", "    \r\n\u001b[?2004l\r"]
[173.50633, "o", "\u001b[?2004h> "]
[173.506509, "o", "    def compute_feat(events, ts_col, days, amount_col=None):\r\n\u001b[?2004l\r"]
[173.506541, "o", "\u001b[?2004h> "]
[173.506728, "o", "        c_out_count = np.zeros(len(points), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[173.506764, "o", "\u001b[?2004h> "]
[173.506949, "o", "        c_out_amount = np.zeros(len(points), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[173.506984, "o", "\u001b[?2004h> "]
[173.507006, "o", "        \r\n\u001b[?2004l\r"]
[173.507027, "o", "\u001b[?2004h"]
[173.507049, "o", "> "]
[173.507166, "o", "        # Group by customer for efficiency\r\n\u001b[?2004l\r"]
[173.507199, "o", "\u001b[?2004h> "]
[173.507383, "o", "        for cid, cust_ev in events.groupby(\"customer_id\"):\r\n\u001b[?2004l\r"]
[173.507418, "o", "\u001b[?2004h"]
[173.507441, "o", "> "]
[173.50764, "o", "            mask_pts = (points[\"customer_id\"].values == cid)\r\n\u001b[?2004l\r"]
[173.507673, "o", "\u001b[?2004h> "]
[173.5078, "o", "            if not np.any(mask_pts):\r\n\u001b[?2004l\r"]
[173.507836, "o", "\u001b[?2004h> "]
[173.507912, "o", "                continue\r\n\u001b[?2004l\r"]
[173.507936, "o", "\u001b[?2004h"]
[173.507964, "o", "> "]
[173.507991, "o", "            \r\n\u001b[?2004l\r"]
[173.50802, "o", "\u001b[?2004h"]
[173.508042, "o", "> "]
[173.50824, "o", "            pts_as_of = _seconds(points.loc[mask_pts, \"as_of\"])\r\n\u001b[?2004l\r"]
[173.508267, "o", "\u001b[?2004h"]
[173.508295, "o", "> "]
[173.508422, "o", "            c_ts = _seconds(cust_ev[ts_col])\r\n\u001b[?2004l\r"]
[173.508456, "o", "\u001b[?2004h> "]
[173.508608, "o", "            c_loaded = _seconds(cust_ev[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[173.508638, "o", "\u001b[?2004h> "]
[173.508834, "o", "            c_amount = cust_ev[amount_col].values if amount_col else None\r\n\u001b[?2004l\r"]
[173.508871, "o", "\u001b[?2004h> "]
[173.508895, "o", "            \r\n\u001b[?2004l\r"]
[173.508921, "o", "\u001b[?2004h> "]
[173.509044, "o", "            for i, t in enumerate(pts_as_of):\r\n\u001b[?2004l\r"]
[173.509074, "o", "\u001b[?2004h> "]
[173.509298, "o", "                visible = (c_ts < t) & (c_loaded < t) & (c_ts >= t - days * 86400)\r\n\u001b[?2004l\r"]
[173.50933, "o", "\u001b[?2004h> "]
[173.509484, "o", "                c_out_count[mask_pts][i] = np.sum(visible)\r\n\u001b[?2004l\r"]
[173.509512, "o", "\u001b[?2004h> "]
[173.509593, "o", "                if amount_col:\r\n\u001b[?2004l\r"]
[173.509627, "o", "\u001b[?2004h> "]
[173.509869, "o", "                    c_out_amount[mask_pts][i] = np.sum(c_amount[visible])\r\n\u001b[?2004l\r"]
[173.5099, "o", "\u001b[?2004h> "]
[173.510042, "o", "        return c_out_count, c_out_amount\r\n\u001b[?2004l\r"]
[173.510073, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[173.510105, "o", "\u001b[?2004h> "]
[173.510282, "o", "    o7_c, _ = compute_feat(orders, \"ordered_at\", 7)\r\n\u001b[?2004l\r"]
[173.510316, "o", "\u001b[?2004h> "]
[173.510405, "o", "    out[\"orders_7d\"] = o7_c\r\n\u001b[?2004l\r"]
[173.510435, "o", "\u001b[?2004h> "]
[173.510696, "o", "    o30_c, o30_a = compute_feat(orders, \"ordered_at\", 30, \"amount_cents\")\r\n\u001b[?2004l\r"]
[173.510728, "o", "\u001b[?2004h> "]
[173.510833, "o", "    out[\"orders_30d\"] = o30_c\r\n\u001b[?2004l\r"]
[173.510865, "o", "\u001b[?2004h"]
[173.510887, "o", "> "]
[173.510988, "o", "    out[\"spend_30d_cents\"] = o30_a\r\n\u001b[?2004l\r"]
[173.51102, "o", "\u001b[?2004h> "]
[173.511204, "o", "    t30_c, _ = compute_feat(tickets, \"opened_at\", 30)\r\n\u001b[?2004l\r"]
[173.51124, "o", "\u001b[?2004h> "]
[173.511344, "o", "    out[\"tickets_30d\"] = t30_c\r\n\u001b[?2004l\r"]
[173.511376, "o", "\u001b[?2004h"]
[173.511398, "o", "> \r\n\u001b[?2004l\r"]
[173.51142, "o", "\u001b[?2004h> "]
[173.511506, "o", "    # days_since_last_order\r\n\u001b[?2004l\r"]
[173.511536, "o", "\u001b[?2004h> "]
[173.511753, "o", "    last_order_ts = np.full(len(points), -1, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[173.511789, "o", "\u001b[?2004h> "]
[173.511981, "o", "    for cid, cust_ev in orders.groupby(\"customer_id\"):\r\n\u001b[?2004l\r"]
[173.512017, "o", "\u001b[?2004h> "]
[173.512209, "o", "        mask_pts = (points[\"customer_id\"].values == cid)\r\n\u001b[?2004l\r"]
[173.512241, "o", "\u001b[?2004h> "]
[173.512352, "o", "        if not np.any(mask_pts):\r\n\u001b[?2004l\r"]
[173.512381, "o", "\u001b[?2004h"]
[173.512403, "o", "> "]
[173.512457, "o", "            continue\r\n\u001b[?2004l\r"]
[173.512488, "o", "\u001b[?2004h"]
[173.51251, "o", "> "]
[173.512707, "o", "        pts_as_of = _seconds(points.loc[mask_pts, \"as_of\"])\r\n\u001b[?2004l\r"]
[173.512738, "o", "\u001b[?2004h"]
[173.512759, "o", "> "]
[173.5129, "o", "        c_ts = _seconds(cust_ev[\"ordered_at\"])\r\n\u001b[?2004l\r"]
[173.512933, "o", "\u001b[?2004h"]
[173.512956, "o", "> "]
[173.513101, "o", "        c_loaded = _seconds(cust_ev[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[173.513137, "o", "\u001b[?2004h> "]
[173.513284, "o", "        for i, t in enumerate(pts_as_of):\r\n\u001b[?2004l\r"]
[173.513321, "o", "\u001b[?2004h> "]
[173.513482, "o", "            visible = (c_ts < t) & (c_loaded < t)\r\n\u001b[?2004l\r"]
[173.513515, "o", "\u001b[?2004h"]
[173.513537, "o", "> "]
[173.513623, "o", "            if np.any(visible):\r\n\u001b[?2004l\r"]
[173.51365, "o", "\u001b[?2004h> "]
[173.513871, "o", "                last_order_ts[mask_pts][i] = np.max(c_ts[visible])\r\n\u001b[?2004l\r"]
[173.513901, "o", "\u001b[?2004h> "]
[173.513962, "o", "                \r\n\u001b[?2004l\r"]
[173.513994, "o", "\u001b[?2004h"]
[173.514015, "o", "> "]
[173.514135, "o", "    out[\"days_since_last_order\"] = np.nan\r\n\u001b[?2004l\r"]
[173.514177, "o", "\u001b[?2004h> "]
[173.51428, "o", "    valid = last_order_ts != -1\r\n\u001b[?2004l\r"]
[173.51431, "o", "\u001b[?2004h> "]
[173.514718, "o", "    out.loc[valid, \"days_since_last_order\"] = (_seconds(points.loc[valid, \"as_of\"]) - last_order_ts[valid]) / 86400.0\r\n\u001b[?2004l\r"]
[173.514753, "o", "\u001b[?2004h"]
[173.514776, "o", "> "]
[173.514813, "o", "    return out\r\n\u001b[?2004l\r"]
[173.514844, "o", "\u001b[?2004h"]
[173.514866, "o", "> \r\n"]
[173.514891, "o", "\u001b[?2004l\r\u001b[?2004h"]
[173.514913, "o", "> "]
[173.514993, "o", "def tenure_days(points, customers):\r\n\u001b[?2004l\r"]
[173.515028, "o", "\u001b[?2004h> "]
[173.51531, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[173.515342, "o", "\u001b[?2004h> "]
[173.515572, "o", "    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[173.515606, "o", "\u001b[?2004h> "]
[173.515629, "o", "EOF\r\n\u001b[?2004l\r"]
[173.517932, "o", "\u001b[?2004hroot@0432d6e1-dec3-4bcf-ae71-fd6d51d91e66:/app# "]
