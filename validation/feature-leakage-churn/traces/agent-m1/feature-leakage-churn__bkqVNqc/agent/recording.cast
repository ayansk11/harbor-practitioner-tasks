[173.505096, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.505139, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[173.505177, "o", "\u001b[?2004h> "]
