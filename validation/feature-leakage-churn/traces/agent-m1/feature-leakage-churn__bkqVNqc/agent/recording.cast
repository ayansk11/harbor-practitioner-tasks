[320.324172, "i", "cat << 'EOF' > /app/churn/attributes.py\n\"\"\"Customer attributes from the customer record: the subscription plan.\n\nPoint in time: reconstruct the plan as of as_of using plan_changes.\n\"\"\"\nimport pandas as pd\n\ndef plan(points, customers, plan_changes):\n    \"\"\"The customer's subscription plan as of as_of.\"\"\"\n    # Initial plan: if changes exist, the old_plan of the first change (by changed_at).\n    # Else, the plan in customers table.\n    first_changes = plan_changes.sort_values([\"customer_id\", \"changed_at\"]).groupby(\"customer_id\").first()\n    signup_plans = first_changes[\"old_plan\"]\n    \n    pts = points.sort_values(\"as_of\").reset_index()\n    # Sort by both _loaded_at and changed_at to ensure merge_asof picks the latest change within a sync\n    changes = plan_changes.sort_values([\"_loaded_at\", \"changed_at\"])\n    \n    merged = pd.merge_asof(\n        pts, \n        changes, \n        left_on=\"as_of\", \n        right_on=\"_loaded_at\", \n        by=\"customer_id\", \n        direction=\"backward\"\n    )\n    \n    # The plan is "]
[320.324326, "i", "the new_plan of the latest change committed before as_of\n    # Use merged.new_plan if it exists, else signup_plans, else customers.plan\n    final_plans = merged[\"new_plan\"].fillna(merged[\"customer_id\"].map(signup_plans))\n    final_plans = final_plans.fillna(merged[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"]))\n    \n    # Put it back in the original order of 'points'\n    res = pd.Series(index=points.index, dtype=object)\n    res.loc[merged[\"index\"]] = final_plans.values\n    return res\nEOF\n"]
