[127.078788, "o", "root@0432d6e1-dec3-4bcf-ae71-fd6d51d91e66:/app# "]
[127.55435, "i", "cat << 'EOF' > /app/churn/status.py\n\"\"\"Account status from the billing system's status snapshots, point in time.\"\"\"\nimport pandas as pd\nimport numpy as np\n\ndef latest_status(points, snapshots):\n    out = np.full(len(points), None, dtype=object)\n    for cid, cust_snaps in snapshots.groupby(\"customer_id\"):\n        mask_pts = (points[\"customer_id\"].values == cid)\n        if not np.any(mask_pts):\n            continue\n        pts_as_of = points.loc[mask_pts, \"as_of\"]\n        pts_day = pts_as_of.dt.floor(\"D\")\n        s_date = cust_snaps[\"snapshot_date\"]\n        s_loaded = cust_snaps[\"_loaded_at\"]\n        for i, (day, as_of) in enumerate(zip(pts_day, pts_as_of)):\n            visible = (s_date < day) & (s_loaded < as_of)\n            if np.any(visible):\n                best_idx = cust_snaps[visible][\"snapshot_date\"].idxmax()\n                out[mask_pts][i] = snapshots.loc[best_idx, \"status\"]\n    return pd.Series(out, index=points.index)\nEOF\n"]
[127.554536, "o", "cat << 'EOF' > /app/churn/status.py\r\n"]
