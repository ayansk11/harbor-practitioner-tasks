[127.067918, "i", "cat << 'EOF' > /app/churn/windows.py\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time-since features.\n\nPoint in time: a window is [t - W days, t) on the exact event timestamps, AND the row must be committed before t.\n\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\n\ndef _seconds(ts):\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\ndef activity_features(points, orders, tickets):\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n    \n    def compute_feat(events, ts_col, days, amount_col=None):\n        c_out_count = np.zeros(len(points), dtype=\"int64\")\n        c_out_amount = np.zeros(len(points), dtype=\"int64\")\n        \n        # Group by customer for efficiency\n        for cid, cust_ev in events.groupby(\"customer_id\"):\n            mask_pts = (points[\"customer_id\"].values == cid)\n            if not np.any(mask_pts):\n                continue\n            \n            pts_as_of = _seconds(points.loc[mask_pts, \"a"]
[127.068011, "i", "s_of\"]).values\n            c_ts = _seconds(cust_ev[ts_col]).values\n            c_loaded = _seconds(cust_ev[\"_loaded_at\"]).values\n            c_amount = cust_ev[amount_col].values if amount_col else None\n            \n            for i, t in enumerate(pts_as_of):\n                visible = (c_ts < t) & (c_loaded < t) & (c_ts >= t - days * 86400)\n                c_out_count[mask_pts][i] = np.sum(visible)\n                if amount_col:\n                    c_out_amount[mask_pts][i] = np.sum(c_amount[visible])\n        return c_out_count, c_out_amount\n\n    o7_c, _ = compute_feat(orders, \"ordered_at\", 7)\n    out[\"orders_7d\"] = o7_c\n    o30_c, o30_a = compute_feat(orders, \"ordered_at\", 30, \"amount_cents\")\n    out[\"orders_30d\"] = o30_c\n    out[\"spend_30d_cents\"] = o30_a\n    t30_c, _ = compute_feat(tickets, \"opened_at\", 30)\n    out[\"tickets_30d\"] = t30_c\n\n    # days_since_last_order\n    last_order_ts = np.full(len(points), -1, dtype=\"int64\")\n    for cid, cust_ev in orders.groupby(\"customer_id\"):\n        mask_pts = (point"]
[127.068046, "i", "s[\"customer_id\"].values == cid)\n        if not np.any(mask_pts):\n            continue\n        pts_as_of = _seconds(points.loc[mask_pts, \"as_of\"]).values\n        c_ts = _seconds(cust_ev[\"ordered_at\"]).values\n        c_loaded = _seconds(cust_ev[\"_loaded_at\"]).values\n        for i, t in enumerate(pts_as_of):\n            visible = (c_ts < t) & (c_loaded < t)\n            if np.any(visible):\n                last_order_ts[mask_pts][i] = np.max(c_ts[visible])\n                \n    out[\"days_since_last_order\"] = np.nan\n    valid = last_order_ts != -1\n    out.loc[valid, \"days_since_last_order\"] = (_seconds(points.loc[valid, \"as_of\"]) - last_order_ts[valid]) / 86400.0\n    return out\n\ndef tenure_days(points, customers):\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\n    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\nEOF\n"]
