[204.305206, "o", "    main()\r\n  File \"/app/churn/build_features.py\", line 32, in main\r\n    feats = build(a.data)\r\n            ^^^^^^^^^^^^^\r\n  File \"/app/churn/build_features.py\", line 22, in build\r\n"]
