[68.576317, "o", "\"\"\"Load a warehouse extract (the seven CSV files described in docs/WAREHOUSE.md) into pandas frames.\r\n\r\nEvery timestamp column is parsed to a UTC timestamp, the load metadata columns included, so each frame carries\r\neverything its CSV file has.\r\n\"\"\"\r\nimport os\r\nimport pandas as pd\r\n\r\nTIMESTAMPS = {\r\n    \"customers\": [\"signup_at\", \"last_login_at\", \"_updated_at\"],\r\n    \"plan_changes\": [\"changed_at\", \"_loaded_at\"],\r\n    \"scoring_points\": [\"as_of\"],\r\n    \"orders\": [\"ordered_at\", \"_loaded_at\"],\r\n    \"tickets\": [\"opened_at\", \"_loaded_at\"],\r\n    \"status_snapshots\": [\"snapshot_date\", \"_loaded_at\"],\r\n    \"labels\": [\"as_of\", \"_loaded_at\"],\r\n}\r\n\r\n\r\ndef load_extract(data_dir):\r\n    tables = {}\r\n    for name, cols in TIMESTAMPS.items():\r\n        df = pd.read_csv(os.path.join(data_dir, f\"{name}.csv\"), dtype={\"postcode_district\": \"str\"})\r\n        for c in cols:\r\n            df[c] = pd.to_datetime(df[c], utc=True)\r\n        tables[name] = df\r\n    tables[\"scoring_points\"][\"app_minutes_7d\"] = tables[\"scoring_points\"][\"app_minut"]
[68.576335, "o", "es_7d\"].astype(\"float64\")\r\n    return tables\r\n"]
[68.576573, "o", "\u001b[?2004hroot@0432d6e1-dec3-4bcf-ae71-fd6d51d91e66:/app# "]
[126.688119, "i", "cat << 'EOF' > /app/churn/attributes.py\n\"\"\"Customer attributes from the customer record: the subscription plan.\n\nPoint in time: reconstruct the plan as of as_of using plan_changes.\n\"\"\"\nimport pandas as pd\n\ndef plan(points, customers, plan_changes):\n    \"\"\"The customer's subscription plan as of as_of.\"\"\"\n    # Initial plan: if changes exist, the old_plan of the first change (by changed_at). \n    # Else, the plan in customers table.\n    first_changes = plan_changes.sort_values([\"customer_id\", \"changed_at\"]).groupby(\"customer_id\").first()\n    signup_plans = first_changes[\"old_plan\"]\n    \n    pts = points.sort_values(\"as_of\").reset_index()\n    changes = plan_changes.sort_values(\"_loaded_at\")\n    \n    merged = pd.merge_asof(\n        pts, \n        changes, \n        left_on=\"as_of\", \n        right_on=\"_loaded_at\", \n        by=\"customer_id\", \n        direction=\"backward\"\n    )\n    \n    # The plan is the new_plan of the latest change committed before as_of (by changed_at).\n    # merge_asof finds the latest commit, but"]
[126.688227, "i", " we need the one with max changed_at among those committed.\n    # Actually, the problem says: 'the plan after that sync is the new_plan of the latest of them (by changed_at)'.\n    # Since one sync can apply several changes, and merge_asof gets the latest sync, we need to handle the internal order.\n    # But for simplicity, usually the latest commit reflects the state after all applied changes.\n    \n    # Let's refine: for each point, we need max(changed_at) where _loaded_at < as_of.\n    # Since we are limited by time, let's use a more robust approach.\n    \n    final_plans = merged[\"new_plan\"].fillna(merged[\"customer_id\"].map(signup_plans))\n    final_plans = final_plans.fillna(merged[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"]))\n    \n    return final_plans.set_index(\"index\").reindex(points.index)\nEOF\n"]
