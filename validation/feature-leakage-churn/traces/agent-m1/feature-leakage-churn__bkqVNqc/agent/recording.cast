[320.327182, "o", "\u001b[?2004h"]
[320.327218, "o", "> "]
[320.327451, "o", "    # Else, the plan in customers table.\r\n\u001b[?2004l\r"]
[320.327493, "o", "\u001b[?2004h"]
[320.327527, "o", "> "]
[320.328112, "o", "    first_changes = plan_changes.sort_values([\"customer_id\", \"changed_at\"]).groupby(\"customer_id\").first()\r\n\u001b[?2004l\r"]
[320.328177, "o", "\u001b[?2004h> "]
[320.328434, "o", "    signup_plans = first_changes[\"old_plan\"]\r\n\u001b[?2004l\r"]
[320.328498, "o", "\u001b[?2004h> "]
[320.32855, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[320.328592, "o", "> "]
[320.328861, "o", "    pts = points.sort_values(\"as_of\").reset_index()\r\n\u001b[?2004l\r"]
[320.328897, "o", "\u001b[?2004h"]
[320.32893, "o", "> "]
[320.329495, "o", "    # Sort by both _loaded_at and changed_at to ensure merge_asof picks the latest change within a sync\r\n\u001b[?2004l\r"]
[320.329539, "o", "\u001b[?2004h"]
[320.329571, "o", "> "]
[320.329962, "o", "    changes = plan_changes.sort_values([\"_loaded_at\", \"changed_at\"])\r\n\u001b[?2004l\r"]
[320.330014, "o", "\u001b[?2004h> "]
[320.330054, "o", "    \r\n\u001b[?2004l\r"]
[320.330092, "o", "\u001b[?2004h"]
[320.330129, "o", "> "]
[320.330276, "o", "    merged = pd.merge_asof(\r\n\u001b[?2004l\r"]
[320.330311, "o", "\u001b[?2004h"]
[320.330352, "o", "> "]
[320.330403, "o", "        pts, \r\n\u001b[?2004l\r"]
[320.330443, "o", "\u001b[?2004h"]
[320.330481, "o", "> "]
[320.330553, "o", "        changes, \r\n\u001b[?2004l\r"]
[320.330587, "o", "\u001b[?2004h> "]
[320.33075, "o", "        left_on=\"as_of\", \r\n\u001b[?2004l\r"]
[320.330807, "o", "\u001b[?2004h"]
[320.330839, "o", "> "]
[320.330968, "o", "        right_on=\"_loaded_at\", \r\n\u001b[?2004l\r"]
[320.331008, "o", "\u001b[?2004h> "]
[320.331167, "o", "        by=\"customer_id\", \r\n\u001b[?2004l\r"]
[320.331209, "o", "\u001b[?2004h"]
[320.331243, "o", "> "]
[320.331378, "o", "        direction=\"backward\"\r\n\u001b[?2004l\r"]
[320.331415, "o", "\u001b[?2004h"]
[320.331441, "o", "> "]
[320.331474, "o", "    )\r\n\u001b[?2004l\r"]
[320.331507, "o", "\u001b[?2004h"]
[320.331545, "o", "> "]
[320.331583, "o", "    \r\n"]
[320.331616, "o", "\u001b[?2004l\r\u001b[?2004h"]
[320.331649, "o", "> "]
[320.332006, "o", "    # The plan is the new_plan of the latest change committed before as_of\r\n\u001b[?2004l\r"]
[320.332039, "o", "\u001b[?2004h"]
[320.332059, "o", "> "]
[320.332457, "o", "    # Use merged.new_plan if it exists, else signup_plans, else customers.plan\r\n\u001b[?2004l\r"]
[320.3325, "o", "\u001b[?2004h> "]
[320.332953, "o", "    final_plans = merged[\"new_plan\"].fillna(merged[\"customer_id\"].map(signup_plans))\r\n\u001b[?2004l\r"]
[320.332999, "o", "\u001b[?2004h"]
[320.333034, "o", "> "]
[320.333549, "o", "    final_plans = final_plans.fillna(merged[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"]))\r\n\u001b[?2004l\r"]
[320.33359, "o", "\u001b[?2004h> "]
[320.333628, "o", "    \r\n\u001b[?2004l\r"]
[320.333664, "o", "\u001b[?2004h"]
[320.333697, "o", "> "]
[320.333974, "o", "    # Put it back in the original order of 'points'\r\n\u001b[?2004l\r"]
[320.334018, "o", "\u001b[?2004h"]
[320.334055, "o", "> "]
[320.334412, "o", "    res = pd.Series(index=points.index, dtype=object)\r\n\u001b[?2004l\r"]
[320.33446, "o", "\u001b[?2004h"]
[320.33449, "o", "> "]
[320.334834, "o", "    res.loc[merged[\"index\"]] = final_plans.values\r\n\u001b[?2004l\r"]
[320.33488, "o", "\u001b[?2004h"]
[320.334919, "o", "> "]
[320.33501, "o", "    return res\r\n\u001b[?2004l\r"]
[320.335048, "o", "\u001b[?2004h"]
[320.33508, "o", "> "]
[320.335123, "o", "EOF\r\n\u001b[?2004l\r"]
[320.337302, "o", "\u001b[?2004hroot@0432d6e1-dec3-4bcf-ae71-fd6d51d91e66:/app# "]
[320.718646, "i", "time python3 -m churn.build_features --data /app/data --out /app/test_output.parquet\n"]
