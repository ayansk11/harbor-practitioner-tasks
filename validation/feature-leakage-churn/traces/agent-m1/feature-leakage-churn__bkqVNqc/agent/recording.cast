[127.068879, "o", "Point in time: a window is [t - W days, t) on the exact event timestamps, AND the row must be committed before t.\r\n\u001b[?2004l\r"]
[127.068901, "o", "\u001b[?2004h"]
[127.068916, "o", "> \"\"\"\r\n"]
[127.068942, "o", "\u001b[?2004l\r"]
[127.06896, "o", "\u001b[?2004h> "]
[127.069009, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[127.069025, "o", "\u001b[?2004h"]
[127.069042, "o", "> "]
[127.069092, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[127.06911, "o", "\u001b[?2004h> "]
[127.069136, "o", "\r\n\u001b[?2004l\r"]
[127.069156, "o", "\u001b[?2004h> "]
[127.069252, "o", "EPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n\u001b[?2004l\r"]
[127.069272, "o", "\u001b[?2004h"]
[127.069286, "o", "> \r\n\u001b[?2004l\r"]
[127.0693, "o", "\u001b[?2004h"]
[127.069319, "o", "> "]
[127.069352, "o", "def _seconds(ts):\r\n\u001b[?2004l\r"]
[127.069367, "o", "\u001b[?2004h"]
[127.069381, "o", "> "]
[127.069563, "o", "    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[127.069584, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[127.069602, "o", "\u001b[?2004h"]
[127.069617, "o", "> "]
[127.069731, "o", "def activity_features(points, orders, tickets):\r\n\u001b[?2004l\r"]
[127.06975, "o", "\u001b[?2004h> "]
[127.069881, "o", "    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n\u001b[?2004l\r"]
[127.069902, "o", "\u001b[?2004h"]
[127.069913, "o", ">     \r\n\u001b[?2004l\r"]
[127.069933, "o", "\u001b[?2004h> "]
[127.07009, "o", "    def compute_feat(events, ts_col, days, amount_col=None):\r\n\u001b[?2004l\r"]
[127.070103, "o", "\u001b[?2004h"]
[127.070119, "o", "> "]
[127.070274, "o", "        c_out_count = np.zeros(len(points), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[127.070295, "o", "\u001b[?2004h"]
[127.07031, "o", "> "]
[127.070448, "o", "        c_out_amount = np.zeros(len(points), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[127.070466, "o", "\u001b[?2004h> "]
[127.070497, "o", "        \r\n\u001b[?2004l\r"]
[127.070515, "o", "\u001b[?2004h"]
[127.070521, "o", "> "]
[127.070635, "o", "        # Group by customer for efficiency\r\n\u001b[?2004l\r"]
[127.07065, "o", "\u001b[?2004h> "]
[127.070802, "o", "        for cid, cust_ev in events.groupby(\"customer_id\"):\r\n\u001b[?2004l\r"]
[127.070822, "o", "\u001b[?2004h> "]
[127.070976, "o", "            mask_pts = (points[\"customer_id\"].values == cid)\r\n\u001b[?2004l\r"]
[127.070991, "o", "\u001b[?2004h"]
[127.071011, "o", "> "]
[127.071094, "o", "            if not np.any(mask_pts):\r\n\u001b[?2004l\r"]
[127.071108, "o", "\u001b[?2004h"]
[127.071122, "o", "> "]
[127.071194, "o", "                continue\r\n\u001b[?2004l\r"]
[127.071213, "o", "\u001b[?2004h"]
[127.071229, "o", "> "]
[127.071264, "o", "            \r\n\u001b[?2004l\r"]
[127.071284, "o", "\u001b[?2004h"]
[127.071297, "o", "> "]
[127.071459, "o", "            pts_as_of = _seconds(points.loc[mask_pts, \"as_of\"]).values\r\n\u001b[?2004l\r"]
[127.071475, "o", "\u001b[?2004h"]
[127.07149, "o", "> "]
[127.071608, "o", "            c_ts = _seconds(cust_ev[ts_col]).values\r\n\u001b[?2004l\r"]
[127.071645, "o", "\u001b[?2004h> "]
[127.071784, "o", "            c_loaded = _seconds(cust_ev[\"_loaded_at\"]).values\r\n\u001b[?2004l\r"]
[127.071806, "o", "\u001b[?2004h"]
[127.07182, "o", "> "]
[127.071993, "o", "            c_amount = cust_ev[amount_col].values if amount_col else None\r\n\u001b[?2004l\r"]
[127.072011, "o", "\u001b[?2004h"]
[127.072024, "o", "> "]
[127.072051, "o", "            \r\n\u001b[?2004l\r"]
[127.072065, "o", "\u001b[?2004h"]
[127.072084, "o", "> "]
[127.072197, "o", "            for i, t in enumerate(pts_as_of):\r\n\u001b[?2004l\r"]
[127.072212, "o", "\u001b[?2004h"]
[127.072226, "o", "> "]
[127.072422, "o", "                visible = (c_ts < t) & (c_loaded < t) & (c_ts >= t - days * 86400)\r\n\u001b[?2004l\r"]
[127.072435, "o", "\u001b[?2004h"]
[127.072449, "o", "> "]
[127.072588, "o", "                c_out_count[mask_pts][i] = np.sum(visible)\r\n\u001b[?2004l\r"]
[127.072607, "o", "\u001b[?2004h> "]
[127.072691, "o", "                if amount_col:\r\n\u001b[?2004l\r"]
[127.072707, "o", "\u001b[?2004h"]
[127.072721, "o", "> "]
[127.072896, "o", "                    c_out_amount[mask_pts][i] = np.sum(c_amount[visible])\r\n\u001b[?2004l\r"]
[127.072911, "o", "\u001b[?2004h"]
[127.072929, "o", "> "]
[127.073024, "o", "        return c_out_count, c_out_amount\r\n\u001b[?2004l\r"]
[127.073042, "o", "\u001b[?2004h> "]
[127.073055, "o", "\r\n\u001b[?2004l\r"]
[127.07307, "o", "\u001b[?2004h"]
[127.073086, "o", "> "]
[127.073256, "o", "    o7_c, _ = compute_feat(orders, \"ordered_at\", 7)\r\n\u001b[?2004l\r"]
[127.073276, "o", "\u001b[?2004h> "]
[127.073352, "o", "    out[\"orders_7d\"] = o7_c\r\n\u001b[?2004l\r"]
[127.073368, "o", "\u001b[?2004h"]
[127.073388, "o", "> "]
[127.073556, "o", "    o30_c, o30_a = compute_feat(orders, \"ordered_at\", 30, \"amount_cents\")\r\n\u001b[?2004l\r"]
[127.073576, "o", "\u001b[?2004h> "]
[127.073655, "o", "    out[\"orders_30d\"] = o30_c\r\n\u001b[?2004l\r"]
[127.073669, "o", "\u001b[?2004h"]
[127.07368, "o", "> "]
[127.073766, "o", "    out[\"spend_30d_cents\"] = o30_a\r\n\u001b[?2004l\r"]
[127.073784, "o", "\u001b[?2004h> "]
[127.07392, "o", "    t30_c, _ = compute_feat(tickets, \"opened_at\", 30)\r\n\u001b[?2004l\r"]
[127.073934, "o", "\u001b[?2004h"]
[127.073953, "o", "> "]
[127.074023, "o", "    out[\"tickets_30d\"] = t30_c\r\n\u001b[?2004l\r"]
[127.074042, "o", "\u001b[?2004h> "]
[127.074057, "o", "\r\n\u001b[?2004l\r"]
[127.074071, "o", "\u001b[?2004h"]
[127.074085, "o", "> "]
[127.074145, "o", "    # days_since_last_order\r\n\u001b[?2004l\r"]
[127.074169, "o", "\u001b[?2004h"]
[127.074187, "o", "> "]
[127.074329, "o", "    last_order_ts = np.full(len(points), -1, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[127.07435, "o", "\u001b[?2004h> "]
[127.074485, "o", "    for cid, cust_ev in orders.groupby(\"customer_id\"):\r\n\u001b[?2004l\r"]
[127.0745, "o", "\u001b[?2004h"]
[127.074516, "o", "> "]
[127.074641, "o", "        mask_pts = (points[\"customer_id\"].values == cid)\r\n\u001b[?2004l\r"]
[127.074655, "o", "\u001b[?2004h"]
[127.074669, "o", "> "]
[127.074742, "o", "        if not np.any(mask_pts):\r\n\u001b[?2004l\r"]
[127.074759, "o", "\u001b[?2004h"]
[127.074775, "o", "> "]
[127.074817, "o", "            continue\r\n\u001b[?2004l\r"]
[127.074832, "o", "\u001b[?2004h"]
[127.074846, "o", "> "]
[127.074998, "o", "        pts_as_of = _seconds(points.loc[mask_pts, \"as_of\"]).values\r\n\u001b[?2004l\r"]
[127.075014, "o", "\u001b[?2004h"]
[127.075027, "o", "> "]
[127.075151, "o", "        c_ts = _seconds(cust_ev[\"ordered_at\"]).values\r\n\u001b[?2004l\r"]
[127.07517, "o", "\u001b[?2004h"]
[127.075201, "o", "> "]
[127.075326, "o", "        c_loaded = _seconds(cust_ev[\"_loaded_at\"]).values\r\n\u001b[?2004l\r"]
[127.075603, "o", "\u001b[?2004h>         for i, t in enumerate(pts_as_of):\r\n\u001b[?2004l\r\u001b[?2004h>             visible = (c_ts < t) & (c_loaded < t)\r\n\u001b[?2004l\r"]
[127.07561, "o", "\u001b[?2004h"]
[127.075652, "o", "> "]
[127.075705, "o", "            if np.any(visible):\r\n\u001b[?2004l\r"]
[127.075732, "o", "\u001b[?2004h> "]
[127.075899, "o", "                last_order_ts[mask_pts][i] = np.max(c_ts[visible])\r\n\u001b[?2004l\r"]
[127.075907, "o", "\u001b[?2004h"]
[127.075931, "o", "> "]
[127.075969, "o", "                \r\n\u001b[?2004l\r"]
[127.075995, "o", "\u001b[?2004h> "]
[127.076099, "o", "    out[\"days_since_last_order\"] = np.nan\r\n\u001b[?2004l\r"]
[127.076129, "o", "\u001b[?2004h> "]
[127.076214, "o", "    valid = last_order_ts != -1\r\n\u001b[?2004l\r"]
[127.07625, "o", "\u001b[?2004h> "]
[127.076544, "o", "    out.loc[valid, \"days_since_last_order\"] = (_seconds(points.loc[valid, \"as_of\"]) - last_order_ts[valid]) / 86400.0\r\n\u001b[?2004l\r"]
[127.076571, "o", "\u001b[?2004h> "]
[127.076614, "o", "    return out\r\n\u001b[?2004l\r"]
[127.076628, "o", "\u001b[?2004h"]
[127.076646, "o", "> \r\n"]
[127.076662, "o", "\u001b[?2004l\r\u001b[?2004h"]
[127.076677, "o", "> "]
[127.076769, "o", "def tenure_days(points, customers):\r\n\u001b[?2004l\r"]
[127.076784, "o", "\u001b[?2004h"]
[127.076799, "o", "> "]
[127.07702, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[127.077036, "o", "\u001b[?2004h"]
[127.07705, "o", "> "]
[127.077233, "o", "    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[127.077247, "o", "\u001b[?2004h"]
[127.07726, "o", "> EOF"]
[127.077272, "o", "\r\n\u001b[?2004l\r"]
