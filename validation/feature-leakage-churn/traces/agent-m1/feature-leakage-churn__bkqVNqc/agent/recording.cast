[241.229568, "o", "\u001b[?2004h> "]
[241.229638, "o", "    merged = pd.merge_asof(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.229713, "o", "        pts, \r\n\u001b[?2004l\r\u001b[?2004h> "]
