[127.952746, "i", "cat << 'EOF' > /app/churn/encoding.py\n\"\"\"Target encoding of high-cardinality categoricals, point in time.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nPRIOR_WEIGHT = 20\nDEFAULT_PRIOR = 0.05\nLABEL_WINDOW_DAYS = 30\n\ndef district_encoding(points, labels, customers):\n    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    out = np.full(len(points), np.nan, dtype=\"float64\")\n    labels = labels.copy()\n    labels[\"district\"] = labels[\"customer_id\"].map(district)\n    \n    # Optimization: sort points and use a sliding window of visible labels\n    pts_sorted = points.sort_values(\"as_of\").reset_index()\n    labels_sorted = labels.copy()\n    labels_sorted[\"vis_time\"] = np.maximum(labels_sorted[\"_loaded_at\"], labels_sorted[\"as_of\"] + pd.Timedelta(days=LABEL_WINDOW_DAYS))\n    labels_sorted = labels_sorted.sort_values(\"vis_time\")\n    \n    global_sum, global_count = 0, 0\n    dist_sums, dist_counts = {}, {}\n    label_idx = 0\n    num_labels = len(labels_sorted)\n    results = []\n    \n    for _, row in pts_sorted"]
[127.952785, "i", ".iterrows():\n        t = row[\"as_of\"]\n        while label_idx < num_labels and labels_sorted.iloc[label_idx][\"vis_time\"] < t:\n            l_row = labels_sorted.iloc[label_idx]\n            y = l_row[\"churned_30d\"]\n            d = l_row[\"district\"]\n            global_sum += y\n            global_count += 1\n            dist_sums[d] = dist_sums.get(d, 0) + y\n            dist_counts[d] = dist_counts.get(d, 0) + 1\n            label_idx += 1\n        \n        dist = district.get(row[\"customer_id\"])\n        p = global_sum / global_count if global_count > 0 else DEFAULT_PRIOR\n        s = dist_sums.get(dist, 0)\n        n = dist_counts.get(dist, 0)\n        results.append((s + PRIOR_WEIGHT * p) / (n + PRIOR_WEIGHT))\n        \n    res_series = pd.Series(results, index=pts_sorted[\"index\"])\n    return res_series.reindex(points.index)\nEOF\n"]
[127.95301, "o", "cat << 'EOF' > /app/churn/encoding.py\r\n"]
