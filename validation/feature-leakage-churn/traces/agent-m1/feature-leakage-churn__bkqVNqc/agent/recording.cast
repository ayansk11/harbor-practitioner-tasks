[127.954818, "o", "    labels = labels.copy()\r\n\u001b[?2004l\r"]
[127.954851, "o", "\u001b[?2004h> "]
[127.954933, "o", "    labels[\"district\"] = labels[\"customer_id\"].map(district)\r\n\u001b[?2004l\r"]
[127.955013, "o", "\u001b[?2004h> "]
[127.955114, "o", "    \r\n"]
[127.955251, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[127.955383, "o", "    # Optimization: sort points and use a sliding window of visible labels\r\n\u001b[?2004l\r"]
[127.955479, "o", "\u001b[?2004h> "]
[127.955641, "o", "    pts_sorted = points.sort_values(\"as_of\").reset_index()"]
[127.955676, "o", "\r\n"]
[127.955684, "o", "\u001b[?2004l\r"]
[127.955856, "o", "\u001b[?2004h> "]
[127.955881, "o", "    labels_sorted = labels.copy()\r\n\u001b[?2004l\r"]
[127.955935, "o", "\u001b[?2004h> "]
[127.956292, "o", "    labels_sorted[\"vis_time\"] = np.maximum(labels_sorted[\"_loaded_at\"], labels_sorted[\"as_of\"] + pd.Timedelta(days=LABEL_WINDOW_DAYS))\r\n\u001b[?2004l\r"]
[127.956366, "o", "\u001b[?2004h> "]
[127.956529, "o", "    labels_sorted = labels_sorted.sort_values(\"vis_time\")\r\n"]
[127.956584, "o", "\u001b[?2004l\r"]
[127.956631, "o", "\u001b[?2004h"]
[127.956643, "o", "> "]
[127.957765, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     global_sum, global_count = 0, 0\r\n\u001b[?2004l\r\u001b[?2004h>     dist_sums, dist_counts = {}, {}\r\n\u001b[?2004l\r\u001b[?2004h>     label_idx = 0\r\n\u001b[?2004l\r\u001b[?2004h>     num_labels = len(labels_sorted)\r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for _, row in pts_sorted.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.957875, "o", "        t = row[\"as_of\"]\r\n\u001b[?2004l\r\u001b[?2004h>         while label_idx < num_labels and labels_sorted.iloc[label_idx][\"vis_time\"] < t:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.958004, "o", "            l_row = labels_sorted.iloc[label_idx]\r\n"]
[127.958065, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[127.958198, "o", "            y = l_row[\"churned_30d\"]\r\n"]
[127.958235, "o", "\u001b[?2004l\r"]
[127.958327, "o", "\u001b[?2004h> "]
[127.958385, "o", "            d = l_row[\"district\"]\r\n\u001b[?2004l\r"]
[127.958395, "o", "\u001b[?2004h"]
[127.958421, "o", "> "]
[127.958557, "o", "            global_sum += y\r\n\u001b[?2004l\r"]
[127.958567, "o", "\u001b[?2004h"]
[127.958582, "o", "> "]
[127.958695, "o", "            global_count += 1\r\n\u001b[?2004l\r"]
[127.958728, "o", "\u001b[?2004h> "]
[127.958902, "o", "            dist_sums[d] = dist_sums.get(d, 0) + y\r\n"]
[127.958922, "o", "\u001b[?2004l\r"]
[127.958968, "o", "\u001b[?2004h> "]
[127.959128, "o", "            dist_counts[d] = dist_counts.get(d, 0) + 1\r\n\u001b[?2004l\r"]
[127.959178, "o", "\u001b[?2004h> "]
[127.959287, "o", "            label_idx += 1\r\n"]
[127.959299, "o", "\u001b[?2004l\r"]
[127.959388, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[127.959399, "o", "\u001b[?2004h"]
[127.959487, "o", "> "]
[127.95958, "o", "        dist = district.get(row[\"customer_id\"])\r\n\u001b[?2004l\r"]
[127.959661, "o", "\u001b[?2004h> "]
[127.959869, "o", "        p = global_sum / global_count if global_count > 0 else DEFAULT_PRIOR\r\n"]
[127.959943, "o", "\u001b[?2004l\r\u001b[?2004h"]
[127.959954, "o", "> "]
[127.960079, "o", "        s = dist_sums.get(dist, 0)\r\n\u001b[?2004l\r"]
[127.960122, "o", "\u001b[?2004h"]
[127.96013, "o", "> "]
[127.960265, "o", "        n = dist_counts.get(dist, 0)\r\n\u001b[?2004l\r"]
[127.9603, "o", "\u001b[?2004h"]
[127.96036, "o", "> "]
[127.960586, "o", "        results.append((s + PRIOR_WEIGHT * p) / (n + PRIOR_WEIGHT))\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.961314, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h>     res_series = pd.Series(results, index=pts_sorted[\"index\"])\r\n\u001b[?2004l\r\u001b[?2004h>     return res_series.reindex(points.index)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[127.965161, "o", "\u001b[?2004h"]
[127.965208, "o", "root@0432d6e1-dec3-4bcf-ae71-fd6d51d91e66:/app# "]
[128.367933, "i", "cat << 'EOF' > /app/churn/build_features.py\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\nimport argparse\nimport os\nimport pandas as pd\n\nfrom churn.attributes import plan\nfrom churn.encoding import district_encoding\nfrom churn.extract import load_extract\nfrom churn.impute import fill_app_minutes\nfrom churn.status import latest_status\nfrom churn.windows import activity_features, tenure_days\n\nFEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\n                   \"tenure_days\", \"status\", \"plan\", \"app_minutes_7d\", \"te_district\"]\n\ndef build(data_dir):\n    t = load_extract(data_dir)\n    points = t[\"scoring_points\"].reset_index(drop=True)\n    feats = activity_features(points, t[\"orders\"], t[\"tickets\"])\n    feats[\"tenure_days\"] = tenure_days(points, t[\"customers\"])\n    feats[\"status\"] = latest_status(points, t[\"status_snapshots\"])\n    feats[\"plan\"] = plan(points, t[\"customers\"], t[\"plan_changes\"])\n    feats[\"a"]
[128.368025, "i", "pp_minutes_7d\"] = fill_app_minutes(points)\n    feats[\"te_district\"] = district_encoding(points, t[\"labels\"], t[\"customers\"])\n    return feats[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    a = ap.parse_args()\n    feats = build(a.data)\n    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)\n    feats.to_parquet(a.out, index=False)\n    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {a.out}\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
