[?2004hroot@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# cat > /app/churn/build_features.py << 'PYEOF'
[?2004l[?2004h> """Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>
[?2004l[?2004h> 
[?2004l[?2004h> For every row of scoring_points.csv, compute the value the live scoring service
[?2004l[?2004h> (live/features.py) would have produced at that row's as_of, against the warehouse
[?2004l[?2004h> as it stood at that moment: only rows and values committed before as_of count
[?2004l[?2004h> (a row committed at or after as_of is not seen, an overwrite at or after as_of is
[?2004l[?2004h> seen as it was before the overwrite).
[?2004l[?2004h> 
[?2004l[?2004h> Every feature of live/features.py whose live value the extract determines for every
[?2004l[?2004h> row is kept.  days_since_last_login is left out: the customer's last login has no
[?2004l[?2004h> history in the warehouse, so its value at an earlier as_of cannot be recovered.
[?2004l[?2004h> """
[?2004l[?2004h> import argparse
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> from churn.extract import load_extract
[?2004l[?2004h> from churn.impute import fill_app_minutes
[?2004l[?2004h> 
[?2004l[?2004h> EPOCH = pd.Timestamp("1970-01-01", tz="UTC")
[?2004l[?2004h> STRIDE = 10 ** 10  # customer_id * STRIDE + epoch seconds (seconds < 1e10 until 2286)
[?2004l[?2004h> DAY = 86400
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _sec(ts):
[?2004l[?2004h>     return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _bounds(cids):
[?2004l[?2004h>     """Return (order, group_ids, starts, ends) splitting an array by customer_id."""
[?2004l[?2004h>     order = np.argsort(cids, kind="stable")
[?2004l[?2004h>     sc = cids[order]
[?2004l[?2004h>     change = np.concatenate(([True], sc[1:] != sc[:-1]))
[?2004l[?2004h>     starts = np.flatnonzero(change)
[?2004l[?2004h>     ends = np.concatenate((starts[1:], [sc.shape[0]]))
[?2004l[?2004h>     return order, sc[starts], starts, ends
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _te_district(points, labels, customers):
[?2004l[?2004h>     """Live te_district: (s + 20 p) / (n + 20) over all labels committed before t,
[?2004l[?2004h>     where p is the global mean churned_30d (0.05 when none) and n, s are the count
[?2004l[?2004h>     and sum over the customer's postcode district.  A label is committed at its
[?2004l[?2004h>     _loaded_at, so it is seen at t iff _loaded_at < t."""
[?2004l[?2004h>     dist = customers.set_index("customer_id")["postcode_district"]
[?2004l[?2004h>     lab = labels.copy()
[?2004l[?2004h>     lab["_d"] = lab["customer_id"].map(dist)
[?2004l[?2004h>     lab = lab[lab["_d"].notna()]
[?2004l[?2004h>     lab_d = lab["_d"].to_numpy()
[?2004l[?2004h>     pt_d = points["customer_id"].map(dist).to_numpy()
[?2004l[?2004h>     codes, _ = pd.factorize(np.concatenate([lab_d, pt_d]))
[?2004l[?2004h>     lab_code = codes[: len(lab_d)].astype("int64")
[?2004l[?2004h>     pt_code = codes[len(lab_d):].astype("int64")
[?2004l[?2004h>     y = lab["churned_30d"].to_numpy(dtype="int64")
[?2004l[?2004h>     commit = _sec(lab["_loaded_at"])
[?2004l[?2004h>     t = _sec(points["as_of"])
[?2004l[?2004h> 
[?2004l[?2004h>     # global prior p: mean churned_30d over all labels with _loaded_at < t
[?2004l[?2004h>     order = np.argsort(commit, kind="stable")
[?2004l[?2004h>     ycum = np.concatenate([[0], np.cumsum(y[order])])
[?2004l[?2004h>     N = np.searchsorted(commit[order], t, side="left")
[?2004l[?2004h>     S = ycum[N]
[?2004l[?2004h>     prior = np.full(len(t), 0.05)
[?2004l[?2004h>     has = N > 0
[?2004l[?2004h>     prior[has] = S[has] / N[has]
[?2004l[?2004h> 
[?2004l[?2004h>     # district count/sum over labels with _loaded_at < t
[?2004l[?2004h>     key = lab_code * STRIDE + commit
[?2004l[?2004h>     o2 = np.argsort(key, kind="stable")
[?2004l[?2004h>     ycum2 = np.concatenate([[0], np.cumsum(y[o2])])
[?2004l[?2004h>     lo = np.searchsorted(key[o2], pt_code * STRIDE, side="left")
[?2004l[?2004h>     hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side="left")
[?2004l[?2004h>     n = hi - lo
[?2004l[?2004h>     s = ycum2[hi] - ycum2[lo]
[?2004l[?2004h>     return (s + 20.0 * prior) / (n + 20.0)
[?2004l[?2004h> 
[?2004l[?2004h> 
