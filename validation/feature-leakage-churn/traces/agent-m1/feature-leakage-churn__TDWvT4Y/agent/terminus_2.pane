[?2004l[?2004h> 
[?2004l[?2004h>     ccid = tb["customers"]["customer_id"].astype(int).to_numpy()
[?2004l[?2004h>     signup = dict(zip(ccid, _sec(tb["customers"]["signup_at"])))
[?2004l[?2004h>     planmap = dict(zip(ccid, tb["customers"]["plan"].to_numpy()))
[?2004l[?2004h> 
[?2004l[?2004h>     orders_7d = np.zeros(n, dtype="int64")
[?2004l[?2004h>     orders_30d = np.zeros(n, dtype="int64")
[?2004l[?2004h>     spend_30d = np.zeros(n, dtype="int64")
[?2004l[?2004h>     tickets_30d = np.zeros(n, dtype="int64")
[?2004l[?2004h>     dso = np.full(n, np.nan, dtype="float64")
[?2004l[?2004h>     tenure = np.full(n, np.nan, dtype="float64")
[?2004l[?2004h>     status = np.full(n, None, dtype=object)
[?2004l[?2004h>     plan = np.full(n, None, dtype=object)
[?2004l[?2004h> 
[?2004l[?2004h>     po, pcv2, pps, ppe = _bounds(cid)
