[1090.992474, "o", "def _groups(df, key_col):\r\n\u001b[?2004l\r"]
[1090.992516, "o", "\u001b[?2004h"]
[1090.99255, "o", "> "]
[1090.993141, "o", "    \"\"\"{customer_id: index-array-of-that-customer's rows} for a frame's rows.\"\"\"\r\n\u001b[?2004l\r"]
[1090.993201, "o", "\u001b[?2004h> "]
[1090.993462, "o", "    cids = df[key_col].to_numpy()\r\n\u001b[?2004l\r"]
[1090.993507, "o", "\u001b[?2004h"]
[1090.993548, "o", "> "]
[1090.993893, "o", "    order, cvals, starts, ends = _bounds(cids)\r\n\u001b[?2004l\r"]
[1090.993934, "o", "\u001b[?2004h"]
[1090.993971, "o", "> "]
[1090.994582, "o", "    return {int(cvals[k]): order[starts[k]:ends[k]] for k in range(starts.shape[0])}\r\n\u001b[?2004l\r"]
[1090.994623, "o", "\u001b[?2004h"]
[1090.994662, "o", "> "]
[1090.994699, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1090.994738, "o", "> "]
[1090.99479, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1090.994833, "o", "> "]
[1090.995156, "o", "def _te_district(points, labels, customers):\r\n\u001b[?2004l\r"]
[1090.995195, "o", "\u001b[?2004h"]
[1090.995233, "o", "> "]
[1090.995853, "o", "    \"\"\"Live te_district: (s + 20 p) / (n + 20) over all labels committed before t,\r\n\u001b[?2004l\r"]
[1090.995896, "o", "\u001b[?2004h"]
[1090.995934, "o", "> "]
[1090.99654, "o", "    where p is the global mean churned_30d (0.05 when none) and n, s are the count\r\n\u001b[?2004l\r"]
[1090.996586, "o", "\u001b[?2004h"]
[1090.996625, "o", "> "]
[1090.997271, "o", "    and sum over the customer's postcode district.  A label is committed at its\r\n\u001b[?2004l\r\u001b[?2004h"]
[1090.997376, "o", "> "]
[1090.997728, "o", "    _loaded_at, so it is seen at t iff _loaded_at < t.\"\"\"\r\n\u001b[?2004l\r"]
[1090.997803, "o", "\u001b[?2004h> "]
[1090.998301, "o", "    dist = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[1090.99834, "o", "\u001b[?2004h"]
[1090.9984, "o", "> "]
[1090.998537, "o", "    lab = labels.copy()\r\n\u001b[?2004l\r"]
[1090.998577, "o", "\u001b[?2004h> "]
[1090.998955, "o", "    lab[\"_d\"] = lab[\"customer_id\"].map(dist)\r\n\u001b[?2004l\r"]
[1090.998993, "o", "\u001b[?2004h"]
[1090.999042, "o", "> "]
[1090.999262, "o", "    lab = lab[lab[\"_d\"].notna()]\r\n\u001b[?2004l\r"]
[1090.99931, "o", "\u001b[?2004h> "]
[1090.999569, "o", "    lab_d = lab[\"_d\"].to_numpy()\r\n\u001b[?2004l\r"]
[1090.999611, "o", "\u001b[?2004h> "]
[1091.000043, "o", "    pt_d = points[\"customer_id\"].map(dist).to_numpy()\r\n\u001b[?2004l\r"]
[1091.000082, "o", "\u001b[?2004h> "]
[1091.000543, "o", "    codes, _ = pd.factorize(np.concatenate([lab_d, pt_d]))\r\n\u001b[?2004l\r"]
[1091.000587, "o", "\u001b[?2004h> "]
[1091.000989, "o", "    lab_code = codes[: len(lab_d)].astype(\"int64\")\r\n\u001b[?2004l\r"]
[1091.001026, "o", "\u001b[?2004h"]
[1091.001063, "o", "> "]
[1091.001402, "o", "    pt_code = codes[len(lab_d):].astype(\"int64\")\r\n\u001b[?2004l\r"]
[1091.001443, "o", "\u001b[?2004h> "]
[1091.001826, "o", "    y = lab[\"churned_30d\"].to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1091.001862, "o", "\u001b[?2004h"]
[1091.001897, "o", "> "]
[1091.002148, "o", "    commit = _sec(lab[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[1091.00218, "o", "\u001b[?2004h"]
[1091.002217, "o", "> "]
[1091.002417, "o", "    t = _sec(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[1091.00245, "o", "\u001b[?2004h"]
[1091.002486, "o", "> \r\n\u001b[?2004l\r"]
[1091.00252, "o", "\u001b[?2004h> "]
[1091.003077, "o", "    # global prior p: mean churned_30d over all labels with _loaded_at < t\r\n\u001b[?2004l\r"]
[1091.003111, "o", "\u001b[?2004h"]
[1091.003146, "o", "> "]
[1091.003456, "o", "    order = np.argsort(commit, kind=\"stable\")\r\n\u001b[?2004l\r"]
[1091.003492, "o", "\u001b[?2004h"]
[1091.003529, "o", "> "]
[1091.003907, "o", "    ycum = np.concatenate([[0], np.cumsum(y[order])])\r\n\u001b[?2004l\r"]
[1091.003948, "o", "\u001b[?2004h> "]
[1091.00436, "o", "    N = np.searchsorted(commit[order], t, side=\"left\")\r\n\u001b[?2004l\r"]
[1091.004395, "o", "\u001b[?2004h"]
[1091.004433, "o", "> "]
[1091.004537, "o", "    S = ycum[N]\r\n\u001b[?2004l\r"]
[1091.004571, "o", "\u001b[?2004h"]
[1091.004609, "o", "> "]
[1091.004851, "o", "    prior = np.full(len(t), 0.05)\r\n\u001b[?2004l\r"]
[1091.004885, "o", "\u001b[?2004h"]
[1091.004922, "o", "> "]
[1091.005021, "o", "    has = N > 0\r\n\u001b[?2004l\r"]
[1091.005057, "o", "\u001b[?2004h"]
[1091.005094, "o", "> "]
[1091.005314, "o", "    prior[has] = S[has] / N[has]\r\n\u001b[?2004l\r"]
[1091.00535, "o", "\u001b[?2004h"]
[1091.005386, "o", "> \r\n\u001b[?2004l\r"]
[1091.005422, "o", "\u001b[?2004h> "]
[1091.005845, "o", "    # district count/sum over labels with _loaded_at < t\r\n\u001b[?2004l\r"]
[1091.005878, "o", "\u001b[?2004h"]
[1091.005915, "o", "> "]
[1091.006176, "o", "    key = lab_code * STRIDE + commit\r\n\u001b[?2004l\r"]
[1091.006216, "o", "\u001b[?2004h"]
[1091.006253, "o", "> "]
[1091.006528, "o", "    o2 = np.argsort(key, kind=\"stable\")\r\n\u001b[?2004l\r"]
[1091.006573, "o", "\u001b[?2004h"]
[1091.006597, "o", "> "]
[1091.006984, "o", "    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])\r\n\u001b[?2004l\r"]
[1091.007037, "o", "\u001b[?2004h> "]
[1091.007513, "o", "    lo = np.searchsorted(key[o2], pt_code * STRIDE, side=\"left\")\r\n\u001b[?2004l\r"]
[1091.00756, "o", "\u001b[?2004h> "]
[1091.008082, "o", "    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side=\"left\")\r\n\u001b[?2004l\r"]
[1091.008121, "o", "\u001b[?2004h"]
[1091.008157, "o", "> "]
[1091.008248, "o", "    n = hi - lo\r\n\u001b[?2004l\r"]
[1091.008281, "o", "\u001b[?2004h"]
[1091.008318, "o", "> "]
[1091.008518, "o", "    s = ycum2[hi] - ycum2[lo]\r\n\u001b[?2004l\r"]
[1091.008554, "o", "\u001b[?2004h"]
[1091.00859, "o", "> "]
[1091.008893, "o", "    return (s + 20.0 * prior) / (n + 20.0)\r\n\u001b[?2004l\r"]
[1091.008927, "o", "\u001b[?2004h"]
[1091.008964, "o", "> \r\n\u001b[?2004l\r"]
[1091.009001, "o", "\u001b[?2004h"]
[1091.009038, "o", "> \r\n\u001b[?2004l\r"]
[1091.009076, "o", "\u001b[?2004h> "]
[1091.009214, "o", "def build(data_dir):\r\n\u001b[?2004l\r"]
[1091.009248, "o", "\u001b[?2004h"]
[1091.009284, "o", "> "]
[1091.0095, "o", "    tb = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[1091.009533, "o", "\u001b[?2004h"]
[1091.009569, "o", "> "]
[1091.009973, "o", "    points = tb[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[1091.01001, "o", "\u001b[?2004h> "]
[1091.010173, "o", "    n = len(points)\r\n\u001b[?2004l\r"]
[1091.010212, "o", "\u001b[?2004h> "]
[1091.010628, "o", "    cid = points[\"customer_id\"].to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1091.010668, "o", "\u001b[?2004h"]
[1091.010705, "o", "> "]
[1091.010905, "o", "    t = _sec(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[1091.010962, "o", "\u001b[?2004h> "]
[1091.011001, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1091.011203, "o", "    orders = tb[\"orders\"]\r\n\u001b[?2004l\r"]
[1091.01124, "o", "\u001b[?2004h> "]
[1091.01153, "o", "    o_at = _sec(orders[\"ordered_at\"])\r\n\u001b[?2004l\r"]
[1091.011566, "o", "\u001b[?2004h"]
[1091.011603, "o", "> "]
[1091.011897, "o", "    o_loaded = _sec(orders[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[1091.01194, "o", "\u001b[?2004h> "]
[1091.012375, "o", "    o_amt = orders[\"amount_cents\"].to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1091.012409, "o", "\u001b[?2004h"]
[1091.012439, "o", "> "]
[1091.01274, "o", "    o_grp = _groups(orders, \"customer_id\")\r\n\u001b[?2004l\r"]
[1091.012792, "o", "\u001b[?2004h> "]
[1091.012823, "o", "\r\n\u001b[?2004l\r"]
[1091.012852, "o", "\u001b[?2004h"]
[1091.012881, "o", "> "]
[1091.01306, "o", "    tickets = tb[\"tickets\"]\r\n\u001b[?2004l\r"]
[1091.013096, "o", "\u001b[?2004h"]
[1091.013126, "o", "> "]
[1091.013391, "o", "    k_at = _sec(tickets[\"opened_at\"])\r\n\u001b[?2004l\r"]
[1091.013425, "o", "\u001b[?2004h"]
[1091.013454, "o", "> "]
[1091.013753, "o", "    k_loaded = _sec(tickets[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[1091.013801, "o", "\u001b[?2004h"]
[1091.013831, "o", "> "]
[1091.014137, "o", "    k_grp = _groups(tickets, \"customer_id\")\r\n\u001b[?2004l\r"]
[1091.014172, "o", "\u001b[?2004h"]
[1091.014203, "o", "> \r\n"]
[1091.014233, "o", "\u001b[?2004l\r"]
[1091.014263, "o", "\u001b[?2004h> "]
[1091.014504, "o", "    snaps = tb[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[1091.014538, "o", "\u001b[?2004h"]
[1091.014568, "o", "> "]
[1091.014869, "o", "    s_date = _sec(snaps[\"snapshot_date\"])\r\n\u001b[?2004l\r"]
[1091.014904, "o", "\u001b[?2004h"]
[1091.014934, "o", "> "]
[1091.015219, "o", "    s_loaded = _sec(snaps[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[1091.015254, "o", "\u001b[?2004h"]
[1091.015283, "o", "> "]
[1091.015568, "o", "    s_status = snaps[\"status\"].to_numpy()\r\n\u001b[?2004l\r"]
[1091.015598, "o", "\u001b[?2004h"]
[1091.01563, "o", "> "]
[1091.015893, "o", "    s_grp = _groups(snaps, \"customer_id\")\r\n\u001b[?2004l\r"]
[1091.015926, "o", "\u001b[?2004h"]
[1091.015956, "o", "> \r\n"]
[1091.015989, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1091.016019, "o", "> "]
[1091.016174, "o", "    pc = tb[\"plan_changes\"]\r\n\u001b[?2004l\r"]
[1091.016207, "o", "\u001b[?2004h"]
[1091.016237, "o", "> "]
[1091.016469, "o", "    pc_changed = _sec(pc[\"changed_at\"])\r\n\u001b[?2004l\r"]
[1091.016501, "o", "\u001b[?2004h"]
[1091.016531, "o", "> "]
[1091.016756, "o", "    pc_loaded = _sec(pc[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[1091.016799, "o", "\u001b[?2004h"]
[1091.016829, "o", "> "]
[1091.017067, "o", "    pc_old = pc[\"old_plan\"].to_numpy()\r\n\u001b[?2004l\r"]
[1091.017102, "o", "\u001b[?2004h"]
[1091.017132, "o", "> "]
[1091.017357, "o", "    pc_new = pc[\"new_plan\"].to_numpy()\r\n\u001b[?2004l\r"]
[1091.017391, "o", "\u001b[?2004h"]
[1091.017421, "o", "> "]
[1091.017655, "o", "    pc_rows = _groups(pc, \"customer_id\")\r\n\u001b[?2004l\r"]
[1091.017688, "o", "\u001b[?2004h"]
[1091.017718, "o", "> "]
[1091.017899, "o", "    p_grp, p_base = {}, {}\r\n\u001b[?2004l\r"]
[1091.017946, "o", "\u001b[?2004h> "]
[1091.018157, "o", "    for c_id, r in pc_rows.items():\r\n\u001b[?2004l\r"]
[1091.018193, "o", "\u001b[?2004h"]
[1091.018228, "o", "> "]
[1091.018373, "o", "        ch = pc_changed[r]\r\n\u001b[?2004l\r"]
[1091.018406, "o", "\u001b[?2004h"]
[1091.018441, "o", "> "]
[1091.018739, "o", "        p_grp[c_id] = (ch, pc_loaded[r], pc_new[r])\r\n\u001b[?2004l\r"]
[1091.018788, "o", "\u001b[?2004h> "]
[1091.019231, "o", "        p_base[c_id] = pc_old[r][ch.argmin()]  # plan chosen at sign-up\r\n\u001b[?2004l\r"]
[1091.019279, "o", "\u001b[?2004h"]
[1091.019316, "o", "> \r\n\u001b[?2004l\r"]
[1091.019346, "o", "\u001b[?2004h> "]
[1091.019731, "o", "    ccid = tb[\"customers\"][\"customer_id\"].astype(int).to_numpy()\r\n\u001b[?2004l\r"]
[1091.019764, "o", "\u001b[?2004h"]
[1091.019819, "o", "> "]
[1091.020185, "o", "    signup = dict(zip(ccid, _sec(tb[\"customers\"][\"signup_at\"])))\r\n\u001b[?2004l\r"]
[1091.020227, "o", "\u001b[?2004h"]
[1091.020261, "o", "> "]
[1091.02064, "o", "    planmap = dict(zip(ccid, tb[\"customers\"][\"plan\"].to_numpy()))\r\n\u001b[?2004l\r"]
[1091.020677, "o", "\u001b[?2004h"]
[1091.020711, "o", "> \r\n\u001b[?2004l\r"]
[1091.020752, "o", "\u001b[?2004h"]
[1091.020803, "o", "> "]
[1091.021027, "o", "    orders_7d = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1091.021065, "o", "\u001b[?2004h"]
[1091.0211, "o", "> "]
[1091.021345, "o", "    orders_30d = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1091.021382, "o", "\u001b[?2004h"]
[1091.021417, "o", "> "]
[1091.021655, "o", "    spend_30d = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1091.021689, "o", "\u001b[?2004h"]
[1091.021725, "o", "> "]
[1091.02199, "o", "    tickets_30d = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1091.022026, "o", "\u001b[?2004h"]
[1091.022061, "o", "> "]
[1091.022321, "o", "    dso = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1091.022355, "o", "\u001b[?2004h"]
[1091.022389, "o", "> "]
[1091.022668, "o", "    tenure = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1091.022707, "o", "\u001b[?2004h"]
[1091.022741, "o", "> "]
[1091.022996, "o", "    status = np.full(n, None, dtype=object)\r\n\u001b[?2004l\r"]
[1091.023031, "o", "\u001b[?2004h"]
[1091.023066, "o", "> "]
[1091.023303, "o", "    plan = np.full(n, None, dtype=object)\r\n\u001b[?2004l\r"]
[1091.023338, "o", "\u001b[?2004h"]
[1091.023373, "o", "> \r\n\u001b[?2004l\r"]
[1091.023412, "o", "\u001b[?2004h"]
[1091.023448, "o", "> "]
[1091.023642, "o", "    po, pcv2, pps, ppe = _bounds(cid)\r\n\u001b[?2004l\r"]
[1091.023679, "o", "\u001b[?2004h"]
[1091.02371, "o", "> "]
[1091.023909, "o", "    for k in range(pps.shape[0]):\r\n\u001b[?2004l\r"]
[1091.023942, "o", "\u001b[?2004h"]
[1091.023978, "o", "> "]
[1091.024167, "o", "        idx = po[pps[k]:ppe[k]]\r\n\u001b[?2004l\r"]
[1091.024198, "o", "\u001b[?2004h"]
[1091.024233, "o", "> "]
[1091.024343, "o", "        tt = t[idx]\r\n\u001b[?2004l\r"]
[1091.024373, "o", "\u001b[?2004h"]
[1091.024412, "o", "> "]
[1091.024549, "o", "        c = int(pcv2[k])\r\n\u001b[?2004l\r"]
[1091.024588, "o", "\u001b[?2004h"]
[1091.024626, "o", "> \r\n\u001b[?2004l\r"]
[1091.024662, "o", "\u001b[?2004h> "]
[1091.02481, "o", "        if c in o_grp:\r\n\u001b[?2004l\r"]
[1091.024851, "o", "\u001b[?2004h> "]
[1091.025012, "o", "            r = o_grp[c]\r\n\u001b[?2004l\r"]
[1091.025043, "o", "\u001b[?2004h"]
[1091.025078, "o", "> "]
[1091.025436, "o", "            oat, oload, oamt = o_at[r], o_loaded[r], o_amt[r]\r\n\u001b[?2004l\r"]
[1091.025467, "o", "\u001b[?2004h"]
[1091.025505, "o", "> "]
[1091.025976, "o", "            vis = (oload[None, :] < tt[:, None]) & (oat[None, :] < tt[:, None])\r\n\u001b[?2004l\r"]
[1091.026008, "o", "\u001b[?2004h"]
[1091.026046, "o", "> "]
[1091.026407, "o", "            m7 = vis & (oat[None, :] >= tt[:, None] - 7 * DAY)\r\n\u001b[?2004l\r"]
[1091.026446, "o", "\u001b[?2004h"]
[1091.026482, "o", "> "]
[1091.02686, "o", "            m30 = vis & (oat[None, :] >= tt[:, None] - 30 * DAY)\r\n\u001b[?2004l\r"]
[1091.026893, "o", "\u001b[?2004h"]
[1091.02693, "o", "> "]
[1091.027149, "o", "            orders_7d[idx] = m7.sum(1)\r\n\u001b[?2004l\r"]
[1091.027186, "o", "\u001b[?2004h"]
[1091.027223, "o", "> "]
[1091.027451, "o", "            orders_30d[idx] = m30.sum(1)\r\n\u001b[?2004l\r"]
[1091.027494, "o", "\u001b[?2004h"]
[1091.027529, "o", "> "]
[1091.027932, "o", "            spend_30d[idx] = np.where(m30, oamt[None, :], 0).sum(1)\r\n\u001b[?2004l\r"]
[1091.027974, "o", "\u001b[?2004h> "]
[1091.02846, "o", "            last = np.where(vis, oat[None, :].astype(\"float64\"), -1.0).max(1)\r\n\u001b[?2004l\r"]
[1091.028483, "o", "\u001b[?2004h"]
[1091.028588, "o", "> "]
[1091.029049, "o", "            dso[idx] = np.where(last < 0, np.nan, (tt - last) / DAY)\r\n\u001b[?2004l\r"]
[1091.029081, "o", "\u001b[?2004h"]
[1091.029106, "o", "> "]
[1091.029189, "o", "\r\n"]
[1091.02923, "o", "\u001b[?2004l\r"]
[1091.02937, "o", "\u001b[?2004h> "]
[1091.029399, "o", "        if c in k_grp:\r\n\u001b[?2004l\r"]
[1091.029465, "o", "\u001b[?2004h> "]
[1091.029657, "o", "            r = k_grp[c]\r\n"]
[1091.02968, "o", "\u001b[?2004l\r"]
[1091.029705, "o", "\u001b[?2004h"]
[1091.029732, "o", "> "]
[1091.030112, "o", "            kat, kload = k_at[r], k_loaded[r]\r\n"]
[1091.030138, "o", "\u001b[?2004l\r"]
[1091.030309, "o", "\u001b[?2004h> "]
[1091.03132, "o", "            kvis = (kload[None, :] < tt[:, None]) & (kat[None, :] < tt[:, None])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1091.031602, "o", "            tickets_30d[idx] = (kvis & (kat[None, :] >= tt[:, None] - 30 * DAY)).sum(1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1091.031706, "o", "        supt = signup.get(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1091.031845, "o", "        if supt is not None:\r\n\u001b[?2004l\r"]
[1091.031884, "o", "\u001b[?2004h"]
[1091.031923, "o", "> "]
[1091.032092, "o", "            tenure[idx] = (tt - supt) / DAY\r\n\u001b[?2004l\r"]
[1091.032127, "o", "\u001b[?2004h"]
[1091.03216, "o", "> \r\n\u001b[?2004l\r"]
