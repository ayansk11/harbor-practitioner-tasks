[1091.034782, "o", "\u001b[?2004h"]
[1091.034819, "o", "> "]
[1091.035078, "o", "            pvals = np.full(idx.shape[0], base, dtype=object)\r\n\u001b[?2004l\r"]
[1091.035112, "o", "\u001b[?2004h"]
[1091.035145, "o", "> "]
[1091.035249, "o", "            if c in p_grp:\r\n\u001b[?2004l\r"]
[1091.035282, "o", "\u001b[?2004h> "]
[1091.035507, "o", "                pch, pload, pnew = p_grp[c]\r\n\u001b[?2004l\r"]
[1091.03555, "o", "\u001b[?2004h> "]
[1091.035801, "o", "                pv = pload[None, :] < tt[:, None]\r\n\u001b[?2004l\r"]
[1091.035836, "o", "\u001b[?2004h"]
[1091.035869, "o", "> "]
[1091.035998, "o", "                phas = pv.any(1)\r\n\u001b[?2004l\r"]
[1091.036036, "o", "\u001b[?2004h> "]
[1091.03619, "o", "                if phas.any():\r\n\u001b[?2004l\r"]
[1091.036233, "o", "\u001b[?2004h> "]
[1091.036511, "o", "                    pd_ = np.where(pv, pch[None, :], -1)\r\n\u001b[?2004l\r"]
[1091.036555, "o", "\u001b[?2004h> "]
[1091.036855, "o", "                    pvals[phas] = pnew[pd_.argmax(1)[phas]]\r\n\u001b[?2004l\r"]
[1091.036901, "o", "\u001b[?2004h> "]
[1091.037043, "o", "            plan[idx] = pvals\r\n\u001b[?2004l\r"]
[1091.037088, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1091.037122, "o", "\u001b[?2004h"]
[1091.037156, "o", "> "]
