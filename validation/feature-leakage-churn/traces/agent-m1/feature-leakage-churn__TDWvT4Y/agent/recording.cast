[776.413833, "i", "cat > /app/churn/build_features.py << 'PYEOF'\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\n\nFor every row of scoring_points.csv, compute the value the live scoring service\n(live/features.py) would have produced at that row's as_of, against the warehouse\nas it stood at that moment: only rows and values committed before as_of count\n(a row committed at or after as_of is not seen, an overwrite at or after as_of is\nseen as it was before the overwrite).\n\nEvery feature of live/features.py whose live value the extract determines for every\nrow is kept.  days_since_last_login is left out: the customer's last login has no\nhistory in the warehouse, so its value at an earlier as_of cannot be recovered.\n\"\"\"\nimport argparse\nimport os\n\nimport numpy as np\nimport pandas as pd\n\nfrom churn.extract import load_extract\nfrom churn.impute import fill_app_minutes\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nSTRIDE = 10 ** 10  # customer_id * STRIDE + epoch seconds (seconds < 1e10"]
[776.413972, "i", " until 2286)\nDAY = 86400\n\n\ndef _sec(ts):\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef _bounds(cids):\n    \"\"\"Return (order, group_ids, starts, ends) splitting an array by customer_id.\"\"\"\n    order = np.argsort(cids, kind=\"stable\")\n    sc = cids[order]\n    change = np.concatenate(([True], sc[1:] != sc[:-1]))\n    starts = np.flatnonzero(change)\n    ends = np.concatenate((starts[1:], [sc.shape[0]]))\n    return order, sc[starts], starts, ends\n\n\ndef _te_district(points, labels, customers):\n    \"\"\"Live te_district: (s + 20 p) / (n + 20) over all labels committed before t,\n    where p is the global mean churned_30d (0.05 when none) and n, s are the count\n    and sum over the customer's postcode district.  A label is committed at its\n    _loaded_at, so it is seen at t iff _loaded_at < t.\"\"\"\n    dist = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    lab = labels.copy()\n    lab[\"_d\"] = lab[\"customer_id\"].map(dist)\n    lab = lab[lab[\"_d\"].notna()]\n    lab_d = lab[\"_d\"].to"]
[776.414013, "i", "_numpy()\n    pt_d = points[\"customer_id\"].map(dist).to_numpy()\n    codes, _ = pd.factorize(np.concatenate([lab_d, pt_d]))\n    lab_code = codes[: len(lab_d)].astype(\"int64\")\n    pt_code = codes[len(lab_d):].astype(\"int64\")\n    y = lab[\"churned_30d\"].to_numpy(dtype=\"int64\")\n    commit = _sec(lab[\"_loaded_at\"])\n    t = _sec(points[\"as_of\"])\n\n    # global prior p: mean churned_30d over all labels with _loaded_at < t\n    order = np.argsort(commit, kind=\"stable\")\n    ycum = np.concatenate([[0], np.cumsum(y[order])])\n    N = np.searchsorted(commit[order], t, side=\"left\")\n    S = ycum[N]\n    prior = np.full(len(t), 0.05)\n    has = N > 0\n    prior[has] = S[has] / N[has]\n\n    # district count/sum over labels with _loaded_at < t\n    key = lab_code * STRIDE + commit\n    o2 = np.argsort(key, kind=\"stable\")\n    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])\n    lo = np.searchsorted(key[o2], pt_code * STRIDE, side=\"left\")\n    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side=\"left\")\n    n = hi - lo\n    s = ycum2[hi]"]
[776.414065, "i", " - ycum2[lo]\n    return (s + 20.0 * prior) / (n + 20.0)\n\n\ndef build(data_dir):\n    tb = load_extract(data_dir)\n    points = tb[\"scoring_points\"].reset_index(drop=True)\n    n = len(points)\n    cid = points[\"customer_id\"].to_numpy(dtype=\"int64\")\n    t = _sec(points[\"as_of\"])\n\n    # ---- orders ---------------------------------------------------------------\n    orders = tb[\"orders\"]\n    o_at = _sec(orders[\"ordered_at\"])\n    o_loaded = _sec(orders[\"_loaded_at\"])\n    o_amt = orders[\"amount_cents\"].to_numpy(dtype=\"int64\")\n    oc = orders[\"customer_id\"].to_numpy()\n    oord, ocv, os, oe = _bounds(oc)\n    o_grp = {}\n    for k in range(os.shape[0]):\n        idx = oord[os[k]:oe[k]]\n        o_grp[int(ocv[k])] = (o_at[idx], o_loaded[idx], o_amt[idx])\n\n    # ---- tickets --------------------------------------------------------------\n    tickets = tb[\"tickets\"]\n    k_at = _sec(tickets[\"opened_at\"])\n    k_loaded = _sec(tickets[\"_loaded_at\"])\n    kc = tickets[\"customer_id\"].to_numpy()\n    kord, kcv, ks, ke = _bounds(kc)\n    k"]
[776.414095, "i", "_grp = {}\n    for k in range(ks.shape[0]):\n        idx = kord[ks[k]:ke[k]]\n        k_grp[int(kcv[k])] = (k_at[idx], k_loaded[idx])\n\n    # ---- status snapshots -----------------------------------------------------\n    snaps = tb[\"status_snapshots\"]\n    s_date = _sec(snaps[\"snapshot_date\"])\n    s_loaded = _sec(snaps[\"_loaded_at\"])\n    s_status = snaps[\"status\"].to_numpy()\n    sc = snaps[\"customer_id\"].to_numpy()\n    sword, scv, ss, se = _bounds(sc)\n    s_grp = {}\n    for k in range(ss.shape[0]):\n        idx = sword[ss[k]:se[k]]\n        s_grp[int(scv[k])] = (s_date[idx], s_loaded[idx], s_status[idx])\n\n    # ---- plan changes ---------------------------------------------------------\n    pc = tb[\"plan_changes\"]\n    pc_changed = _sec(pc[\"changed_at\"])\n    pc_loaded = _sec(pc[\"_loaded_at\"])\n    pc_old = pc[\"old_plan\"].to_numpy()\n    pc_new = pc[\"new_plan\"].to_numpy()\n    pcid = pc[\"customer_id\"].to_numpy()\n    pord, pcv, ps, pe = _bounds(pcid)\n    p_grp = {}\n    p_base = {}\n    for k in range(ps.shape[0]):\n        "]
[776.414115, "i", "idx = pord[ps[k]:pe[k]]\n        ch = pc_changed[idx]\n        c_id = int(pcv[k])\n        p_grp[c_id] = (ch, pc_loaded[idx], pc_new[idx])\n        p_base[c_id] = pc_old[idx][ch.argmin()]  # signup plan\n\n    # ---- customers ------------------------------------------------------------\n    ccid = customers_cid = tb[\"customers\"][\"customer_id\"].astype(int).to_numpy()\n    signup = dict(zip(ccid, _sec(tb[\"customers\"][\"signup_at\"])))\n    planmap = dict(zip(ccid, tb[\"customers\"][\"plan\"].to_numpy()))\n\n    # ---- per-customer computation ---------------------------------------------\n    orders_7d = np.zeros(n, dtype=\"int64\")\n    orders_30d = np.zeros(n, dtype=\"int64\")\n    spend_30d = np.zeros(n, dtype=\"int64\")\n    tickets_30d = np.zeros(n, dtype=\"int64\")\n    dso = np.full(n, np.nan, dtype=\"float64\")\n    tenure = np.full(n, np.nan, dtype=\"float64\")\n    status = np.full(n, None, dtype=object)\n    plan = np.full(n, None, dtype=object)\n\n    pcids = points[\"customer_id\"].to_numpy()\n    po, pcv2, pps, ppe = _bounds(pcids)\n    f"]
[776.41424, "i", "or k in range(pps.shape[0]):\n        idx = po[pps[k]:ppe[k]]\n        tt = t[idx]\n        c = int(pcv2[k])\n\n        if c in o_grp:\n            oat, oload, oamt = o_grp[c]\n            vis = oload[None, :] < tt[:, None]\n            m7 = vis & (oat[None, :] >= tt[:, None] - 7 * DAY)\n            m30 = vis & (oat[None, :] >= tt[:, None] - 30 * DAY)\n            orders_7d[idx] = m7.sum(1)\n            orders_30d[idx] = m30.sum(1)\n            spend_30d[idx] = np.where(m30, oamt[None, :], 0).sum(1)\n            last = np.where(vis, oat[None, :].astype(\"float64\"), -1.0).max(1)\n            dso[idx] = np.where(last < 0, np.nan, (tt - last) / DAY)\n\n        if c in k_grp:\n            kat, kload = k_grp[c]\n            kvis = kload[None, :] < tt[:, None]\n            tickets_30d[idx] = (kvis & (kat[None, :] >= tt[:, None] - 30 * DAY)).sum(1)\n\n        tenure[idx] = (tt - signup[c]) / DAY\n\n        if c in s_grp:\n            sdate, sload, sstat = s_grp[c]\n            sv = sload[None, :] < tt[:, None]\n            sd = np.where(sv, s"]
[776.414275, "o", "cat > /app/churn/build_features.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[776.414304, "i", "date[None, :], -1)\n            best = sd.argmax(1)\n            has = sv.any(1)\n            if has.any():\n                status[idx[has]] = sstat[best[has]]\n\n        base = p_base.get(c, planmap[c])\n        pvals = np.full(idx.shape[0], base, dtype=object)\n        if c in p_grp:\n            pch, pload, pnew = p_grp[c]\n            pv = pload[None, :] < tt[:, None]\n            phas = pv.any(1)\n            if phas.any():\n                pd_ = np.where(pv, pch[None, :], -1)\n                pvals[phas] = pnew[pd_.argmax(1)[phas]]\n        plan[idx] = pvals\n\n    app = fill_app_minutes(points).to_numpy()\n    te = _te_district(points, tb[\"labels\"], tb[\"customers\"])\n\n    return pd.DataFrame({\n        \"customer_id\": cid,\n        \"as_of\": points[\"as_of\"],\n        \"orders_7d\": orders_7d,\n        \"orders_30d\": orders_30d,\n        \"spend_30d_cents\": spend_30d,\n        \"tickets_30d\": tickets_30d,\n        \"days_since_last_order\": dso,\n        \"tenure_days\": tenure,\n        \"status\": status,\n        \"plan\": plan,\n        \"app_"]
[776.414338, "o", "\u001b[?2004h> "]
[776.414369, "i", "minutes_7d\": app,\n        \"te_district\": te,\n    })\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    a = ap.parse_args()\n    feats = build(a.data)\n    d = os.path.dirname(os.path.abspath(a.out))\n    if d:\n        os.makedirs(d, exist_ok=True)\n    feats.to_parquet(a.out, index=False)\n    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {a.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\necho \"written\"; wc -l /app/churn/build_features.py\n"]
[776.414946, "o", "\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\r\n\u001b[?2004l\r"]
[776.414986, "o", "\u001b[?2004h"]
[776.415018, "o", "> \r\n\u001b[?2004l\r"]
[776.415049, "o", "\u001b[?2004h> "]
[776.415626, "o", "For every row of scoring_points.csv, compute the value the live scoring service\r\n\u001b[?2004l\r"]
[776.41566, "o", "\u001b[?2004h"]
[776.41569, "o", "> "]
[776.416162, "o", "(live/features.py) would have produced at that row's as_of, against the warehouse\r\n\u001b[?2004l\r"]
[776.416194, "o", "\u001b[?2004h"]
[776.416229, "o", "> "]
[776.416788, "o", "as it stood at that moment: only rows and values committed before as_of count\r\n\u001b[?2004l\r"]
[776.416821, "o", "\u001b[?2004h"]
[776.416852, "o", "> "]
[776.41744, "o", "(a row committed at or after as_of is not seen, an overwrite at or after as_of is\r\n\u001b[?2004l\r"]
[776.41748, "o", "\u001b[?2004h> "]
[776.417715, "o", "seen as it was before the overwrite).\r\n\u001b[?2004l\r"]
[776.417744, "o", "\u001b[?2004h"]
[776.417783, "o", "> \r\n\u001b[?2004l\r"]
[776.417822, "o", "\u001b[?2004h> "]
[776.418308, "o", "Every feature of live/features.py whose live value the extract determines for every\r\n\u001b[?2004l\r"]
[776.418338, "o", "\u001b[?2004h"]
[776.418369, "o", "> "]
[776.418835, "o", "row is kept.  days_since_last_login is left out: the customer's last login has no\r\n\u001b[?2004l\r"]
[776.418874, "o", "\u001b[?2004h"]
[776.418902, "o", "> "]
[776.419349, "o", "history in the warehouse, so its value at an earlier as_of cannot be recovered.\r\n\u001b[?2004l\r"]
[776.419378, "o", "\u001b[?2004h"]
[776.419415, "o", "> \"\"\"\r\n\u001b[?2004l\r"]
[776.419445, "o", "\u001b[?2004h"]
[776.419476, "o", "> "]
[776.419555, "o", "import argparse\r\n\u001b[?2004l\r"]
[776.41959, "o", "\u001b[?2004h"]
[776.41962, "o", "> "]
[776.419666, "o", "import os\r\n\u001b[?2004l\r"]
[776.419696, "o", "\u001b[?2004h"]
[776.419726, "o", "> \r\n\u001b[?2004l\r"]
[776.419756, "o", "\u001b[?2004h> "]
[776.419882, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[776.419909, "o", "\u001b[?2004h"]
[776.419939, "o", "> "]
[776.420044, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[776.420076, "o", "\u001b[?2004h"]
[776.420106, "o", "> \r\n\u001b[?2004l\r"]
[776.420135, "o", "\u001b[?2004h> "]
[776.420369, "o", "from churn.extract import load_extract\r\n\u001b[?2004l\r"]
[776.420396, "o", "\u001b[?2004h"]
[776.420426, "o", "> "]
[776.420654, "o", "from churn.impute import fill_app_minutes\r\n\u001b[?2004l\r"]
[776.420687, "o", "\u001b[?2004h"]
[776.420716, "o", "> \r\n\u001b[?2004l\r"]
[776.420746, "o", "\u001b[?2004h> "]
[776.421016, "o", "EPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n\u001b[?2004l\r"]
[776.421049, "o", "\u001b[?2004h"]
[776.421081, "o", "> "]
[776.421556, "o", "STRIDE = 10 ** 10  # customer_id * STRIDE + epoch seconds (seconds < 1e10 until 2286)\r\n\u001b[?2004l\r"]
[776.421586, "o", "\u001b[?2004h> "]
[776.421672, "o", "DAY = 86400\r\n\u001b[?2004l\r"]
[776.421703, "o", "\u001b[?2004h"]
[776.421732, "o", "> \r\n\u001b[?2004l\r"]
[776.421763, "o", "\u001b[?2004h> "]
[776.421801, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[776.421831, "o", "> "]
[776.421908, "o", "def _sec(ts):\r\n\u001b[?2004l\r"]
[776.421936, "o", "\u001b[?2004h"]
[776.421965, "o", "> "]
[776.422392, "o", "    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[776.422423, "o", "\u001b[?2004h"]
[776.422454, "o", "> \r\n\u001b[?2004l\r"]
[776.422485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[776.422514, "o", "\u001b[?2004h"]
[776.422544, "o", "> "]
[776.422639, "o", "def _bounds(cids):\r\n\u001b[?2004l\r"]
[776.422666, "o", "\u001b[?2004h"]
[776.422693, "o", "> "]
[776.423177, "o", "    \"\"\"Return (order, group_ids, starts, ends) splitting an array by customer_id.\"\"\"\r\n\u001b[?2004l\r"]
[776.423205, "o", "\u001b[?2004h"]
[776.423235, "o", "> "]
[776.423476, "o", "    order = np.argsort(cids, kind=\"stable\")\r\n\u001b[?2004l\r"]
[776.423503, "o", "\u001b[?2004h"]
[776.423533, "o", "> "]
[776.423642, "o", "    sc = cids[order]\r\n\u001b[?2004l\r"]
[776.42367, "o", "\u001b[?2004h"]
[776.423701, "o", "> "]
[776.424028, "o", "    change = np.concatenate(([True], sc[1:] != sc[:-1]))\r\n\u001b[?2004l\r"]
[776.424054, "o", "\u001b[?2004h"]
[776.424084, "o", "> "]
[776.424801, "o", "    starts = np.flatnonzero(change)\r\n\u001b[?2004l\r\u001b[?2004h>     ends = np.concatenate((starts[1:], [sc.shape[0]]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[776.425066, "o", "    return order, sc[starts], starts, ends\r\n"]
[776.425086, "o", "\u001b[?2004l\r"]
[776.425108, "o", "\u001b[?2004h"]
[776.425126, "o", "> "]
[776.425145, "o", "\r\n\u001b[?2004l\r"]
[776.425211, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[776.425246, "o", "\u001b[?2004h"]
[776.425278, "o", "> "]
[776.425507, "o", "def _te_district(points, labels, customers):\r\n\u001b[?2004l\r"]
[776.425545, "o", "\u001b[?2004h> "]
[776.426073, "o", "    \"\"\"Live te_district: (s + 20 p) / (n + 20) over all labels committed before t,\r\n\u001b[?2004l\r"]
[776.426107, "o", "\u001b[?2004h"]
[776.426129, "o", "> "]
[776.426636, "o", "    where p is the global mean churned_30d (0.05 when none) and n, s are the count\r\n\u001b[?2004l\r"]
[776.426663, "o", "\u001b[?2004h"]
[776.426691, "o", "> "]
[776.427252, "o", "    and sum over the customer's postcode district.  A label is committed at its\r\n\u001b[?2004l\r"]
[776.427292, "o", "\u001b[?2004h"]
[776.427318, "o", "> "]
[776.427741, "o", "    _loaded_at, so it is seen at t iff _loaded_at < t.\"\"\"\r\n\u001b[?2004l\r"]
[776.427784, "o", "\u001b[?2004h"]
[776.427809, "o", "> "]
[776.428297, "o", "    dist = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[776.428336, "o", "\u001b[?2004h"]
[776.428361, "o", "> "]
[776.428496, "o", "    lab = labels.copy()\r\n\u001b[?2004l\r"]
[776.428527, "o", "\u001b[?2004h"]
[776.42855, "o", "> "]
[776.428814, "o", "    lab[\"_d\"] = lab[\"customer_id\"].map(dist)\r\n\u001b[?2004l\r"]
[776.428845, "o", "\u001b[?2004h"]
[776.428869, "o", "> "]
[776.429058, "o", "    lab = lab[lab[\"_d\"].notna()]\r\n\u001b[?2004l\r"]
[776.429104, "o", "\u001b[?2004h"]
[776.429127, "o", "> "]
[776.429311, "o", "    lab_d = lab[\"_d\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.429366, "o", "\u001b[?2004h"]
[776.429391, "o", "> "]
[776.429705, "o", "    pt_d = points[\"customer_id\"].map(dist).to_numpy()\r\n\u001b[?2004l\r"]
[776.429735, "o", "\u001b[?2004h"]
[776.429755, "o", "> "]
[776.430105, "o", "    codes, _ = pd.factorize(np.concatenate([lab_d, pt_d]))\r\n\u001b[?2004l\r"]
[776.430136, "o", "\u001b[?2004h"]
[776.430165, "o", "> "]
[776.430451, "o", "    lab_code = codes[: len(lab_d)].astype(\"int64\")\r\n\u001b[?2004l\r"]
[776.430481, "o", "\u001b[?2004h"]
[776.430492, "o", "> "]
[776.430793, "o", "    pt_code = codes[len(lab_d):].astype(\"int64\")\r\n\u001b[?2004l\r"]
[776.430827, "o", "\u001b[?2004h"]
[776.430849, "o", "> "]
[776.431141, "o", "    y = lab[\"churned_30d\"].to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[776.431173, "o", "\u001b[?2004h"]
[776.431182, "o", "> "]
[776.431401, "o", "    commit = _sec(lab[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[776.431439, "o", "\u001b[?2004h> "]
[776.431622, "o", "    t = _sec(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[776.431654, "o", "\u001b[?2004h"]
[776.431663, "o", "> \r\n\u001b[?2004l\r"]
[776.431695, "o", "\u001b[?2004h"]
[776.431727, "o", "> "]
[776.432155, "o", "    # global prior p: mean churned_30d over all labels with _loaded_at < t\r\n\u001b[?2004l\r"]
[776.432189, "o", "\u001b[?2004h"]
[776.432197, "o", "> "]
[776.432464, "o", "    order = np.argsort(commit, kind=\"stable\")\r\n\u001b[?2004l\r"]
[776.432494, "o", "\u001b[?2004h"]
[776.432523, "o", "> "]
[776.43283, "o", "    ycum = np.concatenate([[0], np.cumsum(y[order])])\r\n\u001b[?2004l\r"]
[776.432858, "o", "\u001b[?2004h"]
[776.432885, "o", "> "]
[776.433199, "o", "    N = np.searchsorted(commit[order], t, side=\"left\")\r\n\u001b[?2004l\r"]
[776.433231, "o", "\u001b[?2004h"]
[776.433259, "o", "> "]
[776.433346, "o", "    S = ycum[N]\r\n\u001b[?2004l\r"]
[776.433375, "o", "\u001b[?2004h"]
[776.433406, "o", "> "]
[776.433606, "o", "    prior = np.full(len(t), 0.05)\r\n\u001b[?2004l\r"]
[776.433702, "o", "\u001b[?2004h> "]
[776.433787, "o", "    has = N > 0\r\n\u001b[?2004l\r"]
[776.433821, "o", "\u001b[?2004h"]
[776.433856, "o", "> "]
[776.434022, "o", "    prior[has] = S[has] / N[has]\r\n\u001b[?2004l\r"]
[776.434068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[776.434105, "o", "\u001b[?2004h> "]
[776.434455, "o", "    # district count/sum over labels with _loaded_at < t\r\n\u001b[?2004l\r"]
[776.434488, "o", "\u001b[?2004h"]
[776.434523, "o", "> "]
[776.434712, "o", "    key = lab_code * STRIDE + commit\r\n\u001b[?2004l\r"]
[776.434745, "o", "\u001b[?2004h"]
[776.434797, "o", "> "]
[776.435008, "o", "    o2 = np.argsort(key, kind=\"stable\")\r\n\u001b[?2004l\r"]
[776.435041, "o", "\u001b[?2004h> "]
[776.435351, "o", "    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])\r\n\u001b[?2004l\r"]
[776.435382, "o", "\u001b[?2004h"]
[776.435416, "o", "> "]
[776.435778, "o", "    lo = np.searchsorted(key[o2], pt_code * STRIDE, side=\"left\")\r\n\u001b[?2004l\r"]
[776.435823, "o", "\u001b[?2004h> "]
[776.436246, "o", "    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side=\"left\")\r\n\u001b[?2004l\r"]
[776.436281, "o", "\u001b[?2004h> "]
[776.436383, "o", "    n = hi - lo\r\n\u001b[?2004l\r"]
[776.436416, "o", "\u001b[?2004h> "]
[776.436602, "o", "    s = ycum2[hi] - ycum2[lo]\r\n\u001b[?2004l\r"]
[776.436635, "o", "\u001b[?2004h> "]
[776.436903, "o", "    return (s + 20.0 * prior) / (n + 20.0)\r\n\u001b[?2004l\r"]
[776.436933, "o", "\u001b[?2004h"]
[776.43697, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[776.437003, "o", "> \r\n\u001b[?2004l\r"]
[776.437039, "o", "\u001b[?2004h"]
[776.437074, "o", "> "]
[776.437162, "o", "def build(data_dir):\r\n\u001b[?2004l\r"]
[776.437192, "o", "\u001b[?2004h"]
[776.437226, "o", "> "]
[776.437395, "o", "    tb = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[776.437424, "o", "\u001b[?2004h> "]
[776.437778, "o", "    points = tb[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[776.437813, "o", "\u001b[?2004h"]
[776.437845, "o", "> "]
[776.437932, "o", "    n = len(points)\r\n\u001b[?2004l\r"]
[776.437961, "o", "\u001b[?2004h"]
[776.437993, "o", "> "]
[776.438295, "o", "    cid = points[\"customer_id\"].to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[776.438325, "o", "\u001b[?2004h"]
[776.438357, "o", "> "]
[776.438513, "o", "    t = _sec(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[776.438542, "o", "\u001b[?2004h"]
[776.438572, "o", "> \r\n\u001b[?2004l\r"]
[776.438598, "o", "\u001b[?2004h"]
[776.438628, "o", "> "]
[776.43908, "o", "    # ---- orders ---------------------------------------------------------------\r\n\u001b[?2004l\r"]
[776.439112, "o", "\u001b[?2004h"]
[776.439144, "o", "> "]
[776.439276, "o", "    orders = tb[\"orders\"]\r\n\u001b[?2004l\r"]
[776.439305, "o", "\u001b[?2004h"]
[776.439336, "o", "> "]
[776.439541, "o", "    o_at = _sec(orders[\"ordered_at\"])\r\n\u001b[?2004l\r"]
[776.43957, "o", "\u001b[?2004h"]
[776.439599, "o", "> "]
[776.439837, "o", "    o_loaded = _sec(orders[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[776.439884, "o", "\u001b[?2004h> "]
[776.440222, "o", "    o_amt = orders[\"amount_cents\"].to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[776.440265, "o", "\u001b[?2004h> "]
[776.440509, "o", "    oc = orders[\"customer_id\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.440538, "o", "\u001b[?2004h"]
[776.440577, "o", "> "]
[776.440772, "o", "    oord, ocv, os, oe = _bounds(oc)\r\n\u001b[?2004l\r"]
[776.440826, "o", "\u001b[?2004h"]
[776.440864, "o", "> "]
[776.440903, "o", "    o_grp = {}\r\n\u001b[?2004l\r"]
[776.440933, "o", "\u001b[?2004h"]
[776.440962, "o", "> "]
[776.441142, "o", "    for k in range(os.shape[0]):\r\n\u001b[?2004l\r"]
[776.441176, "o", "\u001b[?2004h"]
[776.441206, "o", "> "]
[776.441381, "o", "        idx = oord[os[k]:oe[k]]\r\n\u001b[?2004l\r"]
[776.441417, "o", "\u001b[?2004h> "]
[776.441821, "o", "        o_grp[int(ocv[k])] = (o_at[idx], o_loaded[idx], o_amt[idx])\r\n\u001b[?2004l\r"]
[776.441856, "o", "\u001b[?2004h"]
[776.441893, "o", "> \r\n\u001b[?2004l\r"]
[776.441927, "o", "\u001b[?2004h"]
[776.441965, "o", "> "]
[776.442634, "o", "    # ---- tickets --------------------------------------------------------------\r\n\u001b[?2004l\r"]
[776.442682, "o", "\u001b[?2004h"]
[776.442714, "o", "> "]
[776.442925, "o", "    tickets = tb[\"tickets\"]\r\n\u001b[?2004l\r"]
[776.442972, "o", "\u001b[?2004h"]
[776.443004, "o", "> "]
[776.443343, "o", "    k_at = _sec(tickets[\"opened_at\"])\r\n\u001b[?2004l\r"]
[776.443385, "o", "\u001b[?2004h"]
[776.443417, "o", "> "]
[776.443815, "o", "    k_loaded = _sec(tickets[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[776.443861, "o", "\u001b[?2004h"]
[776.443896, "o", "> "]
[776.444278, "o", "    kc = tickets[\"customer_id\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.444313, "o", "\u001b[?2004h"]
[776.444345, "o", "> "]
[776.444592, "o", "    kord, kcv, ks, ke = _bounds(kc)\r\n\u001b[?2004l\r"]
[776.444637, "o", "\u001b[?2004h"]
[776.444673, "o", "> "]
[776.444807, "o", "    k_grp = {}\r\n\u001b[?2004l\r"]
[776.444847, "o", "\u001b[?2004h"]
[776.444884, "o", "> "]
[776.445101, "o", "    for k in range(ks.shape[0]):\r\n\u001b[?2004l\r"]
[776.445148, "o", "\u001b[?2004h"]
[776.445181, "o", "> "]
[776.445463, "o", "        idx = kord[ks[k]:ke[k]]\r\n\u001b[?2004l\r"]
[776.445504, "o", "\u001b[?2004h"]
[776.445538, "o", "> "]
[776.445936, "o", "        k_grp[int(kcv[k])] = (k_at[idx], k_loaded[idx])\r\n\u001b[?2004l\r"]
[776.445979, "o", "\u001b[?2004h"]
[776.44601, "o", "> \r\n\u001b[?2004l\r"]
[776.446043, "o", "\u001b[?2004h> "]
[776.446642, "o", "    # ---- status snapshots -----------------------------------------------------\r\n\u001b[?2004l\r"]
[776.446692, "o", "\u001b[?2004h"]
[776.446722, "o", "> "]
[776.447017, "o", "    snaps = tb[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[776.447059, "o", "\u001b[?2004h"]
[776.447092, "o", "> "]
[776.447469, "o", "    s_date = _sec(snaps[\"snapshot_date\"])\r\n\u001b[?2004l\r"]
[776.44751, "o", "\u001b[?2004h"]
[776.447542, "o", "> "]
[776.447842, "o", "    s_loaded = _sec(snaps[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[776.447885, "o", "\u001b[?2004h"]
[776.447919, "o", "> "]
[776.448212, "o", "    s_status = snaps[\"status\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.448253, "o", "\u001b[?2004h"]
[776.448284, "o", "> "]
[776.448566, "o", "    sc = snaps[\"customer_id\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.448604, "o", "\u001b[?2004h"]
[776.448636, "o", "> "]
[776.448901, "o", "    sword, scv, ss, se = _bounds(sc)\r\n\u001b[?2004l\r"]
[776.448951, "o", "\u001b[?2004h> "]
[776.449071, "o", "    s_grp = {}\r\n"]
[776.449099, "o", "\u001b[?2004l\r"]
[776.449132, "o", "\u001b[?2004h> "]
[776.449376, "o", "    for k in range(ss.shape[0]):\r\n\u001b[?2004l\r"]
[776.449424, "o", "\u001b[?2004h"]
[776.449461, "o", "> "]
[776.449746, "o", "        idx = sword[ss[k]:se[k]]\r\n\u001b[?2004l\r"]
[776.449796, "o", "\u001b[?2004h"]
[776.449835, "o", "> "]
[776.450345, "o", "        s_grp[int(scv[k])] = (s_date[idx], s_loaded[idx], s_status[idx])\r\n\u001b[?2004l\r"]
[776.450387, "o", "\u001b[?2004h> "]
[776.450426, "o", "\r\n\u001b[?2004l\r"]
[776.450464, "o", "\u001b[?2004h> "]
[776.451065, "o", "    # ---- plan changes ---------------------------------------------------------\r\n\u001b[?2004l\r"]
[776.451103, "o", "\u001b[?2004h"]
[776.451144, "o", "> "]
[776.451296, "o", "    pc = tb[\"plan_changes\"]\r\n\u001b[?2004l\r"]
[776.451339, "o", "\u001b[?2004h"]
[776.451377, "o", "> "]
[776.451599, "o", "    pc_changed = _sec(pc[\"changed_at\"])\r\n\u001b[?2004l\r"]
[776.451639, "o", "\u001b[?2004h"]
[776.45168, "o", "> "]
[776.45191, "o", "    pc_loaded = _sec(pc[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[776.451955, "o", "\u001b[?2004h"]
[776.451997, "o", "> "]
[776.452219, "o", "    pc_old = pc[\"old_plan\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.452254, "o", "\u001b[?2004h"]
[776.452294, "o", "> "]
[776.452504, "o", "    pc_new = pc[\"new_plan\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.452544, "o", "\u001b[?2004h"]
[776.452587, "o", "> "]
[776.452812, "o", "    pcid = pc[\"customer_id\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.452855, "o", "\u001b[?2004h> "]
[776.453099, "o", "    pord, pcv, ps, pe = _bounds(pcid)\r\n\u001b[?2004l\r"]
[776.453134, "o", "\u001b[?2004h> "]
[776.453237, "o", "    p_grp = {}\r\n\u001b[?2004l\r"]
[776.453275, "o", "\u001b[?2004h"]
[776.453315, "o", "> "]
[776.45339, "o", "    p_base = {}\r\n\u001b[?2004l\r"]
[776.453428, "o", "\u001b[?2004h"]
[776.453467, "o", "> "]
[776.453644, "o", "    for k in range(ps.shape[0]):\r\n\u001b[?2004l\r"]
[776.453682, "o", "\u001b[?2004h"]
[776.453721, "o", "> "]
[776.453917, "o", "        idx = pord[ps[k]:pe[k]]\r\n\u001b[?2004l\r"]
[776.453949, "o", "\u001b[?2004h"]
[776.45399, "o", "> "]
[776.454146, "o", "        ch = pc_changed[idx]\r\n\u001b[?2004l\r"]
[776.454179, "o", "\u001b[?2004h"]
[776.45422, "o", "> "]
[776.454364, "o", "        c_id = int(pcv[k])\r\n\u001b[?2004l\r"]
[776.454402, "o", "\u001b[?2004h"]
[776.45444, "o", "> "]
[776.454755, "o", "        p_grp[c_id] = (ch, pc_loaded[idx], pc_new[idx])\r\n\u001b[?2004l\r"]
[776.454799, "o", "\u001b[?2004h"]
[776.454858, "o", "> "]
[776.45522, "o", "        p_base[c_id] = pc_old[idx][ch.argmin()]  # signup plan\r\n\u001b[?2004l\r"]
[776.455261, "o", "\u001b[?2004h> "]
[776.455301, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[776.455338, "o", "> "]
[776.455843, "o", "    # ---- customers ------------------------------------------------------------\r\n\u001b[?2004l\r"]
[776.455889, "o", "\u001b[?2004h> "]
[776.456397, "o", "    ccid = customers_cid = tb[\"customers\"][\"customer_id\"].astype(int).to_numpy()\r\n\u001b[?2004l\r"]
[776.456431, "o", "\u001b[?2004h> "]
[776.456842, "o", "    signup = dict(zip(ccid, _sec(tb[\"customers\"][\"signup_at\"])))\r\n\u001b[?2004l\r"]
[776.456876, "o", "\u001b[?2004h"]
[776.456933, "o", "> "]
[776.457293, "o", "    planmap = dict(zip(ccid, tb[\"customers\"][\"plan\"].to_numpy()))\r\n\u001b[?2004l\r"]
[776.457331, "o", "\u001b[?2004h"]
[776.457375, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[776.45742, "o", "> "]
[776.457919, "o", "    # ---- per-customer computation ---------------------------------------------\r\n\u001b[?2004l\r"]
[776.457973, "o", "\u001b[?2004h> "]
[776.45822, "o", "    orders_7d = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[776.458245, "o", "\u001b[?2004h"]
[776.458268, "o", "> "]
[776.458528, "o", "    orders_30d = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[776.458569, "o", "\u001b[?2004h"]
[776.458605, "o", "> "]
[776.458861, "o", "    spend_30d = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[776.458889, "o", "\u001b[?2004h"]
[776.458912, "o", "> "]
[776.459179, "o", "    tickets_30d = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[776.459213, "o", "\u001b[?2004h"]
[776.459236, "o", "> "]
[776.45952, "o", "    dso = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[776.459549, "o", "\u001b[?2004h"]
[776.459579, "o", "> "]
[776.459874, "o", "    tenure = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[776.459903, "o", "\u001b[?2004h"]
[776.459929, "o", "> "]
[776.460192, "o", "    status = np.full(n, None, dtype=object)\r\n\u001b[?2004l\r"]
[776.460228, "o", "\u001b[?2004h"]
[776.460255, "o", "> "]
[776.460503, "o", "    plan = np.full(n, None, dtype=object)\r\n\u001b[?2004l\r"]
[776.460543, "o", "\u001b[?2004h"]
[776.460569, "o", "> "]
[776.460595, "o", "\r\n\u001b[?2004l\r"]
[776.46062, "o", "\u001b[?2004h"]
[776.460645, "o", "> "]
[776.460905, "o", "    pcids = points[\"customer_id\"].to_numpy()\r\n\u001b[?2004l\r"]
[776.460939, "o", "\u001b[?2004h"]
[776.460965, "o", "> "]
[776.461212, "o", "    po, pcv2, pps, ppe = _bounds(pcids)\r\n\u001b[?2004l\r"]
[776.461259, "o", "\u001b[?2004h> "]
[776.461472, "o", "    for k in range(pps.shape[0]):\r\n\u001b[?2004l\r"]
[776.461522, "o", "\u001b[?2004h> "]
[776.461729, "o", "        idx = po[pps[k]:ppe[k]]\r\n\u001b[?2004l\r"]
[776.461774, "o", "\u001b[?2004h"]
[776.461809, "o", "> "]
[776.461918, "o", "        tt = t[idx]\r\n\u001b[?2004l\r"]
[776.461969, "o", "\u001b[?2004h> "]
[776.462126, "o", "        c = int(pcv2[k])\r\n\u001b[?2004l\r"]
[776.462178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[776.462225, "o", "\u001b[?2004h> "]
[776.462336, "o", "        if c in o_grp:\r\n\u001b[?2004l\r"]
[776.462376, "o", "\u001b[?2004h"]
[776.462409, "o", "> "]
[776.462573, "o", "            oat, oload, oamt = o_grp[c]\r\n\u001b[?2004l\r"]
[776.462613, "o", "\u001b[?2004h"]
[776.462648, "o", "> "]
[776.462853, "o", "            vis = oload[None, :] < tt[:, None]\r\n\u001b[?2004l\r"]
[776.462891, "o", "\u001b[?2004h"]
[776.462929, "o", "> "]
[776.463201, "o", "            m7 = vis & (oat[None, :] >= tt[:, None] - 7 * DAY)\r\n\u001b[?2004l\r"]
[776.463247, "o", "\u001b[?2004h"]
[776.463282, "o", "> "]
[776.463561, "o", "            m30 = vis & (oat[None, :] >= tt[:, None] - 30 * DAY)\r\n\u001b[?2004l\r"]
[776.463602, "o", "\u001b[?2004h"]
[776.463647, "o", "> "]
[776.463805, "o", "            orders_7d[idx] = m7.sum(1)\r\n\u001b[?2004l\r"]
[776.463851, "o", "\u001b[?2004h"]
[776.463898, "o", "> "]
[776.46405, "o", "            orders_30d[idx] = m30.sum(1)\r\n\u001b[?2004l\r"]
[776.464087, "o", "\u001b[?2004h"]
[776.464133, "o", "> "]
[776.464424, "o", "            spend_30d[idx] = np.where(m30, oamt[None, :], 0).sum(1)\r\n\u001b[?2004l\r"]
[776.464474, "o", "\u001b[?2004h"]
[776.464576, "o", "> "]
[776.464854, "o", "            last = np.where(vis, oat[None, :].astype(\"float64\"), -1.0).max(1)\r\n\u001b[?2004l\r"]
[776.464898, "o", "\u001b[?2004h"]
[776.464947, "o", "> "]
[776.465229, "o", "            dso[idx] = np.where(last < 0, np.nan, (tt - last) / DAY)\r\n\u001b[?2004l\r"]
[776.465333, "o", "\u001b[?2004h"]
[776.465373, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[776.465433, "o", "        if c in k_grp:\r\n\u001b[?2004l\r"]
[776.465479, "o", "\u001b[?2004h> "]
[776.465636, "o", "            kat, kload = k_grp[c]\r\n\u001b[?2004l\r"]
[776.465676, "o", "\u001b[?2004h> "]
[776.465923, "o", "            kvis = kload[None, :] < tt[:, None]\r\n\u001b[?2004l\r"]
[776.465959, "o", "\u001b[?2004h> "]
[776.466389, "o", "            tickets_30d[idx] = (kvis & (kat[None, :] >= tt[:, None] - 30 * DAY)).sum(1)\r\n\u001b[?2004l\r"]
[776.466424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[776.466468, "o", "\u001b[?2004h> "]
[776.466693, "o", "        tenure[idx] = (tt - signup[c]) / DAY\r\n\u001b[?2004l\r"]
[776.466727, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[776.466778, "o", "\u001b[?2004h> "]
[776.466898, "o", "        if c in s_grp:\r\n\u001b[?2004l\r"]
[776.466926, "o", "\u001b[?2004h"]
[776.466951, "o", "> "]
[776.467148, "o", "            sdate, sload, sstat = s_grp[c]\r\n\u001b[?2004l\r"]
[776.467229, "o", "\u001b[?2004h> "]
[776.467411, "o", "            sv = sload[None, :] < tt[:, None]\r\n\u001b[?2004l\r"]
[776.467476, "o", "\u001b[?2004h> "]
[776.467697, "o", "            sd = np.where(sv, sdate[None, :], -1)\r\n\u001b[?2004l\r"]
[776.467735, "o", "\u001b[?2004h"]
[776.467835, "o", "> "]
[776.467907, "o", "            best = sd.argmax(1)\r\n\u001b[?2004l\r"]
[776.467967, "o", "\u001b[?2004h"]
[776.468014, "o", "> "]
[776.468084, "o", "            has = sv.any(1)\r\n\u001b[?2004l\r"]
[776.468123, "o", "\u001b[?2004h"]
[776.468172, "o", "> "]
[776.468255, "o", "            if has.any():\r\n\u001b[?2004l\r"]
[776.468299, "o", "\u001b[?2004h"]
[776.468347, "o", "> "]
[776.468545, "o", "                status[idx[has]] = sstat[best[has]]\r\n\u001b[?2004l\r"]
[776.468593, "o", "\u001b[?2004h"]
[776.468642, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[776.468688, "o", "> "]
[776.468837, "o", "        base = p_base.get(c, planmap[c])\r\n\u001b[?2004l\r"]
[776.468885, "o", "\u001b[?2004h"]
[776.46893, "o", "> "]
[776.469162, "o", "        pvals = np.full(idx.shape[0], base, dtype=object)\r\n\u001b[?2004l\r"]
[776.4692, "o", "\u001b[?2004h"]
[776.469242, "o", "> "]
[776.469322, "o", "        if c in p_grp:\r\n\u001b[?2004l\r"]
[776.469368, "o", "\u001b[?2004h> "]
[776.469552, "o", "            pch, pload, pnew = p_grp[c]\r\n\u001b[?2004l\r"]
[776.469592, "o", "\u001b[?2004h"]
[776.469634, "o", "> "]
[776.469824, "o", "            pv = pload[None, :] < tt[:, None]\r\n\u001b[?2004l\r"]
[776.469862, "o", "\u001b[?2004h"]
[776.469912, "o", "> "]
[776.470007, "o", "            phas = pv.any(1)\r\n\u001b[?2004l\r"]
[776.470045, "o", "\u001b[?2004h"]
[776.470088, "o", "> "]
[776.470186, "o", "            if phas.any():\r\n\u001b[?2004l\r"]
[776.470218, "o", "\u001b[?2004h"]
[776.470258, "o", "> "]
[776.470485, "o", "                pd_ = np.where(pv, pch[None, :], -1)\r\n\u001b[?2004l\r"]
[776.470518, "o", "\u001b[?2004h> "]
[776.470809, "o", "                pvals[phas] = pnew[pd_.argmax(1)[phas]]\r\n\u001b[?2004l\r"]
[776.470861, "o", "\u001b[?2004h> "]
[776.470987, "o", "        plan[idx] = pvals\r\n\u001b[?2004l\r"]
[776.471024, "o", "\u001b[?2004h"]
[776.471066, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[776.471107, "o", "> "]
[776.471323, "o", "    app = fill_app_minutes(points).to_numpy()\r\n\u001b[?2004l\r"]
[776.471363, "o", "\u001b[?2004h"]
[776.471408, "o", "> "]
[776.471743, "o", "    te = _te_district(points, tb[\"labels\"], tb[\"customers\"])\r\n\u001b[?2004l\r"]
[776.471834, "o", "\u001b[?2004h"]
[776.471875, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[776.472018, "o", "    return pd.DataFrame({\r\n\u001b[?2004l\r"]
[776.472058, "o", "\u001b[?2004h> "]
[776.472234, "o", "        \"customer_id\": cid,\r\n\u001b[?2004l\r"]
[776.472291, "o", "\u001b[?2004h> "]
[776.472508, "o", "        \"as_of\": points[\"as_of\"],\r\n\u001b[?2004l\r"]
[776.472552, "o", "\u001b[?2004h> "]
[776.472746, "o", "        \"orders_7d\": orders_7d,\r\n\u001b[?2004l\r"]
[776.472831, "o", "\u001b[?2004h> "]
[776.473013, "o", "        \"orders_30d\": orders_30d,\r\n\u001b[?2004l\r"]
[776.473062, "o", "\u001b[?2004h> "]
[776.473272, "o", "        \"spend_30d_cents\": spend_30d,\r\n\u001b[?2004l\r"]
[776.473304, "o", "\u001b[?2004h"]
[776.473324, "o", "> "]
[776.473533, "o", "        \"tickets_30d\": tickets_30d,\r\n\u001b[?2004l\r"]
[776.473566, "o", "\u001b[?2004h"]
[776.473592, "o", "> "]
[776.473848, "o", "        \"days_since_last_order\": dso,\r\n\u001b[?2004l\r"]
[776.47388, "o", "\u001b[?2004h"]
[776.473888, "o", "> "]
[776.474079, "o", "        \"tenure_days\": tenure,\r\n\u001b[?2004l\r"]
[776.474112, "o", "\u001b[?2004h"]
[776.474135, "o", "> "]
[776.474285, "o", "        \"status\": status,\r\n\u001b[?2004l\r"]
[776.474319, "o", "\u001b[?2004h"]
[776.474359, "o", "> "]
[776.474469, "o", "        \"plan\": plan,\r\n\u001b[?2004l\r"]
[776.474509, "o", "\u001b[?2004h"]
[776.474519, "o", "> "]
[776.474707, "o", "        \"app_minutes_7d\": app,\r\n\u001b[?2004l\r"]
[776.47474, "o", "\u001b[?2004h"]
[776.474779, "o", "> "]
[776.474926, "o", "        \"te_district\": te,\r\n\u001b[?2004l\r"]
[776.474964, "o", "\u001b[?2004h"]
[776.475001, "o", "> "]
[776.475029, "o", "    })\r\n\u001b[?2004l\r"]
[776.475063, "o", "\u001b[?2004h"]
[776.475073, "o", "> \r\n"]
[776.475105, "o", "\u001b[?2004l\r"]
[776.475116, "o", "\u001b[?2004h"]
[776.475128, "o", "> \r\n"]
[776.475169, "o", "\u001b[?2004l\r\u001b[?2004h"]
[776.475201, "o", "> "]
[776.475265, "o", "def main():\r\n\u001b[?2004l\r"]
[776.475297, "o", "\u001b[?2004h"]
[776.475326, "o", "> "]
[776.475633, "o", "    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[776.475667, "o", "\u001b[?2004h"]
[776.475677, "o", "> "]
[776.476175, "o", "    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[776.476214, "o", "\u001b[?2004h"]
[776.476254, "o", "> "]
[776.476647, "o", "    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[776.476681, "o", "\u001b[?2004h"]
[776.476691, "o", "> "]
[776.476852, "o", "    a = ap.parse_args()\r\n\u001b[?2004l\r"]
[776.47689, "o", "\u001b[?2004h"]
[776.4769, "o", "> "]
[776.477059, "o", "    feats = build(a.data)\r\n\u001b[?2004l\r"]
[776.477094, "o", "\u001b[?2004h"]
[776.477103, "o", "> "]
[776.477392, "o", "    d = os.path.dirname(os.path.abspath(a.out))\r\n\u001b[?2004l\r"]
