[1091.03249, "o", "\u001b[?2004h"]
[1091.032522, "o", "> "]
[1091.032845, "o", "            sdate, sload, sstat = s_date[r], s_loaded[r], s_status[r]\r\n\u001b[?2004l\r"]
[1091.032879, "o", "\u001b[?2004h"]
[1091.03291, "o", "> "]
[1091.033102, "o", "            sv = sload[None, :] < tt[:, None]\r\n\u001b[?2004l\r"]
[1091.033144, "o", "\u001b[?2004h> "]
[1091.033388, "o", "            sd = np.where(sv, sdate[None, :], -1)\r\n\u001b[?2004l\r"]
[1091.033419, "o", "\u001b[?2004h> "]
[1091.033589, "o", "            best = sd.argmax(1)\r\n\u001b[?2004l\r"]
[1091.033631, "o", "\u001b[?2004h> "]
[1091.033786, "o", "            has = sv.any(1)\r\n\u001b[?2004l\r"]
[1091.033817, "o", "\u001b[?2004h> "]
[1091.03394, "o", "            if has.any():\r\n\u001b[?2004l\r"]
[1091.033983, "o", "\u001b[?2004h> "]
[1091.034236, "o", "                status[idx[has]] = sstat[best[has]]\r\n\u001b[?2004l\r"]
[1091.034266, "o", "\u001b[?2004h> \r\n"]
[1091.034298, "o", "\u001b[?2004l\r"]
[1091.034335, "o", "\u001b[?2004h> "]
[1091.034545, "o", "        base = p_base.get(c, planmap.get(c))\r\n\u001b[?2004l\r"]
[1091.034578, "o", "\u001b[?2004h> "]
