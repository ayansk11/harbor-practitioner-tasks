[1111.710806, "i", "cd /app && python3 << 'PYEOF'\nimport pandas as pd, numpy as np, json\nfeats = pd.read_parquet(\"/tmp/features.parquet\")\nfeats[\"as_of\"] = pd.to_datetime(feats[\"as_of\"], utc=True)\nrows=[]\nfor line in open(\"logs/live_2026-01_sample.jsonl\"):\n    rows.append(json.loads(line))\ns = pd.DataFrame([dict(x[\"features\"], customer_id=x[\"customer_id\"], as_of=pd.Timestamp(x[\"as_of\"], tz=\"UTC\")) for x in rows])\nm = feats.merge(s, on=[\"customer_id\",\"as_of\"], how=\"inner\", suffixes=(\"\",\"_live\"))\nprint(\"matched\", len(m), \"of\", len(s))\nF = [\"orders_7d\",\"orders_30d\",\"spend_30d_cents\",\"tickets_30d\",\"days_since_last_order\",\"tenure_days\",\"status\",\"plan\",\"app_minutes_7d\",\"te_district\"]\nbad=0\nfor f in F:\n    a=m[f]; b=m[f+\"_live\"]\n    if f in (\"status\",\"plan\"):\n        aa=a.astype(\"object\").fillna(\"<NULL>\"); bb=b.astype(\"object\").fillna(\"<NULL>\")\n        d=(aa!=bb).sum(); print(f\"{f:22s} fail={d}\"); bad+=d\n    else:\n        aa=pd.to_numeric(a,errors=\"coerce\").astype(float); bb=pd.to_numeric(b,errors=\"coerce\").astype(float)\n        mask=~("]
[1111.710922, "i", "aa.isna()|bb.isna()); diff=(aa[mask]-bb[mask]).abs(); tol=1e-6+1e-9*bb[mask].abs()\n        d=(diff>tol).sum(); nA=(aa.isna()&~bb.isna()).sum(); nB=(bb.isna()&~aa.isna()).sum()\n        print(f\"{f:22s} fail={d} maxdiff={(diff.max() if len(diff) else 0):.2e} nanA={nA} nanB={nB}\"); bad+=d\nprint(\"TOTAL MISMATCHES:\", bad)\nPYEOF\n"]
