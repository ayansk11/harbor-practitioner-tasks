[1111.713464, "o", "F = [\"orders_7d\",\"orders_30d\",\"spend_30d_cents\",\"tickets_30d\",\"days_since_last_order\",\"tenure_days\",\"status\",\"plan\",\"app_minutes_7d\",\"te_district\"]\r\n\u001b[?2004l\r"]
