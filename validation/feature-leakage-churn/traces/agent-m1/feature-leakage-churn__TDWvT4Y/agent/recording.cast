[21.380373, "o", "cat /app/churn/extract.py\r\n\u001b[?2004l\r"]
[21.382101, "o", "\"\"\"Load a warehouse extract (the seven CSV files described in docs/WAREHOUSE.md) into pandas frames.\r\n\r\nEvery timestamp column is parsed to a UTC timestamp, the load metadata columns included, so each frame carries\r\neverything its CSV file has.\r\n\"\"\"\r\nimport os\r\nimport pandas as pd\r\n\r\nTIMESTAMPS = {\r\n    \"customers\": [\"signup_at\", \"last_login_at\", \"_updated_at\"],\r\n    \"plan_changes\": [\"changed_at\", \"_loaded_at\"],\r\n    \"scoring_points\": [\"as_of\"],\r\n    \"orders\": [\"ordered_at\", \"_loaded_at\"],\r\n    \"tickets\": [\"opened_at\", \"_loaded_at\"],\r\n    \"status_snapshots\": [\"snapshot_date\", \"_loaded_at\"],\r\n    \"labels\": [\"as_of\", \"_loaded_at\"],\r\n}\r\n\r\n\r\ndef load_extract(data_dir):\r\n    tables = {}\r\n    for name, cols in TIMESTAMPS.items():\r\n        df = pd.read_csv(os.path.join(data_dir, f\"{name}.csv\"), dtype={\"postcode_district\": \"str\"})\r\n        for c in cols:\r\n            df[c] = pd.to_datetime(df[c], utc=True)\r\n        tables[name] = df\r\n    tables[\"scoring_points\"][\"app_minutes_7d\"] = tables[\"scoring_points\"][\"app_minut"]
[21.382144, "o", "es_7d\"].astype(\"float64\")\r\n    return tables\r\n"]
[21.382438, "o", "\u001b[?2004h"]
[21.382471, "o", "root@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[21.743686, "i", "cat /app/churn/attributes.py\n"]
[21.743948, "o", "cat /app/churn/attributes.py\r\n\u001b[?2004l\r"]
[21.745752, "o", "\"\"\"Customer attributes from the customer record (new in v3): the subscription plan and the days since the last login.\r\n\r\nPoint in time: a last login at or after the prediction time is ignored (the feature is null then), so the feature\r\nnever looks ahead of t.\r\n\"\"\"\r\n\r\n\r\ndef plan(points, customers):\r\n    \"\"\"The customer's subscription plan.\"\"\"\r\n    return points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"])\r\n\r\n\r\ndef days_since_last_login(points, customers):\r\n    \"\"\"t minus the customer's last login, in days; null when the record has no login before t.\"\"\"\r\n"]
[21.745794, "o", "    last = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"last_login_at\"])\r\n    days = (points[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    return days.where(last < points[\"as_of\"])\r\n"]
[21.746119, "o", "\u001b[?2004hroot@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[22.230922, "i", "cat /app/churn/status.py\n"]
[22.231162, "o", "cat /app/churn/status.py\r\n\u001b[?2004l\r"]
[22.232857, "o", "\"\"\"Account status from the billing system's status snapshots, point in time (INC-2041).\r\n\r\nA snapshot dated D records the status at the end of day D, so a prediction at t may only use snapshots dated before\r\ndate(t).\r\n\"\"\"\r\nimport pandas as pd\r\n\r\n\r\ndef latest_status(points, snapshots):\r\n    \"\"\"Status of the customer's latest snapshot dated before the prediction's UTC date (null if none).\"\"\"\r\n    left = points[[\"customer_id\"]].assign(day=points[\"as_of\"].dt.floor(\"D\")).reset_index()\r\n    left = left.sort_values(\"day\", kind=\"mergesort\")\r\n    snaps = snapshots.sort_values(\"snapshot_date\", kind=\"mergesort\")[[\"customer_id\", \"snapshot_date\", \"status\"]]\r\n    snaps = snaps.assign(snapshot_date=snaps[\"snapshot_date\"].astype(left[\"day\"].dtype))\r\n    m = pd.merge_asof(left, snaps, left_on=\"day\", right_on=\"snapshot_date\", by=\"customer_id\",\r\n                      allow_exact_matches=False)\r\n    return m.set_index(\"index\")[\"status\"].reindex(points.index)\r\n"]
[22.233219, "o", "\u001b[?2004h"]
[22.23327, "o", "root@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[22.61322, "i", "cat /app/churn/impute.py\n"]
[22.613452, "o", "cat /app/churn/impute.py\r\n\u001b[?2004l\r"]
[22.615164, "o", "\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\r\n\r\nPoint in time (INC-2041): a missing reading takes the customer's most recent earlier reading, never a later one; with\r\nno earlier reading it stays null.\r\n\"\"\"\r\n\r\n\r\ndef fill_app_minutes(points):\r\n    \"\"\"Fill missing app_minutes_7d from the same customer's last earlier reading.\"\"\"\r\n    pts = points.sort_values([\"customer_id\", \"as_of\"], kind=\"mergesort\")\r\n    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].ffill()\r\n    return filled.reindex(points.index)\r\n"]
[22.615473, "o", "\u001b[?2004h"]
[22.615519, "o", "root@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[22.989795, "i", "cat /app/churn/encoding.py\n"]
[22.98998, "o", "cat /app/churn/encoding.py\r\n\u001b[?2004l\r"]
[22.991255, "o", "\"\"\"Target encoding of high-cardinality categoricals, point in time (INC-2041).\r\n\r\nA label row records whether the customer churned in the 30 days after its own prediction, so its outcome is final only\r\nonce that window has closed (as_of + 30 days). A prediction at t uses only labels whose window closed before t, for the\r\ndistrict counts and for the prior alike; its own label and every later one are never seen.\r\n\"\"\"\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\nPRIOR_WEIGHT = 20\r\nDEFAULT_PRIOR = 0.05\r\nLABEL_WINDOW_DAYS = 30\r\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\nSTRIDE = 10 ** 10\r\n\r\n\r\ndef _seconds(ts):\r\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\r\n\r\ndef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n    \"\"\"Smoothed churn rate of the customer's postcode district, from labels whose window closed before t.\"\"\"\r\n    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n    lab_d = labels[\"customer_id\"].map(district)\r\n    pt_d = points[\"customer_"]
[22.991311, "o", "id\"].map(district)\r\n    codes, _ = pd.factorize(pd.concat([lab_d, pt_d], ignore_index=True))\r\n    lab_code, pt_code = codes[:len(labels)].astype(\"int64\"), codes[len(labels):].astype(\"int64\")\r\n    closed = _seconds(labels[\"as_of\"]) + LABEL_WINDOW_DAYS * 86400\r\n    y = labels[\"churned_30d\"].to_numpy(dtype=\"int64\")\r\n    t = _seconds(points[\"as_of\"])\r\n\r\n    order = np.argsort(closed, kind=\"stable\")\r\n    ycum = np.concatenate([[0], np.cumsum(y[order])])\r\n    N = np.searchsorted(closed[order], t, side=\"left\")\r\n    S = ycum[N]\r\n    prior = np.full(len(t), DEFAULT_PRIOR)\r\n    has = N > 0\r\n    prior[has] = S[has] / N[has]\r\n\r\n    key = lab_code * STRIDE + closed\r\n    o2 = np.argsort(key, kind=\"stable\")\r\n    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])\r\n    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side=\"left\")\r\n    lo = np.searchsorted(key[o2], pt_code * STRIDE, side=\"left\")\r\n    n, s = hi - lo, ycum2[hi] - ycum2[lo]\r\n    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\r\n"]
[22.99146, "o", "\u001b[?2004hroot@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[23.39269, "i", "cat /app/churn/train.py\n"]
[23.392952, "o", "cat /app/churn/train.py\r\n\u001b[?2004l\r"]
[23.395257, "o", "\"\"\"Train and validate the churn model: python -m churn.train --features <file.parquet> --data <dir> [--l2 1.0]\r\n\r\nTime-based split: train on predictions before 2025-09-01, validate on 2025-09-01 .. 2025-11-30. Every column of the\r\nfeature table other than customer_id and as_of is a model input: numeric columns as they are (a null is a missing\r\nvalue), string columns one-hot encoded. A column that holds no value at all is skipped.\r\n\"\"\"\r\nimport argparse\r\nimport os\r\n\r\nimport pandas as pd\r\nfrom sklearn.ensemble import HistGradientBoostingClassifier\r\nfrom sklearn.metrics import roc_auc_score\r\n\r\nKEYS = [\"customer_id\", \"as_of\"]\r\nLABEL = \"churned_30d\"\r\nTRAIN_END = pd.Timestamp(\"2025-09-01\", tz=\"UTC\")\r\nVALID_END = pd.Timestamp(\"2025-12-01\", tz=\"UTC\")\r\n\r\n\r\ndef inputs(feats):\r\n    return [c for c in feats.columns if c not in KEYS and c != LABEL]\r\n\r\n\r\ndef categories(feats):\r\n    \"\"\"Sorted values of each string column (one indicator column per value).\"\"\"\r\n    return {c: sorted(feats[c].dropna().astype(str).unique()) for c"]
[23.395332, "o", " in inputs(feats)\r\n            if not pd.api.types.is_numeric_dtype(feats[c])}\r\n\r\n\r\ndef design_matrix(feats, cats):\r\n    X = feats[[c for c in inputs(feats) if c not in cats]].astype(\"float64\").copy()\r\n    for c, values in cats.items():\r\n        for v in values:\r\n            X[f\"{c}_{v}\"] = (feats[c] == v).astype(\"float64\")\r\n    return X\r\n\r\n\r\ndef make_model(l2=1.0, max_depth=4):\r\n    return HistGradientBoostingClassifier(max_iter=300, learning_rate=0.05, max_depth=max_depth,\r\n                                          l2_regularization=l2, early_stopping=False, random_state=0)\r\n\r\n\r\ndef train_validate(feats, labels, l2=1.0, max_depth=4):\r\n    \"\"\"Fit on labelled predictions before TRAIN_END, validate on TRAIN_END .. VALID_END.\"\"\"\r\n    df = feats.merge(labels[KEYS + [LABEL]], on=KEYS, how=\"inner\").dropna(axis=1, how=\"all\")  # no value: no input\r\n    cats = categories(df)\r\n    tr = df[df[\"as_of\"] < TRAIN_END]\r\n    va = df[(df[\"as_of\"] >= TRAIN_END) & (df[\"as_of\"] < VALID_END)]\r\n    model = make_model(l2, max_depth"]
[23.395376, "o", ").fit(design_matrix(tr, cats), tr[LABEL])\r\n    auc = roc_auc_score(va[LABEL], model.predict_proba(design_matrix(va, cats))[:, 1])\r\n    return model, cats, auc, tr, va\r\n\r\n\r\ndef main():\r\n    ap = argparse.ArgumentParser(description=__doc__)\r\n    ap.add_argument(\"--features\", required=True)\r\n    ap.add_argument(\"--data\", required=True)\r\n    ap.add_argument(\"--l2\", type=float, default=1.0, help=\"L2 regularization\")\r\n    ap.add_argument(\"--max-depth\", type=int, default=4)\r\n    a = ap.parse_args()\r\n    feats = pd.read_parquet(a.features)\r\n    feats[\"as_of\"] = pd.to_datetime(feats[\"as_of\"], utc=True)\r\n    labels = pd.read_csv(os.path.join(a.data, \"labels.csv\"))\r\n    labels[\"as_of\"] = pd.to_datetime(labels[\"as_of\"], utc=True)\r\n    model, cats, auc, tr, va = train_validate(feats, labels, a.l2, a.max_depth)\r\n    print(f\"train rows {len(tr)}, validation rows {len(va)}, validation churn rate {va['churned_30d'].mean():.3f}\")\r\n    print(f\"offline validation AUC: {auc:.3f}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
