[821.854668, "i", "cd /app && python3 << 'PYEOF'\nimport pandas as pd\nimport numpy as np\nimport json\n\nfeats = pd.read_parquet(\"/tmp/features.parquet\")\nfeats[\"as_of\"] = pd.to_datetime(feats[\"as_of\"], utc=True)\n\nsamples = []\nwith open(\"logs/live_2026-01_sample.jsonl\") as f:\n    for line in f:\n        samples.append(json.loads(line))\ns = pd.DataFrame(samples)\ns = s[\"features\"].apply(pd.Series)\ns[\"customer_id\"] = [x[\"customer_id\"] for x in samples]\ns[\"as_of\"] = pd.to_datetime([x[\"as_of\"] for x in samples], utc=True)\n\nm = feats.merge(s, on=[\"customer_id\", \"as_of\"], how=\"inner\", suffixes=(\"\", \"_live\"))\nprint(f\"matched {len(m)} / {len(s)} sample rows\")\n\nFEATURES = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\",\n            \"days_since_last_order\", \"tenure_days\", \"status\", \"plan\",\n            \"app_minutes_7d\", \"te_district\"]\n\nfor f_ in FEATURES:\n    a = m[f_]\n    b = m[f_ + \"_live\"]\n    if pd.api.types.is_numeric_dtype(a) or pd.api.types.is_numeric_dtype(b):\n        a = pd.to_numeric(a, errors=\"coerce\").astype(float)\n     "]
[821.854814, "i", "   b = pd.to_numeric(b, errors=\"coerce\").astype(float)\n        both_nan = a.isna() & b.isna()\n        only_a_nan = a.isna() & ~b.isna()\n        only_b_nan = b.isna() & ~a.isna()\n        mask = ~(a.isna() | b.isna())\n        diff = (a[mask] - b[mask]).abs()\n        tol = 1e-6 + 1e-9 * b[mask].abs()\n        nfail = (diff > tol).sum()\n        maxdiff = diff.max() if len(diff) else 0\n        print(f\"{f_:25s} fail={nfail:4d} maxdiff={maxdiff:.2e} nanA={only_a_nan.sum()} nanB={only_b_nan.sum()}\")\n    else:\n        a = a.astype(\"object\").where(lambda x: x != \"\", None)\n        b = b.astype(\"object\").where(lambda x: x != \"\", None)\n        a = a.fillna(\"<NULL>\")\n        b = b.fillna(\"<NULL>\")\n        nfail = (a != b).sum()\n        print(f\"{f_:25s} fail={nfail:4d}\")\nPYEOF\n"]
