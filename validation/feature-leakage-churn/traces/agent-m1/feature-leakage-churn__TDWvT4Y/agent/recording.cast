[36.205972, "o", "cat /app/churn/windows.py\r\n\u001b[?2004l\r"]
[36.207633, "o", "\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time-since features.\r\n\r\nPoint in time (INC-2041): a window is [t - W days, t) on the exact event timestamps, so an event stamped at or after\r\nthe prediction time is never counted and nothing later in the day leaks in.\r\n\"\"\"\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\nSTRIDE = 10 ** 10  # composite key customer_id * STRIDE + epoch seconds (seconds stay below 1e10 until 2286)\r\n\r\n\r\ndef _seconds(ts):\r\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\r\n\r\ndef _window(points, events, ts_col, days, amount_col=None):\r\n    \"\"\"Per prediction: number (and amount sum) of the customer's events with t - days <= ts < t.\"\"\"\r\n    ev_key = events[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(events[ts_col])\r\n    order = np.argsort(ev_key, kind=\"stable\")\r\n    ev_key = ev_key[order]\r\n    cid = points[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE\r\n    t = _seconds(p"]
[36.207663, "o", "oints[\"as_of\"])\r\n    hi = np.searchsorted(ev_key, cid + t, side=\"left\")\r\n    lo = np.searchsorted(ev_key, cid + t - days * 86400, side=\"left\")\r\n    count = hi - lo\r\n    if amount_col is None:\r\n        return count, None\r\n    pref = np.concatenate([[0], np.cumsum(events[amount_col].to_numpy(dtype=\"int64\")[order])])\r\n    return count, pref[hi] - pref[lo]\r\n\r\n\r\ndef activity_features(points, orders, tickets):\r\n    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n    out[\"orders_7d\"], _ = _window(points, orders, \"ordered_at\", 7)\r\n    out[\"orders_30d\"], out[\"spend_30d_cents\"] = _window(points, orders, \"ordered_at\", 30, \"amount_cents\")\r\n    out[\"tickets_30d\"], _ = _window(points, tickets, \"opened_at\", 30)\r\n\r\n    # time since the last order strictly before the prediction\r\n    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n    last = pd.merge_asof(left, o, left_on=\"as_of\", right_on=\"ordered_at\", by=\"customer_id\",\r\n         "]
[36.207682, "o", "                allow_exact_matches=False).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    return out\r\n\r\n\r\ndef tenure_days(points, customers):\r\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n"]
[36.207839, "o", "\u001b[?2004h"]
[36.207846, "o", "root@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[36.603043, "i", "cat /app/churn/attributes.py\n"]
[36.603229, "o", "cat /app/churn/attributes.py\r\n\u001b[?2004l\r"]
[36.604913, "o", "\"\"\"Customer attributes from the customer record (new in v3): the subscription plan and the days since the last login.\r\n\r\nPoint in time: a last login at or after the prediction time is ignored (the feature is null then), so the feature\r\nnever looks ahead of t.\r\n\"\"\"\r\n\r\n\r\ndef plan(points, customers):\r\n    \"\"\"The customer's subscription plan.\"\"\"\r\n    return points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"])\r\n\r\n\r\ndef days_since_last_login(points, customers):\r\n    \"\"\"t minus the customer's last login, in days; null when the record has no login before t.\"\"\"\r\n    last = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"last_login_at\"])\r\n    days = (points[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    return days.where(last < points[\"as_of\"])\r\n"]
[36.60515, "o", "\u001b[?2004hroot@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[36.996199, "i", "cat /app/churn/status.py\n"]
[36.996384, "o", "cat /app/churn/status.py\r\n\u001b[?2004l\r"]
[36.99826, "o", "\"\"\"Account status from the billing system's status snapshots, point in time (INC-2041).\r\n\r\nA snapshot dated D records the status at the end of day D, so a prediction at t may only use snapshots dated before\r\ndate(t).\r\n\"\"\"\r\nimport pandas as pd\r\n\r\n\r\ndef latest_status(points, snapshots):\r\n    \"\"\"Status of the customer's latest snapshot dated before the prediction's UTC date (null if none).\"\"\"\r\n    left = points[[\"customer_id\"]].assign(day=points[\"as_of\"].dt.floor(\"D\")).reset_index()\r\n    left = left.sort_values(\"day\", kind=\"mergesort\")\r\n"]
[36.998308, "o", "    snaps = snapshots.sort_values(\"snapshot_date\", kind=\"mergesort\")[[\"customer_id\", \"snapshot_date\", \"status\"]]\r\n    snaps = snaps.assign(snapshot_date=snaps[\"snapshot_date\"].astype(left[\"day\"].dtype))\r\n    m = pd.merge_asof(left, snaps, left_on=\"day\", right_on=\"snapshot_date\", by=\"customer_id\",\r\n                      allow_exact_matches=False)\r\n    return m.set_index(\"index\")[\"status\"].reindex(points.index)\r\n"]
[36.998569, "o", "\u001b[?2004hroot@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[37.385151, "i", "cat /app/churn/impute.py\n"]
[37.385306, "o", "cat /app/churn/impute.py\r\n\u001b[?2004l\r"]
[37.386978, "o", "\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\r\n\r\nPoint in time (INC-2041): a missing reading takes the customer's most recent earlier reading, never a later one; with\r\nno earlier reading it stays null.\r\n\"\"\"\r\n\r\n\r\ndef fill_app_minutes(points):\r\n    \"\"\"Fill missing app_minutes_7d from the same customer's last earlier reading.\"\"\"\r\n    pts = points.sort_values([\"customer_id\", \"as_of\"], kind=\"mergesort\")\r\n    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].ffill()\r\n    return filled.reindex(points.index)\r\n"]
[37.387216, "o", "\u001b[?2004hroot@1caa8ce2-e311-4da4-bf43-e623dc6ef43d:/app# "]
[37.767806, "i", "cat /app/churn/extract.py\n"]
[37.76797, "o", "cat /app/churn/extract.py\r\n\u001b[?2004l\r"]
[37.76985, "o", "\"\"\"Load a warehouse extract (the seven CSV files described in docs/WAREHOUSE.md) into pandas frames.\r\n\r\nEvery timestamp column is parsed to a UTC timestamp, the load metadata columns included, so each frame carries\r\neverything its CSV file has.\r\n\"\"\"\r\nimport os\r\nimport pandas as pd\r\n\r\nTIMESTAMPS = {\r\n    \"customers\": [\"signup_at\", \"last_login_at\", \"_updated_at\"],\r\n    \"plan_changes\": [\"changed_at\", \"_loaded_at\"],\r\n    \"scoring_points\": [\"as_of\"],\r\n    \"orders\": [\"ordered_at\", \"_loaded_at\"],\r\n    \"tickets\": [\"opened_at\", \"_loaded_at\"],\r\n    \"status_snapshots\": [\"snapshot_date\", \"_loaded_at\"],\r\n    \"labels\": [\"as_of\", \"_loaded_at\"],\r\n}\r\n"]
[37.769924, "o", "\r\n\r\ndef load_extract(data_dir):\r\n    tables = {}\r\n    for name, cols in TIMESTAMPS.items():\r\n        df = pd.read_csv(os.path.join(data_dir, f\"{name}.csv\"), dtype={\"postcode_district\": \"str\"})\r\n        for c in cols:\r\n            df[c] = pd.to_datetime(df[c], utc=True)\r\n        tables[name] = df\r\n    tables[\"scoring_points\"][\"app_minutes_7d\"] = tables[\"scoring_points\"][\"app_minutes_7d\"].astype(\"float64\")\r\n    return tables\r\n"]
