[1295.029482, "o", "  ex plan [(102129, '2026-01-02 06:00:00+00:00', 'family', 'basic'), (102764, '2026-01-05 06:00:00+00:00', 'family', 'basic'), (102098, '2026-01-06 06:00:00+00:00', 'basic', 'plus')]\r\n"]
[1295.077116, "o", "\u001b[?2004hroot@988134ce-a765-4e20-b2f3-7ad8538b1419:/app# "]
[1330.967702, "i", "cat << 'PYEOF' > /app/churn/attributes.py\n\"\"\"Customer attributes reconstructable from the extract.\n\nplan is reconstructed point-in-time: the customer record starts at the signup plan and is\noverwritten by crm_sync as plan changes are committed. The signup plan is the old_plan of the\nearliest applied change (by changed_at), or the current record's plan when the customer never\nchanged. days_since_last_login cannot be reconstructed (no history of last_login_at), so it is\nleft out of the v4 feature table.\n\"\"\"\nimport numpy as np\nimport pandas as pd\nfrom collections import defaultdict\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\n\n\ndef _seconds(ts):\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef _signup_plans(customers, plan_changes):\n    \"\"\"Per-customer plan at sign-up: old_plan of the earliest change (by changed_at), else the record's plan.\"\"\"\n    base = customers.set_index(\"customer_id\")[\"plan\"]\n    if len(plan_changes) == 0:\n        return base.to_dict()\n    pc = plan_changes"]
[1330.967841, "i", ".sort_values(\"changed_at\", kind=\"stable\")\n    first = pc.groupby(\"customer_id\").first()  # earliest changed_at -> its old_plan\n    out = base.to_dict()\n    for cid, old in first[\"old_plan\"].items():\n        out[cid] = old\n    return out\n\n\ndef plan_feature(points, customers, plan_changes):\n    \"\"\"The customer's plan on the record at each prediction time (committed before as_of).\"\"\"\n    pts_cid = points[\"customer_id\"].to_numpy()\n    pts_t = _seconds(points[\"as_of\"])\n    n = len(pts_t)\n\n    signup = _signup_plans(customers, plan_changes)\n    result = np.full(n, None, object)\n    for i in range(n):\n        result[i] = signup.get(pts_cid[i])\n\n    if len(plan_changes) == 0:\n        return pd.Series(result, index=points.index)\n\n    pc_cid = plan_changes[\"customer_id\"].to_numpy()\n    pc_changed = _seconds(plan_changes[\"changed_at\"])\n    pc_new = plan_changes[\"new_plan\"].to_numpy()\n    pc_loaded = _seconds(plan_changes[\"_loaded_at\"])\n\n    pc_groups = defaultdict(list)\n    for i in range(len(pc_cid)):\n        pc_groups"]
[1330.96789, "i", "[pc_cid[i]].append(i)\n\n    pt_groups = defaultdict(list)\n    for i in range(len(pts_cid)):\n        pt_groups[pts_cid[i]].append(i)\n\n    for cid, pt_idx in pt_groups.items():\n        if cid not in pc_groups:\n            continue\n        pci = np.array(pc_groups[cid], dtype=np.intp)\n        t = pts_t[pt_idx]\n        changed = pc_changed[pci]\n        new_plans = pc_new[pci]\n        loaded = pc_loaded[pci]\n\n        visible = loaded[None, :] < t[:, None]\n        masked = np.where(visible, changed[None, :], np.iinfo(np.int64).min)\n        max_idx = masked.argmax(axis=1)\n        has = visible.any(axis=1)\n        for j, i in enumerate(pt_idx):\n            if has[j]:\n                result[i] = new_plans[max_idx[j]]\n\n    return pd.Series(result, index=points.index)\nPYEOF\n"]
