[1294.527543, "i", "cd /app && cat << 'PYEOF' > /tmp/validate.py\nimport pandas as pd, numpy as np, json\n\nfeats = pd.read_parquet(\"/tmp/test.parquet\")\nfeats[\"as_of\"] = pd.to_datetime(feats[\"as_of\"], utc=True)\nfeats = feats.set_index([\"customer_id\", \"as_of\"])\n\nrows = [json.loads(l) for l in open(\"/app/logs/live_2026-01_sample.jsonl\")]\nkept = [\"orders_7d\",\"orders_30d\",\"spend_30d_cents\",\"tickets_30d\",\n        \"days_since_last_order\",\"tenure_days\",\"status\",\"plan\",\"app_minutes_7d\",\"te_district\"]\n\nmism = {c:0 for c in kept}\ntotal = 0\nexamples = {c:[] for c in kept}\nfor r in rows:\n    cid = r[\"customer_id\"]; asof = pd.Timestamp(r[\"as_of\"], tz=\"UTC\")\n    total += 1\n    if (cid, asof) not in feats.index:\n        continue\n    fr = feats.loc[(cid, asof)]\n    for c in kept:\n        exp = r[\"features\"][c]\n        got = fr[c]\n        if isinstance(exp,(int,float)) and not isinstance(exp,bool):\n            if pd.isna(got):\n                ok = (exp is None)\n            else:\n                ok = abs(float(got)-float(exp)) <= 1e-6 + 1e-9*abs(flo"]
[1294.527589, "i", "at(exp))\n        else:\n            ok = (got == exp) if not (pd.isna(got) and exp is None) else True\n        if not ok:\n            mism[c]+=1\n            if len(examples[c])<3:\n                examples[c].append((cid, str(asof), exp, got))\nprint(\"total\", total)\nfor c in kept:\n    print(f\"{c:22s} mismatches {mism[c]}\")\nfor c in kept:\n    if examples[c]:\n        print(\"  ex\", c, examples[c])\nPYEOF\npython3 /tmp/validate.py\n"]
