[1142.046113, "o", "\u001b[?2004h> "]
[1142.046407, "o", "        ti = np.array(tk_groups[cid], dtype=np.intp)\r\n\u001b[?2004l\r"]
[1142.046451, "o", "\u001b[?2004h"]
[1142.046481, "o", "> "]
