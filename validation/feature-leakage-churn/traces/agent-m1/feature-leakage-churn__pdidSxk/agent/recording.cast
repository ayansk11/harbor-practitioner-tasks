[1205.101306, "o", "\u001b[?2004h> "]
[1205.101439, "o", "    feats[\"days_since_last_order\"] = dsl\r\n\u001b[?2004l\r"]
[1205.10147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1205.101503, "o", "\u001b[?2004h> "]
[1205.101717, "o", "    feats[\"tickets_30d\"] = ticket_features(points, t[\"tickets\"])\r\n\u001b[?2004l\r"]
[1205.10175, "o", "\u001b[?2004h> "]
[1205.10197, "o", "    feats[\"tenure_days\"] = tenure_days(points, t[\"customers\"])\r\n\u001b[?2004l\r"]
[1205.102003, "o", "\u001b[?2004h> "]
[1205.102246, "o", "    feats[\"status\"] = latest_status(points, t[\"status_snapshots\"])\r\n\u001b[?2004l\r"]
[1205.102285, "o", "\u001b[?2004h> "]
[1205.102548, "o", "    feats[\"plan\"] = plan_feature(points, t[\"customers\"], t[\"plan_changes\"])\r\n\u001b[?2004l\r"]
[1205.102576, "o", "\u001b[?2004h> "]
[1205.102771, "o", "    feats[\"app_minutes_7d\"] = fill_app_minutes(points)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1205.102803, "o", "> "]
