[1142.048427, "o", "> \r\n\u001b[?2004l\r"]
[1142.048459, "o", "\u001b[?2004h> "]
[1142.048645, "o", "def tenure_days(points, customers):\r\n\u001b[?2004l\r"]
[1142.048684, "o", "\u001b[?2004h> "]
[1142.049063, "o", "    \"\"\"(as_of - signup_at) / 86400; NULL if customer not yet visible.\"\"\"\r\n\u001b[?2004l\r"]
[1142.049096, "o", "\u001b[?2004h"]
[1142.049126, "o", "> "]
[1142.049575, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[1142.049609, "o", "\u001b[?2004h> "]
[1142.049963, "o", "    days = (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[1142.050005, "o", "\u001b[?2004h"]
[1142.050037, "o", "> "]
[1142.050284, "o", "    return days.where(signup < points[\"as_of\"])\r\n\u001b[?2004l\r"]
[1142.050326, "o", "\u001b[?2004h"]
[1142.050355, "o", "> "]
[1142.050401, "o", "PYEOF\r\n"]
[1142.050434, "o", "\u001b[?2004l\r"]
[1142.052831, "o", "\u001b[?2004h"]
[1142.052874, "o", "root@988134ce-a765-4e20-b2f3-7ad8538b1419:/app# "]
[1142.417659, "i", "cat << 'PYEOF' > /app/churn/status.py\n\"\"\"Account status from the billing system's status snapshots, point in time.\n\nThe live query takes the latest snapshot by snapshot_date with no date filter;\nvisibility is determined by _loaded_at < t (committed before the prediction).\n\"\"\"\nimport numpy as np\nimport pandas as pd\nfrom collections import defaultdict\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\n\n\ndef _seconds(ts):\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Status of the customer's latest snapshot (by snapshot_date) committed before as_of.\"\"\"\n    pts_cid = points[\"customer_id\"].to_numpy()\n    pts_t = _seconds(points[\"as_of\"])\n    n = len(pts_t)\n    result = np.full(n, None, dtype=object)\n\n    if len(snapshots) == 0:\n        return pd.Series(result, index=points.index)\n\n    s_cid = snapshots[\"customer_id\"].to_numpy()\n    s_date = _seconds(snapshots[\"snapshot_date\"])\n    s_status = snapshots[\"status\"].to_numpy()\n    s_loaded = _seco"]
[1142.417772, "i", "nds(snapshots[\"_loaded_at\"])\n\n    s_groups = defaultdict(list)\n    for i in range(len(s_cid)):\n        s_groups[s_cid[i]].append(i)\n\n    pt_groups = defaultdict(list)\n    for i in range(len(pts_cid)):\n        pt_groups[pts_cid[i]].append(i)\n\n    for cid, pt_idx in pt_groups.items():\n        if cid not in s_groups:\n            continue\n        si = np.array(s_groups[cid], dtype=np.intp)\n        t = pts_t[pt_idx]\n        dates = s_date[si]\n        loaded = s_loaded[si]\n        statuses = s_status[si]\n\n        visible = loaded[None, :] < t[:, None]\n        masked = np.where(visible, dates[None, :], np.iinfo(np.int64).min)\n        max_idx = masked.argmax(axis=1)\n        has = visible.any(axis=1)\n        for j, i in enumerate(pt_idx):\n            if has[j]:\n                result[i] = statuses[max_idx[j]]\n\n    return pd.Series(result, index=points.index)\nPYEOF\n"]
