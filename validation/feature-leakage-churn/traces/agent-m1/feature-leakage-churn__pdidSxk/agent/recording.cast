[1142.919912, "i", "cat << 'PYEOF' > /app/churn/attributes.py\n\"\"\"Customer attributes reconstructable from the extract.\n\nplan is reconstructed from plan_changes (visible when _loaded_at < as_of).\ndays_since_last_login CANNOT be reconstructed (no history of last_login_at), so it is dropped.\n\"\"\"\nimport numpy as np\nimport pandas as pd\nfrom collections import defaultdict\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\n\n\ndef _seconds(ts):\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef plan_feature(points, customers, plan_changes):\n    \"\"\"The customer's plan as of each prediction time.\n\n    Starts from the signup plan, then applies plan_changes committed before as_of.\n    The plan is the new_plan of the latest change (by changed_at) among visible ones.\n    \"\"\"\n    pts_cid = points[\"customer_id\"].to_numpy()\n    pts_t = _seconds(points[\"as_of\"])\n    n = len(pts_t)\n\n    sp_map = customers.set_index(\"customer_id\")[\"plan\"]\n    result = np.full(n, None, dtype=object)\n\n    # Default: signup plan\n    for i in "]
[1142.920054, "i", "range(n):\n        cid = pts_cid[i]\n        if cid in sp_map.index:\n            result[i] = sp_map.loc[cid]\n\n    if len(plan_changes) == 0:\n        return pd.Series(result, index=points.index)\n\n    pc_cid = plan_changes[\"customer_id\"].to_numpy()\n    pc_changed = _seconds(plan_changes[\"changed_at\"])\n    pc_new = plan_changes[\"new_plan\"].to_numpy()\n    pc_loaded = _seconds(plan_changes[\"_loaded_at\"])\n\n    pc_groups = defaultdict(list)\n    for i in range(len(pc_cid)):\n        pc_groups[pc_cid[i]].append(i)\n\n    pt_groups = defaultdict(list)\n    for i in range(len(pts_cid)):\n        pt_groups[pts_cid[i]].append(i)\n\n    for cid, pt_idx in pt_groups.items():\n        if cid not in pc_groups:\n            continue\n        pci = np.array(pc_groups[cid], dtype=np.intp)\n        t = pts_t[pt_idx]\n        changed = pc_changed[pci]\n        new_plans = pc_new[pci]\n        loaded = pc_loaded[pci]\n\n        visible = loaded[None, :] < t[:, None]\n        masked = np.where(visible, changed[None, :], np.iinfo(np.int64).min)\n       "]
[1142.920111, "i", " max_idx = masked.argmax(axis=1)\n        has = visible.any(axis=1)\n        for j, i in enumerate(pt_idx):\n            if has[j]:\n                result[i] = new_plans[max_idx[j]]\n\n    return pd.Series(result, index=points.index)\nPYEOF\n"]
