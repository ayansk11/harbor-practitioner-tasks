[1204.705496, "o", "> "]
[1204.705554, "o", "    groups = defaultdict(list)\r\n\u001b[?2004l\r"]
[1204.705592, "o", "\u001b[?2004h> "]
[1204.705684, "o", "    for i in range(len(lab_d_arr)):\r\n\u001b[?2004l\r"]
[1204.705722, "o", "\u001b[?2004h> "]
[1204.705911, "o", "        d = lab_d_arr[i] if not pd.isna(lab_d_arr[i]) else \"__NA__\"\r\n\u001b[?2004l\r"]
[1204.705952, "o", "\u001b[?2004h> "]
[1204.706021, "o", "        groups[d].append(i)\r\n\u001b[?2004l\r"]
[1204.706058, "o", "\u001b[?2004h> "]
[1204.706095, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1204.706246, "o", "    d_loaded = {}   # district -> sorted loaded times\r\n\u001b[?2004l\r"]
[1204.706285, "o", "\u001b[?2004h> "]
[1204.706483, "o", "    d_ycum = {}     # district -> cumsum of y aligned with sorted loaded\r\n\u001b[?2004l\r"]
[1204.706521, "o", "\u001b[?2004h> "]
[1204.706607, "o", "    for d, idx in groups.items():\r\n\u001b[?2004l\r"]
[1204.706646, "o", "\u001b[?2004h> "]
[1204.706762, "o", "        idx = np.array(idx, dtype=np.intp)\r\n\u001b[?2004l\r"]
[1204.706829, "o", "\u001b[?2004h> "]
[1204.706908, "o", "        ld = lab_loaded[idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1204.706956, "o", "        yv = y[idx]\r\n\u001b[?2004l\r"]
[1204.706991, "o", "\u001b[?2004h> "]
[1204.707102, "o", "        o = np.argsort(ld, kind=\"stable\")\r\n\u001b[?2004l\r"]
[1204.707132, "o", "\u001b[?2004h> "]
[1204.707225, "o", "        d_loaded[d] = ld[o]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1204.707254, "o", "> "]
[1204.707437, "o", "        d_ycum[d] = np.concatenate([[0.0], np.cumsum(yv[o])])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1204.707493, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1204.70753, "o", "> "]
[1204.707657, "o", "    # --- for each prediction, find its district's stats ---\r\n\u001b[?2004l\r"]
[1204.707699, "o", "\u001b[?2004h> "]
[1204.707772, "o", "    pt_d_arr = pt_d.to_numpy()\r\n\u001b[?2004l\r"]
[1204.707814, "o", "\u001b[?2004h"]
[1204.707844, "o", "> "]
[1204.707926, "o", "    n_d = np.zeros(n_pts, dtype=np.int64)\r\n\u001b[?2004l\r"]
[1204.707959, "o", "\u001b[?2004h> "]
[1204.708082, "o", "    s_d = np.zeros(n_pts, dtype=np.float64)\r\n\u001b[?2004l\r"]
[1204.708115, "o", "\u001b[?2004h"]
[1204.708146, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1204.708249, "o", "    pt_groups = defaultdict(list)\r\n\u001b[?2004l\r"]
[1204.708287, "o", "\u001b[?2004h> "]
[1204.708354, "o", "    for i in range(n_pts):\r\n\u001b[?2004l\r"]
[1204.708399, "o", "\u001b[?2004h> "]
[1204.708577, "o", "        d = pt_d_arr[i] if not pd.isna(pt_d_arr[i]) else \"__NA__\"\r\n\u001b[?2004l\r"]
[1204.708612, "o", "\u001b[?2004h> "]
[1204.708692, "o", "        pt_groups[d].append(i)\r\n\u001b[?2004l\r"]
[1204.708723, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1204.708754, "o", "\u001b[?2004h> "]
[1204.708867, "o", "    for d, pt_idx in pt_groups.items():\r\n\u001b[?2004l\r"]
[1204.708899, "o", "\u001b[?2004h> "]
[1204.708976, "o", "        if d not in d_loaded:\r\n\u001b[?2004l\r"]
[1204.709001, "o", "\u001b[?2004h> "]
[1204.709066, "o", "            continue\r\n\u001b[?2004l\r"]
[1204.709091, "o", "\u001b[?2004h"]
[1204.709114, "o", "> "]
[1204.709162, "o", "        tl = t[pt_idx]\r\n\u001b[?2004l\r"]
[1204.709186, "o", "\u001b[?2004h> "]
[1204.709367, "o", "        n = np.searchsorted(d_loaded[d], tl, side=\"left\")\r\n\u001b[?2004l\r"]
[1204.70939, "o", "\u001b[?2004h"]
[1204.709414, "o", "> "]
[1204.709465, "o", "        n_d[pt_idx] = n\r\n\u001b[?2004l\r"]
[1204.709489, "o", "\u001b[?2004h> "]
[1204.709597, "o", "        s_d[pt_idx] = d_ycum[d][n]\r\n\u001b[?2004l\r"]
[1204.709618, "o", "\u001b[?2004h> \r\n"]
[1204.709652, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1204.709677, "o", "> "]
[1204.709805, "o", "    result = (s_d + m * prior) / (n_d + m)\r\n\u001b[?2004l\r"]
[1204.709833, "o", "\u001b[?2004h> "]
[1204.710029, "o", "    return pd.Series(result, index=points.index, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1204.710056, "o", "\u001b[?2004h> "]
[1204.710085, "o", "PYEOF\r\n\u001b[?2004l\r"]
[1204.713424, "o", "\u001b[?2004hroot@988134ce-a765-4e20-b2f3-7ad8538b1419:/app# "]
[1205.096739, "i", "cat << 'PYEOF' > /app/churn/build_features.py\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\nimport argparse\nimport os\n\nimport pandas as pd\n\nfrom churn.attributes import plan_feature\nfrom churn.encoding import district_encoding\nfrom churn.extract import load_extract\nfrom churn.impute import fill_app_minutes\nfrom churn.status import latest_status\nfrom churn.windows import order_features, ticket_features, tenure_days\n\nFEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\",\n                   \"days_since_last_order\", \"tenure_days\", \"status\", \"plan\",\n                   \"app_minutes_7d\", \"te_district\"]\n\n\ndef build(data_dir):\n    t = load_extract(data_dir)\n    points = t[\"scoring_points\"].reset_index(drop=True)\n\n    # order / ticket windows + days_since_last_order (visibility-filtered)\n    o7, o30, s30, dsl = order_features(points, t[\"orders\"])\n    feats = pd.DataFrame({\"customer_id\": points[\"customer_id\"], \"as_of\": points[\"as_of\"]})\n   "]
[1205.096865, "i", " feats[\"orders_7d\"] = o7\n    feats[\"orders_30d\"] = o30\n    feats[\"spend_30d_cents\"] = s30\n    feats[\"days_since_last_order\"] = dsl\n\n    feats[\"tickets_30d\"] = ticket_features(points, t[\"tickets\"])\n    feats[\"tenure_days\"] = tenure_days(points, t[\"customers\"])\n    feats[\"status\"] = latest_status(points, t[\"status_snapshots\"])\n    feats[\"plan\"] = plan_feature(points, t[\"customers\"], t[\"plan_changes\"])\n    feats[\"app_minutes_7d\"] = fill_app_minutes(points)\n    feats[\"te_district\"] = district_encoding(points, t[\"labels\"], t[\"customers\"])\n\n    return feats[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    a = ap.parse_args()\n    feats = build(a.data)\n    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)\n    feats.to_parquet(a.out, index=False)\n    print(f\"wrote {len(feats)} rows x"]
[1205.096906, "i", " {feats.shape[1]} columns to {a.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
