[1142.047459, "o", "\u001b[?2004h> "]
[1142.047814, "o", "        w30 = visible & (opened[None, :] >= (t[:, None] - 30 * 86400))\r\n\u001b[?2004l\r"]
[1142.047855, "o", "\u001b[?2004h> "]
[1142.04806, "o", "        out[pt_idx] = w30.sum(axis=1)\r\n\u001b[?2004l\r"]
