[1142.04546, "o", "\u001b[?2004h> "]
[1142.045676, "o", "    for cid, pt_idx in pt_groups.items():\r\n\u001b[?2004l\r"]
[1142.045713, "o", "\u001b[?2004h"]
[1142.045751, "o", "> "]
