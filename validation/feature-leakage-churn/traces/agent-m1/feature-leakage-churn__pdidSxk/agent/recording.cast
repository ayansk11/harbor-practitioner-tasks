[1330.984596, "o", "        if cid not in pc_groups:\r\n\u001b[?2004l\r"]
[1330.984648, "o", "\u001b[?2004h"]
[1330.984663, "o", "> "]
[1330.984774, "o", "            continue\r\n\u001b[?2004l\r"]
[1330.984823, "o", "\u001b[?2004h"]
[1330.984865, "o", "> "]
[1330.985146, "o", "        pci = np.array(pc_groups[cid], dtype=np.intp)\r\n\u001b[?2004l\r"]
[1330.985246, "o", "\u001b[?2004h"]
[1330.985294, "o", "> "]
[1330.985359, "o", "        t = pts_t[pt_idx]\r\n\u001b[?2004l\r"]
[1330.985407, "o", "\u001b[?2004h> "]
[1330.98561, "o", "        changed = pc_changed[pci]\r\n\u001b[?2004l\r"]
[1330.985647, "o", "\u001b[?2004h"]
[1330.985683, "o", "> "]
[1330.985853, "o", "        new_plans = pc_new[pci]\r\n\u001b[?2004l\r"]
[1330.985899, "o", "\u001b[?2004h> "]
[1330.986094, "o", "        loaded = pc_loaded[pci]\r\n\u001b[?2004l\r"]
[1330.98613, "o", "\u001b[?2004h"]
[1330.986166, "o", "> \r\n\u001b[?2004l\r"]
[1330.986234, "o", "\u001b[?2004h"]
[1330.986269, "o", "> "]
[1330.986487, "o", "        visible = loaded[None, :] < t[:, None]\r\n\u001b[?2004l\r"]
[1330.986526, "o", "\u001b[?2004h"]
[1330.986564, "o", "> "]
[1330.98699, "o", "        masked = np.where(visible, changed[None, :], np.iinfo(np.int64).min)\r\n\u001b[?2004l\r"]
[1330.987027, "o", "\u001b[?2004h"]
[1330.98706, "o", "> "]
[1330.987307, "o", "        max_idx = masked.argmax(axis=1)\r\n\u001b[?2004l\r"]
[1330.987351, "o", "\u001b[?2004h> "]
[1330.987556, "o", "        has = visible.any(axis=1)\r\n\u001b[?2004l\r"]
[1330.987599, "o", "\u001b[?2004h> "]
[1330.987845, "o", "        for j, i in enumerate(pt_idx):\r\n\u001b[?2004l\r"]
[1330.987888, "o", "\u001b[?2004h"]
[1330.987903, "o", "> "]
[1330.988048, "o", "            if has[j]:\r\n\u001b[?2004l\r"]
[1330.988097, "o", "\u001b[?2004h> "]
[1330.988412, "o", "                result[i] = new_plans[max_idx[j]]\r\n\u001b[?2004l\r"]
[1330.988459, "o", "\u001b[?2004h> "]
[1330.988497, "o", "\r\n\u001b[?2004l\r"]
[1330.988531, "o", "\u001b[?2004h> "]
[1330.988821, "o", "    return pd.Series(result, index=points.index)\r\n\u001b[?2004l\r"]
