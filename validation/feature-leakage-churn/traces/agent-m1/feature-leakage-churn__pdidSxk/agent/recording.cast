[1142.024258, "i", "cat << 'PYEOF' > /app/churn/windows.py\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and time-since features.\n\nPoint in time: a window [t - W days, t) is further restricted by warehouse visibility:\na row is only seen if its _loaded_at < t (committed before the prediction).\n\"\"\"\nimport numpy as np\nimport pandas as pd\nfrom collections import defaultdict\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nSTRIDE = 10 ** 10\n\n\ndef _seconds(ts):\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef order_features(points, orders):\n    \"\"\"orders_7d, orders_30d, spend_30d_cents, days_since_last_order.\n\n    Only counts orders visible at the prediction time (_loaded_at < as_of).\n    spend_30d_cents is 0 when there are no matching orders (COALESCE semantics).\n    days_since_last_order is NULL when no visible order exists.\n    \"\"\"\n    pts_cid = points[\"customer_id\"].to_numpy()\n    pts_t = _seconds(points[\"as_of\"])\n    n = len(pts_t)\n    out7 = np.zeros(n, dtype=np.int64)\n    out"]
[1142.024405, "i", "30 = np.zeros(n, dtype=np.int64)\n    spend30 = np.zeros(n, dtype=np.int64)\n    dsl = np.full(n, np.nan)\n\n    if len(orders) == 0:\n        return out7, out30, spend30, dsl\n\n    o_cid = orders[\"customer_id\"].to_numpy()\n    o_ord = _seconds(orders[\"ordered_at\"])\n    o_load = _seconds(orders[\"_loaded_at\"])\n    o_amt = orders[\"amount_cents\"].to_numpy()\n\n    o_groups = defaultdict(list)\n    for i in range(len(o_cid)):\n        o_groups[o_cid[i]].append(i)\n\n    pt_groups = defaultdict(list)\n    for i in range(len(pts_cid)):\n        pt_groups[pts_cid[i]].append(i)\n\n    for cid, pt_idx in pt_groups.items():\n        if cid not in o_groups:\n            continue\n        oi = np.array(o_groups[cid], dtype=np.intp)\n        t = pts_t[pt_idx]\n        ord_s = o_ord[oi]\n        load_s = o_load[oi]\n        amt = o_amt[oi]\n\n        visible = load_s[None, :] < t[:, None]\n        w7 = visible & (ord_s[None, :] >= (t[:, None] - 7 * 86400))\n        out7[pt_idx] = w7.sum(axis=1)\n\n        w30 = visible & (ord_s[None, :] >= (t[:, None] "]
[1142.024504, "i", "- 30 * 86400))\n        out30[pt_idx] = w30.sum(axis=1)\n        spend30[pt_idx] = (w30 * amt[None, :]).sum(axis=1).astype(np.int64)\n\n        # visible implies ordered_at < t because _loaded_at >= ordered_at\n        max_ord = np.where(visible, ord_s[None, :], np.iinfo(np.int64).min).max(axis=1)\n        has = visible.any(axis=1)\n        dso = np.full(len(t), np.nan)\n        dso[has] = (t[has] - max_ord[has]) / 86400.0\n        dsl[pt_idx] = dso\n\n    return out7, out30, spend30, dsl\n\n\ndef ticket_features(points, tickets):\n    \"\"\"tickets_30d: count of tickets opened in [t-30d, t) visible at t.\"\"\"\n    pts_cid = points[\"customer_id\"].to_numpy()\n    pts_t = _seconds(points[\"as_of\"])\n    n = len(pts_t)\n    out = np.zeros(n, dtype=np.int64)\n\n    if len(tickets) == 0:\n        return out\n\n    t_cid = tickets[\"customer_id\"].to_numpy()\n    t_opened = _seconds(tickets[\"opened_at\"])\n    t_loaded = _seconds(tickets[\"_loaded_at\"])\n\n    tk_groups = defaultdict(list)\n    for i in range(len(t_cid)):\n        tk_groups[t_cid[i]].app"]
[1142.024553, "i", "end(i)\n\n    pt_groups = defaultdict(list)\n    for i in range(len(pts_cid)):\n        pt_groups[pts_cid[i]].append(i)\n\n    for cid, pt_idx in pt_groups.items():\n        if cid not in tk_groups:\n            continue\n        ti = np.array(tk_groups[cid], dtype=np.intp)\n        t = pts_t[pt_idx]\n        opened = t_opened[ti]\n        loaded = t_loaded[ti]\n\n        visible = loaded[None, :] < t[:, None]\n        w30 = visible & (opened[None, :] >= (t[:, None] - 30 * 86400))\n        out[pt_idx] = w30.sum(axis=1)\n\n    return out\n\n\ndef tenure_days(points, customers):\n    \"\"\"(as_of - signup_at) / 86400; NULL if customer not yet visible.\"\"\"\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\n    days = (points[\"as_of\"] - signup).dt.total_seconds() / 86400\n    return days.where(signup < points[\"as_of\"])\nPYEOF\n"]
