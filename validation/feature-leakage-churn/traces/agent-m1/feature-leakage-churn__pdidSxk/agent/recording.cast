[67.500381, "o", "cat -n /app/live/features.py\r\n\u001b[?2004l\r"]
[67.501681, "o", "     1\t\"\"\"Feature queries of the live churn scoring service: a read-only copy of the service's `features` module.\r\n     2\t\r\n     3\tThis copy is the contract between the live service and the offline pipeline in `churn/`. It is kept for reference:\r\n     4\tnothing in this repository imports or runs it, there is no warehouse connection here, and editing it changes nothing.\r\n     5\t\r\n     6\tHow the service uses it. A scoring request names a customer and a moment: the 06:00 batch run (trigger `batch`), or\r\n     7\tthe support desk when a ticket is opened (trigger `ticket`, at the ticket's `opened_at`). For each request the service\r\n     8\truns every query in QUERIES once, at the moment of the request, against the warehouse tables as they stand at that\r\n     9\tmoment, and takes the first column of the first row as the feature's value; a query that returns no row, or NULL,\r\n    10\tgives a null value. The service then scores the 11 values with the deployed model, if one is attached, and logs them\r\n    11\twith the reque"]
[67.5018, "o", "st.\r\n    12\t\r\n    13\tParameters of every query:\r\n    14\t    :customer_id     the request's customer\r\n    15\t    :now             the moment of the request (the `as_of` the scoring service records for it)\r\n    16\t    :app_minutes_7d  the product-analytics reading that came with the request, NULL when it came without one\r\n    17\t\r\n    18\tThe warehouse is PostgreSQL. Timestamps are `timestamptz` and sessions run in UTC, so INTERVAL '7 days' is exactly\r\n    19\t7 x 86,400 seconds and EXTRACT(EPOCH FROM <interval>) is a number of seconds. The tables, and when their rows and\r\n    20\tvalues are committed: docs/WAREHOUSE.md.\r\n    21\t\"\"\"\r\n    22\t\r\n    23\tQUERIES = {\r\n    24\t    # orders in the 7 days before the request\r\n    25\t    \"orders_7d\": \"\"\"\r\n    26\t        SELECT COUNT(*)\r\n    27\t        FROM orders\r\n    28\t        WHERE customer_id = :customer_id\r\n    29\t          AND ordered_at >= :now - INTERVAL '7 days'\r\n    30\t          AND ordered_at < :now\r\n    31\t    \"\"\",\r\n    32\t    # orders in the 30 days before the re"]
[67.501841, "o", "quest\r\n    33\t    \"orders_30d\": \"\"\"\r\n    34\t        SELECT COUNT(*)\r\n    35\t        FROM orders\r\n    36\t        WHERE customer_id = :customer_id\r\n    37\t          AND ordered_at >= :now - INTERVAL '30 days'\r\n    38\t          AND ordered_at < :now\r\n    39\t    \"\"\",\r\n    40\t    # amount of those orders, in cents (0 when there are none)\r\n    41\t    \"spend_30d_cents\": \"\"\"\r\n    42\t        SELECT COALESCE(SUM(amount_cents), 0)\r\n    43\t        FROM orders\r\n    44\t        WHERE customer_id = :customer_id\r\n    45\t          AND ordered_at >= :now - INTERVAL '30 days'\r\n    46\t          AND ordered_at < :now\r\n    47\t    \"\"\",\r\n    48\t    # support tickets opened in the 30 days before the request\r\n    49\t    \"tickets_30d\": \"\"\"\r\n    50\t        SELECT COUNT(*)\r\n    51\t        FROM tickets\r\n    52\t        WHERE customer_id = :customer_id\r\n    53\t          AND opened_at >= :now - INTERVAL '30 days'\r\n    54\t          AND opened_at < :now\r\n    55\t    \"\"\",\r\n    56\t    # days since the latest order before the request (NULL when the"]
[67.501862, "o", "re is none)\r\n    57\t    \"days_since_last_order\": \"\"\"\r\n    58\t        SELECT EXTRACT(EPOCH FROM (:now - MAX(ordered_at))) / 86400.0\r\n    59\t        FROM orders\r\n    60\t        WHERE customer_id = :customer_id\r\n    61\t          AND ordered_at < :now\r\n    62\t    \"\"\",\r\n    63\t    # days since sign-up\r\n    64\t    \"tenure_days\": \"\"\"\r\n    65\t        SELECT EXTRACT(EPOCH FROM (:now - signup_at)) / 86400.0\r\n    66\t        FROM customers\r\n    67\t        WHERE customer_id = :customer_id\r\n    68\t    \"\"\",\r\n    69\t    # account status of the latest snapshot (no row: NULL)\r\n    70\t    \"status\": \"\"\"\r\n    71\t        SELECT status\r\n    72\t        FROM status_snapshots\r\n    73\t        WHERE customer_id = :customer_id\r\n    74\t        ORDER BY snapshot_date DESC\r\n    75\t        LIMIT 1\r\n    76\t    \"\"\",\r\n    77\t    # subscription plan on the customer record\r\n    78\t    \"plan\": \"\"\"\r\n    79\t        SELECT plan\r\n    80\t        FROM customers\r\n    81\t        WHERE customer_id = :customer_id\r\n    82\t    \"\"\",\r\n    83\t    # days since th"]
[67.501883, "o", "e last login on the customer record (NULL when the record has none)\r\n    84\t    \"days_since_last_login\": \"\"\"\r\n    85\t        SELECT EXTRACT(EPOCH FROM (:now - last_login_at)) / 86400.0\r\n    86\t        FROM customers\r\n    87\t        WHERE customer_id = :customer_id\r\n    88\t    \"\"\",\r\n    89\t    # app minutes over the last 7 days: the request's own reading, else the reading of the customer's latest earlier\r\n    90\t    # request that had one (NULL when there is none)\r\n    91\t    \"app_minutes_7d\": \"\"\"\r\n    92\t        SELECT COALESCE(\r\n    93\t            CAST(:app_minutes_7d AS double precision),\r\n    94\t            (SELECT app_minutes_7d\r\n    95\t             FROM scoring_points\r\n    96\t             WHERE customer_id = :customer_id\r\n    97\t               AND as_of < :now\r\n    98\t               AND app_minutes_7d IS NOT NULL\r\n    99\t             ORDER BY as_of DESC\r\n   100\t             LIMIT 1))\r\n   101\t    \"\"\",\r\n   102\t    # smoothed churn rate of the customer's postcode district: (s + 20 p) / (n + 20), where p is "]
[67.501922, "o", "the mean churned_30d\r\n   103\t    # of all label rows (0.05 when there are none), and n and s are the number of label rows of customers in the same\r\n   104\t    # district and the sum of their churned_30d\r\n   105\t    \"te_district\": \"\"\"\r\n   106\t        WITH lab AS (\r\n   107\t            SELECT l.churned_30d, c.postcode_district\r\n   108\t            FROM labels l\r\n   109\t            JOIN customers c ON c.customer_id = l.customer_id\r\n   110\t        ),\r\n   111\t        own AS (\r\n   112\t            SELECT postcode_district\r\n   113\t            FROM customers\r\n   114\t            WHERE customer_id = :customer_id\r\n   115\t        )\r\n   116\t        SELECT (COALESCE(SUM(lab.churned_30d) FILTER (WHERE lab.postcode_district = own.postcode_district), 0)\r\n   117\t                + 20 * COALESCE(AVG(lab.churned_30d), 0.05))\r\n   118\t               / (COUNT(*) FILTER (WHERE lab.postcode_district = own.postcode_district) + 20)\r\n   119\t        FROM lab CROSS JOIN own\r\n   120\t    \"\"\",\r\n   121\t}\r\n   122\t\r\n   123\tFEATURES = list(QUERIES)"]
