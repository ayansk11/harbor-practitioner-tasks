[1205.100002, "o", "\u001b[?2004h> "]
[1205.100259, "o", "    # order / ticket windows + days_since_last_order (visibility-filtered)\r\n\u001b[?2004l\r"]
[1205.100292, "o", "\u001b[?2004h> "]
[1205.100494, "o", "    o7, o30, s30, dsl = order_features(points, t[\"orders\"])\r\n\u001b[?2004l\r"]
[1205.100527, "o", "\u001b[?2004h> "]
