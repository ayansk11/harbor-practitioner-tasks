[213.841069, "i", "cat -n /app/churn/build_features.py\n"]
[213.841447, "o", "cat -n /app/churn/build_features.py\r\n\u001b[?2004l\r"]
[213.843425, "o", "     1\t\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\r\n     2\timport argparse\r\n     3\timport os\r\n     4\t\r\n     5\tfrom churn.attributes import days_since_last_login, plan\r\n     6\tfrom churn.encoding import district_encoding\r\n     7\tfrom churn.extract import load_extract\r\n     8\tfrom churn.impute import fill_app_minutes\r\n"]
[213.843523, "o", "     9\tfrom churn.status import latest_status\r\n    10\tfrom churn.windows import activity_features, tenure_days\r\n    11\t\r\n    12\tFEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\r\n    13\t                   \"tenure_days\", \"status\", \"plan\", \"days_since_last_login\", \"app_minutes_7d\", \"te_district\"]\r\n    14\t\r\n    15\t\r\n    16\tdef build(data_dir):\r\n    17\t    t = load_extract(data_dir)\r\n    18\t    points = t[\"scoring_points\"].reset_index(drop=True)\r\n    19\t    feats = activity_features(points, t[\"orders\"], t[\"tickets\"])\r\n    20\t    feats[\"tenure_days\"] = tenure_days(points, t[\"customers\"])\r\n    21\t    feats[\"status\"] = latest_status(points, t[\"status_snapshots\"])"]
[213.843576, "o", "\r\n    22\t    feats[\"plan\"] = plan(points, t[\"customers\"])\r\n    23\t    feats[\"days_since_last_login\"] = days_since_last_login(points, t[\"customers\"])\r\n    24\t    feats[\"app_minutes_7d\"] = fill_app_minutes(points)\r\n    25\t    feats[\"te_district\"] = district_encoding(points, t[\"labels\"], t[\"customers\"])\r\n    26\t    return feats[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n    27\t\r\n    28\t\r\n    29\tdef main():\r\n    30\t    ap = argparse.ArgumentParser(description=__doc__)\r\n    31\t    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n    32\t    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n    33\t    a = ap.parse_args()\r\n    34\t    feats = build(a.data)\r\n    35\t    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)\r\n    36\t    feats.to_parquet(a.out, index=False)\r\n    37\t    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {a.out}\")\r\n    38\t\r\n    39\t\r\n    40\tif __name__ == \"__main__\":\r\n    41\t    main()\r\n"]
