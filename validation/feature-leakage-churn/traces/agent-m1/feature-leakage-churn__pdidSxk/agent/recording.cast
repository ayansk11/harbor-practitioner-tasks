[1205.099504, "o", "\u001b[?2004h> "]
[1205.099581, "o", "def build(data_dir):\r\n\u001b[?2004l\r"]
[1205.099615, "o", "\u001b[?2004h> "]
[1205.099724, "o", "    t = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[1205.099757, "o", "\u001b[?2004h> "]
[1205.099941, "o", "    points = t[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
