[1142.046642, "o", "\u001b[?2004h"]
[1142.046674, "o", "> "]
[1142.046829, "o", "        opened = t_opened[ti]\r\n\u001b[?2004l\r"]
[1142.04687, "o", "\u001b[?2004h> "]
[1142.047039, "o", "        loaded = t_loaded[ti]\r\n\u001b[?2004l\r"]
[1142.04708, "o", "\u001b[?2004h> "]
[1142.047112, "o", "\r\n\u001b[?2004l\r"]
[1142.047148, "o", "\u001b[?2004h"]
[1142.047182, "o", "> "]
