[1142.922729, "o", "\u001b[?2004h"]
[1142.92277, "o", "> "]
[1142.922817, "o", "def _seconds(ts):\r\n\u001b[?2004l\r"]
[1142.922859, "o", "\u001b[?2004h"]
[1142.922901, "o", "> "]
[1142.923236, "o", "    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1142.923278, "o", "\u001b[?2004h> "]
[1142.92332, "o", "\r\n\u001b[?2004l\r"]
[1142.923376, "o", "\u001b[?2004h> \r\n"]
[1142.923416, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1142.923458, "o", "> "]
[1142.923661, "o", "def plan_feature(points, customers, plan_changes):\r\n\u001b[?2004l\r"]
[1142.923709, "o", "\u001b[?2004h> "]
[1142.923985, "o", "    \"\"\"The customer's plan as of each prediction time.\r\n"]
[1142.924026, "o", "\u001b[?2004l\r"]
[1142.924069, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1142.924109, "o", "\u001b[?2004h> "]
[1142.924534, "o", "    Starts from the signup plan, then applies plan_changes committed before as_of.\r\n\u001b[?2004l\r"]
[1142.924591, "o", "\u001b[?2004h> "]
[1142.925055, "o", "    The plan is the new_plan of the latest change (by changed_at) among visible ones.\r\n\u001b[?2004l\r"]
[1142.925103, "o", "\u001b[?2004h> "]
[1142.925144, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[1142.925181, "o", "\u001b[?2004h"]
[1142.925227, "o", "> "]
[1142.92542, "o", "    pts_cid = points[\"customer_id\"].to_numpy()\r\n\u001b[?2004l\r"]
[1142.925465, "o", "\u001b[?2004h> "]
[1142.925652, "o", "    pts_t = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[1142.925701, "o", "\u001b[?2004h> "]
[1142.925792, "o", "    n = len(pts_t)\r\n\u001b[?2004l\r"]
[1142.92584, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1142.92588, "o", "\u001b[?2004h"]
[1142.925917, "o", "> "]
[1142.926148, "o", "    sp_map = customers.set_index(\"customer_id\")[\"plan\"]\r\n\u001b[?2004l\r"]
[1142.926205, "o", "\u001b[?2004h> "]
[1142.926418, "o", "    result = np.full(n, None, dtype=object)\r\n"]
[1142.926459, "o", "\u001b[?2004l\r"]
[1142.926502, "o", "\u001b[?2004h> "]
[1142.926539, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1142.926577, "o", "> "]
[1142.926664, "o", "    # Default: signup plan\r\n\u001b[?2004l\r"]
[1142.926712, "o", "\u001b[?2004h> "]
[1142.926822, "o", "    for i in range(n):\r\n\u001b[?2004l\r"]
[1142.926882, "o", "\u001b[?2004h"]
[1142.92692, "o", "> "]
[1142.927026, "o", "        cid = pts_cid[i]\r\n\u001b[?2004l\r"]
[1142.927065, "o", "\u001b[?2004h> "]
[1142.927248, "o", "        if cid in sp_map.index:\r\n\u001b[?2004l\r"]
[1142.927291, "o", "\u001b[?2004h> "]
[1142.927518, "o", "            result[i] = sp_map.loc[cid]\r\n\u001b[?2004l\r"]
[1142.927675, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1142.927769, "o", "    if len(plan_changes) == 0:\r\n\u001b[?2004l\r"]
[1142.927819, "o", "\u001b[?2004h> "]
[1142.928065, "o", "        return pd.Series(result, index=points.index)\r\n"]
[1142.928095, "o", "\u001b[?2004l\r"]
[1142.928113, "o", "\u001b[?2004h"]
[1142.928133, "o", "> \r\n\u001b[?2004l\r"]
[1142.928155, "o", "\u001b[?2004h"]
[1142.928172, "o", "> "]
[1142.928432, "o", "    pc_cid = plan_changes[\"customer_id\"].to_numpy()\r\n\u001b[?2004l\r"]
[1142.928463, "o", "\u001b[?2004h"]
[1142.928487, "o", "> "]
[1142.928737, "o", "    pc_changed = _seconds(plan_changes[\"changed_at\"])\r\n"]
[1142.928759, "o", "\u001b[?2004l\r"]
[1142.928791, "o", "\u001b[?2004h"]
[1142.928812, "o", "> "]
[1142.929028, "o", "    pc_new = plan_changes[\"new_plan\"].to_numpy()\r\n\u001b[?2004l\r"]
[1142.929058, "o", "\u001b[?2004h"]
[1142.929075, "o", "> "]
[1142.929389, "o", "    pc_loaded = _seconds(plan_changes[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[1142.92943, "o", "\u001b[?2004h"]
[1142.929447, "o", "> "]
[1142.929467, "o", "\r\n\u001b[?2004l\r"]
[1142.929486, "o", "\u001b[?2004h"]
[1142.929509, "o", "> "]
[1142.929668, "o", "    pc_groups = defaultdict(list)\r\n\u001b[?2004l\r"]
[1142.929696, "o", "\u001b[?2004h"]
[1142.929717, "o", "> "]
[1142.929873, "o", "    for i in range(len(pc_cid)):\r\n\u001b[?2004l\r"]
[1142.929897, "o", "\u001b[?2004h"]
[1142.929911, "o", "> "]
[1142.930101, "o", "        pc_groups[pc_cid[i]].append(i)\r\n\u001b[?2004l\r"]
[1142.930128, "o", "\u001b[?2004h"]
[1142.930148, "o", "> \r\n\u001b[?2004l\r"]
[1142.930172, "o", "\u001b[?2004h"]
[1142.930186, "o", "> "]
[1142.930362, "o", "    pt_groups = defaultdict(list)\r\n\u001b[?2004l\r"]
[1142.930405, "o", "\u001b[?2004h> "]
[1142.93057, "o", "    for i in range(len(pts_cid)):\r\n\u001b[?2004l\r"]
[1142.930596, "o", "\u001b[?2004h"]
[1142.930619, "o", "> "]
[1142.930804, "o", "        pt_groups[pts_cid[i]].append(i)\r\n\u001b[?2004l\r"]
[1142.930829, "o", "\u001b[?2004h"]
[1142.930846, "o", "> "]
[1142.930864, "o", "\r\n\u001b[?2004l\r"]
[1142.930899, "o", "\u001b[?2004h> "]
[1142.931093, "o", "    for cid, pt_idx in pt_groups.items():\r\n\u001b[?2004l\r"]
[1142.931119, "o", "\u001b[?2004h"]
[1142.931142, "o", "> "]
[1142.931308, "o", "        if cid not in pc_groups:\r\n\u001b[?2004l\r"]
[1142.931331, "o", "\u001b[?2004h"]
[1142.931349, "o", "> "]
[1142.931451, "o", "            continue\r\n\u001b[?2004l\r"]
[1142.931483, "o", "\u001b[?2004h"]
[1142.9315, "o", "> "]
[1142.931761, "o", "        pci = np.array(pc_groups[cid], dtype=np.intp)\r\n"]
[1142.931782, "o", "\u001b[?2004l\r"]
[1142.931801, "o", "\u001b[?2004h"]
[1142.93182, "o", "> "]
[1142.931943, "o", "        t = pts_t[pt_idx]\r\n\u001b[?2004l\r"]
[1142.931974, "o", "\u001b[?2004h"]
[1142.931998, "o", "> "]
[1142.932159, "o", "        changed = pc_changed[pci]\r\n\u001b[?2004l\r"]
[1142.932194, "o", "\u001b[?2004h"]
[1142.932219, "o", "> "]
[1142.932372, "o", "        new_plans = pc_new[pci]\r\n\u001b[?2004l\r"]
[1142.932407, "o", "\u001b[?2004h"]
[1142.932426, "o", "> "]
[1142.932602, "o", "        loaded = pc_loaded[pci]\r\n\u001b[?2004l\r"]
[1142.932626, "o", "\u001b[?2004h> "]
[1142.932646, "o", "\r\n\u001b[?2004l\r"]
[1142.93267, "o", "\u001b[?2004h"]
[1142.932687, "o", "> "]
[1142.932913, "o", "        visible = loaded[None, :] < t[:, None]\r\n\u001b[?2004l\r"]
[1142.932943, "o", "\u001b[?2004h"]
[1142.932972, "o", "> "]
[1142.933341, "o", "        masked = np.where(visible, changed[None, :], np.iinfo(np.int64).min)\r\n\u001b[?2004l\r"]
[1142.933367, "o", "\u001b[?2004h"]
[1142.933386, "o", "> "]
[1142.933579, "o", "        max_idx = masked.argmax(axis=1)\r\n\u001b[?2004l\r"]
[1142.933611, "o", "\u001b[?2004h"]
[1142.933629, "o", "> "]
[1142.933804, "o", "        has = visible.any(axis=1)\r\n"]
[1142.933821, "o", "\u001b[?2004l\r"]
[1142.93384, "o", "\u001b[?2004h"]
[1142.93386, "o", "> "]
[1142.934051, "o", "        for j, i in enumerate(pt_idx):\r\n"]
[1142.934067, "o", "\u001b[?2004l\r"]
[1142.934083, "o", "\u001b[?2004h"]
[1142.934102, "o", "> "]
[1142.934226, "o", "            if has[j]:\r\n"]
[1142.934244, "o", "\u001b[?2004l\r"]
[1142.934261, "o", "\u001b[?2004h"]
[1142.93428, "o", "> "]
[1142.934525, "o", "                result[i] = new_plans[max_idx[j]]\r\n"]
[1142.934546, "o", "\u001b[?2004l\r"]
[1142.934561, "o", "\u001b[?2004h"]
[1142.93458, "o", "> \r\n\u001b[?2004l\r"]
[1142.934612, "o", "\u001b[?2004h"]
[1142.934632, "o", "> "]
[1142.934874, "o", "    return pd.Series(result, index=points.index)\r\n"]
[1142.93489, "o", "\u001b[?2004l\r"]
[1142.934906, "o", "\u001b[?2004h"]
[1142.934924, "o", "> "]
[1142.934957, "o", "PYEOF\r\n"]
[1142.934973, "o", "\u001b[?2004l\r"]
[1142.956874, "o", "\u001b[?2004hroot@988134ce-a765-4e20-b2f3-7ad8538b1419:/app# "]
[1204.699365, "i", "cat << 'PYEOF' > /app/churn/encoding.py\n\"\"\"Target encoding of postcode district, point in time.\n\nA label row is visible at time t iff its _loaded_at < t.\nFormula: (s + 20*p) / (n + 20)\n  s, n = sum/count of churned_30d for same-district visible labels\n  p    = mean churned_30d of ALL visible labels (0.05 if none)\n\"\"\"\nimport numpy as np\nimport pandas as pd\nfrom collections import defaultdict\n\nPRIOR_WEIGHT = 20\nDEFAULT_PRIOR = 0.05\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\n\n\ndef _seconds(ts):\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef district_encoding(points, labels, customers):\n    m = PRIOR_WEIGHT\n    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    pt_d = points[\"customer_id\"].map(district)\n    t = _seconds(points[\"as_of\"])\n    n_pts = len(t)\n\n    if len(labels) == 0:\n        return pd.Series(np.full(n_pts, DEFAULT_PRIOR, dtype=np.float64), index=points.index)\n\n    lab_d = labels[\"customer_id\"].map(district)\n    lab_loaded = _seconds(labels[\"_"]
[1204.699493, "i", "loaded_at\"])\n    y = labels[\"churned_30d\"].to_numpy(dtype=np.float64)\n\n    # --- prior: mean of ALL visible labels ---\n    order = np.argsort(lab_loaded, kind=\"stable\")\n    ycum_all = np.concatenate([[0.0], np.cumsum(y[order])])\n    N_all = np.searchsorted(lab_loaded[order], t, side=\"left\")\n    S_all = ycum_all[N_all]\n    prior = np.full(n_pts, DEFAULT_PRIOR)\n    has = N_all > 0\n    prior[has] = S_all[has] / N_all[has]\n\n    # --- district-specific: group labels by district, sorted by loaded_at ---\n    lab_d_arr = lab_d.to_numpy()\n    groups = defaultdict(list)\n    for i in range(len(lab_d_arr)):\n        d = lab_d_arr[i] if not pd.isna(lab_d_arr[i]) else \"__NA__\"\n        groups[d].append(i)\n\n    d_loaded = {}   # district -> sorted loaded times\n    d_ycum = {}     # district -> cumsum of y aligned with sorted loaded\n    for d, idx in groups.items():\n        idx = np.array(idx, dtype=np.intp)\n        ld = lab_loaded[idx]\n        yv = y[idx]\n        o = np.argsort(ld, kind=\"stable\")\n        d_loaded[d] = ld[o]\n "]
[1204.699556, "i", "       d_ycum[d] = np.concatenate([[0.0], np.cumsum(yv[o])])\n\n    # --- for each prediction, find its district's stats ---\n    pt_d_arr = pt_d.to_numpy()\n    n_d = np.zeros(n_pts, dtype=np.int64)\n    s_d = np.zeros(n_pts, dtype=np.float64)\n\n    pt_groups = defaultdict(list)\n    for i in range(n_pts):\n        d = pt_d_arr[i] if not pd.isna(pt_d_arr[i]) else \"__NA__\"\n        pt_groups[d].append(i)\n\n    for d, pt_idx in pt_groups.items():\n        if d not in d_loaded:\n            continue\n        tl = t[pt_idx]\n        n = np.searchsorted(d_loaded[d], tl, side=\"left\")\n        n_d[pt_idx] = n\n        s_d[pt_idx] = d_ycum[d][n]\n\n    result = (s_d + m * prior) / (n_d + m)\n    return pd.Series(result, index=points.index, dtype=\"float64\")\nPYEOF\n"]
[1204.699685, "o", "cat << 'PYEOF' > /app/churn/encoding.py\r\n\u001b[?2004l\r"]
