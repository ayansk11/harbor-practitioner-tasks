[?2004l[?2004h>     spend_30d_cents is 0 when there are no matching orders (COALESCE semantics).
[?2004l[?2004h>     days_since_last_order is NULL when no visible order exists.
[?2004l[?2004h>     """
[?2004l[?2004h>     pts_cid = points["customer_id"].to_numpy()
[?2004l[?2004h>     pts_t = _seconds(points["as_of"])
[?2004l[?2004h>     n = len(pts_t)
