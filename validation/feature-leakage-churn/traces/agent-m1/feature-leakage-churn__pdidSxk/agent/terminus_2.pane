[?2004l[?2004h> """Target encoding of postcode district, point in time.
[?2004l[?2004h> 
[?2004l[?2004h> A label row is visible at time t iff its _loaded_at < t.
[?2004l[?2004h> Formula: (s + 20*p) / (n + 20)
[?2004l[?2004h>   s, n = sum/count of churned_30d for same-district visible labels
[?2004l[?2004h>   p    = mean churned_30d of ALL visible labels (0.05 if none)
[?2004l[?2004h> """
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> PRIOR_WEIGHT = 20
[?2004l[?2004h> DEFAULT_PRIOR = 0.05
[?2004l[?2004h> EPOCH = pd.Timestamp("1970-01-01", tz="UTC")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _seconds(ts):
[?2004l[?2004h>     return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def district_encoding(points, labels, customers):
[?2004l[?2004h>     m = PRIOR_WEIGHT
[?2004l[?2004h>     district = customers.set_index("customer_id")["postcode_district"]
[?2004l[?2004h>     pt_d = points["customer_id"].map(district)
[?2004l[?2004h>     t = _seconds(points["as_of"])
[?2004l[?2004h>     n_pts = len(t)
[?2004l[?2004h> 
[?2004l[?2004h>     if len(labels) == 0:
[?2004l[?2004h>         return pd.Series(np.full(n_pts, DEFAULT_PRIOR, dtype=np.float64), index=points.index)
[?2004l[?2004h> 
[?2004l[?2004h>     lab_d = labels["customer_id"].map(district)
[?2004l[?2004h>     lab_loaded = _seconds(labels["_loaded_at"])
[?2004l[?2004h>     y = labels["churned_30d"].to_numpy(dtype=np.float64)
[?2004l[?2004h> 
[?2004l[?2004h>     # --- prior: mean of ALL visible labels ---
[?2004l[?2004h>     order = np.argsort(lab_loaded, kind="stable")
[?2004l[?2004h>     ycum_all = np.concatenate([[0.0], np.cumsum(y[order])])
[?2004l[?2004h>     N_all = np.searchsorted(lab_loaded[order], t, side="left")
[?2004l[?2004h>     S_all = ycum_all[N_all]
[?2004l[?2004h>     prior = np.full(n_pts, DEFAULT_PRIOR)
[?2004l[?2004h>     has = N_all > 0
[?2004l[?2004h>     prior[has] = S_all[has] / N_all[has]
[?2004l[?2004h> 
[?2004l[?2004h>     # --- district-specific: group labels by district, sorted by loaded_at ---
[?2004l[?2004h>     lab_d_arr = lab_d.to_numpy()
[?2004l[?2004h>     groups = defaultdict(list)
[?2004l[?2004h>     for i in range(len(lab_d_arr)):
[?2004l[?2004h>         d = lab_d_arr[i] if not pd.isna(lab_d_arr[i]) else "__NA__"
[?2004l[?2004h>         groups[d].append(i)
[?2004l[?2004h> 
[?2004l[?2004h>     d_loaded = {}   # district -> sorted loaded times
[?2004l[?2004h>     d_ycum = {}     # district -> cumsum of y aligned with sorted loaded
[?2004l[?2004h>     for d, idx in groups.items():
[?2004l[?2004h>         idx = np.array(idx, dtype=np.intp)
[?2004l[?2004h>         ld = lab_loaded[idx]
[?2004l[?2004h>         yv = y[idx]
[?2004l[?2004h>         o = np.argsort(ld, kind="stable")
[?2004l[?2004h>         d_loaded[d] = ld[o]
[?2004l[?2004h>         d_ycum[d] = np.concatenate([[0.0], np.cumsum(yv[o])])
[?2004l[?2004h> 
[?2004l[?2004h>     # --- for each prediction, find its district's stats ---
[?2004l[?2004h>     pt_d_arr = pt_d.to_numpy()
[?2004l[?2004h>     n_d = np.zeros(n_pts, dtype=np.int64)
[?2004l[?2004h>     s_d = np.zeros(n_pts, dtype=np.float64)
[?2004l[?2004h> 
