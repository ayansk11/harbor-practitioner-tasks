[?2004l[?2004h>     out30 = np.zeros(n, dtype=np.int64)
[?2004l[?2004h>     spend30 = np.zeros(n, dtype=np.int64)
[?2004l[?2004h>     dsl = np.full(n, np.nan)
[?2004l[?2004h> 
[?2004l[?2004h>     if len(orders) == 0:
[?2004l[?2004h>         return out7, out30, spend30, dsl
[?2004l[?2004h> 
[?2004l[?2004h>     o_cid = orders["customer_id"].to_numpy()
[?2004l[?2004h>     o_ord = _seconds(orders["ordered_at"])
[?2004l[?2004h>     o_load = _seconds(orders["_loaded_at"])
[?2004l[?2004h>     o_amt = orders["amount_cents"].to_numpy()
