[?2004l     1	"""Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>"""
     2	import argparse
     3	import os
     4	
     5	from churn.attributes import days_since_last_login, plan
     6	from churn.encoding import district_encoding
     7	from churn.extract import load_extract
     8	from churn.impute import fill_app_minutes
     9	from churn.status import latest_status
    10	from churn.windows import activity_features, tenure_days
    11	
    12	FEATURE_COLUMNS = ["orders_7d", "orders_30d", "spend_30d_cents", "tickets_30d", "days_since_last_order",
    13	                   "tenure_days", "status", "plan", "days_since_last_login", "app_minutes_7d", "te_district"]
    14	
    15	
    16	def build(data_dir):
    17	    t = load_extract(data_dir)
    18	    points = t["scoring_points"].reset_index(drop=True)
    19	    feats = activity_features(points, t["orders"], t["tickets"])
    20	    feats["tenure_days"] = tenure_days(points, t["customers"])
    21	    feats["status"] = latest_status(points, t["status_snapshots"])
    22	    feats["plan"] = plan(points, t["customers"])
    23	    feats["days_since_last_login"] = days_since_last_login(points, t["customers"])
    24	    feats["app_minutes_7d"] = fill_app_minutes(points)
    25	    feats["te_district"] = district_encoding(points, t["labels"], t["customers"])
    26	    return feats[["customer_id", "as_of"] + FEATURE_COLUMNS]
    27	
    28	
    29	def main():
    30	    ap = argparse.ArgumentParser(description=__doc__)
    31	    ap.add_argument("--data", required=True, help="folder with the extract CSVs")
    32	    ap.add_argument("--out", required=True, help="output parquet file")
    33	    a = ap.parse_args()
    34	    feats = build(a.data)
    35	    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
    36	    feats.to_parquet(a.out, index=False)
    37	    print(f"wrote {len(feats)} rows x {feats.shape[1]} columns to {a.out}")
    38	
    39	
    40	if __name__ == "__main__":
    41	    main()
