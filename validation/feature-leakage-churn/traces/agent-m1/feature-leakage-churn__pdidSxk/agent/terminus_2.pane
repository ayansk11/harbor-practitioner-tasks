[?2004l[?2004h>     for i in range(len(pts_cid)):
[?2004l[?2004h>         pt_groups[pts_cid[i]].append(i)
[?2004l[?2004h> 
[?2004l[?2004h>     for cid, pt_idx in pt_groups.items():
[?2004l[?2004h>         if cid not in o_groups:
[?2004l[?2004h>             continue
