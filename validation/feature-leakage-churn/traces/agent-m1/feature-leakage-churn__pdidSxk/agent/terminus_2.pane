[?2004l[?2004h> """Customer attributes reconstructable from the extract.
[?2004l[?2004h> 
[?2004l[?2004h> plan is reconstructed point-in-time: the customer record starts at the signup plan and is
[?2004l[?2004h> overwritten by crm_sync as plan changes are committed. The signup plan is the old_plan of the
[?2004l[?2004h> earliest applied change (by changed_at), or the current record's plan when the customer never
[?2004l[?2004h> changed. days_since_last_login cannot be reconstructed (no history of last_login_at), so it is
[?2004l[?2004h> left out of the v4 feature table.
[?2004l[?2004h> """
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> EPOCH = pd.Timestamp("1970-01-01", tz="UTC")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _seconds(ts):
[?2004l[?2004h>     return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _signup_plans(customers, plan_changes):
[?2004l[?2004h>     """Per-customer plan at sign-up: old_plan of the earliest change (by changed_at), else the record's plan."""
[?2004l[?2004h>     base = customers.set_index("customer_id")["plan"]
[?2004l[?2004h>     if len(plan_changes) == 0:
[?2004l[?2004h>         return base.to_dict()
[?2004l[?2004h>     pc = plan_changes.sort_values("changed_at", kind="stable")
[?2004l[?2004h>     first = pc.groupby("customer_id").first()  # earliest changed_at -> its old_plan
[?2004l[?2004h>     out = base.to_dict()
[?2004l[?2004h>     for cid, old in first["old_plan"].items():
[?2004l[?2004h>         out[cid] = old
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def plan_feature(points, customers, plan_changes):
[?2004l[?2004h>     """The customer's plan on the record at each prediction time (committed before as_of)."""
[?2004l[?2004h>     pts_cid = points["customer_id"].to_numpy()
[?2004l[?2004h>     pts_t = _seconds(points["as_of"])
[?2004l[?2004h>     n = len(pts_t)
[?2004l[?2004h> 
[?2004l[?2004h>     signup = _signup_plans(customers, plan_changes)
[?2004l[?2004h>     result = np.full(n, None, object)
[?2004l[?2004h>     for i in range(n):
[?2004l[?2004h>         result[i] = signup.get(pts_cid[i])
[?2004l[?2004h> 
[?2004l[?2004h>     if len(plan_changes) == 0:
[?2004l[?2004h>         return pd.Series(result, index=points.index)
[?2004l[?2004h> 
[?2004l[?2004h>     pc_cid = plan_changes["customer_id"].to_numpy()
[?2004l[?2004h>     pc_changed = _seconds(plan_changes["changed_at"])
[?2004l[?2004h>     pc_new = plan_changes["new_plan"].to_numpy()
[?2004l[?2004h>     pc_loaded = _seconds(plan_changes["_loaded_at"])
[?2004l[?2004h> 
[?2004l[?2004h>     pc_groups = defaultdict(list)
[?2004l[?2004h>     for i in range(len(pc_cid)):
[?2004l[?2004h>         pc_groups[pc_cid[i]].append(i)
[?2004l[?2004h> 
[?2004l[?2004h>     pt_groups = defaultdict(list)
[?2004l[?2004h>     for i in range(len(pts_cid)):
[?2004l[?2004h>         pt_groups[pts_cid[i]].append(i)
[?2004l[?2004h> 
[?2004l[?2004h>     for cid, pt_idx in pt_groups.items():
[?2004l[?2004h>         if cid not in pc_groups:
[?2004l[?2004h>             continue
[?2004l[?2004h>         pci = np.array(pc_groups[cid], dtype=np.intp)
[?2004l[?2004h>         t = pts_t[pt_idx]
[?2004l[?2004h>         changed = pc_changed[pci]
[?2004l[?2004h>         new_plans = pc_new[pci]
[?2004l[?2004h>         loaded = pc_loaded[pci]
[?2004l[?2004h> 
[?2004l[?2004h>         visible = loaded[None, :] < t[:, None]
[?2004l[?2004h>         masked = np.where(visible, changed[None, :], np.iinfo(np.int64).min)
[?2004l[?2004h>         max_idx = masked.argmax(axis=1)
[?2004l[?2004h>         has = visible.any(axis=1)
[?2004l[?2004h>         for j, i in enumerate(pt_idx):
[?2004l[?2004h>             if has[j]:
[?2004l[?2004h>                 result[i] = new_plans[max_idx[j]]
[?2004l[?2004h> 
[?2004l[?2004h>     return pd.Series(result, index=points.index)
