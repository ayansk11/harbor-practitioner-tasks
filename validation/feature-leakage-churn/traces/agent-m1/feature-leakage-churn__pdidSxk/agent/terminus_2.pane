[?2004l     1	"""Feature queries of the live churn scoring service: a read-only copy of the service's `features` module.
     2	
     3	This copy is the contract between the live service and the offline pipeline in `churn/`. It is kept for reference:
     4	nothing in this repository imports or runs it, there is no warehouse connection here, and editing it changes nothing.
     5	
     6	How the service uses it. A scoring request names a customer and a moment: the 06:00 batch run (trigger `batch`), or
     7	the support desk when a ticket is opened (trigger `ticket`, at the ticket's `opened_at`). For each request the service
     8	runs every query in QUERIES once, at the moment of the request, against the warehouse tables as they stand at that
     9	moment, and takes the first column of the first row as the feature's value; a query that returns no row, or NULL,
    10	gives a null value. The service then scores the 11 values with the deployed model, if one is attached, and logs them
    11	with the request.
    12	
    13	Parameters of every query:
    14	    :customer_id     the request's customer
    15	    :now             the moment of the request (the `as_of` the scoring service records for it)
    16	    :app_minutes_7d  the product-analytics reading that came with the request, NULL when it came without one
    17	
    18	The warehouse is PostgreSQL. Timestamps are `timestamptz` and sessions run in UTC, so INTERVAL '7 days' is exactly
    19	7 x 86,400 seconds and EXTRACT(EPOCH FROM <interval>) is a number of seconds. The tables, and when their rows and
    20	values are committed: docs/WAREHOUSE.md.
    21	"""
    22	
    23	QUERIES = {
    24	    # orders in the 7 days before the request
    25	    "orders_7d": """
    26	        SELECT COUNT(*)
    27	        FROM orders
    28	        WHERE customer_id = :customer_id
    29	          AND ordered_at >= :now - INTERVAL '7 days'
    30	          AND ordered_at < :now
    31	    """,
    32	    # orders in the 30 days before the request
    33	    "orders_30d": """
    34	        SELECT COUNT(*)
    35	        FROM orders
    36	        WHERE customer_id = :customer_id
    37	          AND ordered_at >= :now - INTERVAL '30 days'
    38	          AND ordered_at < :now
    39	    """,
    40	    # amount of those orders, in cents (0 when there are none)
    41	    "spend_30d_cents": """
    42	        SELECT COALESCE(SUM(amount_cents), 0)
    43	        FROM orders
    44	        WHERE customer_id = :customer_id
    45	          AND ordered_at >= :now - INTERVAL '30 days'
    46	          AND ordered_at < :now
    47	    """,
    48	    # support tickets opened in the 30 days before the request
    49	    "tickets_30d": """
    50	        SELECT COUNT(*)
    51	        FROM tickets
    52	        WHERE customer_id = :customer_id
    53	          AND opened_at >= :now - INTERVAL '30 days'
    54	          AND opened_at < :now
    55	    """,
    56	    # days since the latest order before the request (NULL when there is none)
    57	    "days_since_last_order": """
    58	        SELECT EXTRACT(EPOCH FROM (:now - MAX(ordered_at))) / 86400.0
    59	        FROM orders
    60	        WHERE customer_id = :customer_id
    61	          AND ordered_at < :now
    62	    """,
    63	    # days since sign-up
    64	    "tenure_days": """
    65	        SELECT EXTRACT(EPOCH FROM (:now - signup_at)) / 86400.0
    66	        FROM customers
    67	        WHERE customer_id = :customer_id
    68	    """,
    69	    # account status of the latest snapshot (no row: NULL)
    70	    "status": """
    71	        SELECT status
    72	        FROM status_snapshots
    73	        WHERE customer_id = :customer_id
    74	        ORDER BY snapshot_date DESC
    75	        LIMIT 1
    76	    """,
    77	    # subscription plan on the customer record
    78	    "plan": """
    79	        SELECT plan
    80	        FROM customers
    81	        WHERE customer_id = :customer_id
    82	    """,
    83	    # days since the last login on the customer record (NULL when the record has none)
    84	    "days_since_last_login": """
    85	        SELECT EXTRACT(EPOCH FROM (:now - last_login_at)) / 86400.0
    86	        FROM customers
    87	        WHERE customer_id = :customer_id
    88	    """,
    89	    # app minutes over the last 7 days: the request's own reading, else the reading of the customer's latest earlier
    90	    # request that had one (NULL when there is none)
    91	    "app_minutes_7d": """
    92	        SELECT COALESCE(
    93	            CAST(:app_minutes_7d AS double precision),
    94	            (SELECT app_minutes_7d
    95	             FROM scoring_points
    96	             WHERE customer_id = :customer_id
    97	               AND as_of < :now
    98	               AND app_minutes_7d IS NOT NULL
    99	             ORDER BY as_of DESC
   100	             LIMIT 1))
   101	    """,
   102	    # smoothed churn rate of the customer's postcode district: (s + 20 p) / (n + 20), where p is the mean churned_30d
   103	    # of all label rows (0.05 when there are none), and n and s are the number of label rows of customers in the same
   104	    # district and the sum of their churned_30d
   105	    "te_district": """
   106	        WITH lab AS (
   107	            SELECT l.churned_30d, c.postcode_district
   108	            FROM labels l
   109	            JOIN customers c ON c.customer_id = l.customer_id
   110	        ),
   111	        own AS (
   112	            SELECT postcode_district
   113	            FROM customers
   114	            WHERE customer_id = :customer_id
   115	        )
   116	        SELECT (COALESCE(SUM(lab.churned_30d) FILTER (WHERE lab.postcode_district = own.postcode_district), 0)
   117	                + 20 * COALESCE(AVG(lab.churned_30d), 0.05))
   118	               / (COUNT(*) FILTER (WHERE lab.postcode_district = own.postcode_district) + 20)
   119	        FROM lab CROSS JOIN own
   120	    """,
   121	}
   122	
   123	FEATURES = list(QUERIES)
