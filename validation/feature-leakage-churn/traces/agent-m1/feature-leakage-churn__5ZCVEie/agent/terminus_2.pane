"""Activity features over trailing windows (orders, spend, tickets) and simple time-since features.
"""
import numpy as np
import pandas as pd


def activity_features(points, orders, tickets):
    """Per prediction: activity features using data committed before the prediction time."""
    pts_sorted = points.sort_values("as_of")
    out = pts_sorted[["customer_id", "as_of"]].copy()
    
    # Handle Orders
    orders_sorted = orders.sort_values("_loaded_at")
    # Time since last order: merge_asof on _loaded_at
    m_last = pd.merge_asof(
        pts_sorted[["customer_id", "as_of"]], 
        orders_sorted[["customer_id", "_loaded_at", "ordered_at"]],
        left_on="as_of", 
        right_on="_loaded_at", 
        by="customer_id",
        allow_exact_matches=False
    )
    # We need the last order based on ordered_at among those committed by as_of
    # The above only gives the last committed order. We actually need the max(ordered_at) among all committed.
    # Since orders are generally committed in order, this is usually fine, but for correctness:
    
    # Correctwrote 57909 rows x 12 columns to /app/output.parquet
