cat <<EOF > /app/churn/attributes.py
"""Customer attributes from the customer record (new in v3): the subscription plan.
"""
import pandas as pd
import numpy as np


def plan(points, customers, plan_changes):
    """The customer's subscription plan at the moment of prediction."""
    # Determine the initial plan for every customer
    # 1. From plan_changes: the oldest 'old_plan' for that customer
    # 2. From customers: the 'plan' if they have no changes
    
    sorted_changes = plan_changes.sort_values(["customer_id", "changed_at"])
    initial_plans = sorted_changes.groupby("customer_id")["old_plan"].first()
    
    # current_plan in customers acts as a fallback if no plan_changes exist
    fallback_plans = customers.set_index("customer_id")["plan"]
    
    # Use merge_asof to find the last committed plan change before as_of
    pts_sorted = points.sort_values("as_of")
    changes_sorted = plan_changes.sort_values("_loaded_at")
    
    m = pd.merge_asof(
        pts_sorted[["customer_id", "as_of"]], 
        changes_sorted[["customer_id", "_loaded_at", "new_plan"]],
        left_on="as_of", 
        right_on="_loaded_at", 
        by="customer_id",
        allow_exact_matches=False
    )
    
    # Result is new_plan if available, else the initial plan
    res = m["new_plan"].values
    cids = pts_sorted["customer_id"].values
    
    for i in range(len(res)):
        if pd.isna(res[i]):
            cid = cids[i]
            res[i] = initial_plans.get(cid, fallback_plans.get(cid))
            
    return pd.Series(res, index=pts_sorted.index).reindex(points.index)
EOF
