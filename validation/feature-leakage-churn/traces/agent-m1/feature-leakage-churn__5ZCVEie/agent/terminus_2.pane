cat <<EOF > /app/churn/status.py
"""Account status from the billing system's status snapshots, point in time.
"""
import pandas as pd


def latest_status(points, snapshots):
    """Status of the customer's latest snapshot committed before the prediction time (null if none)."""
    # Ensure sorted for merge_asof
    points = points.sort_values("as_of")
    snapshots = snapshots.sort_values("_loaded_at")
    
    m = pd.merge_asof(
        points[["customer_id", "as_of"]], 
        snapshots[["customer_id", "_loaded_at", "status"]],
        left_on="as_of", 
        right_on="_loaded_at", 
        by="customer_id",
        allow_exact_matches=False
    )
    return m.set_index(points.index)["status"].reindex(points.index)
