[261.781411, "i", "cat <<EOF > /app/churn/status.py\n\"\"\"Account status from the billing system's status snapshots, point in time.\n\"\"\"\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Status of the customer's latest snapshot committed before the prediction time (null if none).\"\"\"\n    out = pd.Series(index=points.index, dtype=\"string\")\n    for cid, group in points.groupby(\"customer_id\"):\n        cust_snaps = snapshots[snapshots[\"customer_id\"] == cid].sort_values(\"snapshot_date\")\n        for idx, row in group.iterrows():\n            t = row[\"as_of\"]\n            visible = cust_snaps[cust_snaps[\"_loaded_at\"] < t]\n            if not visible.empty:\n                out.iloc[idx] = visible.iloc[-1][\"status\"]\n    return out\nEOF\n"]
