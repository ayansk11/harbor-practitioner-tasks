[460.713085, "i", "cat <<EOF > /app/churn/status.py\n\"\"\"Account status from the billing system's status snapshots, point in time.\n\"\"\"\nimport pandas as pd\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Status of the customer's latest snapshot committed before the prediction time (null if none).\"\"\"\n    # Ensure sorted for merge_asof\n    points = points.sort_values(\"as_of\")\n    snapshots = snapshots.sort_values(\"_loaded_at\")\n    \n    m = pd.merge_asof(\n        points[[\"customer_id\", \"as_of\"]], \n        snapshots[[\"customer_id\", \"_loaded_at\", \"status\"]],\n        left_on=\"as_of\", \n        right_on=\"_loaded_at\", \n        by=\"customer_id\",\n        allow_exact_matches=False\n    )\n    return m.set_index(points.index)[\"status\"].reindex(points.index)\nEOF\n"]
[460.713128, "o", "cat <<EOF > /app/churn/status.py\r\n\"\"\"Account status from the billing system's status snapshots, point in"]
