[571.818336, "i", "cat <<EOF > /app/churn/status.py\n\"\"\"Account status from the billing system's status snapshots, point in time.\n\"\"\"\nimport pandas as pd\n\ndef latest_status(points, snapshots):\n    \"\"\"Status of the customer's latest snapshot committed before the prediction time (null if none).\"\"\"\n    pts_sorted = points.sort_values(\"as_of\")\n    snaps_sorted = snapshots.sort_values(\"_loaded_at\")\n    \n    m = pd.merge_asof(\n        pts_sorted[[\"customer_id\", \"as_of\"]], \n        snaps_sorted[[\"customer_id\", \"_loaded_at\", \"status\"]],\n        left_on=\"as_of\", \n        right_on=\"_loaded_at\", \n        by=\"customer_id\",\n        allow_exact_matches=False\n    )\n    return pd.Series(m[\"status\"].values, index=pts_sorted.index).reindex(points.index)\nEOF\n"]
