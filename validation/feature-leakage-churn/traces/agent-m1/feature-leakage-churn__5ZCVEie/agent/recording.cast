[263.185297, "o", "    out[\"spend_30d_cents\"] = 0\r\n\u001b[?2004l\r"]
[263.185324, "o", "\u001b[?2004h> "]
[263.18541, "o", "    out[\"tickets_30d\"] = 0\r\n\u001b[?2004l\r"]
[263.185428, "o", "\u001b[?2004h"]
[263.185452, "o", "> "]
[263.185575, "o", "    out[\"days_since_last_order\"] = np.nan\r\n\u001b[?2004l\r"]
[263.185602, "o", "\u001b[?2004h"]
[263.185623, "o", "> \r\n\u001b[?2004l\r"]
[263.185642, "o", "\u001b[?2004h> "]
[263.185828, "o", "    for cid, group in points.groupby(\"customer_id\"):\r\n\u001b[?2004l\r"]
[263.18586, "o", "\u001b[?2004h"]
[263.185881, "o", "> "]
[263.186172, "o", "        cust_orders = orders[orders[\"customer_id\"] == cid].sort_values(\"ordered_at\")\r\n\u001b[?2004l\r"]
[263.186199, "o", "\u001b[?2004h"]
[263.186218, "o", "> "]
[263.186504, "o", "        cust_tickets = tickets[tickets[\"customer_id\"] == cid].sort_values(\"opened_at\")\r\n\u001b[?2004l\r"]
[263.186532, "o", "\u001b[?2004h> "]
[263.186568, "o", "        \r\n\u001b[?2004l\r"]
[263.186599, "o", "\u001b[?2004h"]
[263.186608, "o", "> "]
[263.18676, "o", "        for idx, row in group.iterrows():\r\n\u001b[?2004l\r"]
[263.186786, "o", "\u001b[?2004h"]
[263.186809, "o", "> "]
[263.186899, "o", "            t = row[\"as_of\"]\r\n\u001b[?2004l\r"]
[263.186918, "o", "\u001b[?2004h"]
[263.186943, "o", "> "]
[263.18698, "o", "            \r\n\u001b[?2004l\r"]
[263.186998, "o", "\u001b[?2004h"]
[263.187009, "o", "> "]
[263.187254, "o", "            vis_orders = cust_orders[cust_orders[\"_loaded_at\"] < t]\r\n\u001b[?2004l\r"]
[263.187283, "o", "\u001b[?2004h> "]
[263.187497, "o", "            vis_tickets = cust_tickets[cust_tickets[\"_loaded_at\"] < t]\r\n\u001b[?2004l\r"]
[263.187519, "o", "\u001b[?2004h> "]
[263.187557, "o", "            \r\n\u001b[?2004l\r"]
[263.187579, "o", "\u001b[?2004h> "]
[263.187947, "o", "            o7 = vis_orders[(vis_orders[\"ordered_at\"] >= t - pd.Timedelta(days=7)) & (vis_orders[\"ordered_at\"] < t)]\r\n\u001b[?2004l\r"]
[263.187981, "o", "\u001b[?2004h"]
[263.188003, "o", "> "]
[263.188102, "o", "            out.at[idx, \"orders_7d\"] = len(o7)\r\n\u001b[?2004l\r"]
[263.188131, "o", "\u001b[?2004h"]
[263.188151, "o", "> "]
[263.188178, "o", "            \r\n\u001b[?2004l\r"]
[263.188214, "o", "\u001b[?2004h"]
[263.188232, "o", "> "]
[263.188558, "o", "            o30 = vis_orders[(vis_orders[\"ordered_at\"] >= t - pd.Timedelta(days=30)) & (vis_orders[\"ordered_at\"] < t)]\r\n\u001b[?2004l\r"]
[263.188579, "o", "\u001b[?2004h> "]
[263.188734, "o", "            out.at[idx, \"orders_30d\"] = len(o30)"]
[263.188752, "o", "\r\n"]
[263.18877, "o", "\u001b[?2004l\r\u001b[?2004h"]
[263.188789, "o", "> "]
[263.189008, "o", "            out.at[idx, \"spend_30d_cents\"] = o30[\"amount_cents\"].sum()\r\n\u001b[?2004l\r"]
[263.189036, "o", "\u001b[?2004h> "]
[263.189092, "o", "            \r\n\u001b[?2004l\r"]
[263.189116, "o", "\u001b[?2004h"]
[263.189136, "o", "> "]
[263.189592, "o", "            t30 = vis_tickets[(vis_tickets[\"opened_at\"] >= t - pd.Timedelta(days=30)) & (vis_tickets[\"opened_at\"] < t)]\r\n\u001b[?2004l\r"]
[263.189612, "o", "\u001b[?2004h"]
[263.189631, "o", "> "]
[263.189785, "o", "            out.at[idx, \"tickets_30d\"] = len(t30)\r\n\u001b[?2004l\r"]
[263.189809, "o", "\u001b[?2004h"]
[263.189827, "o", "> "]
[263.189864, "o", "            \r\n\u001b[?2004l\r"]
[263.189888, "o", "\u001b[?2004h> "]
[263.190145, "o", "            last_orders = vis_orders[vis_orders[\"ordered_at\"] < t]\r\n\u001b[?2004l\r"]
[263.190179, "o", "\u001b[?2004h> "]
[263.190308, "o", "            if not last_orders.empty:\r\n\u001b[?2004l\r"]
[263.190327, "o", "\u001b[?2004h"]
[263.190346, "o", "> "]
[263.190551, "o", "                last_date = last_orders[\"ordered_at\"].max()\r\n\u001b[?2004l\r"]
[263.190569, "o", "\u001b[?2004h"]
[263.190588, "o", "> "]
[263.19092, "o", "                out.at[idx, \"days_since_last_order\"] = (t - last_date).total_seconds() / 86400\r\n\u001b[?2004l\r"]
[263.190946, "o", "\u001b[?2004h> "]
[263.191014, "o", "                \r\n\u001b[?2004l\r"]
[263.191035, "o", "\u001b[?2004h"]
[263.191052, "o", "> "]
[263.191103, "o", "    return out\r\n\u001b[?2004l\r"]
[263.191126, "o", "\u001b[?2004h"]
[263.191146, "o", "> \r\n\u001b[?2004l\r"]
[263.191169, "o", "\u001b[?2004h"]
[263.191185, "o", "> \r\n\u001b[?2004l\r"]
[263.191203, "o", "\u001b[?2004h"]
[263.191222, "o", "> "]
[263.19134, "o", "def tenure_days(points, customers):\r\n\u001b[?2004l\r"]
[263.19136, "o", "\u001b[?2004h"]
[263.191378, "o", "> "]
[263.19168, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[263.191706, "o", "\u001b[?2004h> "]
[263.191952, "o", "    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n\u001b[?2004l\r"]
[263.191984, "o", "\u001b[?2004h"]
[263.192003, "o", "> "]
[263.192022, "o", "EOF\r\n\u001b[?2004l\r"]
[263.194504, "o", "\u001b[?2004hroot@44f3b013-1907-4734-b87d-e77db71013da:/app# "]
[263.517953, "i", "cat <<EOF > /app/churn/build_features.py\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\nimport argparse\nimport os\n\nfrom churn.attributes import plan\nfrom churn.encoding import district_encoding\nfrom churn.extract import load_extract\nfrom churn.impute import fill_app_minutes\nfrom churn.status import latest_status\nfrom churn.windows import activity_features, tenure_days\n\nFEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\n                   \"tenure_days\", \"status\", \"plan\", \"app_minutes_7d\", \"te_district\"]\n\n\ndef build(data_dir):\n    t = load_extract(data_dir)\n    points = t[\"scoring_points\"].reset_index(drop=True)\n    feats = activity_features(points, t[\"orders\"], t[\"tickets\"])\n    feats[\"tenure_days\"] = tenure_days(points, t[\"customers\"])\n    feats[\"status\"] = latest_status(points, t[\"status_snapshots\"])\n    feats[\"plan\"] = plan(points, t[\"customers\"], t[\"plan_changes\"])\n    feats[\"app_minutes_7d\"] = fill"]
[263.517988, "i", "_app_minutes(points)\n    feats[\"te_district\"] = district_encoding(points, t[\"labels\"], t[\"customers\"])\n    return feats[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    a = ap.parse_args()\n    feats = build(a.data)\n    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)\n    feats.to_parquet(a.out, index=False)\n    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {a.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
