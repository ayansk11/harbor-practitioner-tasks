[198.553414, "i", "cat <<EOF > /app/churn/attributes.py\n\"\"\"Customer attributes from the customer record (new in v3): the subscription plan.\n\"\"\"\nimport pandas as pd\nimport numpy as np\n\n\ndef plan(points, customers, plan_changes):\n    \"\"\"The customer's subscription plan at the moment of prediction.\"\"\"\n    out = pd.Series(index=points.index, dtype=\"string\")\n    \n    # Get initial plans\n    # If plan_changes exist, the first old_plan is the sign-up plan.\n    # Otherwise, the current plan in customers is the sign-up plan.\n    initial_plans = {}\n    for cid, group in plan_changes.groupby(\"customer_id\"):\n        initial_plans[cid] = group.sort_values(\"changed_at\").iloc[0][\"old_plan\"]\n    \n    cust_current_plans = customers.set_index(\"customer_id\")[\"plan\"]\n    \n    # Group points by customer to avoid repeated lookups\n    for cid, group in points.groupby(\"customer_id\"):\n        # Initial plan for this customer\n        init_p = initial_plans.get(cid, cust_current_plans.get(cid))\n        \n        # Plan changes for this customer, sorted by"]
[198.553456, "i", " commit time\n        changes = plan_changes[plan_changes[\"customer_id\"] == cid].sort_values(\"_loaded_at\")\n        \n        for idx, row in group.iterrows():\n            t = row[\"as_of\"]\n            # Find the latest change committed before t\n            visible = changes[changes[\"_loaded_at\"] < t]\n            if not visible.empty:\n                out.iloc[idx] = visible.iloc[-1][\"new_plan\"]\n            else:\n                out.iloc[idx] = init_p\n                \n    return out\nEOF\n"]
