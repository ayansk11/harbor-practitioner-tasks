[69.733345, "o", "python3 -c \"import pandas as pd; df = pd.read_csv('data/customers.csv'); df['signup_at'] = pd.to_datetime(df['signup_at']); df['_updated_at'] = pd.to_datetime(df['_updated_at']); pts = pd.read_csv('data/scoring_points.csv'); pts['as_of'] = pd.to_datetime(pts['as_of']); print(pts.merge(df[['customer_id', '_updated_at']], on='customer_id').query('_updated_at >= as_of').shape)\"\r\n\u001b[?2004l\r"]
