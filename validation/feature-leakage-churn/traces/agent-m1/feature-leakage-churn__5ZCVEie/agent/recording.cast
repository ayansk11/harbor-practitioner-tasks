[263.183197, "i", "cat <<EOF > /app/churn/windows.py\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time-since features.\n\"\"\"\nimport numpy as np\nimport pandas as pd\n\n\ndef activity_features(points, orders, tickets):\n    \"\"\"Per prediction: activity features using data committed before the prediction time.\"\"\"\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n    out[\"orders_7d\"] = 0\n    out[\"orders_30d\"] = 0\n    out[\"spend_30d_cents\"] = 0\n    out[\"tickets_30d\"] = 0\n    out[\"days_since_last_order\"] = np.nan\n\n    for cid, group in points.groupby(\"customer_id\"):\n        cust_orders = orders[orders[\"customer_id\"] == cid].sort_values(\"ordered_at\")\n        cust_tickets = tickets[tickets[\"customer_id\"] == cid].sort_values(\"opened_at\")\n        \n        for idx, row in group.iterrows():\n            t = row[\"as_of\"]\n            \n            vis_orders = cust_orders[cust_orders[\"_loaded_at\"] < t]\n            vis_tickets = cust_tickets[cust_tickets[\"_loaded_at\"] < t]\n            \n            o7 = vis_orders[(vis"]
[263.183298, "i", "_orders[\"ordered_at\"] >= t - pd.Timedelta(days=7)) & (vis_orders[\"ordered_at\"] < t)]\n            out.at[idx, \"orders_7d\"] = len(o7)\n            \n            o30 = vis_orders[(vis_orders[\"ordered_at\"] >= t - pd.Timedelta(days=30)) & (vis_orders[\"ordered_at\"] < t)]\n            out.at[idx, \"orders_30d\"] = len(o30)\n            out.at[idx, \"spend_30d_cents\"] = o30[\"amount_cents\"].sum()\n            \n            t30 = vis_tickets[(vis_tickets[\"opened_at\"] >= t - pd.Timedelta(days=30)) & (vis_tickets[\"opened_at\"] < t)]\n            out.at[idx, \"tickets_30d\"] = len(t30)\n            \n            last_orders = vis_orders[vis_orders[\"ordered_at\"] < t]\n            if not last_orders.empty:\n                last_date = last_orders[\"ordered_at\"].max()\n                out.at[idx, \"days_since_last_order\"] = (t - last_date).total_seconds() / 86400\n                \n    return out\n\n\ndef tenure_days(points, customers):\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\n    return (points[\"as_of\""]
[263.183332, "i", "] - signup).dt.total_seconds() / 86400\nEOF\n"]
