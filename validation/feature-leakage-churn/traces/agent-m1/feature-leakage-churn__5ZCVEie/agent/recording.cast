[657.599793, "i", "cat <<EOF > /app/churn/windows.py\n\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time-since features.\n\"\"\"\nimport numpy as np\nimport pandas as pd\n\ndef activity_features(points, orders, tickets):\n    \"\"\"Per prediction: activity features using data committed before the prediction time.\"\"\"\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n    res_orders_7 = np.zeros(len(points))\n    res_orders_30 = np.zeros(len(points))\n    res_spend_30 = np.zeros(len(points))\n    res_days_last = np.full(len(points), np.nan)\n    res_tickets_30 = np.zeros(len(points))\n\n    # Pre-convert timestamps to unix seconds (int64) for numpy speed\n    def to_sec(series):\n        return series.values.astype('datetime64[s]').astype(np.int64)\n\n    orders = orders.sort_values([\"customer_id\", \"_loaded_at\"])\n    tickets = tickets.sort_values([\"customer_id\", \"_loaded_at\"])\n    \n    # Dictionary of numpy arrays per customer\n    cust_orders = {}\n    for cid, df in orders.groupby(\"customer_id\"):\n        cust_orders[cid]"]
[657.601068, "i", " = (to_sec(df[\"_loaded_at\"]), to_sec(df[\"ordered_at\"]), df[\"amount_cents\"].values)\n\n    cust_tickets = {}\n    for cid, df in tickets.groupby(\"customer_id\"):\n        cust_tickets[cid] = (to_sec(df[\"_loaded_at\"]), to_sec(df[\"opened_at\"]))\n\n    # Points timestamps\n    pts_as_of_sec = to_sec(points[\"as_of\"])\n    pts_as_of_dt = points[\"as_of\"].values\n    cids = points[\"customer_id\"].values\n\n    for idx in range(len(points)):\n        cid = cids[idx]\n        t_sec = pts_as_of_sec[idx]\n        t_dt = pts_as_of_dt[idx]\n        \n        if cid in cust_orders:\n            loaded, at, amt = cust_orders[cid]\n            # Committed before t (using numpy boolean indexing)\n            vis_mask = loaded < t_dt.astype('datetime64[s]')\n            if np.any(vis_mask):\n                v_at = at[vis_mask]\n                v_amt = amt[vis_mask]\n                \n                # Window [t - W, t)\n                m7 = (v_at >= t_sec - 7 * 86400) & (v_at < t_sec)\n                res_orders_7[idx] = np.sum(m7)\n                \n      "]
