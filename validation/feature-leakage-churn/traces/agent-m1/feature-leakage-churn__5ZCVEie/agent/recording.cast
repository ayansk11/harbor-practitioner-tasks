[153.766964, "o", "\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time-since features.\r\n\r\nPoint in time (INC-2041): a window is [t - W days, t) on the exact event timestamps, so an event stamped at or after\r\nthe prediction time is never counted and nothing later in the day leaks in.\r\n\"\"\"\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\nSTRIDE = 10 ** 10  # composite key customer_id * STRIDE + epoch seconds (seconds stay below 1e10 until 2286)\r\n\r\n\r\ndef _seconds(ts):\r\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\r\n\r\ndef _window(points, events, ts_col, days, amount_col=None):\r\n    \"\"\"Per prediction: number (and amount sum) of the customer's events with t - days <= ts < t.\"\"\"\r\n    ev_key = events[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(events[ts_col])\r\n    order = np.argsort(ev_key, kind=\"stable\")\r\n    ev_key = ev_key[order]\r\n    cid = points[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE\r\n    t = _seconds(p"]
[153.766976, "o", "oints[\"as_of\"])\r\n    hi = np.searchsorted(ev_key, cid + t, side=\"left\")\r\n    lo = np.searchsorted(ev_key, cid + t - days * 86400, side=\"left\")\r\n    count = hi - lo\r\n    if amount_col is None:\r\n        return count, None\r\n    pref = np.concatenate([[0], np.cumsum(events[amount_col].to_numpy(dtype=\"int64\")[order])])\r\n"]
[153.767046, "o", "    return count, pref[hi] - pref[lo]\r\n\r\n\r\ndef activity_features(points, orders, tickets):\r\n    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n    out[\"orders_7d\"], _ = _window(points, orders, \"ordered_at\", 7)\r\n    out[\"orders_30d\"], out[\"spend_30d_cents\"] = _window(points, orders, \"ordered_at\", 30, \"amount_cents\")\r\n    out[\"tickets_30d\"], _ = _window(points, tickets, \"opened_at\", 30)\r\n\r\n    # time since the last order strictly before the prediction"]
[153.767078, "o", "\r\n    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n    last = pd.merge_asof(left, o, left_on=\"as_of\", right_on=\"ordered_at\", by=\"customer_id\",\r\n                         allow_exact_matches=False).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    return out\r\n\r\n\r\ndef tenure_days(points, customers):\r\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n"]
[153.767354, "o", "\u001b[?2004h"]
[153.767394, "o", "root@44f3b013-1907-4734-b87d-e77db71013da:/app# "]
[154.130871, "i", "cat /app/churn/status.py\n"]
[154.131142, "o", "cat /app/churn/status.py\r\n\u001b[?2004l\r"]
[154.132958, "o", "\"\"\"Account status from the billing system's status snapshots, point in time (INC-2041).\r\n\r\nA snapshot dated D records the status at the end of day D, so a prediction at t may only use snapshots dated before\r\ndate(t).\r\n\"\"\"\r\nimport pandas as pd\r\n\r\n\r\ndef latest_status(points, snapshots):\r\n    \"\"\"Status of the customer's latest snapshot dated before the prediction's UTC date (null if none).\"\"\"\r\n    left = points[[\"customer_id\"]].assign(day=points[\"as_of\"].dt.floor(\"D\")).reset_index()\r\n    left = left.sort_values(\"day\", kind=\"mergesort\")\r\n    snaps = snapshots.sort_values(\"snapshot_date\", kind=\"mergesort\")[[\"customer_id\", \"snapshot_date\", \"status\"]]\r\n    snaps = snaps.assign(snapshot_date=snaps[\"snapshot_date\"].astype(left[\"day\"].dtype))\r\n    m = pd.merge_asof(left, snaps, left_on=\"day\", right_on=\"snapshot_date\", by=\"customer_id\",\r\n                      allow_exact_matches=False)\r\n    return m.set_index(\"index\")[\"status\"].reindex(points.index)\r\n"]
[154.133325, "o", "\u001b[?2004h"]
[154.133371, "o", "root@44f3b013-1907-4734-b87d-e77db71013da:/app# "]
[154.498076, "i", "cat /app/churn/encoding.py\n"]
[154.498192, "o", "cat /app/churn/encoding.py\r\n\u001b[?2004l\r"]
[154.499259, "o", "\"\"\"Target encoding of high-cardinality categoricals, point in time (INC-2041).\r\n\r\nA label row records whether the customer churned in the 30 days after its own prediction, so its outcome is final only\r\nonce that window has closed (as_of + 30 days). A prediction at t uses only labels whose window closed before t, for the\r\ndistrict counts and for the prior alike; its own label and every later one are never seen.\r\n\"\"\"\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\nPRIOR_WEIGHT = 20\r\nDEFAULT_PRIOR = 0.05\r\nLABEL_WINDOW_DAYS = 30\r\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\nSTRIDE = 10 ** 10\r\n\r\n\r\ndef _seconds(ts):\r\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\r\n\r\ndef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n    \"\"\"Smoothed churn rate of the customer's postcode district, from labels whose window closed before t.\"\"\"\r\n    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n    lab_d = labels[\"customer_id\"].map(district)\r\n    pt_d = points[\"customer_"]
[154.499292, "o", "id\"].map(district)\r\n    codes, _ = pd.factorize(pd.concat([lab_d, pt_d], ignore_index=True))\r\n    lab_code, pt_code = codes[:len(labels)].astype(\"int64\"), codes[len(labels):].astype(\"int64\")\r\n    closed = _seconds(labels[\"as_of\"]) + LABEL_WINDOW_DAYS * 86400\r\n    y = labels[\"churned_30d\"].to_numpy(dtype=\"int64\")\r\n    t = _seconds(points[\"as_of\"])\r\n\r\n    order = np.argsort(closed, kind=\"stable\")\r\n    ycum = np.concatenate([[0], np.cumsum(y[order])])\r\n    N = np.searchsorted(closed[order], t, side=\"left\")\r\n    S = ycum[N]\r\n    prior = np.full(len(t), DEFAULT_PRIOR)\r\n    has = N > 0\r\n    prior[has] = S[has] / N[has]\r\n\r\n    key = lab_code * STRIDE + closed\r\n    o2 = np.argsort(key, kind=\"stable\")\r\n    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])\r\n    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side=\"left\")\r\n    lo = np.searchsorted(key[o2], pt_code * STRIDE, side=\"left\")\r\n    n, s = hi - lo, ycum2[hi] - ycum2[lo]\r\n    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\r\n"]
[154.499462, "o", "\u001b[?2004h"]
[154.499474, "o", "root@44f3b013-1907-4734-b87d-e77db71013da:/app# "]
[154.868188, "i", "cat /app/churn/attributes.py\n"]
[154.868436, "o", "cat /app/churn/attributes.py\r\n\u001b[?2004l\r"]
[154.87015, "o", "\"\"\"Customer attributes from the customer record (new in v3): the subscription plan and the days since the last login.\r\n\r\nPoint in time: a last login at or after the prediction time is ignored (the feature is null then), so the feature\r\nnever looks ahead of t.\r\n\"\"\"\r\n\r\n\r\ndef plan(points, customers):\r\n    \"\"\"The customer's subscription plan.\"\"\"\r\n    return points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"])\r\n\r\n\r\ndef days_since_last_login(points, customers):\r\n    \"\"\"t minus the customer's last login, in days; null when the record has no login before t.\"\"\"\r\n    last = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"last_login_at\"])\r\n    days = (points[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    return days.where(last < points[\"as_of\"])\r\n"]
[154.87038, "o", "\u001b[?2004hroot@44f3b013-1907-4734-b87d-e77db71013da:/app# "]
[155.241621, "i", "cat /app/churn/build_features.py\n"]
[155.241925, "o", "cat /app/churn/build_features.py\r\n"]
[155.241939, "o", "\u001b[?2004l\r"]
[155.243987, "o", "\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\r\nimport argparse\r\nimport os\r\n\r\nfrom churn.attributes import days_since_last_login, plan\r\nfrom churn.encoding import district_encoding\r\nfrom churn.extract import load_extract\r\nfrom churn.impute import fill_app_minutes\r\nfrom churn.status import latest_status\r\nfrom churn.windows import activity_features, tenure_days\r\n\r\nFEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\r\n                   \"tenure_days\", \"status\", \"plan\", \"days_since_last_login\", \"app_minutes_7d\", \"te_district\"]\r\n\r\n\r\ndef build(data_dir):\r\n    t = load_extract(data_dir)\r\n    points = t[\"scoring_points\"].reset_index(drop=True)\r\n    feats = activity_features(points, t[\"orders\"], t[\"tickets\"])\r\n    feats[\"tenure_days\"] = tenure_days(points, t[\"customers\"])\r\n    feats[\"status\"] = latest_status(points, t[\"status_snapshots\"])\r\n    feats[\"plan\"] = plan(points, t[\"customers\"])\r\n    feats[\"days_since_la"]
[155.24404, "o", "st_login\"] = days_since_last_login(points, t[\"customers\"])\r\n    feats[\"app_minutes_7d\"] = fill_app_minutes(points)\r\n    feats[\"te_district\"] = district_encoding(points, t[\"labels\"], t[\"customers\"])\r\n    return feats[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\r\n\r\ndef main():\r\n    ap = argparse.ArgumentParser(description=__doc__)\r\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n    a = ap.parse_args()\r\n    feats = build(a.data)\r\n    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)\r\n    feats.to_parquet(a.out, index=False)\r\n    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {a.out}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[155.244253, "o", "\u001b[?2004h"]
