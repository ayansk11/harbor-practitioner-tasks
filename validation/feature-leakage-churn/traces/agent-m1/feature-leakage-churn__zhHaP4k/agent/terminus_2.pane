[?2004l[?2004h> +        te_district = _district_encoding_point(pt, labels, customers_full)
[?2004l[?2004h> +
[?2004l[?2004h> +        rows.append({
[?2004l[?2004h> +            "customer_id": pt["customer_id"],
[?2004l[?2004h> +            "as_of": as_of,
[?2004l[?2004h> +            "orders_7d": int(act["orders_7d"].iloc[0]),
[?2004l[?2004h> +            "orders_30d": int(act["orders_30d"].iloc[0]),
[?2004l[?2004h> +            "spend_30d_cents": int(act["spend_30d_cents"].iloc[0]),
[?2004l[?2004h> +            "tickets_30d": int(act["tickets_30d"].iloc[0]),
