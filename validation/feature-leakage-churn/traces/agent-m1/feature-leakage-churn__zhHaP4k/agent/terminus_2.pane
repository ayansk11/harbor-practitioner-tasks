[?2004l[?2004h> +def main():
[?2004l[?2004h> +    ap = argparse.ArgumentParser(description=__doc__)
[?2004l[?2004h> +    ap.add_argument("--data", required=True, help="folder with the extract CSVs")
[?2004l[?2004h> +    ap.add_argument("--out", required=True, help="output parquet file")
[?2004l[?2004h> +    args = ap.parse_args()
