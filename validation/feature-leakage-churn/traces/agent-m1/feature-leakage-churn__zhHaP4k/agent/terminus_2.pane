[?2004l[?2004h> +    points = tables["scoring_points"].reset_index(drop=True)
[?2004l[?2004h> +
[?2004l[?2004h> +    customers_full = tables["customers"]
[?2004l[?2004h> +    labels_full = tables["labels"]
[?2004l[?2004h> +    orders_full = tables["orders"]
