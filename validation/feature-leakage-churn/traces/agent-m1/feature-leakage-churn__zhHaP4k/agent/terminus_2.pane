[?2004l[?2004h> +
[?2004l[?2004h> +def _filter_by_loaded(df: pd.DataFrame, as_of: pd.Timestamp) -> pd.DataFrame:
[?2004l[?2004h> +    """Return rows whose load timestamp is ≤ ``as_of``.
[?2004l[?2004h> +
[?2004l[?2004h> +    Most tables use ``_loaded_at``; the customers table uses ``_updated_at``.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    load_col = "_loaded_at" if "_loaded_at" in df.columns else "_updated_at"
[?2004l[?2004h> +    return df[df[load_col] <= as_of]
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def _district_encoding_point(point: pd.Series, labels: pd.DataFrame, customers: pd.DataFrame) -> float:
[?2004l[?2004h> +    """Compute the ``te_district`` encoding for a single scoring point.
[?2004l[?2004h> +
[?2004l[?2004h> +    Mirrors ``live.features.district_encoding`` but operates on a pre‑filtered ``labels`` DataFrame.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    cust_row = customers[customers["customer_id"] == point["customer_id"]]
[?2004l[?2004h> +    if cust_row.empty:
[?2004l[?2004h> +        return np.nan
[?2004l[?2004h> +    district = cust_row.iloc[0]["postcode_district"]
[?2004l[?2004h> +
[?2004l[?2004h> +    # Labels whose 30‑day window closed before the point's as_of
[?2004l[?2004h> +    closed = labels["as_of"] + pd.Timedelta(days=LABEL_WINDOW_DAYS)
[?2004l[?2004h> +    mask = closed < point["as_of"]
[?2004l[?2004h> +    lab_closed = labels[mask]
[?2004l[?2004h> +
[?2004l[?2004h> +    if len(lab_closed) == 0:
[?2004l[?2004h> +        prior = DEFAULT_PRIOR
[?2004l[?2004h> +    else:
[?2004l[?2004h> +        prior = lab_closed["churned_30d"].mean()
[?2004l[?2004h> +
[?2004l[?2004h> +    if pd.isna(district):
[?2004l[?2004h> +        n = 0
[?2004l[?2004h> +        s = 0
[?2004l[?2004h> +    else:
[?2004l[?2004h> +        cust_district = customers.set_index("customer_id")["postcode_district"]
[?2004l[?2004h> +        lab_district = lab_closed["customer_id"].map(cust_district)
[?2004l[?2004h> +        district_mask = lab_district == district
[?2004l[?2004h> +        n = district_mask.sum()
[?2004l[?2004h> +        s = lab_closed.loc[district_mask, "churned_30d"].sum()
[?2004l[?2004h> +
[?2004l[?2004h> +    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def build(data_dir: str) -> pd.DataFrame:
[?2004l[?2004h> +    """Build the feature table for the given extract directory.
[?2004l[?2004h> +
[?2004l[?2004h> +    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    tables = load_extract(data_dir)
[?2004l[?2004h> +    points = tables["scoring_points"].reset_index(drop=True)
[?2004l[?2004h> +
[?2004l[?2004h> +    customers_full = tables["customers"]
[?2004l[?2004h> +    labels_full = tables["labels"]
[?2004l[?2004h> +    orders_full = tables["orders"]
[?2004l[?2004h> +    tickets_full = tables["tickets"]
[?2004l[?2004h> +    status_full = tables["status_snapshots"]
[?2004l[?2004h> +
[?2004l[?2004h> +    rows: List[dict] = []
[?2004l[?2004h> +    for _, pt in points.iterrows():
[?2004l[?2004h> +        as_of = pt["as_of"]
[?2004l[?2004h> +
[?2004l[?2004h> +        orders = _filter_by_loaded(orders_full, as_of)
[?2004l[?2004h> +        tickets = _filter_by_loaded(tickets_full, as_of)
[?2004l[?2004h> +        status_snapshots = _filter_by_loaded(status_full, as_of)
[?2004l[?2004h> +        customers = _filter_by_loaded(customers_full, as_of)
[?2004l[?2004h> +        labels = _filter_by_loaded(labels_full, as_of)
[?2004l[?2004h> +
[?2004l[?2004h> +        # Activity windows – reuse vectorised helper on a single‑row DataFrame
[?2004l[?2004h> +        single_point = pt.to_frame().T
[?2004l[?2004h> +        act = activity_features(single_point, orders, tickets)
[?2004l[?2004h> +        tenure = tenure_days(single_point, customers)
[?2004l[?2004h> +        status = latest_status(single_point, status_snapshots)
[?2004l[?2004h> +
[?2004l[?2004h> +        plan_val = plan(single_point, customers).iloc[0]
[?2004l[?2004h> +        dlast_login = days_since_last_login(single_point, customers).iloc[0]
[?2004l[?2004h> +        te_district = _district_encoding_point(pt, labels, customers_full)
[?2004l[?2004h> +
[?2004l[?2004h> +        rows.append({
[?2004l[?2004h> +            "customer_id": pt["customer_id"],
[?2004l[?2004h> +            "as_of": as_of,
[?2004l[?2004h> +            "orders_7d": int(act["orders_7d"].iloc[0]),
[?2004l[?2004h> +            "orders_30d": int(act["orders_30d"].iloc[0]),
[?2004l[?2004h> +            "spend_30d_cents": int(act["spend_30d_cents"].iloc[0]),
[?2004l[?2004h> +            "tickets_30d": int(act["tickets_30d"].iloc[0]),
[?2004l[?2004h> +            "days_since_last_order": act["days_since_last_order"].iloc[0],
[?2004l[?2004h> +            "tenure_days": float(tenure.iloc[0]),
[?2004l[?2004h> +            "status": status.iloc[0] if not pd.isna(status.iloc[0]) else np.nan,
[?2004l[?2004h> +            "plan": plan_val,
[?2004l[?2004h> +            "days_since_last_login": dlast_login,
[?2004l[?2004h> +            "app_minutes_7d": pt.get("app_minutes_7d", np.nan),
[?2004l[?2004h> +            "te_district": float(te_district),
[?2004l[?2004h> +        })
[?2004l[?2004h> +
[?2004l[?2004h> +    df = pd.DataFrame(rows)
[?2004l[?2004h> +    df["app_minutes_7d"] = fill_app_minutes(df)
[?2004l[?2004h> +    return df[["customer_id", "as_of"] + FEATURE_COLUMNS]
