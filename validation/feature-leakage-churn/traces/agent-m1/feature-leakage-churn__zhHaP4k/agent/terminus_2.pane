[?2004l[?2004h> +        as_of = pt["as_of"]
[?2004l[?2004h> +
[?2004l[?2004h> +        orders = _filter_by_loaded(orders_full, as_of)
[?2004l[?2004h> +        tickets = _filter_by_loaded(tickets_full, as_of)
[?2004l[?2004h> +        status_snapshots = _filter_by_loaded(status_full, as_of)
[?2004l[?2004h> +        customers = _filter_by_loaded(customers_full, as_of)
[?2004l[?2004h> +        labels = _filter_by_loaded(labels_full, as_of)
[?2004l[?2004h> +
[?2004l[?2004h> +        # Activity windows – reuse vectorised helper on a single‑row DataFrame
[?2004l[?2004h> +        single_point = pt.to_frame().T
[?2004l[?2004h> +        act = activity_features(single_point, orders, tickets)
[?2004l[?2004h> +        tenure = tenure_days(single_point, customers)
[?2004l[?2004h> +        status = latest_status(single_point, status_snapshots)
[?2004l[?2004h> +
[?2004l[?2004h> +        plan_val = plan(single_point, customers).iloc[0]
