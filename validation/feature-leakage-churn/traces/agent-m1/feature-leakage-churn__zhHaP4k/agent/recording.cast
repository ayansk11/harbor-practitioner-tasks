[217.044378, "o", "\u001b[?2004h> "]
[217.044714, "o", "+    \"\"\"Build the feature table for the given extract directory.\r\n\u001b[?2004l\r"]
[217.044735, "o", "\u001b[?2004h> "]
[217.04476, "o", "+\r\n\u001b[?2004l\r"]
[217.044789, "o", "\u001b[?2004h"]
[217.044816, "o", "> "]
[217.045287, "o", "+    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n\u001b[?2004l\r"]
[217.045319, "o", "\u001b[?2004h"]
[217.045361, "o", "> "]
[217.045391, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[217.04542, "o", "\u001b[?2004h> "]
[217.045607, "o", "+    tables = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[217.045634, "o", "\u001b[?2004h> "]
[217.046005, "o", "+    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[217.046042, "o", "\u001b[?2004h> +\r\n"]
[217.046075, "o", "\u001b[?2004l\r\u001b[?2004h"]
[217.046116, "o", "> "]
[217.046302, "o", "+    customers_full = tables[\"customers\"]\r\n\u001b[?2004l\r"]
[217.046335, "o", "\u001b[?2004h"]
[217.046363, "o", "> "]
[217.04653, "o", "+    labels_full = tables[\"labels\"]\r\n\u001b[?2004l\r"]
[217.046562, "o", "\u001b[?2004h"]
[217.046583, "o", "> "]
[217.046749, "o", "+    orders_full = tables[\"orders\"]\r\n\u001b[?2004l\r"]
[217.046782, "o", "\u001b[?2004h"]
[217.046807, "o", "> "]
[217.047, "o", "+    tickets_full = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[217.047031, "o", "\u001b[?2004h> "]
[217.047264, "o", "+    status_full = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[217.047292, "o", "\u001b[?2004h"]
[217.047313, "o", "> +\r\n"]
[217.047334, "o", "\u001b[?2004l\r"]
[217.047354, "o", "\u001b[?2004h"]
[217.047379, "o", "> "]
[217.047504, "o", "+    rows: List[dict] = []\r\n\u001b[?2004l\r"]
[217.047533, "o", "\u001b[?2004h"]
[217.047553, "o", "> "]
[217.047733, "o", "+    for _, pt in points.iterrows():\r\n\u001b[?2004l\r"]
[217.04776, "o", "\u001b[?2004h"]
[217.04778, "o", "> "]
[217.047919, "o", "+        as_of = pt[\"as_of\"]\r\n\u001b[?2004l\r"]
[217.047968, "o", "\u001b[?2004h> "]
[217.047988, "o", "+\r\n\u001b[?2004l\r"]
[217.048016, "o", "\u001b[?2004h"]
[217.048039, "o", "> "]
[217.048307, "o", "+        orders = _filter_by_loaded(orders_full, as_of)\r\n\u001b[?2004l\r"]
[217.048339, "o", "\u001b[?2004h> "]
[217.048631, "o", "+        tickets = _filter_by_loaded(tickets_full, as_of)\r\n\u001b[?2004l\r"]
[217.048659, "o", "\u001b[?2004h"]
[217.04868, "o", "> "]
[217.049004, "o", "+        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n\u001b[?2004l\r"]
[217.049034, "o", "\u001b[?2004h"]
[217.049055, "o", "> "]
[217.049346, "o", "+        customers = _filter_by_loaded(customers_full, as_of)\r\n\u001b[?2004l\r"]
[217.049362, "o", "\u001b[?2004h"]
[217.049383, "o", "> "]
[217.049656, "o", "+        labels = _filter_by_loaded(labels_full, as_of)\r\n\u001b[?2004l\r"]
[217.049686, "o", "\u001b[?2004h"]
[217.049719, "o", "> +\r\n"]
[217.049742, "o", "\u001b[?2004l\r\u001b[?2004h"]
[217.049767, "o", "> "]
[217.050182, "o", "+        # Activity windows – reuse vectorised helper on a single‑row DataFrame\r\n\u001b[?2004l\r"]
[217.050211, "o", "\u001b[?2004h"]
[217.050244, "o", "> "]
[217.050471, "o", "+        single_point = pt.to_frame().T\r\n\u001b[?2004l\r\u001b[?2004h"]
[217.051111, "o", "> +        act = activity_features(single_point, orders, tickets)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.051292, "o", "+        tenure = tenure_days(single_point, customers)\r\n\u001b[?2004l\r"]
[217.053584, "o", "\u001b[?2004h> +        status = latest_status(single_point, status_snapshots)\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +        plan_val = plan(single_point, customers).iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> +        dlast_login = days_since_last_login(single_point, customers).iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> +        te_district = _district_encoding_point(pt, labels, customers_full)\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +        rows.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.053882, "o", "+            \"customer_id\": pt[\"customer_id\"],\r\n\u001b[?2004l\r"]
[217.053956, "o", "\u001b[?2004h> "]
[217.054063, "o", "+            \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[217.054103, "o", "\u001b[?2004h> "]
[217.054383, "o", "+            \"orders_7d\": int(act[\"orders_7d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[217.054425, "o", "\u001b[?2004h> "]
[217.054723, "o", "+            \"orders_30d\": int(act[\"orders_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[217.05479, "o", "\u001b[?2004h> "]
[217.055107, "o", "+            \"spend_30d_cents\": int(act[\"spend_30d_cents\"].iloc[0]),\r\n\u001b[?2004l\r"]
[217.055149, "o", "\u001b[?2004h> "]
[217.055448, "o", "+            \"tickets_30d\": int(act[\"tickets_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[217.055487, "o", "\u001b[?2004h> "]
[217.055858, "o", "+            \"days_since_last_order\": act[\"days_since_last_order\"].iloc[0],\r\n\u001b[?2004l\r"]
[217.055932, "o", "\u001b[?2004h> "]
[217.056175, "o", "+            \"tenure_days\": float(tenure.iloc[0]),\r\n\u001b[?2004l\r"]
[217.056226, "o", "\u001b[?2004h> "]
[217.056622, "o", "+            \"status\": status.iloc[0] if not pd.isna(status.iloc[0]) else np.nan,\r\n\u001b[?2004l\r"]
[217.056679, "o", "\u001b[?2004h"]
[217.056727, "o", "> "]
[217.056812, "o", "+            \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[217.056852, "o", "\u001b[?2004h> "]
[217.057126, "o", "+            \"days_since_last_login\": dlast_login,\r\n\u001b[?2004l\r"]
[217.057179, "o", "\u001b[?2004h> "]
[217.057472, "o", "+            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n\u001b[?2004l\r"]
[217.057526, "o", "\u001b[?2004h> "]
[217.057761, "o", "+            \"te_district\": float(te_district),\r\n\u001b[?2004l\r"]
[217.057806, "o", "\u001b[?2004h> "]
[217.057867, "o", "+        })\r\n\u001b[?2004l\r"]
[217.057912, "o", "\u001b[?2004h"]
[217.058022, "o", "> +\r\n\u001b[?2004l\r"]
[217.058089, "o", "\u001b[?2004h> "]
[217.058144, "o", "+    df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[217.058186, "o", "\u001b[?2004h> "]
[217.058412, "o", "+    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n\u001b[?2004l\r"]
[217.058465, "o", "\u001b[?2004h"]
[217.058509, "o", "> "]
[217.058746, "o", "+    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
[217.058788, "o", "\u001b[?2004h"]
[217.058825, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.058864, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[217.058903, "o", "> "]
[217.058977, "o", "+def main():\r\n\u001b[?2004l\r"]
[217.059016, "o", "\u001b[?2004h> "]
[217.059277, "o", "+    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[217.059318, "o", "\u001b[?2004h> "]
[217.059766, "o", "+    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[217.059828, "o", "\u001b[?2004h> "]
[217.060181, "o", "+    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[217.060997, "o", "\u001b[?2004h> +    args = ap.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> +    feats = build(args.data)\r\n\u001b[?2004l\r\u001b[?2004h> +    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.061212, "o", "+    feats.to_parquet(args.out, index=False)\r\n\u001b[?2004l\r"]
[217.061254, "o", "\u001b[?2004h"]
[217.061302, "o", "> "]
[217.061672, "o", "+    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\r\n\u001b[?2004l\r"]
[217.061721, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[217.061802, "o", "\u001b[?2004h> "]
[217.061849, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
