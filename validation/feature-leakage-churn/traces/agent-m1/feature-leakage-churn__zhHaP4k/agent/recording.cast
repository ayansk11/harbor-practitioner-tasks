[381.836025, "o", "\u001b[?2004h"]
[381.836063, "o", "> "]
[381.836495, "o", "+    \"\"\"Return rows whose load timestamp is <= ``as_of``.\r\n\u001b[?2004l\r"]
[381.836531, "o", "\u001b[?2004h"]
[381.836569, "o", "> "]
[381.836594, "o", "+\r\n"]
[381.836625, "o", "\u001b[?2004l\r\u001b[?2004h"]
[381.836664, "o", "> "]
[381.83724, "o", "+    Most tables use ``_loaded_at``; the customers table uses ``_updated_at``.\r\n\u001b[?2004l\r"]
[381.837282, "o", "\u001b[?2004h"]
[381.837321, "o", "> "]
[381.837375, "o", "+    \"\"\"\r\n"]
[381.837384, "o", "\u001b[?2004l\r"]
[381.837421, "o", "\u001b[?2004h"]
[381.837459, "o", "> "]
[381.837928, "o", "+    load_col = \"_loaded_at\" if \"_loaded_at\" in df.columns else \"_updated_at\"\r\n\u001b[?2004l\r"]
[381.838022, "o", "\u001b[?2004h> "]
[381.838252, "o", "+    return df[df[load_col] <= as_of]\r\n\u001b[?2004l\r"]
[381.838289, "o", "\u001b[?2004h"]
[381.83833, "o", "> "]
[381.838339, "o", "+\r\n\u001b[?2004l\r"]
[381.838387, "o", "\u001b[?2004h"]
[381.838427, "o", "> +\r\n\u001b[?2004l\r"]
[381.838474, "o", "\u001b[?2004h"]
[381.838517, "o", "> "]
[381.839178, "o", "+def _district_encoding_point(point: pd.Series, labels: pd.DataFrame, customers: pd.DataFrame) -> float:\r\n\u001b[?2004l\r"]
[381.839233, "o", "\u001b[?2004h> "]
[381.83968, "o", "+    \"\"\"Compute the ``te_district`` encoding for a single scoring point.\r\n\u001b[?2004l\r"]
[381.839724, "o", "\u001b[?2004h"]
[381.839758, "o", "> "]
[381.839795, "o", "+\r\n\u001b[?2004l\r"]
[381.839844, "o", "\u001b[?2004h"]
[381.839882, "o", "> "]
[381.840487, "o", "+    Mirrors ``live.features.district_encoding`` but operates on a pre‑filtered ``labels`` DataFrame.\r\n\u001b[?2004l\r"]
[381.840534, "o", "\u001b[?2004h"]
[381.840572, "o", "> "]
[381.840629, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[381.840669, "o", "\u001b[?2004h"]
[381.840714, "o", "> "]
[381.841177, "o", "+    cust_row = customers[customers[\"customer_id\"] == point[\"customer_id\"]]\r\n\u001b[?2004l\r"]
[381.841217, "o", "\u001b[?2004h"]
[381.841248, "o", "> "]
[381.8414, "o", "+    if cust_row.empty:\r\n\u001b[?2004l\r"]
[381.84144, "o", "\u001b[?2004h"]
[381.841474, "o", "> "]
[381.841623, "o", "+        return np.nan\r\n\u001b[?2004l\r"]
[381.841676, "o", "\u001b[?2004h"]
[381.841709, "o", "> "]
[381.842051, "o", "+    district = cust_row.iloc[0][\"postcode_district\"]\r\n\u001b[?2004l\r"]
[381.84209, "o", "\u001b[?2004h"]
[381.842129, "o", "> +\r\n"]
[381.842162, "o", "\u001b[?2004l\r"]
[381.842185, "o", "\u001b[?2004h"]
[381.84223, "o", "> "]
[381.842632, "o", "+    closed = labels[\"as_of\"] + pd.Timedelta(days=LABEL_WINDOW_DAYS)\r\n\u001b[?2004l\r"]
[381.842677, "o", "\u001b[?2004h"]
[381.842714, "o", "> "]
[381.842937, "o", "+    mask = closed < point[\"as_of\"]\r\n\u001b[?2004l\r"]
[381.843006, "o", "\u001b[?2004h> "]
[381.843207, "o", "+    lab_closed = labels[mask]\r\n\u001b[?2004l\r"]
[381.843243, "o", "\u001b[?2004h"]
[381.843268, "o", "> "]
[381.843314, "o", "+\r\n\u001b[?2004l\r"]
[381.843337, "o", "\u001b[?2004h"]
[381.843384, "o", "> "]
[381.843561, "o", "+    if len(lab_closed) == 0:\r\n\u001b[?2004l\r"]
[381.843604, "o", "\u001b[?2004h"]
[381.84364, "o", "> "]
[381.843832, "o", "+        prior = DEFAULT_PRIOR\r\n\u001b[?2004l\r"]
[381.843873, "o", "\u001b[?2004h"]
[381.843918, "o", "> "]
[381.843996, "o", "+    else:\r\n\u001b[?2004l\r"]
[381.844035, "o", "\u001b[?2004h"]
[381.844072, "o", "> "]
[381.844375, "o", "+        prior = lab_closed[\"churned_30d\"].mean()\r\n\u001b[?2004l\r"]
[381.844416, "o", "\u001b[?2004h"]
[381.844449, "o", "> "]
[381.844484, "o", "+\r\n\u001b[?2004l\r"]
[381.844523, "o", "\u001b[?2004h"]
[381.844561, "o", "> "]
[381.844714, "o", "+    if pd.isna(district):\r\n\u001b[?2004l\r"]
[381.844759, "o", "\u001b[?2004h"]
[381.844792, "o", "> "]
[381.844892, "o", "+        n = 0\r\n\u001b[?2004l\r"]
[381.844955, "o", "\u001b[?2004h"]
[381.844991, "o", "> "]
[381.845077, "o", "+        s = 0\r\n\u001b[?2004l\r"]
[381.845122, "o", "\u001b[?2004h"]
[381.84515, "o", "> "]
[381.845232, "o", "+    else:\r\n\u001b[?2004l\r"]
[381.845273, "o", "\u001b[?2004h"]
[381.845301, "o", "> "]
[381.845902, "o", "+        cust_district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[381.845965, "o", "\u001b[?2004h"]
[381.845993, "o", "> "]
[381.846511, "o", "+        lab_district = lab_closed[\"customer_id\"].map(cust_district)\r\n\u001b[?2004l\r"]
[381.846564, "o", "\u001b[?2004h"]
[381.846596, "o", "> "]
[381.84698, "o", "+        district_mask = lab_district == district\r\n\u001b[?2004l\r"]
[381.847036, "o", "\u001b[?2004h"]
[381.847063, "o", "> "]
[381.847325, "o", "+        n = district_mask.sum()\r\n\u001b[?2004l\r"]
[381.847381, "o", "\u001b[?2004h"]
[381.847409, "o", "> "]
[381.847931, "o", "+        s = lab_closed.loc[district_mask, \"churned_30d\"].sum()\r\n\u001b[?2004l\r"]
[381.848006, "o", "\u001b[?2004h"]
[381.848036, "o", "> "]
[381.848064, "o", "+\r\n\u001b[?2004l\r"]
[381.848101, "o", "\u001b[?2004h"]
[381.848127, "o", "> "]
[381.848626, "o", "+    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)\r\n"]
[381.848655, "o", "\u001b[?2004l\r"]
[381.848691, "o", "\u001b[?2004h"]
[381.848719, "o", "> "]
[381.848747, "o", "+\r\n\u001b[?2004l\r"]
[381.848791, "o", "\u001b[?2004h"]
[381.848828, "o", "> "]
[381.848864, "o", "+\r\n\u001b[?2004l\r"]
[381.848894, "o", "\u001b[?2004h"]
[381.848922, "o", "> "]
[381.849297, "o", "+def build(data_dir: str) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[381.849354, "o", "\u001b[?2004h"]
[381.849382, "o", "> "]
[381.84993, "o", "+    \"\"\"Build the feature table for the given extract directory.\r\n\u001b[?2004l\r"]
[381.850009, "o", "\u001b[?2004h"]
[381.850037, "o", "> "]
[381.850067, "o", "+\r\n\u001b[?2004l\r"]
[381.850112, "o", "\u001b[?2004h"]
[381.85014, "o", "> "]
[381.850958, "o", "+    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n"]
[381.850994, "o", "\u001b[?2004l\r"]
[381.851035, "o", "\u001b[?2004h"]
[381.851062, "o", "> "]
[381.851136, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[381.851189, "o", "\u001b[?2004h"]
[381.851217, "o", "> "]
[381.851527, "o", "+    tables = load_extract(data_dir)\r\n"]
[381.851559, "o", "\u001b[?2004l\r"]
[381.85159, "o", "\u001b[?2004h"]
[381.851619, "o", "> "]
[381.852151, "o", "+    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n"]
[381.852182, "o", "\u001b[?2004l\r"]
[381.852216, "o", "\u001b[?2004h"]
[381.852246, "o", "> "]
[381.852275, "o", "+\r\n\u001b[?2004l\r"]
[381.852323, "o", "\u001b[?2004h"]
[381.852351, "o", "> "]
[381.852683, "o", "+    customers_full = tables[\"customers\"]\r\n\u001b[?2004l\r"]
[381.852756, "o", "\u001b[?2004h"]
[381.852793, "o", "> "]
[381.853098, "o", "+    labels_full = tables[\"labels\"]\r\n\u001b[?2004l\r"]
[381.853145, "o", "\u001b[?2004h"]
[381.853174, "o", "> "]
[381.85347, "o", "+    orders_full = tables[\"orders\"]\r\n\u001b[?2004l\r"]
[381.853519, "o", "\u001b[?2004h"]
[381.853548, "o", "> "]
[381.853852, "o", "+    tickets_full = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[381.853911, "o", "\u001b[?2004h"]
[381.853948, "o", "> "]
[381.854338, "o", "+    status_full = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[381.854401, "o", "\u001b[?2004h"]
[381.854429, "o", "> +\r\n"]
[381.854458, "o", "\u001b[?2004l\r"]
[381.854485, "o", "\u001b[?2004h"]
[381.854511, "o", "> "]
[381.854712, "o", "+    rows: List[dict] = []\r\n\u001b[?2004l\r"]
[381.854763, "o", "\u001b[?2004h"]
[381.854788, "o", "> "]
[381.855108, "o", "+    for _, pt in points.iterrows():\r\n\u001b[?2004l\r"]
[381.855172, "o", "\u001b[?2004h"]
[381.855202, "o", "> "]
[381.855436, "o", "+        as_of = pt[\"as_of\"]\r\n\u001b[?2004l\r"]
[381.8555, "o", "\u001b[?2004h"]
[381.855526, "o", "> +\r\n"]
[381.855556, "o", "\u001b[?2004l\r"]
[381.85558, "o", "\u001b[?2004h"]
[381.855602, "o", "> "]
[381.85607, "o", "+        orders = _filter_by_loaded(orders_full, as_of)\r\n\u001b[?2004l\r"]
[381.856125, "o", "\u001b[?2004h"]
[381.856146, "o", "> "]
[381.856628, "o", "+        tickets = _filter_by_loaded(tickets_full, as_of)\r\n\u001b[?2004l\r"]
[381.856688, "o", "\u001b[?2004h"]
[381.856717, "o", "> "]
[381.857247, "o", "+        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n\u001b[?2004l\r"]
[381.857306, "o", "\u001b[?2004h"]
[381.857335, "o", "> "]
[381.857784, "o", "+        customers = _filter_by_loaded(customers_full, as_of)\r\n\u001b[?2004l\r"]
[381.857828, "o", "\u001b[?2004h"]
[381.857857, "o", "> "]
[381.858201, "o", "+        labels = _filter_by_loaded(labels_full, as_of)\r\n\u001b[?2004l\r"]
[381.858236, "o", "\u001b[?2004h"]
[381.858268, "o", "> +\r\n"]
[381.858296, "o", "\u001b[?2004l\r"]
[381.858322, "o", "\u001b[?2004h"]
[381.858345, "o", "> "]
[381.858575, "o", "+        single_point = pt.to_frame().T\r\n\u001b[?2004l\r"]
[381.858613, "o", "\u001b[?2004h"]
[381.858636, "o", "> "]
[381.859047, "o", "+        act = activity_features(single_point, orders, tickets)\r\n\u001b[?2004l\r"]
[381.859094, "o", "\u001b[?2004h"]
[381.859121, "o", "> "]
[381.859445, "o", "+        tenure = tenure_days(single_point, customers)\r\n\u001b[?2004l\r"]
[381.859479, "o", "\u001b[?2004h"]
[381.8595, "o", "> "]
[381.859898, "o", "+        status = latest_status(single_point, status_snapshots)\r\n\u001b[?2004l\r"]
[381.85993, "o", "\u001b[?2004h> "]
[381.859951, "o", "+\r\n\u001b[?2004l\r"]
[381.859989, "o", "\u001b[?2004h"]
[381.860005, "o", "> "]
[381.860348, "o", "+        plan_val = plan(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[381.860383, "o", "\u001b[?2004h"]
[381.860402, "o", "> "]
[381.860872, "o", "+        dlast_login = days_since_last_login(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[381.86095, "o", "\u001b[?2004h> "]
[381.861387, "o", "+        te_district = _district_encoding_point(pt, labels, customers_full)\r\n\u001b[?2004l\r"]
[381.86143, "o", "\u001b[?2004h"]
[381.861445, "o", "> "]
[381.861462, "o", "+\r\n\u001b[?2004l\r"]
[381.861496, "o", "\u001b[?2004h"]
[381.861512, "o", "> "]
[381.861653, "o", "+        rows.append({\r\n\u001b[?2004l\r"]
[381.861688, "o", "\u001b[?2004h"]
[381.861707, "o", "> "]
[381.862002, "o", "+            \"customer_id\": pt[\"customer_id\"],\r\n\u001b[?2004l\r"]
[381.862033, "o", "\u001b[?2004h"]
[381.862049, "o", "> "]
[381.862228, "o", "+            \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[381.862264, "o", "\u001b[?2004h"]
[381.862283, "o", "> "]
[381.862622, "o", "+            \"orders_7d\": int(act[\"orders_7d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[381.862656, "o", "\u001b[?2004h"]
[381.862674, "o", "> "]
[381.863039, "o", "+            \"orders_30d\": int(act[\"orders_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[381.863072, "o", "\u001b[?2004h"]
[381.863092, "o", "> "]
[381.863501, "o", "+            \"spend_30d_cents\": int(act[\"spend_30d_cents\"].iloc[0]),\r\n\u001b[?2004l\r"]
[381.863535, "o", "\u001b[?2004h"]
[381.863555, "o", "> "]
[381.863922, "o", "+            \"tickets_30d\": int(act[\"tickets_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[381.863976, "o", "\u001b[?2004h> "]
[381.864434, "o", "+            \"days_since_last_order\": act[\"days_since_last_order\"].iloc[0],\r\n\u001b[?2004l\r"]
[381.864468, "o", "\u001b[?2004h"]
[381.864484, "o", "> "]
[381.86479, "o", "+            \"tenure_days\": float(tenure.iloc[0]),\r\n\u001b[?2004l\r"]
[381.864829, "o", "\u001b[?2004h"]
[381.864845, "o", "> "]
[381.865345, "o", "+            \"status\": status.iloc[0] if not pd.isna(status.iloc[0]) else np.nan,\r\n\u001b[?2004l\r"]
[381.865419, "o", "\u001b[?2004h"]
[381.865438, "o", "> "]
[381.865623, "o", "+            \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[381.865658, "o", "\u001b[?2004h"]
[381.865678, "o", "> "]
[381.865993, "o", "+            \"days_since_last_login\": dlast_login,\r\n\u001b[?2004l\r"]
[381.866028, "o", "\u001b[?2004h"]
[381.866047, "o", "> "]
[381.866433, "o", "+            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n\u001b[?2004l\r"]
[381.866467, "o", "\u001b[?2004h"]
[381.866485, "o", "> "]
[381.866772, "o", "+            \"te_district\": float(te_district),\r\n\u001b[?2004l\r"]
[381.866815, "o", "\u001b[?2004h"]
[381.866831, "o", "> "]
[381.866907, "o", "+        })\r\n\u001b[?2004l\r"]
[381.86695, "o", "\u001b[?2004h"]
[381.866967, "o", "> "]
[381.866986, "o", "+\r\n\u001b[?2004l\r"]
[381.867018, "o", "\u001b[?2004h"]
[381.867033, "o", "> "]
[381.867211, "o", "+    df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[381.867248, "o", "\u001b[?2004h"]
[381.867265, "o", "> "]
[381.867559, "o", "+    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n\u001b[?2004l\r"]
[381.867594, "o", "\u001b[?2004h"]
[381.867614, "o", "> "]
[381.867978, "o", "+    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
[381.86801, "o", "\u001b[?2004h"]
[381.868026, "o", "> "]
[381.868047, "o", "+\r\n\u001b[?2004l\r"]
[381.868077, "o", "\u001b[?2004h"]
[381.868093, "o", "> "]
[381.86811, "o", "+\r\n\u001b[?2004l\r"]
[381.868144, "o", "\u001b[?2004h"]
[381.86816, "o", "> "]
[381.868241, "o", "+def main():\r\n\u001b[?2004l\r"]
[381.86828, "o", "\u001b[?2004h"]
[381.868297, "o", "> "]
[381.868626, "o", "+    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[381.868661, "o", "\u001b[?2004h"]
[381.86868, "o", "> "]
[381.869185, "o", "+    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[381.869217, "o", "\u001b[?2004h"]
[381.869233, "o", "> "]
[381.869672, "o", "+    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[381.869705, "o", "\u001b[?2004h"]
[381.869722, "o", "> "]
[381.869892, "o", "+    args = ap.parse_args()\r\n\u001b[?2004l\r"]
[381.869928, "o", "\u001b[?2004h"]
[381.869949, "o", "> "]
[381.870137, "o", "+    feats = build(args.data)\r\n\u001b[?2004l\r"]
[381.870172, "o", "\u001b[?2004h"]
[381.870189, "o", "> "]
[381.870643, "o", "+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\r\n\u001b[?2004l\r"]
[381.870675, "o", "\u001b[?2004h"]
[381.870693, "o", "> "]
[381.87097, "o", "+    feats.to_parquet(args.out, index=False)\r\n\u001b[?2004l\r"]
[381.871008, "o", "\u001b[?2004h"]
[381.871027, "o", "> "]
[381.871519, "o", "+    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\r\n\u001b[?2004l\r"]
[381.871551, "o", "\u001b[?2004h"]
[381.871577, "o", "> "]
[381.871596, "o", "+\r\n\u001b[?2004l\r"]
[381.871619, "o", "\u001b[?2004h"]
[381.871644, "o", "> "]
[381.87167, "o", "+\r\n"]
[381.871695, "o", "\u001b[?2004l\r\u001b[?2004h"]
[381.871717, "o", "> "]
[381.87191, "o", "+if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[381.87198, "o", "\u001b[?2004h> "]
[381.872038, "o", "+    main()\r\n\u001b[?2004l\r"]
[381.872073, "o", "\u001b[?2004h"]
[381.872103, "o", "> "]
[381.872137, "o", "+EOF\r\n\u001b[?2004l\r"]
[381.872171, "o", "\u001b[?2004h"]
[381.872206, "o", "> "]
[383.302973, "i", "python test_build.py\n"]
