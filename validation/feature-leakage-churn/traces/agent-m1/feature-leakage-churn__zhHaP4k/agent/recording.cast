[564.306, "i", "cat > churn/build_features.py <<'EOF'\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\n\nThis implementation respects point‑in‑time visibility of rows. Each source table includes a\n`_loaded_at` (or `_updated_at` for customers) timestamp indicating when the row became\ncommitted to the warehouse. The live service only sees rows whose load timestamp is **<=** the\nprediction's `as_of`. The original implementation ignored these timestamps, causing a distribution shift.\n\nThe new `build` function iterates over the rows of ``scoring_points.csv`` and, for each row,\nfilters the other tables to rows visible at that moment. It then reproduces the exact feature\nlogic from ``live/features.py`` using the filtered data. The approach is straightforward and fits\nwithin the 60‑second limit for the modest sized extracts used in grading.\n\"\"\"\n\nimport argparse\nimport os\nfrom typing import List\n\nimport numpy as np\nimport pandas as pd\n\nfrom churn.attributes import days_since_last"]
[564.306151, "i", "_login, plan\nfrom churn.encoding import PRIOR_WEIGHT, DEFAULT_PRIOR, LABEL_WINDOW_DAYS\nfrom churn.extract import load_extract\nfrom churn.impute import fill_app_minutes\nfrom churn.status import latest_status\nfrom churn.windows import tenure_days\n\nFEATURE_COLUMNS = [\n    \"orders_7d\",\n    \"orders_30d\",\n    \"spend_30d_cents\",\n    \"tickets_30d\",\n    \"days_since_last_order\",\n    \"tenure_days\",\n    \"status\",\n    \"plan\",\n    \"days_since_last_login\",\n    \"app_minutes_7d\",\n    \"te_district\",\n]\n\n\ndef _filter_by_loaded(df: pd.DataFrame, as_of: pd.Timestamp) -> pd.DataFrame:\n    \"\"\"Return rows whose load timestamp is <= ``as_of``.\n\n    Most tables use ``_loaded_at``; the customers table uses ``_updated_at``.\n    \"\"\"\n    load_col = \"_loaded_at\" if \"_loaded_at\" in df.columns else \"_updated_at\"\n    return df[df[load_col] <= as_of]\n\n\ndef _district_encoding_point(point: pd.Series, labels: pd.DataFrame, customers: pd.DataFrame) -> float:\n    \"\"\"Compute the ``te_district`` encoding for a single scoring point.\n\n    Mirrors ``live"]
[564.306215, "i", ".features.district_encoding`` but operates on a pre‑filtered ``labels`` DataFrame.\n    \"\"\"\n    cust_row = customers[customers[\"customer_id\"] == point[\"customer_id\"]]\n    if cust_row.empty:\n        return np.nan\n    district = cust_row.iloc[0][\"postcode_district\"]\n\n    closed = labels[\"as_of\"] + pd.Timedelta(days=LABEL_WINDOW_DAYS)\n    mask = closed < point[\"as_of\"]\n    lab_closed = labels[mask]\n\n    if len(lab_closed) == 0:\n        prior = DEFAULT_PRIOR\n    else:\n        prior = lab_closed[\"churned_30d\"].mean()\n\n    if pd.isna(district):\n        n = 0\n        s = 0\n    else:\n        cust_district = customers.set_index(\"customer_id\")[\"postcode_district\"]\n        lab_district = lab_closed[\"customer_id\"].map(cust_district)\n        district_mask = lab_district == district\n        n = district_mask.sum()\n        s = lab_closed.loc[district_mask, \"churned_30d\"].sum()\n\n    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)\n\n\ndef build(data_dir: str) -> pd.DataFrame:\n    \"\"\"Build the feature table for the given"]
[564.306262, "i", " extract directory.\n\n    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\n    \"\"\"\n    tables = load_extract(data_dir)\n    points = tables[\"scoring_points\"].reset_index(drop=True)\n\n    customers_full = tables[\"customers\"]\n    labels_full = tables[\"labels\"]\n    orders_full = tables[\"orders\"]\n    tickets_full = tables[\"tickets\"]\n    status_full = tables[\"status_snapshots\"]\n\n    rows: List[dict] = []\n    for _, pt in points.iterrows():\n        as_of = pt[\"as_of\"]\n\n        orders = _filter_by_loaded(orders_full, as_of)\n        tickets = _filter_by_loaded(tickets_full, as_of)\n        status_snapshots = _filter_by_loaded(status_full, as_of)\n        customers = _filter_by_loaded(customers_full, as_of)\n        labels = _filter_by_loaded(labels_full, as_of)\n\n        # Activity features - manual calculations\n        # orders 7d\n        mask7 = (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=7)) & (orders[\"ordered_at\"] < as_of)\n        orders_7d = int(mask7.sum())\n        #"]
[564.30631, "o", "cat > churn/build_features.py <<'EOF'\r\n\u001b[?2004l\r"]
[564.30636, "i", " orders 30d and spend\n        mask30 = (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=30)) & (orders[\"ordered_at\"] < as_of)\n        orders_30d = int(mask30.sum())\n        spend_30d_cents = int(orders.loc[mask30, \"amount_cents\"].sum())\n        # tickets 30d\n        mask_t = (tickets[\"opened_at\"] >= as_of - pd.Timedelta(days=30)) & (tickets[\"opened_at\"] < as_of)\n        tickets_30d = int(mask_t.sum())\n        # days since last order\n        past_orders = orders[orders[\"ordered_at\"] < as_of]\n        if not past_orders.empty:\n            last_order = past_orders[\"ordered_at\"].max()\n            days_since_last_order = (as_of - last_order).total_seconds() / 86400\n        else:\n            days_since_last_order = np.nan\n\n        # tenure, status, plan, days since login\n        tenure = tenure_days(pd.DataFrame([pt]), customers).iloc[0]\n        status = latest_status(pd.DataFrame([pt]), status_snapshots).iloc[0]\n        plan_val = plan(pd.DataFrame([pt]), customers).iloc[0]\n        dlast_login = days_since_last_l"]
[564.306408, "o", " extract directory.\r\n\r\n    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n    \"\"\"\r\n    tables = load_extract(data_dir)\r\n    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n\r\n    customers_full "]
[564.306444, "i", "ogin(pd.DataFrame([pt]), customers).iloc[0]\n        te_district = _district_encoding_point(pt, labels, customers_full)\n\n        rows.append({\n            \"customer_id\": pt[\"customer_id\"],\n            \"as_of\": as_of,\n            \"orders_7d\": orders_7d,\n            \"orders_30d\": orders_30d,\n            \"spend_30d_cents\": spend_30d_cents,\n            \"tickets_30d\": tickets_30d,\n            \"days_since_last_order\": days_since_last_order,\n            \"tenure_days\": float(tenure),\n            \"status\": status if not pd.isna(status) else np.nan,\n            \"plan\": plan_val,\n            \"days_since_last_login\": dlast_login,\n            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\n            \"te_district\": float(te_district),\n        })\n\n    df = pd.DataFrame(rows)\n    df[\"app_minutes_7d\"] = fill_app_minutes(df)\n    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract"]
[564.306502, "o", "= tables[\"customers\"]\r\n    labels"]
[564.306541, "i", " CSVs\")\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    args = ap.parse_args()\n    feats = build(args.data)\n    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\n    feats.to_parquet(args.out, index=False)\n    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[564.306607, "o", "_full = tables[\"labels\"]\r\n    orders_full = tables[\"orders\"]\r\n    tickets_full = tables[\"tickets\"]\r\n    status_full = tables[\"status_snapshots\"]\r\n\r\n    rows: List[dict] = []\r\n    for _, pt in points.iterrows():\r\n        as_of = pt[\"as_of\""]
[564.306669, "o", "]\r\n\r\n        orders = _filter_by_loaded(orders_full, as_of)\r\n        tickets = _filter_by_loaded(tickets_full, as_of)\r\n        "]
[564.306715, "o", "status_snapshots = _filter_by_loaded(status_full, as_of)\r\n        customers = _filter_by_loaded(customers"]
[564.306773, "o", "_full, as_of)\r\n        labels = _filter_by_loaded(labels_full, as_of)\r\n\r\n     "]
[564.306815, "o", "   # Activity features - manual calculations\r\n        # orders 7d\r\n        mask7 = (orders[\"ordered_at\"] >= as_of - pd.Ti"]
[564.306857, "o", "medelta(days=7)) & (orders[\"ordered_at\"] < as_of)\r\n        orders_7d = int(mask7.sum()"]
[564.306896, "o", ")\r\n        # orders 3"]
[564.306936, "o", "0d and spend\r\n        mask30 \u001b[?2004h> "]
[564.30751, "o", "\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\r\n\u001b[?2004l\r"]
[564.307553, "o", "\u001b[?2004h> "]
[564.307589, "o", "\r\n\u001b[?2004l\r"]
[564.307628, "o", "\u001b[?2004h> "]
[564.308142, "o", "This implementation respects point‑in‑time visibility of rows. Each source table includes a\r\n\u001b[?2004l\r"]
[564.308184, "o", "\u001b[?2004h"]
[564.308222, "o", "> "]
[564.308653, "o", "`_loaded_at` (or `_updated_at` for customers) timestamp indicating when the row became\r\n\u001b[?2004l\r"]
[564.308706, "o", "\u001b[?2004h> "]
[564.309228, "o", "committed to the warehouse. The live service only sees rows whose load timestamp is **<=** the\r\n\u001b[?2004l\r"]
[564.309269, "o", "\u001b[?2004h"]
[564.309306, "o", "> "]
[564.309839, "o", "prediction's `as_of`. The original implementation ignored these timestamps, causing a distribution shift.\r\n\u001b[?2004l\r"]
[564.309881, "o", "\u001b[?2004h"]
[564.309923, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.310462, "o", "The new `build` function iterates over the rows of ``scoring_points.csv`` and, for each row,\r\n\u001b[?2004l\r"]
[564.310508, "o", "\u001b[?2004h"]
[564.310545, "o", "> "]
[564.311032, "o", "filters the other tables to rows visible at that moment. It then reproduces the exact feature\r\n\u001b[?2004l\r"]
[564.311086, "o", "\u001b[?2004h> "]
[564.311611, "o", "logic from ``live/features.py`` using the filtered data. The approach is straightforward and fits\r\n\u001b[?2004l\r"]
[564.311651, "o", "\u001b[?2004h"]
[564.311688, "o", "> "]
[564.312115, "o", "within the 60‑second limit for the modest sized extracts used in grading.\r\n\u001b[?2004l\r"]
[564.312157, "o", "\u001b[?2004h"]
[564.312192, "o", "> \"\"\"\r\n\u001b[?2004l\r"]
[564.312227, "o", "\u001b[?2004h"]
[564.312262, "o", "> \r\n\u001b[?2004l\r"]
[564.312294, "o", "\u001b[?2004h> "]
[564.312381, "o", "import argparse\r\n\u001b[?2004l\r"]
[564.312426, "o", "\u001b[?2004h"]
[564.312459, "o", "> "]
[564.312493, "o", "import os"]
[564.31253, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.312568, "o", "> "]
[564.312669, "o", "from typing import List\r\n\u001b[?2004l\r"]
[564.312705, "o", "\u001b[?2004h"]
[564.312741, "o", "> \r\n\u001b[?2004l\r"]
[564.312773, "o", "\u001b[?2004h> "]
[564.312866, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[564.312901, "o", "\u001b[?2004h"]
[564.312935, "o", "> "]
[564.313055, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[564.313098, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.313138, "o", "\u001b[?2004h> "]
[564.313462, "o", "from churn.attributes import days_since_last_login, plan\r\n\u001b[?2004l\r"]
[564.313501, "o", "\u001b[?2004h"]
[564.313533, "o", "> "]
[564.313911, "o", "from churn.encoding import PRIOR_WEIGHT, DEFAULT_PRIOR, LABEL_WINDOW_DAYS\r\n\u001b[?2004l\r"]
[564.313954, "o", "\u001b[?2004h"]
[564.313994, "o", "> "]
[564.314188, "o", "from churn.extract import load_extract\r\n\u001b[?2004l\r"]
[564.314225, "o", "\u001b[?2004h"]
[564.314261, "o", "> "]
[564.314458, "o", "from churn.impute import fill_app_minutes\r\n\u001b[?2004l\r"]
[564.314506, "o", "\u001b[?2004h> "]
[564.314718, "o", "from churn.status import latest_status\r\n\u001b[?2004l\r"]
[564.314764, "o", "\u001b[?2004h> "]
[564.314991, "o", "from churn.windows import tenure_days\r\n\u001b[?2004l\r"]
[564.315035, "o", "\u001b[?2004h> "]
[564.315075, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.315197, "o", "FEATURE_COLUMNS = [\r\n\u001b[?2004l\r"]
[564.315243, "o", "\u001b[?2004h> "]
[564.31534, "o", "    \"orders_7d\",\r\n\u001b[?2004l\r"]
[564.315377, "o", "\u001b[?2004h> "]
[564.3155, "o", "    \"orders_30d\",\r\n\u001b[?2004l\r"]
[564.315535, "o", "\u001b[?2004h"]
[564.315571, "o", "> "]
[564.315672, "o", "    \"spend_30d_cents\",\r\n\u001b[?2004l\r"]
[564.315707, "o", "\u001b[?2004h"]
[564.315741, "o", "> "]
[564.315831, "o", "    \"tickets_30d\",\r\n\u001b[?2004l\r"]
[564.315866, "o", "\u001b[?2004h"]
[564.315897, "o", "> "]
[564.316047, "o", "    \"days_since_last_order\",\r\n\u001b[?2004l\r"]
[564.316091, "o", "\u001b[?2004h"]
[564.316131, "o", "> "]
[564.316198, "o", "    \"tenure_days\",\r\n\u001b[?2004l\r"]
[564.316232, "o", "\u001b[?2004h"]
[564.316266, "o", "> "]
[564.316334, "o", "    \"status\",\r\n\u001b[?2004l\r"]
[564.316371, "o", "\u001b[?2004h"]
[564.316413, "o", "> "]
[564.31646, "o", "    \"plan\",\r\n\u001b[?2004l\r"]
[564.316505, "o", "\u001b[?2004h> "]
[564.316664, "o", "    \"days_since_last_login\",\r\n\u001b[?2004l\r"]
[564.316709, "o", "\u001b[?2004h"]
[564.316747, "o", "> "]
[564.316838, "o", "    \"app_minutes_7d\",\r\n\u001b[?2004l\r"]
[564.316872, "o", "\u001b[?2004h"]
[564.316902, "o", "> "]
[564.317005, "o", "    \"te_district\",\r\n\u001b[?2004l\r"]
[564.317048, "o", "\u001b[?2004h> "]
[564.317088, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.317127, "o", "\u001b[?2004h> \r\n"]
[564.317165, "o", "\u001b[?2004l\r"]
[564.317199, "o", "\u001b[?2004h> "]
[564.317621, "o", "def _filter_by_loaded(df: pd.DataFrame, as_of: pd.Timestamp) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[564.31766, "o", "\u001b[?2004h"]
[564.317694, "o", "> "]
[564.317998, "o", "    \"\"\"Return rows whose load timestamp is <= ``as_of``.\r\n\u001b[?2004l\r"]
[564.318041, "o", "\u001b[?2004h> "]
[564.318081, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.318524, "o", "    Most tables use ``_loaded_at``; the customers table uses ``_updated_at``.\r\n\u001b[?2004l\r"]
[564.318568, "o", "\u001b[?2004h> "]
[564.318601, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[564.318635, "o", "\u001b[?2004h"]
[564.31867, "o", "> "]
[564.319092, "o", "    load_col = \"_loaded_at\" if \"_loaded_at\" in df.columns else \"_updated_at\"\r\n\u001b[?2004l\r"]
[564.31914, "o", "\u001b[?2004h> "]
[564.319338, "o", "    return df[df[load_col] <= as_of]\r\n\u001b[?2004l\r"]
[564.319376, "o", "\u001b[?2004h"]
[564.319411, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.319444, "o", "\r\n\u001b[?2004l\r"]
[564.319477, "o", "\u001b[?2004h> "]
[564.320053, "o", "def _district_encoding_point(point: pd.Series, labels: pd.DataFrame, customers: pd.DataFrame) -> float:\r\n\u001b[?2004l\r"]
[564.320093, "o", "\u001b[?2004h"]
[564.320128, "o", "> "]
[564.320496, "o", "    \"\"\"Compute the ``te_district`` encoding for a single scoring point.\r\n\u001b[?2004l\r"]
[564.320537, "o", "\u001b[?2004h"]
[564.320574, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[564.320609, "o", "> "]
[564.321163, "o", "    Mirrors ``live.features.district_encoding`` but operates on a pre‑filtered ``labels`` DataFrame.\r\n\u001b[?2004l\r"]
[564.3212, "o", "\u001b[?2004h"]
[564.321233, "o", "> "]
[564.321268, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[564.321302, "o", "\u001b[?2004h> "]
[564.321704, "o", "    cust_row = customers[customers[\"customer_id\"] == point[\"customer_id\"]]\r\n\u001b[?2004l\r"]
[564.321742, "o", "\u001b[?2004h"]
[564.321775, "o", "> "]
[564.32189, "o", "    if cust_row.empty:\r\n\u001b[?2004l\r"]
[564.321933, "o", "\u001b[?2004h"]
[564.321977, "o", "> "]
[564.322076, "o", "        return np.nan\r\n\u001b[?2004l\r"]
[564.322111, "o", "\u001b[?2004h"]
[564.322147, "o", "> "]
[564.322412, "o", "    district = cust_row.iloc[0][\"postcode_district\"]\r\n\u001b[?2004l\r"]
[564.322451, "o", "\u001b[?2004h"]
[564.322483, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[564.322515, "o", "> "]
[564.322876, "o", "    closed = labels[\"as_of\"] + pd.Timedelta(days=LABEL_WINDOW_DAYS)\r\n\u001b[?2004l\r"]
[564.322913, "o", "\u001b[?2004h"]
[564.322954, "o", "> "]
[564.323117, "o", "    mask = closed < point[\"as_of\"]\r\n\u001b[?2004l\r"]
[564.323156, "o", "\u001b[?2004h"]
[564.323191, "o", "> "]
[564.323311, "o", "    lab_closed = labels[mask]\r\n\u001b[?2004l\r"]
[564.323346, "o", "\u001b[?2004h"]
[564.323381, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[564.323416, "o", "> "]
[564.323535, "o", "    if len(lab_closed) == 0:\r\n\u001b[?2004l\r"]
[564.32357, "o", "\u001b[?2004h> "]
[564.323717, "o", "        prior = DEFAULT_PRIOR\r\n\u001b[?2004l\r"]
[564.32376, "o", "\u001b[?2004h> "]
[564.32381, "o", "    else:\r\n\u001b[?2004l\r"]
[564.323853, "o", "\u001b[?2004h> "]
[564.324087, "o", "        prior = lab_closed[\"churned_30d\"].mean()\r\n\u001b[?2004l\r"]
[564.324131, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.324162, "o", "\u001b[?2004h"]
[564.324194, "o", "> "]
[564.324308, "o", "    if pd.isna(district):\r\n\u001b[?2004l\r"]
[564.324351, "o", "\u001b[?2004h> "]
[564.324415, "o", "        n = 0\r\n\u001b[?2004l\r"]
[564.32445, "o", "\u001b[?2004h"]
[564.324482, "o", "> "]
[564.324528, "o", "        s = 0\r\n\u001b[?2004l\r"]
[564.324561, "o", "\u001b[?2004h> "]
[564.324624, "o", "    else:\r\n\u001b[?2004l\r"]
[564.324655, "o", "\u001b[?2004h> "]
[564.325029, "o", "        cust_district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[564.325063, "o", "\u001b[?2004h> "]
[564.325381, "o", "        lab_district = lab_closed[\"customer_id\"].map(cust_district)\r\n\u001b[?2004l\r"]
[564.325415, "o", "\u001b[?2004h"]
[564.325447, "o", "> "]
[564.325648, "o", "        district_mask = lab_district == district\r\n\u001b[?2004l\r"]
[564.325687, "o", "\u001b[?2004h> "]
[564.325836, "o", "        n = district_mask.sum()\r\n\u001b[?2004l\r"]
[564.325874, "o", "\u001b[?2004h"]
[564.325906, "o", "> "]
[564.326175, "o", "        s = lab_closed.loc[district_mask, \"churned_30d\"].sum()\r\n\u001b[?2004l\r"]
[564.326212, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.326244, "o", "\u001b[?2004h"]
[564.326276, "o", "> "]
[564.326533, "o", "    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)\r\n\u001b[?2004l\r"]
[564.326567, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.326611, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.326645, "o", "\u001b[?2004h> "]
[564.326855, "o", "def build(data_dir: str) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[564.326886, "o", "\u001b[?2004h> "]
[564.327201, "o", "    \"\"\"Build the feature table for the given extract directory.\r\n\u001b[?2004l\r"]
[564.327233, "o", "\u001b[?2004h"]
[564.327266, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[564.327298, "o", "> "]
[564.32772, "o", "    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n\u001b[?2004l\r"]
[564.327769, "o", "\u001b[?2004h> "]
[564.327802, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[564.327835, "o", "\u001b[?2004h> "]
[564.328023, "o", "    tables = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[564.328061, "o", "\u001b[?2004h"]
[564.328106, "o", "> "]
[564.328352, "o", "    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[564.328387, "o", "\u001b[?2004h"]
[564.328437, "o", "> \r\n\u001b[?2004l\r"]
[564.328475, "o", "\u001b[?2004h> "]
[564.328645, "o", "    customers_full = tables[\"customers\"]\r\n\u001b[?2004l\r"]
[564.328684, "o", "\u001b[?2004h"]
[564.328719, "o", "> "]
[564.328867, "o", "    labels_full = tables[\"labels\"]\r\n\u001b[?2004l\r"]
[564.328904, "o", "\u001b[?2004h"]
[564.328939, "o", "> "]
[564.32909, "o", "    orders_full = tables[\"orders\"]\r\n\u001b[?2004l\r"]
[564.329126, "o", "\u001b[?2004h"]
[564.32916, "o", "> "]
[564.329314, "o", "    tickets_full = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[564.329353, "o", "\u001b[?2004h"]
[564.329387, "o", "> "]
[564.329566, "o", "    status_full = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[564.329602, "o", "\u001b[?2004h"]
[564.329641, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.329776, "o", "    rows: List[dict] = []\r\n\u001b[?2004l\r"]
[564.329812, "o", "\u001b[?2004h"]
[564.329846, "o", "> "]
[564.330028, "o", "    for _, pt in points.iterrows():\r\n\u001b[?2004l\r"]
[564.330066, "o", "\u001b[?2004h> "]
[564.330199, "o", "        as_of = pt[\"as_of\"]\r\n\u001b[?2004l\r"]
[564.330244, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.330276, "o", "\u001b[?2004h"]
[564.330308, "o", "> "]
[564.330537, "o", "        orders = _filter_by_loaded(orders_full, as_of)\r\n\u001b[?2004l\r"]
[564.330573, "o", "\u001b[?2004h"]
[564.330608, "o", "> "]
[564.33084, "o", "        tickets = _filter_by_loaded(tickets_full, as_of)\r\n\u001b[?2004l\r"]
[564.330879, "o", "\u001b[?2004h"]
[564.330912, "o", "> "]
[564.331187, "o", "        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n\u001b[?2004l\r"]
[564.331214, "o", "\u001b[?2004h"]
[564.331268, "o", "> "]
[564.331505, "o", "        customers = _filter_by_loaded(customers_full, as_of)\r\n\u001b[?2004l\r"]
[564.331543, "o", "\u001b[?2004h"]
[564.331575, "o", "> "]
[564.331801, "o", "        labels = _filter_by_loaded(labels_full, as_of)\r\n\u001b[?2004l\r"]
[564.331838, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.331888, "o", "\u001b[?2004h> "]
[564.332125, "o", "        # Activity features - manual calculations\r\n\u001b[?2004l\r"]
[564.332164, "o", "\u001b[?2004h"]
[564.332201, "o", "> "]
[564.332268, "o", "        # orders 7d\r\n\u001b[?2004l\r"]
[564.332286, "o", "\u001b[?2004h"]
[564.332336, "o", "> "]
[564.332776, "o", "        mask7 = (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=7)) & (orders[\"ordered_at\"] < as_of)\r\n\u001b[?2004l\r"]
[564.332823, "o", "\u001b[?2004h> "]
[564.332999, "o", "        orders_7d = int(mask7.sum())\r\n\u001b[?2004l\r"]
[564.333037, "o", "\u001b[?2004h"]
[564.333057, "o", "> "]
[564.333187, "o", "        # orders 30d and spend\r\n\u001b[?2004l\r"]
[564.333231, "o", "\u001b[?2004h> "]
[564.333696, "o", "        mask30 = (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=30)) & (orders[\"ordered_at\"] < as_of)\r\n\u001b[?2004l\r"]
[564.333737, "o", "\u001b[?2004h"]
[564.333769, "o", "> "]
[564.333922, "o", "        orders_30d = int(mask30.sum())\r\n\u001b[?2004l\r"]
[564.333976, "o", "\u001b[?2004h"]
[564.334008, "o", "> "]
[564.334305, "o", "        spend_30d_cents = int(orders.loc[mask30, \"amount_cents\"].sum())\r\n\u001b[?2004l\r"]
[564.334351, "o", "\u001b[?2004h"]
[564.334393, "o", "> "]
[564.334458, "o", "        # tickets 30d\r\n\u001b[?2004l\r"]
[564.334504, "o", "\u001b[?2004h> "]
[564.334993, "o", "        mask_t = (tickets[\"opened_at\"] >= as_of - pd.Timedelta(days=30)) & (tickets[\"opened_at\"] < as_of)\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.335054, "o", "> "]
[564.33521, "o", "        tickets_30d = int(mask_t.sum())\r\n\u001b[?2004l\r"]
[564.33526, "o", "\u001b[?2004h> "]
[564.335407, "o", "        # days since last order\r\n\u001b[?2004l\r"]
[564.335455, "o", "\u001b[?2004h> "]
[564.335721, "o", "        past_orders = orders[orders[\"ordered_at\"] < as_of]\r\n\u001b[?2004l\r"]
[564.335774, "o", "\u001b[?2004h> "]
[564.335923, "o", "        if not past_orders.empty:\r\n\u001b[?2004l\r"]
[564.335991, "o", "\u001b[?2004h> "]
[564.336248, "o", "            last_order = past_orders[\"ordered_at\"].max()\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.336311, "o", "> "]
[564.336643, "o", "            days_since_last_order = (as_of - last_order).total_seconds() / 86400\r\n\u001b[?2004l\r"]
[564.336701, "o", "\u001b[?2004h> "]
[564.336745, "o", "        else:\r\n\u001b[?2004l\r"]
[564.336799, "o", "\u001b[?2004h> "]
[564.337005, "o", "            days_since_last_order = np.nan\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.337056, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[564.337102, "o", "> "]
[564.337316, "o", "        # tenure, status, plan, days since login\r\n\u001b[?2004l\r"]
[564.33737, "o", "\u001b[?2004h> "]
[564.337665, "o", "        tenure = tenure_days(pd.DataFrame([pt]), customers).iloc[0]\r\n\u001b[?2004l\r"]
[564.337722, "o", "\u001b[?2004h> "]
[564.338058, "o", "        status = latest_status(pd.DataFrame([pt]), status_snapshots).iloc[0]\r\n\u001b[?2004l\r"]
[564.33811, "o", "\u001b[?2004h> "]
[564.338378, "o", "        plan_val = plan(pd.DataFrame([pt]), customers).iloc[0]\r\n\u001b[?2004l\r"]
[564.338424, "o", "\u001b[?2004h> "]
[564.338784, "o", "        dlast_login = days_since_last_login(pd.DataFrame([pt]), customers).iloc[0]\r\n\u001b[?2004l\r"]
[564.33883, "o", "\u001b[?2004h> "]
[564.339185, "o", "        te_district = _district_encoding_point(pt, labels, customers_full)\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.339247, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.339358, "o", "        rows.append({\r\n\u001b[?2004l\r"]
[564.339407, "o", "\u001b[?2004h> "]
[564.339619, "o", "            \"customer_id\": pt[\"customer_id\"],\r\n\u001b[?2004l\r"]
[564.339644, "o", "\u001b[?2004h> "]
[564.339791, "o", "            \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[564.339834, "o", "\u001b[?2004h> "]
[564.340009, "o", "            \"orders_7d\": orders_7d,\r\n\u001b[?2004l\r"]
[564.340055, "o", "\u001b[?2004h> "]
[564.340223, "o", "            \"orders_30d\": orders_30d,\r\n\u001b[?2004l\r"]
[564.340271, "o", "\u001b[?2004h> "]
[564.340487, "o", "            \"spend_30d_cents\": spend_30d_cents,\r\n\u001b[?2004l\r"]
[564.340542, "o", "\u001b[?2004h> "]
[564.340715, "o", "            \"tickets_30d\": tickets_30d,\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.340769, "o", "> "]
[564.341038, "o", "            \"days_since_last_order\": days_since_last_order,\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.3411, "o", "> "]
[564.341269, "o", "            \"tenure_days\": float(tenure),\r\n\u001b[?2004l\r"]
[564.341322, "o", "\u001b[?2004h> "]
[564.341606, "o", "            \"status\": status if not pd.isna(status) else np.nan,\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.341663, "o", "> "]
[564.341777, "o", "            \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[564.341826, "o", "\u001b[?2004h> "]
[564.342066, "o", "            \"days_since_last_login\": dlast_login,\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.342134, "o", "> "]
[564.34239, "o", "            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n\u001b[?2004l\r"]
[564.342471, "o", "\u001b[?2004h> "]
[564.342644, "o", "            \"te_district\": float(te_district),\r\n\u001b[?2004l\r"]
[564.342693, "o", "\u001b[?2004h> "]
[564.342736, "o", "        })\r\n\u001b[?2004l\r"]
[564.342809, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[564.342865, "o", "\u001b[?2004h> "]
[564.34298, "o", "    df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[564.343037, "o", "\u001b[?2004h> "]
[564.343246, "o", "    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n\u001b[?2004l\r"]
[564.343301, "o", "\u001b[?2004h> "]
[564.343554, "o", "    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
[564.343607, "o", "\u001b[?2004h> "]
[564.343655, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.343702, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.343755, "o", "def main():\r\n\u001b[?2004l\r"]
[564.343797, "o", "\u001b[?2004h"]
[564.34384, "o", "> "]
[564.344072, "o", "    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[564.344099, "o", "\u001b[?2004h> "]
[564.344501, "o", "    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.344556, "o", "> "]
[564.344856, "o", "    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[564.344902, "o", "\u001b[?2004h> "]
[564.345043, "o", "    args = ap.parse_args()\r\n\u001b[?2004l\r"]
[564.345068, "o", "\u001b[?2004h> "]
[564.345227, "o", "    feats = build(args.data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.34532, "o", "> "]
[564.345606, "o", "    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\r\n\u001b[?2004l\r"]
[564.345665, "o", "\u001b[?2004h> "]
[564.345862, "o", "    feats.to_parquet(args.out, index=False)\r\n\u001b[?2004l\r"]
[564.345907, "o", "\u001b[?2004h> "]
[564.3463, "o", "    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[564.346362, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[564.346507, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[564.346559, "o", "\u001b[?2004h> "]
[564.346604, "o", "    main()\r\n\u001b[?2004l\r"]
