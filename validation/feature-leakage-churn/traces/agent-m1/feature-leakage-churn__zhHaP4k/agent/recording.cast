[426.321184, "o", "+        n = district_mask.sum()\r\n\u001b[?2004l\r"]
[426.321209, "o", "\u001b[?2004h> "]
[426.321377, "o", "+        s = lab_closed.loc[district_mask, \"churned_30d\"].sum()\r\n\u001b[?2004l\r"]
[426.321399, "o", "\u001b[?2004h> "]
[426.32142, "o", "+\r\n\u001b[?2004l\r"]
[426.321444, "o", "\u001b[?2004h> "]
[426.321594, "o", "+    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)\r\n\u001b[?2004l\r"]
[426.321616, "o", "\u001b[?2004h> +\r\n"]
[426.321638, "o", "\u001b[?2004l\r\u001b[?2004h"]
[426.321657, "o", "> "]
[426.321679, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[426.321699, "o", "> "]
[426.321809, "o", "+def build(data_dir: str) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[426.32183, "o", "\u001b[?2004h> "]
[426.322007, "o", "+    \"\"\"Build the feature table for the given extract directory.\r\n\u001b[?2004l\r"]
[426.322031, "o", "\u001b[?2004h> "]
[426.322048, "o", "+\r\n\u001b[?2004l\r"]
[426.322067, "o", "\u001b[?2004h> "]
[426.322313, "o", "+    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n\u001b[?2004l\r"]
[426.322344, "o", "\u001b[?2004h> "]
[426.322397, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[426.322497, "o", "+    tables = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[426.322517, "o", "\u001b[?2004h"]
[426.322535, "o", "> "]
[426.322684, "o", "+    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[426.322705, "o", "\u001b[?2004h> "]
[426.322724, "o", "+\r\n\u001b[?2004l\r"]
[426.322743, "o", "\u001b[?2004h> "]
[426.322856, "o", "+    customers_full = tables[\"customers\"]\r\n\u001b[?2004l\r"]
[426.322875, "o", "\u001b[?2004h> "]
[426.322996, "o", "+    labels_full = tables[\"labels\"]\r\n\u001b[?2004l\r"]
[426.323015, "o", "\u001b[?2004h> "]
[426.323114, "o", "+    orders_full = tables[\"orders\"]\r\n\u001b[?2004l\r"]
[426.323134, "o", "\u001b[?2004h> "]
[426.323241, "o", "+    tickets_full = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[426.323258, "o", "\u001b[?2004h"]
[426.323278, "o", "> "]
[426.32339, "o", "+    status_full = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[426.32341, "o", "\u001b[?2004h> "]
[426.323427, "o", "+\r\n\u001b[?2004l\r"]
[426.323444, "o", "\u001b[?2004h"]
[426.323464, "o", "> "]
[426.32353, "o", "+    rows: List[dict] = []\r\n\u001b[?2004l\r"]
[426.323548, "o", "\u001b[?2004h> "]
[426.323652, "o", "+    for _, pt in points.iterrows():\r\n\u001b[?2004l\r"]
[426.323669, "o", "\u001b[?2004h> "]
[426.323756, "o", "+        as_of = pt[\"as_of\"]\r\n\u001b[?2004l\r"]
[426.323772, "o", "\u001b[?2004h> "]
[426.323788, "o", "+\r\n"]
[426.323806, "o", "\u001b[?2004l\r"]
[426.323822, "o", "\u001b[?2004h> "]
[426.323973, "o", "+        orders = _filter_by_loaded(orders_full, as_of)\r\n\u001b[?2004l\r"]
[426.323996, "o", "\u001b[?2004h"]
[426.324015, "o", "> "]
[426.324148, "o", "+        tickets = _filter_by_loaded(tickets_full, as_of)\r\n\u001b[?2004l\r"]
[426.324171, "o", "\u001b[?2004h> "]
[426.324342, "o", "+        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n\u001b[?2004l\r"]
[426.324361, "o", "\u001b[?2004h> "]
[426.324524, "o", "+        customers = _filter_by_loaded(customers_full, as_of)\r\n\u001b[?2004l\r"]
[426.324543, "o", "\u001b[?2004h> "]
[426.324693, "o", "+        labels = _filter_by_loaded(labels_full, as_of)\r\n\u001b[?2004l\r"]
[426.324715, "o", "\u001b[?2004h"]
[426.324733, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[426.324753, "o", "> "]
[426.324954, "o", "+        single_point = pt.to_frame().T\r\n\u001b[?2004l\r"]
[426.324975, "o", "\u001b[?2004h"]
[426.324994, "o", "> "]
[426.325153, "o", "+        act = activity_features(single_point, orders, tickets)\r\n\u001b[?2004l\r"]
[426.325171, "o", "\u001b[?2004h> "]
[426.325321, "o", "+        tenure = tenure_days(single_point, customers)\r\n\u001b[?2004l\r"]
[426.325341, "o", "\u001b[?2004h> "]
[426.325506, "o", "+        status = latest_status(single_point, status_snapshots)\r\n\u001b[?2004l\r"]
[426.325523, "o", "\u001b[?2004h> "]
[426.32554, "o", "+\r\n\u001b[?2004l\r"]
[426.325557, "o", "\u001b[?2004h"]
[426.325574, "o", "> "]
[426.325718, "o", "+        plan_val = plan(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[426.325741, "o", "\u001b[?2004h"]
[426.325759, "o", "> "]
[426.325958, "o", "+        dlast_login = days_since_last_login(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[426.32598, "o", "\u001b[?2004h"]
[426.325998, "o", "> "]
[426.326177, "o", "+        te_district = _district_encoding_point(pt, labels, customers_full)\r\n\u001b[?2004l\r"]
[426.326195, "o", "\u001b[?2004h> "]
[426.326212, "o", "+\r\n\u001b[?2004l\r"]
[426.326231, "o", "\u001b[?2004h"]
[426.326248, "o", "> "]
[426.326307, "o", "+        rows.append({\r\n\u001b[?2004l\r"]
[426.326327, "o", "\u001b[?2004h> "]
[426.326454, "o", "+            \"customer_id\": pt[\"customer_id\"],\r\n\u001b[?2004l\r"]
[426.326471, "o", "\u001b[?2004h> "]
[426.326557, "o", "+            \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[426.326575, "o", "\u001b[?2004h> "]
[426.326727, "o", "+            \"orders_7d\": int(act[\"orders_7d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[426.326745, "o", "\u001b[?2004h> "]
[426.326904, "o", "+            \"orders_30d\": int(act[\"orders_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[426.326926, "o", "\u001b[?2004h"]
[426.326953, "o", "> "]
[426.327119, "o", "+            \"spend_30d_cents\": int(act[\"spend_30d_cents\"].iloc[0]),\r\n\u001b[?2004l\r"]
[426.327136, "o", "\u001b[?2004h"]
[426.327154, "o", "> "]
[426.327308, "o", "+            \"tickets_30d\": int(act[\"tickets_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[426.327327, "o", "\u001b[?2004h> "]
[426.327527, "o", "+            \"days_since_last_order\": act[\"days_since_last_order\"].iloc[0],\r\n\u001b[?2004l\r"]
[426.327545, "o", "\u001b[?2004h"]
[426.327566, "o", "> "]
[426.327688, "o", "+            \"tenure_days\": float(tenure.iloc[0]),\r\n\u001b[?2004l\r"]
[426.327705, "o", "\u001b[?2004h"]
[426.327724, "o", "> "]
[426.327923, "o", "+            \"status\": status.iloc[0] if not pd.isna(status.iloc[0]) else np.nan,\r\n\u001b[?2004l\r"]
[426.327953, "o", "\u001b[?2004h> "]
[426.328043, "o", "+            \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[426.328059, "o", "\u001b[?2004h"]
[426.328075, "o", "> "]
[426.328203, "o", "+            \"days_since_last_login\": dlast_login,\r\n\u001b[?2004l\r"]
[426.328218, "o", "\u001b[?2004h"]
[426.328234, "o", "> "]
[426.328397, "o", "+            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n\u001b[?2004l\r"]
[426.328414, "o", "\u001b[?2004h> "]
[426.328546, "o", "+            \"te_district\": float(te_district),\r\n\u001b[?2004l\r"]
[426.328563, "o", "\u001b[?2004h"]
[426.328579, "o", "> "]
[426.328611, "o", "+        })\r\n\u001b[?2004l\r"]
[426.328629, "o", "\u001b[?2004h"]
[426.328645, "o", "> "]
[426.328661, "o", "+\r\n\u001b[?2004l\r"]
[426.328676, "o", "\u001b[?2004h> "]
[426.328757, "o", "+    df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[426.328773, "o", "\u001b[?2004h"]
[426.328788, "o", "> "]
[426.328915, "o", "+    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n\u001b[?2004l\r"]
[426.328931, "o", "\u001b[?2004h"]
[426.328954, "o", "> "]
[426.329101, "o", "+    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
[426.329121, "o", "\u001b[?2004h"]
[426.329135, "o", "> "]
[426.329151, "o", "+\r\n\u001b[?2004l\r"]
[426.329175, "o", "\u001b[?2004h"]
[426.32919, "o", "> +\r\n\u001b[?2004l\r"]
[426.329206, "o", "\u001b[?2004h"]
[426.329221, "o", "> "]
[426.329253, "o", "+def main():\r\n\u001b[?2004l\r"]
[426.32927, "o", "\u001b[?2004h"]
[426.329286, "o", "> "]
[426.329426, "o", "+    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[426.329442, "o", "\u001b[?2004h> "]
[426.329659, "o", "+    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[426.329674, "o", "\u001b[?2004h> "]
[426.329865, "o", "+    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[426.32988, "o", "\u001b[?2004h"]
[426.329898, "o", "> "]
[426.329979, "o", "+    args = ap.parse_args()\r\n\u001b[?2004l\r"]
[426.33, "o", "\u001b[?2004h> "]
[426.330086, "o", "+    feats = build(args.data)\r\n\u001b[?2004l\r"]
[426.330107, "o", "\u001b[?2004h> "]
[426.330303, "o", "+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\r\n\u001b[?2004l\r"]
[426.330318, "o", "\u001b[?2004h"]
[426.330336, "o", "> "]
[426.330447, "o", "+    feats.to_parquet(args.out, index=False)\r\n\u001b[?2004l\r"]
[426.330464, "o", "\u001b[?2004h"]
[426.330481, "o", "> "]
[426.330685, "o", "+    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\r\n\u001b[?2004l\r"]
[426.330702, "o", "\u001b[?2004h> "]
[426.330716, "o", "+\r\n\u001b[?2004l\r"]
[426.330732, "o", "\u001b[?2004h"]
[426.330748, "o", "> "]
[426.330766, "o", "+\r\n\u001b[?2004l\r"]
[426.330784, "o", "\u001b[?2004h> "]
[426.330863, "o", "+if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[426.33088, "o", "\u001b[?2004h"]
[426.330895, "o", "> "]
[426.33093, "o", "+    main()\r\n\u001b[?2004l\r"]
