[426.330998, "o", "\u001b[?2004h"]
[426.331013, "o", "> "]
[427.818555, "i", "python test_build.py\n"]
[427.818682, "o", "python test_build.py\r\n"]
[427.818705, "o", "\u001b[?2004l\r"]
[427.81873, "o", "\u001b[?2004h"]
