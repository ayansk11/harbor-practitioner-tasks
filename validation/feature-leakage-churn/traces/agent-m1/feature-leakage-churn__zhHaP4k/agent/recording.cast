[494.754989, "o", "    if pd.isna(district):\r\n\u001b[?2004l\r"]
[494.75503, "o", "\u001b[?2004h"]
[494.755071, "o", "> "]
[494.755165, "o", "        n = 0\r\n\u001b[?2004l\r"]
[494.755205, "o", "\u001b[?2004h"]
[494.755247, "o", "> "]
[494.755339, "o", "        s = 0\r\n\u001b[?2004l\r"]
[494.755379, "o", "\u001b[?2004h"]
[494.755424, "o", "> "]
[494.755484, "o", "    else:\r\n\u001b[?2004l\r"]
[494.755527, "o", "\u001b[?2004h"]
[494.755571, "o", "> "]
[494.756181, "o", "        cust_district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[494.756227, "o", "\u001b[?2004h"]
[494.756272, "o", "> "]
[494.756671, "o", "        lab_district = lab_closed[\"customer_id\"].map(cust_district)\r\n\u001b[?2004l\r"]
[494.756718, "o", "\u001b[?2004h> "]
[494.757034, "o", "        district_mask = lab_district == district\r\n\u001b[?2004l\r"]
[494.757087, "o", "\u001b[?2004h"]
[494.757124, "o", "> "]
[494.757281, "o", "        n = district_mask.sum()\r\n\u001b[?2004l\r"]
[494.75733, "o", "\u001b[?2004h"]
[494.757376, "o", "> "]
[494.757711, "o", "        s = lab_closed.loc[district_mask, \"churned_30d\"].sum()\r\n\u001b[?2004l\r"]
[494.757748, "o", "\u001b[?2004h"]
[494.757783, "o", "> \r\n"]
[494.757818, "o", "\u001b[?2004l\r\u001b[?2004h"]
[494.757853, "o", "> "]
[494.758192, "o", "    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)\r\n\u001b[?2004l\r"]
[494.758249, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.758292, "o", "\u001b[?2004h"]
[494.758339, "o", "> \r\n\u001b[?2004l\r"]
[494.758377, "o", "\u001b[?2004h> "]
[494.758605, "o", "def build(data_dir: str) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[494.758654, "o", "\u001b[?2004h"]
[494.7587, "o", "> "]
[494.759065, "o", "    \"\"\"Build the feature table for the given extract directory.\r\n\u001b[?2004l\r"]
[494.75908, "o", "\u001b[?2004h"]
[494.759135, "o", "> \r\n\u001b[?2004l\r"]
[494.759174, "o", "\u001b[?2004h"]
[494.759223, "o", "> "]
[494.759748, "o", "    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n\u001b[?2004l\r"]
[494.759793, "o", "\u001b[?2004h"]
[494.759837, "o", "> "]
[494.759872, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[494.759916, "o", "\u001b[?2004h"]
[494.75997, "o", "> "]
[494.760136, "o", "    tables = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[494.760188, "o", "\u001b[?2004h"]
[494.760212, "o", "> "]
[494.760551, "o", "    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[494.760596, "o", "\u001b[?2004h"]
[494.760636, "o", "> \r\n\u001b[?2004l\r"]
[494.760676, "o", "\u001b[?2004h> "]
[494.760905, "o", "    customers_full = tables[\"customers\"]\r\n\u001b[?2004l\r"]
[494.760961, "o", "\u001b[?2004h"]
[494.76101, "o", "> "]
[494.761183, "o", "    labels_full = tables[\"labels\"]\r\n\u001b[?2004l\r"]
[494.761233, "o", "\u001b[?2004h> "]
[494.761446, "o", "    orders_full = tables[\"orders\"]\r\n\u001b[?2004l\r"]
[494.761492, "o", "\u001b[?2004h"]
[494.761528, "o", "> "]
[494.761722, "o", "    tickets_full = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[494.761769, "o", "\u001b[?2004h"]
[494.76181, "o", "> "]
[494.762081, "o", "    status_full = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.762122, "o", "> \r\n\u001b[?2004l\r"]
[494.76216, "o", "\u001b[?2004h"]
[494.762194, "o", "> "]
[494.762316, "o", "    rows: List[dict] = []\r\n\u001b[?2004l\r"]
[494.762349, "o", "\u001b[?2004h"]
[494.762385, "o", "> "]
[494.762589, "o", "    for _, pt in points.iterrows():\r\n\u001b[?2004l\r"]
[494.762628, "o", "\u001b[?2004h"]
[494.76266, "o", "> "]
[494.762815, "o", "        as_of = pt[\"as_of\"]\r\n\u001b[?2004l\r"]
[494.762852, "o", "\u001b[?2004h"]
[494.762884, "o", "> \r\n\u001b[?2004l\r"]
[494.762921, "o", "\u001b[?2004h"]
[494.762968, "o", "> "]
[494.763267, "o", "        orders = _filter_by_loaded(orders_full, as_of)\r\n\u001b[?2004l\r"]
[494.763304, "o", "\u001b[?2004h"]
[494.763335, "o", "> "]
[494.763651, "o", "        tickets = _filter_by_loaded(tickets_full, as_of)\r\n\u001b[?2004l\r"]
[494.763687, "o", "\u001b[?2004h"]
[494.763724, "o", "> "]
[494.764107, "o", "        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n\u001b[?2004l\r"]
[494.764159, "o", "\u001b[?2004h> "]
[494.764517, "o", "        customers = _filter_by_loaded(customers_full, as_of)\r\n\u001b[?2004l\r"]
[494.764552, "o", "\u001b[?2004h"]
[494.76457, "o", "> "]
[494.764927, "o", "        labels = _filter_by_loaded(labels_full, as_of)\r\n\u001b[?2004l\r"]
[494.765007, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.765063, "o", "\u001b[?2004h> "]
[494.765321, "o", "        single_point = pt.to_frame().T\r\n\u001b[?2004l\r"]
[494.765374, "o", "\u001b[?2004h> "]
[494.765775, "o", "        act = activity_features(single_point, orders, tickets)\r\n\u001b[?2004l\r"]
[494.765844, "o", "\u001b[?2004h> "]
[494.766191, "o", "        tenure = tenure_days(single_point, customers)\r\n\u001b[?2004l\r"]
[494.76624, "o", "\u001b[?2004h"]
[494.766275, "o", "> "]
[494.766652, "o", "        status = latest_status(single_point, status_snapshots)\r\n\u001b[?2004l\r"]
[494.766701, "o", "\u001b[?2004h"]
[494.766749, "o", "> \r\n\u001b[?2004l\r"]
[494.766784, "o", "\u001b[?2004h"]
[494.766816, "o", "> "]
[494.767162, "o", "        plan_val = plan(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[494.767213, "o", "\u001b[?2004h"]
[494.767244, "o", "> "]
[494.767705, "o", "        dlast_login = days_since_last_login(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[494.767748, "o", "\u001b[?2004h"]
[494.76779, "o", "> "]
[494.768297, "o", "        te_district = _district_encoding_point(pt, labels, customers_full)\r\n\u001b[?2004l\r"]
[494.768363, "o", "\u001b[?2004h"]
[494.768401, "o", "> \r\n\u001b[?2004l\r"]
[494.768435, "o", "\u001b[?2004h> "]
[494.768574, "o", "        rows.append({\r\n\u001b[?2004l\r"]
[494.768613, "o", "\u001b[?2004h"]
[494.768645, "o", "> "]
[494.768932, "o", "            \"customer_id\": pt[\"customer_id\"],\r\n\u001b[?2004l\r"]
[494.768988, "o", "\u001b[?2004h"]
[494.769019, "o", "> "]
[494.769193, "o", "            \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[494.769232, "o", "\u001b[?2004h"]
[494.769267, "o", "> "]
[494.769608, "o", "            \"orders_7d\": int(act[\"orders_7d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[494.769646, "o", "\u001b[?2004h"]
[494.769681, "o", "> "]
[494.770047, "o", "            \"orders_30d\": int(act[\"orders_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[494.770095, "o", "\u001b[?2004h"]
[494.770127, "o", "> "]
[494.770542, "o", "            \"spend_30d_cents\": int(act[\"spend_30d_cents\"].iloc[0]),\r\n\u001b[?2004l\r"]
[494.770581, "o", "\u001b[?2004h"]
[494.770613, "o", "> "]
[494.770993, "o", "            \"tickets_30d\": int(act[\"tickets_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[494.771042, "o", "\u001b[?2004h> "]
[494.771513, "o", "            \"days_since_last_order\": act[\"days_since_last_order\"].iloc[0],\r\n\u001b[?2004l\r"]
[494.771562, "o", "\u001b[?2004h"]
[494.771597, "o", "> "]
[494.771892, "o", "            \"tenure_days\": float(tenure.iloc[0]),\r\n\u001b[?2004l\r"]
[494.771954, "o", "\u001b[?2004h"]
[494.771989, "o", "> "]
[494.772478, "o", "            \"status\": status.iloc[0] if not pd.isna(status.iloc[0]) else np.nan,\r\n\u001b[?2004l\r"]
[494.772527, "o", "\u001b[?2004h> "]
[494.772731, "o", "            \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[494.772769, "o", "\u001b[?2004h"]
[494.772813, "o", "> "]
[494.773136, "o", "            \"days_since_last_login\": dlast_login,\r\n\u001b[?2004l\r"]
[494.773183, "o", "\u001b[?2004h"]
[494.773218, "o", "> "]
[494.773592, "o", "            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n\u001b[?2004l\r"]
[494.773641, "o", "\u001b[?2004h> "]
[494.773954, "o", "            \"te_district\": float(te_district),\r\n\u001b[?2004l\r"]
[494.774007, "o", "\u001b[?2004h> "]
[494.774098, "o", "        })\r\n\u001b[?2004l\r"]
[494.774137, "o", "\u001b[?2004h"]
[494.774182, "o", "> "]
[494.77422, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.774258, "o", "> "]
[494.774425, "o", "    df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[494.774462, "o", "\u001b[?2004h"]
[494.774494, "o", "> "]
[494.774806, "o", "    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n\u001b[?2004l\r"]
[494.774854, "o", "\u001b[?2004h"]
[494.774869, "o", "> "]
[494.775255, "o", "    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
[494.775303, "o", "\u001b[?2004h> "]
[494.775351, "o", "\r\n\u001b[?2004l\r"]
[494.775384, "o", "\u001b[?2004h"]
[494.775415, "o", "> \r\n\u001b[?2004l\r"]
[494.77545, "o", "\u001b[?2004h"]
[494.775481, "o", "> "]
[494.775557, "o", "def main():\r\n\u001b[?2004l\r"]
[494.775594, "o", "\u001b[?2004h"]
[494.775625, "o", "> "]
[494.775973, "o", "    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[494.776018, "o", "\u001b[?2004h"]
[494.776055, "o", "> "]
[494.77654, "o", "    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[494.77659, "o", "\u001b[?2004h> "]
[494.777072, "o", "    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[494.777088, "o", "\u001b[?2004h"]
[494.777153, "o", "> "]
[494.777314, "o", "    args = ap.parse_args()\r\n\u001b[?2004l\r"]
[494.777356, "o", "\u001b[?2004h"]
[494.777393, "o", "> "]
[494.777572, "o", "    feats = build(args.data)\r\n\u001b[?2004l\r"]
[494.777618, "o", "\u001b[?2004h"]
[494.777654, "o", "> "]
[494.778122, "o", "    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\r\n\u001b[?2004l\r"]
[494.778173, "o", "\u001b[?2004h"]
[494.77821, "o", "> "]
[494.778469, "o", "    feats.to_parquet(args.out, index=False)\r\n\u001b[?2004l\r"]
[494.778512, "o", "\u001b[?2004h"]
[494.778549, "o", "> "]
[494.779066, "o", "    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\r\n\u001b[?2004l\r"]
[494.779122, "o", "\u001b[?2004h> "]
[494.77916, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.779196, "o", "> "]
[494.779382, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[494.779425, "o", "\u001b[?2004h"]
[494.779464, "o", "> "]
[494.779519, "o", "    main()\r\n\u001b[?2004l\r"]
[494.779558, "o", "\u001b[?2004h"]
[494.779605, "o", "> "]
[494.779644, "o", "EOF\r\n\u001b[?2004l\r"]
