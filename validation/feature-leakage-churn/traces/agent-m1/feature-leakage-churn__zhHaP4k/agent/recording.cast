[113.137155, "o", "+    if cust_row.empty:\r\n\u001b[?2004l\r"]
[113.137202, "o", "\u001b[?2004h> "]
[113.137259, "o", "+        return np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.137409, "o", "+    district = cust_row.iloc[0][\"postcode_district\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.137459, "o", "> +\r\n\u001b[?2004l\r"]
[113.137493, "o", "\u001b[?2004h> "]
[113.137638, "o", "+    # Labels whose prediction window closed before the point's as_of\r\n\u001b[?2004l\r"]
[113.137684, "o", "\u001b[?2004h> "]
[113.137824, "o", "+    closed = labels[\"as_of\"] + pd.Timedelta(days=LABEL_WINDOW_DAYS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.137933, "o", "+    mask = closed < point[\"as_of\"]\r\n\u001b[?2004l\r"]
[113.137981, "o", "\u001b[?2004h> "]
[113.138037, "o", "+    lab_closed = labels[mask]\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.138075, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.138204, "o", "+    # Prior churn rate (overall) from closed labels\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.138241, "o", "> "]
[113.138308, "o", "+    if len(lab_closed) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.138398, "o", "+        prior = DEFAULT_PRIOR\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.138444, "o", "> +    else:\r\n\u001b[?2004l\r"]
[113.138486, "o", "\u001b[?2004h> "]
[113.138594, "o", "+        prior = lab_closed[\"churned_30d\"].mean()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.138639, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.138727, "o", "+    # District‑specific aggregates\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.138769, "o", "> "]
[113.138819, "o", "+    if pd.isna(district):\r\n\u001b[?2004l\r"]
[113.138864, "o", "\u001b[?2004h> "]
[113.138901, "o", "+        n = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.138933, "o", "+        s = 0\r\n\u001b[?2004l\r"]
[113.138994, "o", "\u001b[?2004h> +    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.139028, "o", "> "]
[113.139136, "o", "+        # Map each label to its customer's district\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.139173, "o", "> "]
[113.139356, "o", "+        cust_district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.139397, "o", "> "]
[113.139537, "o", "+        lab_district = lab_closed[\"customer_id\"].map(cust_district)\r\n\u001b[?2004l\r"]
[113.139574, "o", "\u001b[?2004h> "]
[113.139693, "o", "+        district_mask = lab_district == district\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.139792, "o", "+        n = district_mask.sum()\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.139828, "o", "> "]
[113.139982, "o", "+        s = lab_closed.loc[district_mask, \"churned_30d\"].sum()\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[113.140021, "o", "\u001b[?2004h> "]
[113.140158, "o", "+    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.140197, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.140232, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.140338, "o", "+def build(data_dir: str) -> pd.DataFrame:\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.140375, "o", "> "]
[113.140521, "o", "+    \"\"\"Build the feature table for the given extract directory.\r\n\u001b[?2004l\r"]
[113.140558, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.140808, "o", "+    The returned DataFrame contains exactly one row per row of ``scoring_points.csv`` and the columns\r\n\u001b[?2004l\r"]
[113.140837, "o", "\u001b[?2004h> "]
[113.141082, "o", "+    ``customer_id``, ``as_of`` followed by the 11 feature columns defined in ``FEATURE_COLUMNS``.\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.141131, "o", "> "]
[113.141178, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.141236, "o", "+    tables = load_extract(data_dir)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.141278, "o", "> "]
[113.141405, "o", "+    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.141428, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.14147, "o", "> "]
[113.141576, "o", "+    # Pre‑extract static tables for faster lookup\r\n\u001b[?2004l\r"]
[113.141615, "o", "\u001b[?2004h> "]
[113.141696, "o", "+    customers_full = tables[\"customers\"]\r\n\u001b[?2004l\r"]
[113.141804, "o", "\u001b[?2004h> "]
[113.141833, "o", "+    labels_full = tables[\"labels\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.141918, "o", "+    orders_full = tables[\"orders\"]\r\n\u001b[?2004l\r"]
[113.141956, "o", "\u001b[?2004h> "]
[113.142036, "o", "+    tickets_full = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[113.142064, "o", "\u001b[?2004h> "]
[113.142172, "o", "+    status_full = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[113.142193, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[113.142222, "o", "\u001b[?2004h> "]
[113.142287, "o", "+    rows: List[dict] = []\r\n\u001b[?2004l\r"]
[113.142315, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[113.142343, "o", "\u001b[?2004h> "]
[113.142425, "o", "+    for _, pt in points.iterrows():\r\n\u001b[?2004l\r"]
[113.142459, "o", "\u001b[?2004h> "]
[113.142517, "o", "+        as_of = pt[\"as_of\"]\r\n\u001b[?2004l\r"]
[113.142545, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[113.142574, "o", "\u001b[?2004h> "]
[113.142707, "o", "+        # Filter each table to rows visible at this as_of\r\n\u001b[?2004l\r"]
[113.142736, "o", "\u001b[?2004h> "]
[113.142871, "o", "+        orders = _filter_by_loaded(orders_full, as_of)\r\n\u001b[?2004l\r"]
[113.142892, "o", "\u001b[?2004h> "]
[113.143039, "o", "+        tickets = _filter_by_loaded(tickets_full, as_of)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.143091, "o", "> "]
[113.143228, "o", "+        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.143271, "o", "> "]
[113.143394, "o", "+        customers = _filter_by_loaded(customers_full, as_of)\r\n\u001b[?2004l\r"]
[113.143423, "o", "\u001b[?2004h> "]
[113.143549, "o", "+        labels = _filter_by_loaded(labels_full, as_of)\r\n\u001b[?2004l\r"]
[113.143584, "o", "\u001b[?2004h> +\r\n"]
[113.14362, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[113.143817, "o", "+        # Activity windows – reuse the vectorised helpers on a single‑row DataFrame\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.143854, "o", "> "]
[113.143967, "o", "+        single_point = pt.to_frame().T\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.144006, "o", "> "]
[113.144123, "o", "+        act = activity_features(single_point, orders, tickets)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.14416, "o", "> "]
[113.144392, "o", "+        # tenure and status use helpers that operate on the full points DataFrame; we call them directly\r\n\u001b[?2004l\r"]
[113.14443, "o", "\u001b[?2004h> "]
[113.144549, "o", "+        tenure = tenure_days(single_point, customers)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.144585, "o", "> "]
[113.144723, "o", "+        status = latest_status(single_point, status_snapshots)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.144757, "o", "> +\r\n\u001b[?2004l\r"]
[113.144788, "o", "\u001b[?2004h> "]
[113.144841, "o", "+        # Customer attributes\r\n\u001b[?2004l\r"]
[113.144874, "o", "\u001b[?2004h> "]
[113.145012, "o", "+        plan_val = plan(single_point, customers).iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.145035, "o", "> "]
[113.145218, "o", "+        dlast_login = days_since_last_login(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[113.145251, "o", "\u001b[?2004h> +\r\n"]
[113.145281, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[113.145378, "o", "+        # District encoding (te_district)\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.145409, "o", "> "]
[113.145565, "o", "+        te_district = _district_encoding_point(pt, labels, customers_full)\r\n\u001b[?2004l\r"]
[113.145574, "o", "\u001b[?2004h"]
[113.145609, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.145666, "o", "+        rows.append(\r\n\u001b[?2004l\r"]
[113.145698, "o", "\u001b[?2004h> "]
[113.145729, "o", "+            {\r\n\u001b[?2004l\r"]
[113.145738, "o", "\u001b[?2004h"]
[113.145783, "o", "> "]
[113.145873, "o", "+                \"customer_id\": pt[\"customer_id\"],\r\n\u001b[?2004l\r"]
[113.145904, "o", "\u001b[?2004h> "]
[113.145981, "o", "+                \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[113.146015, "o", "\u001b[?2004h> "]
[113.146147, "o", "+                \"orders_7d\": int(act[\"orders_7d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[113.146155, "o", "\u001b[?2004h"]
[113.146191, "o", "> "]
[113.14632, "o", "+                \"orders_30d\": int(act[\"orders_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[113.146352, "o", "\u001b[?2004h> "]
[113.146515, "o", "+                \"spend_30d_cents\": int(act[\"spend_30d_cents\"].iloc[0]),\r\n\u001b[?2004l\r"]
[113.146545, "o", "\u001b[?2004h> "]
[113.14669, "o", "+                \"tickets_30d\": int(act[\"tickets_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[113.146698, "o", "\u001b[?2004h"]
[113.146731, "o", "> "]
[113.146901, "o", "+                \"days_since_last_order\": act[\"days_since_last_order\"].iloc[0],\r\n\u001b[?2004l\r"]
[113.146909, "o", "\u001b[?2004h"]
[113.146958, "o", "> "]
[113.147059, "o", "+                \"tenure_days\": float(tenure.iloc[0]),\r\n\u001b[?2004l\r"]
[113.147091, "o", "\u001b[?2004h> "]
[113.147312, "o", "+                \"status\": status.iloc[0] if not pd.isna(status.iloc[0]) else np.nan,\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.147361, "o", "> "]
[113.147414, "o", "+                \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[113.147427, "o", "\u001b[?2004h"]
[113.147512, "o", "> "]
[113.147578, "o", "+                \"days_since_last_login\": dlast_login,\r\n\u001b[?2004l\r"]
[113.147612, "o", "\u001b[?2004h"]
[113.147644, "o", "> "]
[113.147763, "o", "+                \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n\u001b[?2004l\r"]
[113.147795, "o", "\u001b[?2004h"]
[113.147828, "o", "> "]
[113.147909, "o", "+                \"te_district\": float(te_district),\r\n\u001b[?2004l\r"]
[113.147937, "o", "\u001b[?2004h"]
[113.147951, "o", "> "]
[113.147988, "o", "+            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.148021, "o", "+        )\r\n\u001b[?2004l\r"]
[113.14805, "o", "\u001b[?2004h"]
[113.148079, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.148107, "o", "> "]
[113.14814, "o", "+    df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[113.148167, "o", "\u001b[?2004h"]
[113.148195, "o", "> "]
[113.148342, "o", "+    # Forward‑fill missing app minutes exactly as the live service does\r\n\u001b[?2004l\r"]
[113.148372, "o", "\u001b[?2004h"]
[113.148401, "o", "> "]
[113.14848, "o", "+    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n\u001b[?2004l\r"]
[113.148509, "o", "\u001b[?2004h"]
[113.148537, "o", "> "]
[113.148635, "o", "+    # Ensure column order matches the specification\r\n\u001b[?2004l\r"]
[113.148664, "o", "\u001b[?2004h"]
[113.148691, "o", "> "]
[113.148804, "o", "+    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
[113.148833, "o", "\u001b[?2004h"]
[113.14886, "o", "> "]
[113.14888, "o", "*** End Patch\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.148907, "o", "> PATCH\r\n\u001b[?2004l\r"]
[113.149501, "o", "bash: apply_patch: command not found\r\n"]
[113.149869, "o", "\u001b[?2004h"]
[113.149891, "o", "root@d3fb963f-799d-49a1-9198-0b54c841fac5:/app# "]
