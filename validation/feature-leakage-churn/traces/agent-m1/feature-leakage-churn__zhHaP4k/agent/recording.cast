[152.64426, "o", "+def build(data_dir: str) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[152.644312, "o", "\u001b[?2004h> "]
[152.644655, "o", "+    \"\"\"Build the feature table for the given extract directory.\r\n\u001b[?2004l\r"]
[152.644695, "o", "\u001b[?2004h"]
[152.644742, "o", "> +\r\n\u001b[?2004l\r"]
[152.644759, "o", "\u001b[?2004h"]
[152.644821, "o", "> "]
[152.64532, "o", "+    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n\u001b[?2004l\r"]
[152.645363, "o", "\u001b[?2004h"]
[152.645401, "o", "> "]
[152.645458, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[152.645494, "o", "\u001b[?2004h> "]
[152.645697, "o", "+    tables = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[152.64577, "o", "\u001b[?2004h> "]
[152.646158, "o", "+    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[152.646204, "o", "\u001b[?2004h> "]
[152.646228, "o", "+"]
[152.646242, "o", "\r\n\u001b[?2004l\r"]
[152.646308, "o", "\u001b[?2004h> "]
[152.646597, "o", "+    customers_full = tables[\"customers\"]\r\n"]
[152.646609, "o", "\u001b[?2004l\r"]
[152.646678, "o", "\u001b[?2004h> "]
[152.646952, "o", "+    labels_full = tables[\"labels\"]\r\n"]
[152.646966, "o", "\u001b[?2004l\r"]
[152.647028, "o", "\u001b[?2004h"]
[152.647064, "o", "> "]
[152.647386, "o", "+    orders_full = tables[\"orders\"]\r\n"]
[152.647398, "o", "\u001b[?2004l\r"]
[152.647456, "o", "\u001b[?2004h> "]
[152.647754, "o", "+    tickets_full = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[152.647809, "o", "\u001b[?2004h"]
[152.647846, "o", "> "]
[152.648204, "o", "+    status_full = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[152.648261, "o", "\u001b[?2004h"]
[152.648298, "o", "> "]
[152.648333, "o", "+\r\n\u001b[?2004l\r"]
[152.64837, "o", "\u001b[?2004h"]
[152.648403, "o", "> "]
[152.648582, "o", "+    rows: List[dict] = []\r\n"]
[152.64862, "o", "\u001b[?2004l\r"]
[152.648655, "o", "\u001b[?2004h"]
[152.64869, "o", "> "]
[152.648934, "o", "+    for _, pt in points.iterrows():\r\n"]
[152.648984, "o", "\u001b[?2004l\r\u001b[?2004h"]
[152.649045, "o", "> "]
[152.649225, "o", "+        as_of = pt[\"as_of\"]\r\n"]
[152.649261, "o", "\u001b[?2004l\r"]
[152.649301, "o", "\u001b[?2004h"]
[152.649337, "o", "> +\r\n\u001b[?2004l\r"]
[152.649372, "o", "\u001b[?2004h"]
[152.649405, "o", "> "]
[152.649761, "o", "+        orders = _filter_by_loaded(orders_full, as_of)\r\n"]
[152.649796, "o", "\u001b[?2004l\r"]
[152.649829, "o", "\u001b[?2004h> "]
[152.650196, "o", "+        tickets = _filter_by_loaded(tickets_full, as_of)\r\n\u001b[?2004l\r"]
[152.650236, "o", "\u001b[?2004h"]
[152.650286, "o", "> "]
[152.650678, "o", "+        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n"]
[152.650718, "o", "\u001b[?2004l\r"]
[152.650759, "o", "\u001b[?2004h> "]
[152.651162, "o", "+        customers = _filter_by_loaded(customers_full, as_of)\r\n\u001b[?2004l\r"]
[152.6512, "o", "\u001b[?2004h"]
[152.651219, "o", "> "]
[152.651582, "o", "+        labels = _filter_by_loaded(labels_full, as_of)\r\n\u001b[?2004l\r"]
[152.65164, "o", "\u001b[?2004h> "]
[152.65169, "o", "+\r\n\u001b[?2004l\r"]
[152.65173, "o", "\u001b[?2004h"]
[152.651769, "o", "> "]
[152.652287, "o", "+        # Activity windows – reuse vectorised helper on a single‑row DataFrame\r\n\u001b[?2004l\r"]
[152.652334, "o", "\u001b[?2004h"]
[152.65235, "o", "> "]
[152.652615, "o", "+        single_point = pt.to_frame().T\r\n\u001b[?2004l\r"]
[152.652657, "o", "\u001b[?2004h"]
[152.652696, "o", "> "]
[152.6531, "o", "+        act = activity_features(single_point, orders, tickets)\r\n\u001b[?2004l\r"]
[152.653165, "o", "\u001b[?2004h> "]
[152.653511, "o", "+        tenure = tenure_days(single_point, customers)\r\n"]
[152.653549, "o", "\u001b[?2004l\r"]
[152.653586, "o", "\u001b[?2004h> "]
[152.654, "o", "+        status = latest_status(single_point, status_snapshots)\r\n\u001b[?2004l\r"]
[152.654049, "o", "\u001b[?2004h"]
[152.65409, "o", "> "]
[152.654106, "o", "+\r\n\u001b[?2004l\r"]
[152.654163, "o", "\u001b[?2004h"]
[152.654212, "o", "> "]
[152.654507, "o", "+        plan_val = plan(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[152.654546, "o", "\u001b[?2004h"]
[152.65458, "o", "> "]
[152.65497, "o", "+        dlast_login = days_since_last_login(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[152.655007, "o", "\u001b[?2004h"]
[152.655041, "o", "> "]
[152.655412, "o", "+        te_district = _district_encoding_point(pt, labels, customers_full)\r\n\u001b[?2004l\r"]
[152.655451, "o", "\u001b[?2004h"]
[152.655484, "o", "> "]
[152.655517, "o", "+\r\n\u001b[?2004l\r"]
[152.65555, "o", "\u001b[?2004h> "]
[152.655667, "o", "+        rows.append({\r\n\u001b[?2004l\r"]
[152.655704, "o", "\u001b[?2004h> "]
[152.655962, "o", "+            \"customer_id\": pt[\"customer_id\"],\r\n\u001b[?2004l\r"]
[152.656002, "o", "\u001b[?2004h"]
[152.656037, "o", "> "]
[152.65618, "o", "+            \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[152.656218, "o", "\u001b[?2004h"]
[152.656289, "o", "> "]
[152.656521, "o", "+            \"orders_7d\": int(act[\"orders_7d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[152.65656, "o", "\u001b[?2004h> "]
[152.656852, "o", "+            \"orders_30d\": int(act[\"orders_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[152.656891, "o", "\u001b[?2004h"]
[152.656924, "o", "> "]
[152.657259, "o", "+            \"spend_30d_cents\": int(act[\"spend_30d_cents\"].iloc[0]),\r\n\u001b[?2004l\r"]
[152.657299, "o", "\u001b[?2004h"]
[152.657333, "o", "> "]
[152.657612, "o", "+            \"tickets_30d\": int(act[\"tickets_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[152.657656, "o", "\u001b[?2004h"]
[152.657692, "o", "> "]
[152.658081, "o", "+            \"days_since_last_order\": act[\"days_since_last_order\"].iloc[0],\r\n\u001b[?2004l\r"]
[152.658128, "o", "\u001b[?2004h"]
[152.658161, "o", "> "]
[152.658391, "o", "+            \"tenure_days\": float(tenure.iloc[0]),\r\n\u001b[?2004l\r"]
[152.658426, "o", "\u001b[?2004h"]
[152.658458, "o", "> "]
[152.658825, "o", "+            \"status\": status.iloc[0] if not pd.isna(status.iloc[0]) else np.nan,\r\n\u001b[?2004l\r"]
[152.658866, "o", "\u001b[?2004h"]
[152.658911, "o", "> "]
[152.659063, "o", "+            \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[152.659116, "o", "\u001b[?2004h> "]
[152.65936, "o", "+            \"days_since_last_login\": dlast_login,\r\n\u001b[?2004l\r"]
[152.659401, "o", "\u001b[?2004h"]
[152.65941, "o", "> "]
[152.659713, "o", "+            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n"]
[152.659723, "o", "\u001b[?2004l\r"]
[152.659791, "o", "\u001b[?2004h> "]
[152.660027, "o", "+            \"te_district\": float(te_district),\r\n\u001b[?2004l\r"]
[152.660058, "o", "\u001b[?2004h"]
[152.660099, "o", "> "]
[152.660149, "o", "+        })\r\n"]
[152.660158, "o", "\u001b[?2004l\r"]
[152.660193, "o", "\u001b[?2004h"]
[152.660203, "o", "> "]
[152.660242, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.660278, "o", "> "]
[152.660419, "o", "+    df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[152.660444, "o", "\u001b[?2004h"]
[152.660478, "o", "> "]
[152.660712, "o", "+    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n\u001b[?2004l\r"]
[152.660743, "o", "\u001b[?2004h"]
[152.660752, "o", "> "]
[152.661054, "o", "+    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
[152.661084, "o", "\u001b[?2004h"]
[152.661093, "o", "> "]
[152.661129, "o", "+\r\n\u001b[?2004l\r"]
[152.661137, "o", "\u001b[?2004h"]
[152.66118, "o", "> +\r\n\u001b[?2004l\r"]
[152.661213, "o", "\u001b[?2004h> "]
[152.661301, "o", "+def main():\r\n\u001b[?2004l\r"]
[152.661326, "o", "\u001b[?2004h"]
[152.661338, "o", "> "]
[152.661624, "o", "+    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[152.661653, "o", "\u001b[?2004h"]
[152.661682, "o", "> "]
[152.662104, "o", "+    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[152.662134, "o", "\u001b[?2004h"]
[152.662142, "o", "> "]
[152.662514, "o", "+    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[152.662548, "o", "\u001b[?2004h> "]
[152.662709, "o", "+    args = ap.parse_args()\r\n"]
[152.662717, "o", "\u001b[?2004l\r"]
[152.662759, "o", "\u001b[?2004h> "]
[152.66292, "o", "+    feats = build(args.data)\r\n\u001b[?2004l\r"]
[152.66296, "o", "\u001b[?2004h"]
[152.662968, "o", "> "]
[152.663347, "o", "+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\r\n"]
[152.663356, "o", "\u001b[?2004l\r"]
[152.663387, "o", "\u001b[?2004h> "]
[152.663625, "o", "+    feats.to_parquet(args.out, index=False)\r\n\u001b[?2004l\r"]
[152.663668, "o", "\u001b[?2004h"]
[152.663706, "o", "> "]
[152.664182, "o", "+    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\r\n\u001b[?2004l\r"]
[152.664214, "o", "\u001b[?2004h"]
[152.664223, "o", "> "]
[152.664261, "o", "+\r\n\u001b[?2004l\r"]
[152.664297, "o", "\u001b[?2004h> "]
[152.664306, "o", "+\r\n\u001b[?2004l\r"]
[152.664346, "o", "\u001b[?2004h"]
[152.664357, "o", "> "]
[152.664506, "o", "+if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[152.664544, "o", "\u001b[?2004h"]
[152.664553, "o", "> "]
[152.664615, "o", "+    main()\r\n\u001b[?2004l\r"]
[152.66465, "o", "\u001b[?2004h> "]
[152.664687, "o", "+EOF\r\n\u001b[?2004l\r"]
[152.664721, "o", "\u001b[?2004h"]
[152.664729, "o", "> "]
