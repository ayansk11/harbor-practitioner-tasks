[496.801207, "o", "  File \"/app/test_build.py\", line 6, in <module>\r\n    df = bf.build('data')\r\n         ^^^^^^^^^^^^^^^^\r\n  File \"/app/churn/build_features.py\", line 109, in build\r\n    act = activity_features(single_point, orders, tickets)\r\n          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/app/churn/windows.py\", line 35, in activity_features\r\n    out[\"orders_7d\"], _ = _window(points, orders, \"ordered_at\", 7)\r\n                          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/app/churn/windows.py\", line 23, in _window\r\n    t = _seconds(points[\"as_of\"])\r\n        ^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/app/churn/windows.py\", line 14, in _seconds\r\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n             ~~~^~~~~~~\r\n  File \"/usr/local/lib/python3.12/site-packages/pandas/core/ops/common.py\", line 140, in new_method\r\n    return method(self, other)\r\n           ^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/pandas/core/arraylike.py\", line 219, in __sub__\r\n"]
[496.801293, "o", "    return self._arith_method(other, operator.sub)\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/pandas/core/series.py\", line 7388, in _arith_method\r\n    return base.IndexOpsMixin._arith_method(self, other, op)\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/pandas/core/base.py\", line 1717, in _arith_method\r\n    result = ops.arithmetic_op(lvalues, rvalues, op)\r\n             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/pandas/core/ops/array_ops.py\", line 282, in arithmetic_op\r\n    res_values = op(left, right)\r\n                 ^^^^^^^^^^^^^^^\r\nTypeError: unsupported operand type(s) for -: 'numpy.ndarray' and 'Timestamp'\r\n"]
