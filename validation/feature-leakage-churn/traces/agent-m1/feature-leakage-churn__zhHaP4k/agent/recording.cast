[928.248553, "o", "     1\t\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\r\n     2\t\r\n     3\tThis implementation respects point‑in‑time visibility of rows. Each source table includes a\r\n     4\t`_loaded_at` (or `_updated_at` for customers) timestamp indicating when the row became\r\n     5\tcommitted to the warehouse. The live service only sees rows whose load timestamp is **<=** the\r\n     6\tprediction's `as_of`. The original implementation ignored these timestamps, causing a distribution shift.\r\n     7\t\r\n     8\tThe new `build` function iterates over the rows of ``scoring_points.csv`` and, for each row,\r\n     9\tfilters the other tables to rows visible at that moment. It then reproduces the exact feature\r\n    10\tlogic from ``live/features.py`` using the filtered data. The approach is straightforward and fits\r\n    11\t"]
[928.248643, "o", "within the 60‑second limit for the modest sized extracts used in grading.\r\n    12\t\"\"\"\r\n    13\t\r\n    14\timport argparse\r\n    15\timport os\r\n    16\tfrom typing import List\r\n    17\t\r\n    18\timport numpy as np\r\n    19\timport pandas as pd\r\n    20\t\r\n    21\tfrom churn.attributes import days_since_last_login, plan\r\n    22\tfrom churn.encoding import PRIOR_WEIGHT, DEFAULT_PRIOR, LABEL_WINDOW_DAYS\r\n    23\tfrom churn.extract import load_extract\r\n    24\tfrom churn.impute import fill_app_minutes\r\n    25\tfrom churn.status import latest_status\r\n"]
[928.248697, "o", "    26\tfrom churn.windows import tenure_days\r\n    27\t\r\n    28\tFEATURE_COLUMNS = [\r\n    29\t    \"orders_7d\",\r\n    30\t    \"orders_30d\",\r\n    31\t    \"spend_30d_cents\",\r\n    32\t    \"tickets_30d\",\r\n    33\t    \"days_since_last_order\",\r\n    34\t    \"tenure_days\",\r\n    35\t    \"status\",\r\n    36\t    \"plan\",\r\n    37\t    \"days_since_last_login\",\r\n    38\t    \"app_minutes_7d\",\r\n    39\t    \"te_district\",\r\n    40\t]\r\n    41\t\r\n    42\t\r\n    43\tdef _filter_by_loaded(df: pd.DataFrame, as_of: pd.Timestamp) -> pd.DataFrame:\r\n    44\t    \"\"\"Return rows whose load timestamp is <= ``as_of``.\r\n    45\t\r\n    46\t    Most tables use ``_loaded_at``; the customers table uses ``_updated_at``.\r\n    47\t    \"\"\"\r\n    48\t    load_col = \"_loaded_at\" if \"_loaded_at\" in df.columns else \"_updated_at\"\r\n    49\t    return df[df[load_col] <= as_of]\r\n    50\t\r\n    51\t\r\n    52\tdef _district_encoding_point(point: pd.Series, labels: pd.DataFrame, customers: pd.DataFrame) -> float:\r\n"]
[928.248736, "o", "    53\t    \"\"\"Compute the ``te_district`` encoding for a single scoring point.\r\n    54\t\r\n    55\t    Mirrors ``live.features.district_encoding`` but operates on a pre‑filtered ``labels`` DataFrame.\r\n    56\t    \"\"\"\r\n    57\t    cust_row = customers[customers[\"customer_id\"] == point[\"customer_id\"]]\r\n    58\t    if cust_row.empty:\r\n    59\t        return np.nan\r\n    60\t    district = cust_row.iloc[0][\"postcode_district\"]\r\n    61\t\r\n    62\t    closed = labels[\"as_of\"] + pd.Timedelta(days=LABEL_WINDOW_DAYS)\r\n    63\t    mask = closed < point[\"as_of\"]\r\n    64\t    lab_closed = labels[mask]\r\n    65\t\r\n    66\t    if len(lab_closed) == 0:\r\n    67\t        prior = DEFAULT_PRIOR\r\n    68\t    else:\r\n    69\t        prior = lab_closed[\"churned_30d\"].mean()\r\n    70\t\r\n"]
[928.24878, "o", "    71\t    if pd.isna(district):\r\n    72\t        n = 0\r\n    73\t        s = 0\r\n    74\t    else:\r\n    75\t        cust_district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n    76\t        lab_district = lab_closed[\"customer_id\"].map(cust_district)\r\n    77\t        district_mask = lab_district == district\r\n    78\t        n = district_mask.sum()\r\n    79\t        s = lab_closed.loc[district_mask, \"churned_30d\"].sum()\r\n    80\t\r\n    81\t    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)\r\n    82\t\r\n    83\t\r\n    84\tdef build(data_dir: str) -> pd.DataFrame:\r\n    85\t"]
[928.248815, "o", "    \"\"\"Build the feature table for the given extract directory.\r\n    86\t\r\n    87\t    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n    88\t    \"\"\"\r\n    89\t    tables = load_extract(data_dir)\r\n    90\t    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n    91\t\r\n    92\t    customers_full = tables[\"customers\"]\r\n    93\t    labels_full = tables[\"labels\"]\r\n    94\t    orders_full = tables[\"orders\"]\r\n    95\t    tickets_full = tables[\"tickets\"]\r\n    96\t    status_full = tables[\"status_snapshots\"]\r\n    97\t\r\n    98\t    rows: List[dict] = []\r\n    99\t    for _, pt in points.iterrows():\r\n   100\t        as_of = pt[\"as_of\"]\r\n   101\t\r\n   102\t        orders = _filter_by_loaded(orders_full, as_of)\r\n"]
[928.248876, "o", "   103\t        tickets = _filter_by_loaded(tickets_full, as_of)\r\n   104\t        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n   105\t        customers = _filter_by_loaded(customers_full, as_of)\r\n   106\t        labels = _filter_by_loaded(labels_full, as_of)\r\n   107\t\r\n   108\t        # Activity features - manual calculations\r\n   109\t        # orders 7d\r\n   110\t        mask7 = (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=7)) & (orders[\"ordered_at\"] < as_of)\r\n   111\t        orders_7d = int(mask7.sum())\r\n   112\t        # orders 30d and spend\r\n   113\t        mask30 = (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=30)) & (orders[\"ordered_at\"] < as_of)\r\n   114\t        orders_30d = int(mask30.sum())\r\n   115\t        spend_30d_cents = int(orders.loc[mask30, \"amount_cents\"].sum())\r\n   116\t        # tickets 30d\r\n   117\t        mask_t = (tickets[\"opened_at\"] >= as_of - pd.Timedelta(days=30)) & (tickets[\"opened_at\"] < as_of)\r\n   118\t        tickets_30d = int(mask_t.sum())\r\n   119\t        # days since la"]
[928.24892, "o", "st order\r\n   120\t        past_orders = orders[orders[\"ordered_at\"] < as_of]\r\n   121\t        if not past_orders.empty:\r\n   122\t            last_order = past_orders[\"ordered_at\"].max()\r\n   123\t            days_since_last_order = (as_of - last_order).total_seconds() / 86400\r\n   124\t        else:\r\n   125\t            days_since_last_order = np.nan\r\n   126\t\r\n   127\t        # tenure, status, plan, days since login\r\n   128\t        tenure = tenure_days(pd.DataFrame([pt]), customers).iloc[0]\r\n   129\t        status = latest_status(pd.DataFrame([pt]), status_snapshots).iloc[0]\r\n   130\t        plan_val = plan(pd.DataFrame([pt]), customers).iloc[0]\r\n   131\t        dlast_login = days_since_last_login(pd.DataFrame([pt]), customers).iloc[0]\r\n   132\t        te_district = _district_encoding_point(pt, labels, customers_full)\r\n   133\t\r\n   134\t"]
[928.248978, "o", "        rows.append({\r\n   135\t            \"customer_id\": pt[\"customer_id\"],\r\n   136\t            \"as_of\": as_of,\r\n   137\t            \"orders_7d\": orders_7d,\r\n   138\t            \"orders_30d\": orders_30d,\r\n   139\t            \"spend_30d_cents\": spend_30d_cents,\r\n   140\t            \"tickets_30d\": tickets_30d,\r\n   141\t            \"days_since_last_order\": days_since_last_order,\r\n   142\t            \"tenure_days\": float(tenure),\r\n   143\t            \"status\": status if not pd.isna(status) else np.nan,\r\n   144\t            \"plan\": plan_val,\r\n   145\t            \"days_since_last_login\": dlast_login,\r\n   146\t            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n   147\t            \"te_district\": float(te_district),\r\n   148\t        })\r\n   149"]
[928.249019, "o", "\t\r\n   150\t    df = pd.DataFrame(rows)\r\n   151\t    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n   152\t    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n   153\t\r\n   154\t\r\n   155\tdef main():\r\n   156\t    ap = argparse.ArgumentParser(description=__doc__)\r\n   157\t    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n   158\t    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n   159\t    args = ap.parse_args()\r\n   160\t    feats = build(args.data)\r\n   161\t    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\r\n   162\t    feats.to_parquet(args.out, index=False)\r\n   163\t    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\r\n   164\t\r\n   165\tif __name__ == \"__main__\":\r\n   166\t    main()\r\n"]
