[462.308089, "o", "\u001b[?2004h"]
[462.308128, "o", "> "]
[462.30864, "o", "logic from ``live/features.py`` using the filtered data. The approach is straightforward and fits\r\n\u001b[?2004l\r"]
[462.30869, "o", "\u001b[?2004h> "]
[462.309141, "o", "within the 60‑second limit for the modest sized extracts used in grading.\r\n\u001b[?2004l\r"]
[462.30918, "o", "\u001b[?2004h"]
[462.309218, "o", "> \"\"\"\r\n"]
[462.309256, "o", "\u001b[?2004l\r\u001b[?2004h"]
[462.309294, "o", "> \r\n\u001b[?2004l\r"]
[462.309335, "o", "\u001b[?2004h> "]
[462.3094, "o", "import argparse\r\n\u001b[?2004l\r"]
[462.309438, "o", "\u001b[?2004h"]
[462.309475, "o", "> "]
[462.309523, "o", "import os\r\n\u001b[?2004l\r"]
[462.30956, "o", "\u001b[?2004h> "]
[462.309688, "o", "from typing import List\r\n\u001b[?2004l\r"]
[462.309725, "o", "\u001b[?2004h"]
[462.309762, "o", "> \r\n\u001b[?2004l\r"]
[462.3098, "o", "\u001b[?2004h> "]
[462.309892, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[462.309928, "o", "\u001b[?2004h"]
[462.30997, "o", "> "]
[462.310068, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[462.310105, "o", "\u001b[?2004h"]
[462.310142, "o", "> \r\n\u001b[?2004l\r"]
[462.31018, "o", "\u001b[?2004h> "]
[462.310496, "o", "from churn.attributes import days_since_last_login, plan\r\n\u001b[?2004l\r"]
[462.310545, "o", "\u001b[?2004h> "]
[462.310961, "o", "from churn.encoding import PRIOR_WEIGHT, DEFAULT_PRIOR, LABEL_WINDOW_DAYS\r\n\u001b[?2004l\r"]
[462.311015, "o", "\u001b[?2004h> "]
[462.311242, "o", "from churn.extract import load_extract\r\n\u001b[?2004l\r"]
[462.311291, "o", "\u001b[?2004h> "]
[462.311521, "o", "from churn.impute import fill_app_minutes\r\n\u001b[?2004l\r"]
[462.311569, "o", "\u001b[?2004h"]
[462.311607, "o", "> "]
[462.311793, "o", "from churn.status import latest_status\r\n\u001b[?2004l\r"]
[462.311841, "o", "\u001b[?2004h"]
[462.311879, "o", "> "]
[462.312181, "o", "from churn.windows import activity_features, tenure_days\r\n\u001b[?2004l\r"]
[462.312226, "o", "\u001b[?2004h> "]
[462.312263, "o", "\r\n\u001b[?2004l\r"]
[462.312304, "o", "\u001b[?2004h> "]
[462.312394, "o", "FEATURE_COLUMNS = [\r\n\u001b[?2004l\r"]
[462.312441, "o", "\u001b[?2004h"]
[462.312478, "o", "> "]
[462.312541, "o", "    \"orders_7d\",\r\n\u001b[?2004l\r"]
[462.312585, "o", "\u001b[?2004h> "]
[462.312694, "o", "    \"orders_30d\",\r\n\u001b[?2004l\r"]
[462.312736, "o", "\u001b[?2004h"]
[462.312777, "o", "> "]
[462.31286, "o", "    \"spend_30d_cents\",\r\n\u001b[?2004l\r"]
[462.312908, "o", "\u001b[?2004h> "]
[462.313043, "o", "    \"tickets_30d\",\r\n\u001b[?2004l\r"]
[462.313084, "o", "\u001b[?2004h> "]
[462.313273, "o", "    \"days_since_last_order\",\r\n\u001b[?2004l\r"]
[462.313313, "o", "\u001b[?2004h> "]
[462.313462, "o", "    \"tenure_days\",\r\n\u001b[?2004l\r"]
[462.313499, "o", "\u001b[?2004h> "]
[462.313597, "o", "    \"status\",\r\n\u001b[?2004l\r"]
[462.313648, "o", "\u001b[?2004h> "]
[462.31372, "o", "    \"plan\",\r\n\u001b[?2004l\r"]
[462.313769, "o", "\u001b[?2004h> "]
[462.31395, "o", "    \"days_since_last_login\",\r\n\u001b[?2004l\r"]
[462.314013, "o", "\u001b[?2004h> "]
[462.314133, "o", "    \"app_minutes_7d\",\r\n\u001b[?2004l\r"]
[462.314172, "o", "\u001b[?2004h> "]
[462.314299, "o", "    \"te_district\",\r\n\u001b[?2004l\r"]
[462.314351, "o", "\u001b[?2004h> "]
[462.314388, "o", "]\r\n\u001b[?2004l\r"]
[462.314425, "o", "\u001b[?2004h> \r\n"]
[462.314464, "o", "\u001b[?2004l\r\u001b[?2004h"]
[462.314502, "o", "> \r\n\u001b[?2004l\r"]
[462.314526, "o", "\u001b[?2004h> "]
[462.314978, "o", "def _filter_by_loaded(df: pd.DataFrame, as_of: pd.Timestamp) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[462.315015, "o", "\u001b[?2004h"]
[462.315053, "o", "> "]
[462.315324, "o", "    \"\"\"Return rows whose load timestamp is <= ``as_of``.\r\n\u001b[?2004l\r"]
[462.315368, "o", "\u001b[?2004h"]
[462.315404, "o", "> \r\n\u001b[?2004l\r"]
[462.315442, "o", "\u001b[?2004h> "]
[462.315791, "o", "    Most tables use ``_loaded_at``; the customers table uses ``_updated_at``.\r\n\u001b[?2004l\r"]
[462.315839, "o", "\u001b[?2004h> "]
[462.31588, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[462.315918, "o", "\u001b[?2004h"]
[462.31597, "o", "> "]
[462.316298, "o", "    load_col = \"_loaded_at\" if \"_loaded_at\" in df.columns else \"_updated_at\"\r\n\u001b[?2004l\r"]
[462.316337, "o", "\u001b[?2004h"]
[462.316375, "o", "> "]
[462.31652, "o", "    return df[df[load_col] <= as_of]\r\n\u001b[?2004l\r"]
[462.316568, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[462.316617, "o", "\u001b[?2004h> "]
[462.316655, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.316692, "o", "> "]
[462.317164, "o", "def _district_encoding_point(point: pd.Series, labels: pd.DataFrame, customers: pd.DataFrame) -> float:\r\n\u001b[?2004l\r"]
[462.317209, "o", "\u001b[?2004h"]
[462.317246, "o", "> "]
[462.317554, "o", "    \"\"\"Compute the ``te_district`` encoding for a single scoring point.\r\n\u001b[?2004l\r"]
[462.317604, "o", "\u001b[?2004h> "]
[462.317642, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.31768, "o", "> "]
[462.318144, "o", "    Mirrors ``live.features.district_encoding`` but operates on a pre‑filtered ``labels`` DataFrame.\r\n\u001b[?2004l\r"]
[462.318189, "o", "\u001b[?2004h> "]
[462.318229, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[462.318274, "o", "\u001b[?2004h"]
[462.318311, "o", "> "]
[462.318633, "o", "    cust_row = customers[customers[\"customer_id\"] == point[\"customer_id\"]]\r\n\u001b[?2004l\r"]
[462.318679, "o", "\u001b[?2004h"]
[462.318716, "o", "> "]
[462.318791, "o", "    if cust_row.empty:\r\n\u001b[?2004l\r"]
[462.318827, "o", "\u001b[?2004h> "]
[462.318955, "o", "        return np.nan\r\n\u001b[?2004l\r"]
[462.319005, "o", "\u001b[?2004h"]
[462.319043, "o", "> "]
[462.319267, "o", "    district = cust_row.iloc[0][\"postcode_district\"]\r\n\u001b[?2004l\r"]
[462.319311, "o", "\u001b[?2004h"]
[462.319348, "o", "> \r\n\u001b[?2004l\r"]
[462.319386, "o", "\u001b[?2004h> "]
[462.319731, "o", "    closed = labels[\"as_of\"] + pd.Timedelta(days=LABEL_WINDOW_DAYS)\r\n\u001b[?2004l\r"]
[462.319771, "o", "\u001b[?2004h"]
[462.319808, "o", "> "]
[462.320009, "o", "    mask = closed < point[\"as_of\"]\r\n\u001b[?2004l\r"]
[462.32005, "o", "\u001b[?2004h"]
[462.320087, "o", "> "]
[462.320245, "o", "    lab_closed = labels[mask]\r\n\u001b[?2004l\r"]
[462.320292, "o", "\u001b[?2004h"]
[462.32033, "o", "> \r\n\u001b[?2004l\r"]
[462.320368, "o", "\u001b[?2004h"]
[462.320405, "o", "> "]
[462.320546, "o", "    if len(lab_closed) == 0:\r\n\u001b[?2004l\r"]
[462.320586, "o", "\u001b[?2004h"]
[462.320623, "o", "> "]
[462.320786, "o", "        prior = DEFAULT_PRIOR\r\n\u001b[?2004l\r"]
[462.320826, "o", "\u001b[?2004h"]
[462.320863, "o", "> "]
[462.320909, "o", "    else:\r\n\u001b[?2004l\r"]
[462.320963, "o", "\u001b[?2004h"]
[462.321, "o", "> "]
[462.321272, "o", "        prior = lab_closed[\"churned_30d\"].mean()\r\n\u001b[?2004l\r"]
[462.321314, "o", "\u001b[?2004h> "]
[462.321351, "o", "\r\n\u001b[?2004l\r"]
[462.321389, "o", "\u001b[?2004h"]
[462.321426, "o", "> "]
[462.321546, "o", "    if pd.isna(district):\r\n\u001b[?2004l\r"]
[462.321585, "o", "\u001b[?2004h"]
[462.321622, "o", "> "]
[462.321689, "o", "        n = 0\r\n\u001b[?2004l\r"]
[462.321728, "o", "\u001b[?2004h"]
[462.321764, "o", "> "]
[462.321831, "o", "        s = 0\r\n\u001b[?2004l\r"]
[462.321869, "o", "\u001b[?2004h"]
[462.321907, "o", "> "]
[462.321964, "o", "    else:\r\n\u001b[?2004l\r"]
[462.322011, "o", "\u001b[?2004h> "]
[462.322492, "o", "        cust_district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[462.322532, "o", "\u001b[?2004h"]
[462.32257, "o", "> "]
[462.322966, "o", "        lab_district = lab_closed[\"customer_id\"].map(cust_district)\r\n\u001b[?2004l\r"]
[462.323011, "o", "\u001b[?2004h"]
[462.323049, "o", "> "]
[462.323309, "o", "        district_mask = lab_district == district\r\n\u001b[?2004l\r"]
[462.323347, "o", "\u001b[?2004h"]
[462.323384, "o", "> "]
[462.323559, "o", "        n = district_mask.sum()\r\n\u001b[?2004l\r"]
[462.323598, "o", "\u001b[?2004h"]
[462.323635, "o", "> "]
[462.324005, "o", "        s = lab_closed.loc[district_mask, \"churned_30d\"].sum()\r\n\u001b[?2004l\r"]
[462.324044, "o", "\u001b[?2004h"]
[462.324083, "o", "> \r\n\u001b[?2004l\r"]
[462.324119, "o", "\u001b[?2004h> "]
[462.324487, "o", "    return (s + PRIOR_WEIGHT * prior) / (n + PRIOR_WEIGHT)\r\n\u001b[?2004l\r"]
[462.32453, "o", "\u001b[?2004h"]
[462.324568, "o", "> \r\n\u001b[?2004l\r"]
[462.324613, "o", "\u001b[?2004h"]
[462.324652, "o", "> \r\n\u001b[?2004l\r"]
[462.324692, "o", "\u001b[?2004h> "]
[462.324936, "o", "def build(data_dir: str) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[462.324996, "o", "\u001b[?2004h> "]
[462.32539, "o", "    \"\"\"Build the feature table for the given extract directory.\r\n\u001b[?2004l\r"]
[462.325441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[462.325546, "o", "\u001b[?2004h> "]
[462.326109, "o", "    Returns one row per scoring point with ``customer_id``, ``as_of`` and the 11 feature columns.\r\n\u001b[?2004l\r"]
[462.326165, "o", "\u001b[?2004h"]
[462.326203, "o", "> "]
[462.32624, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[462.326283, "o", "\u001b[?2004h> "]
[462.326491, "o", "    tables = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[462.326535, "o", "\u001b[?2004h> "]
[462.326913, "o", "    points = tables[\"scoring_points\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[462.326979, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[462.327032, "o", "\u001b[?2004h> "]
[462.327285, "o", "    customers_full = tables[\"customers\"]\r\n\u001b[?2004l\r"]
[462.327326, "o", "\u001b[?2004h"]
[462.327352, "o", "> "]
[462.327569, "o", "    labels_full = tables[\"labels\"]\r\n\u001b[?2004l\r"]
[462.327611, "o", "\u001b[?2004h"]
[462.327649, "o", "> "]
[462.327839, "o", "    orders_full = tables[\"orders\"]\r\n\u001b[?2004l\r"]
[462.32789, "o", "\u001b[?2004h"]
[462.327927, "o", "> "]
[462.328149, "o", "    tickets_full = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[462.328199, "o", "\u001b[?2004h"]
[462.328237, "o", "> "]
[462.328475, "o", "    status_full = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[462.328513, "o", "\u001b[?2004h"]
[462.328551, "o", "> \r\n\u001b[?2004l\r"]
[462.328589, "o", "\u001b[?2004h"]
[462.328626, "o", "> "]
[462.328751, "o", "    rows: List[dict] = []\r\n\u001b[?2004l\r"]
[462.328791, "o", "\u001b[?2004h"]
[462.328829, "o", "> "]
[462.329034, "o", "    for _, pt in points.iterrows():\r\n\u001b[?2004l\r"]
[462.329073, "o", "\u001b[?2004h"]
[462.329111, "o", "> "]
[462.329262, "o", "        as_of = pt[\"as_of\"]\r\n\u001b[?2004l\r"]
[462.329302, "o", "\u001b[?2004h"]
[462.32934, "o", "> \r\n\u001b[?2004l\r"]
[462.329378, "o", "\u001b[?2004h"]
[462.329415, "o", "> "]
[462.329708, "o", "        orders = _filter_by_loaded(orders_full, as_of)\r\n\u001b[?2004l\r"]
[462.329747, "o", "\u001b[?2004h"]
[462.329785, "o", "> "]
[462.330119, "o", "        tickets = _filter_by_loaded(tickets_full, as_of)\r\n\u001b[?2004l\r"]
[462.330165, "o", "\u001b[?2004h"]
[462.330203, "o", "> "]
[462.330562, "o", "        status_snapshots = _filter_by_loaded(status_full, as_of)\r\n\u001b[?2004l\r"]
[462.330599, "o", "\u001b[?2004h"]
[462.330617, "o", "> "]
[462.330991, "o", "        customers = _filter_by_loaded(customers_full, as_of)\r\n\u001b[?2004l\r"]
[462.33103, "o", "\u001b[?2004h"]
[462.331067, "o", "> "]
[462.331379, "o", "        labels = _filter_by_loaded(labels_full, as_of)\r\n\u001b[?2004l\r"]
[462.331419, "o", "\u001b[?2004h"]
[462.331457, "o", "> \r\n\u001b[?2004l\r"]
[462.331495, "o", "\u001b[?2004h"]
[462.331534, "o", "> "]
[462.331732, "o", "        single_point = pt.to_frame().T\r\n\u001b[?2004l\r"]
[462.331771, "o", "\u001b[?2004h"]
[462.331808, "o", "> "]
[462.332175, "o", "        act = activity_features(single_point, orders, tickets)\r\n\u001b[?2004l\r"]
[462.332214, "o", "\u001b[?2004h"]
[462.332251, "o", "> "]
[462.332556, "o", "        tenure = tenure_days(single_point, customers)\r\n\u001b[?2004l\r"]
[462.332596, "o", "\u001b[?2004h"]
[462.332633, "o", "> "]
[462.333001, "o", "        status = latest_status(single_point, status_snapshots)\r\n\u001b[?2004l\r"]
[462.33304, "o", "\u001b[?2004h"]
[462.333077, "o", "> \r\n"]
[462.333116, "o", "\u001b[?2004l\r\u001b[?2004h"]
[462.333153, "o", "> "]
[462.333466, "o", "        plan_val = plan(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[462.333504, "o", "\u001b[?2004h"]
[462.333542, "o", "> "]
[462.334002, "o", "        dlast_login = days_since_last_login(single_point, customers).iloc[0]\r\n\u001b[?2004l\r"]
[462.334042, "o", "\u001b[?2004h"]
[462.33408, "o", "> "]
[462.334518, "o", "        te_district = _district_encoding_point(pt, labels, customers_full)\r\n"]
[462.334558, "o", "\u001b[?2004l\r"]
[462.334576, "o", "\u001b[?2004h"]
[462.334592, "o", "> \r\n\u001b[?2004l\r"]
[462.334638, "o", "\u001b[?2004h"]
[462.334678, "o", "> "]
[462.334798, "o", "        rows.append({\r\n\u001b[?2004l\r"]
[462.334836, "o", "\u001b[?2004h"]
[462.334875, "o", "> "]
[462.335145, "o", "            \"customer_id\": pt[\"customer_id\"],\r\n\u001b[?2004l\r"]
[462.335185, "o", "\u001b[?2004h"]
[462.335236, "o", "> "]
[462.335373, "o", "            \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[462.335415, "o", "\u001b[?2004h"]
[462.335453, "o", "> "]
[462.335769, "o", "            \"orders_7d\": int(act[\"orders_7d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[462.335807, "o", "\u001b[?2004h"]
[462.335845, "o", "> "]
[462.336185, "o", "            \"orders_30d\": int(act[\"orders_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[462.33623, "o", "\u001b[?2004h"]
[462.336267, "o", "> "]
[462.336618, "o", "            \"spend_30d_cents\": int(act[\"spend_30d_cents\"].iloc[0]),\r\n\u001b[?2004l\r"]
[462.336669, "o", "\u001b[?2004h> "]
[462.336956, "o", "            \"tickets_30d\": int(act[\"tickets_30d\"].iloc[0]),\r\n\u001b[?2004l\r"]
[462.337005, "o", "\u001b[?2004h> "]
[462.337364, "o", "            \"days_since_last_order\": act[\"days_since_last_order\"].iloc[0],\r\n\u001b[?2004l\r"]
[462.337408, "o", "\u001b[?2004h> "]
[462.337656, "o", "            \"tenure_days\": float(tenure.iloc[0]),\r\n\u001b[?2004l\r"]
[462.337707, "o", "\u001b[?2004h> "]
[462.3381, "o", "            \"status\": status.iloc[0] if not pd.isna(status.iloc[0]) else np.nan,\r\n\u001b[?2004l\r"]
[462.33814, "o", "\u001b[?2004h"]
[462.338181, "o", "> "]
[462.338292, "o", "            \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[462.338342, "o", "\u001b[?2004h> "]
[462.338578, "o", "            \"days_since_last_login\": dlast_login,\r\n\u001b[?2004l\r"]
[462.338624, "o", "\u001b[?2004h> "]
[462.338932, "o", "            \"app_minutes_7d\": pt.get(\"app_minutes_7d\", np.nan),\r\n\u001b[?2004l\r"]
[462.338957, "o", "\u001b[?2004h"]
[462.339006, "o", "> "]
[462.339209, "o", "            \"te_district\": float(te_district),\r\n\u001b[?2004l\r"]
[462.339248, "o", "\u001b[?2004h"]
[462.339285, "o", "> "]
[462.339322, "o", "        })\r\n\u001b[?2004l\r"]
[462.33936, "o", "\u001b[?2004h> "]
[462.339398, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.339436, "o", "> "]
[462.339534, "o", "    df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[462.339586, "o", "\u001b[?2004h> "]
[462.33981, "o", "    df[\"app_minutes_7d\"] = fill_app_minutes(df)\r\n\u001b[?2004l\r"]
[462.339854, "o", "\u001b[?2004h"]
[462.339891, "o", "> "]
[462.340141, "o", "    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
