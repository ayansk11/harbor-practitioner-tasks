[906.149793, "i", "cat > debug_activity.py <<'PY'\nimport pandas as pd\nfrom churn.extract import load_extract\nfrom churn.windows import activity_features\n\ntables = load_extract('data')\npoints = tables['scoring_points']\nfirst_pt = points.iloc[0]\nas_of = first_pt['as_of']\n# filter orders and tickets by loaded timestamp\norders = tables['orders']\norders_f = orders[orders['_loaded_at'] <= as_of]\ntickets = tables['tickets']\ntickets_f = tickets[tickets['_loaded_at'] <= as_of]\n# compute activity features\nout = activity_features(first_pt.to_frame().T, orders_f, tickets_f)\nprint(out)\nPY\n"]
