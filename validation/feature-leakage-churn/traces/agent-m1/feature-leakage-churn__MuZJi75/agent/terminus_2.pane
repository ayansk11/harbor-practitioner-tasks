   256	def target_encoding(points, labels, customers):
   257	    """Live district target encoding over labels and customers visible at t."""
   258	    n = len(points)
   259	    out = np.full(n, np.nan, dtype="float64")
   260	    point_secs, point_valid = _seconds(points["as_of"])
   261	    point_positions = np.flatnonzero(point_valid)
