import pandas as pd,re,json
O=pd.read_csv('data/orders.csv'); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True)
# Summarize every legacy selection window and final old counts around rollback/retry examples.
C={int(json.loads(x)['txn']):json.loads(x) for x in open('data/_ops/commits.jsonl')}
for ds in ['2024-01-03','2024-01-04','2024-01-11','2024-01-12','2024-11-07','2024-11-08']:
 d=pd.Timestamp(ds,tz='UTC'); print('\n',ds,'extract old',int((O._load_job.eq('legacy_backfill')&O.ordered_at.ge(d)&O.ordered_at.lt(d+pd.Timedelta(days=1))).sum()))
 for l in open('data/_ops/scheduler.log'):
  a=l.rstrip().split(maxsplit=2)
  if len(a)<3 or a[1]!='legacy_orders' or ds not in a[2]: continue
  print(a[0],a[2])
