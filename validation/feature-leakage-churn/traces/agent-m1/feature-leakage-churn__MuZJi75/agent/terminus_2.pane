[?2004l[?2004h> def _event_features(points, events, commit_col, ts_col, *, amount_col=None,
[?2004l[?2004h>                     windows=(30,), need_last=False):
[?2004l[?2004h>     """Evaluate event queries as events become visible through ``commit_col``."""
[?2004l[?2004h>     n = len(points)
[?2004l[?2004h>     result = {f"count_{w}": np.zeros(n, dtype="int64") for w in windows}
[?2004l[?2004h>     if amount_col is not None:
[?2004l[?2004h>         result["spend"] = np.zeros(n, dtype="int64")
[?2004l[?2004h>     result["last"] = np.full(n, np.nan, dtype="float64")
[?2004l[?2004h> 
[?2004l[?2004h>     point_secs, point_valid = _seconds(points["as_of"])
[?2004l[?2004h>     point_positions = np.flatnonzero(point_valid)
[?2004l[?2004h>     if not len(point_positions):
[?2004l[?2004h>         return result
[?2004l[?2004h>     point_secs = point_secs[point_positions]
[?2004l[?2004h> 
[?2004l[?2004h>     event_secs, event_valid = _seconds(events[ts_col])
[?2004l[?2004h>     event_commit, commit_valid = _seconds(events[commit_col])
[?2004l[?2004h>     event_mask = event_valid & commit_valid
[?2004l[?2004h>     event_positions = np.flatnonzero(event_mask)
[?2004l[?2004h>     event_secs = event_secs[event_positions]
[?2004l[?2004h>     event_commit = event_commit[event_positions]
[?2004l[?2004h> 
[?2004l[?2004h>     if len(events):
[?2004l[?2004h>         point_codes, event_codes, _ = _factorize_ids(
[?2004l[?2004h>             points["customer_id"].iloc[point_positions],
[?2004l[?2004h>             events["customer_id"].iloc[event_positions],
[?2004l[?2004h>         )
[?2004l[?2004h>     else:
[?2004l[?2004h>         point_codes, _ = _factorize_ids(points["customer_id"].iloc[point_positions])
[?2004l[?2004h>         event_codes = np.empty(0, dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h>     all_secs = np.concatenate([point_secs, event_secs]) if len(event_secs) else point_secs
[?2004l[?2004h>     base = int(all_secs.min())
[?2004l[?2004h>     span = int(all_secs.max()) - base + 1
[?2004l[?2004h> 
[?2004l[?2004h>     point_keys = point_codes.astype("int64") * span + (point_secs - base)
[?2004l[?2004h>     if len(event_secs):
[?2004l[?2004h>         event_keys = event_codes.astype("int64") * span + (event_secs - base)
[?2004l[?2004h>         sorted_index = np.argsort(event_keys, kind="mergesort")
[?2004l[?2004h>         event_keys = event_keys[sorted_index]
[?2004l[?2004h>         ranks = np.empty(len(event_keys), dtype="int64")
[?2004l[?2004h>         ranks[sorted_index] = np.arange(len(event_keys), dtype="int64")
[?2004l[?2004h>     else:
[?2004l[?2004h>         event_keys = np.empty(0, dtype="int64")
[?2004l[?2004h>         ranks = np.empty(0, dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h>     if amount_col is not None and len(event_positions):
[?2004l[?2004h>         amounts = pd.to_numeric(events[amount_col].iloc[event_positions],
[?2004l[?2004h>                                 errors="coerce").fillna(0).astype("int64").to_numpy()
[?2004l[?2004h>     else:
[?2004l[?2004h>         amounts = np.zeros(len(event_positions), dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h>     tree = _Fenwick(len(event_keys))
[?2004l[?2004h>     event_order = np.argsort(event_commit, kind="mergesort")
[?2004l[?2004h>     event_commit = event_commit[event_order]
[?2004l[?2004h>     event_order = event_positions[event_order]
[?2004l[?2004h>     ranks = ranks[event_order]
[?2004l[?2004h>     event_secs = event_secs[event_order]
[?2004l[?2004h>     event_codes = event_codes[event_order]
[?2004l[?2004h>     amounts = amounts[event_order]
[?2004l[?2004h> 
[?2004l[?2004h>     histories = [[] for _ in range(len(point_codes))] if need_last else None
[?2004l[?2004h>     event_pos = 0
[?2004l[?2004h>     for q, original in enumerate(point_positions):
[?2004l[?2004h>         t = int(point_secs[q])
[?2004l[?2004h>         code = int(point_codes[q])
[?2004l[?2004h>         while event_pos < len(event_order) and event_commit[event_pos] < t:
[?2004l[?2004h>             i = int(event_order[event_pos])
[?2004l[?2004h>             tree.add(int(ranks[event_pos]), int(amounts[event_pos]))
[?2004l[?2004h>             if histories is not None:
[?2004l[?2004h>                 insort(histories[code], int(event_secs[event_pos]))
[?2004l[?2004h>             event_pos += 1
[?2004l[?2004h> 
[?2004l[?2004h>         for window in windows:
[?2004l[?2004h>             lower_adj = max(t - int(window) * 86400 - base, 0)
[?2004l[?2004h>             upper_adj = max(t - base, 0)
[?2004l[?2004h>             left = bisect_left(event_keys, code * span + lower_adj)
[?2004l[?2004h>             right = bisect_left(event_keys, code * span + upper_adj)
[?2004l[?2004h>             count, _ = tree.range(left, right)
[?2004l[?2004h>             result[f"count_{window}"][original] = count
[?2004l[?2004h> 
[?2004l[?2004h>         if amount_col is not None:
[?2004l[?2004h>             lower_adj = max(t - 30 * 86400 - base, 0)
[?2004l[?2004h>             upper_adj = max(t - base, 0)
[?2004l[?2004h>             left = bisect_left(event_keys, code * span + lower_adj)
[?2004l[?2004h>             right = bisect_left(event_keys, code * span + upper_adj)
[?2004l[?2004h>             result["spend"][original] = tree.range(left, right)[1]
[?2004l[?2004h> 
[?2004l[?2004h>         if histories is not None:
[?2004l[?2004h>             hist = histories[code]
[?2004l[?2004h>             hi = bisect_left(hist, t)
[?2004l[?2004h>             if hi:
[?2004l[?2004h>                 result["last"][original] = float(hist[hi - 1] - t) / 86400.0
[?2004l[?2004h> 
[?2004l[?2004h>     return result
