   294	    lab_commit, lab_commit_valid = _seconds(labels["_loaded_at"])
   295	    lab_signup_secs = np.full(len(labels), np.iinfo(np.int64).max, dtype="int64")
   296	    lab_customer_index = customer_index[: len(labels)]
   297	    visible_customer = has_customer[: len(labels)]
   298	    if visible_customer.any():
   299	        positions = lab_customer_index[visible_customer].astype("int64")
   300	        signup_secs, signup_valid = _seconds(signup.iloc[positions])
   301	        lab_signup_secs[visible_customer] = np.where(signup_valid, signup_secs, np.iinfo(np.int64).max)
   302	    lab_commit = np.where(lab_commit_valid, lab_commit, np.iinfo(np.int64).max)
   303	    eligibility = np.maximum(lab_commit, lab_signup_secs)
   304	
   305	    y_values = pd.to_numeric(labels["churned_30d"], errors="coerce").to_numpy(dtype="float64")
   306	    label_order = np.argsort(eligibility, kind="mergesort")
   307	    eligibility = eligibility[label_order]
   308	    lab_district = lab_district[label_order]
   309	    y_values = y_values[label_order]
   310	
   311	    point_codes = np.asarray(point_codes, dtype="int64")
   312	    pt_district = np.asarray(pt_district, dtype="int64")
   313	    point_order = np.argsort(point_secs, kind="mergesort")
   314	    global_n = global_sum = 0
   315	    district_n = {}
   316	    district_sum = {}
   317	    label_i = 0
   318	    for q, original in enumerate(point_positions):
   319	        t = int(point_secs[q])
   320	        code = int(point_codes[q])
   321	        own = int(pt_district[q])
   322	        while label_i < len(eligibility) and eligibility[label_i] < t:
   323	            y = float(y_values[label_i]) if np.isfinite(y_values[label_i]) else np.nan
   324	            if np.isfinite(y):
   325	                global_n += 1
   326	                global_sum += int(y)
   327	            district = int(lab_district[label_i])
   328	            district_n[district] = district_n.get(district, 0) + 1
   329	            district_sum[district] = district_sum.get(district, 0) + (int(y) if np.isfinite(y) else 0)
   330	            label_i += 1
   331	
   332	        if code < 0 or not np.isfinite(customer_index[unique.searchsorted(code)] if False else 1.0):
   333	            continue
   334	        # A customer row missing from the warehouse yields no row from CROSS JOIN own.
   335	        if not has_customer[len(labels) + q]:
   336	            continue
   337	        same_n = district_n.get(own, 0)
   338	        same_sum = district_sum.get(own, 0)
   339	        prior = global_sum / global_n if global_n else 0.05
   340	        out[original] = (same_sum + 20.0 * prior) / (same_n + 20.0)
   341	    return out
   342	
   343	
   344	def app_minutes(points):
   345	    order = np.lexsort((points["as_of"].to_numpy(), points["customer_id"].to_numpy()))
   346	    ordered = points["app_minutes_7d"].iloc[order]
   347	    filled = ordered.groupby(points["customer_id"].iloc[order]).ffill()
   348	    out = np.full(len(points), np.nan, dtype="float64")
   349	    out[order] = filled.to_numpy(dtype="float64")
   350	    return out
   351	
   352	
   353	def customer_features(points, customers, plan_changes):
   354	    """Build customer-record features when, and only when, every value is known."""
   355	    n = len(points)
   356	    plan = np.full(n, None, dtype=object)
   357	    login_days = np.full(n, np.nan, dtype="float64")
   358	    plan_known = np.zeros(n, dtype="bool")
   359	    login_known = np.zeros(n, dtype="bool")
   360	
   361	    customer_by_id = customers.set_index("customer_id", drop=False)
   362	    final_plan = points["customer_id"].map(customer_by_id["plan"])
   363	    final_login = points["customer_id"].map(customer_by_id["last_login_at"])
   364	    final_updated = points["customer_id"].map(customer_by_id["_updated_at"])
   365	    final_signup = points["customer_id"].map(customer_by_id["signup_at"])
   366	    no_changes = ~points["customer_id"].isin(set(plan_changes["customer_id"]))
   367	
   368	    plan_commit, plan_commit_valid = _seconds(plan_changes["_loaded_at"])
   369	    plan_changed, changed_valid = _seconds(plan_changes["changed_at"])
   370	    valid = plan_commit_valid & changed_valid
