[?2004l     1	"""Reconstruct the values computed by ``live/features.py`` from an extract.
     2	
     3	The reconstruction uses only facts that were committed before each request.  For
     4	rows written by scheduled jobs this comes from ``_loaded_at`` (or, for the old
     5	orders generation, from the scheduler transaction records).  Rows written by the
     6	sign-up, ticket CDC and scoring services were committed at the source timestamps
     7	recorded in the extract.
     8	"""
     9	from bisect import bisect_left, insort
    10	
    11	import numpy as np
    12	import pandas as pd
    13	
    14	
    15	def _seconds(values):
    16	    values = pd.to_datetime(pd.Series(values), utc=True)
    17	    valid = values.notna().to_numpy()
    18	    out = values.to_numpy(dtype="datetime64[ns]").astype("int64") // 1_000_000_000
    19	    return out, valid
    20	
    21	
    22	class _Fenwick:
    23	    def __init__(self, n):
    24	        self.n = n
    25	        self.counts = [0] * (n + 1)
    26	        self.amounts = [0] * (n + 1)
    27	
    28	    def add(self, i, amount):
    29	        i += 1
    30	        while i <= self.n:
    31	            self.counts[i] += 1
    32	            self.amounts[i] += amount
    33	            i += i & -i
    34	
    35	    def range(self, left, right):
    36	        if right <= left:
    37	            return 0, 0
    38	        hi_count, hi_amount = self._prefix(right)
    39	        lo_count, lo_amount = self._prefix(left)
    40	        return hi_count - lo_count, hi_amount - lo_amount
    41	
    42	    def _prefix(self, i):
    43	        count = amount = 0
    44	        while i > 0:
    45	            count += self.counts[i]
    46	            amount += self.amounts[i]
    47	            i -= i & -i
    48	        return count, amount
    49	
    50	
    51	def _factorize_ids(a, b=None):
    52	    if b is None:
    53	        codes, unique = pd.factorize(pd.Series(a), sort=True)
    54	        return codes, unique
    55	    combined = pd.concat([pd.Series(a), pd.Series(b)], ignore_index=True)
    56	    codes, unique = pd.factorize(combined, sort=True)
    57	    return codes[: len(a)], codes[len(a) :], unique
    58	
    59	
    60	def _event_features(points, events, commit_col, ts_col, *, amount_col=None,
    61	                    windows=(30,), need_last=False):
    62	    """Evaluate event queries as events become visible through ``commit_col``."""
    63	    n = len(points)
    64	    result = {f"count_{w}": np.zeros(n, dtype="int64") for w in windows}
    65	    if amount_col is not None:
    66	        result["spend"] = np.zeros(n, dtype="int64")
    67	    result["last"] = np.full(n, np.nan, dtype="float64")
    68	
    69	    point_secs, point_valid = _seconds(points["as_of"])
    70	    point_positions = np.flatnonzero(point_valid)
    71	    if not len(point_positions):
    72	        return result
    73	    point_secs = point_secs[point_positions]
    74	
    75	    event_secs, event_valid = _seconds(events[ts_col])
    76	    event_commit, commit_valid = _seconds(events[commit_col])
    77	    event_mask = event_valid & commit_valid
    78	    event_positions = np.flatnonzero(event_mask)
    79	    event_secs = event_secs[event_positions]
    80	    event_commit = event_commit[event_positions]
    81	
    82	    if len(events):
    83	        point_codes, event_codes, _ = _factorize_ids(
    84	            points["customer_id"].iloc[point_positions],
    85	            events["customer_id"].iloc[event_positions],
    86	        )
    87	    else:
    88	        point_codes, _ = _factorize_ids(points["customer_id"].iloc[point_positions])
    89	        event_codes = np.empty(0, dtype="int64")
    90	
    91	    all_secs = np.concatenate([point_secs, event_secs]) if len(event_secs) else point_secs
    92	    base = int(all_secs.min())
    93	    span = int(all_secs.max()) - base + 1
    94	
    95	    point_keys = point_codes.astype("int64") * span + (point_secs - base)
    96	    if len(event_secs):
    97	        event_keys = event_codes.astype("int64") * span + (event_secs - base)
    98	        sorted_index = np.argsort(event_keys, kind="mergesort")
    99	        event_keys = event_keys[sorted_index]
   100	        ranks = np.empty(len(event_keys), dtype="int64")
   101	        ranks[sorted_index] = np.arange(len(event_keys), dtype="int64")
   102	    else:
   103	        event_keys = np.empty(0, dtype="int64")
   104	        ranks = np.empty(0, dtype="int64")
   105	
   106	    if amount_col is not None and len(event_positions):
   107	        amounts = pd.to_numeric(events[amount_col].iloc[event_positions],
   108	                                errors="coerce").fillna(0).astype("int64").to_numpy()
   109	    else:
   110	        amounts = np.zeros(len(event_positions), dtype="int64")
   111	
   112	    tree = _Fenwick(len(event_keys))
   113	    event_order = np.argsort(event_commit, kind="mergesort")
   114	    event_commit = event_commit[event_order]
   115	    ranks = ranks[event_order]
   116	    event_secs = event_secs[event_order]
   117	    event_codes = event_codes[event_order]
   118	    amounts = amounts[event_order]
   119	
   120	    histories = [[] for _ in range(len(point_codes))] if need_last else None
   121	    event_pos = 0
   122	    for q, original in enumerate(point_positions):
   123	        t = int(point_secs[q])
   124	        code = int(point_codes[q])
   125	        while event_pos < len(event_order) and event_commit[event_pos] < t:
   126	            i = int(event_order[event_pos])
   127	            tree.add(int(ranks[event_pos]), int(amounts[event_pos]))
   128	            if histories is not None:
   129	                insort(histories[code], int(event_secs[event_pos]))
   130	            event_pos += 1
   131	
   132	        for window in windows:
   133	            lower_adj = max(t - int(window) * 86400 - base, 0)
   134	            upper_adj = max(t - base, 0)
   135	            left = bisect_left(event_keys, code * span + lower_adj)
   136	            right = bisect_left(event_keys, code * span + upper_adj)
   137	            count, _ = tree.range(left, right)
   138	            result[f"count_{window}"][original] = count
   139	
   140	        if amount_col is not None:
   141	            lower_adj = max(t - 30 * 86400 - base, 0)
   142	            upper_adj = max(t - base, 0)
   143	            left = bisect_left(event_keys, code * span + lower_adj)
   144	            right = bisect_left(event_keys, code * span + upper_adj)
   145	            result["spend"][original] = tree.range(left, right)[1]
   146	
   147	        if histories is not None:
   148	            hist = histories[code]
   149	            hi = bisect_left(hist, t)
   150	            if hi:
   151	                result["last"][original] = float(hist[hi - 1] - t) / 86400.0
   152	
   153	    return result
