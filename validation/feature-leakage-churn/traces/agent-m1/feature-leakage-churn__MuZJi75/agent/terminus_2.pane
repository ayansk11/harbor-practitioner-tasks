import pandas as pd
P=pd.read_csv('data/scoring_points.csv'); P['as_of']=pd.to_datetime(P.as_of,utc=True)
C=pd.read_csv('data/customers.csv'); C['_updated_at']=pd.to_datetime(C._updated_at,utc=True)
PC=pd.read_csv('data/plan_changes.csv'); PC['_loaded_at']=pd.to_datetime(PC._loaded_at,utc=True)
M=P.merge(C[['customer_id','_updated_at']],on='customer_id')
hasvis=PC.groupby('customer_id')._loaded_at.min().rename('first_change_load')
M=M.merge(hasvis,left_on='customer_id',right_index=True,how='left')
print('points with unchanged row',int((M._updated_at<M.as_of).sum()))
print('points with first change loaded later',int((M.first_change_load>=M.as_of).sum()))
print('both unknown conditions',int(((M._updated_at>=M.as_of)&((M.first_change_load>=M.as_of)|M.first_change_load.isna())).sum()))
