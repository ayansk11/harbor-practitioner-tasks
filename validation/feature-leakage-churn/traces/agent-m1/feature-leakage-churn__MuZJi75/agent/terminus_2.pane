import pandas as pd,re,json,numpy as np
O=pd.read_csv('data/orders.csv'); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True)
C={int(json.loads(x)['txn']):json.loads(x) for x in open('data/_ops/commits.jsonl')}
R=[]
for l in open('data/_ops/scheduler.log'):
 a=l.rstrip().split(maxsplit=2)
 if len(a)<3 or a[1]!='legacy_orders': continue
 z=re.search(r'ordered_at >= (\S+) and ordered_at < (\S+): (\d+) rows; sent txn (\d+) to commit into (\S+)',a[2])
 if not z: continue
 x=C[int(z.group(4))]
 if x['outcome']=='commit': R.append({'s':pd.Timestamp(z.group(1)),'e':pd.Timestamp(z.group(2)),'n':int(z.group(3)),'commit':pd.Timestamp(x['at'])})
R=pd.DataFrame(R).sort_values('commit').reset_index(drop=True)
# Earliest containing successful transaction for all final order rows.
starts=R.s.to_numpy(); ends=R.e.to_numpy(); commits=R.commit.to_numpy()
i=np.argmin(np.where((O.ordered_at.to_numpy()[:,None]>=starts[None,:]) & (O.ordered_at.to_numpy()[:,None]<ends[None,:]), np.arange(len(R))[None,:], len(R)),axis=1)
anyhit=np.any((O.ordered_at.to_numpy()[:,None]>=starts[None,:])&(O.ordered_at.to_numpy()[:,None]<ends[None,:]),axis=1)
O['legacy_commit']=pd.Series(np.where(anyhit,commits[np.minimum(i,len(commits)-1)],pd.NaT),index=O.index)
g=O.drop_duplicates('order_id').groupby('legacy_commit').size().reindex(R.commit).fillna(0)
print('rows',len(O),'assigned',O.legacy_commit.notna().sum(),'transactions',len(R),'sum assigned',g.sum())
print('exact txn counts',int((R.n.to_numpy()==g.to_numpy()).sum()),'of',len(R))
print('sums expected',R.n.sum(),'assigned',g.sum())
print(pd.DataFrame({'n':R.n,'assigned':g.astype(int)}).iloc[np.where(R.n.to_numpy()!=g.to_numpy())[0]].head(20).to_string())
for job in ['legacy_backfill','orders_hourly']:
 q=O[O._load_job.eq(job)]
 print(job,len(q),'assigned',q.legacy_commit.notna().sum(),'commit range',q.legacy_commit.min(),q.legacy_commit.max())
