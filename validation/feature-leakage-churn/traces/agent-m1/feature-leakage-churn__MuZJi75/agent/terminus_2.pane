[?2004l[?2004h>     """Assign old-generation commit times to orders from scheduler intervals.
[?2004l[?2004h> 
[?2004l[?2004h>     After a failed load the next legacy load uses an expanding ordered_at interval.
[?2004l[?2004h>     Thus the earliest successful transaction containing an order's timestamp is the
[?2004l[?2004h>     transaction that first committed it to the old ``orders`` generation.
[?2004l[?2004h>     """
[?2004l[?2004h>     orders["_legacy_commit"] = pd.NaT
[?2004l[?2004h>     ops.legacy_orders_complete = True
[?2004l[?2004h>     if rename_at is None:
[?2004l[?2004h>         return
[?2004l[?2004h> 
[?2004l[?2004h>     records = [x for x in ops.order_txns
[?2004l[?2004h>                if x.table == "orders" and x.commit < rename_at]
[?2004l[?2004h>     if not records:
[?2004l[?2004h>         return
[?2004l[?2004h>     records.sort(key=lambda x: (x.start, x.commit, x.txn))
[?2004l[?2004h> 
[?2004l[?2004h>     starts, _ = _seconds([x.start for x in records])
[?2004l[?2004h>     ends, _ = _seconds([x.end for x in records])
[?2004l[?2004h>     commit_secs, _ = _seconds([x.commit for x in records])
[?2004l[?2004h>     event_secs, event_valid = _seconds(orders["ordered_at"])
[?2004l[?2004h>     if event_valid.any():
[?2004l[?2004h>         unique, inverse, counts = np.unique(event_secs[event_valid], return_inverse=True,
[?2004l[?2004h>                                             return_counts=True)
[?2004l[?2004h>         assigned = np.full(len(unique), -1, dtype="int64")
[?2004l[?2004h>         active = []
[?2004l[?2004h>         pos = 0
[?2004l[?2004h>         for event_no, ts in enumerate(unique):
[?2004l[?2004h>             while pos < len(records) and starts[pos] <= ts:
[?2004l[?2004h>                 heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))
[?2004l[?2004h>                 pos += 1
[?2004l[?2004h>             while active and active[0][1] <= ts:
[?2004l[?2004h>                 heapq.heappop(active)
[?2004l[?2004h>             if active:
[?2004l[?2004h>                 assigned[event_no] = active[0][2]
[?2004l[?2004h> 
[?2004l[?2004h>         txn_counts = np.zeros(len(records), dtype="int64")
[?2004l[?2004h>         hit = assigned >= 0
[?2004l[?2004h>         if hit.any():
[?2004l[?2004h>             np.add.at(txn_counts, assigned[hit], counts[hit])
[?2004l[?2004h>         expected = np.asarray([x.rows for x in records], dtype="int64")
[?2004l[?2004h>         ops.legacy_orders_complete = bool(np.array_equal(txn_counts, expected))
[?2004l[?2004h> 
[?2004l[?2004h>         out = np.full(len(orders), np.iinfo(np.int64).min, dtype="int64")
[?2004l[?2004h>         positions = np.flatnonzero(event_valid)
[?2004l[?2004h>         vals = assigned[inverse]
[?2004l[?2004h>         good = vals >= 0
[?2004l[?2004h>         out[positions[good]] = commit_secs[vals[good]]
[?2004l[?2004h>         result = pd.to_datetime(pd.Series(out, index=orders.index), unit="s", utc=True)
[?2004l[?2004h>         orders["_legacy_commit"] = result.where(out != np.iinfo(np.int64).min, pd.NaT)
