     2	from dataclasses import dataclass
     3	import heapq
     4	import json
     5	import os
     6	import re
     7	
     8	import numpy as np
     9	import pandas as pd
    10	
    11	
    12	@dataclass(frozen=True)
    13	class OrderTxn:
    14	    start: pd.Timestamp
    15	    end: pd.Timestamp
    16	    rows: int
    17	    commit: pd.Timestamp
    18	    table: str
    19	    txn: int
    20	
    21	
    22	@dataclass
    23	class Ops:
    24	    order_txns: list
    25	    schema_txns: list
    26	    rename_at: pd.Timestamp | None = None
    27	    legacy_orders_complete: bool = True
    28	
    29	
    30	_SELECT_RE = re.compile(
    31	    r"selected\s+orders\s+where\s+ordered_at\s*>=\s*(\S+)\s+"
    32	    r"and\s+ordered_at\s*<\s*(\S+):\s*(\d+)\s+rows;\s*"
    33	    r"sent\s+txn\s+(\d+)\s+to\s+commit(?:\s+into\s+(\S+))?"
    34	)
    35	_STATEMENT_RE = re.compile(r"^statement:\s*(.*)$")
    36	_SEND_RE = re.compile(r"\bsent\s+txn\s+(\d+)\s+to\s+commit(?:\s+into\s+(\S+))?")
    37	_RENAME_RE = re.compile(r"ALTER\s+TABLE\s+(\S+)\s+RENAME\s+TO\s+(\S+)", re.I)
    38	
    39	
    40	def _utc(value):
    41	    return pd.to_datetime(value, utc=True)
    42	
    43	
    44	def _table_name(value):
    45	    return value.strip('"`').split(".")[-1]
    46	
    47	
    48	def load_ops(data_dir):
    49	    commits = {}
    50	    path = os.path.join(data_dir, "_ops", "commits.jsonl")
    51	    if os.path.exists(path):
    52	        with open(path, encoding="utf-8") as fh:
    53	            for line in fh:
    54	                if line.strip():
    55	                    row = json.loads(line)
    56	                    commits[int(row["txn"])] = {
    57	                        "at": _utc(row["at"]),
    58	                        "outcome": row.get("outcome"),
    59	                        "table": row.get("table"),
    60	                        "rows": row.get("rows"),
    61	                    }
    62	
    63	    order_txns = []
    64	    schema_txns = []
    65	    statements = {}
    66	    with open(os.path.join(data_dir, "_ops", "scheduler.log"), encoding="utf-8") as fh:
    67	        for line in fh:
    68	            parts = line.rstrip("\n").split(maxsplit=2)
    69	            if len(parts) != 3:
    70	                continue
    71	            job, message = parts[1], parts[2]
    72	
    73	            if message.startswith("state=running"):
    74	                statements[job] = []
    75	                continue
    76	
    77	            match = _STATEMENT_RE.match(message)
    78	            if match:
    79	                statements.setdefault(job, []).append(match.group(1))
    80	                continue
    81	
    82	            match = _SELECT_RE.search(message)
    83	            if match:
    84	                start_s, end_s, rows, txn_s, table = match.groups()
    85	                txn = int(txn_s)
    86	                info = commits.get(txn, {})
    87	                if info.get("outcome") == "commit" and info.get("at") is not None:
    88	                    order_txns.append(OrderTxn(
    89	                        _utc(start_s), _utc(end_s), int(rows), info["at"],
    90	                        _table_name(table or "orders"), txn,
    91	                    ))
    92	                statements[job] = []
    93	                continue
    94	
    95	            match = _SEND_RE.search(message)
    96	            if match:
    97	                txn = int(match.group(1))
    98	                info = commits.get(txn, {})
    99	                if info.get("outcome") == "commit" and info.get("at") is not None and statements.get(job):
   100	                    schema_txns.append({
   101	                        "txn": txn,
   102	                        "at": info["at"],
   103	                        "statements": tuple(statements[job]),
   104	                    })
   105	                statements[job] = []
   106	
   107	    schema_txns.sort(key=lambda x: x["at"])
   108	    names = {"orders": "orders"}
   109	    current_identity = names["orders"]
   110	    rename_at = None
   111	    for txn in schema_txns:
   112	        for statement in txn["statements"]:
   113	            match = _RENAME_RE.fullmatch(statement)
   114	            if not match:
   115	                continue
   116	            old_name, new_name = map(_table_name, match.groups())
   117	            names[new_name] = names.get(old_name, old_name)
   118	            if old_name != new_name:
   119	                names.pop(old_name, None)
   120	        if names.get("orders") != current_identity:
   121	            if rename_at is None:
   122	                rename_at = txn["at"]
   123	            current_identity = names.get("orders")
   124	
   125	    return Ops(order_txns=order_txns, schema_txns=schema_txns, rename_at=rename_at)
   126	
   127	
   128	def _seconds(values):
   129	    values = pd.to_datetime(pd.Series(values), utc=True)
   130	    valid = values.notna().to_numpy()
   131	    out = values.to_numpy(dtype="datetime64[ns]").astype("int64") // 1_000_000_000
   132	    return out, valid
   133	
   134	
   135	def assign_legacy_order_commits(orders, ops, rename_at):
   136	    """Assign old-generation commit times to orders from scheduler intervals.
   137	
   138	    After a failed load the next legacy load uses an expanding ordered_at interval.
   139	    Thus the earliest successful transaction containing an order's timestamp is the
   140	    transaction that first committed it to the old ``orders`` generation.
   141	    """
   142	    orders["_legacy_commit"] = pd.NaT
   143	    ops.legacy_orders_complete = True
   144	    if rename_at is None:
   145	        return
   146	
   147	    records = [x for x in ops.order_txns
   148	               if x.table == "orders" and x.commit < rename_at]
   149	    if not records:
   150	        return
   151	    records.sort(key=lambda x: (x.start, x.commit, x.txn))
   152	
   153	    starts, _ = _seconds([x.start for x in records])
   154	    ends, _ = _seconds([x.end for x in records])
   155	    commit_secs, _ = _seconds([x.commit for x in records])
   156	    event_secs, event_valid = _seconds(orders["ordered_at"])
   157	    if event_valid.any():
   158	        unique, inverse, counts = np.unique(event_secs[event_valid], return_inverse=True,
   159	                                            return_counts=True)
   160	        assigned = np.full(len(unique), -1, dtype="int64")
   161	        active = []
   162	        pos = 0
   163	        for event_no, ts in enumerate(unique):
   164	            while pos < len(records) and starts[pos] <= ts:
   165	                heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))
   166	                pos += 1
   167	            while active and active[0][1] <= ts:
   168	                heapq.heappop(active)
   169	            if active:
   170	                assigned[event_no] = active[0][2]
   171	
   172	        txn_counts = np.zeros(len(records), dtype="int64")
   173	        hit = assigned >= 0
   174	        if hit.any():
   175	            np.add.at(txn_counts, assigned[hit], counts[hit])
   176	        expected = np.asarray([x.rows for x in records], dtype="int64")
   177	        ops.legacy_orders_complete = bool(np.array_equal(txn_counts, expected))
   178	
   179	        out = np.full(len(orders), np.iinfo(np.int64).min, dtype="int64")
   180	        positions = np.flatnonzero(event_valid)
   181	        vals = assigned[inverse]
   182	        good = vals >= 0
   183	        out[positions[good]] = commit_secs[vals[good]]
   184	        result = pd.to_datetime(pd.Series(out, index=orders.index), unit="s", utc=True)
   185	        orders["_legacy_commit"] = result.where(out != np.iinfo(np.int64).min, pd.NaT)
