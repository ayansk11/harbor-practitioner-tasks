[?2004l[?2004h>     }
[?2004l[?2004h>     known = bool(orders["_loaded_at"].notna().all() and legacy_orders_complete)
[?2004l[?2004h> 
[?2004l[?2004h>     if rename_at is None:
[?2004l[?2004h>         values = _event_features(
[?2004l[?2004h>             points, orders, "_loaded_at", "ordered_at",
[?2004l[?2004h>             amount_col="amount_cents", windows=(7, 30), need_last=True,
[?2004l[?2004h>         )
[?2004l[?2004h>         for name in out:
[?2004l[?2004h>             out[name] = values["spend"] if name == "spend_30d_cents" else values.get(name, values["last"])
[?2004l[?2004h>         return out, known
[?2004l[?2004h> 
[?2004l[?2004h>     old_mask = (points["as_of"] <= rename_at).to_numpy()
[?2004l[?2004h>     new_mask = ~old_mask
[?2004l[?2004h>     old_points = points.loc[old_mask].reset_index(drop=True)
[?2004l[?2004h>     new_points = points.loc[new_mask].reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h>     if old_mask.any():
[?2004l[?2004h>         old_events = orders.loc[orders["_legacy_commit"].notna()].copy()
[?2004l[?2004h>         values = _event_features(
[?2004l[?2004h>             old_points, old_events, "_legacy_commit", "ordered_at",
[?2004l[?2004h>             amount_col="amount_cents", windows=(7, 30), need_last=True,
[?2004l[?2004h>         )
[?2004l[?2004h>         out["orders_7d"][old_mask] = values["count_7"]
[?2004l[?2004h>         out["orders_30d"][old_mask] = values["count_30"]
[?2004l[?2004h>         out["spend_30d_cents"][old_mask] = values["spend"]
[?2004l[?2004h>         out["days_since_last_order"][old_mask] = values["last"]
[?2004l[?2004h> 
[?2004l[?2004h>     if new_mask.any():
[?2004l[?2004h>         new_events = orders.loc[orders["_loaded_at"].notna()].copy()
[?2004l[?2004h>         values = _event_features(
[?2004l[?2004h>             new_points, new_events, "_loaded_at", "ordered_at",
[?2004l[?2004h>             amount_col="amount_cents", windows=(7, 30), need_last=True,
[?2004l[?2004h>         )
[?2004l[?2004h>         out["orders_7d"][new_mask] = values["count_7"]
[?2004l[?2004h>         out["orders_30d"][new_mask] = values["count_30"]
[?2004l[?2004h>         out["spend_30d_cents"][new_mask] = values["spend"]
[?2004l[?2004h>         out["days_since_last_order"][new_mask] = values["last"]
[?2004l[?2004h>     return out, known
