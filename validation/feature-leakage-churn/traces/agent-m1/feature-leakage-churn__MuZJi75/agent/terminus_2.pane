[?2004l[?2004h>     id_to_customer = pd.Series(np.arange(len(customers), dtype="int64"), index=customer_ids)
[?2004l[?2004h>     customer_index = id_to_customer.reindex(unique_ids).to_numpy(dtype="float64")
[?2004l[?2004h>     has_customer = np.isfinite(customer_index)
