[?2004l[?2004h> def customer_features(points, customers, plan_changes):
[?2004l[?2004h>     """Reconstruct plan/login where possible and report global reconstructability."""
[?2004l[?2004h>     n = len(points)
[?2004l[?2004h>     plan = np.full(n, np.nan, dtype=object)
[?2004l[?2004h>     login_days = np.full(n, np.nan, dtype="float64")
[?2004l[?2004h>     plan_known = np.zeros(n, dtype="bool")
[?2004l[?2004h>     login_known = np.zeros(n, dtype="bool")
[?2004l[?2004h> 
[?2004l[?2004h>     customer_by_id = customers.set_index("customer_id", drop=False)
[?2004l[?2004h>     final_plan = points["customer_id"].map(customer_by_id["plan"])
[?2004l[?2004h>     final_login = points["customer_id"].map(customer_by_id["last_login_at"])
[?2004l[?2004h>     final_updated = points["customer_id"].map(customer_by_id["_updated_at"])
[?2004l[?2004h>     final_signup = points["customer_id"].map(customer_by_id["signup_at"])
[?2004l[?2004h>     final_plan = final_plan.to_numpy(dtype=object)
[?2004l[?2004h>     final_login = pd.to_datetime(final_login, utc=True)
[?2004l[?2004h>     final_updated = pd.to_datetime(final_updated, utc=True)
[?2004l[?2004h>     final_signup = pd.to_datetime(final_signup, utc=True)
[?2004l[?2004h> 
[?2004l[?2004h>     point_secs, point_valid = _seconds(points["as_of"])
[?2004l[?2004h>     signup_secs, signup_valid = _seconds(final_signup)
[?2004l[?2004h>     updated_secs, updated_valid = _seconds(final_updated)
[?2004l[?2004h>     login_secs, login_valid = _seconds(final_login)
[?2004l[?2004h> 
[?2004l[?2004h>     change_commit, change_commit_valid = _seconds(plan_changes["_loaded_at"])
[?2004l[?2004h>     change_changed, change_changed_valid = _seconds(plan_changes["changed_at"])
[?2004l[?2004h>     change_valid = change_commit_valid & change_changed_valid
[?2004l[?2004h>     change_positions = np.flatnonzero(change_valid)
[?2004l[?2004h>     change_commit = change_commit[change_positions]
[?2004l[?2004h>     change_changed = change_changed[change_positions]
[?2004l[?2004h>     change_ids = plan_changes["customer_id"].to_numpy(dtype="object")[change_positions]
[?2004l[?2004h>     change_plans = plan_changes["new_plan"].to_numpy(dtype=object)[change_positions]
[?2004l[?2004h> 
[?2004l[?2004h>     point_ids = points["customer_id"].to_numpy(dtype="object")[point_positions]
[?2004l[?2004h>     codes, _ = pd.factorize(np.concatenate([point_ids, change_ids]), sort=True)
[?2004l[?2004h>     point_codes = np.asarray(codes[: len(point_positions)], dtype="int64")
[?2004l[?2004h>     change_codes = np.asarray(codes[len(point_positions):], dtype="int64")
[?2004l[?2004h>     change_order = np.argsort(change_commit, kind="mergesort")
[?2004l[?2004h>     change_commit = change_commit[change_order]
[?2004l[?2004h>     change_changed = change_changed[change_order]
[?2004l[?2004h>     change_codes = change_codes[change_order]
[?2004l[?2004h>     change_plans = change_plans[change_order]
[?2004l[?2004h> 
[?2004l[?2004h>     point_order = np.argsort(point_secs, kind="mergesort")
[?2004l[?2004h>     latest_change = {}
[?2004l[?2004h>     change_i = 0
[?2004l[?2004h>     for q in point_order:
[?2004l[?2004h>         original = int(point_positions[q])
[?2004l[?2004h>         t = int(point_secs[q])
[?2004l[?2004h>         code = int(point_codes[q])
[?2004l[?2004h>         while change_i < len(change_commit) and change_commit[change_i] < t:
[?2004l[?2004h>             ccode = int(change_codes[change_i])
[?2004l[?2004h>             changed = int(change_changed[change_i])
[?2004l[?2004h>             current = latest_change.get(ccode)
[?2004l[?2004h>             if current is None or changed >= current[0]:
[?2004l[?2004h>                 latest_change[ccode] = (changed, change_plans[change_i])
[?2004l[?2004h>             change_i += 1
[?2004l[?2004h> 
[?2004l[?2004h>         # No customer row exists until the sign-up row is committed.
[?2004l[?2004h>         if not signup_valid[original] or t <= signup_secs[original]:
[?2004l[?2004h>             plan_known[original] = login_known[original] = True
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h>         # If the final customer row was last committed before t, it is exactly the
[?2004l[?2004h>         # row the live query saw.
[?2004l[?2004h>         if updated_valid[original] and updated_secs[original] < t:
[?2004l[?2004h>             plan[original] = final_plan[original]
[?2004l[?2004h>             plan_known[original] = True
[?2004l[?2004h>             if login_valid[original]:
[?2004l[?2004h>                 login_days[original] = (t - login_secs[original]) / 86400.0
[?2004l[?2004h>             login_known[original] = True
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h>         # Otherwise plan history can still supply a visible plan; login history cannot.
[?2004l[?2004h>         current = latest_change.get(code)
[?2004l[?2004h>         if current is not None:
[?2004l[?2004h>             plan[original] = current[1]
[?2004l[?2004h>             plan_known[original] = True
[?2004l[?2004h> 
[?2004l[?2004h>     return plan, login_days, bool(plan_known.all()), bool(login_known.all())
