[?2004l[?2004h> def order_features(points, orders, rename_at, legacy_orders_complete):
[?2004l[?2004h>     """Live order features across the old and new physical orders tables."""
[?2004l[?2004h>     n = len(points)
[?2004l[?2004h>     out = {
[?2004l[?2004h>         "orders_7d": np.zeros(n, dtype="int64"),
[?2004l[?2004h>         "orders_30d": np.zeros(n, dtype="int64"),
[?2004l[?2004h>         "spend_30d_cents": np.zeros(n, dtype="int64"),
