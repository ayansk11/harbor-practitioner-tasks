   269	    all_ids = pd.concat([lab_ids, point_ids], ignore_index=True)
   270	    row_codes, unique_ids = pd.factorize(all_ids, sort=True)
   271	    lab_codes = np.asarray(row_codes[: len(labels)], dtype="int64")
   272	    point_codes = np.asarray(row_codes[len(labels):], dtype="int64")
   273	    unique_ids = np.asarray(unique_ids)
   274	
   275	    id_to_customer = pd.Series(np.arange(len(customers), dtype="int64"),
   276	                               index=customers["customer_id"])
   277	    unique_customer = id_to_customer.reindex(unique_ids).to_numpy(dtype="float64")
   278	    unique_has_customer = np.isfinite(unique_customer)
   279	    unique_customer_index = np.where(unique_has_customer, unique_customer, 0).astype("int64")
   280	
   281	    lab_customer_index = unique_customer_index[lab_codes]
   282	    lab_has_customer = unique_has_customer[lab_codes]
   283	    pt_customer_index = unique_customer_index[point_codes]
   284	    pt_has_customer = unique_has_customer[point_codes]
   285	
   286	    districts = customers["postcode_district"].astype("object").to_numpy()
   287	    lab_district = np.where(lab_has_customer, districts[lab_customer_index], None)
   288	    pt_district = np.where(pt_has_customer, districts[pt_customer_index], None)
   289	    district_values = pd.concat([
   290	        pd.Series(lab_district, dtype="object"),
   291	        pd.Series(pt_district, dtype="object"),
   292	    ], ignore_index=True)
   293	    district_codes, _ = pd.factorize(district_values, use_na_sentinel=True)
   294	    lab_district = np.asarray(district_codes[: len(labels)], dtype="int64")
   295	    pt_district = np.asarray(district_codes[len(labels):], dtype="int64")
   296	    pt_district = np.where(pt_district >= 0, pt_district, -999999)
   297	
   298	    # A label enters the JOIN only when both its scheduled commit and the joined
   299	    # customer row are visible.  signup_at is immutable and is the customer row's
   300	    # source/commit time.
   301	    lab_commit, lab_commit_valid = _seconds(labels["_loaded_at"])
   302	    lab_signup_secs = np.full(len(labels), np.iinfo(np.int64).max, dtype="int64")
   303	    if lab_has_customer.any():
   304	        positions = lab_customer_index[lab_has_customer]
   305	        signup_secs, signup_valid = _seconds(customers["signup_at"].iloc[positions])
   306	        lab_signup_secs[lab_has_customer] = np.where(signup_valid, signup_secs,
   307	                                                      np.iinfo(np.int64).max)
   308	    lab_commit = np.where(lab_commit_valid, lab_commit, np.iinfo(np.int64).max)
   309	    eligibility = np.maximum(lab_commit, lab_signup_secs)
   310	
   311	    y_values = pd.to_numeric(labels["churned_30d"], errors="coerce").to_numpy(dtype="float64")
   312	    label_order = np.argsort(eligibility, kind="mergesort")
   313	    eligibility = eligibility[label_order]
   314	    lab_district = lab_district[label_order]
   315	    y_values = y_values[label_order]
   316	
   317	    point_order = np.argsort(point_secs, kind="mergesort")
   318	    global_n = global_sum = 0
   319	    district_n = {}
   320	    district_sum = {}
   321	    label_i = 0
   322	    for q in point_order:
   323	        original = int(point_positions[q])
   324	        t = int(point_secs[q])
   325	        own = int(pt_district[q])
   326	        while label_i < len(eligibility) and eligibility[label_i] < t:
   327	            y = float(y_values[label_i])
   328	            if np.isfinite(y):
   329	                global_n += 1
   330	                global_sum += int(y)
   331	            district = int(lab_district[label_i])
   332	            district_n[district] = district_n.get(district, 0) + 1
   333	            district_sum[district] = district_sum.get(district, 0) + (int(y) if np.isfinite(y) else 0)
