   345	def app_minutes(points):
   346	    order = np.lexsort((points["as_of"].to_numpy(), points["customer_id"].to_numpy()))
   347	    ordered = points["app_minutes_7d"].iloc[order]
   348	    filled = ordered.groupby(points["customer_id"].iloc[order]).ffill()
   349	    out = np.full(len(points), np.nan, dtype="float64")
   350	    out[order] = filled.to_numpy(dtype="float64")
   351	    return out
