[?2004l[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# cat > churn/build_features.py <<'PY'
[?2004l[?2004h> """Build the live-equivalent feature table: python -m churn.build_features --data <dir> --out <file.parquet>"""
[?2004l[?2004h> import argparse
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> from churn.extract import load_extract
[?2004l[?2004h> from churn.live_features import (
[?2004l[?2004h>     app_minutes,
[?2004l[?2004h>     customer_features,
[?2004l[?2004h>     order_features,
[?2004l[?2004h>     status_features,
[?2004l[?2004h>     target_encoding,
[?2004l[?2004h>     ticket_features,
[?2004l[?2004h> )
[?2004l[?2004h> from churn.ops import assign_legacy_order_commits, load_ops
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> BASE_COLUMNS = ["customer_id", "as_of"]
[?2004l[?2004h> LIVE_FEATURES = [
[?2004l[?2004h>     "orders_7d", "orders_30d", "spend_30d_cents", "tickets_30d",
[?2004l[?2004h>     "days_since_last_order", "tenure_days", "status", "plan",
[?2004l[?2004h>     "days_since_last_login", "app_minutes_7d", "te_district",
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build(data_dir):
[?2004l[?2004h>     tables = load_extract(data_dir)
[?2004l[?2004h>     points = tables["scoring_points"].reset_index(drop=True)
[?2004l[?2004h>     customers = tables["customers"]
[?2004l[?2004h>     orders = tables["orders"].copy()
[?2004l[?2004h>     tickets = tables["tickets"]
[?2004l[?2004h>     snapshots = tables["status_snapshots"]
[?2004l[?2004h>     labels = tables["labels"]
[?2004l[?2004h>     plan_changes = tables["plan_changes"]
[?2004l[?2004h> 
[?2004l[?2004h>     ops = load_ops(data_dir)
[?2004l[?2004h>     assign_legacy_order_commits(orders, ops, ops.rename_at)
[?2004l[?2004h> 
[?2004l[?2004h>     out = points[["customer_id", "as_of"]].copy()
[?2004l[?2004h>     values, orders_known = order_features(
[?2004l[?2004h>         points, orders, ops.rename_at, ops.legacy_orders_complete,
[?2004l[?2004h>     )
[?2004l[?2004h>     if orders_known:
[?2004l[?2004h>         out["orders_7d"] = values["orders_7d"]
[?2004l[?2004h>         out["orders_30d"] = values["orders_30d"]
[?2004l[?2004h>         out["spend_30d_cents"] = values["spend_30d_cents"]
[?2004l[?2004h>         out["days_since_last_order"] = values["days_since_last_order"]
[?2004l[?2004h> 
[?2004l[?2004h>     out["tickets_30d"] = ticket_features(points, tickets)
[?2004l[?2004h> 
[?2004l[?2004h>     signup = points["customer_id"].map(customers.set_index("customer_id")["signup_at"])
[?2004l[?2004h>     tenure = (points["as_of"] - signup).dt.total_seconds() / 86400.0
[?2004l[?2004h>     exists = signup.notna() & (signup < points["as_of"])
[?2004l[?2004h>     out["tenure_days"] = tenure.where(exists)
[?2004l[?2004h> 
[?2004l[?2004h>     out["status"] = status_features(points, snapshots)
[?2004l[?2004h>     plan, login, keep_plan, keep_login = customer_features(points, customers, plan_changes)
[?2004l[?2004h>     if keep_plan:
[?2004l[?2004h>         out["plan"] = plan
[?2004l[?2004h>     if keep_login:
[?2004l[?2004h>         out["days_since_last_login"] = login
[?2004l[?2004h>     out["app_minutes_7d"] = app_minutes(points)
[?2004l[?2004h>     out["te_district"] = target_encoding(points, labels, customers)
[?2004l[?2004h> 
[?2004l[?2004h>     kept = [f for f in LIVE_FEATURES if f in out.columns]
[?2004l[?2004h>     return out[BASE_COLUMNS + kept]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     ap = argparse.ArgumentParser(description=__doc__)
[?2004l[?2004h>     ap.add_argument("--data", required=True, help="folder with the extract CSVs")
[?2004l[?2004h>     ap.add_argument("--out", required=True, help="output parquet file")
[?2004l[?2004h>     args = ap.parse_args()
[?2004l[?2004h>     features = build(args.data)
[?2004l[?2004h>     out_path = os.path.abspath(args.out)
[?2004l[?2004h>     os.makedirs(os.path.dirname(out_path), exist_ok=True)
[?2004l[?2004h>     features.to_parquet(out_path, index=False)
[?2004l[?2004h>     print(f"wrote {len(features)} rows x {features.shape[1]} columns to {args.out}")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     main()
