[?2004lpython - <<'PY'
import pandas as pd,re,collections
logs=[]
for l in open('data/_ops/scheduler.log'):
 a=l.rstrip().split(maxsplit=2)
 if len(a)>2 and a[1] in ('legacy_orders','orders_hourly','legacy_backfill'): logs.append((a[0],a[1],a[2]))
for job in ['legacy_orders','orders_hourly']:
 print('\n',job)
 for pat in ['state=failed','state=running','state=success','selected']:
  q=[x for x in logs if x[1]==job and pat in x[2]]
  print(pat,len(q),q[:4])
PY
python - <<'PY'
import pandas as pd
from churn.extract import load_extract
from churn.windows import _window
T=load_extract('data')
# Compare unordered amount prefix to corrected prefix on one point.
p=T['scoring_points'].head(1)
cnt,bad=_window(p,T['orders'],'ordered_at',30,'amount_cents')
O=T['orders']; q=O[(O.customer_id==p.customer_id.iloc[0])&(O.ordered_at>=p.as_of.iloc[0]-pd.Timedelta(days=30))&(O.ordered_at<p.as_of.iloc[0])]
print('point',p[['customer_id','as_of']].to_dict('records')[0], 'count',cnt,'bad spend',bad,'correct',q.amount_cents.sum())
PY
