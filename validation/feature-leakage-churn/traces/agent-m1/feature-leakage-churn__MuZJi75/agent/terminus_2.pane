[?2004l[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# cat > churn/windows.py <<'PY'
[?2004l[?2004h> """Point-in-time activity windows used by the live-feature reconstruction."""
[?2004l[?2004h> PY
[?2004l[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# 
[?2004l[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# cat > churn/live_features.py <<'PY'
[?2004l[?2004h> """Reconstruct the values computed by ``live/features.py`` from an extract.
[?2004l[?2004h> 
[?2004l[?2004h> The reconstruction uses only facts that were committed before each request.  For
[?2004l[?2004h> rows written by scheduled jobs this comes from ``_loaded_at`` (or, for the old
[?2004l[?2004h> orders generation, from the scheduler transaction records).  Rows written by the
[?2004l[?2004h> sign-up, ticket CDC and scoring services were committed at the source timestamps
[?2004l[?2004h> recorded in the extract.
[?2004l[?2004h> """
[?2004l[?2004h> from bisect import bisect_left, insort
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _seconds(values):
[?2004l[?2004h>     values = pd.to_datetime(pd.Series(values), utc=True)
[?2004l[?2004h>     valid = values.notna().to_numpy()
[?2004l[?2004h>     out = values.to_numpy(dtype="datetime64[ns]").astype("int64") // 1_000_000_000
[?2004l[?2004h>     return out, valid
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class _Fenwick:
[?2004l[?2004h>     def __init__(self, n):
[?2004l[?2004h>         self.n = n
[?2004l[?2004h>         self.counts = [0] * (n + 1)
[?2004l[?2004h>         self.amounts = [0] * (n + 1)
[?2004l[?2004h> 
[?2004l[?2004h>     def add(self, i, amount):
[?2004l[?2004h>         i += 1
[?2004l[?2004h>         while i <= self.n:
[?2004l[?2004h>             self.counts[i] += 1
[?2004l[?2004h>             self.amounts[i] += amount
[?2004l[?2004h>             i += i & -i
[?2004l[?2004h> 
[?2004l[?2004h>     def range(self, left, right):
[?2004l[?2004h>         if right <= left:
[?2004l[?2004h>             return 0, 0
[?2004l[?2004h>         return self._prefix(right) - self._prefix(left)
[?2004l[?2004h> 
[?2004l[?2004h>     def _prefix(self, i):
[?2004l[?2004h>         count = amount = 0
[?2004l[?2004h>         while i > 0:
[?2004l[?2004h>             count += self.counts[i]
[?2004l[?2004h>             amount += self.amounts[i]
[?2004l[?2004h>             i -= i & -i
[?2004l[?2004h>         return count, amount
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _factorize_ids(a, b=None):
[?2004l[?2004h>     if b is None:
[?2004l[?2004h>         codes, unique = pd.factorize(pd.Series(a), sort=True)
[?2004l[?2004h>         return codes, unique
[?2004l[?2004h>     combined = pd.concat([pd.Series(a), pd.Series(b)], ignore_index=True)
[?2004l[?2004h>     codes, unique = pd.factorize(combined, sort=True)
[?2004l[?2004h>     return codes[: len(a)], codes[len(a) :], unique
