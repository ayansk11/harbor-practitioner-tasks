[1652.389469, "o", "> "]
[1652.389652, "o", "    statements = {}\r\n"]
[1652.38967, "o", "\u001b[?2004l\r"]
[1652.389726, "o", "\u001b[?2004h> "]
[1652.390473, "o", "    with open(os.path.join(data_dir, \"_ops\", \"scheduler.log\"), encoding=\"utf-8\") as fh:\r\n"]
[1652.390514, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1652.390556, "o", "> "]
[1652.390777, "o", "        for line in fh:\r\n"]
[1652.390818, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1652.39086, "o", "> "]
[1652.391374, "o", "            parts = line.rstrip(\"\\n\").split(maxsplit=2)\r\n"]
[1652.391393, "o", "\u001b[?2004l\r"]
[1652.39146, "o", "\u001b[?2004h> "]
[1652.391732, "o", "            if len(parts) != 3:\r\n"]
[1652.391789, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.391987, "o", "                continue\r\n"]
[1652.391998, "o", "\u001b[?2004l\r"]
[1652.39206, "o", "\u001b[?2004h> "]
