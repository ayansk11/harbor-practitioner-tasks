[3248.244085, "i", "python - <<'PY'\nimport json,pandas as pd\nfrom churn.extract import load_extract\nfrom churn.live_features import status_features\nT=load_extract('data'); P=T['scoring_points']; S=T['status_snapshots']\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))]); L['as_of']=pd.to_datetime(L.as_of,utc=True)\nrow=L[L.status.notna()].iloc[0]\nq=P[(P.customer_id==row.customer_id)&(P.as_of==row.as_of)].reset_index(drop=True)\nprint('row',row.customer_id,row.as_of,'live',row.status)\nprint('helper',status_features(q,S)[0])\nv=S[(S.customer_id==row.customer_id)&(S._loaded_at<row.as_of)].sort_values(['snapshot_date','_loaded_at'])\nprint('direct',v.status.iloc[-1] if len(v) else None)\nprint(v.tail(10).to_string(index=False))\nPY\n"]
