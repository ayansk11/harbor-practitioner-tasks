[263.596033, "i", "python - <<'PY'\nimport pandas as pd,re,collections\nlogs=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)>2 and a[1] in ('legacy_orders','orders_hourly','legacy_backfill'): logs.append((a[0],a[1],a[2]))\nfor job in ['legacy_orders','orders_hourly']:\n print('\\n',job)\n for pat in ['state=failed','state=running','state=success','selected']:\n  q=[x for x in logs if x[1]==job and pat in x[2]]\n  print(pat,len(q),q[:4])\nPY\n"]
