[3250.048048, "i", "cat > churn/ops.py <<'PY'\n\"\"\"Read warehouse scheduler records needed for point-in-time reconstruction.\"\"\"\nfrom dataclasses import dataclass\nimport heapq\nimport json\nimport os\nimport re\n\nimport numpy as np\nimport pandas as pd\n\n\n@dataclass(frozen=True)\nclass OrderTxn:\n    start: pd.Timestamp\n    end: pd.Timestamp\n    rows: int\n    commit: pd.Timestamp\n    table: str\n    txn: int\n\n\n@dataclass\nclass Ops:\n    order_txns: list\n    schema_txns: list\n    rename_at: pd.Timestamp | None = None\n    legacy_orders_complete: bool = True\n\n\n_SELECT_RE = re.compile(\n    r\"selected\\s+orders\\s+where\\s+ordered_at\\s*>=\\s*(\\S+)\\s+\"\n    r\"and\\s+ordered_at\\s*<\\s*(\\S+):\\s*(\\d+)\\s+rows;\\s*\"\n    r\"sent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\"\n)\n_SEND_RE = re.compile(r\"\\bsent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\")\n_RENAME_RE = re.compile(r\"ALTER\\s+TABLE\\s+(\\S+)\\s+RENAME\\s+TO\\s+(\\S+)\", re.I)\n\n\ndef _utc(value):\n    return pd.to_datetime(value, utc=True)\n\n\ndef _table_name(value):\n    return value.strip('\"`').split(\".\")[-"]
[3250.048191, "i", "1]\n\n\ndef load_ops(data_dir):\n    commits = {}\n    path = os.path.join(data_dir, \"_ops\", \"commits.jsonl\")\n    if os.path.exists(path):\n        with open(path, encoding=\"utf-8\") as fh:\n            for line in fh:\n                if line.strip():\n                    row = json.loads(line)\n                    commits[int(row[\"txn\"])] = {\n                        \"at\": _utc(row[\"at\"]),\n                        \"outcome\": row.get(\"outcome\"),\n                        \"table\": row.get(\"table\"),\n                        \"rows\": row.get(\"rows\"),\n                    }\n\n    order_txns = []\n    schema_txns = []\n    statements = {}\n    with open(os.path.join(data_dir, \"_ops\", \"scheduler.log\"), encoding=\"utf-8\") as fh:\n        for line in fh:\n            parts = line.rstrip(\"\\n\").split(maxsplit=2)\n            if len(parts) != 3:\n                continue\n            job, message = parts[1], parts[2]\n\n            if \"state=running\" in message:\n                statements[job] = []\n                continue\n            if \"state=\" i"]
[3250.048256, "i", "n message:\n                statements[job] = []\n                continue\n\n            if \"statement:\" in message:\n                statement = message.split(\"statement:\", 1)[1].strip()\n                statements.setdefault(job, []).append(statement)\n                continue\n\n            match = _SELECT_RE.search(message)\n            if match:\n                start_s, end_s, rows, txn_s, table = match.groups()\n                txn = int(txn_s)\n                info = commits.get(txn, {})\n                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None:\n                    order_txns.append(OrderTxn(\n                        _utc(start_s), _utc(end_s), int(rows), info[\"at\"],\n                        _table_name(table or \"orders\"), txn,\n                    ))\n                statements[job] = []\n                continue\n\n            match = _SEND_RE.search(message)\n            if match:\n                txn = int(match.group(1))\n                info = commits.get(txn, {})\n                if info.get(\""]
[3250.048344, "i", "outcome\") == \"commit\" and info.get(\"at\") is not None and statements.get(job):\n                    schema_txns.append({\n                        \"txn\": txn,\n                        \"at\": info[\"at\"],\n                        \"statements\": tuple(statements[job]),\n                    })\n                statements[job] = []\n\n    schema_txns.sort(key=lambda x: x[\"at\"])\n    rename_at = None\n    identities = {\"orders\": \"orders-initial\"}\n    for txn in schema_txns:\n        before = identities.get(\"orders\")\n        for statement in txn[\"statements\"]:\n            match = _RENAME_RE.fullmatch(statement)\n            if not match:\n                continue\n            old_name, new_name = map(_table_name, match.groups())\n            identity = identities.pop(old_name, old_name)\n            identities[new_name] = identity\n        after = identities.get(\"orders\")\n        if after != before and rename_at is None:\n            rename_at = txn[\"at\"]\n\n    return Ops(order_txns=order_txns, schema_txns=schema_txns, rename_at=rename_at"]
