[219.511836, "i", "python - <<'PY'\nimport pandas as pd,json\nO=pd.read_parquet('/tmp/current.parquet')\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))]); L['as_of']=pd.to_datetime(L.as_of,utc=True)\nM=L.merge(O,on=['customer_id','as_of'],suffixes=('_live','_off'))\nfor f in ['orders_7d','orders_30d','spend_30d_cents','days_since_last_order','te_district']:\n bad=~((M[f+'_live']-M[f+'_off']).abs().le(1e-6))\n print('\\n',f,'bad',bad.sum(),'live greater',sum(M.loc[bad,f+'_live']>M.loc[bad,f+'_off']))\n print(M.loc[bad,[f+'_live',f+'_off']].head(5).to_string(index=False))\nPY\n"]
