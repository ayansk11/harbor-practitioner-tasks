[2806.514913, "o", "     1\t\"\"\"Read the warehouse scheduler records used for point-in-time reconstruction.\"\"\"\r\n     2\tfrom dataclasses import dataclass\r\n     3\timport heapq\r\n     4\timport json\r\n     5\timport os\r\n"]
[2806.514982, "o", "     6\timport re\r\n     7\t\r\n     8\timport numpy as np\r\n     9\timport pandas as pd\r\n    10\t\r\n    11\t\r\n"]
[2806.51503, "o", "    12\t@dataclass(frozen=True)\r\n    13\tclass OrderTxn:\r\n    14\t    start: pd.Timestamp\r\n    15\t    end: pd.Timestamp\r\n    16\t    rows: int\r\n    17\t    commit: pd.Timestamp\r\n    18\t    table: str\r\n    19\t    txn: int\r\n    20\t\r\n    21\t\r\n    22\t@dataclass\r\n    23\tclass Ops:\r\n    24\t    order_txns: list\r\n    25\t    schema_txns: list\r\n    26\t    rename_at: pd.Timestamp | None = None\r\n    27"]
[2806.515083, "o", "\t    legacy_orders_complete: bool = True\r\n    28\t\r\n    29\t\r\n    30\t_SELECT_RE = re.compile(\r\n    31\t    r\"selected\\s+orders\\s+where\\s+ordered_at\\s*>=\\s*(\\S+)\\s+\"\r\n    32\t    r\"and\\s+ordered_at\\s*<\\s*(\\S+):\\s*(\\d+)\\s+rows;\\s*\"\r\n    33\t    r\"sent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\"\r\n    34\t)\r\n    35\t_STATEMENT_RE = re.compile(r\"^statement:\\s*(.*)$\")\r\n    36\t_SEND_RE = re.compile(r\"\\bsent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\")\r\n    37\t_RENAME_RE = re.compile(r\"ALTER\\s+TABLE\\s+(\\S+)\\s+RENAME\\s+TO\\s+(\\S+)\", re.I)\r\n    38\t\r\n"]
[2806.515116, "o", "    39\t\r\n    40\tdef _utc(value):\r\n    41\t    return pd.to_datetime(value, utc=True)\r\n    42\t\r\n    43\t\r\n    44\tdef _table_name(value):\r\n    45\t    return value.strip('\"`').split(\".\")[-1]\r\n    46\t\r\n    47\t\r\n    48\tdef load_ops(data_dir):\r\n    49\t    commits = {}\r\n    50\t"]
[2806.515149, "o", "    path = os.path.join(data_dir, \"_ops\", \"commits.jsonl\")\r\n    51\t    if os.path.exists(path):\r\n    52\t        with open(path, encoding=\"utf-8\") as fh:\r\n    53\t            for line in fh:\r\n    54\t                if line.strip():\r\n    55\t                    row = json.loads(line)\r\n    56\t                    commits[int(row[\"txn\"])] = {\r\n    57\t                        \"at\": _utc(row[\"at\"]),"]
[2806.515182, "o", "\r\n    58\t                        \"outcome\": row.get(\"outcome\"),\r\n    59\t                        \"table\": row.get(\"table\"),\r\n    60\t                        \"rows\": row.get(\"rows\"),\r\n    61\t                    }\r\n    62\t\r\n    63\t    order_txns = []\r\n    64\t    schema_txns = []\r\n"]
[2806.515212, "o", "    65\t    statements = {}\r\n    66\t    with open(os.path.join(data_dir, \"_ops\", \"scheduler.log\"), encoding=\"utf-8\") as fh:\r\n    67\t        for line in fh:\r\n    68\t            parts = line.rstrip(\"\\n\").split(maxsplit=2)\r\n    69\t            if len(parts) != 3:\r\n    70\t                continue\r\n    71\t            job, message = parts[1], parts[2]\r\n"]
[2806.515242, "o", "    72\t\r\n    73\t            if message.startswith(\"state=running\"):\r\n    74\t                statements[job] = []\r\n    75\t                continue\r\n    76\t\r\n"]
[2806.515279, "o", "    77\t            match = _STATEMENT_RE.match(message)\r\n    78\t            if match:\r\n    79\t                statements.setdefault(job, []).append(match.group(1))\r\n    80\t                continue\r\n    81\t\r\n    82\t            match = _SELECT_RE.search(message)\r\n    83\t            if match:\r\n    84\t"]
[2806.515311, "o", "                start_s, end_s, rows, txn_s, table = match.groups()\r\n    85\t                txn = int(txn_s)\r\n    86\t                info = commits.get(txn, {})\r\n    87\t                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None:\r\n    88\t                    order_txns.append(OrderTxn(\r\n    89\t                        _utc(start_s), _utc(end_s), int(rows), info[\"at\"],\r\n    90\t                        _table_name(table or \"orders\"), txn,\r\n    91\t                    ))\r\n"]
[2806.515346, "o", "    92\t                statements[job] = []\r\n    93\t                continue\r\n    94\t\r\n    95\t            match = _SEND_RE.search(message)\r\n    96\t            if match:\r\n    97\t                txn = int(match.group(1))\r\n    98\t                info = commits.get(txn, {})\r\n    99\t                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None and statements.get(job):\r\n   100\t                    schema_txns.append({\r\n"]
[2806.51539, "o", "   101\t                        \"txn\": txn,\r\n   102\t                        \"at\": info[\"at\"],\r\n   103\t                        \"statements\": tuple(statements[job]),\r\n   104\t                    })\r\n   105\t                statements[job] = []\r\n   106\t\r\n   107\t    schema_txns.sort(key=lambda x: x[\"at\"])\r\n"]
[2806.515424, "o", "   108\t    names = {\"orders\": \"orders\"}\r\n   109\t    current_identity = names[\"orders\"]\r\n   110\t    rename_at = None\r\n   111\t    for txn in schema_txns:\r\n   112\t        for statement in txn[\"statements\"]:\r\n   113\t            match = _RENAME_RE.fullmatch(statement)\r\n   114\t            if not match:\r\n   115\t                continue\r\n   116\t            old_name, new_name = map(_table_name, match.groups())\r\n   117\t            names[new_name] = names.get(old_name, old_name)\r\n"]
[2806.515455, "o", "   118\t            if old_name != new_name:\r\n   119\t                names.pop(old_name, None)\r\n   120\t        if names.get(\"orders\") != current_identity:\r\n   121\t            if rename_at is None:\r\n   122\t                rename_at = txn[\"at\"]\r\n   123\t            current_identity = names.get(\"orders\")\r\n   124\t\r\n"]
[2806.515489, "o", "   125\t    return Ops(order_txns=order_txns, schema_txns=schema_txns, rename_at=rename_at)\r\n   126\t\r\n   127\t\r\n   128\tdef _seconds(values):\r\n   129\t    values = pd.to_datetime(pd.Series(values), utc=True)\r\n   130\t    valid = values.notna().to_numpy()\r\n   131\t    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n   132\t    return out, valid"]
[2806.51552, "o", "\r\n   133\t\r\n   134\t\r\n   135\tdef assign_legacy_order_commits(orders, ops, rename_at):\r\n   136\t    \"\"\"Assign old-generation commit times to orders from scheduler intervals.\r\n   137\t\r\n   138\t    After a failed load the next legacy load uses an expanding ordered_at interval.\r\n"]
[2806.515556, "o", "   139\t    Thus the earliest successful transaction containing an order's timestamp is the\r\n   140\t    transaction that first committed it to the old ``orders`` generation.\r\n   141\t    \"\"\"\r\n   142\t    orders[\"_legacy_commit\"] = pd.NaT\r\n   143\t    ops.legacy_orders_complete = True\r\n   144\t    if rename_at is None:\r\n   145\t        return\r\n   146\t\r\n"]
[2806.515585, "o", "   147\t    records = [x for x in ops.order_txns\r\n   148\t               if x.table == \"orders\" and x.commit < rename_at]\r\n   149\t    if not records:\r\n   150\t        return\r\n   151\t    records.sort(key=lambda x: (x.start, x.commit, x.txn))\r\n   152\t\r\n   153\t    starts, _ = _seconds([x.start for x in records])\r\n   154\t    ends, _ = _seconds([x.end for x in records])\r\n   155\t    commit_secs, _ = _seconds([x.commit for x in records])\r\n   156\t    event_secs, event_valid = _seconds(orders[\"ordered_at\"])\r\n"]
[2806.515618, "o", "   157\t    if event_valid.any():\r\n   158\t        unique, inverse, counts = np.unique(event_secs[event_valid], return_inverse=True,\r\n   159\t                                            return_counts=True)\r\n   160\t        assigned = np.full(len(unique), -1, dtype=\"int64\")\r\n"]
[2806.515649, "o", "   161\t        active = []\r\n   162\t        pos = 0\r\n   163\t        for event_no, ts in enumerate(unique):\r\n   164\t            while pos < len(records) and starts[pos] <= ts:\r\n   165\t                heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))\r\n   166\t                pos += 1\r\n   167\t            while active and active[0][1] <= ts:\r\n"]
[2806.515679, "o", "   168\t                heapq.heappop(active)\r\n   169\t            if active:\r\n   170\t                assigned[event_no] = active[0][2]\r\n   171\t\r\n   172\t        txn_counts = np.zeros(len(records), dtype=\"int64\")\r\n   173\t        hit = assigned >= 0\r\n   174\t        if hit.any():\r\n   175\t            np.add.at(txn_counts, assigned[hit], counts[hit])\r\n"]
[2806.515711, "o", "   176\t        expected = np.asarray([x.rows for x in records], dtype=\"int64\")\r\n   177\t        ops.legacy_orders_complete = bool(np.array_equal(txn_counts, expected))\r\n   178\t\r\n   179\t        out = np.full(len(orders), np.iinfo(np.int64).min, dtype=\"int64\")\r\n   180\t        positions = np.flatnonzero(event_valid)\r\n   181\t        vals = assigned[inverse]\r\n   182\t        good = vals >= 0\r\n   183\t        out[positions[good]] = commit_secs[vals[good]]\r\n"]
[2806.51575, "o", "   184\t        result = pd.to_datetime(pd.Series(out, index=orders.index), unit=\"s\", utc=True)\r\n   185\t        orders[\"_legacy_commit\"] = result.where(out != np.iinfo(np.int64).min, pd.NaT)\r\n"]
