[150.372092, "i", "python - <<'PY'\nimport pandas as pd,json\nP=pd.read_csv('data/scoring_points.csv'); P['as_of']=pd.to_datetime(P.as_of,utc=True)\nprint('range',P.as_of.min(),P.as_of.max(),'rows',len(P))\nfor d in ['2024-01','2025-03','2025-04','2025-05','2025-06','2026-01']:\n q=P.as_of.dt.strftime('%Y-%m').eq(d); print(d,int(q.sum()),P.as_of[q].min() if q.any() else None,P.as_of[q].max() if q.any() else None)\nPY\n"]
