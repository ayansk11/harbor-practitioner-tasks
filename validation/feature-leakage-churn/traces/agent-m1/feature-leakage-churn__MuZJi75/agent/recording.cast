[3298.33182, "o", "    snap_secs, snap_valid = _seconds(snapshots[\"_loaded_at\"])\r\n    snap_dates, date_valid = _seconds(snapshots[\"snapshot_date\"])\r\n    snap_mask = snap_valid & date_valid\r\n    snap_positions = np.flatnonzero(snap_mask)\r\n    snap_secs = snap_secs[snap_positions]\r\n    snap_dates = snap_dates[snap_positions]\r\n    statuses = snapshots[\"status\"].to_numpy(dtype=object)[snap_positions]\r\n\r\n    point_codes, snap_codes, _ = _factorize_ids(\r\n"]
[3298.331859, "o", "        points[\"customer_id\"].iloc[point_positions],\r\n        snapshots[\"customer_id\"].iloc[snap_positions],\r\n    )\r\n    point_codes = np.asarray(point_codes, dtype=\"int64\")\r\n    snap_codes = np.asarray(snap_codes, dtype=\"int64\")\r\n    snap_order = np.argsort(snap_secs, kind=\"mergesort\")\r\n    snap_secs = snap_secs[snap_order]\r\n    snap_dates = snap_dates[snap_order]\r\n    statuses = statuses[snap_order]\r\n"]
[3298.331939, "o", "    snap_codes = snap_codes[snap_order]\r\n\r\n    latest = {}\r\n    snap_i = 0\r\n    for q, original in enumerate(point_positions):\r\n        t = int(point_secs[q])\r\n        while snap_i < len(snap_secs) and snap_secs[snap_i] < t:\r\n            code = int(snap_codes[snap_i])\r\n            date = int(snap_dates[snap_i])\r\n            if code not in latest or date > latest[code][0]:\r\n                latest[code] = (date, statuses[snap_i])\r\n            snap_i += 1\r\n        current = latest.get(int(point_codes[q]))\r\n        if current is not None:\r\n            out[original] = current[1]\r\n    return out\r\n\r\n\r\ndef target_encoding(points, labels, customers):\r\n    \"\"\"Live district target encoding over labels and customers visible at t.\"\"\"\r\n    n = len(points)\r\n    out = np.full(n, np.nan, dtype=\"float64\")\r\n    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n    point_positions = np.flatnonzero(point_valid)\r\n    if not len(point_positions):\r\n        return out\r\n    point_secs = point_secs[point_positions]\r\n\r\n    # Factoriz"]
[3298.331953, "o", "e all customer IDs once, then map each unique ID to a customer row.\r\n    lab_ids = labels[\"customer_id\"]\r\n    point_ids = points[\"customer_id\"].iloc[point_positions]\r\n    all_ids = pd.concat([lab_ids, point_ids], ignore_index=True)\r\n    row_codes, unique_ids = pd.factorize(all_ids, sort=True)\r\n    lab_codes = np.asarray(row_codes[: len(labels)], dtype=\"int64\")\r\n    point_codes = np.asarray(row_codes[len(labels):], dtype=\"int64\")\r\n    unique_ids = np.asarray(unique_ids)\r\n\r\n    id_to_customer = pd.Series(np.arange(len(customers), dtype=\"int64\"),\r\n                               index=customers[\"customer_id\"])\r\n    unique_customer = id_to_customer.reindex(unique_ids).to_numpy(dtype=\"float64\")\r\n    unique_has_customer = np.isfinite(unique_customer)\r\n    unique_customer_index = np.where(unique_has_customer, unique_customer, 0).astype(\"int64\")\r\n\r\n    lab_customer_index = unique_customer_index[lab_codes]\r\n    lab_has_customer = unique_has_customer[lab_codes]\r\n    pt_customer_index = unique_customer_index[point_codes]"]
[3298.331962, "o", "\r\n    pt_has_customer = unique_has_customer[point_codes]\r\n\r\n"]
