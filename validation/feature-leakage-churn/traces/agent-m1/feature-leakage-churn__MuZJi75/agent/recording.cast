[3271.716545, "o", "\u001b[?2004l\r"]
[3271.718693, "o", "\"\"\"Reconstruct the values computed by ``live/features.py`` from an extract.\r\n\r\nThe reconstruction uses only facts that were committed before each request.  For\r\nrows written by scheduled jobs this comes from ``_loaded_at`` (or, for the old\r\norders generation, from the scheduler transaction records).  Rows written by the\r\n"]
[3271.718717, "o", "sign-up, ticket CDC and scoring services were committed at the source timestamps\r\nrecorded in the extract.\r\n\"\"\"\r\n"]
[3271.718824, "o", "from bisect import bisect_left, insort\r\n\r\n"]
[3271.718851, "o", "import numpy as np\r\nimport pandas as pd\r\n\r\n\r\ndef _seconds(values):\r\n    values = pd.to_datetime(pd.Series(values), utc=True)\r\n    valid = values.notna().to_numpy()\r\n    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    return out, valid\r\n\r\n\r\nclass _Fenwick:\r\n    def __init__(self, n):\r\n        self.n = n\r\n        self.counts = [0] * (n + 1)\r\n        self.amounts = [0] * (n + 1)\r\n\r\n    def add(self, i, amount):\r\n        i += 1\r\n        while i <= self.n:\r\n            self.counts[i] += 1\r\n            self.amounts[i] += amount\r\n            i += i & -i\r\n\r\n    def range(self, left, right):\r\n        if right <= left:\r\n            return 0, 0\r\n        hi_count, hi_amount = self._prefix(right)\r\n"]
[3271.718879, "o", "        lo_count, lo_amount = self._prefix(left)\r\n        return hi_count - lo_count, hi_amount - lo_amount\r\n\r\n    def _prefix(self, i):\r\n        count = amount = 0\r\n        while i > 0:\r\n            count += self.counts[i]\r\n            amount += self.amounts[i]\r\n"]
[3271.718919, "o", "            i -= i & -i\r\n        return count, amount\r\n\r\n\r\ndef _factorize_ids(a, b=None):\r\n    if b is None:\r\n        codes, unique = pd.factorize(pd.Series(a), sort=True)\r\n        return codes, unique\r\n"]
[3271.718951, "o", "    combined = pd.concat([pd.Series(a), pd.Series(b)], ignore_index=True)\r\n    codes, unique = pd.factorize(combined, sort=True)\r\n    return codes[: len(a)], codes[len(a) :], unique\r\n\r\n\r\ndef _event_features(points, events, commit_col, ts_col, *, amount_col=None,\r\n                    windows=(30,), need_last=False):\r\n    \"\"\"Evaluate event queries as events become visible through ``commit_col``.\"\"\"\r\n    n = len(points)\r\n"]
[3271.71898, "o", "    result = {f\"count_{w}\": np.zeros(n, dtype=\"int64\") for w in windows}\r\n    if amount_col is not None:\r\n        result[\"spend\"] = np.zeros(n, dtype=\"int64\")\r\n    result[\"last\"] = np.full(n, np.nan, dtype=\"float64\")\r\n\r\n    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n    point_positions = np.flatnonzero(point_valid)\r\n    if not len(point_positions):\r\n        return result\r\n    point_secs = point_secs[point_positions]"]
[3271.719006, "o", "\r\n\r\n    event_secs, event_valid = _seconds(events[ts_col])\r\n    event_commit, commit_valid = _seconds(events[commit_col])\r\n    event_mask = event_valid & commit_valid\r\n    event_positions = np.flatnonzero(event_mask)\r\n    event_secs = event_secs[event_positions]\r\n    event_commit = event_commit[event_positions]\r\n"]
[3271.719033, "o", "\r\n    if len(events):\r\n        point_codes, event_codes, _ = _factorize_ids(\r\n            points[\"customer_id\"].iloc[point_positions],\r\n            events[\"customer_id\"].iloc[event_positions],\r\n        )\r\n    else:\r\n        point_codes, _ = _factorize_ids(points[\"customer_id\"].iloc[point_positions])\r\n"]
[3271.719048, "o", "        event_codes = np.empty(0, dtype=\"int64\")\r\n\r\n    all_secs = np.concatenate([point_secs, event_secs]) if len(event_secs) else point_secs\r\n    base = int(all_secs.min())\r\n    span = int(all_secs.max()) - base + 1\r\n\r\n    point_keys = point_codes.astype(\"int64\") * span + (point_secs - base)\r\n"]
[3271.719131, "o", "    if len(event_secs):\r\n        event_keys = event_codes.astype(\"int64\") * span + (event_secs - base)\r\n        sorted_index = np.argsort(event_keys, kind=\"mergesort\")\r\n        event_keys = event_keys[sorted_index]\r\n        ranks = np.empty(len(event_keys), dtype=\"int64\")\r\n        ranks[sorted_index] = np.arange(len(event_keys), dtype=\"int64\")\r\n    else:\r\n        event_keys = np.empty(0, dtype=\"int64\")\r\n        ranks = np.empty(0, dtype=\"int64\")\r\n\r\n"]
[3271.719159, "o", "    if amount_col is not None and len(event_positions):\r\n        amounts = pd.to_numeric(events[amount_col].iloc[event_positions],\r\n                                errors=\"coerce\").fillna(0).astype(\"int64\").to_numpy()\r\n    else:\r\n        amounts = np.zeros(len(event_positions), dtype=\"int64\")\r\n\r\n    tree = _Fenwick(len(event_keys))\r\n    event_order = np.argsort(event_commit, kind=\"mergesort\")\r\n    event_commit = event_commit[event_order]\r\n"]
[3271.719172, "o", "    ranks = ranks[event_order]\r\n    event_secs = event_secs[event_order]\r\n    event_codes = event_codes[event_order]\r\n    amounts = amounts[event_order]\r\n\r\n    histories = [[] for _ in range(len(point_codes))] if need_last else None\r\n"]
[3271.719184, "o", "    event_pos = 0\r\n    for q, original in enumerate(point_positions):\r\n        t = int(point_secs[q])\r\n"]
[3271.719239, "o", "        code = int(point_codes[q])\r\n        while event_pos < len(event_order) and event_commit[event_pos] < t:\r\n            i = int(event_order[event_pos])\r\n            tree.add(int(ranks[event_pos]), int(amounts[event_pos]))\r\n            if histories is not None:\r\n                insort(histories[code], int(event_secs[event_pos]))\r\n            event_pos += 1\r\n\r\n        for window in windows:\r\n            lower_adj = max(t - int(window) * 86400 - base, 0)\r\n            upper_adj = max(t - base, 0)\r\n            left = bisect_left(event_keys, code * span + lower_adj)\r\n"]
[3271.71927, "o", "            right = bisect_left(event_keys, code * span + upper_adj)\r\n            count, _ = tree.range(left, right)\r\n"]
[3271.719302, "o", "            result[f\"count_{window}\"][original] = count\r\n\r\n        if amount_col is not None:\r\n            lower_adj = max(t - 30 * 86400 - base, 0)\r\n            upper_adj = max(t - base, 0)\r\n            left = bisect_left(event_keys, code * span + lower_adj)\r\n"]
[3271.71931, "o", "            right = bisect_left(event_keys, code * span + upper_adj)\r\n            result[\"spend\"][original] = tree.range(left, right)[1]\r\n\r\n        if histories is not None:\r\n            hist = histories[code]\r\n            hi = bisect_left(hist, t)\r\n            if hi:\r\n"]
[3271.719348, "o", "                result[\"last\"][original] = float(hist[hi - 1] - t) / 86400.0\r\n\r\n    return result\r\n\r\n\r\ndef order_features(points, orders, rename_at, legacy_orders_complete):\r\n    \"\"\"Live order features across the old and new physical orders tables.\"\"\"\r\n    n = len(points)\r\n"]
[3271.719356, "o", "    out = {\r\n        \"orders_7d\": np.zeros(n, dtype=\"int64\"),\r\n"]
[3271.7194, "o", "        \"orders_30d\": np.zeros(n, dtype=\"int64\"),\r\n        \"spend_30d_cents\": np.zeros(n, dtype=\"int64\"),\r\n"]
[3271.719408, "o", "        \"days_since_last_order\": np.full(n, np.nan, dtype=\"float64\"),\r\n    }\r\n    known = bool(orders[\"_loaded_at\"].notna().all() and legacy_orders_complete)\r\n\r\n    if rename_at is None:\r\n        values = _event_features(\r\n            points, orders, \"_loaded_at\", \"ordered_at\",\r\n            amount_col=\"amount_cents\", windows=(7, 30), need_last=True,\r\n        )\r\n"]
[3271.719447, "o", "        for name in out:\r\n            out[name] = values[\"spend\"] if name == \"spend_30d_cents\" else values.get(name, values[\"last\"])\r\n        return out, known\r\n\r\n    old_mask = (points[\"as_of\"] <= rename_at).to_numpy()\r\n    new_mask = ~old_mask\r\n    old_points = points.loc[old_mask].reset_index(drop=True)\r\n    new_points = points.loc[new_mask].reset_index(drop=True)\r\n"]
[3271.719455, "o", "\r\n    if old_mask.any():\r\n"]
[3271.719467, "o", "        old_events = orders.loc[orders[\"_legacy_commit\"].notna()].copy()\r\n        values = _event_features(\r\n"]
[3271.719518, "o", "            old_points, old_events, \"_legacy_commit\", \"ordered_at\",\r\n            amount_col=\"amount_cents\", windows=(7, 30), need_last=True,\r\n        )\r\n        out[\"orders_7d\"][old_mask] = values[\"count_7\"]\r\n"]
[3271.719548, "o", "        out[\"orders_30d\"][old_mask] = values[\"count_30\"]\r\n        out[\"spend_30d_cents\"][old_mask] = values[\"spend\"]\r\n        out[\"days_since_last_order\"][old_mask] = values[\"last\"]\r\n\r\n    if new_mask.any():\r\n        new_events = orders.loc[orders[\"_loaded_at\"].notna()].copy()\r\n        values = _event_features(\r\n            new_points, new_events, \"_loaded_at\", \"ordered_at\",\r\n            amount_col=\"amount_cents\", windows=(7, 30), need_last=True,\r\n"]
[3271.719578, "o", "        )\r\n        out[\"orders_7d\"][new_mask] = values[\"count_7\"]\r\n        out[\"orders_30d\"][new_mask] = values[\"count_30\"]\r\n        out[\"spend_30d_cents\"][new_mask] = values[\"spend\"]\r\n        out[\"days_since_last_order\"][new_mask] = values[\"last\"]\r\n    return out, known\r\n"]
[3271.719606, "o", "\r\n\r\ndef ticket_features(points, tickets):\r\n    values = _event_features(\r\n        points, tickets, \"_loaded_at\", \"opened_at\", windows=(30,), need_last=False,\r\n    )\r\n    return values[\"count_30\"]\r\n"]
[3271.719613, "o", "\r\n\r\ndef status_features(points, snapshots):\r\n    n = len(points)\r\n    out = np.full(n, None, dtype=object)\r\n"]
[3271.719648, "o", "    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n    point_positions = np.flatnonzero(point_valid)\r\n    if not len(point_positions):\r\n        return out\r\n\r\n    snap_secs, snap_valid = _seconds(snapshots[\"_loaded_at\"])\r\n    snap_dates, date_valid = _seconds(snapshots[\"snapshot_date\"])\r\n"]
[3271.719696, "o", "    snap_mask = snap_valid & date_valid\r\n    snap_positions = np.flatnonzero(snap_mask)\r\n"]
[3271.719766, "o", "    snap_secs = snap_secs[snap_positions]\r\n    snap_dates = snap_dates[snap_positions]\r\n    statuses = snapshots[\"status\"].to_numpy(dtype=object)[snap_positions]\r\n\r\n    point_codes, snap_codes, _ = _factorize_ids(\r\n        points[\"customer_id\"].iloc[point_positions],\r\n        snapshots[\"customer_id\"].iloc[snap_positions],\r\n"]
[3271.720157, "o", "\u001b[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# "]
[3272.100039, "i", "sed -n '230,430p' churn/live_features.py\n"]
[3272.100316, "o", "sed -n '230,430p' churn/live_features.py\r\n"]
[3272.100325, "o", "\u001b[?2004l\r"]
[3272.102269, "o", "        snapshots[\"customer_id\"].iloc[snap_positions],\r\n    )\r\n    point_codes = np.asarray(point_codes, dtype=\"int64\")\r\n    snap_codes = np.asarray(snap_codes, dtype=\"int64\")\r\n    snap_order = np.argsort(snap_secs, kind=\"mergesort\")\r\n"]
[3272.10228, "o", "    snap_secs = snap_secs[snap_order]\r\n    snap_dates = snap_dates[snap_order]\r\n    statuses = statuses[snap_order]\r\n"]
[3272.102334, "o", "    snap_codes = snap_codes[snap_order]\r\n\r\n    latest = {}\r\n    snap_i = 0\r\n    for q, original in enumerate(point_positions):\r\n        t = int(point_secs[q])\r\n        while snap_i < len(snap_secs) and snap_secs[snap_i] < t:\r\n            code = int(snap_codes[snap_i])\r\n            date = int(snap_dates[snap_i])\r\n            if code not in latest or date > latest[code][0]:\r\n                latest[code] = (date, statuses[snap_i])\r\n            snap_i += 1\r\n"]
[3272.102353, "o", "        current = latest.get(int(point_codes[q]))\r\n        if current is not None:\r\n            out[original] = current[1]\r\n    return out\r\n\r\n"]
[3272.10236, "o", "\r\ndef target_encoding(points, labels, customers):\r\n    \"\"\"Live district target encoding over labels and customers visible at t.\"\"\"\r\n    n = len(points)\r\n"]
[3272.102389, "o", "    out = np.full(n, np.nan, dtype=\"float64\")\r\n    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n"]
[3272.102408, "o", "    point_positions = np.flatnonzero(point_valid)\r\n    if not len(point_positions):\r\n        return out\r\n    point_secs = point_secs[point_positions]\r\n\r\n"]
[3272.102426, "o", "    # Factorize all customer IDs once, then map each unique ID to a customer row.\r\n    lab_ids = labels[\"customer_id\"]\r\n    point_ids = points[\"customer_id\"].iloc[point_positions]\r\n"]
[3272.102446, "o", "    all_ids = pd.concat([lab_ids, point_ids], ignore_index=True)\r\n    row_codes, unique_ids = pd.factorize(all_ids, sort=True)\r\n    lab_codes = np.asarray(row_codes[: len(labels)], dtype=\"int64\")\r\n    point_codes = np.asarray(row_codes[len(labels):], dtype=\"int64\")\r\n"]
[3272.102466, "o", "    unique_ids = np.asarray(unique_ids)\r\n\r\n"]
[3272.102483, "o", "    id_to_customer = pd.Series(np.arange(len(customers), dtype=\"int64\"),\r\n                               index=customers[\"customer_id\"])\r\n    unique_customer = id_to_customer.reindex(unique_ids).to_numpy(dtype=\"float64\")\r\n    unique_has_customer = np.isfinite(unique_customer)\r\n"]
[3272.1025, "o", "    unique_customer_index = np.where(unique_has_customer, unique_customer, 0).astype(\"int64\")\r\n"]
[3272.102518, "o", "\r\n    lab_customer_index = unique_customer_index[lab_codes]\r\n    lab_has_customer = unique_has_customer[lab_codes]\r\n    pt_customer_index = unique_customer_index[point_codes]\r\n"]
[3272.102535, "o", "    pt_has_customer = unique_has_customer[point_codes]\r\n\r\n    districts = customers[\"postcode_district\"].astype(\"object\").to_numpy()\r\n    lab_district = np.where(lab_has_customer, districts[lab_customer_index], None)\r\n"]
[3272.10255, "o", "    pt_district = np.where(pt_has_customer, districts[pt_customer_index], None)\r\n    district_values = pd.concat([\r\n"]
[3272.102566, "o", "        pd.Series(lab_district, dtype=\"object\"),\r\n        pd.Series(pt_district, dtype=\"object\"),\r\n    ], ignore_index=True)\r\n"]
[3272.102583, "o", "    district_codes, _ = pd.factorize(district_values, use_na_sentinel=True)\r\n"]
[3272.102601, "o", "    lab_district = np.asarray(district_codes[: len(labels)], dtype=\"int64\")\r\n    pt_district = np.asarray(district_codes[len(labels):], dtype=\"int64\")\r\n    pt_district = np.where(pt_district >= 0, pt_district, -999999)\r\n\r\n"]
[3272.10262, "o", "    # A label enters the JOIN only when both its scheduled commit and the joined\r\n    # customer row are visible.  signup_at is immutable and is the customer row's\r\n    # source/commit time.\r\n"]
[3272.102639, "o", "    lab_commit, lab_commit_valid = _seconds(labels[\"_loaded_at\"])\r\n    lab_signup_secs = np.full(len(labels), np.iinfo(np.int64).max, dtype=\"int64\")\r\n    if lab_has_customer.any():\r\n        positions = lab_customer_index[lab_has_customer]\r\n        signup_secs, signup_valid = _seconds(customers[\"signup_at\"].iloc[positions])\r\n"]
[3272.102659, "o", "        lab_signup_secs[lab_has_customer] = np.where(signup_valid, signup_secs,\r\n                                                      np.iinfo(np.int64).max)\r\n    lab_commit = np.where(lab_commit_valid, lab_commit, np.iinfo(np.int64).max)\r\n    eligibility = np.maximum(lab_commit, lab_signup_secs)\r\n\r\n"]
[3272.102672, "o", "    y_values = pd.to_numeric(labels[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\r\n    label_order = np.argsort(eligibility, kind=\"mergesort\")\r\n    eligibility = eligibility[label_order]\r\n    lab_district = lab_district[label_order]\r\n    y_values = y_values[label_order]\r\n\r\n    point_order = np.argsort(point_secs, kind=\"mergesort\")\r\n"]
[3272.102692, "o", "    global_n = global_sum = 0\r\n    district_n = {}\r\n    district_sum = {}\r\n"]
[3272.102718, "o", "    label_i = 0\r\n    for q in point_order:\r\n        original = int(point_positions[q])\r\n        t = int(point_secs[q])\r\n        own = int(pt_district[q])\r\n"]
[3272.102735, "o", "        while label_i < len(eligibility) and eligibility[label_i] < t:\r\n            y = float(y_values[label_i])\r\n"]
[3272.102751, "o", "            if np.isfinite(y):\r\n                global_n += 1\r\n                global_sum += int(y)\r\n            district = int(lab_district[label_i])\r\n"]
[3272.10277, "o", "            district_n[district] = district_n.get(district, 0) + 1\r\n            district_sum[district] = district_sum.get(district, 0) + (int(y) if np.isfinite(y) else 0)\r\n            label_i += 1\r\n\r\n        # PostgreSQL aggregates return one row even when CROSS JOIN own is empty;\r\n"]
[3272.102791, "o", "        # the COALESCE clauses then produce the 0.05 prior.\r\n        same_n = district_n.get(own, 0)\r\n        same_sum = district_sum.get(own, 0)\r\n        prior = global_sum / global_n if global_n else 0.05\r\n        out[original] = (same_sum + 20.0 * prior) / (same_n + 20.0)\r\n"]
[3272.102811, "o", "    return out\r\n\r\n\r\ndef app_minutes(points):\r\n    order = np.lexsort((points[\"as_of\"].to_numpy(), points[\"customer_id\"].to_numpy()))\r\n    ordered = points[\"app_minutes_7d\"].iloc[order]\r\n"]
[3272.102832, "o", "    filled = ordered.groupby(points[\"customer_id\"].iloc[order]).ffill()\r\n    out = np.full(len(points), np.nan, dtype=\"float64\")\r\n    out[order] = filled.to_numpy(dtype=\"float64\")\r\n    return out\r\n\r\n\r\ndef customer_features(points, customers, plan_changes):\r\n    \"\"\"Build customer-record features when, and only when, every value is known.\"\"\"\r\n    n = len(points)\r\n"]
[3272.102873, "o", "    plan = np.full(n, None, dtype=object)\r\n    login_days = np.full(n, np.nan, dtype=\"float64\")\r\n    plan_known = np.zeros(n, dtype=\"bool\")\r\n    login_known = np.zeros(n, dtype=\"bool\")"]
[3272.102914, "o", "\r\n\r\n    customer_by_id = customers.set_index(\"customer_id\", drop=False)\r\n    final_plan = points[\"customer_id\"].map(customer_by_id[\"plan\"])\r\n    final_login = points[\"customer_id\"].map(customer_by_id[\"last_login_at\"])\r\n    final_updated = points[\"customer_id\"].map(customer_by_id[\"_updated_at\"])\r\n    final_signup = points[\"customer_id\"].map(customer_by_id[\"signup_at\"])\r\n    no_changes = ~points[\"customer_id\"].isin(set(plan_changes[\"customer_id\"]))\r\n\r\n    plan_commit, plan_commit_valid = _seconds(plan_changes[\"_loaded_at\"])\r\n    plan_changed, changed_valid = _seconds(plan_changes[\"changed_at\"])\r\n    valid = plan_commit_valid & changed_valid\r\n    changes = plan_changes.loc[valid, [\"customer_id\", \"new_plan\"]].copy()\r\n    changes[\"commit\"] = plan_commit[valid]\r\n"]
[3272.102936, "o", "    changes[\"changed\"] = plan_changed[valid]\r\n    changes = changes.sort_values(\"commit\", kind=\"mergesort\")\r\n"]
[3272.102962, "o", "    change_commit = changes[\"commit\"].to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    change_changed = changes[\"changed\"].to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    change_ids = changes[\"customer_id\"].to_numpy()\r\n    change_plan = changes[\"new_plan\"].to_numpy(dtype=object)\r\n\r\n    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n    point_positions = np.flatnonzero(point_valid)\r\n"]
[3272.102981, "o", "    point_codes, change_codes, unique_ids = _factorize_ids(\r\n        points[\"customer_id\"].iloc[point_positions], changes[\"customer_id\"],\r\n    )\r\n    point_codes = np.asarray(point_codes, dtype=\"int64\")\r\n    change_codes = np.asarray(change_codes, dtype=\"int64\")\r\n    unique_ids = np.asarray(unique_ids)\r\n"]
[3272.103003, "o", "    point_order = np.argsort(point_secs[point_positions], kind=\"mergesort\")\r\n    current = {}\r\n    change_i = 0\r\n    for q in point_order:\r\n        original = int(point_positions[q])\r\n        t = int(point_secs[original])\r\n        code = int(point_codes[q])\r\n"]
[3272.103019, "o", "        cid = unique_ids[code] if code >= 0 else None\r\n        exists = pd.notna(final_signup.iloc[original]) and point_secs[original] > _seconds([final_signup.iloc[original]])[0][0]\r\n        while change_i < len(change_commit) and change_commit[change_i] < t:\r\n            ccode = int(change_codes[change_i])\r\n            changed = int(change_changed[change_i])\r\n"]
[3272.103036, "o", "            if ccode not in current or changed >= current[ccode][0]:\r\n                current[ccode] = (changed, change_plan[change_i])\r\n            change_i += 1\r\n\r\n        if not exists:\r\n            plan_known[original] = login_known[original] = True\r\n            continue\r\n"]
[3272.103052, "o", "        if pd.notna(final_updated.iloc[original]) and _seconds([final_updated.iloc[original]])[0][0] < t:\r\n            plan[original] = final_plan.iloc[original]\r\n            plan_known[original] = True\r\n            if pd.notna(final_login.iloc[original]) and _seconds([final_login.iloc[original]])[0][0] < t:\r\n"]
[3272.103067, "o", "                login_days[original] = (t - _seconds([final_login.iloc[original]])[0][0]) / 86400.0\r\n            login_known[original] = True\r\n"]
[3272.103084, "o", "            continue\r\n        if code >= 0 and code in current:\r\n            plan[original] = current[code][1]\r\n            plan_known[original] = True\r\n        elif no_changes.iloc[original]:\r\n            plan[original] = final_plan.iloc[original]\r\n            plan_known[original] = True\r\n"]
[3272.103097, "o", "\r\n    keep_plan = bool(plan_known.all())\r\n"]
[3272.103111, "o", "    keep_login = bool(login_known.all())\r\n    return plan if keep_plan else None, login_days if keep_login else None, keep_plan, keep_login\r\n"]
