[2367.776284, "o", "   353\tdef customer_features(points, customers, plan_changes):\r\n   354\t    \"\"\"Build customer-record features when, and only when, every value is known.\"\"\"\r\n   355\t    n = len(points)\r\n   356\t    plan = np.full(n, None, dtype=object)\r\n   357\t    login_days = np.full(n, np.nan, dtype=\"float64\")\r\n   358\t    plan_known = np.zeros(n, dtype=\"bool\")\r\n   359\t    login_known = np.zeros(n, dtype=\"bool\")\r\n   360\t\r\n   361\t    customer_by_id = customers.set_index(\"customer_id\", drop=False)\r\n   362\t    final_plan = points[\"customer_id\"].map(customer_by_id[\"plan\"])\r\n   363\t    final_login = points[\"customer_id\"].map(customer_by_id[\"last_login_at\"])\r\n   364\t    final_updated = points[\"customer_id\"].map(customer_by_id[\"_updated_at\"])\r\n   365\t    final_signup = points[\"customer_id\"].map(customer_by_id[\"signup_at\"])\r\n"]
[2367.77632, "o", "   366\t    no_changes = ~points[\"customer_id\"].isin(set(plan_changes[\"customer_id\"]))\r\n   367\t\r\n   368\t    plan_commit, plan_commit_valid = _seconds(plan_changes[\"_loaded_at\"])\r\n   369\t    plan_changed, changed_valid = _seconds(plan_changes[\"changed_at\"])\r\n   370\t    valid = plan_commit_valid & changed_valid\r\n"]
[2367.776598, "o", "\u001b[?2004h"]
