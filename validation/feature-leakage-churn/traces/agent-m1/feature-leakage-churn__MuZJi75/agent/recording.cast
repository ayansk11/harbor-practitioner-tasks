[3441.64546, "i", "sed -n '1,225p' churn/live_features.py\n"]
[3441.645756, "o", "sed -n '1,225p' churn/live_features.py\r\n\u001b[?2004l\r"]
[3441.648444, "o", "\"\"\"Reconstruct the values computed by ``live/features.py`` from an extract.\r\n\r\nThe reconstruction uses only facts that were committed before each request.  For\r\nrows written by scheduled jobs this comes from ``_loaded_at`` (or, for the old\r\norders generation, from the scheduler transaction records).  Rows written by the\r\nsign-up, ticket CDC and scoring services were committed at the source timestamps\r\n"]
[3441.648463, "o", "recorded in the extract.\r\n\"\"\"\r\nfrom bisect import bisect_left, insort\r\n\r\nimport numpy as np\r\nimport pandas as pd\r\n"]
[3441.648546, "o", "\r\n\r\n"]
[3441.648612, "o", "def _seconds(values):\r\n    values = pd.to_datetime(pd.Series(values), utc=True)\r\n    valid = values.notna().to_numpy()\r\n    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    return out, valid\r\n\r\n\r\nclass _Fenwick:\r\n    def __init__(self, n):\r\n        self.n = n\r\n        self.counts = [0] * (n + 1)\r\n        self.amounts = [0] * (n + 1)\r\n\r\n    def add(self, i, amount):\r\n        i += 1\r\n        while i <= self.n:\r\n            self.counts[i] += 1\r\n            self.amounts[i] += amount\r\n            i += i & -i\r\n\r\n    def range(self, left, right):\r\n        if right <= left:\r\n            return 0, 0\r\n        hi_count, hi_amount = self._prefix(right)\r\n        lo_count, lo_amount = self._prefix(left)\r\n        return hi_count - lo_count, hi_amount - lo_amount\r\n\r\n    def _prefix(self, i):\r\n        count = amount = 0\r\n        while i > 0:\r\n            count += self.counts[i]\r\n"]
[3441.648626, "o", "            amount += self.amounts[i]\r\n"]
[3441.64869, "o", "            i -= i & -i\r\n        return count, amount\r\n\r\n\r\ndef _factorize_ids(a, b=None):\r\n    if b is None:\r\n        codes, unique = pd.factorize(pd.Series(a), sort=True)\r\n        return codes, unique\r\n    combined = pd.concat([pd.Series(a), pd.Series(b)], ignore_index=True)\r\n    codes, unique = pd.factorize(combined, sort=True)\r\n    return codes[: len(a)], codes[len(a) :], unique\r\n\r\n\r\ndef _event_features(points, events, commit_col, ts_col, *, amount_col=None,\r\n"]
[3441.648722, "o", "                    windows=(30,), need_last=False):\r\n    \"\"\"Evaluate event queries as events become visible through ``commit_col``.\"\"\"\r\n    n = len(points)\r\n"]
[3441.648767, "o", "    result = {f\"count_{w}\": np.zeros(n, dtype=\"int64\") for w in windows}\r\n    if amount_col is not None:\r\n        result[\"spend\"] = np.zeros(n, dtype=\"int64\")\r\n    result[\"last\"] = np.full(n, np.nan, dtype=\"float64\")\r\n\r\n    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n    point_positions = np.flatnonzero(point_valid)\r\n    if not len(point_positions):\r\n        return result\r\n    point_secs = point_secs[point_positions]\r\n\r\n    event_secs, event_valid = _seconds(events[ts_col])\r\n    event_commit, commit_valid = _seconds(events[commit_col])\r\n    event_mask = event_valid & commit_valid\r\n    event_positions = np.flatnonzero(event_mask)\r\n"]
[3441.64879, "o", "    event_secs = event_secs[event_positions]\r\n"]
[3441.648822, "o", "    event_commit = event_commit[event_positions]\r\n\r\n    if len(events):\r\n        point_codes, event_codes, _ = _factorize_ids(\r\n            points[\"customer_id\"].iloc[point_positions],\r\n            events[\"customer_id\"].iloc[event_positions],\r\n        )\r\n    else:\r\n        point_codes, _ = _factorize_ids(points[\"customer_id\"].iloc[point_positions])\r\n        event_codes = np.empty(0, dtype=\"int64\")\r\n"]
[3441.648851, "o", "\r\n    all_secs = np.concatenate([point_secs, event_secs]) if len(event_secs) else point_secs\r\n    base = int(all_secs.min())\r\n    span = int(all_secs.max()) - base + 1\r\n\r\n    point_keys = point_codes.astype(\"int64\") * span + (point_secs - base)\r\n    if len(event_secs):\r\n        event_keys = event_codes.astype(\"int64\") * span + (event_secs - base)\r\n"]
[3441.648875, "o", "        sorted_index = np.argsort(event_keys, kind=\"mergesort\")\r\n        event_keys = event_keys[sorted_index]\r\n        ranks = np.empty(len(event_keys), dtype=\"int64\")\r\n        ranks[sorted_index] = np.arange(len(event_keys), dtype=\"int64\")\r\n    else:\r\n"]
[3441.648927, "o", "        event_keys = np.empty(0, dtype=\"int64\")\r\n        ranks = np.empty(0, dtype=\"int64\")\r\n\r\n    if amount_col is not None and len(event_positions):\r\n        amounts = pd.to_numeric(events[amount_col].iloc[event_positions],\r\n                                errors=\"coerce\").fillna(0).astype(\"int64\").to_numpy()\r\n    else:\r\n"]
[3441.648948, "o", "        amounts = np.zeros(len(event_positions), dtype=\"int64\")\r\n\r\n    tree = _Fenwick(len(event_keys))\r\n"]
[3441.648969, "o", "    event_order = np.argsort(event_commit, kind=\"mergesort\")\r\n    event_commit = event_commit[event_order]\r\n    ranks = ranks[event_order]\r\n    event_secs = event_secs[event_order]\r\n"]
[3441.648979, "o", "    event_codes = event_codes[event_order]\r\n    amounts = amounts[event_order]\r\n\r\n    histories = [[] for _ in range(len(point_codes))] if need_last else None\r\n    event_pos = 0\r\n"]
[3441.64905, "o", "    for q, original in enumerate(point_positions):\r\n        t = int(point_secs[q])\r\n        code = int(point_codes[q])\r\n        while event_pos < len(event_order) and event_commit[event_pos] < t:\r\n            i = int(event_order[event_pos])\r\n            tree.add(int(ranks[event_pos]), int(amounts[event_pos]))\r\n            if histories is not None:\r\n                insort(histories[code], int(event_secs[event_pos]))\r\n            event_pos += 1\r\n\r\n        for window in windows:\r\n"]
[3441.64906, "o", "            lower_adj = max(t - int(window) * 86400 - base, 0)\r\n            upper_adj = max(t - base, 0)\r\n            left = bisect_left(event_keys, code * span + lower_adj)\r\n"]
[3441.649101, "o", "            right = bisect_left(event_keys, code * span + upper_adj)\r\n            count, _ = tree.range(left, right)\r\n            result[f\"count_{window}\"][original] = count\r\n"]
[3441.649112, "o", "\r\n        if amount_col is not None:\r\n            lower_adj = max(t - 30 * 86400 - base, 0)\r\n            upper_adj = max(t - base, 0)\r\n            left = bisect_left(event_keys, code * span + lower_adj)\r\n"]
[3441.649145, "o", "            right = bisect_left(event_keys, code * span + upper_adj)\r\n            result[\"spend\"][original] = tree.range(left, right)[1]\r\n\r\n"]
[3441.649155, "o", "        if histories is not None:\r\n            hist = histories[code]\r\n            hi = bisect_left(hist, t)\r\n            if hi:\r\n                result[\"last\"][original] = float(hist[hi - 1] - t) / 86400.0"]
[3441.649191, "o", "\r\n\r\n    return result\r\n\r\n\r\ndef order_features(points, orders, rename_at, legacy_orders_complete):\r\n    \"\"\"Live order features across the old and new physical orders tables.\"\"\"\r\n    n = len(points)\r\n    out = {\r\n"]
[3441.6492, "o", "        \"orders_7d\": np.zeros(n, dtype=\"int64\"),\r\n        \"orders_30d\": np.zeros(n, dtype=\"int64\"),\r\n"]
[3441.649235, "o", "        \"spend_30d_cents\": np.zeros(n, dtype=\"int64\"),\r\n        \"days_since_last_order\": np.full(n, np.nan, dtype=\"float64\"),\r\n    }\r\n    known = bool(orders[\"_loaded_at\"].notna().all() and legacy_orders_complete)\r\n\r\n    if rename_at is None:\r\n        values = _event_features(\r\n"]
[3441.649245, "o", "            points, orders, \"_loaded_at\", \"ordered_at\",\r\n            amount_col=\"amount_cents\", windows=(7, 30), need_last=True,\r\n"]
[3441.649291, "o", "        )\r\n        out[\"orders_7d\"] = values[\"count_7\"]\r\n        out[\"orders_30d\"] = values[\"count_30\"]\r\n        out[\"spend_30d_cents\"] = values[\"spend\"]\r\n"]
[3441.6493, "o", "        out[\"days_since_last_order\"] = values[\"last\"]\r\n        return out, known\r\n\r\n    old_mask = (points[\"as_of\"] <= rename_at).to_numpy()\r\n    new_mask = ~old_mask\r\n    old_points = points.loc[old_mask].reset_index(drop=True)\r\n    new_points = points.loc[new_mask].reset_index(drop=True)\r\n\r\n    if old_mask.any():\r\n"]
[3441.649331, "o", "        old_events = orders.loc[orders[\"_legacy_commit\"].notna()].copy()\r\n        values = _event_features(\r\n            old_points, old_events, \"_legacy_commit\", \"ordered_at\",\r\n            amount_col=\"amount_cents\", windows=(7, 30), need_last=True,\r\n        )\r\n        out[\"orders_7d\"][old_mask] = values[\"count_7\"]\r\n"]
[3441.64934, "o", "        out[\"orders_30d\"][old_mask] = values[\"count_30\"]\r\n        out[\"spend_30d_cents\"][old_mask] = values[\"spend\"]\r\n"]
[3441.64935, "o", "        out[\"days_since_last_order\"][old_mask] = values[\"last\"]\r\n\r\n    if new_mask.any():"]
[3441.649396, "o", "\r\n        new_events = orders.loc[orders[\"_loaded_at\"].notna()].copy()\r\n        values = _event_features(\r\n            new_points, new_events, \"_loaded_at\", \"ordered_at\",\r\n            amount_col=\"amount_cents\", windows=(7, 30), need_last=True,\r\n        )\r\n        out[\"orders_7d\"][new_mask] = values[\"count_7\"]\r\n        out[\"orders_30d\"][new_mask] = values[\"count_30\"]\r\n        out[\"spend_30d_cents\"][new_mask] = values[\"spend\"]\r\n        out[\"days_since_last_order\"][new_mask] = values[\"last\"]\r\n    return out, known\r\n\r\n\r\n"]
[3441.649421, "o", "def ticket_features(points, tickets):\r\n    values = _event_features(\r\n"]
[3441.649448, "o", "        points, tickets, \"_loaded_at\", \"opened_at\", windows=(30,), need_last=False,\r\n    )\r\n    return values[\"count_30\"]\r\n\r\n\r\ndef status_features(points, snapshots):\r\n"]
[3441.649457, "o", "    n = len(points)\r\n    out = np.full(n, None, dtype=object)\r\n    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n    point_positions = np.flatnonzero(point_valid)\r\n    if not len(point_positions):\r\n        return out\r\n\r\n    snap_secs, snap_valid = _seconds(snapshots[\"_loaded_at\"])\r\n"]
[3441.64949, "o", "    snap_dates, date_valid = _seconds(snapshots[\"snapshot_date\"])\r\n    snap_mask = snap_valid & date_valid\r\n    snap_positions = np.flatnonzero(snap_mask)\r\n"]
