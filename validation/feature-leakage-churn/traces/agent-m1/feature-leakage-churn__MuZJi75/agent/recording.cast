[515.885636, "i", "python - <<'PY'\nimport re,collections\nR=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if z: R.append((pd.Timestamp(z.group(1)),pd.Timestamp(z.group(2)),int(z.group(3)),int(z.group(4)),z.group(5),a[0],a[2].split('state=')[-1]))\nD=collections.defaultdict(list)\nfor r in R: D[r[0]].append(r)\nprint('records',len(R),'days',len(D),'duplicates',sum(len(x)>1 for x in D.values()),'max',max(map(len,D.values())))\nfor d,x in D.items():\n if len(x)>1: print('\\n',d); [print(y) for y in x]\nPY\n"]
