[517.908618, "i", "python - <<'PY'\nimport pandas as pd,re,json,collections\nO=pd.read_csv('data/orders.csv'); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True); O['load']=pd.to_datetime(O._loaded_at,utc=True)\nC={int(json.loads(l)['txn']):json.loads(l) for l in open('data/_ops/commits.jsonl')}\nR=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if z: R.append((pd.Timestamp(z.group(1)),pd.Timestamp(z.group(2)),int(z.group(3)),int(z.group(4)),C[int(z.group(4))]))\n# For each selection window, compare committed count to final copied-row count; allow multiple transaction outcomes.\ndays=collections.defaultdict(list)\nfor s,e,n,txn,x in R: days[(s,e)].append((n,x['outcome']))\nbad=[]\nfor (s,e),items in days.items():\n actual=int((O._load_job.eq('legacy_backfill')&O.ordered_at.ge(s)&O.ordered_at.lt(e)).sum())\n committed=sum(n for n,o in items if o=='"]
[517.908709, "i", "commit')\n if actual!=committed: bad.append((str(s),actual,items))\nprint('windows',len(days),'bad',len(bad)); print(*bad[:12],sep='\\n')\nPY\n"]
