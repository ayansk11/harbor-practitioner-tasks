[3565.009121, "o", "\u001b[?2004h> "]
[3565.009337, "o", "    pt_district = np.where(pt_has_customer, districts[pt_customer_index], None)\r\n\u001b[?2004l\r"]
[3565.009367, "o", "\u001b[?2004h> "]
[3565.009466, "o", "    district_codes, _ = pd.factorize(\r\n\u001b[?2004l\r"]
[3565.009495, "o", "\u001b[?2004h> "]
[3565.009695, "o", "        np.concatenate([lab_district, pt_district]), use_na_sentinel=True\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.009725, "o", ">     )\r\n\u001b[?2004l\r"]
[3565.009759, "o", "\u001b[?2004h> "]
