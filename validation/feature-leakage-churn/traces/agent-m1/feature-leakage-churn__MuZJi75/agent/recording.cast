[194.82345, "i", "python - <<'PY'\nimport pandas as pd,json\nP=pd.read_csv('data/scoring_points.csv'); P['as_of']=pd.to_datetime(P.as_of,utc=True)\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))])\nC=pd.read_csv('data/customers.csv'); C['signup_at']=pd.to_datetime(C.signup_at,utc=True); C['_updated_at']=pd.to_datetime(C._updated_at,utc=True); C['last_login_at']=pd.to_datetime(C.last_login_at,utc=True)\nPC=pd.read_csv('data/plan_changes.csv'); PC['changed_at']=pd.to_datetime(PC.changed_at,utc=True); PC['_loaded_at']=pd.to_datetime(PC._loaded_at,utc=True)\n# Plan visible at t from changes whose load commit precedes t; ties use latest changed_at.\nL=L.merge(C[['customer_id','signup_at','_updated_at','last_login_at']],on='customer_id',how='left')\nM=L.merge(P[['customer_id','as_of','trigger','app_minutes_7d']],on=['customer_id','as_of'],how='left',suffixes=('_live','_pt'))\ndef plan_for(r):\n q=PC[(PC.customer_id==r.customer_id)&(PC._loaded_"]
[194.823559, "i", "at<r.as_of)].sort_values(['_loaded_at','changed_at'])\n return q.new_plan.iloc[-1] if len(q) else 'basic'\nM['plan_rec']=M.apply(plan_for,axis=1)\nprint(M[['as_of','plan','plan_rec','_updated_at','last_login_at']].head(15).to_string(index=False))\nprint('plan mismatches',sum(M.plan!=M.plan_rec))\nprint('customer updated after asof',sum(M._updated_at>=M.as_of),'last login after asof',sum(M.last_login_at>=M.as_of),'null',M.last_login_at.isna().sum())\nPY\n"]
