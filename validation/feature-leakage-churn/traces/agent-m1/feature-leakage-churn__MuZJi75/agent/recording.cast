[3564.937628, "o", "\u001b[?2004h"]
[3564.937658, "o", "> "]
[3564.938109, "o", "    \"\"\"Count/sum events in [t-W,t) among rows committed strictly before t.\"\"\"\r\n\u001b[?2004l\r"]
[3564.938145, "o", "\u001b[?2004h> "]
[3564.938279, "o", "    n = len(points)\r\n\u001b[?2004l\r"]
[3564.938308, "o", "\u001b[?2004h"]
[3564.938339, "o", "> "]
