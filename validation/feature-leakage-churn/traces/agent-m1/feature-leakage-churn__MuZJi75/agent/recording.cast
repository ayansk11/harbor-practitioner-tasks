[3565.014589, "o", "\u001b[?2004h> "]
[3565.014673, "o", "        t = int(point_secs[q])\r\n\u001b[?2004l\r"]
[3565.014716, "o", "\u001b[?2004h> "]
[3565.014797, "o", "        own = int(pt_district[q])\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.014834, "o", "> "]
[3565.015026, "o", "        while label_i < len(eligibility) and eligibility[label_i] < t:\r\n\u001b[?2004l\r"]
[3565.015069, "o", "\u001b[?2004h> "]
[3565.015169, "o", "            y = float(y_values[label_i])\r\n\u001b[?2004l\r"]
[3565.0152, "o", "\u001b[?2004h> "]
[3565.015301, "o", "            finite = np.isfinite(y)\r\n\u001b[?2004l\r"]
[3565.015342, "o", "\u001b[?2004h> "]
