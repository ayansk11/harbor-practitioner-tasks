[1875.543336, "o", "\u001b[?2004h> "]
[1875.543425, "o", "def _seconds(values):\r\n\u001b[?2004l\r"]
[1875.543444, "o", "\u001b[?2004h"]
[1875.543463, "o", "> "]
[1875.543662, "o", "    values = pd.to_datetime(pd.Series(values), utc=True)\r\n\u001b[?2004l\r"]
[1875.543681, "o", "\u001b[?2004h"]
[1875.543695, "o", "> "]
[1875.543831, "o", "    valid = values.notna().to_numpy()\r\n\u001b[?2004l\r"]
[1875.543846, "o", "\u001b[?2004h"]
[1875.54386, "o", "> "]
[1875.544112, "o", "    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n\u001b[?2004l\r"]
[1875.544129, "o", "\u001b[?2004h> "]
[1875.544218, "o", "    return out, valid\r\n\u001b[?2004l\r"]
[1875.544245, "o", "\u001b[?2004h> "]
[1875.544261, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.544275, "o", "> \r\n\u001b[?2004l\r"]
[1875.544288, "o", "\u001b[?2004h"]
[1875.544301, "o", "> "]
[1875.544356, "o", "class _Fenwick:\r\n\u001b[?2004l\r"]
[1875.544372, "o", "\u001b[?2004h> "]
[1875.544471, "o", "    def __init__(self, n):\r\n\u001b[?2004l\r"]
[1875.54449, "o", "\u001b[?2004h> "]
[1875.544561, "o", "        self.n = n\r\n\u001b[?2004l\r"]
[1875.54458, "o", "\u001b[?2004h"]
[1875.544593, "o", "> "]
[1875.544715, "o", "        self.counts = [0] * (n + 1)\r\n\u001b[?2004l\r"]
[1875.544733, "o", "\u001b[?2004h> "]
[1875.544877, "o", "        self.amounts = [0] * (n + 1)\r\n\u001b[?2004l\r"]
[1875.544902, "o", "\u001b[?2004h> \r\n"]
[1875.544916, "o", "\u001b[?2004l\r"]
[1875.54493, "o", "\u001b[?2004h"]
[1875.544943, "o", "> "]
[1875.545044, "o", "    def add(self, i, amount):\r\n\u001b[?2004l\r"]
[1875.545063, "o", "\u001b[?2004h"]
[1875.545078, "o", "> "]
[1875.545129, "o", "        i += 1\r\n\u001b[?2004l\r"]
[1875.545151, "o", "\u001b[?2004h> "]
[1875.545259, "o", "        while i <= self.n:\r\n\u001b[?2004l\r"]
[1875.545279, "o", "\u001b[?2004h> "]
[1875.545402, "o", "            self.counts[i] += 1\r\n\u001b[?2004l\r"]
[1875.545427, "o", "\u001b[?2004h> "]
[1875.545571, "o", "            self.amounts[i] += amount\r\n\u001b[?2004l\r"]
[1875.545594, "o", "\u001b[?2004h"]
[1875.545614, "o", "> "]
[1875.545685, "o", "            i += i & -i\r\n\u001b[?2004l\r"]
[1875.545724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.545745, "o", "> "]
[1875.545858, "o", "    def range(self, left, right):\r\n\u001b[?2004l\r"]
[1875.545889, "o", "\u001b[?2004h> "]
[1875.545976, "o", "        if right <= left:\r\n\u001b[?2004l\r"]
[1875.545995, "o", "\u001b[?2004h> "]
[1875.546082, "o", "            return 0, 0\r\n\u001b[?2004l\r"]
[1875.546101, "o", "\u001b[?2004h"]
[1875.546116, "o", "> "]
[1875.546288, "o", "        return self._prefix(right) - self._prefix(left)\r\n\u001b[?2004l\r"]
[1875.546308, "o", "\u001b[?2004h"]
[1875.546329, "o", "> \r\n\u001b[?2004l\r"]
[1875.546344, "o", "\u001b[?2004h> "]
[1875.546416, "o", "    def _prefix(self, i):\r\n\u001b[?2004l\r"]
[1875.546434, "o", "\u001b[?2004h"]
[1875.546454, "o", "> "]
[1875.546527, "o", "        count = amount = 0\r\n\u001b[?2004l\r"]
[1875.546554, "o", "\u001b[?2004h> "]
[1875.546613, "o", "        while i > 0:\r\n\u001b[?2004l\r"]
[1875.546641, "o", "\u001b[?2004h> "]
[1875.546743, "o", "            count += self.counts[i]\r\n\u001b[?2004l\r"]
[1875.546766, "o", "\u001b[?2004h> "]
[1875.546876, "o", "            amount += self.amounts[i]\r\n\u001b[?2004l\r"]
[1875.5469, "o", "\u001b[?2004h> "]
[1875.546977, "o", "            i -= i & -i\r\n\u001b[?2004l\r"]
[1875.546997, "o", "\u001b[?2004h> "]
[1875.547089, "o", "        return count, amount\r\n\u001b[?2004l\r"]
[1875.547109, "o", "\u001b[?2004h> "]
[1875.547131, "o", "\r\n\u001b[?2004l\r"]
[1875.547148, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.547165, "o", "\u001b[?2004h> "]
[1875.54725, "o", "def _factorize_ids(a, b=None):\r\n\u001b[?2004l\r"]
[1875.54727, "o", "\u001b[?2004h> "]
[1875.547328, "o", "    if b is None:\r\n\u001b[?2004l\r"]
[1875.54735, "o", "\u001b[?2004h> "]
[1875.547534, "o", "        codes, unique = pd.factorize(pd.Series(a), sort=True)\r\n\u001b[?2004l\r"]
[1875.547567, "o", "\u001b[?2004h> "]
[1875.547643, "o", "        return codes, unique\r\n\u001b[?2004l\r"]
[1875.547665, "o", "\u001b[?2004h> "]
[1875.547896, "o", "    combined = pd.concat([pd.Series(a), pd.Series(b)], ignore_index=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.547922, "o", "> "]
[1875.548072, "o", "    codes, unique = pd.factorize(combined, sort=True)\r\n\u001b[?2004l\r"]
[1875.548089, "o", "\u001b[?2004h"]
[1875.548112, "o", "> "]
[1875.548249, "o", "    return codes[: len(a)], codes[len(a) :], unique\r\n\u001b[?2004l\r"]
[1875.54827, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.548295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.54832, "o", "\u001b[?2004h> "]
[1875.548549, "o", "def _event_features(points, events, commit_col, ts_col, *, amount_col=None,\r\n\u001b[?2004l\r"]
[1875.548574, "o", "\u001b[?2004h> "]
[1875.548731, "o", "                    windows=(30,), need_last=False):\r\n\u001b[?2004l\r"]
[1875.548755, "o", "\u001b[?2004h> "]
[1875.549005, "o", "    \"\"\"Evaluate event queries as events become visible through ``commit_col``.\"\"\"\r\n\u001b[?2004l\r"]
[1875.549013, "o", "\u001b[?2004h"]
[1875.549049, "o", "> "]
[1875.549086, "o", "    n = len(points)\r\n\u001b[?2004l\r"]
[1875.549109, "o", "\u001b[?2004h> "]
[1875.549324, "o", "    result = {f\"count_{w}\": np.zeros(n, dtype=\"int64\") for w in windows}\r\n\u001b[?2004l\r"]
[1875.549346, "o", "\u001b[?2004h> "]
[1875.549436, "o", "    if amount_col is not None:\r\n\u001b[?2004l\r"]
[1875.549458, "o", "\u001b[?2004h"]
[1875.549478, "o", "> "]
[1875.549621, "o", "        result[\"spend\"] = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.549643, "o", "\u001b[?2004h> "]
[1875.549814, "o", "    result[\"last\"] = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1875.549832, "o", "\u001b[?2004h"]
[1875.549851, "o", "> \r\n\u001b[?2004l\r"]
[1875.549869, "o", "\u001b[?2004h> "]
[1875.55003, "o", "    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[1875.550048, "o", "\u001b[?2004h> "]
[1875.5502, "o", "    point_positions = np.flatnonzero(point_valid)\r\n\u001b[?2004l\r"]
[1875.550227, "o", "\u001b[?2004h> "]
[1875.550322, "o", "    if not len(point_positions):\r\n\u001b[?2004l\r"]
[1875.550344, "o", "\u001b[?2004h> "]
[1875.550411, "o", "        return result\r\n\u001b[?2004l\r"]
[1875.550431, "o", "\u001b[?2004h> "]
[1875.550564, "o", "    point_secs = point_secs[point_positions]\r\n\u001b[?2004l\r"]
[1875.550585, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.550604, "o", "\u001b[?2004h> "]
[1875.550776, "o", "    event_secs, event_valid = _seconds(events[ts_col])\r\n\u001b[?2004l\r"]
[1875.550797, "o", "\u001b[?2004h> "]
[1875.550984, "o", "    event_commit, commit_valid = _seconds(events[commit_col])\r\n\u001b[?2004l\r"]
[1875.551007, "o", "\u001b[?2004h"]
[1875.551023, "o", "> "]
[1875.551135, "o", "    event_mask = event_valid & commit_valid\r\n\u001b[?2004l\r"]
[1875.551158, "o", "\u001b[?2004h> "]
[1875.551305, "o", "    event_positions = np.flatnonzero(event_mask)\r\n\u001b[?2004l\r"]
[1875.551326, "o", "\u001b[?2004h> "]
[1875.551457, "o", "    event_secs = event_secs[event_positions]\r\n\u001b[?2004l\r"]
[1875.551483, "o", "\u001b[?2004h> "]
[1875.55163, "o", "    event_commit = event_commit[event_positions]\r\n\u001b[?2004l\r"]
[1875.551652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.551672, "o", "\u001b[?2004h> "]
[1875.551736, "o", "    if len(events):\r\n\u001b[?2004l\r"]
[1875.551759, "o", "\u001b[?2004h> "]
[1875.551924, "o", "        point_codes, event_codes, _ = _factorize_ids(\r\n\u001b[?2004l\r"]
[1875.551951, "o", "\u001b[?2004h> "]
[1875.552134, "o", "            points[\"customer_id\"].iloc[point_positions],\r\n\u001b[?2004l\r"]
[1875.552155, "o", "\u001b[?2004h> "]
[1875.552362, "o", "            events[\"customer_id\"].iloc[event_positions],\r\n\u001b[?2004l\r"]
[1875.552381, "o", "\u001b[?2004h> "]
[1875.552424, "o", "        )\r\n\u001b[?2004l\r"]
[1875.552447, "o", "\u001b[?2004h> "]
[1875.552485, "o", "    else:\r\n\u001b[?2004l\r"]
[1875.552504, "o", "\u001b[?2004h> "]
[1875.552822, "o", "        point_codes, _ = _factorize_ids(points[\"customer_id\"].iloc[point_positions])\r\n\u001b[?2004l\r"]
[1875.55284, "o", "\u001b[?2004h> "]
[1875.553018, "o", "        event_codes = np.empty(0, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.553051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.553069, "o", "\u001b[?2004h"]
[1875.553092, "o", "> "]
[1875.55334, "o", "    all_secs = np.concatenate([point_secs, event_secs]) if len(event_secs) else point_secs\r\n\u001b[?2004l\r"]
[1875.553365, "o", "\u001b[?2004h> "]
[1875.553479, "o", "    base = int(all_secs.min())\r\n\u001b[?2004l\r"]
[1875.553498, "o", "\u001b[?2004h> "]
[1875.553627, "o", "    span = int(all_secs.max()) - base + 1\r\n\u001b[?2004l\r"]
[1875.553647, "o", "\u001b[?2004h> "]
[1875.553664, "o", "\r\n\u001b[?2004l\r"]
[1875.553682, "o", "\u001b[?2004h> "]
[1875.553957, "o", "    point_keys = point_codes.astype(\"int64\") * span + (point_secs - base)\r\n\u001b[?2004l\r"]
[1875.553985, "o", "\u001b[?2004h> "]
[1875.554052, "o", "    if len(event_secs):\r\n\u001b[?2004l\r"]
[1875.554076, "o", "\u001b[?2004h> "]
[1875.554342, "o", "        event_keys = event_codes.astype(\"int64\") * span + (event_secs - base)\r\n\u001b[?2004l\r"]
[1875.554366, "o", "\u001b[?2004h> "]
[1875.554598, "o", "        sorted_index = np.argsort(event_keys, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[1875.554621, "o", "\u001b[?2004h> "]
[1875.554788, "o", "        event_keys = event_keys[sorted_index]\r\n\u001b[?2004l\r"]
[1875.55481, "o", "\u001b[?2004h> "]
[1875.555004, "o", "        ranks = np.empty(len(event_keys), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.555033, "o", "\u001b[?2004h> "]
[1875.555285, "o", "        ranks[sorted_index] = np.arange(len(event_keys), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.555317, "o", "\u001b[?2004h"]
[1875.555337, "o", "> "]
[1875.55536, "o", "    else:\r\n\u001b[?2004l\r"]
[1875.555377, "o", "\u001b[?2004h> "]
[1875.555544, "o", "        event_keys = np.empty(0, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.555573, "o", "\u001b[?2004h> "]
[1875.555693, "o", "        ranks = np.empty(0, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.555717, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.555737, "o", "\u001b[?2004h> "]
[1875.555917, "o", "    if amount_col is not None and len(event_positions):\r\n\u001b[?2004l\r"]
[1875.555942, "o", "\u001b[?2004h> "]
[1875.556216, "o", "        amounts = pd.to_numeric(events[amount_col].iloc[event_positions],\r\n\u001b[?2004l\r"]
[1875.556235, "o", "\u001b[?2004h"]
[1875.556252, "o", "> "]
[1875.556514, "o", "                                errors=\"coerce\").fillna(0).astype(\"int64\").to_numpy()\r\n\u001b[?2004l\r"]
[1875.556531, "o", "\u001b[?2004h"]
[1875.556551, "o", "> "]
[1875.556571, "o", "    else:\r\n\u001b[?2004l\r"]
[1875.55659, "o", "\u001b[?2004h> "]
[1875.556784, "o", "        amounts = np.zeros(len(event_positions), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.556806, "o", "\u001b[?2004h> "]
[1875.556823, "o", "\r\n\u001b[?2004l\r"]
[1875.55684, "o", "\u001b[?2004h> "]
[1875.55696, "o", "    tree = _Fenwick(len(event_keys))\r\n\u001b[?2004l\r"]
[1875.556984, "o", "\u001b[?2004h"]
[1875.557005, "o", "> "]
[1875.557162, "o", "    event_order = np.argsort(event_commit, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[1875.557184, "o", "\u001b[?2004h> "]
[1875.557318, "o", "    event_commit = event_commit[event_order]\r\n\u001b[?2004l\r"]
[1875.557341, "o", "\u001b[?2004h> "]
[1875.557478, "o", "    event_order = event_positions[event_order]\r\n\u001b[?2004l\r"]
[1875.557497, "o", "\u001b[?2004h> "]
[1875.557595, "o", "    ranks = ranks[event_order]\r\n\u001b[?2004l\r"]
[1875.557613, "o", "\u001b[?2004h> "]
[1875.557736, "o", "    event_secs = event_secs[event_order]\r\n\u001b[?2004l\r"]
[1875.557754, "o", "\u001b[?2004h> "]
[1875.55789, "o", "    event_codes = event_codes[event_order]\r\n\u001b[?2004l\r"]
[1875.557918, "o", "\u001b[?2004h> "]
[1875.558015, "o", "    amounts = amounts[event_order]\r\n\u001b[?2004l\r"]
[1875.558039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.558063, "o", "\u001b[?2004h> "]
[1875.558296, "o", "    histories = [[] for _ in range(len(point_codes))] if need_last else None\r\n\u001b[?2004l\r"]
[1875.558326, "o", "\u001b[?2004h> "]
[1875.558372, "o", "    event_pos = 0\r\n\u001b[?2004l\r"]
[1875.558396, "o", "\u001b[?2004h> "]
[1875.558554, "o", "    for q, original in enumerate(point_positions):\r\n\u001b[?2004l\r"]
[1875.558579, "o", "\u001b[?2004h> "]
[1875.558674, "o", "        t = int(point_secs[q])\r\n\u001b[?2004l\r"]
[1875.558693, "o", "\u001b[?2004h"]
[1875.558715, "o", "> "]
[1875.558798, "o", "        code = int(point_codes[q])\r\n\u001b[?2004l\r"]
[1875.558821, "o", "\u001b[?2004h> "]
[1875.559052, "o", "        while event_pos < len(event_order) and event_commit[event_pos] < t:\r\n\u001b[?2004l\r"]
[1875.559074, "o", "\u001b[?2004h> "]
[1875.559207, "o", "            i = int(event_order[event_pos])\r\n\u001b[?2004l\r"]
[1875.559224, "o", "\u001b[?2004h> "]
[1875.559455, "o", "            tree.add(int(ranks[event_pos]), int(amounts[event_pos]))\r\n\u001b[?2004l\r"]
[1875.559479, "o", "\u001b[?2004h> "]
[1875.559601, "o", "            if histories is not None:\r\n\u001b[?2004l\r"]
[1875.559624, "o", "\u001b[?2004h> "]
[1875.559827, "o", "                insort(histories[code], int(event_secs[event_pos]))\r\n\u001b[?2004l\r"]
[1875.559848, "o", "\u001b[?2004h> "]
[1875.559938, "o", "            event_pos += 1\r\n\u001b[?2004l\r"]
[1875.559967, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.559988, "o", "\u001b[?2004h"]
[1875.560009, "o", "> "]
[1875.560082, "o", "        for window in windows:\r\n\u001b[?2004l\r"]
[1875.560109, "o", "\u001b[?2004h> "]
[1875.560292, "o", "            lower_adj = max(t - int(window) * 86400 - base, 0)\r\n\u001b[?2004l\r"]
[1875.560322, "o", "\u001b[?2004h> "]
[1875.560435, "o", "            upper_adj = max(t - base, 0)\r\n\u001b[?2004l\r"]
[1875.560452, "o", "\u001b[?2004h> "]
[1875.560658, "o", "            left = bisect_left(event_keys, code * span + lower_adj)\r\n\u001b[?2004l\r"]
[1875.560677, "o", "\u001b[?2004h> "]
[1875.560887, "o", "            right = bisect_left(event_keys, code * span + upper_adj)\r\n\u001b[?2004l\r"]
[1875.56091, "o", "\u001b[?2004h> "]
[1875.561051, "o", "            count, _ = tree.range(left, right)\r\n\u001b[?2004l\r"]
[1875.561072, "o", "\u001b[?2004h> "]
[1875.561243, "o", "            result[f\"count_{window}\"][original] = count\r\n\u001b[?2004l\r"]
[1875.561264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.561283, "o", "\u001b[?2004h> "]
[1875.561396, "o", "        if amount_col is not None:\r\n\u001b[?2004l\r"]
[1875.561417, "o", "\u001b[?2004h> "]
[1875.561569, "o", "            lower_adj = max(t - 30 * 86400 - base, 0)\r\n\u001b[?2004l\r"]
