[217.459991, "i", "python - <<'PY'\nimport re,json,collections\nlog=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3: continue\n if a[1] in ('legacy_orders','orders_hourly','legacy_backfill'):\n  log.append((pd.Timestamp(a[0]),a[1],a[2]))\ncomm={}\nfor l in open('data/_ops/commits.jsonl'):\n x=json.loads(l); comm[x['txn']]=x\nfor job in ['legacy_orders','orders_hourly']:\n sel=[]\n for t,j,m in log:\n  if j==job:\n   z=re.search(r'selected .* ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',m)\n   if z: sel.append(z.groups())\n print('\\n',job,'selections',len(sel),'first',sel[:2],'last',sel[-2:])\n for z in sel[-3:]:\n  start,end,n,txn,table=z; c=comm[int(txn)]\n  print(z,'=>',c)\nPY\n"]
