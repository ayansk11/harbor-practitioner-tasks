[1476.722337, "o", "\u001b[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# "]
[1477.070124, "i", "cat > churn/windows.py <<'PY'\n\"\"\"Point-in-time event features, including warehouse load visibility.\"\"\"\nfrom bisect import bisect_left, insort\n\nimport numpy as np\nimport pandas as pd\n\n\ndef _seconds(values):\n    values = pd.to_datetime(values, utc=True)\n    valid = values.notna().to_numpy()\n    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\n    return out, valid\n\n\nclass _Fenwick:\n    def __init__(self, n):\n        self.n = n\n        self.tree = [0] * (n + 1)\n\n    def add(self, i, delta):\n        i += 1\n        while i <= self.n:\n            self.tree[i] += delta\n            i += i & -i\n\n    def prefix(self, i):\n        result = 0\n        while i > 0:\n            result += self.tree[i]\n            i -= i & -i\n        return result\n\n    def range(self, left, right):\n        return self.prefix(right) - self.prefix(left)\n\n\nclass _SumFenwick:\n    def __init__(self, n):\n        self.n = n\n        self.tree = [0] * (n + 1)\n\n    def add(self, i, delta):\n        i += 1\n        while i <= "]
[1477.070157, "i", "self.n:\n            self.tree[i] += delta\n            i += i & -i\n\n    def prefix(self, i):\n        result = 0\n        while i > 0:\n            result += self.tree[i]\n            i -= i & -i\n        return result\n\n    def range(self, left, right):\n        return self.prefix(right) - self.prefix(left)\n\n\ndef _codes(points, point_positions, events):\n    left = points[\"customer_id\"].to_numpy(dtype=\"int64\")[point_positions]\n    if len(events):\n        right = events[\"customer_id\"].to_numpy(dtype=\"int64\")\n        all_ids = np.concatenate([left, right])\n    else:\n        all_ids = left\n    codes, unique = pd.factorize(all_ids, sort=True)\n    n_points = len(point_positions)\n    return codes[:n_points], codes[n_points:], unique\n\n\ndef _event_computer(points, point_positions, events, commit_col, *, amount_col=None,\n                    last_event=False):\n    \"\"\"Compute windows [t-W,t) over events visible strictly before each t.\"\"\"\n    n = len(point_positions)\n    point_times, point_valid = _seconds(points[\"as_of\"].iloc[p"]
[1477.070171, "i", "oint_positions])\n    valid_positions = point_positions[point_valid]\n    valid_times = point_times[point_valid]\n    counts = [np.zeros(n, dtype=\"int64\") for _ in range(len(days))] if False else None\n    return valid_positions, valid_times\nPY\n"]
