[3166.868058, "i", "python - <<'PY'\nimport json,re\nfrom churn.ops import _STATEMENT_RE,_SEND_RE\nfor line in open('data/_ops/scheduler.log'):\n    parts=line.rstrip().split(maxsplit=2)\n    if len(parts)==3 and parts[1]=='schema_migrations':\n        _,job,msg=parts\n        print(repr(msg), 'statement', bool(_STATEMENT_RE.match(msg)), 'send', _SEND_RE.search(msg))\nPY\n"]
