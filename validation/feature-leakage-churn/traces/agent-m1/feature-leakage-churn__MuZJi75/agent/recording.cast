[3564.929309, "o", "\u001b[?2004h> "]
[3564.929431, "o", "def _seconds(values):\r\n\u001b[?2004l\r"]
[3564.929466, "o", "\u001b[?2004h"]
[3564.929499, "o", "> "]
[3564.929811, "o", "    values = pd.to_datetime(pd.Series(values), utc=True)\r\n\u001b[?2004l\r"]
[3564.929854, "o", "\u001b[?2004h> "]
[3564.930102, "o", "    valid = values.notna().to_numpy()\r\n\u001b[?2004l\r"]
[3564.930147, "o", "\u001b[?2004h> "]
[3564.930631, "o", "    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n\u001b[?2004l\r"]
[3564.930674, "o", "\u001b[?2004h> "]
[3564.930811, "o", "    return out, valid\r\n\u001b[?2004l\r"]
[3564.930905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
