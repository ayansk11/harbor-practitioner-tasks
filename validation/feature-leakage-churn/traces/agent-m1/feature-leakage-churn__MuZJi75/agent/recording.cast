[1652.399854, "o", "> "]
[1652.400172, "o", "                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None and statements.get(job):\r\n"]
[1652.400187, "o", "\u001b[?2004l\r"]
[1652.400196, "o", "\u001b[?2004h"]
[1652.400336, "o", "> "]
[1652.400347, "o", "                    schema_txns.append({"]
[1652.400354, "o", "\r\n"]
[1652.40036, "o", "\u001b[?2004l\r"]
[1652.400444, "o", "\u001b[?2004h> "]
[1652.400694, "o", "                        \"txn\": txn,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.400756, "o", "                        \"at\": info[\"at\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.400967, "o", "                        \"statements\": tuple(statements[job]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.400979, "o", "> "]
[1652.401069, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.401184, "o", "                statements[job] = []\r\n\u001b[?2004l\r"]
[1652.401218, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1652.401228, "o", "\u001b[?2004h> "]
[1652.401373, "o", "    schema_txns.sort(key=lambda x: x[\"at\"])\r\n\u001b[?2004l\r"]
[1652.401407, "o", "\u001b[?2004h> "]
[1652.4015, "o", "    names = {\"orders\": \"orders\"}\r\n\u001b[?2004l\r"]
[1652.401547, "o", "\u001b[?2004h> "]
[1652.401644, "o", "    current_identity = names[\"orders\"]\r\n\u001b[?2004l\r"]
[1652.401699, "o", "\u001b[?2004h> "]
[1652.401771, "o", "    rename_at = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.401855, "o", "    for txn in schema_txns:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.40194, "o", "> "]
[1652.402044, "o", "        for statement in txn[\"statements\"]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.402169, "o", "            match = _RENAME_RE.fullmatch(statement)\r\n\u001b[?2004l\r"]
[1652.402181, "o", "\u001b[?2004h"]
[1652.402232, "o", "> "]
[1652.402329, "o", "            if not match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.402405, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.402566, "o", "            old_name, new_name = map(_table_name, match.groups())\r\n\u001b[?2004l\r"]
[1652.402578, "o", "\u001b[?2004h"]
[1652.402585, "o", "> "]
[1652.402736, "o", "            names[new_name] = names.get(old_name, old_name)\r\n\u001b[?2004l\r"]
[1652.402749, "o", "\u001b[?2004h"]
[1652.402755, "o", "> "]
[1652.402855, "o", "            if old_name != new_name:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.40296, "o", "> "]
[1652.403025, "o", "                names.pop(old_name, None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.403133, "o", "        if names.get(\"orders\") != current_identity:\r\n\u001b[?2004l\r"]
[1652.403145, "o", "\u001b[?2004h> "]
[1652.403234, "o", "            if rename_at is None:\r\n\u001b[?2004l\r"]
[1652.403252, "o", "\u001b[?2004h> "]
[1652.403347, "o", "                rename_at = txn[\"at\"]\r\n\u001b[?2004l\r"]
[1652.403355, "o", "\u001b[?2004h"]
[1652.403361, "o", "> "]
[1652.40349, "o", "            current_identity = names.get(\"orders\")\r\n\u001b[?2004l\r"]
[1652.403502, "o", "\u001b[?2004h"]
[1652.403535, "o", "> \r\n\u001b[?2004l\r"]
[1652.403577, "o", "\u001b[?2004h> "]
[1652.403805, "o", "    return Ops(order_txns=order_txns, schema_txns=schema_txns, rename_at=rename_at)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1652.403835, "o", "\u001b[?2004l\r"]
[1652.403841, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1652.403942, "o", "\u001b[?2004h> "]
[1652.404104, "o", "def _seconds(values):\r\n\u001b[?2004l\r\u001b[?2004h>     values = pd.to_datetime(pd.Series(values), utc=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.404211, "o", "    valid = values.notna().to_numpy()\r\n\u001b[?2004l\r"]
[1652.404252, "o", "\u001b[?2004h> "]
[1652.404462, "o", "    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.404477, "o", "> "]
[1652.404623, "o", "    return out, valid\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.404747, "o", "def assign_legacy_order_commits(orders, ops, rename_at):\r\n\u001b[?2004l\r"]
[1652.404767, "o", "\u001b[?2004h> "]
[1652.405033, "o", "    \"\"\"Assign old-generation commit times to orders from scheduler intervals."]
[1652.405051, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1652.405062, "o", "\u001b[?2004h"]
[1652.405078, "o", "> "]
[1652.405782, "o", "    After a failed load the next legacy load uses an expanding ordered_at interval.\r\n\u001b[?2004l\r\u001b[?2004h>     Thus the earliest successful transaction containing an order's timestamp is the\r\n\u001b[?2004l\r\u001b[?2004h>     transaction that first committed it to the old ``orders`` generation.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.405842, "o", "    orders[\"_legacy_commit\"] = pd.NaT\r\n\u001b[?2004l\r"]
[1652.405854, "o", "\u001b[?2004h"]
[1652.405861, "o", "> "]
[1652.405983, "o", "    ops.legacy_orders_complete = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.406062, "o", ">     if rename_at is None:\r\n\u001b[?2004l\r"]
[1652.406073, "o", "\u001b[?2004h"]
[1652.406105, "o", "> "]
[1652.406159, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.406169, "o", "> "]
[1652.40627, "o", "    records = [x for x in ops.order_txns\r\n\u001b[?2004l\r"]
[1652.406286, "o", "\u001b[?2004h> "]
[1652.406449, "o", "               if x.table == \"orders\" and x.commit < rename_at]\r\n"]
[1652.406459, "o", "\u001b[?2004l\r"]
[1652.406515, "o", "\u001b[?2004h> "]
[1652.406543, "o", "    if not records:\r\n\u001b[?2004l\r"]
[1652.406564, "o", "\u001b[?2004h> "]
[1652.406631, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.406652, "o", "> "]
[1652.406797, "o", "    records.sort(key=lambda x: (x.start, x.commit, x.txn))\r\n"]
[1652.406808, "o", "\u001b[?2004l\r"]
[1652.406866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.407014, "o", "    starts, _ = _seconds([x.start for x in records])\r\n"]
[1652.407053, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.407172, "o", "    ends, _ = _seconds([x.end for x in records])\r\n"]
[1652.407189, "o", "\u001b[?2004l\r"]
[1652.407196, "o", "\u001b[?2004h"]
[1652.407245, "o", "> "]
[1652.40737, "o", "    commit_secs, _ = _seconds([x.commit for x in records])\r\n\u001b[?2004l\r"]
[1652.40742, "o", "\u001b[?2004h> "]
[1652.407551, "o", "    event_secs, event_valid = _seconds(orders[\"ordered_at\"])\r\n"]
[1652.407584, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.407657, "o", "    if event_valid.any():\r\n"]
[1652.407673, "o", "\u001b[?2004l\r"]
[1652.40768, "o", "\u001b[?2004h"]
[1652.407763, "o", "> "]
[1652.407924, "o", "        unique, inverse, counts = np.unique(event_secs[event_valid], return_inverse=True,\r\n"]
[1652.407982, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.408137, "o", "                                            return_counts=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.408148, "o", "> "]
[1652.4083, "o", "        assigned = np.full(len(unique), -1, dtype=\"int64\")\r\n"]
[1652.408339, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.4084, "o", "        active = []\r\n\u001b[?2004l\r"]
[1652.408416, "o", "\u001b[?2004h"]
[1652.408423, "o", "> "]
[1652.408505, "o", "        pos = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.40872, "o", "        for event_no, ts in enumerate(unique):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1652.408809, "o", "            while pos < len(records) and starts[pos] <= ts:\r\n"]
[1652.408819, "o", "\u001b[?2004l\r"]
[1652.408839, "o", "\u001b[?2004h"]
[1652.408846, "o", "> "]
[1652.409075, "o", "                heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))\r\n\u001b[?2004l\r"]
[1652.409099, "o", "\u001b[?2004h> "]
[1652.409184, "o", "                pos += 1\r\n"]
[1652.409195, "o", "\u001b[?2004l\r"]
[1652.409248, "o", "\u001b[?2004h> "]
[1652.409375, "o", "            while active and active[0][1] <= ts:\r\n"]
[1652.409392, "o", "\u001b[?2004l\r"]
[1652.409453, "o", "\u001b[?2004h> "]
[1652.409536, "o", "                heapq.heappop(active)\r\n"]
[1652.409606, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.409678, "o", "            if active:\r\n\u001b[?2004l\r"]
[1652.409724, "o", "\u001b[?2004h> "]
[1652.409832, "o", "                assigned[event_no] = active[0][2]\r\n\u001b[?2004l\r"]
[1652.409855, "o", "\u001b[?2004h> "]
[1652.409894, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.409906, "o", "> "]
[1652.41007, "o", "        txn_counts = np.zeros(len(records), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1652.410082, "o", "\u001b[?2004h"]
[1652.410089, "o", "> "]
[1652.410168, "o", "        hit = assigned >= 0\r\n"]
[1652.410178, "o", "\u001b[?2004l\r"]
[1652.410213, "o", "\u001b[?2004h> "]
[1652.410275, "o", "        if hit.any():\r\n\u001b[?2004l\r"]
[1652.410314, "o", "\u001b[?2004h> "]
[1652.410478, "o", "            np.add.at(txn_counts, assigned[hit], counts[hit])\r\n"]
[1652.410491, "o", "\u001b[?2004l\r"]
[1652.410525, "o", "\u001b[?2004h> "]
[1652.410695, "o", "        expected = np.asarray([x.rows for x in records], dtype=\"int64\")\r\n"]
[1652.410706, "o", "\u001b[?2004l\r"]
[1652.410743, "o", "\u001b[?2004h> "]
[1652.410939, "o", "        ops.legacy_orders_complete = bool(np.array_equal(txn_counts, expected))\r\n"]
[1652.410949, "o", "\u001b[?2004l\r"]
[1652.410984, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1652.411025, "o", "\u001b[?2004h> "]
[1652.4112, "o", "        out = np.full(len(orders), np.iinfo(np.int64).min, dtype=\"int64\")\r\n"]
[1652.41121, "o", "\u001b[?2004l\r"]
[1652.411261, "o", "\u001b[?2004h> "]
[1652.411361, "o", "        positions = np.flatnonzero(event_valid)\r\n"]
[1652.411371, "o", "\u001b[?2004l\r"]
[1652.411403, "o", "\u001b[?2004h> "]
[1652.41149, "o", "        vals = assigned[inverse]\r\n"]
[1652.4115, "o", "\u001b[?2004l\r"]
[1652.411532, "o", "\u001b[?2004h> "]
[1652.411595, "o", "        good = vals >= 0\r\n"]
[1652.411605, "o", "\u001b[?2004l\r"]
[1652.411669, "o", "\u001b[?2004h> "]
[1652.411771, "o", "        out[positions[good]] = commit_secs[vals[good]]\r\n"]
[1652.411795, "o", "\u001b[?2004l\r"]
[1652.41181, "o", "\u001b[?2004h> "]
[1652.412042, "o", "        result = pd.to_datetime(pd.Series(out, index=orders.index), unit=\"s\", utc=True)\r\n"]
