[1476.711947, "o", "def assign_legacy_order_commits(orders, ops, rename_at):\r\n\u001b[?2004l\r"]
[1476.711965, "o", "\u001b[?2004h"]
[1476.711981, "o", "> "]
[1476.712166, "o", "    \"\"\"Map source orders to their commits into the old generation named *orders*.\r\n\u001b[?2004l\r"]
[1476.712182, "o", "\u001b[?2004h> "]
[1476.712204, "o", "\r\n\u001b[?2004l\r"]
[1476.712221, "o", "\u001b[?2004h> "]
[1476.712415, "o", "    A failed/rolled-back load is retried with an expanding ordered_at interval.  For\r\n\u001b[?2004l\r"]
[1476.712431, "o", "\u001b[?2004h> "]
[1476.712635, "o", "    each source order, the earliest successful transaction whose interval contains\r\n\u001b[?2004l\r"]
[1476.712651, "o", "\u001b[?2004h> "]
[1476.712829, "o", "    its timestamp is therefore the transaction that first committed it.\r\n\u001b[?2004l\r"]
[1476.712852, "o", "\u001b[?2004h> "]
[1476.712873, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[1476.712915, "o", "\u001b[?2004h> "]
[1476.713097, "o", "    commits = pd.Series(pd.NaT, index=orders.index, dtype=\"datetime64[ns, UTC]\")\r\n\u001b[?2004l\r"]
[1476.713118, "o", "\u001b[?2004h"]
[1476.71315, "o", "> "]
[1476.713185, "o", "    if rename_at is None:\r\n\u001b[?2004l\r"]
[1476.713199, "o", "\u001b[?2004h"]
[1476.713215, "o", "> "]
[1476.713313, "o", "        orders[\"_legacy_commit\"] = commits\r\n\u001b[?2004l\r"]
[1476.713343, "o", "\u001b[?2004h"]
[1476.713932, "o", ">         return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     records = [x for x in ops.order_txns\r\n\u001b[?2004l\r\u001b[?2004h>                if x.table == \"orders\" and x.commit < rename_at]\r\n\u001b[?2004l\r\u001b[?2004h>     if not records:\r\n\u001b[?2004l\r\u001b[?2004h>         orders[\"_legacy_commit\"] = commits\r\n\u001b[?2004l\r"]
[1476.713966, "o", "\u001b[?2004h> "]
[1476.713979, "o", "        return"]
[1476.714068, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.71431, "o", "    records.sort(key=lambda x: x.start)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.714354, "o", "    starts, valid = _seconds(pd.Series([x.start for x in records]))\r\n\u001b[?2004l\r"]
[1476.714382, "o", "\u001b[?2004h> "]
[1476.714752, "o", "    ends, _ = _seconds(pd.Series([x.end for x in records]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.714855, "o", "    commit_secs, _ = _seconds(pd.Series([x.commit for x in records]))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.715004, "o", "    event_times, event_valid = _seconds(orders[\"ordered_at\"])\r\n\u001b[?2004l\r"]
[1476.715069, "o", "\u001b[?2004h> "]
[1476.715256, "o", "    unique, inverse = np.unique(event_times[event_valid], return_inverse=True)\r\n\u001b[?2004l\r"]
[1476.715316, "o", "\u001b[?2004h> "]
[1476.715458, "o", "    assigned = np.full(len(unique), -1, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1476.715589, "o", "\u001b[?2004h>     active = []\r\n\u001b[?2004l\r"]
[1476.715618, "o", "\u001b[?2004h>     pos = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.715753, "o", "    for event_no, ts in enumerate(unique):\r\n\u001b[?2004l\r"]
[1476.715788, "o", "\u001b[?2004h> "]
[1476.715975, "o", "        while pos < len(records) and starts[pos] <= ts:\r\n\u001b[?2004l\r"]
[1476.71606, "o", "\u001b[?2004h> "]
[1476.716228, "o", "            heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))\r\n\u001b[?2004l\r"]
[1476.716291, "o", "\u001b[?2004h> "]
[1476.716363, "o", "            pos += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.716492, "o", "        while active and active[0][1] <= ts:\r\n\u001b[?2004l\r"]
[1476.71657, "o", "\u001b[?2004h> "]
[1476.716693, "o", "            heapq.heappop(active)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1476.716713, "o", "> "]
[1476.716783, "o", "        if active:\r\n\u001b[?2004l\r"]
[1476.7168, "o", "\u001b[?2004h> "]
[1476.716989, "o", "            assigned[event_no] = active[0][2]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.717187, "o", "    out = np.full(len(orders), np.iinfo(np.int64).min, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1476.717291, "o", "\u001b[?2004h> "]
[1476.717395, "o", "    positions = np.flatnonzero(event_valid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.717546, "o", "    vals = assigned[inverse]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1476.717563, "o", "> "]
[1476.717655, "o", "    hit = vals >= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1476.717849, "o", "    out[positions[hit]] = commit_secs[vals[hit]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1476.717916, "o", "> "]
[1476.718094, "o", "    result = pd.to_datetime(pd.Series(out, index=orders.index), unit=\"s\", utc=True)\r\n\u001b[?2004l\r"]
[1476.718142, "o", "\u001b[?2004h> "]
[1476.718371, "o", "    orders[\"_legacy_commit\"] = result.where(out != np.iinfo(np.int64).min, pd.NaT)\r\n\u001b[?2004l\r"]
[1476.718444, "o", "\u001b[?2004h> "]
[1476.718499, "o", "PY\r\n\u001b[?2004l\r"]
[1476.720047, "o", "\u001b[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# "]
[1476.720245, "o", "# The helper above uses numpy and heapq; ensure imports are present.\r\n\u001b[?2004l\r"]
[1476.720293, "o", "\u001b[?2004h"]
[1476.720327, "o", "root@350a58e0-4994-406f-939c-27256b382ccb:/app# "]
