[1652.39735, "o", "\u001b[?2004h> "]
[1652.398012, "o", "                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None:\r\n"]
[1652.398024, "o", "\u001b[?2004l\r"]
[1652.398056, "o", "\u001b[?2004h"]
[1652.39809, "o", "> "]
[1652.398225, "o", "                    order_txns.append(OrderTxn(\r\n\u001b[?2004l\r"]
[1652.398242, "o", "\u001b[?2004h"]
