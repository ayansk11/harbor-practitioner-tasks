[3565.00997, "o", "> "]
[3565.010135, "o", "    pt_district = np.asarray(district_codes[len(labels):])\r\n\u001b[?2004l\r"]
[3565.010164, "o", "\u001b[?2004h> "]
[3565.010397, "o", "    # SQL NULL is not equal to itself, so a null own district has no matching labels.\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.010419, "o", "> "]
[3565.010626, "o", "    pt_district = np.where(pt_district >= 0, pt_district, -999999)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.010651, "o", "> \r\n\u001b[?2004l\ro"]
[3565.010676, "o", "\u001b[?2004h> "]
[3565.010864, "o", "    lab_commit, lab_commit_valid = _seconds(labels[\"_loaded_at\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.010897, "o", "> "]
[3565.011131, "o", "    lab_signup_secs = np.full(len(labels), np.iinfo(np.int64).max, dtype=\"int64\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.011155, "o", "> "]
[3565.011241, "o", "    if lab_has_customer.any():\r\n\u001b[?2004l\r"]
[3565.011261, "o", "\u001b[?2004h> "]
[3565.011464, "o", "        positions = lab_customer_index[lab_has_customer]\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.011489, "o", "> "]
[3565.011616, "o", "        signup_secs, signup_valid = _seconds(\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.011648, "o", "> "]
[3565.011777, "o", "            customers[\"signup_at\"].iloc[positions]\r\n\u001b[?2004l\r"]
[3565.011794, "o", "\u001b[?2004h> "]
[3565.011834, "o", "        )\r\n\u001b[?2004l\r"]
[3565.011855, "o", "\u001b[?2004h> "]
[3565.012019, "o", "        lab_signup_secs[lab_has_customer] = np.where(\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.012054, "o", "> "]
[3565.012217, "o", "            signup_valid, signup_secs, np.iinfo(np.int64).max\r\n\u001b[?2004l\r"]
[3565.012252, "o", "\u001b[?2004h> "]
[3565.012273, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.012298, "o", "> "]
[3565.012527, "o", "    lab_commit = np.where(lab_commit_valid, lab_commit, np.iinfo(np.int64).max)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.012552, "o", "> "]
[3565.012711, "o", "    eligibility = np.maximum(lab_commit, lab_signup_secs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.012735, "o", "> \r\n\u001b[?2004l\rt"]
[3565.012756, "o", "\u001b[?2004h> "]
[3565.013026, "o", "    y_values = pd.to_numeric(labels[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.013054, "o", "> "]
[3565.013258, "o", "    label_order = np.argsort(eligibility, kind=\"mergesort\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.013287, "o", "> "]
[3565.013403, "o", "    eligibility = eligibility[label_order]\r\n\u001b[?2004l\r"]
[3565.013471, "o", "\u001b[?2004h> "]
[3565.013566, "o", "    lab_district = lab_district[label_order]\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.013599, "o", "> "]
[3565.013694, "o", "    y_values = y_values[label_order]\r\n\u001b[?2004l\r"]
[3565.013733, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[3565.013947, "o", "    point_order = np.argsort(point_secs, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[3565.013996, "o", "\u001b[?2004h> "]
[3565.014066, "o", "    global_n = global_sum = 0\r\n\u001b[?2004l\r"]
[3565.014098, "o", "\u001b[?2004h> "]
[3565.014149, "o", "    district_n = {}\r\n\u001b[?2004l\r"]
[3565.014181, "o", "\u001b[?2004h> "]
[3565.014233, "o", "    district_sum = {}\r\n\u001b[?2004l\r"]
[3565.014268, "o", "\u001b[?2004h> "]
[3565.014313, "o", "    label_i = 0\r\n\u001b[?2004l\r"]
[3565.014393, "o", "\u001b[?2004h> "]
[3565.014444, "o", "    for q in point_order:\r\n\u001b[?2004l\r"]
[3565.014489, "o", "\u001b[?2004h> "]
