[3250.056532, "o", "> "]
[3250.056593, "o", "    statements = {}\r\n\u001b[?2004l\r"]
[3250.056634, "o", "\u001b[?2004h> "]
[3250.056956, "o", "    with open(os.path.join(data_dir, \"_ops\", \"scheduler.log\"), encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r"]
[3250.057, "o", "\u001b[?2004h> "]
[3250.057075, "o", "        for line in fh:\r\n\u001b[?2004l\r"]
[3250.057118, "o", "\u001b[?2004h> "]
[3250.057316, "o", "            parts = line.rstrip(\"\\n\").split(maxsplit=2)\r\n\u001b[?2004l\r"]
[3250.057341, "o", "\u001b[?2004h> "]
[3250.057473, "o", "            if len(parts) != 3:\r\n\u001b[?2004l\r"]
[3250.057518, "o", "\u001b[?2004h> "]
[3250.057595, "o", "                continue\r\n\u001b[?2004l\r"]
[3250.057645, "o", "\u001b[?2004h> "]
[3250.057792, "o", "            job, message = parts[1], parts[2]\r\n\u001b[?2004l\r"]
[3250.057839, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3250.05789, "o", "\u001b[?2004h> "]
[3250.058028, "o", "            if \"state=running\" in message:\r\n\u001b[?2004l\r"]
[3250.058074, "o", "\u001b[?2004h> "]
[3250.058188, "o", "                statements[job] = []\r\n\u001b[?2004l\r"]
[3250.058228, "o", "\u001b[?2004h> "]
[3250.058319, "o", "                continue\r\n\u001b[?2004l\r"]
[3250.058358, "o", "\u001b[?2004h> "]
[3250.058495, "o", "            if \"state=\" in message:\r\n\u001b[?2004l\r"]
[3250.058537, "o", "\u001b[?2004h> "]
[3250.058656, "o", "                statements[job] = []\r\n\u001b[?2004l\r"]
[3250.058692, "o", "\u001b[?2004h"]
[3250.05874, "o", "> "]
[3250.058779, "o", "                continue\r\n\u001b[?2004l\r"]
[3250.058824, "o", "\u001b[?2004h"]
[3250.05887, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
