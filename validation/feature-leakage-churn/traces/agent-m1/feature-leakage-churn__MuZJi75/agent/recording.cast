[707.605941, "i", "cat > /tmp/check_orders.py <<'PY'\nimport pandas as pd,re,json\nO=pd.read_csv('data/orders.csv'); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True); O['_loaded_at']=pd.to_datetime(O['_loaded_at'],utc=True)\nC={int(json.loads(x)['txn']):json.loads(x) for x in open('data/_ops/commits.jsonl')}\nR=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if not z: continue\n x=C[int(z.group(4))]\n if x['outcome']=='commit': R.append((pd.Timestamp(z.group(1)),pd.Timestamp(z.group(2)),int(z.group(3)),pd.Timestamp(x['at']),int(z.group(4))))\nR.sort(key=lambda x:x[3])\nold=O[O._load_job.eq('legacy_backfill')].copy()\nstarts=pd.Series([r[0] for r in R]); ends=pd.Series([r[1] for r in R]); times=pd.Series([r[3] for r in R]); counts=pd.Series([r[2] for r in R])\n# For each event, earliest successful commit whose interval contains it.\nidx=[]\nfor ts"]
[707.606034, "i", " in old.ordered_at:\n cand=(times.index[(starts<=ts)&(ends>ts)])\n idx.append(cand[0] if len(cand) else -1)\nold['txn_idx']=idx\nold['commit']=old.txn_idx.map(lambda i:R[i][3] if i>=0 else pd.NaT)\nassigned=old.groupby('txn_idx').size()\ncheck=pd.DataFrame({'rows':counts,'extract':assigned.reindex(range(len(R)),fill_value=0).values},index=range(len(R)))\nprint('old rows',len(old),'assigned',old.txn_idx.ge(0).sum(),'unassigned',old.txn_idx.lt(0).sum())\nprint('transactions',len(R),'exact count rows',int((check.rows==check.extract).sum()),'of',len(check))\nprint('sums',check.rows.sum(),check.extract.sum())\nprint('mismatches'); print(check[check.rows!=check.extract].head(20).to_string())\nprint('unique commits',old.commit.nunique(),'first',old.commit.min(),'last',old.commit.max())\nPY\npython /tmp/check_orders.py\n"]
[707.606074, "o", "cat > /tmp/check_orders.py <<'PY'\r\n"]
