[2772.798965, "i", "python - <<'PY'\nimport pandas as pd,json\nF=pd.read_parquet('/tmp/fixed.parquet')\nprint('shape',F.shape)\nprint('columns',list(F.columns))\nprint('nulls',F.isna().sum().to_dict())\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))]); L['as_of']=pd.to_datetime(L.as_of,utc=True)\nM=L.merge(F,on=['customer_id','as_of'],how='left',suffixes=('_live','_off'))\nfor f in [x for x in ['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','days_since_last_login','app_minutes_7d','te_district'] if x in F]:\n a=M[f+'_live']; b=M[f+'_off']\n try: bad=~(((a-b).abs()<=1e-6+1e-9*a.abs())|(a.isna()&b.isna()))\n except: bad=~((a==b)|(a.isna()&b.isna()))\n print(f,int(bad.sum()),'live null',int(a.isna().sum()),'off null',int(b.isna().sum()))\nPY\n"]
