[259.773494, "i", "python - <<'PY'\nimport pandas as pd,re,json,collections\nO=pd.read_csv('data/orders.csv'); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True)\nold=O[O._load_job.eq('legacy_backfill')].copy(); old['day']=old.ordered_at.dt.floor('D')\ncounts=old.groupby('day').size()\nsel={}; comm={int(json.loads(l)['txn']):json.loads(l) for l in open('data/_ops/commits.jsonl')}\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if z:\n  s,e,n,txn,table=z.groups(); x=comm[int(txn)]; sel[pd.Timestamp(s)]= (int(n),x)\nbad=0\nfor d,(n,x) in sel.items():\n actual=int(counts.get(d,0)); ok=(x['outcome']=='commit' and actual==n) or (x['outcome']=='rollback' and actual==0)\n bad += not ok\n if not ok: print('BAD',d,n,x,actual)\nprint('selection days',len(sel),'bad',bad,'extract old days',len(counts),'old rows',len(old))\nprint('rollbacks',[(str(d),n) for d,(n,x)"]
[259.773536, "i", " in sel.items() if x['outcome']=='rollback'][:30])\nprint('missing extract days',sorted(set(sel)-set(counts.index))[:20])\nPY\n"]
