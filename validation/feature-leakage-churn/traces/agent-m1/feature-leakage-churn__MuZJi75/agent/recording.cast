[3051.460585, "o", "\"\"\"Read the warehouse scheduler records used for point-in-time reconstruction.\"\"\"\r\nfrom dataclasses import dataclass\r\nimport heapq\r\nimport json\r\nimport os\r\nimport re\r\n\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\n"]
[3051.460647, "o", "\r\n@dataclass(frozen=True)\r\nclass OrderTxn:\r\n    start: pd.Timestamp\r\n    end: pd.Timestamp\r\n    rows: int\r\n    commit: pd.Timestamp\r\n    table: str\r\n"]
[3051.460688, "o", "    txn: int\r\n\r\n\r\n@dataclass\r\nclass Ops:\r\n    order_txns: list\r\n    schema_txns: list\r\n    rename_at: pd.Timestamp | None = None\r\n    legacy_orders_complete: bool = True\r\n\r\n\r\n_SELECT_RE = re.compile(\r\n    r\"selected\\s+orders\\s+where\\s+ordered_at\\s*>=\\s*(\\S+)\\s+\"\r\n    r\"and\\s+ordered_at\\s*<\\s*(\\S+):\\s*(\\d+)\\s+rows;\\s*\"\r\n    r\"sent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\"\r\n"]
[3051.460725, "o", ")\r\n_STATEMENT_RE = re.compile(r\"^statement:\\s*(.*)$\")\r\n_SEND_RE = re.compile(r\"\\bsent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\")\r\n_RENAME_RE = re.compile(r\"ALTER\\s+TABLE\\s+(\\S+)\\s+RENAME\\s+TO\\s+(\\S+)\", re.I)\r\n\r\n\r\n"]
[3051.460757, "o", "def _utc(value):\r\n    return pd.to_datetime(value, utc=True)\r\n\r\n\r\ndef _table_name(value):\r\n    return value.strip('\"`').split(\".\")[-1]\r\n\r\n\r\n"]
[3051.460775, "o", "def load_ops(data_dir):\r\n    commits = {}\r\n    path = os.path.join(data_dir, \"_ops\", \"commits.jsonl\")\r\n    if os.path.exists(path):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n"]
[3051.460833, "o", "            for line in fh:\r\n                if line.strip():\r\n                    row = json.loads(line)\r\n                    commits[int(row[\"txn\"])] = {\r\n                        \"at\": _utc(row[\"at\"]),\r\n                        \"outcome\": row.get(\"outcome\"),\r\n                        \"table\": row.get(\"table\"),\r\n                        \"rows\": row.get(\"rows\"),\r\n                    }\r\n\r\n    order_txns = []\r\n    schema_txns = []\r\n"]
[3051.460866, "o", "    statements = {}\r\n    with open(os.path.join(data_dir, \"_ops\", \"scheduler.log\"), encoding=\"utf-8\") as fh:\r\n        for line in fh:\r\n"]
[3051.460914, "o", "            parts = line.rstrip(\"\\n\").split(maxsplit=2)\r\n            if len(parts) != 3:\r\n                continue\r\n            job, message = parts[1], parts[2]\r\n\r\n            if message.startswith(\"state=running\"):\r\n                statements[job] = []\r\n                continue\r\n\r\n            match = _STATEMENT_RE.match(message)\r\n            if match:\r\n"]
[3051.46095, "o", "                statements.setdefault(job, []).append(match.group(1))\r\n                continue\r\n\r\n            match = _SELECT_RE.search(message)\r\n            if match:\r\n                start_s, end_s, rows, txn_s, table = match.groups()\r\n                txn = int(txn_s)\r\n"]
[3051.460986, "o", "                info = commits.get(txn, {})\r\n                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None:\r\n                    order_txns.append(OrderTxn(\r\n                        _utc(start_s), _utc(end_s), int(rows), info[\"at\"],\r\n                        _table_name(table or \"orders\"), txn,\r\n                    ))\r\n                statements[job] = []\r\n                continue\r\n"]
[3051.461036, "o", "\r\n            match = _SEND_RE.search(message)\r\n            if match:\r\n                txn = int(match.group(1))\r\n                info = commits.get(txn, {})\r\n"]
[3051.461077, "o", "                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None and statements.get(job):\r\n                    schema_txns.append({\r\n                        \"txn\": txn,\r\n                        \"at\": info[\"at\"],\r\n                        \"statements\": tuple(statements[job]),\r\n                    })\r\n                statements[job] = []\r\n\r\n    schema_txns.sort(key=lambda x: x[\"at\"])\r\n    names = {\"orders\": \"orders\"}\r\n    current_identity = names[\"orders\"]\r\n    rename_at = None\r\n    for txn in schema_txns:\r\n        for statement in txn[\"statements\"]:"]
[3051.461117, "o", "\r\n            match = _RENAME_RE.fullmatch(statement)\r\n            if not match:\r\n                continue\r\n"]
[3051.461152, "o", "            old_name, new_name = map(_table_name, match.groups())\r\n            names[new_name] = names.get(old_name, old_name)\r\n            if old_name != new_name:\r\n                names.pop(old_name, None)\r\n        if names.get(\"orders\") != current_identity:\r\n            if rename_at is None:\r\n                rename_at = txn[\"at\"]\r\n"]
[3051.461185, "o", "            current_identity = names.get(\"orders\")\r\n\r\n    return Ops(order_txns=order_txns, schema_txns=schema_txns, rename_at=rename_at)\r\n\r\n\r\ndef _seconds(values):\r\n    values = pd.to_datetime(pd.Series(values), utc=True)\r\n    valid = values.notna().to_numpy()\r\n    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n"]
[3051.461219, "o", "    return out, valid\r\n\r\n\r\ndef assign_legacy_order_commits(orders, ops, rename_at):\r\n    \"\"\"Assign old-generation commit times to orders from scheduler intervals.\r\n\r\n    After a failed load the next legacy load uses an expanding ordered_at interval."]
[3051.461252, "o", "\r\n    Thus the earliest successful transaction containing an order's timestamp is the\r\n    transaction that first committed it to the old ``orders`` generation.\r\n    \"\"\"\r\n    orders[\"_legacy_commit\"] = pd.NaT\r\n"]
[3051.461282, "o", "    ops.legacy_orders_complete = True\r\n    if rename_at is None:\r\n        return\r\n\r\n    records = [x for x in ops.order_txns\r\n"]
[3051.461312, "o", "               if x.table == \"orders\" and x.commit < rename_at]\r\n    if not records:\r\n        return\r\n    records.sort(key=lambda x: (x.start, x.commit, x.txn))\r\n\r\n"]
[3051.461346, "o", "    starts, _ = _seconds([x.start for x in records])\r\n    ends, _ = _seconds([x.end for x in records])\r\n    commit_secs, _ = _seconds([x.commit for x in records])\r\n    event_secs, event_valid = _seconds(orders[\"ordered_at\"])\r\n    if event_valid.any():\r\n        unique, inverse, counts = np.unique(event_secs[event_valid], return_inverse=True,\r\n                                            return_counts=True)"]
[3051.461378, "o", "\r\n        assigned = np.full(len(unique), -1, dtype=\"int64\")\r\n        active = []\r\n        pos = 0\r\n        for event_no, ts in enumerate(unique):\r\n            while pos < len(records) and starts[pos] <= ts:\r\n                heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))"]
[3051.461409, "o", "\r\n                pos += 1\r\n            while active and active[0][1] <= ts:\r\n                heapq.heappop(active)\r\n            if active:\r\n                assigned[event_no] = active[0][2]\r\n"]
[3051.46144, "o", "\r\n        txn_counts = np.zeros(len(records), dtype=\"int64\")\r\n        hit = assigned >= 0\r\n        if hit.any():\r\n            np.add.at(txn_counts, assigned[hit], counts[hit])\r\n        expected = np.asarray([x.rows for x in records], dtype=\"int64\")\r\n        ops.legacy_orders_complete = bool(np.array_equal(txn_counts, expected))"]
[3051.461471, "o", "\r\n\r\n        out = np.full(len(orders), np.iinfo(np.int64).min, dtype=\"int64\")\r\n        positions = np.flatnonzero(event_valid)\r\n        vals = assigned[inverse]\r\n"]
[3051.461502, "o", "        good = vals >= 0\r\n        out[positions[good]] = commit_secs[vals[good]]\r\n        result = pd.to_datetime(pd.Series(out, index=orders.index), unit=\"s\", utc=True)\r\n        orders[\"_legacy_commit\"] = result.where(out != np.iinfo(np.int64).min, pd.NaT)\r\n"]
