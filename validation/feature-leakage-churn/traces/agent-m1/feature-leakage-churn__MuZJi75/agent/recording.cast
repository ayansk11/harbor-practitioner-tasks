[1005.33801, "i", "python - <<'PY'\nimport pandas as pd\nP=pd.read_csv('data/scoring_points.csv'); P['as_of']=pd.to_datetime(P.as_of,utc=True)\nC=pd.read_csv('data/customers.csv'); C['_updated_at']=pd.to_datetime(C._updated_at,utc=True)\nPC=pd.read_csv('data/plan_changes.csv'); PC['_loaded_at']=pd.to_datetime(PC._loaded_at,utc=True); PC['changed_at']=pd.to_datetime(PC.changed_at,utc=True)\n# Per point: latest visible plan change, otherwise final plan only if the customer row had not been updated after t.\ncount_unknown=0; count_from_customer=0; count_from_change=0\nexamples=[]\npc_by=PC.groupby('customer_id',sort=False)\nfor row in P.itertuples():\n    try: q=pc_by.get_group(row.customer_id)\n    except KeyError: q=PC.iloc[:0]\n    visible=q[q._loaded_at<row.as_of]\n    c=C.loc[C.customer_id.eq(row.customer_id).idxmax()]\n    if len(visible):\n        count_from_change+=1\n    elif c._updated_at<row.as_of:\n        count_from_customer+=1\n    else:\n        count_unknown+=1\n        if len(examples)<10: examples.append((row.customer_id,row.as_of,c"]
[1005.338153, "i", ".plan,c._updated_at,len(q)))\nprint('points',len(P),'from visible change',count_from_change,'from unchanged customer row',count_from_customer,'unknown',count_unknown)\nprint('examples')\nfor x in examples: print(x)\nprint('first points by customer with unknown?')\nprint(P.merge(C[['customer_id','_updated_at']],on='customer_id').query('_updated_at >= as_of').sort_values('as_of')[['customer_id','as_of','_updated_at']].head(10).to_string(index=False))\nPY\n"]
