[1875.579439, "o", "    point_secs = point_secs[point_positions]\r\n\u001b[?2004l\r"]
[1875.579456, "o", "\u001b[?2004h"]
[1875.579477, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.579496, "o", "> "]
[1875.579622, "o", "    customer_ids = customers[\"customer_id\"]\r\n\u001b[?2004l\r"]
[1875.579634, "o", "\u001b[?2004h> "]
[1875.579748, "o", "    signup = customers[\"signup_at\"]\r\n\u001b[?2004l\r"]
[1875.579781, "o", "\u001b[?2004h"]
[1875.579792, "o", "> "]
[1875.579965, "o", "    district = customers[\"postcode_district\"].astype(\"object\")\r\n\u001b[?2004l\r"]
[1875.579974, "o", "\u001b[?2004h> "]
[1875.580089, "o", "    lab_ids = labels[\"customer_id\"]\r\n\u001b[?2004l\r"]
[1875.580115, "o", "\u001b[?2004h> "]
[1875.580302, "o", "    point_ids = points[\"customer_id\"].iloc[point_positions]\r\n\u001b[?2004l\r"]
[1875.58034, "o", "\u001b[?2004h> "]
[1875.580511, "o", "    all_ids = pd.concat([lab_ids, point_ids], ignore_index=True)\r\n\u001b[?2004l\r"]
[1875.580531, "o", "\u001b[?2004h> "]
[1875.580684, "o", "    codes, unique = pd.factorize(all_ids, sort=True)\r\n\u001b[?2004l\r"]
[1875.580703, "o", "\u001b[?2004h> "]
[1875.580907, "o", "    lab_codes = np.asarray(codes[: len(labels)], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.580931, "o", "\u001b[?2004h> "]
[1875.581123, "o", "    point_codes = np.asarray(codes[len(labels) :], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.581139, "o", "\u001b[?2004h> "]
[1875.581305, "o", "    unique_ids = np.asarray(unique, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.581324, "o", "\u001b[?2004h"]
[1875.581358, "o", "> "]
[1875.581604, "o", "    id_to_customer = pd.Series(np.arange(len(customers), dtype=\"int64\"), index=customer_ids)\r\n\u001b[?2004l\r"]
[1875.581627, "o", "\u001b[?2004h> "]
[1875.581879, "o", "    customer_index = id_to_customer.reindex(unique_ids).to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1875.581909, "o", "\u001b[?2004h> "]
[1875.582048, "o", "    has_customer = np.isfinite(customer_index)\r\n\u001b[?2004l\r"]
[1875.582069, "o", "\u001b[?2004h> "]
[1875.582306, "o", "    customer_index = np.where(has_customer, customer_index, 0).astype(\"int64\")\r\n\u001b[?2004l\r"]
[1875.582324, "o", "\u001b[?2004h"]
[1875.58234, "o", "> \r\n\u001b[?2004l\r"]
[1875.582363, "o", "\u001b[?2004h> "]
[1875.582729, "o", "    lab_district = district.iloc[np.where(has_customer[: len(labels)], customer_index[: len(labels)], 0)].to_numpy(dtype=object)\r\n\u001b[?2004l\r"]
[1875.582747, "o", "\u001b[?2004h> "]
[1875.582982, "o", "    lab_district = np.where(has_customer[: len(labels)], lab_district, None)\r\n\u001b[?2004l\r"]
[1875.583, "o", "\u001b[?2004h"]
[1875.583016, "o", "> "]
[1875.583369, "o", "    pt_district = district.iloc[np.where(has_customer[len(labels):], customer_index[len(labels):], 0)].to_numpy(dtype=object)\r\n\u001b[?2004l\r"]
[1875.583385, "o", "\u001b[?2004h> "]
[1875.583608, "o", "    pt_district = np.where(has_customer[len(labels):], pt_district, None)\r\n\u001b[?2004l\r"]
[1875.583623, "o", "\u001b[?2004h> "]
[1875.583644, "o", "\r\n\u001b[?2004l\r"]
[1875.58366, "o", "\u001b[?2004h> "]
[1875.583757, "o", "    district_values = pd.concat([\r\n\u001b[?2004l\r"]
[1875.583776, "o", "\u001b[?2004h> "]
[1875.583929, "o", "        pd.Series(lab_district, dtype=\"object\"),\r\n\u001b[?2004l\r"]
[1875.583951, "o", "\u001b[?2004h> "]
[1875.58409, "o", "        pd.Series(pt_district, dtype=\"object\"),\r\n\u001b[?2004l\r"]
[1875.58411, "o", "\u001b[?2004h> "]
[1875.584197, "o", "    ], ignore_index=True)\r\n\u001b[?2004l\r"]
[1875.584215, "o", "\u001b[?2004h"]
[1875.584233, "o", "> "]
[1875.584441, "o", "    district_codes, _ = pd.factorize(district_values, use_na_sentinel=True)\r\n\u001b[?2004l\r"]
[1875.584458, "o", "\u001b[?2004h"]
[1875.584476, "o", "> "]
[1875.584686, "o", "    lab_district = np.asarray(district_codes[: len(labels)], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.584707, "o", "\u001b[?2004h> "]
[1875.58493, "o", "    pt_district = np.asarray(district_codes[len(labels):], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.58495, "o", "\u001b[?2004h> "]
[1875.585148, "o", "    pt_district = np.where(pt_district >= 0, pt_district, -999999)\r\n\u001b[?2004l\r"]
[1875.585165, "o", "\u001b[?2004h> "]
[1875.58518, "o", "\r\n\u001b[?2004l\r"]
[1875.585202, "o", "\u001b[?2004h> "]
[1875.585396, "o", "    lab_commit, lab_commit_valid = _seconds(labels[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[1875.585414, "o", "\u001b[?2004h> "]
[1875.585666, "o", "    lab_signup_secs = np.full(len(labels), np.iinfo(np.int64).max, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.585687, "o", "\u001b[?2004h> "]
[1875.585835, "o", "    visible_customer = has_customer[: len(labels)]\r\n\u001b[?2004l\r"]
[1875.585852, "o", "\u001b[?2004h> "]
[1875.585958, "o", "    if visible_customer.any():\r\n\u001b[?2004l\r"]
[1875.585974, "o", "\u001b[?2004h> "]
[1875.586254, "o", "        secs, valid = _seconds(signup.iloc[customer_index[: len(labels)][visible_customer]])\r\n\u001b[?2004l\r"]
[1875.586274, "o", "\u001b[?2004h> "]
[1875.58654, "o", "        lab_signup_secs[visible_customer] = np.where(valid, secs, np.iinfo(np.int64).max)\r\n\u001b[?2004l\r"]
[1875.586561, "o", "\u001b[?2004h> "]
[1875.586797, "o", "    lab_commit = np.where(lab_commit_valid, lab_commit, np.iinfo(np.int64).max)\r\n\u001b[?2004l\r"]
[1875.586826, "o", "\u001b[?2004h> "]
[1875.586998, "o", "    eligibility = np.maximum(lab_commit, lab_signup_secs)\r\n\u001b[?2004l\r"]
[1875.587016, "o", "\u001b[?2004h"]
[1875.587033, "o", "> \r\n\u001b[?2004l\r"]
[1875.587052, "o", "\u001b[?2004h> "]
[1875.58733, "o", "    y_values = pd.to_numeric(labels[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1875.587367, "o", "\u001b[?2004h> "]
[1875.587543, "o", "    label_order = np.argsort(eligibility, kind=\"mergesort\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.587576, "o", "> "]
[1875.587687, "o", "    eligibility = eligibility[label_order]\r\n\u001b[?2004l\r"]
[1875.58771, "o", "\u001b[?2004h> "]
[1875.587843, "o", "    lab_district = lab_district[label_order]\r\n\u001b[?2004l\r"]
[1875.58786, "o", "\u001b[?2004h> "]
[1875.587982, "o", "    y_values = y_values[label_order]\r\n\u001b[?2004l\r"]
[1875.588002, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.58802, "o", "\u001b[?2004h> "]
[1875.588195, "o", "    point_codes = np.asarray(point_codes, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.588212, "o", "\u001b[?2004h> "]
[1875.588384, "o", "    pt_district = np.asarray(pt_district, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.588399, "o", "\u001b[?2004h> "]
[1875.588581, "o", "    point_order = np.argsort(point_secs, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[1875.5886, "o", "\u001b[?2004h> "]
[1875.588693, "o", "    global_n = global_sum = 0\r\n\u001b[?2004l\r"]
[1875.588711, "o", "\u001b[?2004h> "]
[1875.588776, "o", "    district_n = {}\r\n\u001b[?2004l\r"]
[1875.588792, "o", "\u001b[?2004h> "]
[1875.588866, "o", "    district_sum = {}\r\n\u001b[?2004l\r"]
[1875.588889, "o", "\u001b[?2004h"]
[1875.588906, "o", "> "]
[1875.588943, "o", "    label_i = 0\r\n\u001b[?2004l\r"]
[1875.588958, "o", "\u001b[?2004h> "]
[1875.58912, "o", "    for q, original in enumerate(point_positions):\r\n\u001b[?2004l\r"]
[1875.589138, "o", "\u001b[?2004h> "]
[1875.589232, "o", "        t = int(point_secs[q])\r\n\u001b[?2004l\r"]
[1875.589265, "o", "\u001b[?2004h> "]
[1875.58937, "o", "        code = int(point_codes[q])\r\n\u001b[?2004l\r"]
[1875.589389, "o", "\u001b[?2004h> "]
[1875.589486, "o", "        own = int(pt_district[q])\r\n\u001b[?2004l\r"]
[1875.589503, "o", "\u001b[?2004h> "]
[1875.589724, "o", "        while label_i < len(eligibility) and eligibility[label_i] < t:\r\n\u001b[?2004l\r"]
[1875.589742, "o", "\u001b[?2004h> "]
[1875.590009, "o", "            y = float(y_values[label_i]) if np.isfinite(y_values[label_i]) else np.nan\r\n\u001b[?2004l\r"]
[1875.590028, "o", "\u001b[?2004h"]
[1875.590046, "o", "> "]
[1875.590124, "o", "            if np.isfinite(y):\r\n\u001b[?2004l\r"]
[1875.590142, "o", "\u001b[?2004h> "]
[1875.590239, "o", "                global_n += 1\r\n\u001b[?2004l\r"]
[1875.590262, "o", "\u001b[?2004h> "]
[1875.590377, "o", "                global_sum += int(y)\r\n\u001b[?2004l\r"]
[1875.590395, "o", "\u001b[?2004h> "]
[1875.59055, "o", "            district = int(lab_district[label_i])\r\n\u001b[?2004l\r"]
[1875.590567, "o", "\u001b[?2004h"]
[1875.590586, "o", "> "]
[1875.59077, "o", "            district_n[district] = district_n.get(district, 0) + 1\r\n\u001b[?2004l\r"]
[1875.590788, "o", "\u001b[?2004h> "]
[1875.591101, "o", "            district_sum[district] = district_sum.get(district, 0) + (int(y) if np.isfinite(y) else 0)\r\n\u001b[?2004l\r"]
[1875.591117, "o", "\u001b[?2004h"]
[1875.591141, "o", "> "]
[1875.591199, "o", "            label_i += 1\r\n\u001b[?2004l\r"]
[1875.591217, "o", "\u001b[?2004h> "]
[1875.591236, "o", "\r\n\u001b[?2004l\r"]
[1875.591256, "o", "\u001b[?2004h> "]
[1875.591547, "o", "        if code < 0 or not np.isfinite(customer_index[unique.searchsorted(code)] if False else 1.0):\r\n\u001b[?2004l\r"]
[1875.591564, "o", "\u001b[?2004h> "]
[1875.591632, "o", "            continue\r\n\u001b[?2004l\r"]
[1875.591652, "o", "\u001b[?2004h> "]
[1875.591916, "o", "        # A customer row missing from the warehouse yields no row from CROSS JOIN own.\r\n\u001b[?2004l\r"]
[1875.591954, "o", "\u001b[?2004h> "]
[1875.592088, "o", "        if not has_customer[len(labels) + q]:\r\n\u001b[?2004l\r"]
[1875.592111, "o", "\u001b[?2004h"]
[1875.59213, "o", "> "]
[1875.592174, "o", "            continue\r\n\u001b[?2004l\r"]
[1875.59219, "o", "\u001b[?2004h"]
[1875.592209, "o", "> "]
[1875.592319, "o", "        same_n = district_n.get(own, 0)\r\n\u001b[?2004l\r"]
[1875.592341, "o", "\u001b[?2004h> "]
[1875.592478, "o", "        same_sum = district_sum.get(own, 0)\r\n\u001b[?2004l\r"]
[1875.592511, "o", "\u001b[?2004h"]
[1875.592532, "o", "> "]
[1875.592677, "o", "        prior = global_sum / global_n if global_n else 0.05\r\n\u001b[?2004l\r"]
[1875.592703, "o", "\u001b[?2004h> "]
[1875.59292, "o", "        out[original] = (same_sum + 20.0 * prior) / (same_n + 20.0)\r\n\u001b[?2004l\r"]
[1875.592946, "o", "\u001b[?2004h> "]
[1875.592982, "o", "    return out\r\n\u001b[?2004l\r"]
[1875.593004, "o", "\u001b[?2004h> "]
[1875.593024, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.593043, "o", "> \r\n\u001b[?2004l\r"]
[1875.593059, "o", "\u001b[?2004h> "]
[1875.593116, "o", "def app_minutes(points):\r\n\u001b[?2004l\r"]
[1875.593137, "o", "\u001b[?2004h"]
[1875.593154, "o", "> "]
[1875.593351, "o", "    order = np.lexsort((points[\"as_of\"].to_numpy(), points[\"customer_id\"].to_numpy()))\r\n\u001b[?2004l\r"]
[1875.593375, "o", "\u001b[?2004h> "]
[1875.593491, "o", "    ordered = points[\"app_minutes_7d\"].iloc[order]\r\n\u001b[?2004l\r"]
[1875.593526, "o", "\u001b[?2004h> "]
[1875.593696, "o", "    filled = ordered.groupby(points[\"customer_id\"].iloc[order]).ffill()\r\n\u001b[?2004l\r"]
[1875.593715, "o", "\u001b[?2004h> "]
[1875.59385, "o", "    out = np.full(len(points), np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1875.59387, "o", "\u001b[?2004h> "]
[1875.594005, "o", "    out[order] = filled.to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1875.59402, "o", "\u001b[?2004h> "]
[1875.594064, "o", "    return out\r\n\u001b[?2004l\r"]
[1875.59408, "o", "\u001b[?2004h> "]
[1875.594089, "o", "\r\n\u001b[?2004l\r"]
[1875.594118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.594131, "o", "\u001b[?2004h"]
[1875.594145, "o", "> "]
[1875.594271, "o", "def customer_features(points, customers, plan_changes):\r\n\u001b[?2004l\r"]
[1875.594286, "o", "\u001b[?2004h> "]
[1875.594494, "o", "    \"\"\"Build customer-record features when, and only when, every value is known.\"\"\"\r\n\u001b[?2004l\r"]
[1875.594509, "o", "\u001b[?2004h> "]
[1875.594565, "o", "    n = len(points)\r\n\u001b[?2004l\r"]
[1875.59458, "o", "\u001b[?2004h> "]
[1875.594691, "o", "    plan = np.full(n, None, dtype=object)\r\n\u001b[?2004l\r"]
[1875.594719, "o", "\u001b[?2004h> "]
[1875.594842, "o", "    login_days = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[1875.594866, "o", "\u001b[?2004h"]
[1875.594888, "o", "> "]
[1875.594974, "o", "    plan_known = np.zeros(n, dtype=\"bool\")\r\n\u001b[?2004l\r"]
[1875.594998, "o", "\u001b[?2004h> "]
[1875.595104, "o", "    login_known = np.zeros(n, dtype=\"bool\")\r\n\u001b[?2004l\r"]
[1875.595121, "o", "\u001b[?2004h"]
[1875.595128, "o", "> \r\n\u001b[?2004l\r"]
[1875.59515, "o", "\u001b[?2004h> "]
[1875.595311, "o", "    customer_by_id = customers.set_index(\"customer_id\", drop=False)\r\n\u001b[?2004l\r"]
[1875.595331, "o", "\u001b[?2004h"]
[1875.595349, "o", "> "]
[1875.595494, "o", "    final_plan = points[\"customer_id\"].map(customer_by_id[\"plan\"])\r\n\u001b[?2004l\r"]
[1875.595515, "o", "\u001b[?2004h"]
[1875.595538, "o", "> "]
[1875.595702, "o", "    final_login = points[\"customer_id\"].map(customer_by_id[\"last_login_at\"])\r\n\u001b[?2004l\r"]
[1875.59572, "o", "\u001b[?2004h"]
[1875.595737, "o", "> "]
[1875.595917, "o", "    final_updated = points[\"customer_id\"].map(customer_by_id[\"_updated_at\"])\r\n\u001b[?2004l\r"]
[1875.595943, "o", "\u001b[?2004h> "]
[1875.596122, "o", "    final_signup = points[\"customer_id\"].map(customer_by_id[\"signup_at\"])\r\n\u001b[?2004l\r"]
[1875.59613, "o", "\u001b[?2004h"]
[1875.596157, "o", "> "]
[1875.596331, "o", "    no_changes = ~points[\"customer_id\"].isin(set(plan_changes[\"customer_id\"]))\r\n\u001b[?2004l\r"]
[1875.596358, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.596375, "o", "\u001b[?2004h"]
[1875.596397, "o", "> "]
[1875.596564, "o", "    plan_commit, plan_commit_valid = _seconds(plan_changes[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[1875.596587, "o", "\u001b[?2004h"]
[1875.5966, "o", "> "]
[1875.59677, "o", "    plan_changed, changed_valid = _seconds(plan_changes[\"changed_at\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.596817, "o", "> "]
[1875.596896, "o", "    valid = plan_commit_valid & changed_valid\r\n\u001b[?2004l\r"]
[1875.59692, "o", "\u001b[?2004h> "]
[1875.597098, "o", "    changes = plan_changes.loc[valid, [\"customer_id\", \"new_plan\"]].copy()\r\n\u001b[?2004l\r"]
[1875.597119, "o", "\u001b[?2004h> "]
[1875.597223, "o", "    changes[\"commit\"] = plan_commit[valid]\r\n\u001b[?2004l\r"]
[1875.597243, "o", "\u001b[?2004h"]
[1875.597262, "o", "> "]
[1875.597352, "o", "    changes[\"changed\"] = plan_changed[valid]\r\n\u001b[?2004l\r"]
[1875.597371, "o", "\u001b[?2004h"]
[1875.597393, "o", "> "]
[1875.597521, "o", "    changes = changes.sort_values(\"commit\", kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[1875.597542, "o", "\u001b[?2004h> "]
[1875.597793, "o", "    change_commit = changes[\"commit\"].to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n\u001b[?2004l\r"]
[1875.597817, "o", "\u001b[?2004h> "]
[1875.598077, "o", "    change_changed = changes[\"changed\"].to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n\u001b[?2004l\r"]
[1875.598086, "o", "\u001b[?2004h"]
[1875.598108, "o", "> "]
[1875.598232, "o", "    change_ids = changes[\"customer_id\"].to_numpy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.598256, "o", "> "]
[1875.598389, "o", "    change_plan = changes[\"new_plan\"].to_numpy(dtype=object)\r\n\u001b[?2004l\r"]
[1875.598411, "o", "\u001b[?2004h> "]
[1875.598434, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1875.598576, "o", "    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[1875.5986, "o", "\u001b[?2004h> "]
[1875.598722, "o", "    point_positions = np.flatnonzero(point_valid)\r\n\u001b[?2004l\r"]
[1875.598746, "o", "\u001b[?2004h> "]
[1875.598895, "o", "    point_codes, change_codes, unique_ids = _factorize_ids(\r\n\u001b[?2004l\r"]
[1875.598918, "o", "\u001b[?2004h> "]
[1875.599101, "o", "        points[\"customer_id\"].iloc[point_positions], changes[\"customer_id\"],\r\n\u001b[?2004l\r"]
[1875.599124, "o", "\u001b[?2004h> "]
[1875.599144, "o", "    )\r\n\u001b[?2004l\r"]
[1875.599161, "o", "\u001b[?2004h"]
[1875.599178, "o", "> "]
[1875.599301, "o", "    point_codes = np.asarray(point_codes, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.59932, "o", "\u001b[?2004h"]
[1875.599337, "o", "> "]
[1875.599463, "o", "    change_codes = np.asarray(change_codes, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[1875.599496, "o", "\u001b[?2004h> "]
[1875.599583, "o", "    unique_ids = np.asarray(unique_ids)\r\n\u001b[?2004l\r"]
[1875.599601, "o", "\u001b[?2004h"]
[1875.599622, "o", "> "]
[1875.599786, "o", "    point_order = np.argsort(point_secs[point_positions], kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[1875.599809, "o", "\u001b[?2004h> "]
[1875.59985, "o", "    current = {}\r\n\u001b[?2004l\r"]
[1875.599876, "o", "\u001b[?2004h> "]
[1875.599919, "o", "    change_i = 0\r\n\u001b[?2004l\r"]
[1875.599935, "o", "\u001b[?2004h> "]
[1875.600004, "o", "    for q in point_order:\r\n\u001b[?2004l\r"]
[1875.60003, "o", "\u001b[?2004h> "]
[1875.600132, "o", "        original = int(point_positions[q])\r\n\u001b[?2004l\r"]
[1875.600156, "o", "\u001b[?2004h> "]
[1875.600245, "o", "        t = int(point_secs[original])\r\n\u001b[?2004l\r"]
[1875.60027, "o", "\u001b[?2004h> "]
[1875.600352, "o", "        code = int(point_codes[q])\r\n\u001b[?2004l\r"]
[1875.600378, "o", "\u001b[?2004h> "]
[1875.600503, "o", "        cid = unique_ids[code] if code >= 0 else None\r\n\u001b[?2004l\r"]
[1875.600523, "o", "\u001b[?2004h> "]
[1875.600833, "o", "        exists = pd.notna(final_signup.iloc[original]) and point_secs[original] > _seconds([final_signup.iloc[original]])[0][0]\r\n\u001b[?2004l\r"]
[1875.600854, "o", "\u001b[?2004h"]
[1875.600871, "o", "> "]
[1875.601042, "o", "        while change_i < len(change_commit) and change_commit[change_i] < t:\r\n\u001b[?2004l\r"]
[1875.601063, "o", "\u001b[?2004h"]
[1875.601079, "o", "> "]
[1875.601179, "o", "            ccode = int(change_codes[change_i])\r\n\u001b[?2004l\r"]
[1875.6012, "o", "\u001b[?2004h> "]
[1875.601337, "o", "            changed = int(change_changed[change_i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.601374, "o", "> "]
[1875.601516, "o", "            if ccode not in current or changed >= current[ccode][0]:\r\n\u001b[?2004l\r"]
[1875.601536, "o", "\u001b[?2004h"]
[1875.601558, "o", "> "]
[1875.601697, "o", "                current[ccode] = (changed, change_plan[change_i])\r\n\u001b[?2004l\r"]
[1875.601717, "o", "\u001b[?2004h"]
[1875.601736, "o", "> "]
[1875.601781, "o", "            change_i += 1\r\n\u001b[?2004l\r"]
[1875.601805, "o", "\u001b[?2004h> "]
[1875.601822, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1875.601839, "o", "> "]
[1875.601893, "o", "        if not exists:\r\n\u001b[?2004l\r"]
[1875.601966, "o", "\u001b[?2004h> "]
[1875.602101, "o", "            plan_known[original] = login_known[original] = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1875.602158, "o", "            continue\r\n\u001b[?2004l\r"]
[1875.602178, "o", "\u001b[?2004h> "]
[1875.602432, "o", "        if pd.notna(final_updated.iloc[original]) and _seconds([final_updated.iloc[original]])[0][0] < t:\r\n\u001b[?2004l\r"]
[1875.602464, "o", "\u001b[?2004h> "]
[1875.602587, "o", "            plan[original] = final_plan.iloc[original]\r\n\u001b[?2004l\r"]
[1875.602614, "o", "\u001b[?2004h> "]
[1875.602705, "o", "            plan_known[original] = True\r\n\u001b[?2004l\r"]
[1875.602729, "o", "\u001b[?2004h> "]
[1875.602992, "o", "            if pd.notna(final_login.iloc[original]) and _seconds([final_login.iloc[original]])[0][0] < t:\r\n\u001b[?2004l\r"]
[1875.60302, "o", "\u001b[?2004h"]
[1875.603039, "o", "> "]
[1875.603256, "o", "                login_days[original] = (t - _seconds([final_login.iloc[original]])[0][0]) / 86400.0\r\n\u001b[?2004l\r"]
[1875.603287, "o", "\u001b[?2004h"]
[1875.60331, "o", "> "]
[1875.603377, "o", "            login_known[original] = True\r\n\u001b[?2004l\r"]
[1875.603399, "o", "\u001b[?2004h> "]
[1875.603451, "o", "            continue\r\n\u001b[?2004l\r"]
[1875.603472, "o", "\u001b[?2004h> "]
[1875.603575, "o", "        if code >= 0 and code in current:\r\n\u001b[?2004l\r"]
[1875.603598, "o", "\u001b[?2004h> "]
[1875.603709, "o", "            plan[original] = current[code][1]\r\n\u001b[?2004l\r"]
[1875.603738, "o", "\u001b[?2004h> "]
[1875.603827, "o", "            plan_known[original] = True\r\n\u001b[?2004l\r"]
[1875.603851, "o", "\u001b[?2004h> "]
[1875.603953, "o", "        elif no_changes.iloc[original]:\r\n\u001b[?2004l\r"]
[1875.603981, "o", "\u001b[?2004h> "]
[1875.604108, "o", "            plan[original] = final_plan.iloc[original]\r\n\u001b[?2004l\r"]
[1875.604137, "o", "\u001b[?2004h> "]
[1875.604229, "o", "            plan_known[original] = True\r\n\u001b[?2004l\r"]
[1875.604249, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1875.60427, "o", "\u001b[?2004h> "]
[1875.604372, "o", "    keep_plan = bool(plan_known.all())\r\n\u001b[?2004l\r"]
[1875.60439, "o", "\u001b[?2004h"]
[1875.604409, "o", "> "]
[1875.604495, "o", "    keep_login = bool(login_known.all())\r\n\u001b[?2004l\r"]
[1875.604522, "o", "\u001b[?2004h> "]
[1875.60476, "o", "    return plan if keep_plan else None, login_days if keep_login else None, keep_plan, keep_login\r\n\u001b[?2004l\r"]
[1875.604788, "o", "\u001b[?2004h> "]
[1875.604811, "o", "PY\r\n\u001b[?2004l\r"]
[1875.606786, "o", "\u001b[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# "]
[1876.266657, "i", "cat > churn/build_features.py <<'PY'\n\"\"\"Build the live-equivalent feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\nimport argparse\nimport os\n\nfrom churn.extract import load_extract\nfrom churn.live_features import (\n    app_minutes,\n    customer_features,\n    order_features,\n    status_features,\n    target_encoding,\n    ticket_features,\n)\nfrom churn.ops import assign_legacy_order_commits, load_ops\n\n\nBASE_COLUMNS = [\"customer_id\", \"as_of\"]\nLIVE_FEATURES = [\n    \"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\",\n    \"days_since_last_order\", \"tenure_days\", \"status\", \"plan\",\n    \"days_since_last_login\", \"app_minutes_7d\", \"te_district\",\n]\n\n\ndef build(data_dir):\n    tables = load_extract(data_dir)\n    points = tables[\"scoring_points\"].reset_index(drop=True)\n    customers = tables[\"customers\"]\n    orders = tables[\"orders\"].copy()\n    tickets = tables[\"tickets\"]\n    snapshots = tables[\"status_snapshots\"]\n    labels = tables[\"labels\"]\n    plan_changes = tables[\"plan_changes\"]"]
[1876.266748, "i", "\n\n    ops = load_ops(data_dir)\n    assign_legacy_order_commits(orders, ops, ops.rename_at)\n\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n    values, orders_known = order_features(\n        points, orders, ops.rename_at, ops.legacy_orders_complete,\n    )\n    if orders_known:\n        out[\"orders_7d\"] = values[\"orders_7d\"]\n        out[\"orders_30d\"] = values[\"orders_30d\"]\n        out[\"spend_30d_cents\"] = values[\"spend_30d_cents\"]\n        out[\"days_since_last_order\"] = values[\"days_since_last_order\"]\n\n    out[\"tickets_30d\"] = ticket_features(points, tickets)\n\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\n    tenure = (points[\"as_of\"] - signup).dt.total_seconds() / 86400.0\n    exists = signup.notna() & (signup < points[\"as_of\"])\n    out[\"tenure_days\"] = tenure.where(exists)\n\n    out[\"status\"] = status_features(points, snapshots)\n    plan, login, keep_plan, keep_login = customer_features(points, customers, plan_changes)\n    if keep_plan:\n        out[\"plan\"] = plan\n    if"]
[1876.266774, "i", " keep_login:\n        out[\"days_since_last_login\"] = login\n    out[\"app_minutes_7d\"] = app_minutes(points)\n    out[\"te_district\"] = target_encoding(points, labels, customers)\n\n    kept = [f for f in LIVE_FEATURES if f in out.columns]\n    return out[BASE_COLUMNS + kept]\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    args = ap.parse_args()\n    features = build(args.data)\n    out_path = os.path.abspath(args.out)\n    os.makedirs(os.path.dirname(out_path), exist_ok=True)\n    features.to_parquet(out_path, index=False)\n    print(f\"wrote {len(features)} rows x {features.shape[1]} columns to {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\nPY\npython -m py_compile churn/*.py\n"]
