[3250.048428, "i", ")\n\n\ndef _seconds(values):\n    values = pd.to_datetime(pd.Series(values), utc=True)\n    valid = values.notna().to_numpy()\n    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\n    return out, valid\n\n\ndef assign_legacy_order_commits(orders, ops, rename_at):\n    \"\"\"Assign old-generation commit times to orders from scheduler intervals.\n\n    A rolled-back legacy load is retried with an expanding ordered_at interval, so\n    the earliest successful transaction containing an order timestamp is the load\n    that first committed it to the old ``orders`` table.  Exact transaction counts\n    are checked before the result is considered complete.\n    \"\"\"\n    orders[\"_legacy_commit\"] = pd.NaT\n    ops.legacy_orders_complete = True\n    if rename_at is None:\n        return\n\n    records = [x for x in ops.order_txns\n               if x.table == \"orders\" and x.commit < rename_at]\n    if not records:\n        return\n    records.sort(key=lambda x: (x.start, x.commit, x.txn))\n\n    starts, _ = _seconds([x."]
