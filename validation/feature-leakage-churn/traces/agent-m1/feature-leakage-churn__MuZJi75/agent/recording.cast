[1875.539203, "i", "\r    return values[\"count_30\"]\r\r\rdef status_features(points, snapshots):\r    n = len(points)\r    out = np.full(n, None, dtype=object)\r    point_secs, point_valid = _seconds(points[\"as_of\"])\r    point_positions = np.flatnonzero(point_valid)\r    if not len(point_positions):\r        return out\r\r    snap_secs, snap_valid = _seconds(snapshots[\"_loaded_at\"])\r    snap_dates, date_valid = _seconds(snapshots[\"snapshot_date\"])\r    snap_mask = snap_valid & date_valid\r    snap_positions = np.flatnonzero(snap_mask)\r    snap_secs = snap_secs[snap_positions]\r    snap_dates = snap_dates[snap_positions]\r    statuses = snapshots[\"status\"].to_numpy(dtype=object)[snap_positions]\r\r    point_codes, snap_codes, _ = _factorize_ids(\r        points[\"customer_id\"].iloc[point_positions],\r        snapshots[\"customer_id\"].iloc[snap_positions],\r    )\r    point_codes = np.asarray(point_codes, dtype=\"int64\")\r    snap_codes = np.asarray(snap_codes, dtype=\"int64\")\r    snap_order = np.argsort(snap_secs, kind=\"mergesort\")\r    snap_secs = snap_se"]
