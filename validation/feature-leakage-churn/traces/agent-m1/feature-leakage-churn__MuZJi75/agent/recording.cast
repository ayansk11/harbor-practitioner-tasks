[2368.147047, "i", "cat > /tmp/rewrite_te.py <<'PY'\np='churn/live_features.py'\ns=open(p).read()\nstart=s.index('def target_encoding(')\nend=s.index('\\n\\ndef app_minutes(', start)\nnew=r'''def target_encoding(points, labels, customers):\n    \"\"\"Live district target encoding over labels and customers visible at t.\"\"\"\n    n = len(points)\n    out = np.full(n, np.nan, dtype=\"float64\")\n    point_secs, point_valid = _seconds(points[\"as_of\"])\n    point_positions = np.flatnonzero(point_valid)\n    if not len(point_positions):\n        return out\n    point_secs = point_secs[point_positions]\n\n    # Factorize all customer IDs once, then map each unique ID to a customer row.\n    lab_ids = labels[\"customer_id\"]\n    point_ids = points[\"customer_id\"].iloc[point_positions]\n    all_ids = pd.concat([lab_ids, point_ids], ignore_index=True)\n    row_codes, unique_ids = pd.factorize(all_ids, sort=True)\n    lab_codes = np.asarray(row_codes[: len(labels)], dtype=\"int64\")\n    point_codes = np.asarray(row_codes[len(labels):], dtype=\"int64\")\n    unique_ids = np."]
[2368.147144, "i", "asarray(unique_ids)\n\n    id_to_customer = pd.Series(np.arange(len(customers), dtype=\"int64\"),\n                               index=customers[\"customer_id\"])\n    unique_customer = id_to_customer.reindex(unique_ids).to_numpy(dtype=\"float64\")\n    unique_has_customer = np.isfinite(unique_customer)\n    unique_customer_index = np.where(unique_has_customer, unique_customer, 0).astype(\"int64\")\n\n    lab_customer_index = unique_customer_index[lab_codes]\n    lab_has_customer = unique_has_customer[lab_codes]\n    pt_customer_index = unique_customer_index[point_codes]\n    pt_has_customer = unique_has_customer[point_codes]\n\n    districts = customers[\"postcode_district\"].astype(\"object\").to_numpy()\n    lab_district = np.where(lab_has_customer, districts[lab_customer_index], None)\n    pt_district = np.where(pt_has_customer, districts[pt_customer_index], None)\n    district_values = pd.concat([\n        pd.Series(lab_district, dtype=\"object\"),\n        pd.Series(pt_district, dtype=\"object\"),\n    ], ignore_index=True)\n    district"]
[2368.147191, "i", "_codes, _ = pd.factorize(district_values, use_na_sentinel=True)\n    lab_district = np.asarray(district_codes[: len(labels)], dtype=\"int64\")\n    pt_district = np.asarray(district_codes[len(labels):], dtype=\"int64\")\n    pt_district = np.where(pt_district >= 0, pt_district, -999999)\n\n    # A label enters the JOIN only when both its scheduled commit and the joined\n    # customer row are visible.  signup_at is immutable and is the customer row's\n    # source/commit time.\n    lab_commit, lab_commit_valid = _seconds(labels[\"_loaded_at\"])\n    lab_signup_secs = np.full(len(labels), np.iinfo(np.int64).max, dtype=\"int64\")\n    if lab_has_customer.any():\n        positions = lab_customer_index[lab_has_customer]\n        signup_secs, signup_valid = _seconds(customers[\"signup_at\"].iloc[positions])\n        lab_signup_secs[lab_has_customer] = np.where(signup_valid, signup_secs,\n                                                      np.iinfo(np.int64).max)\n    lab_commit = np.where(lab_commit_valid, lab_commit, np.iinfo(np.int64)"]
[2368.147233, "i", ".max)\n    eligibility = np.maximum(lab_commit, lab_signup_secs)\n\n    y_values = pd.to_numeric(labels[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\n    label_order = np.argsort(eligibility, kind=\"mergesort\")\n    eligibility = eligibility[label_order]\n    lab_district = lab_district[label_order]\n    y_values = y_values[label_order]\n\n    point_order = np.argsort(point_secs, kind=\"mergesort\")\n    global_n = global_sum = 0\n    district_n = {}\n    district_sum = {}\n    label_i = 0\n    for q in point_order:\n        original = int(point_positions[q])\n        t = int(point_secs[q])\n        own = int(pt_district[q])\n        while label_i < len(eligibility) and eligibility[label_i] < t:\n            y = float(y_values[label_i])\n            if np.isfinite(y):\n                global_n += 1\n                global_sum += int(y)\n            district = int(lab_district[label_i])\n            district_n[district] = district_n.get(district, 0) + 1\n            district_sum[district] = district_sum.get(district, 0) +\n "]
[2368.147245, "i", "                                    (int(y) if np.isfinite(y) else 0)\n            label_i += 1\n\n        # PostgreSQL aggregates return one row even when CROSS JOIN own is empty;\n        # the COALESCE clauses then produce the 0.05 prior.\n        same_n = district_n.get(own, 0)\n        same_sum = district_sum.get(own, 0)\n        prior = global_sum / global_n if global_n else 0.05\n        out[original] = (same_sum + 20.0 * prior) / (same_n + 20.0)\n    return out\n'''\ns=s[:start]+new+s[end:]\nopen(p,'w').write(s)\nPY\npython /tmp/rewrite_te.py\npython -m py_compile churn/*.py\n"]
