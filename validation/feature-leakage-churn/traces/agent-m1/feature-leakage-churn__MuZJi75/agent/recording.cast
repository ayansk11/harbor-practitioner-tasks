[3564.938788, "o", "\u001b[?2004h"]
[3564.938818, "o", "> "]
[3564.93899, "o", "    if amount_col is not None:\r\n\u001b[?2004l\r"]
[3564.939023, "o", "\u001b[?2004h> "]
[3564.939353, "o", "        result[\"spend\"] = np.zeros(n, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3564.939395, "o", "\u001b[?2004h> "]
[3564.939734, "o", "    result[\"last\"] = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[3564.939763, "o", "\u001b[?2004h"]
[3564.939791, "o", "> \r\n\u001b[?2004l\r"]
[3564.939821, "o", "\u001b[?2004h> "]
[3564.940163, "o", "    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[3564.940207, "o", "\u001b[?2004h"]
[3564.940238, "o", "> "]
[3564.940512, "o", "    point_positions = np.flatnonzero(point_valid)\r\n\u001b[?2004l\r"]
[3564.940545, "o", "\u001b[?2004h"]
[3564.940574, "o", "> "]
[3564.940749, "o", "    if not len(point_positions):\r\n\u001b[?2004l\r"]
[3564.940782, "o", "\u001b[?2004h> "]
[3564.940933, "o", "        return result\r\n\u001b[?2004l\r"]
[3564.940968, "o", "\u001b[?2004h> "]
[3564.941288, "o", "    point_secs = point_secs[point_positions]\r\n\u001b[?2004l\r"]
[3564.941328, "o", "\u001b[?2004h> "]
[3564.941358, "o", "\r\n\u001b[?2004l\r"]
[3564.941388, "o", "\u001b[?2004h"]
[3564.941422, "o", "> "]
[3564.941578, "o", "    if not len(events):\r\n\u001b[?2004l\r"]
[3564.941618, "o", "\u001b[?2004h> "]
[3564.941797, "o", "        return result\r\n\u001b[?2004l\r"]
[3564.941834, "o", "\u001b[?2004h"]
[3564.941864, "o", "> "]
[3564.942295, "o", "    event_secs, event_time_valid = _seconds(events[ts_col])\r\n\u001b[?2004l\r"]
[3564.942328, "o", "\u001b[?2004h"]
[3564.942358, "o", "> "]
[3564.942835, "o", "    event_commit, event_commit_valid = _seconds(events[commit_col])\r\n\u001b[?2004l\r"]
[3564.942868, "o", "\u001b[?2004h"]
[3564.942912, "o", "> "]
[3564.94329, "o", "    event_mask = event_time_valid & event_commit_valid\r\n\u001b[?2004l\r"]
[3564.943323, "o", "\u001b[?2004h"]
[3564.943353, "o", "> "]
[3564.943698, "o", "    event_positions = np.flatnonzero(event_mask)\r\n\u001b[?2004l\r"]
[3564.943738, "o", "\u001b[?2004h"]
[3564.943769, "o", "> "]
[3564.944008, "o", "    if not len(event_positions):\r\n\u001b[?2004l\r"]
[3564.944041, "o", "\u001b[?2004h"]
[3564.944071, "o", "> "]
[3564.944219, "o", "        return result\r\n\u001b[?2004l\r"]
[3564.944256, "o", "\u001b[?2004h"]
[3564.944286, "o", "> "]
[3564.944601, "o", "    event_secs = event_secs[event_positions]\r\n\u001b[?2004l\r"]
[3564.944641, "o", "\u001b[?2004h"]
[3564.944671, "o", "> "]
[3564.945022, "o", "    event_commit = event_commit[event_positions]\r\n\u001b[?2004l\r"]
[3564.945058, "o", "\u001b[?2004h"]
[3564.945087, "o", "> \r\n\u001b[?2004l\r"]
[3564.94512, "o", "\u001b[?2004h"]
[3564.945151, "o", "> "]
[3564.945704, "o", "    point_ids = points[\"customer_id\"].to_numpy(dtype=\"object\")[point_positions]\r\n\u001b[?2004l\r"]
[3564.945741, "o", "\u001b[?2004h"]
[3564.94577, "o", "> "]
[3564.946353, "o", "    event_ids = events[\"customer_id\"].to_numpy(dtype=\"object\")[event_positions]\r\n\u001b[?2004l\r"]
[3564.946389, "o", "\u001b[?2004h"]
[3564.94642, "o", "> "]
[3564.946996, "o", "    codes, _ = pd.factorize(np.concatenate([point_ids, event_ids]), sort=True)\r\n\u001b[?2004l\r"]
[3564.947033, "o", "\u001b[?2004h"]
[3564.947062, "o", "> "]
[3564.94759, "o", "    point_codes = np.asarray(codes[: len(point_positions)], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3564.947623, "o", "\u001b[?2004h"]
[3564.947653, "o", "> "]
[3564.948194, "o", "    event_codes = np.asarray(codes[len(point_positions):], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3564.94823, "o", "\u001b[?2004h"]
[3564.94826, "o", "> "]
[3564.948716, "o", "    n_codes = int(max(point_codes.max(), event_codes.max()) + 1)\r\n\u001b[?2004l\r"]
[3564.948751, "o", "\u001b[?2004h"]
[3564.948781, "o", "> \r\n\u001b[?2004l\r"]
[3564.948813, "o", "\u001b[?2004h"]
[3564.948843, "o", "> "]
[3564.949302, "o", "    # Put each valid event in a stable, customer-local time rank.\r\n\u001b[?2004l\r"]
[3564.949333, "o", "\u001b[?2004h"]
[3564.949363, "o", "> "]
[3564.949754, "o", "    group_order = np.lexsort((event_secs, event_codes))\r\n\u001b[?2004l\r"]
[3564.949796, "o", "\u001b[?2004h> "]
[3564.950116, "o", "    group_codes = event_codes[group_order]\r\n\u001b[?2004l\r"]
[3564.950156, "o", "\u001b[?2004h"]
[3564.950186, "o", "> "]
[3564.950472, "o", "    group_times = event_secs[group_order]\r\n\u001b[?2004l\r"]
[3564.950514, "o", "\u001b[?2004h"]
[3564.950544, "o", "> "]
[3564.950897, "o", "    offsets = np.zeros(n_codes + 1, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3564.950933, "o", "\u001b[?2004h"]
[3564.950965, "o", "> "]
[3564.951506, "o", "    np.cumsum(np.bincount(group_codes, minlength=n_codes), out=offsets[1:])\r\n\u001b[?2004l\r"]
[3564.951546, "o", "\u001b[?2004h> "]
[3564.952135, "o", "    slot = np.arange(len(event_positions), dtype=\"int64\") - offsets[group_codes]\r\n\u001b[?2004l\r"]
[3564.952171, "o", "\u001b[?2004h"]
[3564.952204, "o", "> "]
[3564.952634, "o", "    event_slot = np.empty(len(event_positions), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3564.952667, "o", "\u001b[?2004h"]
[3564.952697, "o", "> "]
[3564.952941, "o", "    event_slot[group_order] = slot\r\n\u001b[?2004l\r"]
[3564.95298, "o", "\u001b[?2004h> "]
[3564.95301, "o", "\r\n\u001b[?2004l\r"]
[3564.95304, "o", "\u001b[?2004h"]
[3564.953083, "o", "> "]
[3564.953535, "o", "    # Process events by commit time and requests by request time.\r\n\u001b[?2004l\r"]
[3564.953569, "o", "\u001b[?2004h"]
[3564.953599, "o", "> "]
[3564.954059, "o", "    commit_order = np.argsort(event_commit, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[3564.954092, "o", "\u001b[?2004h"]
[3564.954122, "o", "> "]
[3564.954476, "o", "    event_indices = event_positions[commit_order]\r\n\u001b[?2004l\r"]
[3564.954517, "o", "\u001b[?2004h> "]
[3564.954863, "o", "    commit_times = event_commit[commit_order]\r\n\u001b[?2004l\r"]
[3564.954918, "o", "\u001b[?2004h"]
[3564.954949, "o", "> "]
[3564.955257, "o", "    insert_slots = event_slot[commit_order]\r\n\u001b[?2004l\r"]
[3564.955299, "o", "\u001b[?2004h"]
[3564.955329, "o", "> "]
[3564.955643, "o", "    insert_codes = event_codes[commit_order]\r\n\u001b[?2004l\r"]
[3564.955675, "o", "\u001b[?2004h"]
[3564.955705, "o", "> "]
[3564.956015, "o", "    insert_times = event_secs[commit_order]\r\n\u001b[?2004l\r"]
[3564.956052, "o", "\u001b[?2004h"]
[3564.956083, "o", "> \r\n\u001b[?2004l\r"]
[3564.956113, "o", "\u001b[?2004h"]
[3564.956146, "o", "> "]
[3564.956356, "o", "    if amount_col is not None:\r\n\u001b[?2004l\r"]
[3564.956391, "o", "\u001b[?2004h"]
[3564.956421, "o", "> "]
[3564.957076, "o", "        amounts = (pd.to_numeric(events[amount_col].iloc[event_indices], errors=\"coerce\")\r\n\u001b[?2004l\r"]
