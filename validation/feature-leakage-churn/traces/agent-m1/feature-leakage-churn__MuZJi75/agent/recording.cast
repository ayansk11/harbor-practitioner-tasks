[130.163649, "i", "python - <<'PY'\nimport pandas as pd, json\nO=pd.read_parquet('/tmp/current.parquet')\nrows=[json.loads(x) for x in open('logs/live_2026-01_sample.jsonl')]\nL=pd.DataFrame([{**{'customer_id':r['customer_id'],'as_of':r['as_of']}, **r['features']} for r in rows])\nL['as_of']=pd.to_datetime(L.as_of,utc=True)\nM=L.merge(O,on=['customer_id','as_of'],how='left',suffixes=('_live','_offline'))\nprint('joined',len(M),'missing',M.orders_7d_offline.isna().sum())\nfeatures=['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','days_since_last_login','app_minutes_7d','te_district']\nfor f in features:\n a=M[f+'_live']; b=M[f+'_offline']\n if pd.api.types.is_numeric_dtype(a) and pd.api.types.is_numeric_dtype(b):\n  bad=~((a-b).abs().le(1e-6+1e-9*a.abs()) | (a.isna()&b.isna()))\n else: bad=~((a==b)|(a.isna()&b.isna()))\n print(f,'mismatches',int(bad.sum()))\n if bad.any(): print(M.loc[bad,[f+'_live',f+'_offline']].head(8).to_string(index=False))\nPY\n"]
