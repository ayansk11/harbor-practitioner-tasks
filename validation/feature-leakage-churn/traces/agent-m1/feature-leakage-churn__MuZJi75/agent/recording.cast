[3564.925775, "i", ", i):\r        count = amount = 0\r        while i > 0:\r            count += self.counts[i]\r            amount += self.amounts[i]\r            i -= i & -i\r        return count, amount\r\r    def range(self, left, right):\r        if right <= left:\r            return 0, 0\r        hi_count, hi_amount = self._prefix(right)\r        lo_count, lo_amount = self._prefix(left)\r        return hi_count - lo_count, hi_amount - lo_amount\r\r\rdef _event_features(points, events, commit_col, ts_col, *, amount_col=None,\r                    windows=(30,), need_last=False):\r    \"\"\"Count/sum events in [t-W,t) among rows committed strictly before t.\"\"\"\r    n = len(points)\r    result = {f\"count_{w}\": np.zeros(n, dtype=\"int64\") for w in windows}\r    if amount_col is not None:\r        result[\"spend\"] = np.zeros(n, dtype=\"int64\")\r    result[\"last\"] = np.full(n, np.nan, dtype=\"float64\")\r\r    point_secs, point_valid = _seconds(points[\"as_of\"])\r    point_positions = np.flatnonzero(point_valid)\r    if not len(point_positions):\r        return res"]
