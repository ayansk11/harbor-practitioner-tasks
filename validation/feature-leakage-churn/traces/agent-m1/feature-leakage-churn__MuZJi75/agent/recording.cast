[3272.467784, "i", "python - <<'PY'\nimport json,pandas as pd\nfrom churn.extract import load_extract\nfrom churn.live_features import status_features\nT=load_extract('data'); P=T['scoring_points']; S=T['status_snapshots']\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))]); L['as_of']=pd.to_datetime(L.as_of,utc=True)\nF=pd.read_parquet('/tmp/fixed.parquet'); M=L.merge(F[['customer_id','as_of','status']],on=['customer_id','as_of'],how='left',suffixes=('_live','_off'))\nr=M.loc[M.status_live!=M.status_off].iloc[0]\nq=P[(P.customer_id==r.customer_id)&(P.as_of==r.as_of)].reset_index(drop=True)\nprint('row',r.customer_id,r.as_of,'live',r.status_live,'old_helper',r.status_off)\nprint('new_helper',status_features(q,S)[0])\nv=S[(S.customer_id==r.customer_id)&(S._loaded_at<r.as_of)].sort_values(['snapshot_date','_loaded_at'])\nprint('direct',v.status.iloc[-1] if len(v) else None)\nprint(v.tail(10).to_string(index=False))\nPY\n"]
