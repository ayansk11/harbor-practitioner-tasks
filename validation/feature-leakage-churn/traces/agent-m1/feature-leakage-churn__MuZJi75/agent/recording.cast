[3565.004309, "o", "\u001b[?2004h"]
[3565.004338, "o", "> "]
[3565.004498, "o", "    if not len(point_positions):\r\n\u001b[?2004l\r"]
[3565.004522, "o", "\u001b[?2004h"]
[3565.004551, "o", "> "]
[3565.004649, "o", "        return out\r\n\u001b[?2004l\r"]
[3565.004669, "o", "\u001b[?2004h"]
[3565.004699, "o", "> "]
[3565.004929, "o", "    point_secs = point_secs[point_positions]\r\n\u001b[?2004l\r"]
[3565.004959, "o", "\u001b[?2004h> "]
[3565.004982, "o", "\r\n\u001b[?2004l\r"]
[3565.005006, "o", "\u001b[?2004h> "]
[3565.005355, "o", "    lab_ids = labels[\"customer_id\"].to_numpy(dtype=\"object\")\r\n\u001b[?2004l\r"]
