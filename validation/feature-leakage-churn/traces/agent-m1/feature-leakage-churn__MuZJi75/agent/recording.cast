[1652.398503, "o", "                        _utc(start_s), _utc(end_s), int(rows), info[\"at\"],\r\n"]
[1652.398556, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.399108, "o", "                        _table_name(table or \"orders\"), txn,\r\n\u001b[?2004l\r\u001b[?2004h>                     ))\r\n\u001b[?2004l\r\u001b[?2004h>                 statements[job] = []\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r"]
[1652.399186, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1652.399232, "o", "\u001b[?2004h> "]
[1652.399315, "o", "            match = _SEND_RE.search(message)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.399482, "o", ">             if match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
