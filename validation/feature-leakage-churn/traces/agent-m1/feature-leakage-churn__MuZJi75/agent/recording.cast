[568.316125, "i", "python - <<'PY'\nimport re,pandas as pd,collections\nR=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if z: R.append((pd.Timestamp(z.group(1)),pd.Timestamp(z.group(2)),int(z.group(3)),int(z.group(4)),z.group(5),a[0]))\nD=collections.defaultdict(list)\nfor r in R: D[(r[0],r[1])].append(r)\nprint('records',len(R),'windows',len(D),'duplicates',sum(len(v)>1 for v in D.values()))\nfor k,v in D.items():\n if len(v)>1:\n  print(k); [print(x) for x in v]\n# Find overlaps between distinct windows\nW=sorted({(r[0],r[1]) for r in R})\nfor i in range(1,len(W)):\n if W[i][0] < W[i-1][1]: print('overlap',W[i-1],W[i])\nPY\n"]
