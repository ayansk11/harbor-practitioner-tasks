[140.377509, "i", "python -m churn.build_features --data data --out /tmp/current.parquet > /tmp/build.log && cat /tmp/build.log && python - <<'PY'\nimport pandas as pd,json\nO=pd.read_parquet('/tmp/current.parquet')\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))])\nL['as_of']=pd.to_datetime(L.as_of,utc=True)\nM=L.merge(O,on=['customer_id','as_of'],how='left',suffixes=('_live','_off'))\nfs=['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','days_since_last_login','app_minutes_7d','te_district']\nfor f in fs:\n a=M[f+'_live']; b=M[f+'_off']\n try: bad=~(((a-b).abs()<=1e-6+1e-9*a.abs()) | (a.isna()&b.isna()))\n except: bad=~((a==b)|(a.isna()&b.isna()))\n print(f,int(bad.sum()),'/',len(M))\nPY\n"]
