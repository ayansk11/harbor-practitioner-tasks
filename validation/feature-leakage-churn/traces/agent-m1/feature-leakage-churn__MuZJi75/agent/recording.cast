[3141.431545, "o", "\"\"\"Read the warehouse scheduler records used for point-in-time reconstruction.\"\"\"\r\nfrom dataclasses import dataclass\r\nimport heapq\r\nimport json\r\nimport os\r\nimport re\r\n\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass OrderTxn:\r\n    start: pd.Timestamp\r\n    end: pd.Timestamp\r\n    rows: int\r\n    commit: pd.Timestamp\r\n    table: str\r\n    txn: int\r\n\r\n\r\n@dataclass\r\nclass Ops:\r\n    order_txns: list\r\n    schema_txns: list\r\n    rename_at: pd.Timestamp | None = None\r\n    legacy_orders_complete: bool = True\r\n\r\n\r\n_SELECT_RE = re.compile(\r\n"]
[3141.431591, "o", "    r\"selected\\s+orders\\s+where\\s+ordered_at\\s*>=\\s*(\\S+)\\s+\"\r\n    r\"and\\s+ordered_at\\s*<\\s*(\\S+):\\s*(\\d+)\\s+rows;\\s*\"\r\n    r\"sent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\"\r\n)\r\n_STATEMENT_RE = re.compile(r\"^statement:\\s*(.*)$\")\r\n_SEND_RE = re.compile(r\"\\bsent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\")\r\n_RENAME_RE = re.compile(r\"ALTER\\s+TABLE\\s+(\\S+)\\s+RENAME\\s+TO\\s+(\\S+)\", re.I)\r\n\r\n\r\ndef _utc(value):\r\n    return pd.to_datetime(value, utc=True)\r\n\r\n\r\ndef _table_name(value):\r\n    return value.strip('\"`').split(\".\")[-1]\r\n\r\n\r\ndef load_ops(data_dir):\r\n    commits = {}\r\n    path = os.path.join(data_dir, \"_ops\", \"commits.jsonl\")\r\n    if os.path.exists(path):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n"]
