[2806.909364, "o", "nl -ba churn/live_features.py | sed -n '1,230p'\r\n\u001b[?2004l\r"]
[2806.911687, "o", "     1\t\"\"\"Reconstruct the values computed by ``live/features.py`` from an extract.\r\n     2\t\r\n     3\tThe reconstruction uses only facts that were committed before each request.  For\r\n     4\trows written by scheduled jobs this comes from ``_loaded_at`` (or, for the old\r\n     5\torders generation, from the scheduler transaction records).  Rows written by the\r\n     6\tsign-up, ticket CDC and scoring services were committed at the source timestamps\r\n"]
[2806.911744, "o", "     7\trecorded in the extract.\r\n     8\t\"\"\"\r\n     9\tfrom bisect import bisect_left, insort\r\n    10\t\r\n    11\timport numpy as np\r\n    12\timport pandas as pd\r\n    13\t\r\n    14\t\r\n"]
[2806.911828, "o", "    15\tdef _seconds(values):\r\n    16\t    values = pd.to_datetime(pd.Series(values), utc=True)\r\n    17\t    valid = values.notna().to_numpy()\r\n    18\t    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    19\t    return out, valid\r\n    20\t\r\n    21\t\r\n    22\tclass _Fenwick:\r\n    23\t    def __init__(self, n):\r\n    24\t        self.n = n\r\n    25\t        self.counts = [0] * (n + 1)\r\n    26\t        self.amounts = [0] * (n + 1)\r\n    27\t\r\n    28\t    def add(self, i, amount):\r\n    29\t        i += 1\r\n    30\t        while i <= self.n:\r\n    31\t            self.counts[i] += 1\r\n    32\t            self.amounts[i] += amount\r\n    33\t            i += i & -i\r\n    34\t\r\n    35\t    def range(self, left, right):\r\n    36\t        if right <= left:\r\n    37\t            return 0, 0\r\n    38\t        hi_count, hi_amount = self._prefix(right)\r\n    39\t        lo_count, lo_amount = self._prefix(left)\r\n    40\t        return hi_count - lo_count, hi_amount - lo_amount\r\n    41\t\r\n    42\t"]
[2806.911879, "o", "    def _prefix(self, i):\r\n    43\t        count = amount = 0\r\n    44\t        while i > 0:\r\n    45\t            count += self.counts[i]\r\n    46\t            amount += self.amounts[i]\r\n    47\t            i -= i & -i\r\n    48\t        return count, amount\r\n    49\t\r\n    50\t\r\n"]
[2806.91195, "o", "    51\tdef _factorize_ids(a, b=None):\r\n    52\t    if b is None:\r\n    53\t        codes, unique = pd.factorize(pd.Series(a), sort=True)\r\n    54\t        return codes, unique\r\n    55\t    combined = pd.concat([pd.Series(a), pd.Series(b)], ignore_index=True)\r\n    56\t    codes, unique = pd.factorize(combined, sort=True)\r\n    57\t    return codes[: len(a)], codes[len(a) :], unique\r\n    58\t\r\n    59\t\r\n    60\tdef _event_features(points, events, commit_col, ts_col, *, amount_col=None,\r\n    61\t                    windows=(30,), need_last=False):\r\n    62\t    \"\"\"Evaluate event queries as events become visible through ``commit_col``.\"\"\"\r\n    63\t    n = len(points)\r\n    64\t    result = {f\"count_{w}\": np.zeros(n, dtype=\"int64\") for w in windows}\r\n    65\t    if amount_col is not None:\r\n"]
[2806.911997, "o", "    66\t        result[\"spend\"] = np.zeros(n, dtype=\"int64\")\r\n    67\t    result[\"last\"] = np.full(n, np.nan, dtype=\"float64\")\r\n    68\t\r\n    69\t    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n    70\t    point_positions = np.flatnonzero(point_valid)\r\n    71\t    if not len(point_positions):\r\n    72\t        return result\r\n    73\t    point_secs = point_secs[point_positions]\r\n    74\t\r\n    75\t    event_secs, event_valid = _seconds(events[ts_col])\r\n    76\t    event_commit, commit_valid = _seconds(events[commit_col])\r\n"]
