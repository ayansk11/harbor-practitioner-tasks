[3564.926504, "i", "nt_positions)], dtype=\"int64\")\r    change_codes = np.asarray(codes[len(point_positions):], dtype=\"int64\")\r    change_order = np.argsort(change_commit, kind=\"mergesort\")\r    change_commit = change_commit[change_order]\r    change_changed = change_changed[change_order]\r    change_codes = change_codes[change_order]\r    change_plans = change_plans[change_order]\r\r    point_order = np.argsort(point_secs, kind=\"mergesort\")\r    latest_change = {}\r    change_i = 0\r    for q in point_order:\r        original = int(point_positions[q])\r        t = int(point_secs[q])\r        code = int(point_codes[q])\r        while change_i < len(change_commit) and change_commit[change_i] < t:\r            ccode = int(change_codes[change_i])\r            changed = int(change_changed[change_i])\r            current = latest_change.get(ccode)\r            if current is None or changed >= current[0]:\r                latest_change[ccode] = (changed, change_plans[change_i])\r            change_i += 1\r\r        # No customer row exists until the sign-u"]
[3564.926611, "i", "p row is committed.\r        if not signup_valid[original] or t <= signup_secs[original]:\r            plan_known[original] = login_known[original] = True\r            continue\r\r        # If the final customer row was last committed before t, it is exactly the\r        # row the live query saw.\r        if updated_valid[original] and updated_secs[original] < t:\r            plan[original] = final_plan[original]\r            plan_known[original] = True\r            if login_valid[original]:\r                login_days[original] = (t - login_secs[original]) / 86400.0\r            login_known[original] = True\r            continue\r\r        # Otherwise plan history can still supply a visible plan; login history cannot.\r        current = latest_change.get(code)\r        if current is not None:\r            plan[original] = current[1]\r            plan_known[original] = True\r\r    return plan, login_days, bool(plan_known.all()), bool(login_known.all())\rPY\rpython -m py_compile churn/*.py\r"]
[3564.926991, "o", "Rows written by scheduled jobs are visible at their commit time.  Source-service\r\n\u001b[?2004l\r"]
[3564.927049, "o", "\u001b[?2004h"]
[3564.927089, "o", "> "]
[3564.92747, "o", "rows (customers, scoring points, and ticket CDC rows) use the source/CDC\r\n\u001b[?2004l\r"]
[3564.927523, "o", "\u001b[?2004h"]
[3564.927564, "o", "> "]
[3564.927995, "o", "timestamps retained by the extract.  The scheduler records are used to recover\r\n\u001b[?2004l\r"]
[3564.928035, "o", "\u001b[?2004h"]
[3564.928071, "o", "> "]
[3564.928408, "o", "visibility in the old ``orders`` table across its migration.\r\n\u001b[?2004l\r"]
