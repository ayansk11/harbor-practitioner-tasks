[2775.581139, "i", "python - <<'PY'\nimport pandas as pd\nP=pd.read_csv('data/scoring_points.csv'); P['as_of']=pd.to_datetime(P.as_of,utc=True)\nPC=pd.read_csv('data/plan_changes.csv'); PC['_loaded_at']=pd.to_datetime(PC._loaded_at,utc=True)\nfirst=PC.groupby('customer_id').agg(changed_min=('changed_at','min'),loaded_min=('_loaded_at','min'))\nM=P.merge(first,left_on='customer_id',right_index=True,how='inner')\nprint('points for customers with changes',len(M),'before first loaded',int((M.as_of<=M.loaded_min).sum()),'strict before',int((M.as_of<M.loaded_min).sum()))\nprint(M.loc[M.as_of<M.loaded_min,['customer_id','as_of','loaded_min']].head(10).to_string(index=False))\nPY\n"]
