[96.958877, "i", "python - <<'PY'\nimport pandas as pd\nO=pd.read_csv('data/orders.csv'); O['_loaded_at']=pd.to_datetime(O._loaded_at,utc=True); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True)\nprint('rows',len(O),'unique_ids',O.order_id.nunique())\nprint('jobs:',O._load_job.value_counts(dropna=False).to_dict())\nfor j,g in O.groupby('_load_job',dropna=False):\n print(j,len(g),g._loaded_at.min(),g._loaded_at.max(),g.ordered_at.min(),g.ordered_at.max(),g.order_id.nunique())\nprint('prebackfill_loads',sum(O._loaded_at<pd.Timestamp('2025-04-06T10:00:00Z')))\nprint('migrated_commit',sum(O._loaded_at==pd.Timestamp('2025-04-06T09:19:00Z')))\nPY\n"]
