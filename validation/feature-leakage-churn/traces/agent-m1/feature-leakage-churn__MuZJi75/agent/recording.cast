[1876.273141, "o", "\u001b[?2004h"]
[1876.273159, "o", "> "]
[1876.273249, "o", "        out[\"days_since_last_login\"] = login\r\n\u001b[?2004l\r"]
[1876.27327, "o", "\u001b[?2004h> "]
[1876.273386, "o", "    out[\"app_minutes_7d\"] = app_minutes(points)\r\n\u001b[?2004l\r"]
[1876.273408, "o", "\u001b[?2004h> "]
[1876.27357, "o", "    out[\"te_district\"] = target_encoding(points, labels, customers)\r\n\u001b[?2004l\r"]
[1876.273592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1876.273614, "o", "\u001b[?2004h> "]
[1876.273764, "o", "    kept = [f for f in LIVE_FEATURES if f in out.columns]\r\n\u001b[?2004l\r"]
[1876.273783, "o", "\u001b[?2004h"]
[1876.2738, "o", "> "]
[1876.273873, "o", "    return out[BASE_COLUMNS + kept]\r\n\u001b[?2004l\r"]
[1876.273902, "o", "\u001b[?2004h"]
[1876.27392, "o", "> \r\n\u001b[?2004l\r"]
[1876.273937, "o", "\u001b[?2004h> "]
[1876.273955, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1876.273972, "o", "> "]
[1876.273989, "o", "def main():\r\n\u001b[?2004l\r"]
[1876.274011, "o", "\u001b[?2004h> "]
[1876.274141, "o", "    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[1876.274165, "o", "\u001b[?2004h"]
[1876.274187, "o", "> "]
[1876.274364, "o", "    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[1876.274388, "o", "\u001b[?2004h"]
[1876.274405, "o", "> "]
[1876.274557, "o", "    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[1876.274577, "o", "\u001b[?2004h> "]
[1876.274646, "o", "    args = ap.parse_args()\r\n\u001b[?2004l\r"]
[1876.274672, "o", "\u001b[?2004h> "]
[1876.274751, "o", "    features = build(args.data)\r\n\u001b[?2004l\r"]
[1876.274773, "o", "\u001b[?2004h> "]
[1876.274873, "o", "    out_path = os.path.abspath(args.out)\r\n\u001b[?2004l\r"]
[1876.274903, "o", "\u001b[?2004h"]
[1876.27492, "o", "> "]
[1876.275039, "o", "    os.makedirs(os.path.dirname(out_path), exist_ok=True)\r\n\u001b[?2004l\r"]
[1876.275058, "o", "\u001b[?2004h"]
[1876.275074, "o", "> "]
[1876.275174, "o", "    features.to_parquet(out_path, index=False)\r\n\u001b[?2004l\r"]
[1876.275194, "o", "\u001b[?2004h"]
[1876.27521, "o", "> "]
[1876.275406, "o", "    print(f\"wrote {len(features)} rows x {features.shape[1]} columns to {args.out}\")\r\n\u001b[?2004l\r"]
[1876.275423, "o", "\u001b[?2004h"]
[1876.275439, "o", "> \r\n\u001b[?2004l\r"]
[1876.27546, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1876.275482, "o", "\u001b[?2004h> "]
[1876.275542, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[1876.275563, "o", "\u001b[?2004h> "]
[1876.275593, "o", "    main()\r\n\u001b[?2004l\r"]
