[569.321067, "i", "python - <<'PY'\nimport pandas as pd,json,re,collections\nC={int(json.loads(x)['txn']):json.loads(x) for x in open('data/_ops/commits.jsonl')}\nR=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if z: R.append((pd.Timestamp(z.group(1)),pd.Timestamp(z.group(2)),int(z.group(3)),C[int(z.group(4))]))\nprint('legacy selections',len(R),'commits',sum(x['outcome']=='commit' for _,_,_,x in R),'rollbacks',sum(x['outcome']=='rollback' for _,_,_,x in R),'committed rows',sum(n for _,_,n,x in R if x['outcome']=='commit'))\nprint('time range',min(x['at'] for _,_,_,x in R),max(x['at'] for _,_,_,x in R))\nprint('first 10'); [print(s,e,n,x) for s,e,n,x in R[:10]]\nPY\n"]
