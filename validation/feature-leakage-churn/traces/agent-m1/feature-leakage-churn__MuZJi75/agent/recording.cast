[301.251461, "i", "python - <<'PY'\nimport pandas as pd,json,collections\nO=pd.read_csv('data/orders.csv'); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True)\ncomm={int(json.loads(l)['txn']):json.loads(l) for l in open('data/_ops/commits.jsonl')}\nsel=collections.defaultdict(list)\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='orders_hourly': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if z: sel[z.group(5)].append((pd.Timestamp(z.group(1)),pd.Timestamp(z.group(2)),int(z.group(3)),comm[int(z.group(4))]))\nfor table,items in sel.items():\n bad=[]\n for s,e,n,x in items:\n  actual=int(((O._load_job=='orders_hourly')&O.ordered_at.ge(s)&O.ordered_at.lt(e)).sum())\n  expected=n if x['outcome']=='commit' else 0\n  if actual!=expected: bad.append((str(s),str(e),n,x['outcome'],actual))\n print(table,'selections',len(items),'bad',len(bad),'first bad',bad[:3])\nPY\n"]
