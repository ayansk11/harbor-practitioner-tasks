[1476.710359, "o", "\u001b[?2004h"]
[1476.710376, "o", "> "]
[1476.710519, "o", "        renames = [( _table_name(a), _table_name(b)) for a, b in\r\n\u001b[?2004l\r"]
[1476.710541, "o", "\u001b[?2004h> "]
[1476.710702, "o", "                   (match.groups() for match in renames if match)]\r\n\u001b[?2004l\r"]
[1476.710718, "o", "\u001b[?2004h> "]
[1476.710914, "o", "        moved_old = any(a == \"orders\" and b != \"orders\" for a, b in renames)\r\n\u001b[?2004l\r"]
