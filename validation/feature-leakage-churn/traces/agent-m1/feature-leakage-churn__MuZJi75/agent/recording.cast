[344.202085, "i", "python - <<'PY'\nimport pandas as pd,json\nC=pd.read_csv('data/customers.csv'); C['signup_at']=pd.to_datetime(C.signup_at,utc=True)\nPC=pd.read_csv('data/plan_changes.csv'); PC['changed_at']=pd.to_datetime(PC.changed_at,utc=True); PC['_loaded_at']=pd.to_datetime(PC._loaded_at,utc=True)\nP=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))]); P['as_of']=pd.to_datetime(P.as_of,utc=True)\ninitial=PC.sort_values(['customer_id','changed_at']).groupby('customer_id').first().old_plan\ninitial=C.customer_id.map(pd.Series(C.customer_id.values,index=C.customer_id.values)).map(initial).fillna(C.set_index('customer_id').plan)\nP['initial']=P.customer_id.map(initial)\n# For each row, take latest change loaded before t.\nP=P.sort_values('as_of'); out=[]\nfor row in P.itertuples():\n q=PC[(PC.customer_id==row.customer_id)&(PC._loaded_at<row.as_of)].sort_values(['changed_at'])\n out.append(q.new_plan.iloc[-1] if len(q) else row.initial)\nP['pla"]
[344.202178, "i", "n_rec']=out\nprint('plan mismatches',int((P.plan!=P.plan_rec).sum()),'/',len(P))\nprint(P.loc[P.plan!=P.plan_rec,['customer_id','as_of','plan','plan_rec']].head())\nPY\n"]
