[218.47646, "i", "python - <<'PY'\nimport re,json,collections,pandas as pd\n# Pair selection windows with commits by txn and compare committed count to selected count.\ncomm={int(json.loads(l)['txn']):json.loads(l) for l in open('data/_ops/commits.jsonl')}\nfor job in ['legacy_orders','orders_hourly']:\n c=collections.Counter()\n for l in open('data/_ops/scheduler.log'):\n  a=l.rstrip().split(maxsplit=2)\n  if len(a)<3 or a[1]!=job: continue\n  z=re.search(r'selected .*: (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n  if z:\n   n,txn,table=z.groups(); x=comm.get(int(txn))\n   c[(table,x['outcome'],str(int(n)==int(x['rows']))) if x else (table,'missing',str(int(n)==0))]+=1\n print(job,c)\nPY\n"]
