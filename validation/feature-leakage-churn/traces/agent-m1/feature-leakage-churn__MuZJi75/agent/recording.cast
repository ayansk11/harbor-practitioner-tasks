[3298.735352, "o", "\r\n\r\n\r\ndef customer_features(points, customers, plan_changes):"]
[3298.73537, "o", "\r\n    \"\"\"Build customer-record features when, and only when, every value is known.\"\"\"\r\n    n = len(points)\r\n    plan = np.full(n, None, dtype=object)\r\n    login_days = np.full(n, np.nan, dtype=\"float64\")\r\n    plan_known = np.zeros(n, dtype=\"bool\")\r\n"]
[3298.735408, "o", "    login_known = np.zeros(n, dtype=\"bool\")\r\n\r\n    customer_by_id = customers.set_index(\"customer_id\", drop=False)\r\n    final_plan = points[\"customer_id\"].map(customer_by_id[\"plan\"])\r\n"]
[3298.735423, "o", "    final_login = points[\"customer_id\"].map(customer_by_id[\"last_login_at\"])\r\n    final_updated = points[\"customer_id\"].map(customer_by_id[\"_updated_at\"])\r\n"]
[3298.735432, "o", "    final_signup = points[\"customer_id\"].map(customer_by_id[\"signup_at\"])\r\n"]
[3298.735463, "o", "    no_changes = ~points[\"customer_id\"].isin(set(plan_changes[\"customer_id\"]))\r\n\r\n    plan_commit, plan_commit_valid = _seconds(plan_changes[\"_loaded_at\"])\r\n    plan_changed, changed_valid = _seconds(plan_changes[\"changed_at\"])"]
[3298.735474, "o", "\r\n    valid = plan_commit_valid & changed_valid"]
[3298.735483, "o", "\r\n    changes = plan_changes.loc[valid, [\"customer_id\", \"new_plan\"]].copy()"]
[3298.735527, "o", "\r\n    changes[\"commit\"] = plan_commit[valid]\r\n    changes[\"changed\"] = plan_changed[valid]\r\n    changes = changes.sort_values(\"commit\", kind=\"mergesort\")\r\n    change_commit = changes[\"commit\"].to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n"]
[3298.735555, "o", "    change_changed = changes[\"changed\"].to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    change_ids = changes[\"customer_id\"].to_numpy()"]
[3298.73557, "o", "\r\n    change_plan = changes[\"new_plan\"].to_numpy(dtype=object)\r\n\r\n    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n"]
[3298.735579, "o", "    point_positions = np.flatnonzero(point_valid)\r\n"]
[3298.735586, "o", "    point_codes, change_codes, unique_ids = _factorize_ids(\r\n"]
[3298.735595, "o", "        points[\"customer_id\"].iloc[point_positions], changes[\"customer_id\"],"]
[3298.73562, "o", "\r\n    )"]
[3298.73566, "o", "\r\n    point_codes = np.asarray(point_codes, dtype=\"int64\")\r\n    change_codes = np.asarray(change_codes, dtype=\"int64\")\r\n    unique_ids = np.asarray(unique_ids)"]
[3298.735675, "o", "\r\n    point_order = np.argsort(point_secs[point_positions], kind=\"mergesort\")\r\n    current = {}\r\n    change_i = 0\r\n    for q in point_order:"]
[3298.735684, "o", "\r\n        original = int(point_positions[q])"]
[3298.735693, "o", "\r\n        t = int(point_secs[original])"]
[3298.735702, "o", "\r\n"]
[3298.73571, "o", "        code = int(point_codes[q])\r\n"]
[3298.735718, "o", "        cid = unique_ids[code] if code >= 0 else None\r\n"]
[3298.735773, "o", "        exists = pd.notna(final_signup.iloc[original]) and point_secs[original] > _seconds([final_signup.iloc[original]])[0][0]\r\n        while change_i < len(change_commit) and change_commit[change_i] < t:\r\n            ccode = int(change_codes[change_i])\r\n            changed = int(change_changed[change_i])\r\n            if ccode not in current or changed >= current[ccode][0]:\r\n                current[ccode] = (changed, change_plan[change_i])\r\n"]
[3298.7358, "o", "            change_i += 1\r\n\r\n"]
[3298.735816, "o", "        if not exists:\r\n            plan_known[original] = login_known[original] = True\r\n            continue\r\n"]
[3298.735825, "o", "        if pd.notna(final_updated.iloc[original]) and _seconds([final_updated.iloc[original]])[0][0] < t:\r\n"]
[3298.735833, "o", "            plan[original] = final_plan.iloc[original]\r\n"]
[3298.735842, "o", "            plan_known[original] = True\r\n"]
[3298.735851, "o", "            if pd.notna(final_login.iloc[original]) and _seconds([final_login.iloc[original]])[0][0] < t:"]
[3298.735859, "o", "\r\n                login_days[original] = (t - _seconds([final_login.iloc[original]])[0][0]) / 86400.0"]
[3298.735911, "o", "\r\n            login_known[original] = True"]
[3298.735956, "o", "\r\n            continue\r\n        if code >= 0 and code in current:\r\n            plan[original] = current[code][1]\r\n            plan_known[original] = True\r\n        elif no_changes.iloc[original]:\r\n            plan[original] = final_plan.iloc[original]"]
[3298.735972, "o", "\r\n            plan_known[original] = True\r\n\r\n    keep_plan = bool(plan_known.all())\r\n    keep_login = bool(login_known.all())\r\n    return plan if keep_plan else None, login_days if keep_login else None, keep_plan, keep_login\r\n"]
