[81.623131, "i", "python - <<'PY'\nimport pandas as pd\nO=pd.read_csv('data/orders.csv')\nO['_loaded_at']=pd.to_datetime(O._loaded_at,utc=True)\nfor cutoff in ['2025-04-05','2025-04-06','2025-04-07','2025-05-31','2025-06-01','2025-06-02']:\n d=pd.Timestamp(cutoff,tz='UTC'); q=O[(O._loaded_at>=d)&(O._loaded_at<d+pd.Timedelta(days=1))]\n print('\\n',cutoff,len(q)); print(q[['order_id','ordered_at','_load_job','_loaded_at']].head(10).to_string(index=False))\nPY\n"]
