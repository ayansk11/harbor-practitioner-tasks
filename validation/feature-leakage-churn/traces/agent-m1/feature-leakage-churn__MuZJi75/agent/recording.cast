[83.525775, "i", "python - <<'PY'\nimport pandas as pd\nP=pd.read_csv('data/plan_changes.csv'); P['_loaded_at']=pd.to_datetime(P._loaded_at,utc=True)\nC=pd.read_csv('data/customers.csv'); L=pd.read_csv('data/labels.csv'); S=pd.read_csv('data/status_snapshots.csv')\nprint('plan rows',len(P),'ids',P.customer_id.nunique()); print(P.head())\nprint('customers',len(C),'updated'); C['_updated_at']=pd.to_datetime(C._updated_at,utc=True); print(C._updated_at.min(),C._updated_at.max(),C.signup_at.nunique())\nprint('labels loaded',len(L),L._loaded_at.nunique(),L.groupby('_loaded_at').size().describe())\nprint('status loaded',len(S),S._loaded_at.nunique(),S.groupby('_loaded_at').size().describe())\nPY\n"]
