[472.597682, "i", "python - <<'PY'\nimport pandas as pd,re,json\nC={int(json.loads(x)['txn']):json.loads(x) for x in open('data/_ops/commits.jsonl')}\nR=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.split(maxsplit=2)\n if len(a)==3 and a[1]=='legacy_orders':\n  z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n  if z: R.append((pd.Timestamp(z.group(1)),pd.Timestamp(z.group(2)),int(z.group(3)),int(z.group(4)),z.group(5),C[int(z.group(4))]['at'],C[int(z.group(4))]['outcome']))\nprint('records',len(R))\nfor r in R:\n if r[1].date().isoformat() in {'2024-01-03','2024-01-11','2024-01-18'}: print(r)\nPY\n"]
