[192.311778, "i", "python - <<'PY'\nimport re,collections\nsel=collections.Counter()\nfor l in open('data/_ops/scheduler.log'):\n a=l.split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n m=a[2]\n if m.startswith('selected orders'):\n  z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',m)\n  if z: sel[z.groups()[:3]]+=1\nfor k,n in sel.items(): print(k,n)\nprint('total selection lines',sum(sel.values()),'keys',len(sel))\nPY\n"]
