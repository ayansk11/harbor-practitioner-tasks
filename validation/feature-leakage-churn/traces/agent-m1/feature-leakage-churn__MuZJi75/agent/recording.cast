[1875.538938, "i", "cat > churn/windows.py <<'PY'\r\"\"\"Point-in-time activity windows used by the live-feature reconstruction.\"\"\"\rPY\r\rcat > churn/live_features.py <<'PY'\r\"\"\"Reconstruct the values computed by ``live/features.py`` from an extract.\r\rThe reconstruction uses only facts that were committed before each request.  For\rrows written by scheduled jobs this comes from ``_loaded_at`` (or, for the old\rorders generation, from the scheduler transaction records).  Rows written by the\rsign-up, ticket CDC and scoring services were committed at the source timestamps\rrecorded in the extract.\r\"\"\"\rfrom bisect import bisect_left, insort\r\rimport numpy as np\rimport pandas as pd\r\r\rdef _seconds(values):\r    values = pd.to_datetime(pd.Series(values), utc=True)\r    valid = values.notna().to_numpy()\r    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r    return out, valid\r\r\rclass _Fenwick:\r    def __init__(self, n):\r        self.n = n\r        self.counts = [0] * (n + 1)\r        self.amounts = [0] * (n + 1)\r\r    def"]
[1875.539028, "i", " add(self, i, amount):\r        i += 1\r        while i <= self.n:\r            self.counts[i] += 1\r            self.amounts[i] += amount\r            i += i & -i\r\r    def range(self, left, right):\r        if right <= left:\r            return 0, 0\r        return self._prefix(right) - self._prefix(left)\r\r    def _prefix(self, i):\r        count = amount = 0\r        while i > 0:\r            count += self.counts[i]\r            amount += self.amounts[i]\r            i -= i & -i\r        return count, amount\r\r\rdef _factorize_ids(a, b=None):\r    if b is None:\r        codes, unique = pd.factorize(pd.Series(a), sort=True)\r        return codes, unique\r    combined = pd.concat([pd.Series(a), pd.Series(b)], ignore_index=True)\r    codes, unique = pd.factorize(combined, sort=True)\r    return codes[: len(a)], codes[len(a) :], unique\r\r\rdef _event_features(points, events, commit_col, ts_col, *, amount_col=None,\r                    windows=(30,), need_last=False):\r    \"\"\"Evaluate event queries as events become visible through ``comm"]
[1875.539049, "i", "it_col``.\"\"\"\r    n = len(points)\r    result = {f\"count_{w}\": np.zeros(n, dtype=\"int64\") for w in windows}\r    if amount_col is not None:\r        result[\"spend\"] = np.zeros(n, dtype=\"int64\")\r    result[\"last\"] = np.full(n, np.nan, dtype=\"float64\")\r\r    point_secs, point_valid = _seconds(points[\"as_of\"])\r    point_positions = np.flatnonzero(point_valid)\r    if not len(point_positions):\r        return result\r    point_secs = point_secs[point_positions]\r\r    event_secs, event_valid = _seconds(events[ts_col])\r    event_commit, commit_valid = _seconds(events[commit_col])\r    event_mask = event_valid & commit_valid\r    event_positions = np.flatnonzero(event_mask)\r    event_secs = event_secs[event_positions]\r    event_commit = event_commit[event_positions]\r\r    if len(events):\r        point_codes, event_codes, _ = _factorize_ids(\r            points[\"customer_id\"].iloc[point_positions],\r            events[\"customer_id\"].iloc[event_positions],\r        )\r    else:\r        point_codes, _ = _factorize_ids(points[\"customer"]
[1875.53907, "i", "_id\"].iloc[point_positions])\r        event_codes = np.empty(0, dtype=\"int64\")\r\r    all_secs = np.concatenate([point_secs, event_secs]) if len(event_secs) else point_secs\r    base = int(all_secs.min())\r    span = int(all_secs.max()) - base + 1\r\r    point_keys = point_codes.astype(\"int64\") * span + (point_secs - base)\r    if len(event_secs):\r        event_keys = event_codes.astype(\"int64\") * span + (event_secs - base)\r        sorted_index = np.argsort(event_keys, kind=\"mergesort\")\r        event_keys = event_keys[sorted_index]\r        ranks = np.empty(len(event_keys), dtype=\"int64\")\r        ranks[sorted_index] = np.arange(len(event_keys), dtype=\"int64\")\r    else:\r        event_keys = np.empty(0, dtype=\"int64\")\r        ranks = np.empty(0, dtype=\"int64\")\r\r    if amount_col is not None and len(event_positions):\r        amounts = pd.to_numeric(events[amount_col].iloc[event_positions],\r                                errors=\"coerce\").fillna(0).astype(\"int64\").to_numpy()\r    else:\r        amounts = np.zeros(len(event_"]
