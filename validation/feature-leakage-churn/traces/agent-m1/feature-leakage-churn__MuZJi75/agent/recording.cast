[216.475785, "i", "python - <<'PY'\nimport pandas as pd,json\nC=pd.read_csv('data/customers.csv'); C['signup_at']=pd.to_datetime(C.signup_at,utc=True); C['_updated_at']=pd.to_datetime(C._updated_at,utc=True); C['last_login_at']=pd.to_datetime(C.last_login_at,utc=True)\nPC=pd.read_csv('data/plan_changes.csv'); PC['changed_at']=pd.to_datetime(PC.changed_at,utc=True); PC['_loaded_at']=pd.to_datetime(PC._loaded_at,utc=True)\nP=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))]); P['as_of']=pd.to_datetime(P.as_of,utc=True)\ndef plan_for(r):\n q=PC[(PC.customer_id==r.customer_id)&(PC._loaded_at<r.as_of)].sort_values(['changed_at','_loaded_at'])\n if len(q): return q.new_plan.iloc[-1]\n row=C[C.customer_id==r.customer_id]\n return row.plan.iloc[0] if row.iloc[0]._updated_at<r.as_of else None\nP['plan_rec']=[plan_for(r) for r in P.itertuples()]\nM=P.merge(pd.read_csv('data/scoring_points.csv')[['customer_id','as_of']].assign(as_of=lambda x:pd.to_dateti"]
