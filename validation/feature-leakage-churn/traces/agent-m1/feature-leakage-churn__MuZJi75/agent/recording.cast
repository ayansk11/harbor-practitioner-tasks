[261.596524, "i", "python - <<'PY'\nimport pandas as pd,re,json,collections\nO=pd.read_csv('data/orders.csv'); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True)\nnew=O[O._load_job.eq('orders_hourly')].copy(); new['day']=new.ordered_at.dt.floor('D')\ncomm={int(json.loads(l)['txn']):json.loads(l) for l in open('data/_ops/commits.jsonl')}\nsel=collections.defaultdict(list)\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='orders_hourly': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if z:\n  s,e,n,txn,table=z.groups(); sel[pd.Timestamp(s)].append((pd.Timestamp(e),int(n),comm[int(txn)],table))\nbad=[]\nfor d,items in sel.items():\n actual=int(new[new.ordered_at.ge(d)&new.ordered_at.lt(items[0][0])].shape[0])\n committed=sum(n for _,n,x,_ in items if x['outcome']=='commit')\n rolled=sum(n for _,n,x,_ in items if x['outcome']=='rollback')\n if actual!=committed:\n  bad.append((d,actual,committed,rolled,items))\nprint('ho"]
[261.596654, "i", "urly days',len(sel),'bad',len(bad)); print(bad[:5])\nPY\n"]
