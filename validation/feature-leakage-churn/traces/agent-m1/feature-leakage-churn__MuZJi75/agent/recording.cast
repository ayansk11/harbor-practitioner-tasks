[1652.394292, "o", "\u001b[?2004l\r"]
[1652.394354, "o", "\u001b[?2004h> "]
[1652.394555, "o", "            if match:\r\n"]
[1652.394596, "o", "\u001b[?2004l\r"]
[1652.394675, "o", "\u001b[?2004h> "]
[1652.395067, "o", "                statements.setdefault(job, []).append(match.group(1))\r\n"]
[1652.395078, "o", "\u001b[?2004l\r"]
[1652.395147, "o", "\u001b[?2004h> "]
[1652.395249, "o", "                continue\r\n"]
[1652.395288, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.39533, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
