[462.327982, "i", "cat > /tmp/candidate.py <<'PY'\nimport json\nimport numpy as np\nimport pandas as pd\nfrom churn.extract import load_extract\nT=load_extract('data')\nP=T['scoring_points']; C=T['customers']; O=T['orders']; K=T['tickets']; S=T['status_snapshots']; L=T['labels']; PC=T['plan_changes']\n# Live sample\nQ=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))])\nQ['as_of']=pd.to_datetime(Q.as_of,utc=True)\n\ndef feature_row(row):\n    cid=row.customer_id; t=row.as_of\n    oo=O[(O.customer_id==cid)&(O._loaded_at<t)&(O.ordered_at>=t-pd.Timedelta(days=7))&(O.ordered_at<t)]\n    o30=O[(O.customer_id==cid)&(O._loaded_at<t)&(O.ordered_at>=t-pd.Timedelta(days=30))&(O.ordered_at<t)]\n    kk=K[(K.customer_id==cid)&(K._loaded_at<t)&(K.opened_at>=t-pd.Timedelta(days=30))&(K.opened_at<t)]\n    cc=C[C.customer_id==cid].iloc[0]\n    ss=S[(S.customer_id==cid)&(S._loaded_at<t)]\n    pp=PC[(PC.customer_id==cid)&(PC._loaded_at<t)].sort_values('changed_at')\n    "]
[462.328206, "i", "hist=P[(P.customer_id==cid)&(P.as_of<t)&P.app_minutes_7d.notna()].sort_values('as_of')\n    lab=L[L._loaded_at<t].copy(); lab['district']=lab.customer_id.map(C.set_index('customer_id').postcode_district)\n    district=cc.postcode_district\n    if len(lab):\n        prior=lab.churned_30d.mean()\n        same=lab[lab.district==district]\n        n=len(same); s=same.churned_30d.sum()\n        te=(s+20*prior)/(n+20)\n    else:\n        te=.05\n    return {'orders_7d':len(oo),'orders_30d':len(o30),'spend_30d_cents':int(o30.amount_cents.sum()),'tickets_30d':len(kk),\n      'days_since_last_order':(t-oo.ordered_at.max()).total_seconds()/86400 if len(oo) else np.nan,\n      'tenure_days':(t-cc.signup_at).total_seconds()/86400,'status':ss.sort_values('snapshot_date').status.iloc[-1] if len(ss) else np.nan,\n      'plan':pp.new_plan.iloc[-1] if len(pp) else cc.signup_plan,'app_minutes_7d':row.app_minutes_7d if pd.notna(row.app_minutes_7d) else (hist.app_minutes_7d.iloc[-1] if len(hist) else np.nan),\n      'te_district':te}\ninitial="]
[462.328234, "o", "cat > /tmp/candidate.py <<'PY'"]
[462.328262, "i", "PC.sort_values(['customer_id','changed_at']).groupby('customer_id').first().old_plan\nsignup_plan=C.customer_id.map(initial).fillna(C.set_index('customer_id').plan)\nC['signup_plan']=signup_plan\nV=Q.apply(feature_row,axis=1,result_type='expand')\nfs=['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','app_minutes_7d','te_district']\nfor f in fs:\n a=Q[f]; b=V[f]\n try: bad=~(((a-b).abs()<=1e-6+1e-9*a.abs())|(a.isna()&b.isna()))\n except: bad=~((a==b)|(a.isna()&b.isna()))\n print(f,int(bad.sum()),'bad')\n if bad.any(): print(pd.DataFrame({'live':a[bad],'rec':b[bad]}).head(8).to_string(index=False))\nPY\npython /tmp/candidate.py\n"]
