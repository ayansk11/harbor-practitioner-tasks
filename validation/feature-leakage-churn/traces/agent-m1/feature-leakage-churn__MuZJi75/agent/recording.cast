[3565.005402, "o", "> "]
[3565.00582, "o", "    point_ids = points[\"customer_id\"].to_numpy(dtype=\"object\")[point_positions]\r\n\u001b[?2004l\r"]
[3565.005841, "o", "\u001b[?2004h"]
[3565.005865, "o", "> "]
[3565.006203, "o", "    codes, unique_ids = pd.factorize(np.concatenate([lab_ids, point_ids]), sort=True)\r\n\u001b[?2004l\r"]
[3565.006237, "o", "\u001b[?2004h> "]
[3565.0064, "o", "    lab_codes = np.asarray(codes[: len(labels)], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3565.006429, "o", "\u001b[?2004h> "]
[3565.006612, "o", "    point_codes = np.asarray(codes[len(labels):], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3565.006641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rm\u001b[?2004h"]
[3565.00667, "o", "> "]
[3565.006868, "o", "    customer_index = pd.Series(np.arange(len(customers), dtype=\"int64\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.006907, "o", "> "]
[3565.007079, "o", "                               index=customers[\"customer_id\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.007108, "o", "> "]
[3565.007363, "o", "    unique_customer = customer_index.reindex(unique_ids).to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r"]
[3565.007392, "o", "\u001b[?2004h> "]
[3565.007521, "o", "    has_customer = np.isfinite(unique_customer)\r\n\u001b[?2004l\r"]
[3565.00755, "o", "\u001b[?2004h> "]
[3565.007793, "o", "    customer_index = np.where(has_customer, unique_customer, 0).astype(\"int64\")\r\n\u001b[?2004l\r"]
[3565.007818, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r="]
[3565.007854, "o", "\u001b[?2004h> "]
