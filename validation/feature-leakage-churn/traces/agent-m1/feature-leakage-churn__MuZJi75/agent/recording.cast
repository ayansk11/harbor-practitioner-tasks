[3250.059312, "o", "\u001b[?2004h> "]
[3250.059529, "o", "                statements.setdefault(job, []).append(statement)\r\n\u001b[?2004l\r"]
[3250.059565, "o", "\u001b[?2004h> "]
[3250.05964, "o", "                continue\r\n\u001b[?2004l\r"]
[3250.059678, "o", "\u001b[?2004h> "]
[3250.059713, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3250.05987, "o", "            match = _SELECT_RE.search(message)\r\n\u001b[?2004l\r"]
[3250.059891, "o", "\u001b[?2004h"]
[3250.059936, "o", "> "]
[3250.059984, "o", "            if match:\r\n\u001b[?2004l\ri"]
[3250.060019, "o", "\u001b[?2004h> "]
[3250.06026, "o", "                start_s, end_s, rows, txn_s, table = match.groups()\r\n\u001b[?2004l\r"]
[3250.06031, "o", "\u001b[?2004h> "]
[3250.060418, "o", "                txn = int(txn_s)\r\n\u001b[?2004l\r"]
[3250.060453, "o", "\u001b[?2004h> "]
[3250.060615, "o", "                info = commits.get(txn, {})\r\n\u001b[?2004l\r"]
[3250.060649, "o", "\u001b[?2004h"]
[3250.060684, "o", "> "]
[3250.060951, "o", "                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None:\r\n\u001b[?2004l\r"]
[3250.06099, "o", "\u001b[?2004h"]
[3250.061029, "o", "> "]
[3250.061152, "o", "                    order_txns.append(OrderTxn(\r\n\u001b[?2004l\r"]
[3250.061187, "o", "\u001b[?2004h"]
[3250.061223, "o", "> "]
[3250.061447, "o", "                        _utc(start_s), _utc(end_s), int(rows), info[\"at\"],\r\n\u001b[?2004l\r"]
[3250.061482, "o", "\u001b[?2004h"]
[3250.061516, "o", "> "]
[3250.061692, "o", "                        _table_name(table or \"orders\"), txn,\r\n\u001b[?2004l\r"]
[3250.061728, "o", "\u001b[?2004h"]
[3250.061763, "o", "> "]
[3250.061809, "o", "                    ))\r\n\u001b[?2004l\r\u001b[?2004h"]
[3250.061841, "o", "> "]
[3250.061944, "o", "                statements[job] = []\r\n\u001b[?2004l\r"]
[3250.061989, "o", "\u001b[?2004h> "]
[3250.062048, "o", "                continue\r\n\u001b[?2004l\r"]
[3250.06208, "o", "\u001b[?2004h"]
[3250.062116, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3250.062243, "o", "            match = _SEND_RE.search(message)\r\n\u001b[?2004l\r"]
[3250.062277, "o", "\u001b[?2004h> "]
[3250.062336, "o", "            if match:\r\n\u001b[?2004l\r"]
[3250.062369, "o", "\u001b[?2004h"]
[3250.062405, "o", "> "]
[3250.062492, "o", "                txn = int(match.group(1))\r\n\u001b[?2004l\r"]
[3250.062525, "o", "\u001b[?2004h> "]
[3250.062653, "o", "                info = commits.get(txn, {})\r\n\u001b[?2004l\r"]
[3250.062687, "o", "\u001b[?2004h"]
[3250.062736, "o", "> "]
[3250.062999, "o", "                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None and statements.get(job):\r\n\u001b[?2004l\r"]
[3250.063045, "o", "\u001b[?2004h> "]
[3250.063156, "o", "                    schema_txns.append({\r\n\u001b[?2004l\r"]
[3250.063198, "o", "\u001b[?2004h> "]
[3250.06329, "o", "                        \"txn\": txn,\r\n\u001b[?2004l\r"]
[3250.063331, "o", "\u001b[?2004h> "]
[3250.063444, "o", "                        \"at\": info[\"at\"],\r\n\u001b[?2004l\r"]
[3250.063483, "o", "\u001b[?2004h> "]
[3250.063663, "o", "                        \"statements\": tuple(statements[job]),\r\n\u001b[?2004l\r"]
[3250.063702, "o", "\u001b[?2004h> "]
[3250.063764, "o", "                    })\r\n\u001b[?2004l\r"]
[3250.063802, "o", "\u001b[?2004h> "]
[3250.063908, "o", "                statements[job] = []\r\n\u001b[?2004l\r"]
[3250.063947, "o", "\u001b[?2004h> "]
[3250.063963, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3250.064094, "o", "    schema_txns.sort(key=lambda x: x[\"at\"])\r\n\u001b[?2004l\r"]
[3250.064116, "o", "\u001b[?2004h> "]
[3250.064184, "o", "    rename_at = None\r\n\u001b[?2004l\r"]
[3250.064223, "o", "\u001b[?2004h> "]
[3250.064348, "o", "    identities = {\"orders\": \"orders-initial\"}\r\n\u001b[?2004l\r"]
[3250.064384, "o", "\u001b[?2004h> "]
[3250.064461, "o", "    for txn in schema_txns:\r\n\u001b[?2004l\r"]
[3250.064545, "o", "\u001b[?2004h> "]
[3250.064613, "o", "        before = identities.get(\"orders\")\r\n\u001b[?2004l\r"]
[3250.064655, "o", "\u001b[?2004h> "]
[3250.06478, "o", "        for statement in txn[\"statements\"]:\r\n\u001b[?2004l\r"]
[3250.064816, "o", "\u001b[?2004h> "]
[3250.064971, "o", "            match = _RENAME_RE.fullmatch(statement)\r\n\u001b[?2004l\r"]
[3250.06501, "o", "\u001b[?2004h> "]
[3250.065077, "o", "            if not match:\r\n\u001b[?2004l\r"]
[3250.065114, "o", "\u001b[?2004h> "]
[3250.065181, "o", "                continue\r\n\u001b[?2004l\r"]
[3250.065216, "o", "\u001b[?2004h> "]
[3250.065421, "o", "            old_name, new_name = map(_table_name, match.groups())\r\n\u001b[?2004l\r"]
[3250.065455, "o", "\u001b[?2004h> "]
[3250.065625, "o", "            identity = identities.pop(old_name, old_name)\r\n\u001b[?2004l\r"]
[3250.065668, "o", "\u001b[?2004h> "]
[3250.065797, "o", "            identities[new_name] = identity\r\n\u001b[?2004l\r"]
[3250.065832, "o", "\u001b[?2004h> "]
[3250.065953, "o", "        after = identities.get(\"orders\")\r\n\u001b[?2004l\r"]
[3250.065993, "o", "\u001b[?2004h> "]
[3250.066132, "o", "        if after != before and rename_at is None:\r\n\u001b[?2004l\r"]
[3250.066173, "o", "\u001b[?2004h> "]
[3250.066263, "o", "            rename_at = txn[\"at\"]\r\n\u001b[?2004l\r"]
[3250.066297, "o", "\u001b[?2004h> "]
[3250.066333, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3250.066577, "o", "    return Ops(order_txns=order_txns, schema_txns=schema_txns, rename_at=rename_at)\r\n\u001b[?2004l\r"]
[3250.066613, "o", "\u001b[?2004h> "]
[3250.066649, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3250.066681, "o", "> "]
[3250.066736, "o", "def _seconds(values):\r\n\u001b[?2004l\r"]
[3250.066768, "o", "\u001b[?2004h> "]
[3250.066941, "o", "    values = pd.to_datetime(pd.Series(values), utc=True)\r\n\u001b[?2004l\r"]
[3250.066988, "o", "\u001b[?2004h> "]
[3250.067086, "o", "    valid = values.notna().to_numpy()\r\n\u001b[?2004l\r"]
[3250.067108, "o", "\u001b[?2004h> "]
[3250.067367, "o", "    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n\u001b[?2004l\r"]
[3250.067408, "o", "\u001b[?2004h> "]
[3250.067463, "o", "    return out, valid\r\n\u001b[?2004l\r"]
[3250.067503, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3250.067544, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3250.067578, "o", "> "]
[3250.067739, "o", "def assign_legacy_order_commits(orders, ops, rename_at):\r\n\u001b[?2004l\r"]
[3250.067782, "o", "\u001b[?2004h> "]
[3250.068012, "o", "    \"\"\"Assign old-generation commit times to orders from scheduler intervals.\r\n\u001b[?2004l\r"]
[3250.068052, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3250.068088, "o", "\u001b[?2004h> "]
[3250.068309, "o", "    A rolled-back legacy load is retried with an expanding ordered_at interval, so\r\n\u001b[?2004l\r"]
[3250.068349, "o", "\u001b[?2004h> "]
[3250.068587, "o", "    the earliest successful transaction containing an order timestamp is the load\r\n\u001b[?2004l\r"]
[3250.068621, "o", "\u001b[?2004h> "]
[3250.068863, "o", "    that first committed it to the old ``orders`` table.  Exact transaction counts\r\n\u001b[?2004l\r"]
[3250.068918, "o", "\u001b[?2004h> "]
[3250.069076, "o", "    are checked before the result is considered complete.\r\n\u001b[?2004l\r"]
[3250.069116, "o", "\u001b[?2004h> "]
[3250.06915, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[3250.069169, "o", "> "]
[3250.069276, "o", "    orders[\"_legacy_commit\"] = pd.NaT\r\n\u001b[?2004l\r"]
[3250.069317, "o", "\u001b[?2004h> "]
[3250.069418, "o", "    ops.legacy_orders_complete = True\r\n\u001b[?2004l\r"]
[3250.069458, "o", "\u001b[?2004h> "]
[3250.069522, "o", "    if rename_at is None:\r\n\u001b[?2004l\r"]
[3250.069562, "o", "\u001b[?2004h> "]
[3250.069597, "o", "        return\r\n\u001b[?2004l\r"]
[3250.069641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3250.069776, "o", "    records = [x for x in ops.order_txns\r\n\u001b[?2004l\r"]
[3250.069816, "o", "\u001b[?2004h> "]
[3250.070014, "o", "               if x.table == \"orders\" and x.commit < rename_at]\r\n\u001b[?2004l\r"]
[3250.070064, "o", "\u001b[?2004h> "]
[3250.070106, "o", "    if not records:\r\n\u001b[?2004l\r"]
[3250.070146, "o", "\u001b[?2004h> "]
[3250.070189, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[3250.070229, "o", "> "]
[3250.070388, "o", "    records.sort(key=lambda x: (x.start, x.commit, x.txn))\r\n\u001b[?2004l\r"]
[3250.070428, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3250.070598, "o", "    starts, _ = _seconds([x.start for x in records])\r\n\u001b[?2004l\r"]
[3250.070639, "o", "\u001b[?2004h> "]
[3250.070782, "o", "    ends, _ = _seconds([x.end for x in records])\r\n\u001b[?2004l\r"]
[3250.070824, "o", "\u001b[?2004h> "]
[3250.070994, "o", "    commit_secs, _ = _seconds([x.commit for x in records])\r\n\u001b[?2004l\r"]
[3250.071032, "o", "\u001b[?2004h> "]
[3250.071211, "o", "    event_secs, event_valid = _seconds(orders[\"ordered_at\"])\r\n\u001b[?2004l\r"]
[3250.071253, "o", "\u001b[?2004h> "]
[3250.071313, "o", "    if event_valid.any():\r\n\u001b[?2004l\r"]
[3250.071355, "o", "\u001b[?2004h> "]
[3250.071554, "o", "        unique, inverse, counts = np.unique(event_secs[event_valid],\r\n\u001b[?2004l\r"]
[3250.071593, "o", "\u001b[?2004h> "]
[3250.071841, "o", "                                            return_inverse=True, return_counts=True)\r\n\u001b[?2004l\r"]
[3250.071887, "o", "\u001b[?2004h> "]
[3250.072053, "o", "        assigned = np.full(len(unique), -1, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3250.072094, "o", "\u001b[?2004h> "]
[3250.072143, "o", "        active = []\r\n\u001b[?2004l\r"]
[3250.072166, "o", "\u001b[?2004h> "]
[3250.072221, "o", "        pos = 0\r\n\u001b[?2004l\r"]
[3250.072262, "o", "\u001b[?2004h> "]
[3250.072399, "o", "        for event_no, ts in enumerate(unique):\r\n\u001b[?2004l\r"]
[3250.072439, "o", "\u001b[?2004h> "]
[3250.072606, "o", "            while pos < len(records) and starts[pos] <= ts:\r\n\u001b[?2004l\r"]
[3250.072648, "o", "\u001b[?2004h> "]
[3250.072902, "o", "                heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))\r\n\u001b[?2004l\r"]
[3250.072945, "o", "\u001b[?2004h> "]
[3250.073002, "o", "                pos += 1\r\n\u001b[?2004l\r"]
[3250.073044, "o", "\u001b[?2004h> "]
[3250.07318, "o", "            while active and active[0][1] <= ts:\r\n\u001b[?2004l\r"]
[3250.07322, "o", "\u001b[?2004h> "]
[3250.073322, "o", "                heapq.heappop(active)\r\n\u001b[?2004l\r"]
[3250.073363, "o", "\u001b[?2004h> "]
[3250.073417, "o", "            if active:\r\n\u001b[?2004l\r"]
[3250.073441, "o", "\u001b[?2004h> "]
[3250.073603, "o", "                assigned[event_no] = active[0][2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[3250.073647, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3250.073839, "o", "        txn_counts = np.zeros(len(records), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3250.073905, "o", "\u001b[?2004h> "]
[3250.073953, "o", "        hit = assigned >= 0\r\n\u001b[?2004l\r"]
[3250.073997, "o", "\u001b[?2004h> "]
[3250.074044, "o", "        if hit.any():\r\n\u001b[?2004l\r"]
[3250.074084, "o", "\u001b[?2004h> "]
[3250.074265, "o", "            np.add.at(txn_counts, assigned[hit], counts[hit])\r\n\u001b[?2004l\r"]
[3250.074302, "o", "\u001b[?2004h> "]
[3250.074509, "o", "        expected = np.asarray([x.rows for x in records], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3250.07455, "o", "\u001b[?2004h> "]
[3250.074802, "o", "        ops.legacy_orders_complete = bool(np.array_equal(txn_counts, expected))\r\n\u001b[?2004l\r"]
[3250.074842, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3250.07508, "o", "        out = np.full(len(orders), np.iinfo(np.int64).min, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3250.075136, "o", "\u001b[?2004h> "]
[3250.075259, "o", "        positions = np.flatnonzero(event_valid)\r\n\u001b[?2004l\r"]
[3250.075295, "o", "\u001b[?2004h> "]
[3250.075388, "o", "        vals = assigned[inverse]\r\n\u001b[?2004l\r"]
[3250.075424, "o", "\u001b[?2004h> "]
[3250.075489, "o", "        good = vals >= 0\r\n\u001b[?2004l\r"]
[3250.075524, "o", "\u001b[?2004h> "]
[3250.075689, "o", "        out[positions[good]] = commit_secs[vals[good]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[3250.075722, "o", "> "]
[3250.075976, "o", "        result = pd.to_datetime(pd.Series(out, index=orders.index), unit=\"s\", utc=True)\r\n\u001b[?2004l\r"]
[3250.076004, "o", "\u001b[?2004h> "]
[3250.076267, "o", "        orders[\"_legacy_commit\"] = result.where(out != np.iinfo(np.int64).min, pd.NaT)\r\n\u001b[?2004l\r"]
[3250.07629, "o", "\u001b[?2004h"]
