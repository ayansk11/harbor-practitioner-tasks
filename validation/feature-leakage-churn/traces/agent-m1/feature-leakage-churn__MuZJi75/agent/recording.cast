[303.771488, "i", "python - <<'PY'\nimport pandas as pd\nPC=pd.read_csv('data/plan_changes.csv'); PC['_loaded_at']=pd.to_datetime(PC._loaded_at,utc=True); PC['changed_at']=pd.to_datetime(PC.changed_at,utc=True)\nC=pd.read_csv('data/customers.csv'); P=pd.read_csv('data/scoring_points.csv'); P['as_of']=pd.to_datetime(P.as_of,utc=True)\nfirst=PC.sort_values(['customer_id','changed_at']).groupby('customer_id').first().old_plan\nM=P.merge(C[['customer_id','plan']],on='customer_id',how='left')\nM['initial_expected']=M.customer_id.map(first).fillna(M.plan)\nprint('points',len(M),'plan changes loaded after point',int(PC.merge(P[['customer_id','as_of']],on='customer_id').query('_loaded_at >= as_of').shape[0]))\nprint('initial plans categories',M.initial_expected.value_counts().to_dict())\nprint('customers without change',len(C)-len(first))\nPY\n"]
