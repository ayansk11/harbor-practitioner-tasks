[2776.570595, "i", "python - <<'PY'\nimport pandas as pd,json\nS=pd.read_csv('data/status_snapshots.csv'); S['_loaded_at']=pd.to_datetime(S._loaded_at,utc=True); S['snapshot_date']=pd.to_datetime(S.snapshot_date,utc=True)\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))]); L['as_of']=pd.to_datetime(L.as_of,utc=True)\nF=pd.read_parquet('/tmp/fixed.parquet'); M=L.merge(F[['customer_id','as_of','status']],on=['customer_id','as_of'],suffixes=('_live','_off')); bad=M[M.status_live!=M.status_off]\nfor r in bad.itertuples():\n q=S[(S.customer_id==r.customer_id)&(S._loaded_at<r.as_of)].sort_values('snapshot_date')\n print('\\n',r.customer_id,r.as_of,'live',r.status_live,'off',r.status_off)\n print(q.tail(5).to_string(index=False))\n break\nPY\n"]
