[3565.016039, "o", "> "]
[3565.016304, "o", "            district_sum[district] = district_sum.get(district, 0) + (int(y) if finite else 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.016335, "o", "> "]
[3565.016412, "o", "            label_i += 1\r\n\u001b[?2004l\r"]
[3565.016454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3565.016495, "o", "]\u001b[?2004h> "]
[3565.016575, "o", "        if not pt_has_customer[q]:\r\n\u001b[?2004l\r"]
[3565.016607, "o", "\u001b[?2004h> "]
[3565.016657, "o", "            continue\r\n\u001b[?2004l\r"]
[3565.016701, "o", "\u001b[?2004h> "]
[3565.016844, "o", "        same_n = 0 if own < 0 else district_n.get(own, 0)\r\n\u001b[?2004l\r"]
[3565.016874, "o", "\u001b[?2004h> "]
[3565.017044, "o", "        same_sum = 0 if own < 0 else district_sum.get(own, 0)\r\n\u001b[?2004l\r"]
[3565.017074, "o", "\u001b[?2004h> "]
[3565.01724, "o", "        prior = global_sum / global_n if global_n else 0.05\r\n\u001b[?2004l\r"]
[3565.017272, "o", "\u001b[?2004h> "]
[3565.017482, "o", "        out[original] = (same_sum + 20.0 * prior) / (same_n + 20.0)\r\n\u001b[?2004l\r"]
[3565.017526, "o", "\u001b[?2004h> "]
[3565.01757, "o", "    return out\r\n\u001b[?2004l\r"]
[3565.017607, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3565.017639, "o", "t\u001b[?2004h> "]
[3565.017698, "o", "def app_minutes(points):\r\n\u001b[?2004l\r"]
[3565.01773, "o", "\u001b[?2004h> "]
[3565.017784, "o", "    n = len(points)\r\n\u001b[?2004l\r"]
[3565.017816, "o", "\u001b[?2004h> "]
[3565.017995, "o", "    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[3565.018027, "o", "\u001b[?2004h> "]
[3565.018216, "o", "    order = np.lexsort((point_secs, points[\"customer_id\"].to_numpy()))\r\n\u001b[?2004l\r"]
[3565.018252, "o", "\u001b[?2004h> "]
[3565.018446, "o", "    values = pd.Series(points[\"app_minutes_7d\"].iloc[order], copy=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.01849, "o", "> "]
[3565.018644, "o", "    filled = values.groupby(points[\"customer_id\"].iloc[order]).ffill()\r\n\u001b[?2004l\r"]
[3565.018686, "o", "\u001b[?2004h> "]
[3565.018777, "o", "    out = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[3565.018807, "o", "\u001b[?2004h> "]
[3565.018931, "o", "    out[order] = filled.to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.018962, "o", "> "]
[3565.019, "o", "    return out\r\n\u001b[?2004l\r"]
[3565.019039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.019074, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3565.019193, "o", "def customer_features(points, customers, plan_changes):\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.019226, "o", "> "]
[3565.019419, "o", "    \"\"\"Reconstruct plan/login where possible and report global reconstructability.\"\"\"\r\n\u001b[?2004l\r"]
[3565.01945, "o", "\u001b[?2004h> "]
[3565.01949, "o", "    n = len(points)\r\n\u001b[?2004l\r"]
[3565.019521, "o", "\u001b[?2004h> "]
[3565.019618, "o", "    plan = np.full(n, np.nan, dtype=object)\r\n\u001b[?2004l\r"]
[3565.019665, "o", "\u001b[?2004h> "]
[3565.019784, "o", "    login_days = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3565.019909, "o", "    plan_known = np.zeros(n, dtype=\"bool\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3565.020029, "o", "    login_known = np.zeros(n, dtype=\"bool\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.020063, "o", "> \r\n\u001b[?2004l\r"]
[3565.020101, "o", "\u001b[?2004h> "]
[3565.020242, "o", "    customer_by_id = customers.set_index(\"customer_id\", drop=False)\r\n\u001b[?2004l\r"]
[3565.020271, "o", "\u001b[?2004h> "]
[3565.020427, "o", "    final_plan = points[\"customer_id\"].map(customer_by_id[\"plan\"])\r\n\u001b[?2004l\r"]
[3565.020466, "o", "\u001b[?2004h> "]
[3565.020637, "o", "    final_login = points[\"customer_id\"].map(customer_by_id[\"last_login_at\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.02067, "o", "> "]
[3565.02084, "o", "    final_updated = points[\"customer_id\"].map(customer_by_id[\"_updated_at\"])\r\n\u001b[?2004l\r"]
[3565.020871, "o", "\u001b[?2004h> "]
[3565.021048, "o", "    final_signup = points[\"customer_id\"].map(customer_by_id[\"signup_at\"])\r\n\u001b[?2004l\r"]
[3565.021104, "o", "\u001b[?2004h> "]
[3565.021194, "o", "    final_plan = final_plan.to_numpy(dtype=object)\r\n\u001b[?2004l\r"]
[3565.021235, "o", "\u001b[?2004h> "]
[3565.02135, "o", "    final_login = pd.to_datetime(final_login, utc=True)\r\n\u001b[?2004l\r"]
[3565.02139, "o", "\u001b[?2004h> "]
[3565.021518, "o", "    final_updated = pd.to_datetime(final_updated, utc=True)\r\n\u001b[?2004l\r"]
[3565.021566, "o", "\u001b[?2004h> "]
[3565.021682, "o", "    final_signup = pd.to_datetime(final_signup, utc=True)\r\n\u001b[?2004l\r"]
[3565.021721, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3565.021758, "o", "\u001b[?2004h> "]
[3565.021867, "o", "    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.021938, "o", "> "]
[3565.022029, "o", "    signup_secs, signup_valid = _seconds(final_signup)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.022064, "o", "> "]
[3565.022188, "o", "    updated_secs, updated_valid = _seconds(final_updated)\r\n\u001b[?2004l\r"]
[3565.022223, "o", "\u001b[?2004h> "]
[3565.022337, "o", "    login_secs, login_valid = _seconds(final_login)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.022385, "o", "> \r\n\u001b[?2004l\r"]
[3565.022424, "o", "\u001b[?2004h> "]
[3565.02257, "o", "    change_commit, change_commit_valid = _seconds(plan_changes[\"_loaded_at\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.022613, "o", "> "]
[3565.022785, "o", "    change_changed, change_changed_valid = _seconds(plan_changes[\"changed_at\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.022834, "o", "> "]
[3565.022964, "o", "    change_valid = change_commit_valid & change_changed_valid\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.02301, "o", "> "]
[3565.023107, "o", "    change_positions = np.flatnonzero(change_valid)\r\n\u001b[?2004l\r"]
[3565.023143, "o", "\u001b[?2004h> "]
[3565.023254, "o", "    change_commit = change_commit[change_positions]\r\n\u001b[?2004l\r"]
[3565.023293, "o", "\u001b[?2004h> "]
[3565.023408, "o", "    change_changed = change_changed[change_positions]\r\n\u001b[?2004l\r"]
[3565.023445, "o", "\u001b[?2004h> "]
[3565.023642, "o", "    change_ids = plan_changes[\"customer_id\"].to_numpy(dtype=\"object\")[change_positions]\r\n\u001b[?2004l\r"]
[3565.023677, "o", "\u001b[?2004h> "]
[3565.023866, "o", "    change_plans = plan_changes[\"new_plan\"].to_numpy(dtype=object)[change_positions]\r\n\u001b[?2004l\r"]
[3565.023914, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3565.023951, "o", "\u001b[?2004h> "]
[3565.024111, "o", "    point_ids = points[\"customer_id\"].to_numpy(dtype=\"object\")[point_positions]\r\n\u001b[?2004l\r"]
[3565.024156, "o", "\u001b[?2004h> "]
[3565.024325, "o", "    codes, _ = pd.factorize(np.concatenate([point_ids, change_ids]), sort=True)\r\n\u001b[?2004l\r"]
[3565.024364, "o", "\u001b[?2004h> "]
[3565.024528, "o", "    point_codes = np.asarray(codes[: len(point_positions)], dtype=\"int64\")\r\n\u001b[?2004l\r"]
[3565.024575, "o", "\u001b[?2004h> "]
[3565.024731, "o", "    change_codes = np.asarray(codes[len(point_positions):], dtype=\"int64\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.024766, "o", "> "]
[3565.024912, "o", "    change_order = np.argsort(change_commit, kind=\"mergesort\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.024951, "o", "> "]
[3565.025048, "o", "    change_commit = change_commit[change_order]\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.025092, "o", "> "]
[3565.025187, "o", "    change_changed = change_changed[change_order]\r\n\u001b[?2004l\r"]
[3565.025235, "o", "\u001b[?2004h> "]
[3565.02532, "o", "    change_codes = change_codes[change_order]\r\n\u001b[?2004l\r"]
[3565.025364, "o", "\u001b[?2004h> "]
[3565.025455, "o", "    change_plans = change_plans[change_order]\r\n\u001b[?2004l\r"]
[3565.025495, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3565.025547, "o", "\u001b[?2004h> "]
[3565.025645, "o", "    point_order = np.argsort(point_secs, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[3565.025684, "o", "\u001b[?2004h> "]
[3565.025724, "o", "    latest_change = {}\r\n\u001b[?2004l\r"]
[3565.02576, "o", "\u001b[?2004h> "]
[3565.025792, "o", "    change_i = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.025826, "o", "> "]
[3565.025876, "o", "    for q in point_order:\r\n\u001b[?2004l\r"]
[3565.025931, "o", "\u001b[?2004h> "]
[3565.026012, "o", "        original = int(point_positions[q])\r\n\u001b[?2004l\r"]
[3565.026046, "o", "\u001b[?2004h> "]
[3565.026109, "o", "        t = int(point_secs[q])\r\n\u001b[?2004l\r"]
[3565.026142, "o", "\u001b[?2004h> "]
[3565.026217, "o", "        code = int(point_codes[q])\r\n\u001b[?2004l\r"]
[3565.026249, "o", "\u001b[?2004h> "]
[3565.026424, "o", "        while change_i < len(change_commit) and change_commit[change_i] < t:\r\n\u001b[?2004l\r"]
[3565.026458, "o", "\u001b[?2004h> "]
[3565.026562, "o", "            ccode = int(change_codes[change_i])\r\n\u001b[?2004l\r"]
[3565.026598, "o", "\u001b[?2004h> "]
[3565.026709, "o", "            changed = int(change_changed[change_i])\r\n\u001b[?2004l\r"]
[3565.026745, "o", "\u001b[?2004h> "]
[3565.026845, "o", "            current = latest_change.get(ccode)\r\n\u001b[?2004l\r"]
[3565.026878, "o", "\u001b[?2004h> "]
[3565.02701, "o", "            if current is None or changed >= current[0]:\r\n\u001b[?2004l\r"]
[3565.027047, "o", "\u001b[?2004h> "]
[3565.027205, "o", "                latest_change[ccode] = (changed, change_plans[change_i])\r\n\u001b[?2004l\r"]
[3565.02724, "o", "\u001b[?2004h> "]
[3565.027291, "o", "            change_i += 1\r\n\u001b[?2004l\r"]
[3565.027323, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.027355, "o", "> "]
[3565.027505, "o", "        # No customer row exists until the sign-up row is committed.\r\n\u001b[?2004l\r"]
[3565.027539, "o", "\u001b[?2004h> "]
[3565.027692, "o", "        if not signup_valid[original] or t <= signup_secs[original]:\r\n\u001b[?2004l\r"]
[3565.027726, "o", "\u001b[?2004h> "]
[3565.027867, "o", "            plan_known[original] = login_known[original] = True\r\n\u001b[?2004l\r"]
[3565.027924, "o", "\u001b[?2004h> "]
[3565.027963, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[3565.027997, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3565.028207, "o", "        # If the final customer row was last committed before t, it is exactly the\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.028243, "o", "> "]
[3565.028313, "o", "        # row the live query saw.\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.028347, "o", "> "]
[3565.028499, "o", "        if updated_valid[original] and updated_secs[original] < t:\r\n\u001b[?2004l\r"]
[3565.028533, "o", "\u001b[?2004h> "]
[3565.028649, "o", "            plan[original] = final_plan[original]\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.028683, "o", "> "]
[3565.028768, "o", "            plan_known[original] = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.028801, "o", "> "]
[3565.028895, "o", "            if login_valid[original]:\r\n\u001b[?2004l\r"]
[3565.028934, "o", "\u001b[?2004h> "]
[3565.029092, "o", "                login_days[original] = (t - login_secs[original]) / 86400.0\r\n\u001b[?2004l\r"]
[3565.029112, "o", "\u001b[?2004h> "]
[3565.029228, "o", "            login_known[original] = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.029311, "o", "> "]
[3565.029355, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3565.029395, "o", "\u001b[?2004h> "]
[3565.029588, "o", "        # Otherwise plan history can still supply a visible plan; login history cannot.\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.029631, "o", "> "]
[3565.029914, "o", "        current = latest_change.get(code)\r\n\u001b[?2004l\r\u001b[?2004h>         if current is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3565.029988, "o", "            plan[original] = current[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.030017, "o", "> "]
[3565.030115, "o", "            plan_known[original] = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[3565.030144, "o", "> \r\n\u001b[?2004l\r"]
[3565.030176, "o", "\u001b[?2004h> "]
[3565.030349, "o", "    return plan, login_days, bool(plan_known.all()), bool(login_known.all())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3565.030382, "o", "PY\r\n\u001b[?2004l\r"]
[3565.033512, "o", "\u001b[?2004h"]
[3565.033728, "o", "root@350a58e0-4994-406f-939c-27256b382ccb:/app# "]
[3565.033795, "o", "python -m py_compile churn/*.py\r\n\u001b[?2004l\r"]
[3565.075737, "o", "\u001b[?2004hroot@350a58e0-4994-406f-939c-27256b382ccb:/app# "]
[3565.709705, "i", "cat > churn/build_features.py <<'PY'\n\"\"\"Build the live-equivalent feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\nimport argparse\nimport os\n\nfrom churn.extract import load_extract\nfrom churn.live_features import (\n    app_minutes,\n    customer_features,\n    order_features,\n    status_features,\n    target_encoding,\n    ticket_features,\n)\nfrom churn.ops import assign_legacy_order_commits, load_ops\n\n\nBASE_COLUMNS = [\"customer_id\", \"as_of\"]\nLIVE_FEATURES = [\n    \"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\",\n    \"days_since_last_order\", \"tenure_days\", \"status\", \"plan\",\n    \"days_since_last_login\", \"app_minutes_7d\", \"te_district\",\n]\n\n\ndef build(data_dir):\n    tables = load_extract(data_dir)\n    points = tables[\"scoring_points\"].reset_index(drop=True)\n    customers = tables[\"customers\"]\n    orders = tables[\"orders\"].copy()\n    tickets = tables[\"tickets\"]\n    snapshots = tables[\"status_snapshots\"]\n    labels = tables[\"labels\"]\n    plan_changes = tables[\"plan_changes\"]"]
[3565.709751, "i", "\n\n    ops = load_ops(data_dir)\n    assign_legacy_order_commits(orders, ops, ops.rename_at)\n\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n    values, orders_known = order_features(\n        points, orders, ops.rename_at, ops.legacy_orders_complete,\n    )\n    if orders_known:\n        out[\"orders_7d\"] = values[\"orders_7d\"]\n        out[\"orders_30d\"] = values[\"orders_30d\"]\n        out[\"spend_30d_cents\"] = values[\"spend_30d_cents\"]\n        out[\"days_since_last_order\"] = values[\"days_since_last_order\"]\n\n    ticket_values = ticket_features(points, tickets)\n    if tickets[\"_loaded_at\"].notna().all() and tickets[\"opened_at\"].notna().all():\n        out[\"tickets_30d\"] = ticket_values\n\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\n    tenure = (points[\"as_of\"] - signup).dt.total_seconds() / 86400.0\n    exists = signup.notna() & (signup < points[\"as_of\"])\n    out[\"tenure_days\"] = tenure.where(exists)\n\n    status_values = status_features(points, snapshots)\n    if (snapshots[\"_lo"]
[3565.709894, "i", "aded_at\"].notna().all() and\n            snapshots[\"snapshot_date\"].notna().all()):\n        out[\"status\"] = status_values\n\n    plan, login, keep_plan, keep_login = customer_features(\n        points, customers, plan_changes\n    )\n    if keep_plan:\n        out[\"plan\"] = plan\n    if keep_login:\n        out[\"days_since_last_login\"] = login\n\n    out[\"app_minutes_7d\"] = app_minutes(points)\n    out[\"te_district\"] = target_encoding(points, labels, customers)\n\n    kept = [feature for feature in LIVE_FEATURES if feature in out.columns]\n    return out[BASE_COLUMNS + kept]\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    args = ap.parse_args()\n    features = build(args.data)\n    out_path = os.path.abspath(args.out)\n    os.makedirs(os.path.dirname(out_path), exist_ok=True)\n    features.to_parquet(out_path, index=False)\n    print(f\"wrote {len(feature"]
[3565.709938, "i", "s)} rows x {features.shape[1]} columns to {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\nPY\npython -m py_compile churn/*.py\nexport OMP_NUM_THREADS=1; SECONDS=0; python -m churn.build_features --data data --out /tmp/clean.parquet; rc=$?; echo \"rc=$rc elapsed=$SECONDS\"\n"]
[3565.710022, "o", "cat > churn/build_features.py <<'PY'\r\n\u001b[?2004l\r"]
[3565.71008, "o", "\u001b[?2004h> "]
[3565.710631, "o", "\"\"\"Build the live-equivalent feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\r\n\u001b[?2004l\r"]
[3565.710675, "o", "\u001b[?2004h> "]
[3565.710755, "o", "import argparse\r\n\u001b[?2004l\r"]
[3565.710787, "o", "\u001b[?2004h"]
[3565.710818, "o", "> "]
[3565.710848, "o", "import os\r\n\u001b[?2004l\r"]
[3565.710878, "o", "\u001b[?2004h"]
[3565.710917, "o", "> \r\n\u001b[?2004l\r"]
[3565.710948, "o", "\u001b[?2004h> "]
[3565.711122, "o", "from churn.extract import load_extract\r\n\u001b[?2004l\r"]
[3565.711163, "o", "\u001b[?2004h> "]
[3565.711326, "o", "from churn.live_features import (\r\n\u001b[?2004l\r"]
[3565.711355, "o", "\u001b[?2004h> "]
[3565.711448, "o", "    app_minutes,\r\n\u001b[?2004l\r"]
[3565.711478, "o", "\u001b[?2004h"]
[3565.711507, "o", "> "]
[3565.71159, "o", "    customer_features,\r\n\u001b[?2004l\r"]
[3565.711622, "o", "\u001b[?2004h> "]
[3565.711725, "o", "    order_features,\r\n\u001b[?2004l\r"]
[3565.711755, "o", "\u001b[?2004h"]
[3565.711786, "o", "> "]
[3565.71186, "o", "    status_features,\r\n\u001b[?2004l\r"]
[3565.71191, "o", "\u001b[?2004h"]
[3565.71194, "o", "> "]
[3565.712008, "o", "    target_encoding,\r\n\u001b[?2004l\r"]
[3565.712039, "o", "\u001b[?2004h"]
[3565.712071, "o", "> "]
[3565.712141, "o", "    ticket_features,\r\n\u001b[?2004l\r"]
[3565.71217, "o", "\u001b[?2004h"]
[3565.7122, "o", "> )\r\n\u001b[?2004l\r"]
