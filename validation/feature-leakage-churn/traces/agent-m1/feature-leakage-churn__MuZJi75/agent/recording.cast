[56.337334, "i", "python - <<'PY'\nimport collections,re\nC=collections.Counter(); E={}\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3: continue\n _,j,m=a\n if 'state=' in m:\n  typ=m[m.index('state='):].split()[0]\n else:\n  typ=m.split(':')[0] if ': ' in m else m.split()[0]\n  typ=re.sub(r'\\d.*$','',typ)[:40]\n C[(j,typ)]+=1; E.setdefault((j,typ),m)\nfor k in sorted(C):\n if k[0] not in ('orders_hourly','legacy_orders','billing_export','label_job','crm_sync'):\n  print(C[k],k,E[k])\nPY\n"]
