[2773.581541, "i", "python - <<'PY'\nimport pandas as pd,json\nfrom churn.extract import load_extract\nfrom churn.ops import load_ops,assign_legacy_order_commits\nT=load_extract('data'); O=T['orders'].copy(); ops=load_ops('data'); assign_legacy_order_commits(O,ops,ops.rename_at)\nprint('rename',ops.rename_at,'legacy complete',ops.legacy_orders_complete,'legacy commit nonnull',O._legacy_commit.notna().sum())\nprint(O.loc[O._legacy_commit.notna(),['customer_id','ordered_at','_load_job','_loaded_at','_legacy_commit']].head())\nprint(O.loc[O._legacy_commit.isna(),['customer_id','ordered_at','_load_job','_loaded_at']].head())\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))]); L['as_of']=pd.to_datetime(L.as_of,utc=True)\nprint(L.iloc[:5][['customer_id','as_of','days_since_last_order']].to_string(index=False))\nPY\n"]
