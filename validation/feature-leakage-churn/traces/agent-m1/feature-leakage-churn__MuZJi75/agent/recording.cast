[3165.684123, "o", "\r\ndef load_ops(data_dir):\r\n    commits = {}\r\n    path = os.path.join(data_dir, \"_ops\", \"commits.jsonl\")\r\n    if os.path.exists(path):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    row = json.loads(line)\r\n"]
[3165.684139, "o", "                    commits[int(row[\"txn\"])] = {\r\n                        \"at\": _utc(row[\"at\"]),\r\n                        \"outcome\": row.get(\"outcome\"),\r\n                        \"table\": row.get(\"table\"),\r\n                        \"rows\": row.get(\"rows\"),\r\n"]
[3165.684154, "o", "                    }\r\n\r\n    order_txns = []\r\n    schema_txns = []\r\n    statements = {}\r\n    with open(os.path.join(data_dir, \"_ops\", \"scheduler.log\"), encoding=\"utf-8\") as fh:\r\n        for line in fh:\r\n            parts = line.rstrip(\"\\n\").split(maxsplit=2)\r\n"]
[3165.68417, "o", "            if len(parts) != 3:\r\n                continue\r\n            job, message = parts[1], parts[2]\r\n\r\n            if message.startswith(\"state=running\"):\r\n                statements[job] = []\r\n                continue\r\n\r\n            match = _STATEMENT_RE.match(message)\r\n            if match:\r\n                statements.setdefault(job, []).append(match.group(1))\r\n                continue\r\n\r\n"]
[3165.684188, "o", "            match = _SELECT_RE.search(message)\r\n            if match:\r\n                start_s, end_s, rows, txn_s, table = match.groups()\r\n                txn = int(txn_s)\r\n                info = commits.get(txn, {})\r\n                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None:\r\n                    order_txns.append(OrderTxn(\r\n                        _utc(start_s), _utc(end_s), int(rows), info[\"at\"],\r\n"]
[3165.684202, "o", "                        _table_name(table or \"orders\"), txn,\r\n                    ))\r\n                statements[job] = []\r\n                continue\r\n"]
[3165.684217, "o", "\r\n            match = _SEND_RE.search(message)\r\n            if match:\r\n                txn = int(match.group(1))\r\n                info = commits.get(txn, {})\r\n                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None and statements.get(job):\r\n                    schema_txns.append({\r\n                        \"txn\": txn,\r\n                        \"at\": info[\"at\"],\r\n"]
[3165.684239, "o", "                        \"statements\": tuple(statements[job]),\r\n                    })\r\n                statements[job] = []\r\n\r\n    schema_txns.sort(key=lambda x: x[\"at\"])\r\n    names = {\"orders\": \"orders\"}\r\n    current_identity = names[\"orders\"]\r\n"]
[3165.684254, "o", "    rename_at = None\r\n    for txn in schema_txns:\r\n        for statement in txn[\"statements\"]:\r\n            match = _RENAME_RE.fullmatch(statement)\r\n            if not match:\r\n                continue\r\n            old_name, new_name = map(_table_name, match.groups())\r\n            names[new_name] = names.get(old_name, old_name)\r\n            if old_name != new_name:\r\n                names.pop(old_name, None)\r\n        if names.get(\"orders\") != current_identity:\r\n            if rename_at is None:\r\n"]
[3165.684269, "o", "                rename_at = txn[\"at\"]\r\n            current_identity = names.get(\"orders\")\r\n\r\n    return Ops(order_txns=order_txns, schema_txns=schema_txns, rename_at=rename_at)\r\n\r\n\r\n"]
[3165.684284, "o", "def _seconds(values):\r\n    values = pd.to_datetime(pd.Series(values), utc=True)\r\n    valid = values.notna().to_numpy()\r\n    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    return out, valid\r\n\r\n\r\n"]
[3165.684301, "o", "def assign_legacy_order_commits(orders, ops, rename_at):\r\n    \"\"\"Assign old-generation commit times to orders from scheduler intervals.\r\n\r\n    After a failed load the next legacy load uses an expanding ordered_at interval.\r\n    Thus the earliest successful transaction containing an order's timestamp is the\r\n    transaction that first committed it to the old ``orders`` generation.\r\n    \"\"\"\r\n    orders[\"_legacy_commit\"] = pd.NaT\r\n    ops.legacy_orders_complete = True\r\n    if rename_at is None:\r\n        return\r\n"]
[3165.684316, "o", "\r\n    records = [x for x in ops.order_txns\r\n               if x.table == \"orders\" and x.commit < rename_at]\r\n    if not records:\r\n"]
[3165.684331, "o", "        return\r\n    records.sort(key=lambda x: (x.start, x.commit, x.txn))\r\n\r\n    starts, _ = _seconds([x.start for x in records])\r\n    ends, _ = _seconds([x.end for x in records])\r\n"]
[3165.684345, "o", "    commit_secs, _ = _seconds([x.commit for x in records])\r\n    event_secs, event_valid = _seconds(orders[\"ordered_at\"])\r\n    if event_valid.any():\r\n        unique, inverse, counts = np.unique(event_secs[event_valid], return_inverse=True,\r\n                                            return_counts=True)\r\n        assigned = np.full(len(unique), -1, dtype=\"int64\")\r\n"]
[3165.684367, "o", "        active = []\r\n        pos = 0\r\n        for event_no, ts in enumerate(unique):\r\n            while pos < len(records) and starts[pos] <= ts:\r\n                heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))\r\n                pos += 1\r\n            while active and active[0][1] <= ts:\r\n                heapq.heappop(active)\r\n            if active:\r\n                assigned[event_no] = active[0][2]\r\n\r\n        txn_counts = np.zeros(len(records), dtype=\"int64\")\r\n        hit = assigned >= 0\r\n"]
[3165.684382, "o", "        if hit.any():\r\n            np.add.at(txn_counts, assigned[hit], counts[hit])\r\n"]
[3165.684408, "o", "        expected = np.asarray([x.rows for x in records], dtype=\"int64\")\r\n        ops.legacy_orders_complete = bool(np.array_equal(txn_counts, expected))\r\n\r\n        out = np.full(len(orders), np.iinfo(np.int64).min, dtype=\"int64\")\r\n        positions = np.flatnonzero(event_valid)\r\n        vals = assigned[inverse]\r\n        good = vals >= 0\r\n        out[positions[good]] = commit_secs[vals[good]]\r\n        result = pd.to_datetime(pd.Series(out, index=orders.index), unit=\"s\", utc=True)\r\n        orders[\"_legacy_commit\"] = result.where(out != np.iinfo(np.int64).min, pd.NaT)\r\n"]
[3165.684644, "o", "\u001b[?2004h"]
[3165.684657, "o", "root@350a58e0-4994-406f-939c-27256b382ccb:/app# "]
[3166.065125, "i", "sed -n '1,190p' churn/live_features.py\n"]
[3166.065283, "o", "sed -n '1,190p' churn/live_features.py\r\n\u001b[?2004l\r"]
[3166.066568, "o", "\"\"\"Reconstruct the values computed by ``live/features.py`` from an extract.\r\n\r\nThe reconstruction uses only facts that were committed before each request.  For\r\nrows written by scheduled jobs this comes from ``_loaded_at`` (or, for the old\r\norders generation, from the scheduler transaction records).  Rows written by the\r\nsign-up, ticket CDC and scoring services were committed at the source timestamps\r\nrecorded in the extract.\r\n\"\"\"\r\nfrom bisect import bisect_left, insort\r\n"]
[3166.066578, "o", "\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\n\r\n"]
[3166.066619, "o", "def _seconds(values):\r\n    values = pd.to_datetime(pd.Series(values), utc=True)\r\n    valid = values.notna().to_numpy()\r\n    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    return out, valid\r\n\r\n\r\nclass _Fenwick:\r\n    def __init__(self, n):\r\n        self.n = n\r\n        self.counts = [0] * (n + 1)\r\n        self.amounts = [0] * (n + 1)\r\n\r\n    def add(self, i, amount):\r\n        i += 1\r\n        while i <= self.n:\r\n"]
[3166.066637, "o", "            self.counts[i] += 1\r\n            self.amounts[i] += amount\r\n            i += i & -i\r\n\r\n    def range(self, left, right):\r\n"]
[3166.066654, "o", "        if right <= left:\r\n            return 0, 0\r\n        hi_count, hi_amount = self._prefix(right)\r\n        lo_count, lo_amount = self._prefix(left)\r\n        return hi_count - lo_count, hi_amount - lo_amount\r\n"]
[3166.06667, "o", "\r\n    def _prefix(self, i):\r\n        count = amount = 0\r\n        while i > 0:\r\n            count += self.counts[i]\r\n            amount += self.amounts[i]\r\n            i -= i & -i\r\n"]
[3166.066684, "o", "        return count, amount\r\n\r\n\r\ndef _factorize_ids(a, b=None):\r\n    if b is None:\r\n        codes, unique = pd.factorize(pd.Series(a), sort=True)\r\n        return codes, unique\r\n"]
[3166.066699, "o", "    combined = pd.concat([pd.Series(a), pd.Series(b)], ignore_index=True)\r\n    codes, unique = pd.factorize(combined, sort=True)\r\n    return codes[: len(a)], codes[len(a) :], unique\r\n\r\n\r\ndef _event_features(points, events, commit_col, ts_col, *, amount_col=None,\r\n                    windows=(30,), need_last=False):\r\n"]
[3166.066715, "o", "    \"\"\"Evaluate event queries as events become visible through ``commit_col``.\"\"\"\r\n    n = len(points)\r\n    result = {f\"count_{w}\": np.zeros(n, dtype=\"int64\") for w in windows}\r\n    if amount_col is not None:\r\n        result[\"spend\"] = np.zeros(n, dtype=\"int64\")\r\n    result[\"last\"] = np.full(n, np.nan, dtype=\"float64\")\r\n\r\n    point_secs, point_valid = _seconds(points[\"as_of\"])\r\n    point_positions = np.flatnonzero(point_valid)\r\n    if not len(point_positions):\r\n        return result"]
[3166.066728, "o", "\r\n    point_secs = point_secs[point_positions]\r\n\r\n"]
[3166.066744, "o", "    event_secs, event_valid = _seconds(events[ts_col])\r\n    event_commit, commit_valid = _seconds(events[commit_col])\r\n    event_mask = event_valid & commit_valid\r\n    event_positions = np.flatnonzero(event_mask)\r\n    event_secs = event_secs[event_positions]\r\n    event_commit = event_commit[event_positions]\r\n\r\n    if len(events):\r\n        point_codes, event_codes, _ = _factorize_ids(\r\n            points[\"customer_id\"].iloc[point_positions],"]
[3166.066759, "o", "\r\n            events[\"customer_id\"].iloc[event_positions],\r\n        )\r\n    else:\r\n"]
[3166.066773, "o", "        point_codes, _ = _factorize_ids(points[\"customer_id\"].iloc[point_positions])\r\n        event_codes = np.empty(0, dtype=\"int64\")\r\n\r\n    all_secs = np.concatenate([point_secs, event_secs]) if len(event_secs) else point_secs\r\n    base = int(all_secs.min())\r\n"]
[3166.066789, "o", "    span = int(all_secs.max()) - base + 1\r\n\r\n    point_keys = point_codes.astype(\"int64\") * span + (point_secs - base)\r\n    if len(event_secs):\r\n        event_keys = event_codes.astype(\"int64\") * span + (event_secs - base)\r\n"]
[3166.066809, "o", "        sorted_index = np.argsort(event_keys, kind=\"mergesort\")\r\n        event_keys = event_keys[sorted_index]\r\n        ranks = np.empty(len(event_keys), dtype=\"int64\")\r\n        ranks[sorted_index] = np.arange(len(event_keys), dtype=\"int64\")\r\n    else:\r\n        event_keys = np.empty(0, dtype=\"int64\")\r\n        ranks = np.empty(0, dtype=\"int64\")\r\n\r\n    if amount_col is not None and len(event_positions):\r\n"]
[3166.066822, "o", "        amounts = pd.to_numeric(events[amount_col].iloc[event_positions],\r\n                                errors=\"coerce\").fillna(0).astype(\"int64\").to_numpy()\r\n    else:\r\n        amounts = np.zeros(len(event_positions), dtype=\"int64\")\r\n\r\n"]
[3166.066839, "o", "    tree = _Fenwick(len(event_keys))\r\n    event_order = np.argsort(event_commit, kind=\"mergesort\")\r\n    event_commit = event_commit[event_order]\r\n    ranks = ranks[event_order]\r\n    event_secs = event_secs[event_order]\r\n    event_codes = event_codes[event_order]\r\n    amounts = amounts[event_order]\r\n\r\n"]
[3166.066857, "o", "    histories = [[] for _ in range(len(point_codes))] if need_last else None\r\n    event_pos = 0\r\n    for q, original in enumerate(point_positions):\r\n        t = int(point_secs[q])\r\n        code = int(point_codes[q])\r\n        while event_pos < len(event_order) and event_commit[event_pos] < t:\r\n            i = int(event_order[event_pos])\r\n            tree.add(int(ranks[event_pos]), int(amounts[event_pos]))\r\n            if histories is not None:\r\n                insort(histories[code], int(event_secs[event_pos]))"]
[3166.066871, "o", "\r\n            event_pos += 1\r\n\r\n"]
[3166.06691, "o", "        for window in windows:\r\n            lower_adj = max(t - int(window) * 86400 - base, 0)\r\n            upper_adj = max(t - base, 0)\r\n            left = bisect_left(event_keys, code * span + lower_adj)\r\n            right = bisect_left(event_keys, code * span + upper_adj)\r\n            count, _ = tree.range(left, right)\r\n"]
[3166.066927, "o", "            result[f\"count_{window}\"][original] = count\r\n\r\n        if amount_col is not None:\r\n            lower_adj = max(t - 30 * 86400 - base, 0)\r\n            upper_adj = max(t - base, 0)\r\n            left = bisect_left(event_keys, code * span + lower_adj)\r\n            right = bisect_left(event_keys, code * span + upper_adj)\r\n            result[\"spend\"][original] = tree.range(left, right)[1]\r\n\r\n        if histories is not None:\r\n            hist = histories[code]\r\n            hi = bisect_left(hist, t)\r\n            if hi:\r\n                result[\"last\"][original] = float(hist[hi - 1] - t) / 86400.0\r\n\r\n    return result\r\n\r\n"]
[3166.066942, "o", "\r\ndef order_features(points, orders, rename_at, legacy_orders_complete):\r\n"]
[3166.066964, "o", "    \"\"\"Live order features across the old and new physical orders tables.\"\"\"\r\n    n = len(points)\r\n    out = {\r\n        \"orders_7d\": np.zeros(n, dtype=\"int64\"),\r\n        \"orders_30d\": np.zeros(n, dtype=\"int64\"),\r\n        \"spend_30d_cents\": np.zeros(n, dtype=\"int64\"),\r\n        \"days_since_last_order\": np.full(n, np.nan, dtype=\"float64\"),\r\n    }"]
[3166.066978, "o", "\r\n    known = bool(orders[\"_loaded_at\"].notna().all() and legacy_orders_complete)\r\n\r\n    if rename_at is None:\r\n        values = _event_features(\r\n            points, orders, \"_loaded_at\", \"ordered_at\",\r\n            amount_col=\"amount_cents\", windows=(7, 30), need_last=True,\r\n"]
[3166.066992, "o", "        )\r\n        for name in out:\r\n            out[name] = values[\"spend\"] if name == \"spend_30d_cents\" else values.get(name, values[\"last\"])\r\n        return out, known\r\n\r\n"]
[3166.067004, "o", "    old_mask = (points[\"as_of\"] <= rename_at).to_numpy()\r\n    new_mask = ~old_mask\r\n    old_points = points.loc[old_mask].reset_index(drop=True)\r\n    new_points = points.loc[new_mask].reset_index(drop=True)\r\n\r\n    if old_mask.any():\r\n"]
[3166.067021, "o", "        old_events = orders.loc[orders[\"_legacy_commit\"].notna()].copy()\r\n        values = _event_features(\r\n            old_points, old_events, \"_legacy_commit\", \"ordered_at\",\r\n            amount_col=\"amount_cents\", windows=(7, 30), need_last=True,\r\n        )\r\n        out[\"orders_7d\"][old_mask] = values[\"count_7\"]\r\n        out[\"orders_30d\"][old_mask] = values[\"count_30\"]\r\n"]
[3166.067037, "o", "        out[\"spend_30d_cents\"][old_mask] = values[\"spend\"]\r\n        out[\"days_since_last_order\"][old_mask] = values[\"last\"]\r\n"]
