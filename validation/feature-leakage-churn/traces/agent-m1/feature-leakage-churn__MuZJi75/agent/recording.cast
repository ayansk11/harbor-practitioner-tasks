[516.915105, "i", "python - <<'PY'\nimport re,collections,pandas as pd\n# Show all legacy task timelines for duplicated selection windows.\nD=collections.defaultdict(list)\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n m=a[2]; z=re.search(r'ordered_at >= (\\S+)',m)\n if z: D[pd.Timestamp(z.group(1))].append((a[0],m))\nfor d,x in list(D.items()):\n if len(x)>1 and any('state=' in m for _,m in x): print(d,*x,sep='\\n  ')\nPY\n"]
