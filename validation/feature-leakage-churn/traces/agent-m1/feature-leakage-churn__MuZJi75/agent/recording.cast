[80.639183, "i", "python - <<'PY'\nimport pandas as pd\nO=pd.read_csv('data/orders.csv')\nO['_loaded_at']=pd.to_datetime(O._loaded_at,utc=True); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True)\nprint('rows',len(O),'ids',O.order_id.nunique())\nprint(O._load_job.value_counts(dropna=False))\nprint('load ranges by job')\nprint(O.groupby('_load_job').agg(rows=('order_id','size'), first_load=('_loaded_at','min'), last_load=('_loaded_at','max'), first_event=('ordered_at','min'), last_event=('ordered_at','max')).sort_index())\nfor cutoff in ['2025-04-05','2025-04-06','2025-04-07','2025-06-01','2025-06-08']:\n d=pd.Timestamp(cutoff,tz='UTC'); print(cutoff, ((O._loaded_at<d).sum(), (O._loaded_at>=d).sum()))\nPY\n"]
