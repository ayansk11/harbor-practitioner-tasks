[3564.931093, "o", "\u001b[?2004h"]
[3564.931124, "o", "> "]
[3564.931269, "o", "    def __init__(self, n):\r\n\u001b[?2004l\r"]
[3564.931301, "o", "\u001b[?2004h"]
[3564.931333, "o", "> "]
[3564.931429, "o", "        self.n = n\r\n\u001b[?2004l\r"]
[3564.931462, "o", "\u001b[?2004h"]
[3564.931495, "o", "> "]
[3564.93169, "o", "        self.counts = [0] * (n + 1)\r\n\u001b[?2004l\r"]
[3564.93172, "o", "\u001b[?2004h"]
[3564.931752, "o", "> "]
[3564.931968, "o", "        self.amounts = [0] * (n + 1)\r\n\u001b[?2004l\r"]
[3564.932011, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3564.932043, "o", "\u001b[?2004h"]
[3564.932073, "o", "> "]
[3564.932237, "o", "    def add(self, i, amount):\r\n\u001b[?2004l\r"]
[3564.932281, "o", "\u001b[?2004h> "]
[3564.932375, "o", "        i += 1\r\n\u001b[?2004l\r"]
[3564.93242, "o", "\u001b[?2004h"]
[3564.932457, "o", "> "]
[3564.932582, "o", "        while i <= self.n:\r\n\u001b[?2004l\r"]
[3564.932629, "o", "\u001b[?2004h> "]
[3564.932823, "o", "            self.counts[i] += 1\r\n\u001b[?2004l\r"]
[3564.932862, "o", "\u001b[?2004h> "]
[3564.933108, "o", "            self.amounts[i] += amount\r\n\u001b[?2004l\r"]
[3564.933139, "o", "\u001b[?2004h"]
[3564.933168, "o", "> "]
[3564.933293, "o", "            i += i & -i\r\n\u001b[?2004l\r"]
[3564.933339, "o", "\u001b[?2004h> "]
[3564.933368, "o", "\r\n\u001b[?2004l\r"]
[3564.933399, "o", "\u001b[?2004h> "]
[3564.933552, "o", "    def _prefix(self, i):\r\n\u001b[?2004l\r"]
[3564.933589, "o", "\u001b[?2004h"]
[3564.933621, "o", "> "]
[3564.933766, "o", "        count = amount = 0\r\n\u001b[?2004l\r"]
[3564.933796, "o", "\u001b[?2004h"]
[3564.933825, "o", "> "]
[3564.93394, "o", "        while i > 0:\r\n\u001b[?2004l\r"]
[3564.933977, "o", "\u001b[?2004h> "]
[3564.934212, "o", "            count += self.counts[i]\r\n\u001b[?2004l\r"]
[3564.934254, "o", "\u001b[?2004h> "]
[3564.934474, "o", "            amount += self.amounts[i]\r\n\u001b[?2004l\r"]
[3564.934509, "o", "\u001b[?2004h"]
[3564.93454, "o", "> "]
[3564.934655, "o", "            i -= i & -i\r\n\u001b[?2004l\r"]
[3564.934689, "o", "\u001b[?2004h"]
[3564.934721, "o", "> "]
[3564.934877, "o", "        return count, amount\r\n\u001b[?2004l\r"]
[3564.934919, "o", "\u001b[?2004h> "]
[3564.934961, "o", "\r\n\u001b[?2004l\r"]
[3564.934993, "o", "\u001b[?2004h> "]
[3564.935188, "o", "    def range(self, left, right):\r\n\u001b[?2004l\r"]
[3564.935218, "o", "\u001b[?2004h"]
[3564.935247, "o", "> "]
[3564.935385, "o", "        if right <= left:\r\n\u001b[?2004l\r"]
[3564.935417, "o", "\u001b[?2004h> "]
[3564.935573, "o", "            return 0, 0\r\n\u001b[?2004l\r"]
[3564.935602, "o", "\u001b[?2004h"]
[3564.935635, "o", "> "]
[3564.935918, "o", "        hi_count, hi_amount = self._prefix(right)\r\n\u001b[?2004l\r"]
[3564.935948, "o", "\u001b[?2004h"]
[3564.935982, "o", "> "]
[3564.936258, "o", "        lo_count, lo_amount = self._prefix(left)\r\n\u001b[?2004l\r"]
[3564.9363, "o", "\u001b[?2004h> "]
[3564.936649, "o", "        return hi_count - lo_count, hi_amount - lo_amount\r\n\u001b[?2004l\r"]
[3564.936681, "o", "\u001b[?2004h> "]
[3564.936714, "o", "\r\n\u001b[?2004l\r"]
[3564.936744, "o", "\u001b[?2004h> "]
