[3565.000674, "o", "\u001b[?2004h> "]
[3565.00103, "o", "            if scode not in latest or date > latest[scode][0]:\r\n\u001b[?2004l\r"]
[3565.00106, "o", "\u001b[?2004h> "]
[3565.001368, "o", "                latest[scode] = (date, statuses[snap_i])\r\n\u001b[?2004l\r"]
