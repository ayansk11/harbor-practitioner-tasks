[303.26818, "i", "python - <<'PY'\nimport pandas as pd\nP=pd.read_csv('data/scoring_points.csv'); P['as_of']=pd.to_datetime(P.as_of,utc=True)\nC=pd.read_csv('data/customers.csv'); C['signup_at']=pd.to_datetime(C.signup_at,utc=True); C['_updated_at']=pd.to_datetime(C._updated_at,utc=True)\nM=P.merge(C[['customer_id','signup_at','_updated_at']],on='customer_id',how='left')\nprint('points',len(P),'customer missing',M.signup_at.isna().sum())\nprint('as_of <= signup',int((M.as_of<=M.signup_at).sum()),'as_of < signup',int((M.as_of<M.signup_at).sum()))\nprint('customer updated before first point',int((M._updated_at<M.as_of).sum()))\nPY\n"]
