[1476.696798, "i", "cat > churn/ops.py <<'PY'\n\"\"\"Parse the warehouse scheduler records needed for point-in-time reconstruction.\"\"\"\nfrom dataclasses import dataclass\nimport json\nimport os\nimport re\n\nimport pandas as pd\n\n\n@dataclass(frozen=True)\nclass OrderTxn:\n    start: pd.Timestamp\n    end: pd.Timestamp\n    rows: int\n    commit: pd.Timestamp\n    table: str\n    txn: int\n\n\n@dataclass\nclass Ops:\n    order_txns: list\n    schema_txns: list\n    rename_at: pd.Timestamp | None = None\n\n\n_SELECT_RE = re.compile(\n    r\"selected\\s+orders\\s+where\\s+ordered_at\\s*>=\\s*(\\S+)\\s+\"\n    r\"and\\s+ordered_at\\s*<\\s*(\\S+):\\s*(\\d+)\\s+rows;\\s*\"\n    r\"sent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\"\n)\n_STATEMENT_RE = re.compile(r\"^statement:\\s*(.*)$\")\n_SEND_RE = re.compile(r\"\\bsent\\s+txn\\s+(\\d+)\\s+to\\s+commit(?:\\s+into\\s+(\\S+))?\")\n_RENAME_RE = re.compile(r\"ALTER\\s+TABLE\\s+(\\S+)\\s+RENAME\\s+TO\\s+(\\S+)\", re.I)\n\n\ndef _utc(value):\n    return pd.to_datetime(value, utc=True)\n\n\ndef _table_name(value):\n    return value.strip('\"`').split(\".\")[-1]\n\n\ndef load_op"]
[1476.696927, "i", "s(data_dir):\n    commits = {}\n    path = os.path.join(data_dir, \"_ops\", \"commits.jsonl\")\n    if os.path.exists(path):\n        with open(path, encoding=\"utf-8\") as fh:\n            for line in fh:\n                if not line.strip():\n                    continue\n                row = json.loads(line)\n                commits[int(row[\"txn\"])] = {\n                    \"at\": _utc(row[\"at\"]),\n                    \"outcome\": row.get(\"outcome\"),\n                    \"table\": row.get(\"table\"),\n                    \"rows\": row.get(\"rows\"),\n                }\n\n    order_txns = []\n    schema_txns = []\n    statements = []\n    with open(os.path.join(data_dir, \"_ops\", \"scheduler.log\"), encoding=\"utf-8\") as fh:\n        for line in fh:\n            parts = line.rstrip(\"\\n\").split(maxsplit=2)\n            if len(parts) != 3:\n                continue\n            message = parts[2]\n\n            if message.startswith(\"state=running\"):\n                statements = []\n                continue\n\n            match = _STATEMENT_RE.match(messag"]
[1476.696981, "i", "e)\n            if match:\n                statements.append(match.group(1))\n                continue\n\n            match = _SELECT_RE.search(message)\n            if match:\n                start_s, end_s, rows, txn_s, table = match.groups()\n                txn = int(txn_s)\n                commit = commits.get(txn, {}).get(\"at\")\n                if commits.get(txn, {}).get(\"outcome\") == \"commit\" and commit is not None:\n                    order_txns.append(OrderTxn(\n                        _utc(start_s), _utc(end_s), int(rows), commit,\n                        _table_name(table or \"orders\"), txn,\n                    ))\n                statements = []\n                continue\n\n            match = _SEND_RE.search(message)\n            if match:\n                txn = int(match.group(1))\n                if commits.get(txn, {}).get(\"outcome\") == \"commit\" and statements:\n                    schema_txns.append({\n                        \"txn\": txn,\n                        \"at\": commits[txn][\"at\"],\n                        \"s"]
