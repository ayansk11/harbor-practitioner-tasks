[1652.393157, "o", "\u001b[?2004h> "]
[1652.393472, "o", "                statements[job] = []\r\n"]
[1652.39353, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1652.393709, "o", "                continue\r\n"]
[1652.393746, "o", "\u001b[?2004l\r"]
[1652.393756, "o", "\u001b[?2004h"]
[1652.393829, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1652.393864, "o", "> "]
