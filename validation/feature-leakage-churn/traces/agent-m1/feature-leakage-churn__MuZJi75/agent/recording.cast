[341.841679, "i", "python - <<'PY'\nimport pandas as pd,re,json,collections\nO=pd.read_csv('data/orders.csv'); O['ordered_at']=pd.to_datetime(O.ordered_at,utc=True)\nold=O[O._load_job.eq('legacy_backfill')]; counts=old.ordered_at.dt.floor('D').value_counts().to_dict()\ncomm={int(json.loads(l)['txn']):json.loads(l) for l in open('data/_ops/commits.jsonl')}\nsel={}; bad=[]\nfor l in open('data/_ops/scheduler.log'):\n a=l.rstrip().split(maxsplit=2)\n if len(a)<3 or a[1]!='legacy_orders': continue\n z=re.search(r'ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)',a[2])\n if z:\n  d=pd.Timestamp(z.group(1)); n=int(z.group(3)); x=comm[int(z.group(4))]; sel[d]=(n,x)\n  actual=counts.get(d,0)\n  if not ((x['outcome']=='commit' and actual==n) or (x['outcome']=='rollback' and actual==0)): bad.append((str(d),n,x['outcome'],actual))\nprint('legacy selections',len(sel),'bad',len(bad),'rollbacks',sum(x['outcome']=='rollback' for _,x in sel.values()),'bad',bad[:5])\nPY\n"]
