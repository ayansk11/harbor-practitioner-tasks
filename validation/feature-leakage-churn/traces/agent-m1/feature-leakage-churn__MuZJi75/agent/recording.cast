[82.634665, "i", "python - <<'PY'\nimport json,pandas as pd\nC=pd.DataFrame([json.loads(x) for x in open('data/_ops/commits.jsonl')]); C['at']=pd.to_datetime(C.at,utc=True)\nfor txn in [7001430,7002954,7002955,7003133]: print(C[C.txn==txn].to_string(index=False))\nfor d in ['2025-04-06','2025-05-31','2025-06-01']:\n x=C[(C.at>=pd.Timestamp(d,tz='UTC'))&(C.at<pd.Timestamp(d,tz='UTC')+pd.Timedelta(days=1))]\n print('\\n',d, x.groupby(['job' if 'job' in x else 'table','outcome']).size())\nPY\n"]
