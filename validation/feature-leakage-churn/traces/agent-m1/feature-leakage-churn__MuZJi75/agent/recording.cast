[3141.431662, "o", "                        \"rows\": row.get(\"rows\"),\r\n                    }\r\n\r\n    order_txns = []\r\n    schema_txns = []\r\n    statements = {}\r\n    with open(os.path.join(data_dir, \"_ops\", \"scheduler.log\"), encoding=\"utf-8\") as fh:\r\n        for line in fh:\r\n            parts = line.rstrip(\"\\n\").split(maxsplit=2)\r\n            if len(parts) != 3:\r\n                continue\r\n            job, message = parts[1], parts[2]\r\n\r\n            if message.startswith(\"state=running\"):\r\n"]
[3141.431686, "o", "                statements[job] = []\r\n                continue\r\n\r\n            match = _STATEMENT_RE.match(message)\r\n            if match:\r\n                statements.setdefault(job, []).append(match.group(1))\r\n                continue\r\n\r\n            match = _SELECT_RE.search(message)\r\n            if match:\r\n                start_s, end_s, rows, txn_s, table = match.groups()\r\n                txn = int(txn_s)\r\n                info = commits.get(txn, {})\r\n"]
[3141.431712, "o", "                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None:\r\n                    order_txns.append(OrderTxn(\r\n                        _utc(start_s), _utc(end_s), int(rows), info[\"at\"],\r\n                        _table_name(table or \"orders\"), txn,\r\n                    ))\r\n                statements[job] = []\r\n                continue\r\n\r\n            match = _SEND_RE.search(message)\r\n            if match:\r\n                txn = int(match.group(1))\r\n                info = commits.get(txn, {})\r\n"]
[3141.431737, "o", "                if info.get(\"outcome\") == \"commit\" and info.get(\"at\") is not None and statements.get(job):\r\n                    schema_txns.append({\r\n                        \"txn\": txn,\r\n                        \"at\": info[\"at\"],\r\n                        \"statements\": tuple(statements[job]),\r\n                    })\r\n                statements[job] = []\r\n\r\n    schema_txns.sort(key=lambda x: x[\"at\"])\r\n    names = {\"orders\": \"orders\"}\r\n    current_identity = names[\"orders\"]\r\n    rename_at = None\r\n    for txn in schema_txns:\r\n        for statement in txn[\"statements\"]:\r\n"]
[3141.431761, "o", "            match = _RENAME_RE.fullmatch(statement)\r\n            if not match:\r\n                continue\r\n"]
[3141.431784, "o", "            old_name, new_name = map(_table_name, match.groups())\r\n            names[new_name] = names.get(old_name, old_name)\r\n            if old_name != new_name:\r\n                names.pop(old_name, None)\r\n        if names.get(\"orders\") != current_identity:\r\n            if rename_at is None:\r\n                rename_at = txn[\"at\"]\r\n            current_identity = names.get(\"orders\")\r\n\r\n    return Ops(order_txns=order_txns, schema_txns=schema_txns, rename_at=rename_at)\r\n\r\n\r\ndef _seconds(values):\r\n"]
[3141.431808, "o", "    values = pd.to_datetime(pd.Series(values), utc=True)\r\n    valid = values.notna().to_numpy()\r\n    out = values.to_numpy(dtype=\"datetime64[ns]\").astype(\"int64\") // 1_000_000_000\r\n    return out, valid\r\n\r\n\r\ndef assign_legacy_order_commits(orders, ops, rename_at):\r\n    \"\"\"Assign old-generation commit times to orders from scheduler intervals.\r\n\r\n    After a failed load the next legacy load uses an expanding ordered_at interval.\r\n    Thus the earliest successful transaction containing an order's timestamp is the\r\n    transaction that first committed it to the old ``orders`` generation.\r\n    \"\"\"\r\n    orders[\"_legacy_commit\"] = pd.NaT\r\n    ops.legacy_orders_complete = True\r\n    if rename_at is None:\r\n        return\r\n"]
[3141.431841, "o", "\r\n    records = [x for x in ops.order_txns\r\n               if x.table == \"orders\" and x.commit < rename_at]\r\n    if not records:\r\n        return\r\n    records.sort(key=lambda x: (x.start, x.commit, x.txn))\r\n\r\n    starts, _ = _seconds([x.start for x in records])\r\n    ends, _ = _seconds([x.end for x in records])\r\n    commit_secs, _ = _seconds([x.commit for x in records])\r\n    event_secs, event_valid = _seconds(orders[\"ordered_at\"])\r\n    if event_valid.any():\r\n        unique, inverse, counts = np.unique(event_secs[event_valid], return_inverse=True,\r\n                                            return_counts=True)\r\n"]
[3141.431864, "o", "        assigned = np.full(len(unique), -1, dtype=\"int64\")\r\n        active = []\r\n        pos = 0\r\n        for event_no, ts in enumerate(unique):\r\n            while pos < len(records) and starts[pos] <= ts:\r\n                heapq.heappush(active, (int(commit_secs[pos]), int(ends[pos]), pos))\r\n                pos += 1\r\n            while active and active[0][1] <= ts:\r\n                heapq.heappop(active)\r\n            if active:\r\n                assigned[event_no] = active[0][2]\r\n\r\n        txn_counts = np.zeros(len(records), dtype=\"int64\")\r\n        hit = assigned >= 0\r\n        if hit.any():\r\n            np.add.at(txn_counts, assigned[hit], counts[hit])\r\n        expected = np.asarray([x.rows for x in records], dtype=\"int64\")\r\n        ops.legacy_orders_complete = bool(np.array_equal(txn_counts, expected))\r\n\r\n        out = np.full(len(orders), np.iinfo(np.int64).min, dtype=\"int64\")\r\n        positions = np.flatnonzero(event_valid)\r\n"]
[3141.431891, "o", "        vals = assigned[inverse]\r\n        good = vals >= 0\r\n        out[positions[good]] = commit_secs[vals[good]]\r\n        result = pd.to_datetime(pd.Series(out, index=orders.index), unit=\"s\", utc=True)\r\n        orders[\"_legacy_commit\"] = result.where(out != np.iinfo(np.int64).min, pd.NaT)\r\n"]
