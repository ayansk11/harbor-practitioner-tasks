[3390.606201, "i", "python - <<'PY'\nimport json,pandas as pd\nO=pd.read_parquet('/tmp/fixed2.parquet')\nL=pd.DataFrame([{'customer_id':x['customer_id'],'as_of':x['as_of'],**x['features']} for x in map(json.loads,open('logs/live_2026-01_sample.jsonl'))])\nL['as_of']=pd.to_datetime(L.as_of,utc=True)\nM=L.merge(O,on=['customer_id','as_of'],how='left',suffixes=('_live','_off'))\nprint('shape',O.shape,'columns',list(O.columns),'unmatched',int(M['orders_7d_off'].isna().sum()))\nfor f in ['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','days_since_last_login','app_minutes_7d','te_district']:\n    if f not in O:\n        print(f,'omitted')\n        continue\n    a=M[f+'_live']; b=M[f+'_off']\n    if pd.api.types.is_numeric_dtype(a) and pd.api.types.is_numeric_dtype(b):\n        bad=~(((a-b).abs()<=1e-6+1e-9*a.abs())|(a.isna()&b.isna()))\n    else:\n        bad=~((a==b)|(a.isna()&b.isna()))\n    print(f,'mismatches',int(bad.sum()),'/',len(M),'off_null',int(b.isna().sum()))\n    if bad.any():"]
