[191.525468, "i", "python - <<'PY'\nimport re,collections,json\nlines=open('data/_ops/scheduler.log').read().splitlines()\nby=collections.defaultdict(list)\nfor s in lines:\n a=s.split(maxsplit=2)\n if len(a)<3: continue\n t,j,m=a\n if j in ('legacy_orders','orders_hourly','legacy_backfill','schema_migrations','crm_sync','billing_export','label_job','dq_checks'):\n  by[j].append((t,m))\nfor j in ('legacy_orders','orders_hourly','legacy_backfill','crm_sync'):\n print('\\n###',j)\n for pat in ['state=failed','selected','copied','sent txn','statement','state=running','state=success']:\n  q=[x for x in by[j] if pat in x[1]]\n  print(pat,len(q),q[:3])\nPY\n"]
