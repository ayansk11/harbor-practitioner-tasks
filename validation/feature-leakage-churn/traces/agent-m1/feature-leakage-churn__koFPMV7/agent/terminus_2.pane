cat > churn/build_features.py <<'PY'
"""Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>

This version respects point‑in‑time visibility by using the `_loaded_at` timestamp present in every
extract CSV (except `scoring_points`). It groups source tables by `customer_id` so that each scoring
point only processes the small subset belonging to its customer, avoiding the O(N*M) scans that
made the previous implementation hang.
"""

from __future__ import annotations

import argparse
import os
from typing import Dict, List

import numpy as np
import pandas as pd

from churn.extract import load_extract

FEATURE_COLUMNS = [
    "orders_7d",
    "orders_30d",
    "spend_30d_cents",
    "tickets_30d",
    "days_since_last_order",
    "tenure_days",
    "status",
    "plan",
    "days_since_last_login",
    "app_minutes_7d",
    "te_district",
]


def _district_encoding_point(
    as_of: pd.Timestamp,
    labels: pd.DataFrame,
    customers: pd.DataFrame,
    customer_id: int,
    m: int = 20,
) -> float | None:
    """Smoothed churn rate for the customer's postcode district.

    Only labels whose 30‑day outcome window has closed **and** whose `_loaded_at` is
    <= `as_of` are considered.
    """
    # Labels usable for this prediction
    closed = labels["as_of"] + pd.Timedelta(days=30)
    usable = (closed <= as_of) & (labels["_loaded_at"] <= as_of)
    valid = labels[usable]
    if valid.empty:
        return None
    # District mapping
    district_series = customers.set_index("customer_id")["postcode_district"]
    pt_district = district_series.get(customer_id)
    if pd.isna(pt_district):
        return None
    # Global prior churn rate
    prior = valid["churned_30d"].mean()
    # District‑specific counts
    label_districts = valid["customer_id"].map(district_series)
    mask = label_districts == pt_district
    n = int(mask.sum())
    s = int(valid.loc[mask, "churned_30d"].sum())
    return (s + m * prior) / (n + m)


def build(data_dir: str) -> pd.DataFrame:
    tables = load_extract(data_dir)
    scoring = tables["scoring_points"][["customer_id", "as_of", "app_minutes_7d"]].reset_index(drop=True)

    # Group source tables by customer for fast lookup
    def group_by(table: pd.DataFrame, sort_by: str) -> Dict[int, pd.DataFrame]:
        if table.empty:
            return {}
        # Ensure sorting for binary‑search like operations
        sorted_tbl = table.sort_values(["customer_id", sort_by])
        groups = {}
        for cid, grp in sorted_tbl.groupby("customer_id"):
            groups[cid] = grp
        return groups

    orders_by_cust = group_by(tables["orders"], "ordered_at")
    tickets_by_cust = group_by(tables["tickets"], "opened_at")
    status_by_cust = group_by(tables["status_snapshots"], "snapshot_date")
    labels_by_cust = group_by(tables["labels"], "as_of")
    customers_by_cid = tables["customers"].set_index("customer_id").to_dict("index")

    rows: List[dict] = []
    for _, row in scoring.iterrows():
        cid = int(row["customer_id"])
        as_of = row["as_of"]
        app_minutes = row.get("app_minutes_7d", np.nan)

        # ----- Orders -----
        orders_cust = orders_by_cust.get(cid)
        if orders_cust is not None:
            mask_vis = orders_cust["_loaded_at"] <= as_of
           wrote 57909 rows x 13 columns to features.parquet
