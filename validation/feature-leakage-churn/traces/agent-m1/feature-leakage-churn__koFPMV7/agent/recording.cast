[298.622796, "i", "cat > churn/build_features.py <<'PY'\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\n\nThis version respects point‑in‑time visibility by using the `_loaded_at` timestamp present in every\nextract CSV (except `scoring_points`). It groups source tables by `customer_id` so that each scoring\npoint only processes the small subset belonging to its customer, avoiding the O(N*M) scans that\nmade the previous implementation hang.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport os\nfrom typing import Dict, List\n\nimport numpy as np\nimport pandas as pd\n\nfrom churn.extract import load_extract\n\nFEATURE_COLUMNS = [\n    \"orders_7d\",\n    \"orders_30d\",\n    \"spend_30d_cents\",\n    \"tickets_30d\",\n    \"days_since_last_order\",\n    \"tenure_days\",\n    \"status\",\n    \"plan\",\n    \"days_since_last_login\",\n    \"app_minutes_7d\",\n    \"te_district\",\n]\n\n\ndef _district_encoding_point(\n    as_of: pd.Timestamp,\n    labels: pd.DataFrame,\n    customers: pd.DataFrame,\n    customer_i"]
[298.622837, "i", "d: int,\n    m: int = 20,\n) -> float | None:\n    \"\"\"Smoothed churn rate for the customer's postcode district.\n\n    Only labels whose 30‑day outcome window has closed **and** whose `_loaded_at` is\n    <= `as_of` are considered.\n    \"\"\"\n    # Labels usable for this prediction\n    closed = labels[\"as_of\"] + pd.Timedelta(days=30)\n    usable = (closed <= as_of) & (labels[\"_loaded_at\"] <= as_of)\n    valid = labels[usable]\n    if valid.empty:\n        return None\n    # District mapping\n    district_series = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    pt_district = district_series.get(customer_id)\n    if pd.isna(pt_district):\n        return None\n    # Global prior churn rate\n    prior = valid[\"churned_30d\"].mean()\n    # District‑specific counts\n    label_districts = valid[\"customer_id\"].map(district_series)\n    mask = label_districts == pt_district\n    n = int(mask.sum())\n    s = int(valid.loc[mask, \"churned_30d\"].sum())\n    return (s + m * prior) / (n + m)\n\n\ndef build(data_dir: str) -> pd.DataFrame"]
[298.622988, "o", "cat > churn/build_features.py <<'PY'\r\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\r\n\r\nThis version respects point‑in‑time visibility by using the `_loaded_at` timestamp present in every\r\nextract"]
