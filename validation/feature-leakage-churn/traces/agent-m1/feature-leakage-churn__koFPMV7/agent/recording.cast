[338.266643, "i", "cat > churn/build_features.py <<'PY'\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\n\nThis implementation respects point‑in‑time visibility by using the `_loaded_at` timestamp present in every extract CSV (except `scoring_points`). For each prediction point it filters the source tables to rows that were loaded no later than the prediction's `as_of` timestamp before computing the feature values.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport os\nfrom typing import List\n\nimport numpy as np\nimport pandas as pd\n\nfrom churn.extract import load_extract\n\nFEATURE_COLUMNS = [\n    \"orders_7d\",\n    \"orders_30d\",\n    \"spend_30d_cents\",\n    \"tickets_30d\",\n    \"days_since_last_order\",\n    \"tenure_days\",\n    \"status\",\n    \"plan\",\n    \"days_since_last_login\",\n    \"app_minutes_7d\",\n    \"te_district\",\n]\n\n\ndef _district_encoding_point(as_of: pd.Timestamp, labels: pd.DataFrame, customers: pd.DataFrame, customer_id: int, m: int = 20) -> float | None:\n    \"\"\"Co"]
[338.266824, "i", "mpute smoothed churn rate for the customer's postcode district.\n\n    Only labels whose 30‑day outcome window has closed and whose `_loaded_at` is <= `as_of` are considered.\n    \"\"\"\n    closed = labels[\"as_of\"] + pd.Timedelta(days=30)\n    usable = (closed <= as_of) & (labels[\"_loaded_at\"] <= as_of)\n    valid = labels[usable]\n    if valid.empty:\n        return None\n    district_series = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    pt_district = district_series.get(customer_id)\n    if pd.isna(pt_district):\n        return None\n    prior = valid[\"churned_30d\"].mean()\n    label_districts = valid[\"customer_id\"].map(district_series)\n    mask = label_districts == pt_district\n    n = int(mask.sum())\n    s = int(valid.loc[mask, \"churned_30d\"].sum())\n    return (s + m * prior) / (n + m)\n\n\ndef build(data_dir: str) -> pd.DataFrame:\n    tables = load_extract(data_dir)\n    scoring = tables[\"scoring_points\"][[\"customer_id\", \"as_of\", \"app_minutes_7d\"]].reset_index(drop=True)\n\n    orders = tables[\"orders\"]\n    "]
[338.266897, "i", "tickets = tables[\"tickets\"]\n    customers = tables[\"customers\"]\n    status_snapshots = tables[\"status_snapshots\"]\n    labels = tables[\"labels\"]\n\n    rows: List[dict] = []\n    for _, pt in scoring.iterrows():\n        cid = int(pt[\"customer_id\"])\n        as_of = pt[\"as_of\"]\n        app_minutes = pt.get(\"app_minutes_7d\", np.nan)\n\n        # ----- Orders -----\n        o_vis = orders[(orders[\"customer_id\"] == cid) & (orders[\"_loaded_at\"] <= as_of)]\n        o_7d = o_vis[(o_vis[\"ordered_at\"] < as_of) & (o_vis[\"ordered_at\"] >= as_of - pd.Timedelta(days=7))]\n        orders_7d = int(len(o_7d))\n        o_30d = o_vis[(o_vis[\"ordered_at\"] < as_of) & (o_vis[\"ordered_at\"] >= as_of - pd.Timedelta(days=30))]\n        orders_30d = int(len(o_30d))\n        spend_30d_cents = int(o_30d[\"amount_cents\"].sum())\n        past_orders = o_vis[o_vis[\"ordered_at\"] < as_of]\n        if not past_orders.empty:\n            last_order_ts = past_orders[\"ordered_at\"].max()\n            days_since_last_order = (as_of - last_order_ts).total_seconds() /"]
[338.266947, "i", " 86400\n        else:\n            days_since_last_order = np.nan\n\n        # ----- Tickets -----\n        t_vis = tickets[(tickets[\"customer_id\"] == cid) & (tickets[\"_loaded_at\"] <= as_of)]\n        t_30d = t_vis[(t_vis[\"opened_at\"] < as_of) & (t_vis[\"opened_at\"] >= as_of - pd.Timedelta(days=30))]\n        tickets_30d = int(len(t_30d))\n\n        # ----- Customer attributes -----\n        cust_vis = customers[(customers[\"customer_id\"] == cid) & (customers[\"_updated_at\"] <= as_of)]\n        if not cust_vis.empty:\n            # latest visible revision\n            cust_row = cust_vis.loc[cust_vis[\"_updated_at\"].idxmax()]\n            plan_val = cust_row[\"plan\"]\n            last_login = cust_row[\"last_login_at\"]\n            if pd.notnull(last_login) and last_login < as_of:\n                days_since_last_login = (as_of - last_login).total_seconds() / 86400\n            else:\n                days_since_last_login = np.nan\n            signup = cust_row[\"signup_at\"]\n            tenure_days = (as_of - signup).total_seconds() / "]
[338.266989, "i", "86400\n        else:\n            plan_val = np.nan\n            days_since_last_login = np.nan\n            tenure_days = np.nan\n\n        # ----- Status -----\n        snap_vis = status_snapshots[(status_snapshots[\"customer_id\"] == cid) & (status_snapshots[\"_loaded_at\"] <= as_of)]\n        day_cut = as_of.floor(\"D\")\n        eligible = snap_vis[snap_vis[\"snapshot_date\"] < day_cut]\n        if not eligible.empty:\n            latest_snap = eligible.sort_values(\"snapshot_date\").iloc[-1][\"status\"]\n        else:\n            latest_snap = np.nan\n\n        # ----- District encoding -----\n        te_district = _district_encoding_point(as_of, labels, customers, cid, m=20)\n\n        rows.append({\n            \"customer_id\": cid,\n            \"as_of\": as_of,\n            \"orders_7d\": orders_7d,\n            \"orders_30d\": orders_30d,\n            \"spend_30d_cents\": spend_30d_cents,\n            \"tickets_30d\": tickets_30d,\n            \"days_since_last_order\": days_since_last_order,\n            \"tenure_days\": tenure_days,\n            \"st"]
[338.267065, "i", "atus\": latest_snap,\n            \"plan\": plan_val,\n            \"days_since_last_login\": days_since_last_login,\n            \"app_minutes_7d\": app_minutes,\n            \"te_district\": te_district,\n        })\n\n    df = pd.DataFrame(rows)\n    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n    parser.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    args = parser.parse_args()\n    feats = build(args.data)\n    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\n    feats.to_parquet(args.out, index=False)\n    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\n\nif __name__ == \"__main__\":\n    main()\nPY\n"]
