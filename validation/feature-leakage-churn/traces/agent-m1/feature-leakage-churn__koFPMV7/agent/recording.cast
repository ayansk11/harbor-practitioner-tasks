[122.113322, "o", "\u001b[?2004h"]
[122.113338, "o", "> "]
[122.113597, "o", "    parser.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[122.113641, "o", "\u001b[?2004h"]
[122.113672, "o", "> "]
[122.113843, "o", "    parser.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[122.113869, "o", "\u001b[?2004h> "]
