[21.758615, "o", "cat churn/status.py\r\n\u001b[?2004l\r"]
[21.760074, "o", "\"\"\"Account status from the billing system's status snapshots, point in time (INC-2041).\r\n\r\nA snapshot dated D records the status at the end of day D, so a prediction at t may only use snapshots dated before\r\ndate(t).\r\n\"\"\"\r\nimport pandas as pd\r\n\r\n\r\ndef latest_status(points, snapshots):\r\n    \"\"\"Status of the customer's latest snapshot dated before the prediction's UTC date (null if none).\"\"\"\r\n    left = points[[\"customer_id\"]].assign(day=points[\"as_of\"].dt.floor(\"D\")).reset_index()\r\n    left = left.sort_values(\"day\", kind=\"mergesort\")\r\n    snaps = snapshots.sort_values(\"snapshot_date\", kind=\"mergesort\")[[\"customer_id\", \"snapshot_date\", \"status\"]]\r\n    snaps = snaps.assign(snapshot_date=snaps[\"snapshot_date\"].astype(left[\"day\"].dtype))\r\n    m = pd.merge_asof(left, snaps, left_on=\"day\", right_on=\"snapshot_date\", by=\"customer_id\",\r\n                      allow_exact_matches=False)\r\n    return m.set_index(\"index\")[\"status\"].reindex(points.index)\r\n"]
[21.76027, "o", "\u001b[?2004hroot@161f24ce-3c0c-44b4-b5d6-cf2d972a5f12:/app# "]
[22.136222, "i", "cat churn/attributes.py\n"]
[22.13738, "o", "cat churn/attributes.py\r\n\u001b[?2004l\r"]
[22.139697, "o", "\"\"\"Customer attributes from the customer record (new in v3): the subscription plan and the days since the last login.\r\n\r\nPoint in time: a last login at or after the prediction time is ignored (the feature is null then), so the feature\r\nnever looks ahead of t.\r\n\"\"\"\r\n\r\n\r\ndef plan(points, customers):\r\n    \"\"\"The customer's subscription plan.\"\"\"\r\n    return points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"])\r\n\r\n\r\ndef days_since_last_login(points, customers):\r\n    \"\"\"t minus the customer's last login, in days; null when the record has no login before t.\"\"\"\r\n    last = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"last_login_at\"])\r\n    days = (points[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    return days.where(last < points[\"as_of\"])\r\n"]
[22.139884, "o", "\u001b[?2004hroot@161f24ce-3c0c-44b4-b5d6-cf2d972a5f12:/app# "]
[22.510273, "i", "cat churn/encoding.py\n"]
[22.510498, "o", "cat churn/encoding.py\r\n"]
[22.51051, "o", "\u001b[?2004l\r"]
[22.512544, "o", "\"\"\"Target encoding of high-cardinality categoricals, point in time (INC-2041).\r\n\r\nA label row records whether the customer churned in the 30 days after its own prediction, so its outcome is final only\r\nonce that window has closed (as_of + 30 days). A prediction at t uses only labels whose window closed before t, for the\r\ndistrict counts and for the prior alike; its own label and every later one are never seen.\r\n\"\"\"\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\nPRIOR_WEIGHT = 20\r\nDEFAULT_PRIOR = 0.05\r\nLABEL_WINDOW_DAYS = 30\r\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n"]
[22.512555, "o", "STRIDE = 10 ** 10\r\n\r\n\r\ndef _seconds(ts):\r\n    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\r\n\r\ndef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n    \"\"\"Smoothed churn rate of the customer's postcode district, from labels whose window closed before t.\"\"\"\r\n    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n    lab_d = labels[\"customer_id\"].map(district)"]
[22.512563, "o", "\r\n    pt_d = points[\"customer_id\"].map(district)\r\n    codes, _ = pd.factorize(pd.concat([lab_d, pt_d], ignore_index=True))\r\n"]
[22.512652, "o", "    lab_code, pt_code = codes[:len(labels)].astype(\"int64\"), codes[len(labels):].astype(\"int64\")\r\n    closed = _seconds(labels[\"as_of\"]) + LABEL_WINDOW_DAYS * 86400\r\n    y = labels[\"churned_30d\"].to_numpy(dtype=\"int64\")\r\n    t = _seconds(points[\"as_of\"])\r\n\r\n    order = np.argsort(closed, kind=\"stable\")\r\n    ycum = np.concatenate([[0], np.cumsum(y[order])])\r\n    N = np.searchsorted(closed[order], t, side=\"left\")\r\n    S = ycum[N]\r\n    prior = np.full(len(t), DEFAULT_PRIOR)\r\n    has = N > 0\r\n    prior[has] = S[has] / N[has]\r\n\r\n    key = lab_code * STRIDE + closed\r\n    o2 = np.argsort(key, kind=\"stable\")\r\n    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])\r\n    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side=\"left\")\r\n    lo = np.searchsorted(key[o2], pt_code * STRIDE, side=\"left\")\r\n    n, s = hi - lo, ycum2[hi] - ycum2[lo]\r\n    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\r\n"]
