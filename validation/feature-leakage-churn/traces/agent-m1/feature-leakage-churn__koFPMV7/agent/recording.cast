[88.422998, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: churn/build_features.py\n+\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\n+\n+This implementation mirrors the live scoring service by ensuring that, for each prediction\n+point, only rows that were *visible* in the warehouse at that moment are used. Visibility is\n+determined by the `_loaded_at` column present in every extract CSV (except `scoring_points`).\n+\n+The original implementation relied on the full tables, which could leak future rows that were\n+back‑filled after a prediction timestamp. The revised `build` function iterates over each row\n+in `scoring_points` and filters each source table by both the event timestamp **and** the\n+`_loaded_at` timestamp before computing features. The logic for each feature is equivalent to\n+the original helpers (`activity_features`, `tenure_days`, `latest_status`, etc.) but applied\n+to the point‑in‑time subset.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import argp"]
[88.42315, "i", "arse\n+import os\n+from typing import List\n+\n+import numpy as np\n+import pandas as pd\n+\n+from churn.attributes import days_since_last_login, plan\n+from churn.impute import fill_app_minutes\n+from churn.extract import load_extract\n+from churn.status import latest_status\n+from churn.windows import activity_features, tenure_days\n+\n+FEATURE_COLUMNS = [\n+    \"orders_7d\",\n+    \"orders_30d\",\n+    \"spend_30d_cents\",\n+    \"tickets_30d\",\n+    \"days_since_last_order\",\n+    \"tenure_days\",\n+    \"status\",\n+    \"plan\",\n+    \"days_since_last_login\",\n+    \"app_minutes_7d\",\n+    \"te_district\",\n+]\n+\n+\n+def _district_encoding_point(\n+    point_idx: int,\n+    point: pd.Series,\n+    labels: pd.DataFrame,\n+    customers: pd.DataFrame,\n+    m: int = 20,\n+) -> float | None:\n+    \"\"\"Compute the smoothed churn rate for a single point.\n+\n+    Mirrors ``churn.encoding.district_encoding`` but respects the `_loaded_at`\n+    visibility constraint for the given ``as_of``.\n+    \"\"\"\n+    # Labels must have their 30‑day window closed before the "]
[88.423183, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.423215, "i", "prediction time.\n+    # The window closes at label.as_of + 30 days.\n+    as_of = point[\"as_of\"]\n+    closed = labels[\"as_of\"] + pd.Timedelta(days=30)\n+    mask = (closed <= as_of) & (labels[\"_loaded_at\"] <= as_of)\n+    valid_labels = labels[mask]\n+    if valid_labels.empty:\n+        return None\n+\n+    # Map customers to postcode districts.\n+    district_series = customers.set_index(\"customer_id\")[\"postcode_district\"]\n+    pt_district = district_series.get(point[\"customer_id\"])\n+    if pd.isna(pt_district):\n+        return None\n+\n+    # Prior churn rate (global) using the same smoothing weight as the original code.\n+    prior = valid_labels[\"churned_30d\"].mean()\n+\n+    # Count and sum of churned labels in the same district.\n+    label_districts = valid_labels[\"customer_id\"].map(district_series)\n+    district_mask = label_districts == pt_district\n+    n = int(district_mask.sum())\n+    s = int(valid_labels.loc[district_mask, \"churned_30d\"].sum())\n+    return (s + m * prior) / (n + m)\n+\n+\n+def build(data_dir: str"]
[88.423245, "o", "*** Begin Patch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.423274, "i", ") -> pd.DataFrame:\n+    \"\"\"Build the feature table respecting point‑in‑time visibility.\n+\n+    Parameters\n+    ----------\n+    data_dir: str\n+        Path to the directory that contains the seven CSV files of the extract.\n+    \"\"\"\n+    tables = load_extract(data_dir)\n+    points = tables[\"scoring_points\"][[\"customer_id\", \"as_of\"]].reset_index(drop=True)\n+\n+    # Pre‑load tables that will be repeatedly filtered.\n+    orders = tables[\"orders\"]\n+    tickets = tables[\"tickets\"]\n+    customers = tables[\"customers\"]\n+    status_snapshots = tables[\"status_snapshots\"]\n+    labels = tables[\"labels\"]\n+\n+    # Prepare a list to collect rows.\n+    rows: List[dict] = []\n+\n+    for idx, pt in points.iterrows():\n+        cid = pt[\"customer_id\"]\n+        as_of = pt[\"as_of\"]\n+\n+        # ---------- Activity windows ----------\n+        # Orders\n+        o_mask = (orders[\"customer_id\"] == cid) & (orders[\"ordered_at\"] < as_of) & (orders[\"_loaded_at\"] <= as_of)\n+        o_last7 = o_mask & (orders[\"ordered_at\"] >= as_of - pd"]
[88.423306, "i", ".Timedelta(days=7))\n+        o_last30 = o_mask & (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=30))\n+        orders_7d = int(o_last7.sum())\n+        orders_30d = int(o_last30.sum())\n+        spend_30d_cents = int(orders.loc[o_last30, \"amount_cents\"].sum())\n+\n+        # Tickets (30‑day window)\n+        t_mask = (tickets[\"customer_id\"] == cid) & (tickets[\"opened_at\"] < as_of) & (tickets[\"_loaded_at\"] <= as_of)\n+        t_last30 = t_mask & (tickets[\"opened_at\"] >= as_of - pd.Timedelta(days=30))\n+        tickets_30d = int(t_last30.sum())\n+\n+        # Days since last order (strictly before as_of)\n+        past_orders = orders[o_mask]\n+        if not past_orders.empty:\n+            last_order_ts = past_orders[\"ordered_at\"].max()\n+            days_since_last_order = (as_of - last_order_ts).total_seconds() / 86400\n+        else:\n+            days_since_last_order = np.nan\n+\n+        # ---------- Customer attributes (plan, login) ----------\n+        # Customer rows may have multiple revisions; pick the latest v"]
[88.42334, "o", "*** Add File: churn/build_features.py\r\n\u001b[?2004l\r"]
[88.423367, "i", "ersion visible at as_of.\n+        cust_vis = customers[(customers[\"customer_id\"] == cid) & (customers[\"_updated_at\"] <= as_of)]\n+        if not cust_vis.empty:\n+            # Keep the row with the greatest _updated_at (latest visible revision).\n+            cust_row = cust_vis.loc[cust_vis[\"_updated_at\"].idxmax()]\n+            plan_val = cust_row[\"plan\"]\n+            # days since last login – null if no login before as_of\n+            last_login = cust_row[\"last_login_at\"]\n+            if pd.notnull(last_login) and last_login < as_of:\n+                days_since_last_login = (as_of - last_login).total_seconds() / 86400\n+            else:\n+                days_since_last_login = np.nan\n+        else:\n+            plan_val = np.nan\n+            days_since_last_login = np.nan\n+\n+        # ---------- Tenure ----------\n+        if not cust_vis.empty:\n+            signup = cust_row[\"signup_at\"]\n+            tenure_days = (as_of - signup).total_seconds() / 86400\n+        else:\n+            tenure_days = np.nan\n+\n+"]
[88.423392, "o", "\u001b[?2004h> "]
[88.423417, "i", "        # ---------- Status ----------\n+        # Status snapshots are dated; only snapshots with snapshot_date < floor(as_of) are usable.\n+        snap_mask = (\n+            (status_snapshots[\"customer_id\"] == cid)\n+            & (status_snapshots[\"snapshot_date\"] < as_of.floor(\"D\"))\n+            & (status_snapshots[\"_loaded_at\"] <= as_of)\n+        )\n+        if snap_mask.any():\n+            latest_snap = status_snapshots.loc[snap_mask].sort_values(\"snapshot_date\").iloc[-1][\"status\"]\n+        else:\n+            latest_snap = np.nan\n+\n+        # ---------- App minutes (already pre‑computed per point) ----------\n+        app_minutes_7d = pt.get(\"app_minutes_7d\", np.nan)\n+\n+        # ---------- District encoding ----------\n+        te_district = _district_encoding_point(idx, pt, labels, customers, m=20)\n+\n+        rows.append(\n+            {\n+                \"customer_id\": cid,\n+                \"as_of\": as_of,\n+                \"orders_7d\": orders_7d,\n+                \"orders_30d\": orders_30d,\n+               "]
[88.423446, "i", " \"spend_30d_cents\": spend_30d_cents,\n+                \"tickets_30d\": tickets_30d,\n+                \"days_since_last_order\": days_since_last_order,\n+                \"tenure_days\": tenure_days,\n+                \"status\": latest_snap,\n+                \"plan\": plan_val,\n+                \"days_since_last_login\": days_since_last_login,\n+                \"app_minutes_7d\": app_minutes_7d,\n+                \"te_district\": te_district,\n+            }\n+        )\n+\n+    feats = pd.DataFrame(rows)\n+    # Preserve column order expected by downstream checks.\n+    return feats[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\n+\n+\n+def main() -> None:\n+    ap = argparse.ArgumentParser(description=__doc__)\n+    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n+    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\n+    args = ap.parse_args()\n+    feats = build(args.data)\n+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True\n+    feats.to_parquet(args.out, index=False)\n"]
[88.423474, "i", "+    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n+\n*** End Patch\nPATCH\n"]
[88.423653, "o", "+\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\r\n\u001b[?2004l\r"]
[88.423681, "o", "\u001b[?2004h> "]
[88.423709, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.423978, "o", "+This implementation mirrors the live scoring service by ensuring that, for each prediction\r\n\u001b[?2004l\r"]
[88.424, "o", "\u001b[?2004h> "]
[88.424287, "o", "+point, only rows that were *visible* in the warehouse at that moment are used. Visibility is\r\n\u001b[?2004l\r"]
[88.424306, "o", "\u001b[?2004h> "]
[88.424588, "o", "+determined by the `_loaded_at` column present in every extract CSV (except `scoring_points`).\r\n\u001b[?2004l\r"]
[88.424616, "o", "\u001b[?2004h> "]
[88.424631, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.424659, "o", "> "]
[88.425002, "o", "+The original implementation relied on the full tables, which could leak future rows that were\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.425057, "o", "> "]
[88.425371, "o", "+back‑filled after a prediction timestamp. The revised `build` function iterates over each row\r\n\u001b[?2004l\r"]
[88.425406, "o", "\u001b[?2004h> "]
[88.425726, "o", "+in `scoring_points` and filters each source table by both the event timestamp **and** the\r\n\u001b[?2004l\r"]
[88.425757, "o", "\u001b[?2004h> "]
[88.42612, "o", "+`_loaded_at` timestamp before computing features. The logic for each feature is equivalent to\r\n\u001b[?2004l\r"]
[88.426139, "o", "\u001b[?2004h"]
[88.426146, "o", "> "]
[88.426488, "o", "+the original helpers (`activity_features`, `tenure_days`, `latest_status`, etc.) but applied\r\n\u001b[?2004l\r"]
[88.4265, "o", "\u001b[?2004h"]
[88.426549, "o", "> "]
[88.426638, "o", "+to the point‑in‑time subset.\r\n\u001b[?2004l\r"]
[88.42669, "o", "\u001b[?2004h> +\"\"\"\r\n\u001b[?2004l\r"]
[88.426702, "o", "\u001b[?2004h"]
[88.426745, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.426888, "o", "+from __future__ import annotations\r\n\u001b[?2004l\r"]
[88.426899, "o", "\u001b[?2004h"]
[88.426942, "o", "> "]
[88.426983, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.427033, "o", "+import argparse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.42708, "o", "+import os\r\n\u001b[?2004l\r"]
[88.427092, "o", "\u001b[?2004h"]
[88.427137, "o", "> "]
[88.427202, "o", "+from typing import List\r\n\u001b[?2004l\r"]
[88.427238, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.427278, "o", "\u001b[?2004h> "]
[88.427339, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[88.427378, "o", "\u001b[?2004h> "]
[88.427444, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[88.42746, "o", "\u001b[?2004h"]
[88.427509, "o", "> "]
[88.427519, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.427722, "o", "+from churn.attributes import days_since_last_login, plan\r\n\u001b[?2004l\r"]
[88.427735, "o", "\u001b[?2004h"]
[88.427785, "o", "> "]
[88.427901, "o", "+from churn.impute import fill_app_minutes\r\n\u001b[?2004l\r"]
[88.427943, "o", "\u001b[?2004h"]
[88.427954, "o", "> "]
[88.428082, "o", "+from churn.extract import load_extract\r\n\u001b[?2004l\r"]
[88.428108, "o", "\u001b[?2004h> "]
[88.428253, "o", "+from churn.status import latest_status\r\n\u001b[?2004l\r"]
[88.428293, "o", "\u001b[?2004h> "]
[88.42849, "o", "+from churn.windows import activity_features, tenure_days\r\n\u001b[?2004l\r"]
[88.42853, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.428585, "o", "\u001b[?2004h"]
[88.428636, "o", "> +FEATURE_COLUMNS = [\r\n\u001b[?2004l\r"]
[88.42867, "o", "\u001b[?2004h> "]
[88.428733, "o", "+    \"orders_7d\",\r\n\u001b[?2004l\r"]
[88.428764, "o", "\u001b[?2004h> "]
[88.428832, "o", "+    \"orders_30d\",\r\n\u001b[?2004l\r"]
[88.428861, "o", "\u001b[?2004h> "]
[88.42895, "o", "+    \"spend_30d_cents\",\r\n\u001b[?2004l\r"]
[88.428983, "o", "\u001b[?2004h> "]
[88.429057, "o", "+    \"tickets_30d\",\r\n\u001b[?2004l\r"]
[88.429086, "o", "\u001b[?2004h> "]
[88.429199, "o", "+    \"days_since_last_order\",\r\n\u001b[?2004l\r"]
[88.42923, "o", "\u001b[?2004h> "]
[88.429294, "o", "+    \"tenure_days\",\r\n\u001b[?2004l\r"]
[88.429325, "o", "\u001b[?2004h> "]
[88.429376, "o", "+    \"status\",\r\n\u001b[?2004l\r"]
[88.429405, "o", "\u001b[?2004h> "]
[88.429452, "o", "+    \"plan\",\r\n\u001b[?2004l\r"]
[88.429484, "o", "\u001b[?2004h> "]
[88.429587, "o", "+    \"days_since_last_login\",\r\n\u001b[?2004l\r"]
[88.429616, "o", "\u001b[?2004h"]
[88.429648, "o", "> "]
[88.429741, "o", "+    \"app_minutes_7d\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.429808, "o", "+    \"te_district\",\r\n\u001b[?2004l\r"]
[88.429854, "o", "\u001b[?2004h> +]\r\n"]
[88.429893, "o", "\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.429935, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.429974, "o", "\u001b[?2004h> "]
[88.430062, "o", "+def _district_encoding_point(\r\n\u001b[?2004l\r"]
[88.430102, "o", "\u001b[?2004h> "]
[88.430166, "o", "+    point_idx: int,\r\n\u001b[?2004l\r"]
[88.430203, "o", "\u001b[?2004h> "]
[88.430278, "o", "+    point: pd.Series,\r\n\u001b[?2004l\r"]
[88.430315, "o", "\u001b[?2004h> "]
[88.430405, "o", "+    labels: pd.DataFrame,\r\n\u001b[?2004l\r"]
[88.430443, "o", "\u001b[?2004h> "]
[88.430543, "o", "+    customers: pd.DataFrame,\r\n\u001b[?2004l\r"]
[88.430581, "o", "\u001b[?2004h> "]
[88.430638, "o", "+    m: int = 20,\r\n\u001b[?2004l\r"]
[88.430675, "o", "\u001b[?2004h> "]
[88.430739, "o", "+) -> float | None:\r\n\u001b[?2004l\r"]
[88.430783, "o", "\u001b[?2004h> "]
[88.430986, "o", "+    \"\"\"Compute the smoothed churn rate for a single point.\r\n\u001b[?2004l\r"]
[88.431039, "o", "\u001b[?2004h> "]
[88.431077, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.431346, "o", "+    Mirrors ``churn.encoding.district_encoding`` but respects the `_loaded_at`\r\n\u001b[?2004l\r"]
[88.431405, "o", "\u001b[?2004h> "]
[88.431571, "o", "+    visibility constraint for the given ``as_of``.\r\n\u001b[?2004l\r"]
[88.43161, "o", "\u001b[?2004h> "]
[88.431648, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[88.431686, "o", "\u001b[?2004h> "]
[88.431959, "o", "+    # Labels must have their 30‑day window closed before the prediction time.\r\n\u001b[?2004l\r"]
[88.431996, "o", "\u001b[?2004h> "]
[88.432186, "o", "+    # The window closes at label.as_of + 30 days.\r\n\u001b[?2004l\r"]
[88.43223, "o", "\u001b[?2004h> "]
[88.432322, "o", "+    as_of = point[\"as_of\"]\r\n\u001b[?2004l\r"]
[88.432363, "o", "\u001b[?2004h> "]
[88.432546, "o", "+    closed = labels[\"as_of\"] + pd.Timedelta(days=30)\r\n\u001b[?2004l\r"]
[88.432584, "o", "\u001b[?2004h"]
[88.432623, "o", "> "]
[88.432821, "o", "+    mask = (closed <= as_of) & (labels[\"_loaded_at\"] <= as_of)\r\n\u001b[?2004l\r"]
[88.432862, "o", "\u001b[?2004h> "]
[88.43297, "o", "+    valid_labels = labels[mask]\r\n\u001b[?2004l\r"]
[88.433008, "o", "\u001b[?2004h> "]
[88.433105, "o", "+    if valid_labels.empty:\r\n\u001b[?2004l\r"]
[88.433147, "o", "\u001b[?2004h> "]
[88.433214, "o", "+        return None\r\n\u001b[?2004l\r"]
[88.433256, "o", "\u001b[?2004h> "]
[88.433294, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.433446, "o", "+    # Map customers to postcode districts.\r\n\u001b[?2004l\r"]
[88.433489, "o", "\u001b[?2004h> "]
[88.433774, "o", "+    district_series = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[88.433825, "o", "\u001b[?2004h> "]
[88.434031, "o", "+    pt_district = district_series.get(point[\"customer_id\"])\r\n\u001b[?2004l\r"]
[88.434064, "o", "\u001b[?2004h> "]
[88.434171, "o", "+    if pd.isna(pt_district):\r\n\u001b[?2004l\r"]
[88.434201, "o", "\u001b[?2004h> "]
[88.434286, "o", "+        return None\r\n\u001b[?2004l\r"]
[88.434317, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.434353, "o", "\u001b[?2004h> "]
[88.434672, "o", "+    # Prior churn rate (global) using the same smoothing weight as the original code.\r\n\u001b[?2004l\r"]
[88.434707, "o", "\u001b[?2004h> "]
[88.434891, "o", "+    prior = valid_labels[\"churned_30d\"].mean()\r\n\u001b[?2004l\r"]
[88.434927, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.434956, "o", "\u001b[?2004h> "]
[88.435193, "o", "+    # Count and sum of churned labels in the same district.\r\n\u001b[?2004l\r"]
[88.435224, "o", "\u001b[?2004h> "]
[88.435506, "o", "+    label_districts = valid_labels[\"customer_id\"].map(district_series)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.435538, "o", "> "]
[88.435726, "o", "+    district_mask = label_districts == pt_district\r\n\u001b[?2004l\r"]
[88.435755, "o", "\u001b[?2004h> "]
[88.435888, "o", "+    n = int(district_mask.sum())\r\n\u001b[?2004l\r"]
[88.435917, "o", "\u001b[?2004h> "]
[88.436176, "o", "+    s = int(valid_labels.loc[district_mask, \"churned_30d\"].sum())\r\n\u001b[?2004l\r"]
[88.436212, "o", "\u001b[?2004h> "]
[88.436357, "o", "+    return (s + m * prior) / (n + m)\r\n\u001b[?2004l\r"]
[88.436388, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.43641, "o", "\u001b[?2004h"]
[88.436428, "o", "> +\r\n\u001b[?2004l\r"]
[88.436451, "o", "\u001b[?2004h> "]
[88.436627, "o", "+def build(data_dir: str) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[88.436666, "o", "\u001b[?2004h> "]
[88.436932, "o", "+    \"\"\"Build the feature table respecting point‑in‑time visibility.\r\n\u001b[?2004l\r"]
[88.43697, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.437015, "o", "\u001b[?2004h> "]
[88.437072, "o", "+    Parameters\r\n\u001b[?2004l\r"]
[88.437126, "o", "\u001b[?2004h> "]
[88.437166, "o", "+    ----------\r\n\u001b[?2004l\r"]
[88.437204, "o", "\u001b[?2004h> "]
[88.437263, "o", "+    data_dir: str\r\n\u001b[?2004l\r"]
[88.437301, "o", "\u001b[?2004h> "]
[88.437598, "o", "+        Path to the directory that contains the seven CSV files of the extract.\r\n\u001b[?2004l\r"]
[88.437638, "o", "\u001b[?2004h> "]
[88.437676, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.437709, "o", "> "]
[88.437834, "o", "+    tables = load_extract(data_dir)\r\n\u001b[?2004l\r"]
[88.437872, "o", "\u001b[?2004h> "]
[88.438205, "o", "+    points = tables[\"scoring_points\"][[\"customer_id\", \"as_of\"]].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[88.438244, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.438274, "o", "\u001b[?2004h> "]
[88.438508, "o", "+    # Pre‑load tables that will be repeatedly filtered.\r\n\u001b[?2004l\r"]
[88.438548, "o", "\u001b[?2004h> "]
[88.438651, "o", "+    orders = tables[\"orders\"]\r\n\u001b[?2004l\r"]
[88.438684, "o", "\u001b[?2004h> "]
[88.438807, "o", "+    tickets = tables[\"tickets\"]\r\n\u001b[?2004l\r"]
[88.438843, "o", "\u001b[?2004h> "]
[88.43898, "o", "+    customers = tables[\"customers\"]\r\n\u001b[?2004l\r"]
[88.439018, "o", "\u001b[?2004h> "]
[88.439216, "o", "+    status_snapshots = tables[\"status_snapshots\"]\r\n\u001b[?2004l\r"]
[88.439254, "o", "\u001b[?2004h> "]
[88.439371, "o", "+    labels = tables[\"labels\"]\r\n\u001b[?2004l\r"]
[88.439409, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.439457, "o", "\u001b[?2004h> "]
[88.439585, "o", "+    # Prepare a list to collect rows.\r\n\u001b[?2004l\r"]
[88.439623, "o", "\u001b[?2004h> "]
[88.439722, "o", "+    rows: List[dict] = []\r\n\u001b[?2004l\r"]
[88.43975, "o", "\u001b[?2004h> "]
[88.439797, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.439826, "o", "> "]
[88.439942, "o", "+    for idx, pt in points.iterrows():\r\n\u001b[?2004l\r"]
[88.439981, "o", "\u001b[?2004h> "]
[88.440108, "o", "+        cid = pt[\"customer_id\"]\r\n\u001b[?2004l\r"]
[88.440134, "o", "\u001b[?2004h> "]
[88.440247, "o", "+        as_of = pt[\"as_of\"]\r\n\u001b[?2004l\r"]
[88.440286, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.440321, "o", "\u001b[?2004h> "]
[88.440512, "o", "+        # ---------- Activity windows ----------\r\n\u001b[?2004l\r"]
[88.44055, "o", "\u001b[?2004h> "]
[88.44061, "o", "+        # Orders\r\n\u001b[?2004l\r"]
[88.440649, "o", "\u001b[?2004h> "]
[88.441085, "o", "+        o_mask = (orders[\"customer_id\"] == cid) & (orders[\"ordered_at\"] < as_of) & (orders[\"_loaded_at\"] <= as_of)\r\n\u001b[?2004l\r"]
[88.441123, "o", "\u001b[?2004h> "]
[88.441373, "o", "+        o_last7 = o_mask & (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=7))\r\n\u001b[?2004l\r"]
[88.441401, "o", "\u001b[?2004h> "]
[88.441665, "o", "+        o_last30 = o_mask & (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=30))\r\n\u001b[?2004l\r"]
[88.441694, "o", "\u001b[?2004h> "]
[88.441814, "o", "+        orders_7d = int(o_last7.sum())\r\n\u001b[?2004l\r"]
[88.44184, "o", "\u001b[?2004h> "]
[88.441946, "o", "+        orders_30d = int(o_last30.sum())\r\n\u001b[?2004l\r"]
[88.441976, "o", "\u001b[?2004h> "]
[88.442171, "o", "+        spend_30d_cents = int(orders.loc[o_last30, \"amount_cents\"].sum())\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.442199, "o", "> +\r\n\u001b[?2004l\r"]
[88.442224, "o", "\u001b[?2004h> "]
[88.442316, "o", "+        # Tickets (30‑day window)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.442342, "o", "> "]
[88.442635, "o", "+        t_mask = (tickets[\"customer_id\"] == cid) & (tickets[\"opened_at\"] < as_of) & (tickets[\"_loaded_at\"] <= as_of)\r\n\u001b[?2004l\r"]
[88.442662, "o", "\u001b[?2004h> "]
[88.442875, "o", "+        t_last30 = t_mask & (tickets[\"opened_at\"] >= as_of - pd.Timedelta(days=30))\r\n\u001b[?2004l\r"]
[88.442899, "o", "\u001b[?2004h> "]
[88.443013, "o", "+        tickets_30d = int(t_last30.sum())\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.443048, "o", "> +\r\n\u001b[?2004l\r"]
[88.443072, "o", "\u001b[?2004h> "]
[88.44321, "o", "+        # Days since last order (strictly before as_of)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.443234, "o", "> "]
[88.443323, "o", "+        past_orders = orders[o_mask]\r\n\u001b[?2004l\r"]
[88.443347, "o", "\u001b[?2004h> "]
[88.443432, "o", "+        if not past_orders.empty:\r\n\u001b[?2004l\r"]
[88.443456, "o", "\u001b[?2004h> "]
[88.443603, "o", "+            last_order_ts = past_orders[\"ordered_at\"].max()\r\n\u001b[?2004l\r"]
[88.44363, "o", "\u001b[?2004h> "]
[88.44383, "o", "+            days_since_last_order = (as_of - last_order_ts).total_seconds() / 86400\r\n\u001b[?2004l\r"]
[88.443865, "o", "\u001b[?2004h> "]
[88.443888, "o", "+        else:\r\n\u001b[?2004l\r"]
[88.443912, "o", "\u001b[?2004h> "]
[88.444038, "o", "+            days_since_last_order = np.nan\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.444063, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.444235, "o", "+        # ---------- Customer attributes (plan, login) ----------\r\n\u001b[?2004l\r"]
[88.44426, "o", "\u001b[?2004h> "]
[88.44449, "o", "+        # Customer rows may have multiple revisions; pick the latest version visible at as_of.\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.444513, "o", "> "]
[88.444753, "o", "+        cust_vis = customers[(customers[\"customer_id\"] == cid) & (customers[\"_updated_at\"] <= as_of)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.444775, "o", "> "]
[88.44485, "o", "+        if not cust_vis.empty:\r\n\u001b[?2004l\r"]
[88.444873, "o", "\u001b[?2004h> "]
[88.445082, "o", "+            # Keep the row with the greatest _updated_at (latest visible revision).\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.445105, "o", "> "]
[88.445274, "o", "+            cust_row = cust_vis.loc[cust_vis[\"_updated_at\"].idxmax()]\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.445301, "o", "> "]
[88.445391, "o", "+            plan_val = cust_row[\"plan\"]\r\n\u001b[?2004l\r"]
[88.445414, "o", "\u001b[?2004h> "]
[88.445583, "o", "+            # days since last login – null if no login before as_of\r\n\u001b[?2004l\r"]
[88.44561, "o", "\u001b[?2004h> "]
[88.445732, "o", "+            last_login = cust_row[\"last_login_at\"]\r\n\u001b[?2004l\r"]
[88.445759, "o", "\u001b[?2004h> "]
[88.445904, "o", "+            if pd.notnull(last_login) and last_login < as_of:\r\n\u001b[?2004l\r"]
[88.445936, "o", "\u001b[?2004h> "]
[88.446138, "o", "+                days_since_last_login = (as_of - last_login).total_seconds() / 86400\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.446164, "o", "> "]
[88.446208, "o", "+            else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.446231, "o", "> "]
[88.446341, "o", "+                days_since_last_login = np.nan\r\n\u001b[?2004l\r"]
[88.446368, "o", "\u001b[?2004h> "]
[88.446405, "o", "+        else:\r\n\u001b[?2004l\r"]
[88.446429, "o", "\u001b[?2004h> "]
[88.446501, "o", "+            plan_val = np.nan\r\n\u001b[?2004l\r"]
[88.446524, "o", "\u001b[?2004h> "]
[88.446629, "o", "+            days_since_last_login = np.nan\r\n\u001b[?2004l\r"]
[88.446654, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.446678, "o", "\u001b[?2004h> "]
[88.446778, "o", "+        # ---------- Tenure ----------\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.446802, "o", "> "]
[88.446876, "o", "+        if not cust_vis.empty:\r\n\u001b[?2004l\r"]
[88.446901, "o", "\u001b[?2004h> "]
[88.447004, "o", "+            signup = cust_row[\"signup_at\"]\r\n\u001b[?2004l\r"]
[88.447042, "o", "\u001b[?2004h> "]
[88.447196, "o", "+            tenure_days = (as_of - signup).total_seconds() / 86400\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.447219, "o", "> "]
[88.447256, "o", "+        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.447283, "o", "> "]
[88.447358, "o", "+            tenure_days = np.nan\r\n\u001b[?2004l\r"]
[88.447381, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.447406, "o", "\u001b[?2004h> "]
[88.44751, "o", "+        # ---------- Status ----------\r\n\u001b[?2004l\r"]
[88.447534, "o", "\u001b[?2004h> "]
[88.447772, "o", "+        # Status snapshots are dated; only snapshots with snapshot_date < floor(as_of) are usable.\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.447795, "o", "> "]
[88.44785, "o", "+        snap_mask = (\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.447873, "o", "> "]
[88.447999, "o", "+            (status_snapshots[\"customer_id\"] == cid)\r\n\u001b[?2004l\r"]
[88.448032, "o", "\u001b[?2004h> "]
[88.448194, "o", "+            & (status_snapshots[\"snapshot_date\"] < as_of.floor(\"D\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.448217, "o", "> "]
[88.448351, "o", "+            & (status_snapshots[\"_loaded_at\"] <= as_of)\r\n\u001b[?2004l\r"]
[88.448374, "o", "\u001b[?2004h> "]
[88.448396, "o", "+        )\r\n\u001b[?2004l\r"]
[88.448421, "o", "\u001b[?2004h> "]
[88.448493, "o", "+        if snap_mask.any():\r\n\u001b[?2004l\r"]
[88.448517, "o", "\u001b[?2004h> "]
[88.448772, "o", "+            latest_snap = status_snapshots.loc[snap_mask].sort_values(\"snapshot_date\").iloc[-1][\"status\"]\r\n\u001b[?2004l\r"]
[88.448795, "o", "\u001b[?2004h> "]
[88.448834, "o", "+        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.448857, "o", "> "]
[88.448935, "o", "+            latest_snap = np.nan\r\n\u001b[?2004l\r"]
[88.448958, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.448984, "o", "\u001b[?2004h> "]
[88.449181, "o", "+        # ---------- App minutes (already pre‑computed per point) ----------\r\n\u001b[?2004l\r"]
[88.449206, "o", "\u001b[?2004h> "]
[88.449345, "o", "+        app_minutes_7d = pt.get(\"app_minutes_7d\", np.nan)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.44937, "o", "> +\r\n\u001b[?2004l\r"]
[88.449395, "o", "\u001b[?2004h> "]
[88.449515, "o", "+        # ---------- District encoding ----------\r\n\u001b[?2004l\r"]
[88.449541, "o", "\u001b[?2004h> "]
[88.449733, "o", "+        te_district = _district_encoding_point(idx, pt, labels, customers, m=20)\r\n\u001b[?2004l\r"]
[88.449757, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.449784, "o", "\u001b[?2004h> "]
[88.449839, "o", "+        rows.append(\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.449862, "o", "> "]
[88.449899, "o", "+            {\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.449922, "o", "> "]
[88.450008, "o", "+                \"customer_id\": cid,\r\n\u001b[?2004l\r"]
[88.450043, "o", "\u001b[?2004h> "]
[88.450115, "o", "+                \"as_of\": as_of,\r\n\u001b[?2004l\r"]
[88.450141, "o", "\u001b[?2004h> "]
[88.450237, "o", "+                \"orders_7d\": orders_7d,\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.450262, "o", "> "]
[88.450361, "o", "+                \"orders_30d\": orders_30d,\r\n\u001b[?2004l\r"]
[88.450387, "o", "\u001b[?2004h> "]
[88.45051, "o", "+                \"spend_30d_cents\": spend_30d_cents,\r\n\u001b[?2004l\r"]
[88.450535, "o", "\u001b[?2004h> "]
[88.45064, "o", "+                \"tickets_30d\": tickets_30d,\r\n\u001b[?2004l\r"]
[88.450667, "o", "\u001b[?2004h> "]
[88.450824, "o", "+                \"days_since_last_order\": days_since_last_order,\r\n\u001b[?2004l\r"]
[88.450849, "o", "\u001b[?2004h> "]
[88.450958, "o", "+                \"tenure_days\": tenure_days,\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.450983, "o", "> "]
[88.451085, "o", "+                \"status\": latest_snap,\r\n\u001b[?2004l\r"]
[88.451112, "o", "\u001b[?2004h> "]
[88.451189, "o", "+                \"plan\": plan_val,\r\n\u001b[?2004l\r"]
[88.451216, "o", "\u001b[?2004h> "]
[88.451367, "o", "+                \"days_since_last_login\": days_since_last_login,\r\n\u001b[?2004l\r"]
[88.451393, "o", "\u001b[?2004h> "]
[88.45151, "o", "+                \"app_minutes_7d\": app_minutes_7d,\r\n\u001b[?2004l\r"]
[88.451535, "o", "\u001b[?2004h> "]
[88.451641, "o", "+                \"te_district\": te_district,\r\n\u001b[?2004l\r"]
[88.451664, "o", "\u001b[?2004h> "]
[88.451705, "o", "+            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.451729, "o", "> "]
[88.451752, "o", "+        )\r\n\u001b[?2004l\r"]
[88.451774, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.4518, "o", "\u001b[?2004h> "]
[88.451879, "o", "+    feats = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[88.451904, "o", "\u001b[?2004h> "]
[88.452084, "o", "+    # Preserve column order expected by downstream checks.\r\n\u001b[?2004l\r"]
[88.452109, "o", "\u001b[?2004h> "]
[88.452273, "o", "+    return feats[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\u001b[?2004l\r"]
[88.452296, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.452322, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.452346, "o", "\u001b[?2004h> "]
[88.452401, "o", "+def main() -> None:\r\n\u001b[?2004l\r"]
[88.452425, "o", "\u001b[?2004h> "]
[88.452557, "o", "+    ap = argparse.ArgumentParser(description=__doc__)\r\n\u001b[?2004l\r"]
[88.452581, "o", "\u001b[?2004h> "]
[88.452778, "o", "+    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n\u001b[?2004l\r"]
[88.452804, "o", "\u001b[?2004h> "]
[88.452974, "o", "+    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n\u001b[?2004l\r"]
[88.452997, "o", "\u001b[?2004h> "]
[88.45307, "o", "+    args = ap.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.453094, "o", "> "]
[88.453164, "o", "+    feats = build(args.data)\r\n\u001b[?2004l\r"]
[88.453189, "o", "\u001b[?2004h> "]
[88.453366, "o", "+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True\r\n\u001b[?2004l\r"]
[88.453388, "o", "\u001b[?2004h> "]
[88.453497, "o", "+    feats.to_parquet(args.out, index=False)\r\n\u001b[?2004l\r"]
[88.45352, "o", "\u001b[?2004h> "]
[88.453717, "o", "+    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\r\n\u001b[?2004l\r"]
[88.453744, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.453768, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.453793, "o", "\u001b[?2004h> "]
[88.453866, "o", "+if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[88.453897, "o", "\u001b[?2004h> "]
[88.453924, "o", "+    main()\r\n\u001b[?2004l\r"]
[88.453953, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[88.453977, "o", "\u001b[?2004h> "]
[88.454013, "o", "*** End Patch\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.454049, "o", "> PATCH\r\n\u001b[?2004l\r"]
[88.454573, "o", "bash: apply_patch: command not found\r\n"]
[88.45493, "o", "\u001b[?2004hroot@161f24ce-3c0c-44b4-b5d6-cf2d972a5f12:/app# "]
[89.18642, "i", "python -m churn.build_features --data data --out features.parquet\n"]
[89.186648, "o", "python -m churn.build_features --data data --out features.parquet\r\n\u001b[?2004l\r"]
[90.182698, "o", "wrote 57909 rows x 13 columns to features.parquet\r\n"]
[90.23505, "o", "\u001b[?2004hroot@161f24ce-3c0c-44b4-b5d6-cf2d972a5f12:/app# "]
[93.924972, "i", "ls -lh features.parquet\n"]
[93.925107, "o", "ls -lh features.parquet\r\n\u001b[?2004l\r"]
[93.92652, "o", "-rw-r--r-- 1 root root 1.5M Nov  3 17:28 features.parquet\r\n"]
[93.926754, "o", "\u001b[?2004h"]
[93.926777, "o", "root@161f24ce-3c0c-44b4-b5d6-cf2d972a5f12:/app# "]
[122.085829, "i", "cat > churn/build_features.py <<'PY'\n\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\\n\\nThis implementation mirrors the live scoring service by ensuring that, for each prediction\\npoint, only rows that were *visible* in the warehouse at that moment are used. Visibility is\\ndetermined by the `_loaded_at` column present in every extract CSV (except `scoring_points`).\\n\\nThe original implementation relied on the full tables, which could leak future rows that were\\nback‑filled after a prediction timestamp. The revised `build` function iterates over each row\\nin `scoring_points` and filters each source table by both the event timestamp **and** the\\n`_loaded_at` timestamp before computing features. The logic for each feature is equivalent to\\nthe original helpers (`activity_features`, `tenure_days`, `latest_status`, etc.) but applied\\nto the point‑in‑time subset.\\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport os\nfrom typing import List\n\nimpo"]
[122.08593, "i", "rt numpy as np\nimport pandas as pd\n\nfrom churn.attributes import days_since_last_login, plan\nfrom churn.impute import fill_app_minutes\nfrom churn.extract import load_extract\nfrom churn.status import latest_status\nfrom churn.windows import activity_features, tenure_days\n\nFEATURE_COLUMNS = [\n    \"orders_7d\",\n    \"orders_30d\",\n    \"spend_30d_cents\",\n    \"tickets_30d\",\n    \"days_since_last_order\",\n    \"tenure_days\",\n    \"status\",\n    \"plan\",\n    \"days_since_last_login\",\n    \"app_minutes_7d\",\n    \"te_district\",\n]\n\n\ndef _district_encoding_point(\n    point_idx: int,\n    point: pd.Series,\n    labels: pd.DataFrame,\n    customers: pd.DataFrame,\n    m: int = 20,\n) -> float | None:\n    \"\"\"Compute the smoothed churn rate for a single point respecting `_loaded_at`.\"\"\"\n    as_of = point[\"as_of\"]\n    # Labels are usable only after their 30‑day outcome window has closed and they were loaded.\n    closed = labels[\"as_of\"] + pd.Timedelta(days=30)\n    mask = (closed <= as_of) & (labels[\"_loaded_at\"] <= as_of)\n    valid = labels"]
[122.08596, "i", "[mask]\n    if valid.empty:\n        return None\n    # Map customers to postcode districts.\n    district_series = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    pt_district = district_series.get(point[\"customer_id\"])\n    if pd.isna(pt_district):\n        return None\n    # Global prior churn rate.\n    prior = valid[\"churned_30d\"].mean()\n    # District‑specific counts.\n    label_districts = valid[\"customer_id\"].map(district_series)\n    district_mask = label_districts == pt_district\n    n = int(district_mask.sum())\n    s = int(valid.loc[district_mask, \"churned_30d\"].sum())\n    return (s + m * prior) / (n + m)\n\n\ndef build(data_dir: str) -> pd.DataFrame:\n    tables = load_extract(data_dir)\n    points = tables[\"scoring_points\"][[\"customer_id\", \"as_of\"]].reset_index(drop=True)\n\n    orders = tables[\"orders\"]\n    tickets = tables[\"tickets\"]\n    customers = tables[\"customers\"]\n    status_snapshots = tables[\"status_snapshots\"]\n    labels = tables[\"labels\"]\n\n    rows: List[dict] = []\n    for _, pt in points.i"]
[122.085981, "i", "terrows():\n        cid = pt[\"customer_id\"]\n        as_of = pt[\"as_of\"]\n\n        # ----- Orders -----\n        o_mask = (\n            (orders[\"customer_id\"] == cid)\n            & (orders[\"ordered_at\"] < as_of)\n            & (orders[\"_loaded_at\"] <= as_of)\n        )\n        o_last7 = o_mask & (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=7))\n        o_last30 = o_mask & (orders[\"ordered_at\"] >= as_of - pd.Timedelta(days=30))\n        orders_7d = int(o_last7.sum())\n        orders_30d = int(o_last30.sum())\n        spend_30d_cents = int(orders.loc[o_last30, \"amount_cents\"].sum())\n\n        # ----- Tickets -----\n        t_mask = (\n            (tickets[\"customer_id\"] == cid)\n            & (tickets[\"opened_at\"] < as_of)\n            & (tickets[\"_loaded_at\"] <= as_of)\n        )\n        t_last30 = t_mask & (tickets[\"opened_at\"] >= as_of - pd.Timedelta(days=30))\n        tickets_30d = int(t_last30.sum())\n\n        # ----- Days since last order -----\n        past_orders = orders[o_mask]\n        if not past_orders.empty:\n  "]
[122.085999, "i", "          last_order_ts = past_orders[\"ordered_at\"].max()\n            days_since_last_order = (as_of - last_order_ts).total_seconds() / 86400\n        else:\n            days_since_last_order = np.nan\n\n        # ----- Customer attributes (plan, login) -----\n        cust_vis = customers[(customers[\"customer_id\"] == cid) & (customers[\"_updated_at\"] <= as_of)]\n        if not cust_vis.empty:\n            cust_row = cust_vis.loc[cust_vis[\"_updated_at\"].idxmax()]\n            plan_val = cust_row[\"plan\"]\n            last_login = cust_row[\"last_login_at\"]\n            if pd.notnull(last_login) and last_login < as_of:\n                days_since_last_login = (as_of - last_login).total_seconds() / 86400\n            else:\n                days_since_last_login = np.nan\n        else:\n            plan_val = np.nan\n            days_since_last_login = np.nan\n\n        # ----- Tenure -----\n        if not cust_vis.empty:\n            signup = cust_row[\"signup_at\"]\n            tenure = (as_of - signup).total_seconds() / 86400\n        e"]
[122.086018, "i", "lse:\n            tenure = np.nan\n\n        # ----- Status -----\n        snap_mask = (\n            (status_snapshots[\"customer_id\"] == cid)\n            & (status_snapshots[\"snapshot_date\"] < as_of.floor(\"D\"))\n            & (status_snapshots[\"_loaded_at\"] <= as_of)\n        )\n        if snap_mask.any():\n            latest_snap = status_snapshots.loc[snap_mask].sort_values(\"snapshot_date\").iloc[-1][\"status\"]\n        else:\n            latest_snap = np.nan\n\n        # ----- App minutes (already in scoring_points) -----\n        app_minutes_7d = pt.get(\"app_minutes_7d\", np.nan)\n\n        # ----- District encoding -----\n        te_district = _district_encoding_point(_, pt, labels, customers, m=20)\n\n        rows.append({\n            \"customer_id\": cid,\n            \"as_of\": as_of,\n            \"orders_7d\": orders_7d,\n            \"orders_30d\": orders_30d,\n            \"spend_30d_cents\": spend_30d_cents,\n            \"tickets_30d\": tickets_30d,\n            \"days_since_last_order\": days_since_last_order,\n            \"tenure_days"]
[122.086051, "o", "cat > churn/build_features.py <<'PY'"]
[122.086068, "i", "\": tenure,\n            \"status\": latest_snap,\n            \"plan\": plan_val,\n            \"days_since_last_login\": days_since_last_login,\n            \"app_minutes_7d\": app_minutes_7d,\n            \"te_district\": te_district,\n        })\n\n    df = pd.DataFrame(rows)\n    return df[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\n    parser.add_argument(\"--out\", required=True, help=\"output parquet file\")\n    args = parser.parse_args()\n    feats = build(args.data)\n    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\n    feats.to_parquet(args.out, index=False)\n    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\nPY\n"]
