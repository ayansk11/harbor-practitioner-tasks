[2864.227237, "i", "python3 - <<'PY'\np='churn/status.py'\ns=open(p).read()\ns=s.replace('changed = np.r_[True, running_max[1:] != running_max[:-1]]', 'boundary = np.r_[True, customer[1:] != customer[:-1]]\\n    changed = boundary | np.r_[False, running_max[1:] != running_max[:-1]]')\nopen(p,'w').write(s)\nPY\n\ncat > churn/encoding.py <<'PY'\n\"\"\"Point-in-time smoothed district target encoding.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nSTRIDE = 10 ** 10\n\n\ndef _seconds(values):\n    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef district_encoding(points, labels, customers, m=20):\n    \"\"\"Reproduce the live SQL using label rows committed before each prediction.\"\"\"\n    districts = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    lab = labels.copy()\n    lab[\"postcode_district\"] = lab[\"customer_id\"].map(districts)\n    lab = lab[lab[\"postcode_district\"].notna()].copy().reset_index(drop=True)\n\n    all_districts = pd.concat(\n        [lab[\"postcode_district"]
[2864.227376, "i", "\"], points[\"customer_id\"].map(districts)], ignore_index=True\n    )\n    codes = all_districts.astype(\"category\").cat.codes.to_numpy(dtype=\"int64\")\n    lab_codes = codes[:len(lab)]\n    point_codes = codes[len(lab):]\n\n    y = pd.to_numeric(lab[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\n    valid = ~np.isnan(y)\n    y_filled = np.nan_to_num(y, nan=0.0)\n    rows = np.arange(1, len(lab) + 1, dtype=\"int64\")\n\n    # Global prior: all label rows visible to the query at time t.\n    loaded = _seconds(lab[\"_loaded_at\"])\n    global_order = np.argsort(loaded, kind=\"mergesort\")\n    global_load = loaded[global_order]\n    global_sum = np.cumsum(y_filled[global_order])\n    global_rows = rows[global_order]\n    global_seen = np.cumsum(valid[global_order]).astype(\"int64\")\n\n    # District statistics: cumulative values reset at each district group.\n    key = lab_codes.astype(\"int64\") * STRIDE + loaded\n    order = np.argsort(key, kind=\"mergesort\")\n    district_key = key[order]\n    district_codes = lab_codes[order]\n    "]
[2864.227435, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[2864.227475, "i", "starts = np.flatnonzero(np.r_[True, district_codes[1:] != district_codes[:-1]])\n    group_ends = np.r_[starts[1:], len(lab)]\n    group_start_sum = np.where(starts == 0, 0.0, np.cumsum(y_filled[order])[starts - 1])\n    group_start_rows = np.where(starts == 0, 0, rows[order][starts - 1])\n    cumulative_sum = np.cumsum(y_filled[order])\n    cumulative_rows = rows[order]\n    district_sum = cumulative_sum - np.repeat(group_start_sum, group_ends - starts)\n    district_rows = cumulative_rows - np.repeat(group_start_rows, group_ends - starts)\n\n    t = _seconds(points[\"as_of\"])\n    gp = np.searchsorted(global_load, t, side=\"left\")\n    global_n = np.where(gp > 0, global_rows[np.maximum(gp - 1, 0)], 0)\n    global_s = np.where(gp > 0, global_sum[np.maximum(gp - 1, 0)], 0.0)\n    global_count = np.where(gp > 0, global_seen[np.maximum(gp - 1, 0)], 0)\n    prior = np.full(len(points), 0.05, dtype=\"float64\")\n    has_prior = global_count > 0\n    prior[has_prior] = global_s[has_prior] / global_count[has_prior]\n\n    point_key = po"]
[2864.227512, "o", "\u001b[?2004h> "]
[2864.227527, "i", "int_codes.astype(\"int64\") * STRIDE + t\n    hp = np.searchsorted(district_key, point_key, side=\"left\")\n    n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)\n    s = np.where(hp > 0, district_sum[np.maximum(hp - 1, 0)], 0.0)\n    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\nPY\npython3 -m py_compile churn/*.py\n"]
