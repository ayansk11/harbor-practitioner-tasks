[2965.85102, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom churn.extract import load_extract\nfrom churn.status import latest_status\nfrom churn.encoding import _seconds\nT=load_extract('/app/data')\npts=pd.DataFrame({'customer_id':[100220,101169],'as_of':pd.to_datetime(['2026-01-06T06:00:00Z','2026-01-07T06:00:00Z'],utc=True)})\nprint('status helper',latest_status(pts,T['status_snapshots']).tolist())\n\n# Reproduce status internals\ns=T['status_snapshots']; points=pts\nEPOCH=pd.Timestamp('1970-01-01',tz='UTC'); STRIDE=10**10\ndef sec(v): return ((v-EPOCH)//pd.Timedelta(seconds=1)).to_numpy(dtype='int64')\nevent=s.snapshot_date.to_numpy(dtype='datetime64[ns]').astype('int64'); loaded=sec(s._loaded_at); customer=s.customer_id.to_numpy(dtype='int64'); key=customer*STRIDE+loaded\norder=np.argsort(key,kind='mergesort'); customer_s=customer[order]; event_s=event[order]; status_s=s.status.to_numpy(dtype=object)[order]\nrunning=np.empty(len(event_s),dtype=event_s.dtype); prev=None; cur=None\nfor i,(cid,val) in enumerate(zip(customer_"]
[2965.851113, "i", "s,event_s)):\n if cid!=prev: cur=val; prev=cid\n elif val>cur: cur=val\n running[i]=cur\nboundary=np.r_[True,customer_s[1:]!=customer_s[:-1]]\nchanged=boundary | np.r_[False,running[1:]!=running[:-1]]\nbest=pd.Series(status_s).where(changed).ffill().to_numpy(dtype=object)\nfor cid,t in zip(points.customer_id,points.as_of):\n pk=int(cid)*STRIDE+sec(pd.Series([t]))[0]; pos=np.searchsorted(key,pk,side='left')\n print('point',cid,'key',pk,'pos',pos,'insert key neighbors',key[max(0,pos-2):pos+2], 'best around',best[max(0,pos-2):pos+2])\n # customer rows in sorted order\n loc=np.flatnonzero(customer_s==cid)\n print('customer sorted load/date/status/max/boundary/changed/best')\n print(pd.DataFrame({'loaded':loaded[order][loc],'date':event_s[loc],'status':status_s[loc],'max':running[loc],'boundary':boundary[loc],'changed':changed[loc],'best':best[loc]}).to_string(index=False))\n\n# Reproduce encoding internals for sample\nlabels=T['labels'].copy(); customers=T['customers'].set_index('customer_id'); labels['district']=labels.customer"]
[2965.851139, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[2965.851157, "i", "_id.map(customers.postcode_district)\ncid,t=100012,pd.Timestamp('2026-01-12T06:00:00Z'); d=customers.loc[cid,'postcode_district']\nall_d=pd.concat([labels.district,pd.Series([d])],ignore_index=True); codes=all_d.astype('category').cat.codes.to_numpy(dtype='int64'); lc=codes[:-1]; pc=codes[-1]\nloaded=_seconds(labels._loaded_at); key=lc.astype('int64')*STRIDE+loaded; pk=int(pc)*STRIDE+sec(pd.Series([t]))[0]\npos=np.searchsorted(np.sort(key),pk,side='left')\nprint('\\nencoding d',repr(d),'code',pc,'lab code range',lc.min(),lc.max(),'unique',len(np.unique(lc)))\nprint('point key',pk,'search pos',pos,'matching keys',np.sum(key==pk),'key min/max',key.min(),key.max())\n# show keys around desired district by sorting with key\no=np.argsort(key,kind='mergesort'); ii=np.flatnonzero(lc[o]==pc)\nprint('district sorted range',ii[:1],ii[-1:],'keys',key[o][ii[:3]],key[o][ii[-3:]])\nprint('point code map back',all_d.astype('category').cat.categories[pc])\nPY\n"]
