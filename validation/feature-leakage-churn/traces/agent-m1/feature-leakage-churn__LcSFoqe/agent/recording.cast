[2183.790982, "o", "\u001b[?2004h> "]
[2183.791315, "o", "                    event = times[:hi][seen]\r\n\u001b[?2004l\r"]
[2183.791356, "o", "\u001b[?2004h"]
[2183.791391, "o", "> "]
[2183.791766, "o", "                    amounts_seen = amounts[:hi][seen]\r\n\u001b[?2004l\r"]
[2183.791802, "o", "\u001b[?2004h"]
[2183.791842, "o", "> "]
[2183.792472, "o", "                    orders_7d[i] = np.count_nonzero(event >= t - np.timedelta64(7, \"D\"))\r\n\u001b[?2004l\r"]
[2183.792513, "o", "\u001b[?2004h"]
[2183.792551, "o", "> "]
[2183.793183, "o", "                    orders_30d[i] = np.count_nonzero(event >= t - np.timedelta64(30, \"D\"))\r\n\u001b[?2004l\r"]
[2183.793224, "o", "\u001b[?2004h"]
[2183.793262, "o", "> "]
[2183.793925, "o", "                    spend[i] = int(np.nansum(amounts_seen[event >= t - np.timedelta64(30, \"D\")]))\r\n\u001b[?2004l\r"]
[2183.793984, "o", "\u001b[?2004h"]
[2183.794023, "o", "> "]
[2183.794749, "o", "                    last_order_days[i] = (at - pd.Timestamp(event[-1], tz=\"UTC\")).total_seconds() / 86400.0\r\n\u001b[?2004l\r"]
[2183.794789, "o", "\u001b[?2004h"]
[2183.794829, "o", "> \r\n\u001b[?2004l\r"]
[2183.794872, "o", "\u001b[?2004h"]
[2183.79491, "o", "> "]
[2183.795253, "o", "        group = ticket_groups.get(int(cid))\r\n"]
[2183.795297, "o", "\u001b[?2004l\r\u001b[?2004h"]
[2183.795336, "o", "> "]
[2183.795544, "o", "        if group is not None:\r\n\u001b[?2004l\r"]
[2183.795591, "o", "\u001b[?2004h"]
[2183.795628, "o", "> "]
[2183.795933, "o", "            times, loads, _amounts = group\r\n\u001b[?2004l\r"]
[2183.795984, "o", "\u001b[?2004h"]
[2183.796021, "o", "> "]
[2183.796414, "o", "            hi = np.searchsorted(times, t, side=\"left\")\r\n\u001b[?2004l\r"]
[2183.796469, "o", "\u001b[?2004h> "]
[2183.796631, "o", "            if hi:\r\n\u001b[?2004l\r"]
[2183.79667, "o", "\u001b[?2004h"]
[2183.796713, "o", "> "]
[2183.797008, "o", "                seen = loads[:hi] < t\r\n\u001b[?2004l\r"]
[2183.79705, "o", "\u001b[?2004h"]
[2183.797086, "o", "> "]
[2183.797316, "o", "                if seen.any():\r\n"]
[2183.797354, "o", "\u001b[?2004l\r"]
[2183.797398, "o", "\u001b[?2004h> "]
[2183.797742, "o", "                    event = times[:hi][seen]\r\n\u001b[?2004l\r"]
[2183.797795, "o", "\u001b[?2004h"]
[2183.797856, "o", "> "]
[2183.798463, "o", "                    tickets_30d[i] = np.count_nonzero(event >= t - np.timedelta64(30, \"D\"))\r\n\u001b[?2004l\r"]
[2183.798501, "o", "\u001b[?2004h"]
[2183.798542, "o", "> \r\n\u001b[?2004l\r"]
[2183.798585, "o", "\u001b[?2004h"]
[2183.798623, "o", "> "]
[2183.798939, "o", "    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n\u001b[?2004l\r"]
[2183.799007, "o", "\u001b[?2004h"]
[2183.799038, "o", "> "]
[2183.799268, "o", "    out[\"orders_7d\"] = orders_7d\r\n\u001b[?2004l\r"]
[2183.799302, "o", "\u001b[?2004h"]
[2183.799317, "o", "> "]
[2183.799574, "o", "    out[\"orders_30d\"] = orders_30d\r\n\u001b[?2004l\r"]
[2183.799608, "o", "\u001b[?2004h"]
[2183.799639, "o", "> "]
