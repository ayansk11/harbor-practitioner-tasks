[2837.682214, "o", "\u001b[?2004h"]
[2837.682258, "o", "> "]
[2837.682884, "o", "        ok=a.astype(object).where(a.notna(),None) == b.astype(object).where(b.notna(),None)\r\n\u001b[?2004l\r"]
[2837.682931, "o", "\u001b[?2004h> "]
[2837.683366, "o", "    print(feat,'mismatches',int((~ok).sum()),'of',len(z))\r\n\u001b[?2004l\r"]
[2837.683416, "o", "\u001b[?2004h> "]
[2837.684251, "o", "    if (~ok).any(): print(z.loc[~ok,['customer_id','as_of',feat+'_out',feat+'_live']].head(3).to_string(index=False))\r\n\u001b[?2004l\r"]
