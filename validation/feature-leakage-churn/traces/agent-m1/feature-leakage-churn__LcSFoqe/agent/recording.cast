[44.918308, "i", "python3 - <<'PY'\nimport pandas as pd, os\nfor f in sorted(os.listdir('data')):\n    if not f.endswith('.csv'): continue\n    p='data/'+f\n    d=pd.read_csv(p)\n    print('\\n===',f,'rows',len(d),'===' )\n    print(d.dtypes.to_string())\n    print('head:')\n    print(d.head(3).to_string(index=False))\n    for c in d.columns:\n        if any(x in c for x in ('_at','date','as_of')):\n            s=pd.to_datetime(d[c],errors='coerce',utc=True)\n            if s.notna().any(): print(c,'min',s.min(),'max',s.max(),'null',s.isna().sum())\nPY\n"]
