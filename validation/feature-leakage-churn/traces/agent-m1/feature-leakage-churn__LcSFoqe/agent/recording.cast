[2776.575133, "o", "\u001b[?2004h"]
[2776.575186, "o", "> "]
[2776.575358, "o", "            current_max = value\r\n\u001b[?2004l\r"]
[2776.575397, "o", "\u001b[?2004h"]
[2776.575428, "o", "> "]
[2776.575586, "o", "            previous = cid\r\n\u001b[?2004l\r"]
[2776.575624, "o", "\u001b[?2004h"]
[2776.575654, "o", "> "]
[2776.575852, "o", "        elif value > current_max:\r\n\u001b[?2004l\r"]
[2776.575889, "o", "\u001b[?2004h"]
[2776.575919, "o", "> "]
[2776.576122, "o", "            current_max = value\r\n\u001b[?2004l\r"]
[2776.576169, "o", "\u001b[?2004h"]
[2776.5762, "o", "> "]
[2776.576416, "o", "        running_max[i] = current_max\r\n\u001b[?2004l\r"]
[2776.576455, "o", "\u001b[?2004h"]
[2776.576485, "o", "> "]
[2776.576857, "o", "    changed = np.r_[True, running_max[1:] != running_max[:-1]]\r\n\u001b[?2004l\r"]
[2776.57689, "o", "\u001b[?2004h"]
[2776.576919, "o", "> "]
[2776.577418, "o", "    best_status = pd.Series(status).where(changed).ffill().to_numpy(dtype=object)\r\n\u001b[?2004l\r"]
[2776.57746, "o", "\u001b[?2004h"]
[2776.577493, "o", "> "]
[2776.577532, "o", "\r\n\u001b[?2004l\r"]
[2776.577567, "o", "\u001b[?2004h> "]
[2776.578152, "o", "    point_key = points[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[2776.578225, "o", "\u001b[?2004h> "]
[2776.578557, "o", "    pos = np.searchsorted(key, point_key, side=\"left\")\r\n\u001b[?2004l\r"]
[2776.578603, "o", "\u001b[?2004h"]
[2776.578643, "o", "> "]
[2776.57895, "o", "    result = np.full(len(points), None, dtype=object)\r\n\u001b[?2004l\r"]
[2776.579017, "o", "\u001b[?2004h"]
[2776.579065, "o", "> "]
[2776.579148, "o", "    known = pos > 0\r\n\u001b[?2004l\r"]
[2776.579187, "o", "\u001b[?2004h"]
[2776.579235, "o", "> "]
[2776.579498, "o", "    result[known] = best_status[pos[known] - 1]\r\n\u001b[?2004l\r"]
[2776.579548, "o", "\u001b[?2004h> "]
[2776.579946, "o", "    return pd.Series(result, index=points.index, dtype=\"object\")\r\n\u001b[?2004l\r"]
[2776.580009, "o", "\u001b[?2004h> "]
[2776.580045, "o", "PY\r\n\u001b[?2004l\r"]
[2776.582789, "o", "\u001b[?2004h"]
[2776.582806, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# \r\n\u001b[?2004l\r"]
[2776.582874, "o", "\u001b[?2004h"]
[2776.582908, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2776.583107, "o", "cat > churn/encoding.py <<'PY'\r\n\u001b[?2004l\r"]
[2776.583159, "o", "\u001b[?2004h"]
[2776.583195, "o", "> "]
[2776.583519, "o", "\"\"\"Point-in-time smoothed district target encoding.\"\"\"\r\n\u001b[?2004l\r"]
[2776.583556, "o", "\u001b[?2004h"]
[2776.583588, "o", "> "]
[2776.583704, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[2776.583749, "o", "\u001b[?2004h"]
[2776.583786, "o", "> "]
[2776.583896, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[2776.583951, "o", "\u001b[?2004h> "]
[2776.584026, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2776.584306, "o", "EPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n\u001b[?2004l\r"]
[2776.584365, "o", "\u001b[?2004h> "]
[2776.584475, "o", "STRIDE = 10 ** 10\r\n\u001b[?2004l\r"]
[2776.584518, "o", "\u001b[?2004h"]
[2776.584554, "o", "> "]
[2776.584588, "o", "\r\n\u001b[?2004l\r"]
[2776.584635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2776.584674, "o", "\u001b[?2004h> "]
[2776.584794, "o", "def _seconds(values):\r\n\u001b[?2004l\r"]
[2776.584841, "o", "\u001b[?2004h> "]
[2776.585351, "o", "    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2776.585393, "o", "\u001b[?2004h"]
[2776.58544, "o", "> \r\n"]
[2776.585478, "o", "\u001b[?2004l\r\u001b[?2004h"]
[2776.58551, "o", "> \r\n\u001b[?2004l\r"]
[2776.585546, "o", "\u001b[?2004h"]
[2776.585578, "o", "> "]
[2776.585889, "o", "def district_encoding(points, labels, customers, m=20):\r\n\u001b[?2004l\r"]
[2776.585932, "o", "\u001b[?2004h"]
[2776.585983, "o", "> "]
[2776.586481, "o", "    \"\"\"Reproduce the live SQL using label rows committed before each prediction.\"\"\"\r\n\u001b[?2004l\r"]
[2776.586565, "o", "\u001b[?2004h> "]
[2776.586973, "o", "    districts = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[2776.587047, "o", "\u001b[?2004h> "]
[2776.587189, "o", "    lab = labels.copy()\r\n\u001b[?2004l\r"]
[2776.587248, "o", "\u001b[?2004h"]
[2776.587285, "o", "> "]
[2776.587647, "o", "    lab[\"postcode_district\"] = lab[\"customer_id\"].map(districts)\r\n\u001b[?2004l\r"]
[2776.587708, "o", "\u001b[?2004h"]
[2776.587747, "o", "> "]
[2776.58821, "o", "    lab = lab[lab[\"postcode_district\"].notna()].copy().reset_index(drop=True)\r\n\u001b[?2004l\r"]
[2776.588275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2776.588319, "o", "\u001b[?2004h> "]
[2776.588526, "o", "    all_districts = pd.concat(\r\n\u001b[?2004l\r"]
[2776.588569, "o", "\u001b[?2004h"]
[2776.588601, "o", "> "]
[2776.589172, "o", "        [lab[\"postcode_district\"], points[\"customer_id\"].map(districts)], ignore_index=True\r\n\u001b[?2004l\r"]
[2776.589208, "o", "\u001b[?2004h"]
[2776.589239, "o", "> "]
[2776.58927, "o", "    )\r\n\u001b[?2004l\r"]
[2776.589302, "o", "\u001b[?2004h"]
[2776.589335, "o", "> "]
[2776.5898, "o", "    codes = all_districts.astype(\"category\").cat.codes.to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2776.58985, "o", "\u001b[?2004h"]
[2776.58988, "o", "> "]
[2776.590084, "o", "    lab_codes = codes[:len(lab)]\r\n\u001b[?2004l\r"]
[2776.590143, "o", "\u001b[?2004h> "]
[2776.590352, "o", "    point_codes = codes[len(lab):]\r\n\u001b[?2004l\r"]
[2776.590384, "o", "\u001b[?2004h"]
[2776.590414, "o", "> "]
[2776.590449, "o", "\r\n\u001b[?2004l\r"]
[2776.590478, "o", "\u001b[?2004h> "]
[2776.591009, "o", "    y = pd.to_numeric(lab[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2776.59104, "o", "\u001b[?2004h"]
[2776.59107, "o", "> "]
[2776.591318, "o", "    y_filled = np.nan_to_num(y, nan=0.0)\r\n\u001b[?2004l\r"]
[2776.591361, "o", "\u001b[?2004h"]
[2776.591391, "o", "> "]
[2776.591616, "o", "    raw_sum = np.cumsum(y_filled)\r\n\u001b[?2004l\r"]
[2776.591671, "o", "\u001b[?2004h> "]
[2776.592011, "o", "    raw_rows = np.arange(1, len(lab) + 1, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2776.592059, "o", "\u001b[?2004h"]
[2776.592099, "o", "> \r\n\u001b[?2004l\r"]
[2776.592139, "o", "\u001b[?2004h"]
[2776.592177, "o", "> "]
[2776.592391, "o", "    loaded = _seconds(lab[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[2776.592435, "o", "\u001b[?2004h"]
[2776.592474, "o", "> \r\n\u001b[?2004l\r"]
[2776.592514, "o", "\u001b[?2004h"]
[2776.592554, "o", "> "]
[2776.59295, "o", "    # Global prior from all label rows visible at the prediction time.\r\n\u001b[?2004l\r"]
[2776.593002, "o", "\u001b[?2004h"]
[2776.593041, "o", "> "]
[2776.593369, "o", "    global_order = np.argsort(loaded, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2776.593412, "o", "\u001b[?2004h"]
[2776.593452, "o", "> "]
[2776.593666, "o", "    global_load = loaded[global_order]\r\n\u001b[?2004l\r"]
[2776.593707, "o", "\u001b[?2004h> "]
[2776.593953, "o", "    global_sum = raw_sum[global_order]\r\n\u001b[?2004l\r"]
[2776.594007, "o", "\u001b[?2004h> "]
[2776.594265, "o", "    global_rows = raw_rows[global_order]\r\n\u001b[?2004l\r"]
[2776.594313, "o", "\u001b[?2004h"]
[2776.594354, "o", "> \r\n"]
[2776.594393, "o", "\u001b[?2004l\r\u001b[?2004h"]
[2776.594434, "o", "> "]
[2776.594802, "o", "    # District statistics are cumulative only within that district.\r\n\u001b[?2004l\r"]
[2776.594847, "o", "\u001b[?2004h"]
[2776.594885, "o", "> "]
[2776.595212, "o", "    key = lab_codes.astype(\"int64\") * STRIDE + loaded\r\n\u001b[?2004l\r"]
[2776.595254, "o", "\u001b[?2004h"]
[2776.595292, "o", "> "]
[2776.59555, "o", "    order = np.argsort(key, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2776.59559, "o", "\u001b[?2004h"]
[2776.595628, "o", "> "]
[2776.595783, "o", "    district_key = key[order]\r\n\u001b[?2004l\r"]
[2776.595822, "o", "\u001b[?2004h"]
[2776.59586, "o", "> "]
[2776.59608, "o", "    district_order = lab_codes[order]\r\n\u001b[?2004l\r"]
[2776.596122, "o", "\u001b[?2004h"]
[2776.596161, "o", "> "]
[2776.596571, "o", "    boundaries = np.r_[True, district_order[1:] != district_order[:-1]]\r\n\u001b[?2004l\r"]
[2776.596621, "o", "\u001b[?2004h> "]
[2776.596863, "o", "    starts = np.flatnonzero(boundaries)\r\n\u001b[?2004l\r"]
[2776.596905, "o", "\u001b[?2004h"]
[2776.596943, "o", "> "]
[2776.597216, "o", "    previous_start = np.maximum(starts - 1, -1)\r\n\u001b[?2004l\r"]
[2776.597258, "o", "\u001b[?2004h"]
[2776.597296, "o", "> "]
[2776.597743, "o", "    group_start_for_row = np.repeat(starts, np.diff(np.r_[starts, len(lab)]))\r\n\u001b[?2004l\r"]
[2776.597789, "o", "\u001b[?2004h"]
[2776.597827, "o", "> "]
[2776.598381, "o", "    previous_before_group = np.where(group_start_for_row == 0, -1, group_start_for_row - 1)\r\n\u001b[?2004l\r"]
[2776.598433, "o", "\u001b[?2004h> "]
[2776.599154, "o", "    district_sum = raw_sum[order] - np.where(previous_before_group >= 0, raw_sum[order][previous_before_group], 0.0)\r\n\u001b[?2004l\r"]
[2776.599214, "o", "\u001b[?2004h"]
[2776.599254, "o", "> "]
[2776.599927, "o", "    district_rows = raw_rows[order] - np.where(previous_before_group >= 0, raw_rows[order][previous_before_group], 0)\r\n\u001b[?2004l\r"]
[2776.599977, "o", "\u001b[?2004h"]
[2776.600029, "o", "> "]
[2776.600069, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[2776.600107, "o", "> "]
[2776.600291, "o", "    t = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[2776.600334, "o", "\u001b[?2004h"]
[2776.600384, "o", "> "]
[2776.600688, "o", "    gp = np.searchsorted(global_load, t, side=\"left\")\r\n\u001b[?2004l\r"]
[2776.600731, "o", "\u001b[?2004h"]
[2776.60077, "o", "> "]
[2776.601185, "o", "    global_n = np.where(gp > 0, global_rows[np.maximum(gp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2776.601232, "o", "\u001b[?2004h"]
[2776.60127, "o", "> "]
[2776.601688, "o", "    global_s = np.where(gp > 0, global_sum[np.maximum(gp - 1, 0)], 0.0)\r\n\u001b[?2004l\r"]
[2776.601732, "o", "\u001b[?2004h"]
[2776.601771, "o", "> "]
[2776.602221, "o", "    prior = np.where(global_n > 0, global_s / np.maximum(global_n, 1), 0.05)\r\n\u001b[?2004l\r"]
[2776.602273, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2776.602328, "o", "\u001b[?2004h"]
[2776.602371, "o", "> "]
[2776.602699, "o", "    point_key = point_codes.astype(\"int64\") * STRIDE + t\r\n\u001b[?2004l\r"]
[2776.602743, "o", "\u001b[?2004h"]
[2776.602781, "o", "> "]
[2776.60317, "o", "    hp = np.searchsorted(district_key, point_key, side=\"left\")\r\n\u001b[?2004l\r"]
[2776.603216, "o", "\u001b[?2004h"]
[2776.603254, "o", "> "]
[2776.603636, "o", "    n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2776.603682, "o", "\u001b[?2004h"]
[2776.603721, "o", "> "]
[2776.604129, "o", "    s = np.where(hp > 0, district_sum[np.maximum(hp - 1, 0)], 0.0)\r\n\u001b[?2004l\r"]
[2776.604178, "o", "\u001b[?2004h> "]
[2776.604724, "o", "    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2776.6048, "o", "\u001b[?2004h> PY\r\n"]
[2776.604836, "o", "\u001b[?2004l\r"]
[2776.607734, "o", "\u001b[?2004h"]
[2776.607801, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2776.607995, "o", "python3 -m py_compile churn/*.py\r\n\u001b[?2004l\r"]
[2776.648504, "o", "\u001b[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2777.370805, "i", "python3 - <<'PY'\nimport subprocess,time,os,sys\nenv=os.environ.copy(); env['OMP_NUM_THREADS']='1'\nstart=time.monotonic()\nr=subprocess.run([sys.executable,'-m','churn.build_features','--data','/app/data','--out','/tmp/features.parquet'],env=env)\nprint('elapsed',time.monotonic()-start,'status',r.returncode)\nraise SystemExit(r.returncode)\nPY\n"]
