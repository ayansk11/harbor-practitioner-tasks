[1597.210595, "i", "python3 - <<'PY'\nimport pandas as pd\nc=pd.read_csv('data/customers.csv'); p=pd.read_csv('data/plan_changes.csv')\nlast=p.sort_values(['customer_id','changed_at']).groupby('customer_id').last()\nz=c.set_index('customer_id').join(last[['changed_at','old_plan','new_plan']])\nprint('customers',len(z),'with changes',z.new_plan.notna().sum())\nprint('current != latest new_plan among customers with changes:',sum(z.new_plan.notna() & (z.plan!=z.new_plan)))\nprint(z[z.new_plan.notna() & (z.plan!=z.new_plan)].head(10).to_string())\nprint('changed_at < signup_at:',sum(pd.to_datetime(z.changed_at,utc=True)<pd.to_datetime(z.signup_at,utc=True)))\nprint('loaded_at < changed_at:',sum(pd.to_datetime(p._loaded_at,utc=True)<pd.to_datetime(p.changed_at,utc=True)))\nPY\n"]
