[52.704518, "o", "     1\t\"\"\"Load a warehouse extract (the seven CSV files described in docs/WAREHOUSE.md) into pandas frames.\r\n     2\t\r\n     3\tEvery timestamp column is parsed to a UTC timestamp, the load metadata columns included, so each frame carries\r\n     4\teverything its CSV file has.\r\n"]
[52.704577, "o", "     5\t\"\"\"\r\n     6\timport os\r\n     7\timport pandas as pd\r\n     8\t\r\n     9\tTIMESTAMPS = {\r\n"]
[52.704618, "o", "    10\t    \"customers\": [\"signup_at\", \"last_login_at\", \"_updated_at\"],\r\n    11\t    \"plan_changes\": [\"changed_at\", \"_loaded_at\"],\r\n    12\t    \"scoring_points\": [\"as_of\"],\r\n    13\t    \"orders\": [\"ordered_at\", \"_loaded_at\"],\r\n    14\t    \"tickets\": [\"opened_at\", \"_loaded_at\"],\r\n    15\t    \"status_snapshots\": [\"snapshot_date\", \"_loaded_at\"],\r\n    16\t    \"labels\": [\"as_of\", \"_loaded_at\"],\r\n    17\t}\r\n    18\t\r\n    19\t\r\n    20\tdef load_extract(data_dir):\r\n    21\t    tables = {}\r\n    22\t    for name, cols in TIMESTAMPS.items():\r\n    23\t"]
[52.704654, "o", "        df = pd.read_csv(os.path.join(data_dir, f\"{name}.csv\"), dtype={\"postcode_district\": \"str\"})\r\n    24\t        for c in cols:\r\n    25\t            df[c] = pd.to_datetime(df[c], utc=True)\r\n    26\t        tables[name] = df\r\n    27\t    tables[\"scoring_points\"][\"app_minutes_7d\"] = tables[\"scoring_points\"][\"app_minutes_7d\"].astype(\"float64\")\r\n    28\t    return tables\r\n"]
