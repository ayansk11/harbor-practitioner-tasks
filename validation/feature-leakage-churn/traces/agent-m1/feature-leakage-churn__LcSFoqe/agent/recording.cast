[2184.202247, "i", "cat > churn/status.py <<'PY'\n\"\"\"Latest account status visible to the live warehouse query.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nSTRIDE = 10 ** 10\n\n\ndef _seconds(values):\n    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Snapshot with the latest date among rows whose load committed before the prediction.\"\"\"\n    loaded = _seconds(snapshots[\"_loaded_at\"])\n    event = snapshots[\"snapshot_date\"].astype(\"int64\").to_numpy()\n    key = snapshots[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + loaded\n    order = np.argsort(key, kind=\"mergesort\")\n    key = key[order]\n    event = event[order]\n    status = snapshots[\"status\"].to_numpy(dtype=object)[order]\n\n    running_max = np.maximum.accumulate(event)\n    changed = np.r_[True, running_max[1:] != running_max[:-1]]\n    best_status = pd.Series(status, index=snapshots.index).where(changed).ffill().to_numpy(dtype=object)\n\n    point_key = points[\"c"]
[2184.202369, "i", "ustomer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(points[\"as_of\"])\n    pos = np.searchsorted(key, point_key, side=\"left\")\n    result = np.full(len(points), None, dtype=object)\n    known = pos > 0\n    result[known] = best_status[pos[known] - 1]\n    return pd.Series(result, index=points.index, dtype=\"object\")\nPY\n\ncat > churn/attributes.py <<'PY'\n\"\"\"Customer attributes that can be reconstructed historically.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nSTRIDE = 10 ** 10\n\n\ndef _seconds(values):\n    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef plan(points, plan_changes, customers):\n    \"\"\"Plan on the customer record at each prediction, reconstructed from plan changes.\"\"\"\n    current = customers.set_index(\"customer_id\")[\"plan\"]\n    histories = {}\n    if not plan_changes.empty:\n        changes = plan_changes.copy()\n        changes[\"commit\"] = _seconds(changes[\"_loaded_at\"])\n        first = changes.sort_values([\"customer_id\", \"cha"]
[2184.202415, "i", "nged_at\"], kind=\"mergesort\")\n        initial = first.groupby(\"customer_id\", sort=False).first()[\"old_plan\"]\n        for cid, group in changes.groupby(\"customer_id\", sort=False):\n            base = initial.loc[cid]\n            if pd.isna(base):\n                base = current.get(cid)\n            group = group.sort_values([\"commit\", \"changed_at\"], kind=\"mergesort\")\n            best_changed = None\n            best_plan = base\n            commit_times = []\n            plan_values = []\n            for commit, rows in group.groupby(\"commit\", sort=True):\n                for changed_at, new_plan in zip(rows[\"changed_at\"].to_numpy(), rows[\"new_plan\"].to_numpy()):\n                    if best_changed is None or changed_at > best_changed:\n                        best_changed = changed_at\n                        best_plan = new_plan\n                commit_times.append(int(commit))\n                plan_values.append(best_plan)\n            histories[int(cid)] = (base, np.asarray(commit_times, dtype=\"int64\"), plan_values)\n\n "]
[2184.202452, "i", "   result = np.full(len(points), None, dtype=object)\n    for i, (cid, at) in enumerate(zip(points[\"customer_id\"].to_numpy(), points[\"as_of\"].to_numpy())):\n        cid = int(cid)\n        if cid not in current.index:\n            continue\n        if cid not in histories:\n            value = current.loc[cid]\n            result[i] = None if pd.isna(value) else value\n            continue\n        base, commits, values = histories[cid]\n        pos = np.searchsorted(commits, _seconds(pd.Series([at]))[0], side=\"left\")\n        result[i] = base if pos == 0 else values[pos - 1]\n    return pd.Series(result, index=points.index, dtype=\"object\")\n\n\ndef days_since_last_login(points, customers):\n    \"\"\"Kept only as null in the offline table: login history is not in the warehouse extract.\"\"\"\n    return pd.Series(np.nan, index=points.index, dtype=\"float64\")\nPY\n\ncat > churn/encoding.py <<'PY'\n\"\"\"Point-in-time smoothed district target encoding.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nS"]
[2184.202484, "i", "TRIDE = 10 ** 10\n\n\ndef _seconds(values):\n    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef district_encoding(points, labels, customers, m=20):\n    \"\"\"Reproduce the live SQL using label rows committed before each prediction.\"\"\"\n    districts = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    lab = labels.copy()\n    lab[\"postcode_district\"] = lab[\"customer_id\"].map(districts)\n    lab = lab[lab[\"postcode_district\"].notna()].copy()\n\n    all_districts = pd.concat([lab[\"postcode_district\"], points[\"customer_id\"].map(districts)], ignore_index=True)\n    codes = all_districts.astype(\"category\").cat.codes.to_numpy()\n    lab_codes = codes[:len(lab)]\n    point_codes = codes[len(lab):]\n\n    y = pd.to_numeric(lab[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\n    y_sum = np.nancumsum(y)\n    y_seen = np.cumsum(~np.isnan(y))\n    n_rows = np.arange(1, len(lab) + 1, dtype=\"int64\")\n\n    loaded = _seconds(lab[\"_loaded_at\"])\n    order = np.argsort(loaded, kind=\"mergesort"]
[2184.202511, "i", "\")\n    global_load = loaded[order]\n    global_sum = y_sum[order]\n    global_seen = y_seen[order]\n    global_rows = n_rows[order]\n\n    key = lab_codes.astype(\"int64\") * STRIDE + loaded\n    order2 = np.argsort(key, kind=\"mergesort\")\n    district_key = key[order2]\n    district_sum = y_sum[order2]\n    district_rows = n_rows[order2]\n\n    t = _seconds(points[\"as_of\"])\n    gp = np.searchsorted(global_load, t, side=\"left\")\n    global_n = np.where(gp > 0, global_rows[np.maximum(gp - 1, 0)], 0)\n    global_s = np.where(gp > 0, global_sum[np.maximum(gp - 1, 0)], 0.0)\n    global_seen_n = np.where(gp > 0, global_seen[np.maximum(gp - 1, 0)], 0)\n    prior = np.full(len(points), 0.05, dtype=\"float64\")\n    has_prior = global_seen_n > 0\n    prior[has_prior] = global_s[has_prior] / global_seen_n[has_prior]\n\n    point_key = point_codes.astype(\"int64\") * STRIDE + t\n    hp = np.searchsorted(district_key, point_key, side=\"left\")\n    n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)\n    s = np.where(hp > 0, district_sum[n"]
[2184.202542, "i", "p.maximum(hp - 1, 0)], 0.0)\n    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\nPY\n\npython3 - <<'PY'\np='churn/build_features.py'\ns=open(p).read()\ns=s.replace('import os\\n', 'import os\\n')\ns=s.replace('from churn.status import latest_status\\n', 'from churn.status import latest_status\\nfrom churn.visibility import order_commit_times\\n')\ns=s.replace('FEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\\n                   \"tenure_days\", \"status\", \"plan\", \"days_since_last_login\", \"app_minutes_7d\", \"te_district\"]', 'FEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\\n                   \"tenure_days\", \"status\", \"plan\", \"app_minutes_7d\", \"te_district\"]')\ns=s.replace('    t = load_extract(data_dir)\\n', '    t = load_extract(data_dir)\\n    t[\"orders\"][\"_effective_loaded_at\"] = order_commit_times(\\n        t[\"orders\"], os.path.join(data_dir, \"_ops\")\\n    )\\n')\ns=s.replace('    feats"]
[2184.202571, "i", "[\"plan\"] = plan(points, t[\"customers\"])\\n', '    feats[\"plan\"] = plan(points, t[\"plan_changes\"], t[\"customers\"])\\n')\nopen(p,'w').write(s)\nPY\npython3 -m py_compile churn/*.py\nsed -n '1,120p' churn/build_features.py\n"]
