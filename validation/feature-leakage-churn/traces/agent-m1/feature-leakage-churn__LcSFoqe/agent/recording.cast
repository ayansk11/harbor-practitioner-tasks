[2491.520616, "i", "cat > churn/visibility.py <<'PY'\n\"\"\"Warehouse visibility metadata reconstructed from an extract's `_ops` records.\n\nAppend rows normally become visible at their `_loaded_at`, but a table can be replaced by a\nbackfill and rename.  A query reads the table *name* which was current when it started, so rows in\nthe replacement are not visible merely because they were loaded into its old name.\n\"\"\"\nimport os\nimport re\nimport json\n\nimport numpy as np\nimport pandas as pd\n\n_SELECT_RE = re.compile(\n    r\"^\\S+ legacy_orders run=\\S+ selected orders where ordered_at >= (\\S+) \"\n    r\"and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)$\"\n)\n_STATEMENT_RE = re.compile(\n    r\"statement:\\s*ALTER TABLE\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+RENAME TO\\s+\"\n    r\"([A-Za-z_][A-Za-z0-9_]*)\\s*$\"\n)\n_TXN_RE = re.compile(r\"schema_migrations run=\\S+ sent txn (\\d+) to commit\")\n\n\ndef _committed_transactions(ops_dir):\n    path = os.path.join(ops_dir, \"commits.jsonl\")\n    committed = {}\n    with open(path, encoding=\"utf-8\") as fh:\n    "]
[2491.52074, "i", "    for line in fh:\n            row = json.loads(line)\n            if row.get(\"outcome\") == \"commit\" and row.get(\"at\"):\n                committed[int(row[\"txn\"])] = pd.to_datetime(row[\"at\"], utc=True)\n    return committed\n\n\ndef _orders_rename_commit(ops_dir, committed):\n    \"\"\"Find a committed schema transaction which renamed another table to `orders`.\"\"\"\n    statements = []\n    candidates = []\n    with open(os.path.join(ops_dir, \"scheduler.log\"), encoding=\"utf-8\") as fh:\n        for line in fh:\n            match = _STATEMENT_RE.search(line)\n            if match:\n                statements.append((match.group(1), match.group(2)))\n                continue\n            match = _TXN_RE.search(line)\n            if match:\n                txn = int(match.group(1))\n                if any(new_name == \"orders\" for _old_name, new_name in statements):\n                    candidates.append((txn, tuple(statements)))\n                statements = []\n    for txn, _statements in reversed(candidates):\n        at = committed.get"]
[2491.520808, "i", "(txn)\n        if at is not None:\n            return at\n    return None\n\n\ndef _legacy_intervals(ops_dir, committed, rename_at):\n    \"\"\"Committed event intervals loaded into the old table named `orders`.\"\"\"\n    intervals = []\n    with open(os.path.join(ops_dir, \"scheduler.log\"), encoding=\"utf-8\") as fh:\n        for line in fh:\n            match = _SELECT_RE.match(line.rstrip(\"\\n\"))\n            if not match:\n                continue\n            start, end, selected, txn, table = match.groups()\n            if table != \"orders\" or int(selected) == 0:\n                continue\n            at = committed.get(int(txn))\n            if at is not None and at < rename_at:\n                intervals.append((pd.Timestamp(start).value, pd.Timestamp(end).value, at.value))\n    if not intervals:\n        return np.empty((0, 3), dtype=\"int64\")\n    result = pd.DataFrame(intervals, columns=[\"start\", \"end\", \"at\"])\n    # A failed transaction was retried.  The first committed selection of an event interval\n    # is the moment those row"]
[2491.520866, "i", "s became visible in the old table.\n    result = result.sort_values([\"start\", \"at\"], kind=\"mergesort\")\n    result = result.drop_duplicates(\"start\", keep=\"first\")\n    return result[[\"start\", \"end\", \"at\"]].to_numpy(dtype=\"int64\")\n\n\ndef order_commit_times(orders, ops_dir):\n    \"\"\"Effective commit time of each row of the final `orders` table.\"\"\"\n    rename_at = _orders_rename_commit(ops_dir, _committed_transactions(ops_dir))\n    if rename_at is None:\n        return orders[\"_loaded_at\"].copy()\n\n    loaded = orders[\"_loaded_at\"].astype(\"int64\").to_numpy(dtype=\"int64\")\n    ordered = orders[\"ordered_at\"].astype(\"int64\").to_numpy(dtype=\"int64\")\n    rename = int(rename_at.value)\n    intervals = _legacy_intervals(ops_dir, _committed_transactions(ops_dir), rename_at)\n\n    visible = loaded.copy()\n    pre_rename = ordered < rename\n    if not pre_rename.any() or len(intervals) == 0:\n        visible[pre_rename] = np.maximum(loaded[pre_rename], rename)\n        return pd.Series(pd.to_datetime(visible, utc=True), index=orders.in"]
[2491.520907, "i", "dex)\n\n    starts = intervals[:, 0]\n    ends = intervals[:, 1]\n    commit = intervals[:, 2]\n    pos = np.searchsorted(starts, ordered[pre_rename], side=\"right\") - 1\n    clipped = np.clip(pos, 0, len(starts) - 1)\n    known = (pos >= 0) & (ordered[pre_rename] < ends[clipped])\n    old_commit = commit[clipped]\n    replacement_commit = np.maximum(loaded[pre_rename], rename)\n    visible[pre_rename] = np.where(known, old_commit, replacement_commit)\n    return pd.Series(pd.to_datetime(visible, utc=True), index=orders.index)\nPY\n\ncat > churn/status.py <<'PY'\n\"\"\"Latest account status visible to the live warehouse query.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nSTRIDE = 10 ** 10\n\n\ndef _seconds(values):\n    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef latest_status(points, snapshots):\n    \"\"\"Snapshot with the latest date among rows whose load committed before each prediction.\"\"\"\n    event = snapshots[\"snapshot_date\"].astype(\"int64\").to_num"]
[2491.520988, "i", "py(dtype=\"int64\")\n    loaded = _seconds(snapshots[\"_loaded_at\"])\n    customer = snapshots[\"customer_id\"].to_numpy(dtype=\"int64\")\n    key = customer * STRIDE + loaded\n    order = np.argsort(key, kind=\"mergesort\")\n    customer = customer[order]\n    event = event[order]\n    status = snapshots[\"status\"].to_numpy(dtype=object)[order]\n\n    # Reset the running maximum of snapshot date at every customer boundary.\n    running_max = np.empty(len(event), dtype=event.dtype)\n    previous = None\n    current_max = None\n    for i, (cid, value) in enumerate(zip(customer, event)):\n        if cid != previous:\n            current_max = value\n            previous = cid\n        elif value > current_max:\n            current_max = value\n        running_max[i] = current_max\n    changed = np.r_[True, running_max[1:] != running_max[:-1]]\n    best_status = pd.Series(status, index=snapshots.index).where(changed).ffill().to_numpy(dtype=object)\n\n    point_key = points[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(points[\"as_of"]
[2491.521031, "o", "cat > churn/visibility.py <<'PY'\r\n\u001b[?2004l\r"]
[2491.521066, "i", "\"])\n    pos = np.searchsorted(key, point_key, side=\"left\")\n    result = np.full(len(points), None, dtype=object)\n    known = pos > 0\n    result[known] = best_status[pos[known] - 1]\n    return pd.Series(result, index=points.index, dtype=\"object\")\nPY\n\ncat > churn/encoding.py <<'PY'\n\"\"\"Point-in-time smoothed district target encoding.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nSTRIDE = 10 ** 10\n\n\ndef _seconds(values):\n    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef district_encoding(points, labels, customers, m=20):\n    \"\"\"Reproduce the live SQL using label rows committed before each prediction.\"\"\"\n    districts = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    lab = labels.copy()\n    lab[\"postcode_district\"] = lab[\"customer_id\"].map(districts)\n    lab = lab[lab[\"postcode_district\"].notna()].copy()\n\n    all_districts = pd.concat(\n        [lab[\"postcode_district\"], points[\"customer_id\"].map(districts)], ignore_index=Tru"]
[2491.521107, "i", "e\n    )\n    codes = all_districts.astype(\"category\").cat.codes.to_numpy(dtype=\"int64\")\n    lab_codes = codes[:len(lab)]\n    point_codes = codes[len(lab):]\n\n    y = pd.to_numeric(lab[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\n    valid = ~np.isnan(y)\n    y_filled = np.where(valid, y, 0.0)\n\n    # Global prior: cumulative sum and non-null count by commit time.\n    loaded = _seconds(lab[\"_loaded_at\"])\n    order = np.argsort(loaded, kind=\"mergesort\")\n    global_load = loaded[order]\n    global_sum = np.cumsum(y_filled[order])\n    global_count = np.cumsum(valid[order]).astype(\"int64\")\n    global_rows = np.arange(1, len(lab) + 1, dtype=\"int64\")[order]\n\n    # District numerator/denominator: cumulative values reset at each district boundary.\n    key = lab_codes.astype(\"int64\") * STRIDE + loaded\n    order2 = np.argsort(key, kind=\"mergesort\")\n    district_key = key[order2]\n    district_sorted = lab_codes[order2]\n    district_sum = np.cumsum(y_filled[order2])\n    district_count = np.cumsum(valid[order2]).a"]
[2491.521143, "o", "\u001b[?2004h> "]
[2491.52118, "i", "stype(\"int64\")\n    district_rows = np.empty(len(lab), dtype=\"int64\")\n    previous = None\n    count = 0\n    for i, cid in enumerate(district_sorted):\n        if cid != previous:\n            count = 0\n            previous = cid\n        count += 1\n        district_rows[i] = count\n\n    t = _seconds(points[\"as_of\"])\n    gp = np.searchsorted(global_load, t, side=\"left\")\n    global_n = np.where(gp > 0, global_rows[np.maximum(gp - 1, 0)], 0)\n    global_s = np.where(gp > 0, global_sum[np.maximum(gp - 1, 0)], 0.0)\n    global_seen = np.where(gp > 0, global_count[np.maximum(gp - 1, 0)], 0)\n    prior = np.full(len(points), 0.05, dtype=\"float64\")\n    has_prior = global_seen > 0\n    prior[has_prior] = global_s[has_prior] / global_seen[has_prior]\n\n    point_key = point_codes.astype(\"int64\") * STRIDE + t\n    hp = np.searchsorted(district_key, point_key, side=\"left\")\n    district_n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)\n    district_s = np.where(hp > 0, district_sum[np.maximum(hp - 1, 0)], 0.0)\n    return "]
[2491.521213, "i", "pd.Series((district_s + m * prior) / (district_n + m), index=points.index, dtype=\"float64\")\nPY\npython3 -m py_compile churn/*.py\n"]
