[3397.978015, "i", "python3 - <<'PY'\nimport pandas as pd, json, numpy as np\nf=pd.read_parquet('/tmp/features.parquet')\nsamples=[json.loads(x) for x in open('/app/logs/live_2026-01_sample.jsonl')]\ns=pd.DataFrame([{'customer_id':r['customer_id'],'as_of':pd.to_datetime(r['as_of'],utc=True),**r['features']} for r in samples])\nz=f.merge(s,on=['customer_id','as_of'],suffixes=('_out','_live'),indicator=True)\nprint('rows/columns',f.shape,'sample joins',len(z))\nfor feat in ['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','app_minutes_7d','te_district']:\n    a=z[feat+'_out']; b=z[feat+'_live']\n    if pd.api.types.is_numeric_dtype(b):\n        an=pd.to_numeric(a,errors='coerce'); bn=pd.to_numeric(b,errors='coerce')\n        ok=an.isna() & bn.isna()\n        ok |= an.notna() & bn.notna() & ((an-bn).abs() <= 1e-6 + 1e-9*bn.abs())\n    else:\n        ok=a.astype(object).where(a.notna(),None) == b.astype(object).where(b.notna(),None)\n    print(feat,'mismatches',int((~ok).sum()),'of',len"]
[3397.978192, "i", "(z))\n    if (~ok).any(): print(z.loc[~ok,['customer_id','as_of',feat+'_out',feat+'_live']].head(3).to_string(index=False))\nPY\n"]
