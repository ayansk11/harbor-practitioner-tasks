[283.855505, "i", "python3 - <<'PY'\nimport re\nfrom collections import Counter,defaultdict\nL=open('data/_ops/scheduler.log').read().splitlines(); by=defaultdict(Counter)\nfor s in L:\n a=s.split(' ',2); d=a[0][:7]; j=a[1]\n if 'state=running' in s: by[(d,j)]['running']+=1\n elif 'state=success' in s: by[(d,j)]['success']+=1\n elif 'state=failed' in s: by[(d,j)]['failed']+=1\n elif 'selected orders' in s: by[(d,j)]['selected']+=1\n elif 'sent txn' in s: by[(d,j)]['txn']+=1\n elif 'wrote' in s: by[(d,j)]['wrote']+=1\n elif 'statement' in s: by[(d,j)]['statement']+=1\n else: by[(d,j)]['other']+=1\nfor (d,j),x in sorted(by.items()):\n print(d,j,dict(x))\nPY\n"]
