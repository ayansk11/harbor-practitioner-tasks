[2183.719746, "i", "cat > churn/visibility.py <<'PY'\n\"\"\"Warehouse visibility metadata reconstructed from an extract's `_ops` records.\n\nAppend rows normally become visible at their `_loaded_at`, but a table can be replaced by a\nbackfill/rename.  A query reads the table *name* which was current when it started, so rows in the\nreplacement are not visible merely because they were loaded into its old name.\n\"\"\"\nimport os\nimport re\nimport json\n\nimport numpy as np\nimport pandas as pd\n\n_SELECT_RE = re.compile(\n    r\"^\\S+ legacy_orders run=\\S+ selected orders where ordered_at >= (\\S+) \"\n    r\"and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)$\"\n)\n_STATEMENT_RE = re.compile(\n    r\"statement:\\s*ALTER TABLE\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+RENAME TO\\s+\"\n    r\"([A-Za-z_][A-Za-z0-9_]*)\\s*$\"\n)\n_TXN_RE = re.compile(r\"schema_migrations run=\\S+ sent txn (\\d+) to commit\")\n\n\ndef _committed_transactions(ops_dir):\n    path = os.path.join(ops_dir, \"commits.jsonl\")\n    committed = {}\n    with open(path, encoding=\"utf-8\") as fh:\n        "]
[2183.71988, "i", "for line in fh:\n            row = json.loads(line)\n            if row.get(\"outcome\") == \"commit\" and row.get(\"at\"):\n                committed[int(row[\"txn\"])] = pd.to_datetime(row[\"at\"], utc=True)\n    return committed\n\n\ndef _orders_rename_commit(ops_dir, committed):\n    \"\"\"Find the last committed schema transaction which renamed another table to `orders`.\"\"\"\n    statements = []\n    candidates = []\n    with open(os.path.join(ops_dir, \"scheduler.log\"), encoding=\"utf-8\") as fh:\n        for line in fh:\n            match = _STATEMENT_RE.search(line)\n            if match:\n                statements.append((match.group(1), match.group(2)))\n                continue\n            match = _TXN_RE.search(line)\n            if match:\n                txn = int(match.group(1))\n                if any(new_name == \"orders\" for _old_name, new_name in statements):\n                    candidates.append((txn, tuple(statements)))\n                statements = []\n    for txn, _statements in reversed(candidates):\n        at = committed."]
[2183.719949, "i", "get(txn)\n        if at is not None:\n            return at\n    return None\n\n\ndef _legacy_intervals(ops_dir, committed, rename_at):\n    intervals = []\n    with open(os.path.join(ops_dir, \"scheduler.log\"), encoding=\"utf-8\") as fh:\n        for line in fh:\n            match = _SELECT_RE.match(line.rstrip(\"\\n\"))\n            if not match:\n                continue\n            start, end, selected, txn, table = match.groups()\n            if table != \"orders\" or int(selected) == 0:\n                continue\n            at = committed.get(int(txn))\n            if at is not None and at < rename_at:\n                intervals.append((pd.Timestamp(start), pd.Timestamp(end), at))\n    if not intervals:\n        return pd.DataFrame(columns=[\"start\", \"end\", \"at\"])\n    result = pd.DataFrame(intervals, columns=[\"start\", \"end\", \"at\"])\n    # A failed transaction was retried.  The first committed selection of an event interval\n    # is the moment those rows became visible in the old table.\n    result = result.sort_values([\"start\", \"at"]
[2183.720008, "i", "\"], kind=\"mergesort\")\n    result = result.drop_duplicates(\"start\", keep=\"first\")\n    return result\n\n\ndef order_commit_times(orders, ops_dir):\n    \"\"\"Effective commit time of each row of the final `orders` table.\n\n    For rows from a replacement table, this accounts for the time before that table was the one\n    named `orders`.  Rows selected by the old daily loader use its committed transaction time.\n    \"\"\"\n    visible = orders[\"_loaded_at\"].copy()\n    rename_at = _orders_rename_commit(ops_dir, _committed_transactions(ops_dir))\n    if rename_at is None:\n        return visible\n\n    intervals = _legacy_intervals(ops_dir, _committed_transactions(ops_dir), rename_at)\n    loaded = orders[\"_loaded_at\"].to_numpy(dtype=\"datetime64[ns]\")\n    ordered = orders[\"ordered_at\"].to_numpy(dtype=\"datetime64[ns]\")\n    rename = rename_at.to_datetime64()\n    pre_rename = ordered < rename\n\n    if intervals.empty:\n        visible.iloc[pre_rename] = np.maximum(loaded[pre_rename], rename)\n        return pd.to_datetime(visible, utc=T"]
[2183.720057, "i", "rue)\n\n    starts = intervals[\"start\"].to_numpy(dtype=\"datetime64[ns]\")\n    ends = intervals[\"end\"].to_numpy(dtype=\"datetime64[ns]\")\n    commit = intervals[\"at\"].to_numpy(dtype=\"datetime64[ns]\")\n    pos = np.searchsorted(starts, ordered[pre_rename], side=\"right\") - 1\n    clipped = np.clip(pos, 0, len(starts) - 1)\n    known = (pos >= 0) & (ordered[pre_rename] < ends[clipped])\n    old_commit = commit[clipped]\n    replacement_commit = np.maximum(loaded[pre_rename], rename)\n    visible.iloc[pre_rename] = np.where(known, old_commit, replacement_commit)\n    return pd.to_datetime(visible, utc=True)\nPY\n\ncat > churn/windows.py <<'PY'\n\"\"\"Point-in-time order and ticket features.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\n\n\ndef _seconds(values):\n    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef _timestamp(value):\n    return value.to_datetime64()\n\n\ndef activity_features(points, orders, tickets):\n    \"\"\"Live order/ticket values using only rows"]
[2183.720099, "i", " committed before each prediction.\"\"\"\n    n = len(points)\n    orders_7d = np.zeros(n, dtype=\"int64\")\n    orders_30d = np.zeros(n, dtype=\"int64\")\n    spend = np.zeros(n, dtype=\"int64\")\n    tickets_30d = np.zeros(n, dtype=\"int64\")\n    last_order_days = np.full(n, np.nan, dtype=\"float64\")\n\n    def event_groups(frame, event_col):\n        frame = frame.sort_values([\"customer_id\", event_col], kind=\"mergesort\")\n        groups = {}\n        for cid, group in frame.groupby(\"customer_id\", sort=False):\n            times = group[event_col].to_numpy(dtype=\"datetime64[ns]\")\n            loads = group[\"_effective_loaded_at\"].to_numpy(dtype=\"datetime64[ns]\")\n            if \"amount_cents\" in group:\n                amounts = group[\"amount_cents\"].to_numpy(dtype=\"float64\")\n            else:\n                amounts = np.empty(len(group), dtype=\"float64\")\n            groups[int(cid)] = (times, loads, amounts)\n        return groups\n\n    order_groups = event_groups(orders, \"ordered_at\")\n    ticket_groups = event_groups(tickets, \"open"]
