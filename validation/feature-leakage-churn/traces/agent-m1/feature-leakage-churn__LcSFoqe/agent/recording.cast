[36.362809, "i", "nl -ba live/features.py | sed -n '1,70p'\n"]
[36.363174, "o", "nl -ba live/features.py | sed -n '1,70p'\r\n\u001b[?2004l\r"]
[36.365143, "o", "     1\t\"\"\"Feature queries of the live churn scoring service: a read-only copy of the service's `features` module.\r\n     2\t\r\n     3\tThis copy is the contract between the live service and the offline pipeline in `churn/`. It is kept for reference:\r\n     4\tnothing in this repository imports or runs it, there is no warehouse connection here, and editing it changes nothing.\r\n     5\t\r\n     6\tHow the service uses it. A scoring request names a customer and a moment: the 06:00 batch run (trigger `batch`), or\r\n     7\tthe support desk when a ticket is opened (trigger `ticket`, at the ticket's `opened_at`). For each request the service\r\n     8\truns every query in QUERIES once, at the moment of the request, against the warehouse tables as they stand at that\r\n     9\tmoment, and takes the first column of the first row as the feature's value; a query that returns no row, or NULL,\r\n    10\tgives a null value. The service then scores the 11 values with the deployed model, if one is attached, and logs them\r\n"]
[36.365188, "o", "    11\twith the request.\r\n    12\t\r\n    13\tParameters of every query:\r\n    14\t    :customer_id     the request's customer\r\n    15\t    :now             the moment of the request (the `as_of` the scoring service records for it)\r\n"]
[36.365213, "o", "    16\t    :app_minutes_7d  the product-analytics reading that came with the request, NULL when it came without one\r\n    17\t\r\n    18\tThe warehouse is PostgreSQL. Timestamps are `timestamptz` and sessions run in UTC, so INTERVAL '7 days' is exactly\r\n    19\t7 x 86,400 seconds and EXTRACT(EPOCH FROM <interval>) is a number of seconds. The tables, and when their rows and\r\n    20\tvalues are committed: docs/WAREHOUSE.md.\r\n    21\t\"\"\"\r\n    22\t\r\n    23\tQUERIES = {\r\n    24\t    # orders in the 7 days before the request\r\n    25\t    \"orders_7d\": \"\"\"\r\n    26\t        SELECT COUNT(*)\r\n"]
[36.365233, "o", "    27\t        FROM orders\r\n    28\t        WHERE customer_id = :customer_id\r\n    29\t          AND ordered_at >= :now - INTERVAL '7 days'\r\n    30\t          AND ordered_at < :now\r\n    31\t    \"\"\",\r\n    32\t    # orders in the 30 days before the request\r\n    33\t    \"orders_30d\": \"\"\"\r\n"]
[36.365252, "o", "    34\t        SELECT COUNT(*)\r\n    35\t        FROM orders\r\n    36\t        WHERE customer_id = :customer_id\r\n    37\t          AND ordered_at >= :now - INTERVAL '30 days'\r\n    38\t          AND ordered_at < :now\r\n    39\t    \"\"\",\r\n    40\t    # amount of those orders, in cents (0 when there are none)\r\n    41\t"]
[36.365267, "o", "    \"spend_30d_cents\": \"\"\"\r\n    42\t        SELECT COALESCE(SUM(amount_cents), 0)\r\n    43\t        FROM orders\r\n    44\t        WHERE customer_id = :customer_id\r\n    45\t          AND ordered_at >= :now - INTERVAL '30 days'\r\n    46\t          AND ordered_at < :now\r\n"]
[36.365293, "o", "    47\t    \"\"\",\r\n    48\t    # support tickets opened in the 30 days before the request\r\n    49\t    \"tickets_30d\": \"\"\"\r\n    50\t        SELECT COUNT(*)\r\n    51\t        FROM tickets\r\n"]
[36.36531, "o", "    52\t        WHERE customer_id = :customer_id\r\n    53\t          AND opened_at >= :now - INTERVAL '30 days'\r\n    54\t          AND opened_at < :now\r\n    55\t    \"\"\",\r\n    56\t    # days since the latest order before the request (NULL when there is none)\r\n    57\t    \"days_since_last_order\": \"\"\"\r\n    58\t        SELECT EXTRACT(EPOCH FROM (:now - MAX(ordered_at))) / 86400.0\r\n    59\t        FROM orders\r\n    60\t        WHERE customer_id = :customer_id\r\n"]
[36.365327, "o", "    61\t          AND ordered_at < :now\r\n    62\t    \"\"\",\r\n    63\t    # days since sign-up\r\n    64\t    \"tenure_days\": \"\"\"\r\n    65\t        SELECT EXTRACT(EPOCH FROM (:now - signup_at)) / 86400.0\r\n    66\t        FROM customers\r\n"]
[36.365342, "o", "    67\t        WHERE customer_id = :customer_id\r\n    68\t    \"\"\",\r\n    69\t    # account status of the latest snapshot (no row: NULL)\r\n    70\t    \"status\": \"\"\"\r\n"]
