[43.928808, "i", "for f in churn/extract.py churn/windows.py churn/status.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[43.929574, "o", "for f in churn/extract.py churn/windows.py churn/status.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[43.929669, "o", "===== churn/extract.py =====\r\n"]
[43.930811, "o", "     1\t\"\"\"Load a warehouse extract (the seven CSV files described in docs/WAREHOUSE.md) into pandas frames.\r\n     2\t\r\n     3\tEvery timestamp column is parsed to a UTC timestamp, the load metadata columns included, so each frame carries\r\n     4\teverything its CSV file has.\r\n     5\t\"\"\"\r\n     6\timport os\r\n     7\timport pandas as pd\r\n     8\t\r\n     9\tTIMESTAMPS = {\r\n    10\t    \"customers\": [\"signup_at\", \"last_login_at\", \"_updated_at\"],\r\n    11\t    \"plan_changes\": [\"changed_at\", \"_loaded_at\"],\r\n    12\t    \"scoring_points\": [\"as_of\"],\r\n    13\t    \"orders\": [\"ordered_at\", \"_loaded_at\"],\r\n    14\t    \"tickets\": [\"opened_at\", \"_loaded_at\"],\r\n    15\t    \"status_snapshots\": [\"snapshot_date\", \"_loaded_at\"],\r\n    16\t    \"labels\": [\"as_of\", \"_loaded_at\"],\r\n    17\t}\r\n    18"]
[43.930871, "o", "\t\r\n    19\t\r\n    20\tdef load_extract(data_dir):\r\n    21\t    tables = {}\r\n    22\t    for name, cols in TIMESTAMPS.items():\r\n    23\t        df = pd.read_csv(os.path.join(data_dir, f\"{name}.csv\"), dtype={\"postcode_district\": \"str\"})\r\n    24\t        for c in cols:\r\n    25\t            df[c] = pd.to_datetime(df[c], utc=True)\r\n    26\t        tables[name] = df\r\n    27\t    tables[\"scoring_points\"][\"app_minutes_7d\"] = tables[\"scoring_points\"][\"app_minutes_7d\"].astype(\"float64\")\r\n    28\t    return tables\r\n"]
[43.931045, "o", "===== churn/windows.py =====\r\n"]
[43.931988, "o", "     1\t\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time-since features.\r\n     2\t\r\n     3\tPoint in time (INC-2041): a window is [t - W days, t) on the exact event timestamps, so an event stamped at or after\r\n     4\tthe prediction time is never counted and nothing later in the day leaks in.\r\n     5\t\"\"\"\r\n     6\timport numpy as np\r\n     7\timport pandas as pd\r\n     8\t\r\n     9\tEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n    10\tSTRIDE = 10 ** 10  # composite key customer_id * STRIDE + epoch seconds (seconds stay below 1e10 until 2286)\r\n    11\t\r\n    12\t\r\n"]
[43.932036, "o", "    13\tdef _seconds(ts):\r\n    14\t    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n    15\t\r\n    16\t\r\n    17\tdef _window(points, events, ts_col, days, amount_col=None):\r\n    18\t    \"\"\"Per prediction: number (and amount sum) of the customer's events with t - days <= ts < t.\"\"\"\r\n    19\t    ev_key = events[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(events[ts_col])\r\n    20\t    order = np.argsort(ev_key, kind=\"stable\")\r\n    21\t    ev_key = ev_key[order]\r\n    22\t    cid = points[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE\r\n    23\t    t = _seconds(points[\"as_of\"])\r\n    24\t    hi = np.searchsorted(ev_key, cid + t, side=\"left\")\r\n    25\t    lo = np.searchsorted(ev_key, cid + t - days * 86400, side=\"left\")\r\n    26\t    count = hi - lo\r\n    27\t    if amount_col is None:\r\n    28\t        return count, None\r\n    29\t    pref = np.concatenate([[0], np.cumsum(events[amount_col].to_numpy(dtype=\"int64\")[order])])\r\n    30\t    return count, pref[hi] - pref[lo]\r\n    31\t\r\n"]
[43.932076, "o", "    32\t\r\n    33\tdef activity_features(points, orders, tickets):\r\n    34\t    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n    35\t    out[\"orders_7d\"], _ = _window(points, orders, \"ordered_at\", 7)\r\n    36\t    out[\"orders_30d\"], out[\"spend_30d_cents\"] = _window(points, orders, \"ordered_at\", 30, \"amount_cents\")\r\n    37\t    out[\"tickets_30d\"], _ = _window(points, tickets, \"opened_at\", 30)\r\n    38\t\r\n    39\t    # time since the last order strictly before the prediction\r\n    40\t    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n    41\t    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n    42\t    last = pd.merge_asof(left, o, left_on=\"as_of\", right_on=\"ordered_at\", by=\"customer_id\",\r\n    43\t                         allow_exact_matches=False).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n    44\t    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    45\t    return out\r\n    46\t\r\n    47\t\r\n    48\tdef tenure_days(points, customers):\r\n"]
[43.932111, "o", "    49\t    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n    50\t    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n"]
[43.932265, "o", "===== churn/status.py =====\r\n"]
[43.933164, "o", "     1\t\"\"\"Account status from the billing system's status snapshots, point in time (INC-2041).\r\n     2\t\r\n     3\tA snapshot dated D records the status at the end of day D, so a prediction at t may only use snapshots dated before\r\n     4\tdate(t).\r\n     5\t\"\"\"\r\n     6\timport pandas as pd\r\n     7\t\r\n     8\t\r\n     9\tdef latest_status(points, snapshots):\r\n"]
[43.933197, "o", "    10\t    \"\"\"Status of the customer's latest snapshot dated before the prediction's UTC date (null if none).\"\"\"\r\n    11\t    left = points[[\"customer_id\"]].assign(day=points[\"as_of\"].dt.floor(\"D\")).reset_index()\r\n    12\t    left = left.sort_values(\"day\", kind=\"mergesort\")\r\n    13\t    snaps = snapshots.sort_values(\"snapshot_date\", kind=\"mergesort\")[[\"customer_id\", \"snapshot_date\", \"status\"]]\r\n    14\t    snaps = snaps.assign(snapshot_date=snaps[\"snapshot_date\"].astype(left[\"day\"].dtype))\r\n    15\t    m = pd.merge_asof(left, snaps, left_on=\"day\", right_on=\"snapshot_date\", by=\"customer_id\",\r\n    16\t                      allow_exact_matches=False)\r\n    17\t    return m.set_index(\"index\")[\"status\"].reindex(points.index)\r\n"]
[43.93339, "o", "\u001b[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[44.435079, "i", "for f in churn/attributes.py churn/impute.py churn/encoding.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[44.435477, "o", "for f in churn/attributes.py churn/impute.py churn/encoding.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[44.435622, "o", "===== churn/attributes.py =====\r\n"]
[44.436434, "o", "     1\t\"\"\"Customer attributes from the customer record (new in v3): the subscription plan and the days since the last login.\r\n     2\t\r\n     3\tPoint in time: a last login at or after the prediction time is ignored (the feature is null then), so the feature\r\n     4\tnever looks ahead of t.\r\n     5\t\"\"\"\r\n     6\t\r\n"]
[44.436457, "o", "     7\t\r\n     8\tdef plan(points, customers):\r\n     9\t    \"\"\"The customer's subscription plan.\"\"\"\r\n"]
[44.436474, "o", "    10\t    return points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"])\r\n    11\t\r\n    12\t\r\n    13\tdef days_since_last_login(points, customers):\r\n    14\t    \"\"\"t minus the customer's last login, in days; null when the record has no login before t.\"\"\"\r\n    15\t    last = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"last_login_at\"])\r\n    16\t    days = (points[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    17\t    return days.where(last < points[\"as_of\"])\r\n"]
[44.436604, "o", "===== churn/impute.py =====\r\n"]
[44.437613, "o", "     1\t\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\r\n     2\t\r\n     3\tPoint in time (INC-2041): a missing reading takes the customer's most recent earlier reading, never a later one; with\r\n     4\tno earlier reading it stays null.\r\n     5\t\"\"\"\r\n     6\t\r\n     7\t\r\n     8\tdef fill_app_minutes(points):\r\n     9\t    \"\"\"Fill missing app_minutes_7d from the same customer's last earlier reading.\"\"\"\r\n    10\t    pts = points.sort_values([\"customer_id\", \"as_of\"], kind=\"mergesort\")\r\n    11\t    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].ffill()\r\n    12\t    return filled.reindex(points.index)\r\n"]
[44.437776, "o", "===== churn/encoding.py =====\r\n"]
[44.438953, "o", "     1\t\"\"\"Target encoding of high-cardinality categoricals, point in time (INC-2041).\r\n     2\t\r\n     3\tA label row records whether the customer churned in the 30 days after its own prediction, so its outcome is final only\r\n     4\tonce that window has closed (as_of + 30 days). A prediction at t uses only labels whose window closed before t, for the\r\n     5\tdistrict counts and for the prior alike; its own label and every later one are never seen.\r\n     6\t\"\"\"\r\n     7\timport numpy as np\r\n     8\timport pandas as pd\r\n     9\t\r\n    10\tPRIOR_WEIGHT = 20\r\n    11\tDEFAULT_PRIOR = 0.05\r\n    12\tLABEL_WINDOW_DAYS = 30\r\n    13\tEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n"]
[44.439046, "o", "    14\tSTRIDE = 10 ** 10\r\n    15\t\r\n    16\t\r\n    17\tdef _seconds(ts):\r\n    18\t    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n    19\t\r\n    20\t\r\n    21\tdef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n    22\t    \"\"\"Smoothed churn rate of the customer's postcode district, from labels whose window closed before t.\"\"\"\r\n    23\t    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n    24\t    lab_d = labels[\"customer_id\"].map(district)\r\n    25\t    pt_d = points[\"customer_id\"].map(district)\r\n    26\t    codes, _ = pd.factorize(pd.concat([lab_d, pt_d], ignore_index=True))\r\n"]
[44.439072, "o", "    27\t    lab_code, pt_code = codes[:len(labels)].astype(\"int64\"), codes[len(labels):].astype(\"int64\")\r\n    28\t    closed = _seconds(labels[\"as_of\"]) + LABEL_WINDOW_DAYS * 86400\r\n    29\t    y = labels[\"churned_30d\"].to_numpy(dtype=\"int64\")\r\n    30\t    t = _seconds(points[\"as_of\"])\r\n    31\t\r\n    32\t    order = np.argsort(closed, kind=\"stable\")\r\n    33\t    ycum = np.concatenate([[0], np.cumsum(y[order])])\r\n    34\t    N = np.searchsorted(closed[order], t, side=\"left\")\r\n    35\t    S = ycum[N]\r\n    36\t    prior = np.full(len(t), DEFAULT_PRIOR)\r\n    37\t    has = N > 0\r\n    38\t    prior[has] = S[has] / N[has]\r\n    39\t\r\n    40\t    key = lab_code * STRIDE + closed\r\n    41\t    o2 = np.argsort(key, kind=\"stable\")\r\n    42\t    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])\r\n    43\t    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side=\"left\")\r\n    44\t    lo = np.searchsorted(key[o2], pt_code * STRIDE, side=\"left\")\r\n    45\t    n, s = hi - lo, ycum2[hi] - ycum2[lo]\r\n    46\t    return pd.Series((s + m * prior) / (n +"]
[44.43909, "o", " m), index=points.index, dtype=\"float64\")\r\n"]
