[2776.544243, "i", "to_numpy(dtype=\"int64\")\n    key = customer * STRIDE + loaded\n    order = np.argsort(key, kind=\"mergesort\")\n    customer = customer[order]\n    event = event[order]\n    status = snapshots[\"status\"].to_numpy(dtype=object)[order]\n\n    # The best status is a running maximum of snapshot date, resetting for each customer.\n    running_max = np.empty(len(event), dtype=event.dtype)\n    previous = None\n    current_max = None\n    for i, (cid, value) in enumerate(zip(customer, event)):\n        if cid != previous:\n            current_max = value\n            previous = cid\n        elif value > current_max:\n            current_max = value\n        running_max[i] = current_max\n    changed = np.r_[True, running_max[1:] != running_max[:-1]]\n    best_status = pd.Series(status).where(changed).ffill().to_numpy(dtype=object)\n\n    point_key = points[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(points[\"as_of\"])\n    pos = np.searchsorted(key, point_key, side=\"left\")\n    result = np.full(len(points), None, dtype=object)\n  "]
[2776.544311, "i", "  known = pos > 0\n    result[known] = best_status[pos[known] - 1]\n    return pd.Series(result, index=points.index, dtype=\"object\")\nPY\n\ncat > churn/encoding.py <<'PY'\n\"\"\"Point-in-time smoothed district target encoding.\"\"\"\nimport numpy as np\nimport pandas as pd\n\nEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\nSTRIDE = 10 ** 10\n\n\ndef _seconds(values):\n    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\n\n\ndef district_encoding(points, labels, customers, m=20):\n    \"\"\"Reproduce the live SQL using label rows committed before each prediction.\"\"\"\n    districts = customers.set_index(\"customer_id\")[\"postcode_district\"]\n    lab = labels.copy()\n    lab[\"postcode_district\"] = lab[\"customer_id\"].map(districts)\n    lab = lab[lab[\"postcode_district\"].notna()].copy().reset_index(drop=True)\n\n    all_districts = pd.concat(\n        [lab[\"postcode_district\"], points[\"customer_id\"].map(districts)], ignore_index=True\n    )\n    codes = all_districts.astype(\"category\").cat.codes.to_numpy(dtype=\"int64\")\n    l"]
