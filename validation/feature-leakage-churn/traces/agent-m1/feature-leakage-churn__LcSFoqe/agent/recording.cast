[36.768198, "o", "nl -ba live/features.py | sed -n '71,124p'\r\n\u001b[?2004l\r"]
[36.769753, "o", "    71\t        SELECT status\r\n    72\t        FROM status_snapshots\r\n    73\t        WHERE customer_id = :customer_id\r\n    74\t        ORDER BY snapshot_date DESC\r\n"]
[36.769771, "o", "    75\t        LIMIT 1\r\n    76\t    \"\"\",\r\n"]
[36.76982, "o", "    77\t    # subscription plan on the customer record\r\n    78\t    \"plan\": \"\"\"\r\n    79\t        SELECT plan\r\n    80\t        FROM customers\r\n    81\t        WHERE customer_id = :customer_id\r\n    82\t    \"\"\",\r\n    83\t    # days since the last login on the customer record (NULL when the record has none)\r\n    84\t    \"days_since_last_login\": \"\"\"\r\n    85\t        SELECT EXTRACT(EPOCH FROM (:now - last_login_at)) / 86400.0\r\n    86\t        FROM customers\r\n    87\t        WHERE customer_id = :customer_id\r\n    88\t    \"\"\",\r\n    89\t    # app minutes over the last 7 days: the request's own reading, else the reading of the customer's latest earlier\r\n    90\t    # request that had one (NULL when there is none)\r\n    91\t    \"app_minutes_7d\": \"\"\"\r\n    92\t        SELECT COALESCE(\r\n"]
[36.769856, "o", "    93\t            CAST(:app_minutes_7d AS double precision),\r\n    94\t            (SELECT app_minutes_7d\r\n    95\t             FROM scoring_points\r\n    96\t             WHERE customer_id = :customer_id\r\n    97\t               AND as_of < :now\r\n    98\t               AND app_minutes_7d IS NOT NULL\r\n    99\t             ORDER BY as_of DESC\r\n   100\t             LIMIT 1))\r\n   101"]
[36.769871, "o", "\t    \"\"\",\r\n   102\t    # smoothed churn rate of the customer's postcode district: (s + 20 p) / (n + 20), where p is the mean churned_30d\r\n   103\t    # of all label rows (0.05 when there are none), and n and s are the number of label rows of customers in the same\r\n   104\t    # district and the sum of their churned_30d\r\n   105\t    \"te_district\": \"\"\"\r\n   106\t        WITH lab AS (\r\n   107\t            SELECT l.churned_30d, c.postcode_district\r\n   108"]
[36.76989, "o", "\t            FROM labels l\r\n   109\t            JOIN customers c ON c.customer_id = l.customer_id\r\n   110\t        ),\r\n   111\t        own AS (\r\n   112\t            SELECT postcode_district\r\n"]
[36.769907, "o", "   113\t            FROM customers\r\n   114\t            WHERE customer_id = :customer_id\r\n   115\t        )\r\n   116\t        SELECT (COALESCE(SUM(lab.churned_30d) FILTER (WHERE lab.postcode_district = own.postcode_district), 0)\r\n   117\t                + 20 * COALESCE(AVG(lab.churned_30d), 0.05))\r\n   118\t"]
[36.769924, "o", "               / (COUNT(*) FILTER (WHERE lab.postcode_district = own.postcode_district) + 20)\r\n   119\t        FROM lab CROSS JOIN own\r\n   120\t    \"\"\",\r\n   121\t}\r\n   122\t\r\n   123\tFEATURES = list(QUERIES)\r\n"]
