[3003.82374, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom churn.extract import load_extract\nfrom churn.encoding import _seconds\nfrom churn.status import latest_status\nT=load_extract('/app/data')\npts=pd.DataFrame({'customer_id':[100220,101169],'as_of':pd.to_datetime(['2026-01-06T06:00:00Z','2026-01-07T06:00:00Z'],utc=True)})\nprint('status helper:',latest_status(pts,T['status_snapshots']).tolist())\n# Direct status selected status\nfor cid,t in zip(pts.customer_id,pts.as_of):\n z=T['status_snapshots'][(T['status_snapshots'].customer_id==cid)&(T['status_snapshots']._loaded_at<t)]\n print('direct',cid,z.sort_values('snapshot_date').iloc[-1].to_dict())\n\n# Encoding internals\nlabels=T['labels'].copy(); customers=T['customers'].set_index('customer_id'); labels['district']=labels.customer_id.map(customers.postcode_district)\ncid,t=100012,pd.Timestamp('2026-01-12T06:00:00Z'); d=customers.loc[cid,'postcode_district']\nall_d=pd.concat([labels.district,pd.Series([d])],ignore_index=True)\ncodes=all_d.astype('category').cat.codes.to_"]
[3003.823877, "i", "numpy(dtype='int64'); lab_codes=codes[:-1]; point_code=codes[-1]\ny=pd.to_numeric(labels.churned_30d,errors='coerce').to_numpy(float); valid=~np.isnan(y); yf=np.nan_to_num(y); rows=np.arange(1,len(y)+1)\nloaded=_seconds(labels._loaded_at)\n# global\ngo=np.argsort(loaded,kind='mergesort'); gs=np.cumsum(yf[go]); gn=rows[go]; gc=np.cumsum(valid[go]); gl=loaded[go]\ntsec=_seconds(pd.Series([t]))[0]; p=np.searchsorted(gl,tsec); print('global direct n',p,'s',y[:p].sum(),'algorithm n',gn[p-1],'s',gs[p-1],'count',gc[p-1])\n# district\nkey=lab_codes.astype('int64')*10**10+loaded; pk=int(point_code)*10**10+tsec; o=np.argsort(key,kind='mergesort'); dk=key[o]\nhp=np.searchsorted(dk,pk,side='left'); starts=np.flatnonzero(np.r_[True,lab_codes[o][1:]!=lab_codes[o][:-1]]); ends=np.r_[starts[1:],len(y)]\ngi=np.searchsorted(starts,hp-1,side='right')-1; start=starts[gi]; end=ends[gi]\nprint('hp',hp,'district group',gi,'range',start,end,'expected direct n',end-start,'s',yf[o][start:end].sum())\nprint('algorithm group starts',starts[gi:gi+2"]
[3003.823926, "i", "], 'hp row',hp-1)\ncum_s=np.cumsum(yf[o]); cum_n=rows[o]\ngrp_start_sum=np.where(starts==0,0,cum_s[starts-1]); grp_start_n=np.where(starts==0,0,cum_n[starts-1])\nds=cum_s-np.repeat(grp_start_sum,ends-starts); dn=cum_n-np.repeat(grp_start_n,ends-starts)\nprint('algorithm n',dn[hp-1],'s',ds[hp-1])\nprint('expected value',(yf[o][start:end].sum()+20*y[:p].mean())/(end-start+20))\nprint('algorithm value',(ds[hp-1]+20*gs[p-1]/gc[p-1])/(dn[hp-1]+20))\nPY\n"]
