[608.303188, "o", "# compare samples\r\n\u001b[?2004l\r"]
[608.303208, "o", "\u001b[?2004h"]
[608.303225, "o", "> "]
[608.303535, "o", "samples=pd.DataFrame([json.loads(x) for x in open('/app/logs/live_2026-01_sample.jsonl')])\r\n\u001b[?2004l\r"]
[608.303559, "o", "\u001b[?2004h"]
[608.303577, "o", "> "]
[608.304121, "o", "for feat in ['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','app_minutes_7d','te_district']:\r\n\u001b[?2004l\r"]
[608.304151, "o", "\u001b[?2004h> "]
[608.304182, "o", " vals=[]\r\n\u001b[?2004l\r"]
[608.3042, "o", "\u001b[?2004h> "]
[608.304322, "o", " for r in samples.itertuples():\r\n\u001b[?2004l\r"]
[608.304343, "o", "\u001b[?2004h> "]
[608.304658, "o", "  expected=out.loc[(r.customer_id,pd.Timestamp(r.as_of)),feat]; actual=r.features[feat]\r\n\u001b[?2004l\r"]
[608.304679, "o", "\u001b[?2004h> "]
[608.305521, "o", "  vals.append((pd.isna(expected) and actual is None) or (isinstance(actual,str) and expected==actual) or (isinstance(actual,(int,float)) and not pd.isna(expected) and abs(float(expected)-float(actual))<=1e-6+1e-9*abs(float(actual))))\r\n\u001b[?2004l\r"]
[608.305547, "o", "\u001b[?2004h"]
[608.305565, "o", "> "]
[608.305774, "o", " print(feat,'mismatches',len(vals)-sum(vals),'of',len(vals))\r\n\u001b[?2004l\r"]
[608.305794, "o", "\u001b[?2004h> "]
[608.305966, "o", " for r,ok in zip(samples.itertuples(),vals):\r\n\u001b[?2004l\r"]
[608.30599, "o", "\u001b[?2004h"]
[608.306007, "o", "> "]
[608.306047, "o", "  if not ok:\r\n\u001b[?2004l\r"]
[608.306067, "o", "\u001b[?2004h"]
[608.306085, "o", "> "]
[608.306277, "o", "   e=out.loc[(r.customer_id,pd.Timestamp(r.as_of)),feat]\r\n\u001b[?2004l\r"]
[608.306297, "o", "\u001b[?2004h> "]
[608.306621, "o", "   print(' example',r.customer_id,r.as_of,'expected',e,'actual',r.features[feat]);break\r\n\u001b[?2004l\r"]
[608.30664, "o", "\u001b[?2004h> "]
