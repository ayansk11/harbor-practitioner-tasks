[2183.799905, "o", "\u001b[?2004h"]
[2183.799939, "o", "> "]
[2183.800194, "o", "    out[\"tickets_30d\"] = tickets_30d\r\n\u001b[?2004l\r"]
[2183.800227, "o", "\u001b[?2004h"]
[2183.800257, "o", "> "]
