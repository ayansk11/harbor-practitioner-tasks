[737.21578, "o", "\u001b[?2004h> "]
[737.216103, "o", "print('legacy intervals',len(intervals),'first',intervals.iloc[0].to_dict(),'last',intervals.iloc[-1].to_dict(),'migration',repr(mig))\r\n\u001b[?2004l\r"]
[737.216139, "o", "\u001b[?2004h> "]
[737.216383, "o", "# Every pre-rename order is assigned to the committed legacy job interval containing its event timestamp.\r\n\u001b[?2004l\r"]
[737.21642, "o", "\u001b[?2004h> "]
[737.216466, "o", "o=T['orders'].copy()\r\n\u001b[?2004l\r"]
[737.216501, "o", "\u001b[?2004h> "]
[737.216633, "o", "loaded=o['_loaded_at'].to_numpy(dtype='datetime64[ns]')\r\n\u001b[?2004l\r"]
[737.216666, "o", "\u001b[?2004h> "]
[737.216857, "o", "event=o['ordered_at'].to_numpy(dtype='datetime64[ns]')\r\n\u001b[?2004l\r"]
[737.216888, "o", "\u001b[?2004h> "]
[737.216974, "o", "rename64=mig.to_datetime64()\r\n\u001b[?2004l\r\u001b[?2004h"]
[737.217002, "o", "> "]
[737.217387, "o", "starts=intervals['lo'].to_numpy(dtype='datetime64[ns]'); ends=intervals['hi'].to_numpy(dtype='datetime64[ns]'); ats=intervals['at'].to_numpy(dtype='datetime64[ns]')\r\n\u001b[?2004l\r"]
[737.217458, "o", "\u001b[?2004h> "]
[737.217498, "o", "pre=event<rename64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[737.217532, "o", "vis=loaded.copy()\r\n\u001b[?2004l\r"]
[737.217564, "o", "\u001b[?2004h> "]
[737.217688, "o", "idx=np.searchsorted(starts,event[pre],side='right')-1\r\n\u001b[?2004l\r"]
[737.21772, "o", "\u001b[?2004h> "]
[737.217859, "o", "ok=(idx>=0)&(event[pre]<ends[np.clip(idx,0,len(ends)-1)])\r\n\u001b[?2004l\r"]
[737.217893, "o", "\u001b[?2004h> "]
[737.217982, "o", "legacy=ats[np.clip(idx,0,len(ats)-1)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[737.218019, "o", "> "]
[737.218154, "o", "vis[pre]=np.where(ok,legacy,np.maximum(loaded[pre],rename64))\r\n\u001b[?2004l\r\u001b[?2004h"]
[737.218194, "o", "> "]
[737.218306, "o", "o['effective_loaded_at']=pd.Series(vis,index=o.index)\r\n\u001b[?2004l\r"]
[737.218349, "o", "\u001b[?2004h> "]
[737.218634, "o", "print('pre-rename',pre.sum(),'unmapped',(~ok).sum(),'effective range',pd.Series(vis).min(),pd.Series(vis).max())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[737.218676, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[737.218708, "o", "\u001b[?2004h> "]
[737.218774, "o", "s=s[:start]+new+s[end:]\r\n\u001b[?2004l\r"]
[737.218805, "o", "\u001b[?2004h> "]
[737.218938, "o", "# Replace other accessor collisions in feature section.\r\n\u001b[?2004l\r"]
[737.219, "o", "\u001b[?2004h> "]
[737.219178, "o", "s=s.replace(\"starts=intervals.start.to_numpy\", \"starts=intervals['lo'].to_numpy\")\r\n\u001b[?2004l\r"]
[737.219218, "o", "\u001b[?2004h> "]
[737.219384, "o", "s=s.replace(\"ends=intervals.end.to_numpy\", \"ends=intervals['hi'].to_numpy\")\r\n\u001b[?2004l\r"]
[737.219418, "o", "\u001b[?2004h> "]
[737.219591, "o", "s=s.replace(\"ats=intervals.at.to_numpy\", \"ats=intervals['at'].to_numpy\")\r\n\u001b[?2004l\r"]
[737.219634, "o", "\u001b[?2004h> "]
[737.219669, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r"]
