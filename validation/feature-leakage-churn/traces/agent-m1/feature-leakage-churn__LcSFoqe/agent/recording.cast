[2183.784927, "o", "                amounts = group[\"amount_cents\"].to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2183.784983, "o", "\u001b[?2004h"]
[2183.785024, "o", "> "]
[2183.785161, "o", "            else:\r\n\u001b[?2004l\r"]
[2183.785201, "o", "\u001b[?2004h"]
[2183.785242, "o", "> "]
[2183.785712, "o", "                amounts = np.empty(len(group), dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2183.785751, "o", "\u001b[?2004h"]
[2183.785791, "o", "> "]
