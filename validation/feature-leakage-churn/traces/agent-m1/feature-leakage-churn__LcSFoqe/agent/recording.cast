[917.555288, "i", "python3 - <<'PY'\nimport json,re,pandas as pd\nc=pd.DataFrame(json.loads(x) for x in open('data/_ops/commits.jsonl')); c['at']=pd.to_datetime(c['at'],utc=True)\ncm={int(t):a for t,o,a in zip(c.txn,c.outcome,c['at']) if o=='commit'}\niv=[]\npat=re.compile(r'^\\S+ legacy_orders run=\\S+ selected orders where ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)$')\nfor s in open('data/_ops/scheduler.log'):\n m=pat.match(s)\n if m and int(m.group(4)) in cm: iv.append((pd.Timestamp(m.group(1)),pd.Timestamp(m.group(2)),cm[int(m.group(4))],int(m.group(3))))\niv=pd.DataFrame(iv,columns=['lo','hi','at','n']).sort_values(['lo','at'])\nprint('intervals',len(iv),'overlapping starts',iv.lo.duplicated().sum(),'rows',iv.n.sum())\nprint(iv.tail(20).to_string(index=False))\nPY\n"]
