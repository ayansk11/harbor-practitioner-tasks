[3480.401546, "i", "python3 - <<'PY'\nfrom churn.extract import load_extract\nimport pandas as pd\nT=load_extract('/app/data'); p=T['scoring_points']; c=T['customers'].set_index('customer_id')\nmerged=p.join(c[['signup_at','plan','postcode_district']],on='customer_id')\nprint('points',len(p),'missing customer',merged.signup_at.isna().sum(),'missing district',merged.postcode_district.isna().sum())\nprint('points at/before signup',int((merged.as_of<=merged.signup_at).sum()),'before signup',int((merged.as_of<merged.signup_at).sum()))\nprint(merged[merged.as_of<merged.signup_at][['customer_id','as_of','signup_at']].head().to_string(index=False))\nPY\n"]
