[24.575629, "i", "nl -ba live/features.py | sed -n '1,260p'\n"]
[24.575787, "o", "nl -ba live/features.py | sed -n '1,260p'\r\n\u001b[?2004l\r"]
[24.577903, "o", "     1\t\"\"\"Feature queries of the live churn scoring service: a read-only copy of the service's `features` module.\r\n     2\t\r\n     3\tThis copy is the contract between the live service and the offline pipeline in `churn/`. It is kept for reference:\r\n     4\t"]
[24.577935, "o", "nothing in this repository imports or runs it, there is no warehouse connection here, and editing it changes nothing.\r\n     5\t\r\n     6\tHow the service uses it. A scoring request names a customer and a moment: the 06:00 batch run (trigger `batch`), or\r\n"]
[24.577977, "o", "     7\tthe support desk when a ticket is opened (trigger `ticket`, at the ticket's `opened_at`). For each request the service\r\n     8\truns every query in QUERIES once, at the moment of the request, against the warehouse tables as they stand at that\r\n     9\tmoment, and takes the first column of the first row as the feature's value; a query that returns no row, or NULL,\r\n    10\tgives a null value. The service then scores the 11 values with the deployed model, if one is attached, and logs them\r\n"]
[24.578007, "o", "    11\twith the request.\r\n    12\t\r\n    13\tParameters of every query:\r\n    14\t    :customer_id     the request's customer\r\n    15\t    :now             the moment of the request (the `as_of` the scoring service records for it)\r\n    16\t    :app_minutes_7d  the product-analytics reading that came with the request, NULL when it came without one\r\n    17\t\r\n    18\tThe warehouse is PostgreSQL. Timestamps are `timestamptz` and sessions run in UTC, so INTERVAL '7 days' is exactly\r\n    19\t7 x 86,400 seconds and EXTRACT(EPOCH FROM <interval>) is a number of seconds. The tables, and when their rows and\r\n"]
[24.578029, "o", "    20\tvalues are committed: docs/WAREHOUSE.md.\r\n    21\t\"\"\"\r\n"]
[24.578071, "o", "    22\t\r\n    23\tQUERIES = {\r\n    24\t    # orders in the 7 days before the request\r\n    25\t    \"orders_7d\": \"\"\"\r\n    26\t        SELECT COUNT(*)\r\n"]
[24.578097, "o", "    27\t        FROM orders\r\n    28\t        WHERE customer_id = :customer_id\r\n    29\t          AND ordered_at >= :now - INTERVAL '7 days'\r\n    30\t          AND ordered_at < :now\r\n    31\t    \"\"\",\r\n    32\t    # orders in the 30 days before the request\r\n"]
[24.578119, "o", "    33\t    \"orders_30d\": \"\"\"\r\n    34\t        SELECT COUNT(*)\r\n    35\t        FROM orders\r\n    36\t        WHERE customer_id = :customer_id\r\n"]
[24.578145, "o", "    37\t          AND ordered_at >= :now - INTERVAL '30 days'\r\n    38\t          AND ordered_at < :now\r\n    39\t    \"\"\",\r\n    40\t    # amount of those orders, in cents (0 when there are none)\r\n    41\t    \"spend_30d_cents\": \"\"\"\r\n"]
[24.578179, "o", "    42\t        SELECT COALESCE(SUM(amount_cents), 0)\r\n    43\t        FROM orders\r\n    44\t        WHERE customer_id = :customer_id\r\n    45\t          AND ordered_at >= :now - INTERVAL '30 days'\r\n    46\t          AND ordered_at < :now\r\n"]
[24.578205, "o", "    47\t    \"\"\",\r\n    48\t    # support tickets opened in the 30 days before the request\r\n    49\t    \"tickets_30d\": \"\"\"\r\n    50\t        SELECT COUNT(*)\r\n    51\t        FROM tickets\r\n    52\t        WHERE customer_id = :customer_id\r\n"]
[24.578227, "o", "    53\t          AND opened_at >= :now - INTERVAL '30 days'\r\n    54\t          AND opened_at < :now\r\n    55\t    \"\"\",\r\n"]
[24.578253, "o", "    56\t    # days since the latest order before the request (NULL when there is none)\r\n    57\t    \"days_since_last_order\": \"\"\"\r\n    58\t        SELECT EXTRACT(EPOCH FROM (:now - MAX(ordered_at))) / 86400.0\r\n    59\t        FROM orders\r\n    60\t        WHERE customer_id = :customer_id\r\n    61\t          AND ordered_at < :now\r\n    62\t    \"\"\",\r\n"]
[24.578275, "o", "    63\t    # days since sign-up\r\n    64\t    \"tenure_days\": \"\"\"\r\n"]
[24.578296, "o", "    65\t        SELECT EXTRACT(EPOCH FROM (:now - signup_at)) / 86400.0\r\n    66\t        FROM customers\r\n    67\t        WHERE customer_id = :customer_id\r\n"]
[24.578323, "o", "    68\t    \"\"\",\r\n    69\t    # account status of the latest snapshot (no row: NULL)\r\n    70\t    \"status\": \"\"\"\r\n    71\t        SELECT status\r\n    72\t        FROM status_snapshots\r\n"]
[24.57835, "o", "    73\t        WHERE customer_id = :customer_id\r\n    74\t        ORDER BY snapshot_date DESC\r\n    75\t        LIMIT 1\r\n    76\t    \"\"\",\r\n    77\t    # subscription plan on the customer record\r\n    78\t    \"plan\": \"\"\"\r\n"]
[24.578371, "o", "    79\t        SELECT plan\r\n    80\t        FROM customers\r\n"]
[24.578393, "o", "    81\t        WHERE customer_id = :customer_id\r\n    82\t    \"\"\",\r\n    83\t    # days since the last login on the customer record (NULL when the record has none)\r\n"]
[24.578415, "o", "    84\t    \"days_since_last_login\": \"\"\"\r\n    85\t        SELECT EXTRACT(EPOCH FROM (:now - last_login_at)) / 86400.0\r\n    86\t        FROM customers\r\n"]
[24.57844, "o", "    87\t        WHERE customer_id = :customer_id\r\n    88\t    \"\"\",\r\n    89\t    # app minutes over the last 7 days: the request's own reading, else the reading of the customer's latest earlier\r\n    90\t    # request that had one (NULL when there is none)\r\n    91\t    \"app_minutes_7d\": \"\"\"\r\n    92\t        SELECT COALESCE(\r\n"]
[24.578462, "o", "    93\t            CAST(:app_minutes_7d AS double precision),\r\n    94\t            (SELECT app_minutes_7d\r\n"]
[24.578489, "o", "    95\t             FROM scoring_points\r\n    96\t             WHERE customer_id = :customer_id\r\n    97\t               AND as_of < :now\r\n    98\t               AND app_minutes_7d IS NOT NULL\r\n"]
[24.57851, "o", "    99\t             ORDER BY as_of DESC\r\n   100\t             LIMIT 1))\r\n   101\t    \"\"\",\r\n   102\t    # smoothed churn rate of the customer's postcode district: (s + 20 p) / (n + 20), where p is the mean churned_30d\r\n"]
[24.578532, "o", "   103\t    # of all label rows (0.05 when there are none), and n and s are the number of label rows of customers in the same\r\n   104\t    # district and the sum of their churned_30d\r\n   105\t    \"te_district\": \"\"\"\r\n   106\t        WITH lab AS (\r\n"]
[24.578557, "o", "   107\t            SELECT l.churned_30d, c.postcode_district\r\n   108\t            FROM labels l\r\n   109\t            JOIN customers c ON c.customer_id = l.customer_id\r\n   110\t        ),\r\n   111\t        own AS (\r\n   112\t            SELECT postcode_district\r\n"]
[24.578577, "o", "   113\t            FROM customers\r\n   114\t            WHERE customer_id = :customer_id\r\n   115\t        )\r\n"]
[24.578598, "o", "   116\t        SELECT (COALESCE(SUM(lab.churned_30d) FILTER (WHERE lab.postcode_district = own.postcode_district), 0)\r\n   117\t                + 20 * COALESCE(AVG(lab.churned_30d), 0.05))\r\n"]
[24.578622, "o", "   118\t               / (COUNT(*) FILTER (WHERE lab.postcode_district = own.postcode_district) + 20)\r\n   119\t        FROM lab CROSS JOIN own\r\n   120\t    \"\"\",\r\n   121\t}\r\n"]
[24.578644, "o", "   122\t\r\n   123\tFEATURES = list(QUERIES)\r\n"]
[24.579014, "o", "\u001b[?2004h"]
[24.579029, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[25.06898, "i", "for f in churn/extract.py churn/windows.py churn/status.py churn/attributes.py churn/impute.py churn/encoding.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[25.069481, "o", "for f in churn/extract.py churn/windows.py churn/status.py churn/attributes.py churn/impute.py churn/encoding.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[25.06953, "o", "===== churn/extract.py =====\r\n"]
[25.070421, "o", "     1\t\"\"\"Load a warehouse extract (the seven CSV files described in docs/WAREHOUSE.md) into pandas frames.\r\n     2\t\r\n     3\tEvery timestamp column is parsed to a UTC timestamp, the load metadata columns included, so each frame carries\r\n     4\teverything its CSV file has.\r\n     5\t\"\"\"\r\n     6\timport os\r\n"]
[25.070464, "o", "     7\timport pandas as pd\r\n     8\t\r\n     9\tTIMESTAMPS = {\r\n    10\t    \"customers\": [\"signup_at\", \"last_login_at\", \"_updated_at\"],\r\n    11\t    \"plan_changes\": [\"changed_at\", \"_loaded_at\"],\r\n    12\t    \"scoring_points\": [\"as_of\"],\r\n    13\t    \"orders\": [\"ordered_at\", \"_loaded_at\"],\r\n"]
[25.070494, "o", "    14\t    \"tickets\": [\"opened_at\", \"_loaded_at\"],\r\n    15\t    \"status_snapshots\": [\"snapshot_date\", \"_loaded_at\"],\r\n    16\t    \"labels\": [\"as_of\", \"_loaded_at\"],\r\n    17\t}\r\n    18\t\r\n    19\t\r\n    20\tdef load_extract(data_dir):\r\n    21\t    tables = {}\r\n    22\t    for name, cols in TIMESTAMPS.items():\r\n    23\t        df = pd.read_csv(os.path.join(data_dir, f\"{name}.csv\"), dtype={\"postcode_district\": \"str\"})\r\n    24\t        for c in cols:\r\n    25\t            df[c] = pd.to_datetime(df[c], utc=True)\r\n    26\t        tables[name] = df\r\n    27\t    tables[\"scoring_points\"][\"app_minutes_7d\"] = tables[\"scoring_points\"][\"app_minutes_7d\"].astype(\"float64\")\r\n    28\t    return tables\r\n"]
[25.070628, "o", "===== churn/windows.py =====\r\n"]
[25.071431, "o", "     1\t\"\"\"Activity features over trailing windows (orders, spend, tickets) and simple time-since features.\r\n     2\t\r\n     3\tPoint in time (INC-2041): a window is [t - W days, t) on the exact event timestamps, so an event stamped at or after\r\n"]
[25.07144, "o", "     4\tthe prediction time is never counted and nothing later in the day leaks in.\r\n     5\t\"\"\"\r\n     6\timport numpy as np\r\n     7\timport pandas as pd\r\n     8"]
[25.071481, "o", "\t\r\n     9\tEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n    10\tSTRIDE = 10 ** 10  # composite key customer_id * STRIDE + epoch seconds (seconds stay below 1e10 until 2286)\r\n    11\t\r\n    12\t\r\n    13\tdef _seconds(ts):\r\n    14\t    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n    15\t\r\n    16\t\r\n    17\tdef _window(points, events, ts_col, days, amount_col=None):\r\n    18\t    \"\"\"Per prediction: number (and amount sum) of the customer's events with t - days <= ts < t.\"\"\"\r\n    19\t    ev_key = events[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(events[ts_col])\r\n"]
[25.071509, "o", "    20\t    order = np.argsort(ev_key, kind=\"stable\")\r\n    21\t    ev_key = ev_key[order]\r\n    22\t    cid = points[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE\r\n    23\t    t = _seconds(points[\"as_of\"])\r\n    24\t    hi = np.searchsorted(ev_key, cid + t, side=\"left\")\r\n"]
[25.071536, "o", "    25\t    lo = np.searchsorted(ev_key, cid + t - days * 86400, side=\"left\")\r\n    26\t    count = hi - lo\r\n    27\t    if amount_col is None:\r\n    28\t        return count, None\r\n    29\t    pref = np.concatenate([[0], np.cumsum(events[amount_col].to_numpy(dtype=\"int64\")[order])])\r\n    30\t    return count, pref[hi] - pref[lo]\r\n    31\t\r\n    32\t\r\n    33\tdef activity_features(points, orders, tickets):\r\n"]
[25.071563, "o", "    34\t    out = points[[\"customer_id\", \"as_of\"]].copy()\r\n    35\t    out[\"orders_7d\"], _ = _window(points, orders, \"ordered_at\", 7)\r\n    36\t    out[\"orders_30d\"], out[\"spend_30d_cents\"] = _window(points, orders, \"ordered_at\", 30, \"amount_cents\")\r\n    37\t    out[\"tickets_30d\"], _ = _window(points, tickets, \"opened_at\", 30)\r\n    38\t\r\n    39\t    # time since the last order strictly before the prediction\r\n    40\t    o = orders.sort_values(\"ordered_at\")[[\"customer_id\", \"ordered_at\"]]\r\n    41\t    left = out[[\"customer_id\", \"as_of\"]].reset_index().sort_values(\"as_of\")\r\n    42\t    last = pd.merge_asof(left, o, left_on=\"as_of\", right_on=\"ordered_at\", by=\"customer_id\",\r\n    43\t                         allow_exact_matches=False).set_index(\"index\").sort_index()[\"ordered_at\"]\r\n    44\t    out[\"days_since_last_order\"] = (out[\"as_of\"] - last).dt.total_seconds() / 86400\r\n"]
[25.071591, "o", "    45\t    return out\r\n    46\t\r\n    47\t\r\n    48\tdef tenure_days(points, customers):\r\n    49\t    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n    50\t    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400\r\n"]
[25.071717, "o", "===== churn/status.py =====\r\n"]
[25.072513, "o", "     1\t\"\"\"Account status from the billing system's status snapshots, point in time (INC-2041).\r\n     2\t\r\n     3\tA snapshot dated D records the status at the end of day D, so a prediction at t may only use snapshots dated before\r\n     4\tdate(t).\r\n     5"]
[25.07256, "o", "\t\"\"\"\r\n     6\timport pandas as pd\r\n     7\t\r\n     8\t\r\n     9\tdef latest_status(points, snapshots):\r\n    10\t    \"\"\"Status of the customer's latest snapshot dated before the prediction's UTC date (null if none).\"\"\"\r\n    11\t    left = points[[\"customer_id\"]].assign(day=points[\"as_of\"].dt.floor(\"D\")).reset_index()\r\n    12\t    left = left.sort_values(\"day\", kind=\"mergesort\")\r\n"]
[25.07259, "o", "    13\t    snaps = snapshots.sort_values(\"snapshot_date\", kind=\"mergesort\")[[\"customer_id\", \"snapshot_date\", \"status\"]]\r\n    14\t    snaps = snaps.assign(snapshot_date=snaps[\"snapshot_date\"].astype(left[\"day\"].dtype))\r\n    15\t    m = pd.merge_asof(left, snaps, left_on=\"day\", right_on=\"snapshot_date\", by=\"customer_id\",\r\n    16\t                      allow_exact_matches=False)\r\n    17\t    return m.set_index(\"index\")[\"status\"].reindex(points.index)\r\n"]
[25.072693, "o", "===== churn/attributes.py =====\r\n"]
[25.073699, "o", "     1\t\"\"\"Customer attributes from the customer record (new in v3): the subscription plan and the days since the last login.\r\n     2\t\r\n     3\tPoint in time: a last login at or after the prediction time is ignored (the feature is null then), so the feature\r\n     4\tnever looks ahead of t.\r\n     5\t\"\"\"\r\n     6\t\r\n     7\t\r\n     8\tdef plan(points, customers):\r\n     9\t    \"\"\"The customer's subscription plan.\"\"\"\r\n"]
[25.07374, "o", "    10\t    return points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"plan\"])\r\n    11\t\r\n    12\t\r\n    13\tdef days_since_last_login(points, customers):\r\n    14\t    \"\"\"t minus the customer's last login, in days; null when the record has no login before t.\"\"\"\r\n    15\t    last = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"last_login_at\"])\r\n"]
[25.073756, "o", "    16\t    days = (points[\"as_of\"] - last).dt.total_seconds() / 86400\r\n    17\t    return days.where(last < points[\"as_of\"])\r\n"]
[25.073861, "o", "===== churn/impute.py =====\r\n"]
[25.074808, "o", "     1\t\"\"\"Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).\r\n     2\t\r\n     3\tPoint in time (INC-2041): a missing reading takes the customer's most recent earlier reading, never a later one; with\r\n"]
[25.074819, "o", "     4\tno earlier reading it stays null.\r\n     5\t\"\"\"\r\n     6\t\r\n     7\t\r\n     8"]
[25.074855, "o", "\tdef fill_app_minutes(points):\r\n     9\t    \"\"\"Fill missing app_minutes_7d from the same customer's last earlier reading.\"\"\"\r\n    10\t    pts = points.sort_values([\"customer_id\", \"as_of\"], kind=\"mergesort\")\r\n    11\t    filled = pts.groupby(\"customer_id\")[\"app_minutes_7d\"].ffill()\r\n    12\t    return filled.reindex(points.index)\r\n"]
[25.074968, "o", "===== churn/encoding.py =====\r\n"]
[25.07585, "o", "     1\t\"\"\"Target encoding of high-cardinality categoricals, point in time (INC-2041).\r\n     2\t\r\n     3\tA label row records whether the customer churned in the 30 days after its own prediction, so its outcome is final only\r\n     4\tonce that window has closed (as_of + 30 days). A prediction at t uses only labels whose window closed before t, for the\r\n     5\tdistrict counts and for the prior alike; its own label and every later one are never seen.\r\n     6\t\"\"\"\r\n     7\timport numpy as np\r\n     8\timport pandas as pd\r\n     9\t\r\n    10\tPRIOR_WEIGHT = 20\r\n    11\tDEFAULT_PRIOR = 0.05\r\n"]
[25.075888, "o", "    12\tLABEL_WINDOW_DAYS = 30\r\n    13\tEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n    14\tSTRIDE = 10 ** 10\r\n    15\t\r\n    16\t\r\n    17\tdef _seconds(ts):\r\n    18\t    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n    19\t\r\n    20\t\r\n    21\tdef district_encoding(points, labels, customers, m=PRIOR_WEIGHT):\r\n    22\t    \"\"\"Smoothed churn rate of the customer's postcode district, from labels whose window closed before t.\"\"\"\r\n    23\t    district = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n    24\t    lab_d = labels[\"customer_id\"].map(district)\r\n    25\t    pt_d = points[\"customer_id\"].map(district)\r\n    26\t    codes, _ = pd.factorize(pd.concat([lab_d, pt_d], ignore_index=True))\r\n    27\t    lab_code, pt_code = codes[:len(labels)].astype(\"int64\"), codes[len(labels):].astype(\"int64\")\r\n    28\t    closed = _seconds(labels[\"as_of\"]) + LABEL_WINDOW_DAYS * 86400\r\n    29\t    y = labels[\"churned_30d\"].to_numpy(dtype=\"int64\")\r\n    30\t    t = _seconds(points[\"as_of\"])\r\n    31\t\r\n    32\t    o"]
[25.075911, "o", "rder = np.argsort(closed, kind=\"stable\")\r\n    33\t    ycum = np.concatenate([[0], np.cumsum(y[order])])\r\n    34\t    N = np.searchsorted(closed[order], t, side=\"left\")\r\n    35\t    S = ycum[N]\r\n    36\t    prior = np.full(len(t), DEFAULT_PRIOR)\r\n    37\t    has = N > 0\r\n    38\t    prior[has] = S[has] / N[has]\r\n    39\t\r\n    40\t    key = lab_code * STRIDE + closed\r\n    41"]
[25.075931, "o", "\t    o2 = np.argsort(key, kind=\"stable\")\r\n    42\t    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])\r\n    43\t    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side=\"left\")\r\n    44\t    lo = np.searchsorted(key[o2], pt_code * STRIDE, side=\"left\")\r\n    45\t    n, s = hi - lo, ycum2[hi] - ycum2[lo]\r\n    46\t    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\r\n"]
[25.076101, "o", "\u001b[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[26.071498, "i", "nl -ba docs/WAREHOUSE.md | sed -n '1,180p'\n"]
[26.071806, "o", "nl -ba docs/WAREHOUSE.md | sed -n '1,180p'\r\n\u001b[?2004l\r"]
[26.074807, "o", "     1\t# Warehouse tables (churn scoring)\r\n     2\t\r\n     3\tWritten 2025-02-14 by the data platform for the warehouse and its nightly loaders as they were on that date, and not\r\n     4\tupdated since. The scheduler's own records of every job run and transaction, later changes included, are in each\r\n     5\textract's `_ops/` folder (below).\r\n     6\t\r\n     7\tThe seven tables below are the warehouse tables that the live scoring service (`live/features.py`) and the churn\r\n"]
[26.074866, "o", "     8\tpipeline (`churn/`) read. This page says what each table holds and which system writes it. Every brand of the company\r\n     9\truns the same warehouse and jobs; each brand's job runs, failures and changes are its own.\r\n    10\t\r\n    11\t## Reading the warehouse\r\n    12\t- A query that starts at a moment t sees exactly the rows and values committed before t: a row committed at or after\r\n    13\t  t is not seen, and a value overwritten at or after t is seen as it was before the overwrite, whatever the date of\r\n    14\t  the event the row records.\r\n    15\t- A query reads each table by the name it has when the query starts.\r\n    16\t- `_loaded_at` is the commit time of the load that wrote the row; in `orders`, `_load_job` names that load.\r\n    17\t"]
[26.074909, "o", "- An extract is a copy of every table as the warehouse held it at one moment: the rows and values committed before\r\n    18\t  that moment, with the `_ops/` records written before it.\r\n    19\t- Timestamps are UTC, written as ISO 8601 with a `Z` suffix and whole seconds (`2025-02-04T06:00:00Z`);\r\n    20\t  `snapshot_date` is a UTC date (`YYYY-MM-DD`); amounts are integer cents. Columns whose names start with `_` are\r\n    21\t  written by the loaders, not by the source systems.\r\n    22\t\r\n    23\t## The scheduler's records (`_ops/`)\r\n    24\t- `_ops/scheduler.log` has one UTC event per line, `<time> <job> run=<run> <event>`: each task's start\r\n    25\t  (`state=running`) and end (`state=success` or `state=failed`), and between them the lines the task writes, such as\r\n"]
[26.074949, "o", "    26\t  the rows it selected or copied, the transaction it sent (`sent txn <n> to commit`), the statements it ran and the\r\n    27\t  checks it made.\r\n    28\t- `_ops/commits.jsonl` has one JSON object per transaction a scheduled job sent: `txn`, `at`, `outcome` (`commit` or\r\n    29\t  `rollback`), `table` and `rows` (the table the transaction writes rows into and how many; null for schema\r\n    30\t  statements).\r\n    31\t- `_ops/commits.jsonl` is the commit log of the scheduled jobs: a transaction is committed if and only if its outcome\r\n    32\t"]
[26.07501, "o", "  is `commit`, and it is committed at its `at`; the scheduler's task states describe tasks, not commits.\r\n    33\t- Change data capture (`tickets`), the sign-up service and the scoring service write without the scheduler and are not\r\n    34\t  in `_ops/`.\r\n    35\t\r\n"]
[26.075047, "o", "    36\t## Tables\r\n    37\t\r\n    38\t### `customers`\r\n    39\t`customer_id, signup_at, plan, postcode_district, last_login_at, _updated_at`: one row per customer.\r\n    40\t- The sign-up service writes the row at `signup_at`: the plan chosen at sign-up (`basic`, `plus` or `family`), the\r\n    41\t  postcode district, an empty `last_login_at`, and `_updated_at` = `signup_at`. `signup_at` and `postcode_district`\r\n    42\t  never change.\r\n"]
[26.075099, "o", "    43\t- `crm_sync` reads the CRM at its start. For each customer whose plan or last login in the CRM (the latest login to\r\n    44\t  the app or website before the sync's start) differs from the row, it overwrites `plan` and `last_login_at` with the\r\n    45\t  CRM's values and sets `_updated_at` to the sync's commit time.\r\n    46\t- Only plan changes are logged (`plan_changes`); no history of `last_login_at` is kept.\r\n    47\t\r\n    48\t### `plan_changes`\r\n    49\t`customer_id, changed_at, old_plan, new_plan, _loaded_at`: one row per plan change that `crm_sync` has applied. Each\r\n    50\tsync writes one row for every change made in the CRM before its start that no earlier sync applied; `changed_at` is\r\n    51\t"]
[26.07514, "o", "when the customer made the change in the CRM, `_loaded_at` the commit of the sync that applied it. A customer's rows\r\n    52\tare every change applied since sign-up, so the earliest row's `old_plan` is the plan chosen at sign-up. When one sync\r\n    53\tapplies several changes of a customer, the plan after that sync is the `new_plan` of the latest of them (by\r\n    54\t`changed_at`), the CRM's plan at the sync's start.\r\n    55\t\r\n    56\t### `scoring_points`\r\n    57\t`customer_id, as_of, trigger, app_minutes_7d`: one row per scoring request, written by the scoring service at the\r\n"]
[26.075168, "o", "    58\tmoment of the request, `as_of`. `trigger` is `batch` (the 06:00 run, which scores a customer every 14 days, on the\r\n    59\tcustomer's billing weekday) or `ticket` (a request the support desk sends when a ticket is opened, for some of the\r\n    60\ttickets, at the ticket's `opened_at`). `app_minutes_7d` is the product-analytics reading that came with the request (the customer's minutes in\r\n    61\tthe app over the last 7 days), empty when the request came without one (analytics export outages, devices offline).\r\n    62"]
[26.075211, "o", "\t`(customer_id, as_of)` is unique.\r\n    63\t\r\n    64\t### `orders`\r\n    65\t`order_id, customer_id, ordered_at, kind, amount_cents, _load_job, _loaded_at`. `kind` is `box` (the weekly box,\r\n"]
[26.075249, "o", "    66\tcharged by billing at 05:30 on the customer's billing weekday; `ordered_at` is the charge) or `addon` (an extra item,\r\n    67\tordered at any time). Each order exists in the order system, which the loaders read, from its `ordered_at` on.\r\n    68\tThe nightly `legacy_orders` job writes the table: each run selects orders from the order system and sends them to\r\n    69\t`orders` in one transaction.\r\n    70\t\r\n    71\t### `tickets`\r\n    72\t`ticket_id, customer_id, opened_at, topic, _loaded_at`: support tickets, written by change data capture from the\r\n    73\tsupport desk 1 to 30 seconds after `opened_at`.\r\n    74\t\r\n    75\t### `status_snapshots`\r\n"]
[26.075278, "o", "    76\t`customer_id, snapshot_date, status, _loaded_at`: the billing system's account status (`active`, `paused`,\r\n    77\t`payment_failed` or `cancelled`) at the end of day `snapshot_date`. Billing records a row for a customer on the\r\n    78\tsign-up day, on every day the status changed, and on the first day of every month, up to the cancellation (a\r\n    79\t`cancelled` row is the customer's last); there is at most one row per customer and date.\r\n"]
[26.075299, "o", "    80\t`billing_export` writes each day's partition (all the rows dated D) in one transaction.\r\n    81\t\r\n    82\t### `labels`\r\n    83\t`customer_id, as_of, churned_30d, _loaded_at`: the outcome of a prediction (`customer_id` and `as_of` as in\r\n"]
[26.075327, "o", "    84\t`scoring_points`): `churned_30d` is 1 if the customer cancelled in `(as_of, as_of + 30 days]`, else 0. The outcome\r\n    85\tbecomes known at the cancellation, or when the 30 days have passed without one.\r\n    86\t`label_job` writes, in one transaction per run, a row for each prediction whose outcome became known before the run\r\n    87\tstarted and that has no row yet.\r\n"]
[26.075803, "o", "\u001b[?2004h"]
[26.07583, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[30.96222, "i", "nl -ba live/features.py\n"]
[30.962455, "o", "nl -ba live/features.py\r\n"]
[30.962495, "o", "\u001b[?2004l\r"]
[30.964313, "o", "     1\t\"\"\"Feature queries of the live churn scoring service: a read-only copy of the service's `features` module.\r\n     2\t\r\n     3\tThis copy is the contract between the live service and the offline pipeline in `churn/`. It is kept for reference:\r\n     4\tnothing in this repository imports or runs it, there is no warehouse connection here, and editing it changes nothing.\r\n     5\t"]
[30.964384, "o", "\r\n     6\tHow the service uses it. A scoring request names a customer and a moment: the 06:00 batch run (trigger `batch`), or\r\n     7\tthe support desk when a ticket is opened (trigger `ticket`, at the ticket's `opened_at`). For each request the service\r\n     8\truns every query in QUERIES once, at the moment of the request, against the warehouse tables as they stand at that\r\n     9\tmoment, and takes the first column of the first row as the feature's value; a query that returns no row, or NULL,\r\n    10\tgives a null value. The service then scores the 11 values with the deployed model, if one is attached, and logs them\r\n    11\twith the request.\r\n    12\t\r\n    13\tParameters of every query:\r\n    14\t    :customer_id     the request's customer\r\n    15\t    :now             the moment of the request (the `as_of` the scoring service records for it)\r\n    16\t    :app_minutes_7d  the product-analytics reading that came with the request, NULL when it came without one\r\n    17\t\r\n"]
[30.964412, "o", "    18\tThe warehouse is PostgreSQL. Timestamps are `timestamptz` and sessions run in UTC, so INTERVAL '7 days' is exactly\r\n    19\t7 x 86,400 seconds and EXTRACT(EPOCH FROM <interval>) is a number of seconds. The tables, and when their rows and\r\n    20\tvalues are committed: docs/WAREHOUSE.md.\r\n    21\t\"\"\"\r\n    22\t\r\n    23\tQUERIES = {\r\n"]
[30.964437, "o", "    24\t    # orders in the 7 days before the request\r\n    25\t    \"orders_7d\": \"\"\"\r\n    26\t        SELECT COUNT(*)\r\n    27\t        FROM orders\r\n    28\t        WHERE customer_id = :customer_id\r\n    29\t          AND ordered_at >= :now - INTERVAL '7 days'\r\n"]
[30.964463, "o", "    30\t          AND ordered_at < :now\r\n    31\t    \"\"\",\r\n    32\t    # orders in the 30 days before the request\r\n    33\t    \"orders_30d\": \"\"\"\r\n    34\t        SELECT COUNT(*)\r\n    35\t        FROM orders\r\n    36\t        WHERE customer_id = :customer_id\r\n"]
[30.964488, "o", "    37\t          AND ordered_at >= :now - INTERVAL '30 days'\r\n    38\t          AND ordered_at < :now\r\n    39\t    \"\"\",\r\n    40\t    # amount of those orders, in cents (0 when there are none)\r\n    41\t    \"spend_30d_cents\": \"\"\"\r\n    42\t        SELECT COALESCE(SUM(amount_cents), 0)"]
[30.964521, "o", "\r\n    43\t        FROM orders\r\n    44\t        WHERE customer_id = :customer_id\r\n"]
[30.964537, "o", "    45\t          AND ordered_at >= :now - INTERVAL '30 days'\r\n    46\t          AND ordered_at < :now\r\n    47\t    \"\"\",\r\n    48\t    # support tickets opened in the 30 days before the request"]
[30.964581, "o", "\r\n    49\t    \"tickets_30d\": \"\"\"\r\n    50\t        SELECT COUNT(*)\r\n    51\t        FROM tickets\r\n    52\t        WHERE customer_id = :customer_id\r\n    53\t          AND opened_at >= :now - INTERVAL '30 days'\r\n    54\t          AND opened_at < :now\r\n"]
[30.964607, "o", "    55\t    \"\"\",\r\n    56\t    # days since the latest order before the request (NULL when there is none)\r\n    57\t    \"days_since_last_order\": \"\"\"\r\n    58\t        SELECT EXTRACT(EPOCH FROM (:now - MAX(ordered_at))) / 86400.0\r\n    59\t        FROM orders\r\n    60\t        WHERE customer_id = :customer_id\r\n    61\t          AND ordered_at < :now\r\n    62\t    \"\"\",\r\n"]
[30.964633, "o", "    63\t    # days since sign-up\r\n    64\t    \"tenure_days\": \"\"\"\r\n    65\t        SELECT EXTRACT(EPOCH FROM (:now - signup_at)) / 86400.0\r\n    66\t        FROM customers\r\n    67\t        WHERE customer_id = :customer_id\r\n"]
[30.964653, "o", "    68\t    \"\"\",\r\n    69\t    # account status of the latest snapshot (no row: NULL)\r\n    70\t    \"status\": \"\"\"\r\n    71\t        SELECT status\r\n"]
[30.964679, "o", "    72\t        FROM status_snapshots\r\n    73\t        WHERE customer_id = :customer_id\r\n    74\t        ORDER BY snapshot_date DESC\r\n    75\t        LIMIT 1\r\n    76\t    \"\"\",\r\n    77\t    # subscription plan on the customer record\r\n"]
[30.964703, "o", "    78\t    \"plan\": \"\"\"\r\n    79\t        SELECT plan\r\n    80\t        FROM customers\r\n    81\t        WHERE customer_id = :customer_id\r\n    82\t    \"\"\",\r\n    83"]
[30.964728, "o", "\t    # days since the last login on the customer record (NULL when the record has none)\r\n    84\t    \"days_since_last_login\": \"\"\"\r\n    85\t        SELECT EXTRACT(EPOCH FROM (:now - last_login_at)) / 86400.0\r\n    86\t        FROM customers\r\n    87\t        WHERE customer_id = :customer_id\r\n"]
[30.964753, "o", "    88\t    \"\"\",\r\n    89\t    # app minutes over the last 7 days: the request's own reading, else the reading of the customer's latest earlier\r\n    90\t    # request that had one (NULL when there is none)\r\n    91\t    \"app_minutes_7d\": \"\"\"\r\n    92\t        SELECT COALESCE(\r\n    93\t            CAST(:app_minutes_7d AS double precision),\r\n"]
[30.964777, "o", "    94\t            (SELECT app_minutes_7d\r\n    95\t             FROM scoring_points\r\n    96\t             WHERE customer_id = :customer_id\r\n    97\t               AND as_of < :now\r\n    98\t               AND app_minutes_7d IS NOT NULL\r\n"]
[30.964802, "o", "    99\t             ORDER BY as_of DESC\r\n   100\t             LIMIT 1))\r\n   101\t    \"\"\",\r\n   102\t    # smoothed churn rate of the customer's postcode district: (s + 20 p) / (n + 20), where p is the mean churned_30d\r\n   103\t    # of all label rows (0.05 when there are none), and n and s are the number of label rows of customers in the same\r\n   104\t    # district and the sum of their churned_30d\r\n"]
[30.964825, "o", "   105\t    \"te_district\": \"\"\"\r\n   106\t        WITH lab AS (\r\n   107\t            SELECT l.churned_30d, c.postcode_district\r\n   108\t            FROM labels l\r\n   109\t            JOIN customers c ON c.customer_id = l.customer_id\r\n   110\t        ),\r\n"]
[30.964849, "o", "   111\t        own AS (\r\n   112\t            SELECT postcode_district\r\n   113\t            FROM customers\r\n   114\t            WHERE customer_id = :customer_id\r\n   115\t        )\r\n   116\t        SELECT (COALESCE(SUM(lab.churned_30d) FILTER (WHERE lab.postcode_district = own.postcode_district), 0)\r\n"]
[30.964874, "o", "   117\t                + 20 * COALESCE(AVG(lab.churned_30d), 0.05))\r\n   118\t               / (COUNT(*) FILTER (WHERE lab.postcode_district = own.postcode_district) + 20)\r\n   119\t        FROM lab CROSS JOIN own\r\n   120\t    \"\"\",\r\n   121\t}\r\n   122\t\r\n"]
[30.964897, "o", "   123\tFEATURES = list(QUERIES)\r\n"]
