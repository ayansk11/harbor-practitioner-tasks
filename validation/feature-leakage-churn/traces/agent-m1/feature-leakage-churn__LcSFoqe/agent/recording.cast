[477.663929, "i", "python3 - <<'PY'\nimport pandas as pd, re, json\no=pd.read_csv('data/orders.csv'); o['ordered_at']=pd.to_datetime(o.ordered_at,utc=True)\no['day']=o.ordered_at.dt.floor('D')\nfor day in pd.date_range('2025-04-04','2025-04-09',freq='D',tz='UTC'):\n z=o[o.day==day]\n print('current',day.date(),len(z),z.groupby(['_load_job','kind']).size().to_dict())\nprint('legacy scheduler selected counts:')\nfor s in open('data/_ops/scheduler.log'):\n m=re.search(r'^\\S+ legacy_orders run=\\S+ selected orders where ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+)',s)\n if m: print(m.group(1)[:10],m.group(2)[:10],m.group(3),m.group(4))\nPY\n"]
