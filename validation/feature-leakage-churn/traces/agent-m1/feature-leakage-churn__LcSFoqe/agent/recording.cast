[737.210411, "i", "python3 - <<'PY'\np='/tmp/proto.py'\ns=open(p).read()\nstart=s.index(\"# Parse committed selected-order intervals from scheduler.\")\nend=s.index(\"# Features\\n\")\nnew=r'''# Parse committed selected-order intervals from scheduler.\ncommits=pd.DataFrame(json.loads(s) for s in open(f'{D}/_ops/commits.jsonl'))\ncommits['at']=pd.to_datetime(commits['at'],utc=True)\ncmap={int(r.txn):r['at'] for r in commits.itertuples() if r.outcome=='commit'}\nintervals=[]\npat=re.compile(r'^(\\S+) legacy_orders run=(\\S+) selected orders where ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)$')\nfor line in open(f'{D}/_ops/scheduler.log'):\n m=pat.match(line)\n if m:\n  at=cmap.get(int(m.group(6)))\n  if at is not None:\n   intervals.append((pd.Timestamp(m.group(3)),pd.Timestamp(m.group(4)),at))\nintervals=pd.DataFrame(intervals,columns=['lo','hi','at']).sort_values(['lo','hi','at'])\n# Associate schema statements with the next transaction ID, then find the orders swap.\npending=[]; rename_txn=None\nfor line in"]
[737.210533, "i", " open(f'{D}/_ops/scheduler.log'):\n m=re.search(r'schema_migrations run=\\S+ statement: (.*)$',line)\n if m: pending.append(m.group(1)); continue\n m=re.search(r'schema_migrations run=\\S+ sent txn (\\d+) to commit',line)\n if m:\n  stmts=pending; pending=[]\n  if 'ALTER TABLE orders RENAME TO orders_legacy' in stmts and 'ALTER TABLE orders_new RENAME TO orders' in stmts:\n   rename_txn=int(m.group(1)); break\nif rename_txn is None: raise RuntimeError('orders rename not found')\nr=commits[commits.txn==rename_txn].iloc[0]\nif r.outcome!='commit': raise RuntimeError('orders rename did not commit')\nmig=r['at']\nprint('legacy intervals',len(intervals),'first',intervals.iloc[0].to_dict(),'last',intervals.iloc[-1].to_dict(),'migration',repr(mig))\n# Every pre-rename order is assigned to the committed legacy job interval containing its event timestamp.\no=T['orders'].copy()\nloaded=o['_loaded_at'].to_numpy(dtype='datetime64[ns]')\nevent=o['ordered_at'].to_numpy(dtype='datetime64[ns]')\nrename64=mig.to_datetime64()\nstarts=intervals['lo"]
[737.210563, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[737.210587, "i", "'].to_numpy(dtype='datetime64[ns]'); ends=intervals['hi'].to_numpy(dtype='datetime64[ns]'); ats=intervals['at'].to_numpy(dtype='datetime64[ns]')\npre=event<rename64\nvis=loaded.copy()\nidx=np.searchsorted(starts,event[pre],side='right')-1\nok=(idx>=0)&(event[pre]<ends[np.clip(idx,0,len(ends)-1)])\nlegacy=ats[np.clip(idx,0,len(ats)-1)]\nvis[pre]=np.where(ok,legacy,np.maximum(loaded[pre],rename64))\no['effective_loaded_at']=pd.Series(vis,index=o.index)\nprint('pre-rename',pre.sum(),'unmapped',(~ok).sum(),'effective range',pd.Series(vis).min(),pd.Series(vis).max())\n\n'''\ns=s[:start]+new+s[end:]\n# Replace other accessor collisions in feature section.\ns=s.replace(\"starts=intervals.start.to_numpy\", \"starts=intervals['lo'].to_numpy\")\ns=s.replace(\"ends=intervals.end.to_numpy\", \"ends=intervals['hi'].to_numpy\")\ns=s.replace(\"ats=intervals.at.to_numpy\", \"ats=intervals['at'].to_numpy\")\nopen(p,'w').write(s)\nPY\npython3 /tmp/proto.py\n"]
