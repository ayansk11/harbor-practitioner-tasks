[2943.22503, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom churn.extract import load_extract\nfrom churn.encoding import _seconds\nfrom churn.visibility import order_commit_times\nT=load_extract('/app/data')\ncustomers=T['customers'].set_index('customer_id'); labels=T['labels'].copy(); labels['district']=labels.customer_id.map(customers.postcode_district)\ncid,t=100012,pd.Timestamp('2026-01-12T06:00:00Z'); d=customers.loc[cid,'postcode_district']\nz=labels[labels._loaded_at<t]\nprint('district',d,'global n',len(z),'sum',z.churned_30d.sum(),'mean',z.churned_30d.mean())\nzz=z[z.district==d]\nprint('own n',len(zz),'sum',zz.churned_30d.sum(),'mean',zz.churned_30d.mean())\nprint('expected',(zz.churned_30d.sum()+20*z.churned_30d.mean())/(len(zz)+20))\nprint(zz[['customer_id','as_of','churned_30d','_loaded_at']].sort_values('_loaded_at').to_string(index=False))\n\nfor cid,t in [(100220,pd.Timestamp('2026-01-06T06:00:00Z')),(101169,pd.Timestamp('2026-01-07T06:00:00Z'))]:\n z=T['status_snapshots'][(T['status_snapshots'].customer_id==ci"]
