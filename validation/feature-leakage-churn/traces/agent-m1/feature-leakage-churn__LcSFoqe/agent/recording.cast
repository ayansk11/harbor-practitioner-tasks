[2183.789751, "o", "> "]
[2183.79012, "o", "            hi = np.searchsorted(times, t, side=\"left\")\r\n\u001b[?2004l\r"]
[2183.79016, "o", "\u001b[?2004h"]
[2183.790195, "o", "> "]
[2183.790303, "o", "            if hi:\r\n\u001b[?2004l\r"]
[2183.79034, "o", "\u001b[?2004h"]
[2183.79038, "o", "> "]
