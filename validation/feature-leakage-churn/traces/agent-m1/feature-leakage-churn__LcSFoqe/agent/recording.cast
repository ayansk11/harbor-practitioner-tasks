[111.951923, "o", "\r\n2025-05-31T19:19:36Z orders_hourly run=2025-05-31T19:00:00Z state=success\r\n2025-05-31T20:21:42Z orders_hourly run=2025-05-31T20:00:00Z state=running\r\n2025-05-31T20:22:14Z orders_hourly run=2025-05-31T20:00:00Z selected orders where ordered_at >= 2025-05-31T19:00:00Z and ordered_at < 2025-05-31T20:00:00Z: 3 rows; sent txn 7002939 to commit into orders_new\r\n2025-05-31T20:22:24Z orders_hourly run=2025-05-31T20:00:00Z state=success\r\n2025-05-31T21:20:55Z orders_hourly run=2025-05-31T21:00:00Z state=running\r\n2025-05-31T21:21:21Z orders_hourly run=2025-05-31T21:00:00Z selected orders where ordered_at >= 2025-05-31T20:00:00Z and ordered_at < 2025-05-31T21:00:00Z: 2 rows; sent txn 7002940 to commit into orders_new\r\n2025-05-31T21:21:37Z orders_hourly run=2025-05-31T21:00:00Z state=success\r\n2025-05-31T22:22:12Z orders_hourly run=2025-05-31T22:00:00Z state=running\r\n2025-05-31T22:22:27Z orders_hourly run=2025-05-31T22:00:00Z selected orders where ordered_at >= 2025-05-31T21:00:00Z and ordered_at < 2025-05-31T22:00:00Z: "]
