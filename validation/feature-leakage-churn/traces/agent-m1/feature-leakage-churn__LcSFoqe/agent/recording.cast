[2183.7804, "o", "> "]
[2183.780798, "o", "    last_order_days = np.full(n, np.nan, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2183.780837, "o", "\u001b[?2004h"]
[2183.780873, "o", "> "]
