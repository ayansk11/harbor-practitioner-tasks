[2184.243252, "o", "    for i, (cid, at) in enumerate(zip(points[\"customer_id\"].to_numpy(), points[\"as_of\"].to_numpy())):\r\n\u001b[?2004l\r"]
[2184.243295, "o", "\u001b[?2004h"]
[2184.243338, "o", "> "]
[2184.243517, "o", "        cid = int(cid)\r\n\u001b[?2004l\r"]
[2184.243555, "o", "\u001b[?2004h"]
[2184.243588, "o", "> "]
[2184.243878, "o", "        if cid not in current.index:\r\n\u001b[?2004l\r"]
[2184.243915, "o", "\u001b[?2004h"]
[2184.243948, "o", "> "]
[2184.244112, "o", "            continue\r\n\u001b[?2004l\r"]
[2184.244151, "o", "\u001b[?2004h"]
[2184.244178, "o", "> "]
[2184.244403, "o", "        if cid not in histories:\r\n\u001b[?2004l\r"]
[2184.24444, "o", "\u001b[?2004h"]
[2184.244473, "o", "> "]
[2184.244713, "o", "            value = current.loc[cid]\r\n\u001b[?2004l\r"]
[2184.244752, "o", "\u001b[?2004h"]
[2184.244785, "o", "> "]
[2184.245156, "o", "            result[i] = None if pd.isna(value) else value\r\n\u001b[?2004l\r"]
[2184.245193, "o", "\u001b[?2004h"]
[2184.245226, "o", "> "]
[2184.245374, "o", "            continue\r\n\u001b[?2004l\r"]
[2184.245411, "o", "\u001b[?2004h"]
[2184.245443, "o", "> "]
[2184.245742, "o", "        base, commits, values = histories[cid]\r\n\u001b[?2004l\r"]
[2184.245779, "o", "\u001b[?2004h"]
[2184.245811, "o", "> "]
[2184.246329, "o", "        pos = np.searchsorted(commits, _seconds(pd.Series([at]))[0], side=\"left\")\r\n\u001b[?2004l\r"]
[2184.246372, "o", "\u001b[?2004h"]
[2184.246406, "o", "> "]
[2184.246774, "o", "        result[i] = base if pos == 0 else values[pos - 1]\r\n\u001b[?2004l\r"]
[2184.246813, "o", "\u001b[?2004h"]
[2184.246845, "o", "> "]
[2184.247272, "o", "    return pd.Series(result, index=points.index, dtype=\"object\")\r\n\u001b[?2004l\r"]
[2184.247323, "o", "\u001b[?2004h"]
[2184.24737, "o", "> \r\n\u001b[?2004l\r"]
[2184.247409, "o", "\u001b[?2004h"]
[2184.247421, "o", "> "]
[2184.247461, "o", "\r\n\u001b[?2004l\r"]
[2184.247507, "o", "\u001b[?2004h> "]
[2184.247841, "o", "def days_since_last_login(points, customers):\r\n\u001b[?2004l\r"]
[2184.247884, "o", "\u001b[?2004h"]
[2184.247918, "o", "> "]
[2184.248589, "o", "    \"\"\"Kept only as null in the offline table: login history is not in the warehouse extract.\"\"\"\r\n\u001b[?2004l\r"]
[2184.248642, "o", "\u001b[?2004h"]
[2184.248688, "o", "> "]
[2184.249148, "o", "    return pd.Series(np.nan, index=points.index, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2184.249186, "o", "\u001b[?2004h"]
[2184.249222, "o", "> "]
[2184.249253, "o", "PY\r\n\u001b[?2004l\r"]
[2184.251723, "o", "\u001b[?2004h"]
[2184.251774, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# \r\n\u001b[?2004l\r"]
[2184.251829, "o", "\u001b[?2004h"]
[2184.251868, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2184.252123, "o", "cat > churn/encoding.py <<'PY'\r\n\u001b[?2004l\r"]
[2184.252177, "o", "\u001b[?2004h"]
[2184.25226, "o", "> "]
[2184.252612, "o", "\"\"\"Point-in-time smoothed district target encoding.\"\"\"\r\n\u001b[?2004l\r"]
[2184.25266, "o", "\u001b[?2004h"]
[2184.252695, "o", "> "]
[2184.252842, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[2184.252881, "o", "\u001b[?2004h"]
[2184.252914, "o", "> "]
[2184.253087, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[2184.253122, "o", "\u001b[?2004h"]
[2184.253154, "o", "> \r\n\u001b[?2004l\r"]
[2184.253204, "o", "\u001b[?2004h"]
[2184.253236, "o", "> "]
[2184.253564, "o", "EPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n\u001b[?2004l\r"]
[2184.253606, "o", "\u001b[?2004h"]
[2184.253645, "o", "> "]
[2184.253788, "o", "STRIDE = 10 ** 10\r\n\u001b[?2004l\r"]
[2184.253829, "o", "\u001b[?2004h"]
[2184.253868, "o", "> "]
[2184.253908, "o", "\r\n\u001b[?2004l\r"]
[2184.253944, "o", "\u001b[?2004h> "]
[2184.253989, "o", "\r\n\u001b[?2004l\r"]
[2184.254023, "o", "\u001b[?2004h"]
[2184.254059, "o", "> "]
[2184.25422, "o", "def _seconds(values):\r\n\u001b[?2004l\r"]
[2184.254261, "o", "\u001b[?2004h"]
[2184.254297, "o", "> "]
[2184.254853, "o", "    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2184.254907, "o", "\u001b[?2004h> "]
[2184.254942, "o", "\r\n\u001b[?2004l\r"]
[2184.255008, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2184.255066, "o", "\u001b[?2004h"]
[2184.255102, "o", "> "]
[2184.255488, "o", "def district_encoding(points, labels, customers, m=20):\r\n\u001b[?2004l\r"]
[2184.255535, "o", "\u001b[?2004h"]
[2184.255584, "o", "> "]
[2184.256163, "o", "    \"\"\"Reproduce the live SQL using label rows committed before each prediction.\"\"\"\r\n\u001b[?2004l\r"]
[2184.256208, "o", "\u001b[?2004h"]
[2184.256242, "o", "> "]
[2184.25674, "o", "    districts = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[2184.256781, "o", "\u001b[?2004h"]
[2184.256815, "o", "> "]
[2184.257009, "o", "    lab = labels.copy()\r\n\u001b[?2004l\r"]
[2184.257049, "o", "\u001b[?2004h"]
[2184.257082, "o", "> "]
[2184.257535, "o", "    lab[\"postcode_district\"] = lab[\"customer_id\"].map(districts)\r\n\u001b[?2004l\r"]
[2184.25758, "o", "\u001b[?2004h"]
[2184.257615, "o", "> "]
[2184.25801, "o", "    lab = lab[lab[\"postcode_district\"].notna()].copy()\r\n\u001b[?2004l\r"]
[2184.258048, "o", "\u001b[?2004h"]
[2184.258081, "o", "> "]
[2184.258115, "o", "\r\n\u001b[?2004l\r"]
[2184.25815, "o", "\u001b[?2004h"]
[2184.258183, "o", "> "]
[2184.258954, "o", "    all_districts = pd.concat([lab[\"postcode_district\"], points[\"customer_id\"].map(districts)], ignore_index=True)\r\n\u001b[?2004l\r"]
[2184.259007, "o", "\u001b[?2004h"]
[2184.259041, "o", "> "]
[2184.259495, "o", "    codes = all_districts.astype(\"category\").cat.codes.to_numpy()\r\n\u001b[?2004l\r"]
[2184.259536, "o", "\u001b[?2004h"]
[2184.259573, "o", "> "]
[2184.25981, "o", "    lab_codes = codes[:len(lab)]\r\n\u001b[?2004l\r"]
[2184.259858, "o", "\u001b[?2004h"]
[2184.259898, "o", "> "]
[2184.260161, "o", "    point_codes = codes[len(lab):]\r\n\u001b[?2004l\r"]
[2184.260207, "o", "\u001b[?2004h"]
[2184.260239, "o", "> \r\n\u001b[?2004l\r"]
[2184.260292, "o", "\u001b[?2004h"]
[2184.260324, "o", "> "]
[2184.260903, "o", "    y = pd.to_numeric(lab[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2184.260951, "o", "\u001b[?2004h"]
[2184.261015, "o", "> "]
[2184.261207, "o", "    y_sum = np.nancumsum(y)\r\n\u001b[?2004l\r"]
[2184.261252, "o", "\u001b[?2004h"]
[2184.261287, "o", "> "]
[2184.261557, "o", "    y_seen = np.cumsum(~np.isnan(y))\r\n\u001b[?2004l\r"]
[2184.261597, "o", "\u001b[?2004h"]
[2184.261632, "o", "> "]
[2184.262023, "o", "    n_rows = np.arange(1, len(lab) + 1, dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2184.262063, "o", "\u001b[?2004h"]
[2184.262097, "o", "> "]
[2184.262131, "o", "\r\n\u001b[?2004l\r"]
[2184.262167, "o", "\u001b[?2004h"]
[2184.2622, "o", "> "]
[2184.262478, "o", "    loaded = _seconds(lab[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[2184.262519, "o", "\u001b[?2004h"]
[2184.262552, "o", "> "]
[2184.262897, "o", "    order = np.argsort(loaded, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2184.262937, "o", "\u001b[?2004h"]
[2184.262996, "o", "> "]
[2184.263226, "o", "    global_load = loaded[order]\r\n\u001b[?2004l\r"]
[2184.263265, "o", "\u001b[?2004h"]
[2184.263299, "o", "> "]
[2184.26352, "o", "    global_sum = y_sum[order]\r\n\u001b[?2004l\r"]
[2184.26356, "o", "\u001b[?2004h"]
[2184.263593, "o", "> "]
[2184.263826, "o", "    global_seen = y_seen[order]\r\n\u001b[?2004l\r"]
[2184.263867, "o", "\u001b[?2004h"]
[2184.263902, "o", "> "]
[2184.264152, "o", "    global_rows = n_rows[order]\r\n\u001b[?2004l\r"]
[2184.264193, "o", "\u001b[?2004h"]
[2184.264228, "o", "> "]
[2184.264262, "o", "\r\n\u001b[?2004l\r"]
[2184.264295, "o", "\u001b[?2004h"]
[2184.26433, "o", "> "]
[2184.264694, "o", "    key = lab_codes.astype(\"int64\") * STRIDE + loaded\r\n\u001b[?2004l\r"]
[2184.264735, "o", "\u001b[?2004h"]
[2184.26477, "o", "> "]
[2184.265115, "o", "    order2 = np.argsort(key, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2184.265157, "o", "\u001b[?2004h"]
[2184.265193, "o", "> "]
[2184.265423, "o", "    district_key = key[order2]\r\n\u001b[?2004l\r"]
[2184.265461, "o", "\u001b[?2004h"]
[2184.265494, "o", "> "]
[2184.265734, "o", "    district_sum = y_sum[order2]\r\n\u001b[?2004l\r"]
[2184.26578, "o", "\u001b[?2004h"]
[2184.265815, "o", "> "]
[2184.266081, "o", "    district_rows = n_rows[order2]\r\n\u001b[?2004l\r"]
[2184.266121, "o", "\u001b[?2004h"]
[2184.266154, "o", "> "]
[2184.266188, "o", "\r\n\u001b[?2004l\r"]
[2184.266224, "o", "\u001b[?2004h"]
[2184.266269, "o", "> "]
[2184.266496, "o", "    t = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[2184.266534, "o", "\u001b[?2004h"]
[2184.266568, "o", "> "]
[2184.266943, "o", "    gp = np.searchsorted(global_load, t, side=\"left\")\r\n\u001b[?2004l\r"]
[2184.266994, "o", "\u001b[?2004h"]
[2184.267034, "o", "> "]
[2184.267518, "o", "    global_n = np.where(gp > 0, global_rows[np.maximum(gp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2184.267557, "o", "\u001b[?2004h"]
[2184.267592, "o", "> "]
[2184.268101, "o", "    global_s = np.where(gp > 0, global_sum[np.maximum(gp - 1, 0)], 0.0)\r\n\u001b[?2004l\r"]
[2184.268142, "o", "\u001b[?2004h"]
[2184.268174, "o", "> "]
[2184.268694, "o", "    global_seen_n = np.where(gp > 0, global_seen[np.maximum(gp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2184.268736, "o", "\u001b[?2004h"]
[2184.268768, "o", "> "]
[2184.269177, "o", "    prior = np.full(len(points), 0.05, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2184.269231, "o", "\u001b[?2004h"]
[2184.269267, "o", "> "]
[2184.269515, "o", "    has_prior = global_seen_n > 0\r\n\u001b[?2004l\r"]
[2184.269554, "o", "\u001b[?2004h"]
[2184.269588, "o", "> "]
[2184.270094, "o", "    prior[has_prior] = global_s[has_prior] / global_seen_n[has_prior]\r\n\u001b[?2004l\r"]
[2184.270135, "o", "\u001b[?2004h"]
[2184.270169, "o", "> "]
[2184.270203, "o", "\r\n\u001b[?2004l\r"]
[2184.270236, "o", "\u001b[?2004h"]
[2184.27027, "o", "> "]
[2184.270656, "o", "    point_key = point_codes.astype(\"int64\") * STRIDE + t\r\n\u001b[?2004l\r"]
[2184.270695, "o", "\u001b[?2004h"]
[2184.27073, "o", "> "]
[2184.271182, "o", "    hp = np.searchsorted(district_key, point_key, side=\"left\")\r\n\u001b[?2004l\r"]
[2184.271223, "o", "\u001b[?2004h"]
[2184.271257, "o", "> "]
[2184.271711, "o", "    n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2184.271753, "o", "\u001b[?2004h"]
[2184.271788, "o", "> "]
[2184.272259, "o", "    s = np.where(hp > 0, district_sum[np.maximum(hp - 1, 0)], 0.0)\r\n\u001b[?2004l\r"]
[2184.2723, "o", "\u001b[?2004h"]
[2184.272334, "o", "> "]
[2184.272957, "o", "    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\r\n"]
[2184.273005, "o", "\u001b[?2004l\r"]
[2184.273045, "o", "\u001b[?2004h"]
[2184.273078, "o", "> "]
[2184.273117, "o", "PY\r\n\u001b[?2004l\r"]
[2184.276311, "o", "\u001b[?2004h"]
[2184.27635, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2184.276366, "o", "\r\n\u001b[?2004l\r"]
[2184.276408, "o", "\u001b[?2004h"]
[2184.276423, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2184.276583, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[2184.276644, "o", "\u001b[?2004h"]
[2184.276676, "o", "> "]
[2184.276875, "o", "p='churn/build_features.py'\r\n\u001b[?2004l\r"]
[2184.276917, "o", "\u001b[?2004h"]
[2184.276957, "o", "> "]
[2184.277085, "o", "s=open(p).read()\r\n\u001b[?2004l\r"]
[2184.277134, "o", "\u001b[?2004h"]
[2184.277168, "o", "> "]
[2184.277427, "o", "s=s.replace('import os\\n', 'import os\\n')\r\n\u001b[?2004l\r"]
[2184.277464, "o", "\u001b[?2004h"]
[2184.277498, "o", "> "]
[2184.278461, "o", "s=s.replace('from churn.status import latest_status\\n', 'from churn.status import latest_status\\nfrom churn.visibility import order_commit_times\\n')\r\n\u001b[?2004l\r"]
[2184.278498, "o", "\u001b[?2004h"]
[2184.278527, "o", "> "]
[2184.281186, "o", "s=s.replace('FEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\\n                   \"tenure_days\", \"status\", \"plan\", \"days_since_last_login\", \"app_minutes_7d\", \"te_district\"]', 'FEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\\n                   \"tenure_days\", \"status\", \"plan\", \"app_minutes_7d\", \"te_district\"]')\r\n\u001b[?2004l\r"]
[2184.281235, "o", "\u001b[?2004h"]
[2184.281268, "o", "> "]
[2184.283018, "o", "s=s.replace('    t = load_extract(data_dir)\\n', '    t = load_extract(data_dir)\\n    t[\"orders\"][\"_effective_loaded_at\"] = order_commit_times(\\n        t[\"orders\"], os.path.join(data_dir, \"_ops\")\\n    )\\n')\r\n\u001b[?2004l\r"]
[2184.28312, "o", "\u001b[?2004h"]
[2184.283155, "o", "> "]
[2184.284113, "o", "s=s.replace('    feats[\"plan\"] = plan(points, t[\"customers\"])\\n', '    feats[\"plan\"] = plan(points, t[\"plan_changes\"], t[\"customers\"])\\n')\r\n\u001b[?2004l\r"]
[2184.284163, "o", "\u001b[?2004h"]
[2184.284197, "o", "> "]
[2184.28435, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r"]
[2184.28439, "o", "\u001b[?2004h"]
[2184.284421, "o", "> "]
[2184.284457, "o", "PY\r\n\u001b[?2004l\r"]
[2184.295045, "o", "\u001b[?2004h"]
[2184.295064, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2184.295314, "o", "python3 -m py_compile churn/*.py\r\n\u001b[?2004l\r"]
[2184.343392, "o", "\u001b[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2184.343682, "o", "sed -n '1,120p' churn/build_features.py\r\n\u001b[?2004l\r"]
[2184.346194, "o", "\"\"\"Build the churn feature table: python -m churn.build_features --data <dir> --out <file.parquet>\"\"\"\r\nimport argparse\r\nimport os\r\n"]
[2184.346234, "o", "\r\nfrom churn.attributes import days_since_last_login, plan\r\nfrom churn.encoding import district_encoding\r\nfrom churn.extract import load_extract\r\n"]
[2184.34627, "o", "from churn.impute import fill_app_minutes\r\nfrom churn.status import latest_status\r\nfrom churn.visibility import order_commit_times\r\nfrom churn.windows import activity_features, tenure_days\r\n\r\nFEATURE_COLUMNS = [\"orders_7d\", \"orders_30d\", \"spend_30d_cents\", \"tickets_30d\", \"days_since_last_order\",\r\n                   \"tenure_days\", \"status\", \"plan\", \"app_minutes_7d\", \"te_district\"]\r\n\r\n\r\ndef build(data_dir):\r\n"]
[2184.346302, "o", "    t = load_extract(data_dir)\r\n    t[\"orders\"][\"_effective_loaded_at\"] = order_commit_times(\r\n        t[\"orders\"], os.path.join(data_dir, \"_ops\")\r\n    )\r\n    points = t[\"scoring_points\"].reset_index(drop=True)\r\n    feats = activity_features(points, t[\"orders\"], t[\"tickets\"])\r\n    feats[\"tenure_days\"] = tenure_days(points, t[\"customers\"])\r\n"]
[2184.346333, "o", "    feats[\"status\"] = latest_status(points, t[\"status_snapshots\"])\r\n    feats[\"plan\"] = plan(points, t[\"plan_changes\"], t[\"customers\"])\r\n    feats[\"days_since_last_login\"] = days_since_last_login(points, t[\"customers\"])\r\n    feats[\"app_minutes_7d\"] = fill_app_minutes(points)\r\n    feats[\"te_district\"] = district_encoding(points, t[\"labels\"], t[\"customers\"])\r\n    return feats[[\"customer_id\", \"as_of\"] + FEATURE_COLUMNS]\r\n\r\n\r\n"]
[2184.346369, "o", "def main():\r\n    ap = argparse.ArgumentParser(description=__doc__)\r\n    ap.add_argument(\"--data\", required=True, help=\"folder with the extract CSVs\")\r\n    ap.add_argument(\"--out\", required=True, help=\"output parquet file\")\r\n    a = ap.parse_args()\r\n    feats = build(a.data)\r\n    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)\r\n    feats.to_parquet(a.out, index=False)\r\n    print(f\"wrote {len(feats)} rows x {feats.shape[1]} columns to {a.out}\")\r\n\r\n\r\n"]
[2184.346401, "o", "if __name__ == \"__main__\":\r\n    main()\r\n"]
