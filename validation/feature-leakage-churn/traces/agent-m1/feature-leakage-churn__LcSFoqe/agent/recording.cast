[2837.6812, "o", "> "]
[2837.6814, "o", "        ok=an.isna() & bn.isna()\r\n\u001b[?2004l\r"]
[2837.681431, "o", "\u001b[?2004h"]
[2837.681461, "o", "> "]
[2837.682024, "o", "        ok |= an.notna() & bn.notna() & ((an-bn).abs() <= 1e-6 + 1e-9*bn.abs())\r\n\u001b[?2004l\r"]
[2837.682068, "o", "\u001b[?2004h"]
[2837.682103, "o", "> "]
