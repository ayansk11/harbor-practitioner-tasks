[2491.525492, "o", "\u001b[?2004h"]
[2491.525534, "o", "> "]
[2491.525549, "o", "\r\n\u001b[?2004l\r"]
[2491.525614, "o", "\u001b[?2004h"]
[2491.525637, "o", "> "]
[2491.525862, "o", "_SELECT_RE = re.compile(\r\n\u001b[?2004l\r"]
[2491.525917, "o", "\u001b[?2004h> "]
[2491.526485, "o", "    r\"^\\S+ legacy_orders run=\\S+ selected orders where ordered_at >= (\\S+) \"\r\n\u001b[?2004l\r"]
[2491.526539, "o", "\u001b[?2004h"]
[2491.526581, "o", "> "]
[2491.527189, "o", "    r\"and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)$\"\r\n\u001b[?2004l\r"]
[2491.527237, "o", "\u001b[?2004h> "]
[2491.527308, "o", ")\r\n\u001b[?2004l\r"]
[2491.527354, "o", "\u001b[?2004h"]
[2491.527393, "o", "> "]
[2491.527586, "o", "_STATEMENT_RE = re.compile(\r\n\u001b[?2004l\r"]
[2491.527637, "o", "\u001b[?2004h> "]
[2491.528221, "o", "    r\"statement:\\s*ALTER TABLE\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+RENAME TO\\s+\"\r\n\u001b[?2004l\r"]
[2491.528274, "o", "\u001b[?2004h"]
[2491.528313, "o", "> "]
[2491.528577, "o", "    r\"([A-Za-z_][A-Za-z0-9_]*)\\s*$\"\r\n\u001b[?2004l\r"]
[2491.52863, "o", "\u001b[?2004h"]
[2491.52867, "o", "> )\r\n"]
[2491.528725, "o", "\u001b[?2004l\r"]
[2491.528764, "o", "\u001b[?2004h> "]
[2491.529326, "o", "_TXN_RE = re.compile(r\"schema_migrations run=\\S+ sent txn (\\d+) to commit\")\r\n\u001b[?2004l\r"]
[2491.529381, "o", "\u001b[?2004h> \r\n"]
[2491.529419, "o", "\u001b[?2004l\r"]
[2491.529458, "o", "\u001b[?2004h"]
[2491.529497, "o", "> \r\n\u001b[?2004l\r"]
[2491.529535, "o", "\u001b[?2004h"]
[2491.529588, "o", "> "]
[2491.529857, "o", "def _committed_transactions(ops_dir):\r\n\u001b[?2004l\r"]
[2491.529902, "o", "\u001b[?2004h"]
[2491.529983, "o", "> "]
[2491.530343, "o", "    path = os.path.join(ops_dir, \"commits.jsonl\")\r\n\u001b[?2004l\r"]
[2491.530396, "o", "\u001b[?2004h"]
[2491.530439, "o", "> "]
[2491.53058, "o", "    committed = {}\r\n\u001b[?2004l\r"]
[2491.530623, "o", "\u001b[?2004h"]
[2491.530662, "o", "> "]
[2491.531035, "o", "    with open(path, encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r"]
[2491.531078, "o", "\u001b[?2004h"]
[2491.531116, "o", "> "]
[2491.531312, "o", "        for line in fh:\r\n\u001b[?2004l\r"]
[2491.531353, "o", "\u001b[?2004h"]
[2491.531391, "o", "> "]
[2491.531666, "o", "            row = json.loads(line)\r\n\u001b[?2004l\r"]
[2491.531717, "o", "\u001b[?2004h> "]
[2491.53226, "o", "            if row.get(\"outcome\") == \"commit\" and row.get(\"at\"):\r\n\u001b[?2004l\r"]
[2491.532315, "o", "\u001b[?2004h"]
[2491.532352, "o", "> "]
[2491.532981, "o", "                committed[int(row[\"txn\"])] = pd.to_datetime(row[\"at\"], utc=True)\r\n\u001b[?2004l\r"]
[2491.533054, "o", "\u001b[?2004h> "]
[2491.533231, "o", "    return committed\r\n\u001b[?2004l\r"]
[2491.533282, "o", "\u001b[?2004h> \r\n"]
[2491.53332, "o", "\u001b[?2004l\r"]
[2491.533375, "o", "\u001b[?2004h"]
[2491.533395, "o", "> \r\n\u001b[?2004l\r"]
[2491.53344, "o", "\u001b[?2004h> "]
[2491.53381, "o", "def _orders_rename_commit(ops_dir, committed):\r\n\u001b[?2004l\r"]
[2491.533861, "o", "\u001b[?2004h> "]
[2491.534534, "o", "    \"\"\"Find a committed schema transaction which renamed another table to `orders`.\"\"\"\r\n\u001b[?2004l\r"]
[2491.534595, "o", "\u001b[?2004h"]
[2491.534643, "o", "> "]
[2491.53475, "o", "    statements = []\r\n\u001b[?2004l\r"]
[2491.534787, "o", "\u001b[?2004h"]
[2491.534812, "o", "> "]
[2491.534981, "o", "    candidates = []\r\n\u001b[?2004l\r"]
[2491.535014, "o", "\u001b[?2004h"]
[2491.535051, "o", "> "]
[2491.535764, "o", "    with open(os.path.join(ops_dir, \"scheduler.log\"), encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r"]
[2491.535803, "o", "\u001b[?2004h"]
[2491.535825, "o", "> "]
[2491.536024, "o", "        for line in fh:\r\n\u001b[?2004l\r"]
[2491.536063, "o", "\u001b[?2004h"]
[2491.536098, "o", "> "]
[2491.536507, "o", "            match = _STATEMENT_RE.search(line)\r\n\u001b[?2004l\r"]
[2491.53655, "o", "\u001b[?2004h"]
[2491.536588, "o", "> "]
[2491.536762, "o", "            if match:\r\n\u001b[?2004l\r"]
[2491.536807, "o", "\u001b[?2004h"]
[2491.536841, "o", "> "]
[2491.537463, "o", "                statements.append((match.group(1), match.group(2)))\r\n\u001b[?2004l\r"]
[2491.537498, "o", "\u001b[?2004h"]
[2491.53754, "o", "> "]
[2491.537755, "o", "                continue\r\n\u001b[?2004l\r"]
[2491.537794, "o", "\u001b[?2004h"]
[2491.537828, "o", "> "]
[2491.53819, "o", "            match = _TXN_RE.search(line)\r\n\u001b[?2004l\r"]
[2491.538229, "o", "\u001b[?2004h"]
[2491.538263, "o", "> "]
[2491.538431, "o", "            if match:\r\n\u001b[?2004l\r"]
[2491.538463, "o", "\u001b[?2004h"]
[2491.538519, "o", "> "]
[2491.538834, "o", "                txn = int(match.group(1))\r\n\u001b[?2004l\r"]
[2491.538913, "o", "\u001b[?2004h> "]
[2491.53955, "o", "                if any(new_name == \"orders\" for _old_name, new_name in statements):\r\n\u001b[?2004l\r"]
[2491.53962, "o", "\u001b[?2004h> "]
[2491.540124, "o", "                    candidates.append((txn, tuple(statements)))\r\n\u001b[?2004l\r"]
[2491.540171, "o", "\u001b[?2004h"]
[2491.540267, "o", "> "]
[2491.540477, "o", "                statements = []\r\n\u001b[?2004l\r"]
[2491.540532, "o", "\u001b[?2004h> "]
[2491.540927, "o", "    for txn, _statements in reversed(candidates):\r\n\u001b[?2004l\r"]
[2491.540989, "o", "\u001b[?2004h> "]
[2491.541257, "o", "        at = committed.get(txn)\r\n\u001b[?2004l\r"]
[2491.541314, "o", "\u001b[?2004h"]
[2491.541358, "o", "> "]
[2491.54155, "o", "        if at is not None:\r\n\u001b[?2004l\r"]
[2491.541599, "o", "\u001b[?2004h"]
[2491.541643, "o", "> "]
[2491.541803, "o", "            return at\r\n\u001b[?2004l\r"]
[2491.541868, "o", "\u001b[?2004h> "]
[2491.542024, "o", "    return None\r\n\u001b[?2004l\r"]
[2491.542076, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2491.542138, "o", "\u001b[?2004h> "]
[2491.542176, "o", "\r\n\u001b[?2004l\r"]
[2491.542215, "o", "\u001b[?2004h"]
[2491.542261, "o", "> "]
[2491.542658, "o", "def _legacy_intervals(ops_dir, committed, rename_at):\r\n\u001b[?2004l\r"]
[2491.542712, "o", "\u001b[?2004h> "]
[2491.543334, "o", "    \"\"\"Committed event intervals loaded into the old table named `orders`.\"\"\"\r\n\u001b[?2004l\r"]
[2491.543383, "o", "\u001b[?2004h> "]
[2491.543562, "o", "    intervals = []\r\n\u001b[?2004l\r"]
[2491.543616, "o", "\u001b[?2004h> "]
[2491.544249, "o", "    with open(os.path.join(ops_dir, \"scheduler.log\"), encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r"]
[2491.544321, "o", "\u001b[?2004h> "]
[2491.544513, "o", "        for line in fh:\r\n\u001b[?2004l\r"]
[2491.544563, "o", "\u001b[?2004h> "]
[2491.545009, "o", "            match = _SELECT_RE.match(line.rstrip(\"\\n\"))\r\n\u001b[?2004l\r"]
[2491.545071, "o", "\u001b[?2004h"]
[2491.545123, "o", "> "]
[2491.545314, "o", "            if not match:\r\n\u001b[?2004l\r"]
[2491.545367, "o", "\u001b[?2004h> "]
[2491.545577, "o", "                continue\r\n\u001b[?2004l\r"]
[2491.54563, "o", "\u001b[?2004h"]
[2491.545673, "o", "> "]
[2491.546137, "o", "            start, end, selected, txn, table = match.groups()\r\n\u001b[?2004l\r"]
[2491.54619, "o", "\u001b[?2004h> "]
[2491.546618, "o", "            if table != \"orders\" or int(selected) == 0:\r\n\u001b[?2004l\r"]
[2491.546673, "o", "\u001b[?2004h"]
[2491.546715, "o", "> "]
[2491.546898, "o", "                continue\r\n\u001b[?2004l\r"]
[2491.546934, "o", "\u001b[?2004h"]
[2491.547028, "o", "> "]
[2491.547312, "o", "            at = committed.get(int(txn))\r\n\u001b[?2004l\r"]
[2491.54736, "o", "\u001b[?2004h> "]
[2491.547764, "o", "            if at is not None and at < rename_at:\r\n\u001b[?2004l\r"]
[2491.547819, "o", "\u001b[?2004h"]
[2491.547863, "o", "> "]
[2491.548582, "o", "                intervals.append((pd.Timestamp(start).value, pd.Timestamp(end).value, at.value))\r\n\u001b[?2004l\r"]
[2491.548634, "o", "\u001b[?2004h"]
[2491.548672, "o", "> "]
[2491.548837, "o", "    if not intervals:\r\n\u001b[?2004l\r"]
[2491.548889, "o", "\u001b[?2004h> "]
[2491.549266, "o", "        return np.empty((0, 3), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.549301, "o", "\u001b[?2004h"]
[2491.549341, "o", "> "]
[2491.549851, "o", "    result = pd.DataFrame(intervals, columns=[\"start\", \"end\", \"at\"])\r\n\u001b[?2004l\r"]
[2491.549922, "o", "\u001b[?2004h> "]
[2491.5506, "o", "    # A failed transaction was retried.  The first committed selection of an event interval\r\n\u001b[?2004l\r"]
[2491.550656, "o", "\u001b[?2004h> "]
[2491.551157, "o", "    # is the moment those rows became visible in the old table.\r\n\u001b[?2004l\r"]
[2491.551208, "o", "\u001b[?2004h"]
[2491.551247, "o", "> "]
[2491.551729, "o", "    result = result.sort_values([\"start\", \"at\"], kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2491.551764, "o", "\u001b[?2004h"]
[2491.551799, "o", "> "]
[2491.552249, "o", "    result = result.drop_duplicates(\"start\", keep=\"first\")\r\n\u001b[?2004l\r"]
[2491.55229, "o", "\u001b[?2004h"]
[2491.552328, "o", "> "]
[2491.552813, "o", "    return result[[\"start\", \"end\", \"at\"]].to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.552852, "o", "\u001b[?2004h"]
[2491.552887, "o", "> "]
[2491.552922, "o", "\r\n\u001b[?2004l\r"]
[2491.552952, "o", "\u001b[?2004h"]
[2491.552992, "o", "> \r\n\u001b[?2004l\r"]
[2491.553025, "o", "\u001b[?2004h"]
[2491.55304, "o", "> "]
[2491.553367, "o", "def order_commit_times(orders, ops_dir):\r\n\u001b[?2004l\r"]
[2491.553404, "o", "\u001b[?2004h"]
[2491.553438, "o", "> "]
[2491.554008, "o", "    \"\"\"Effective commit time of each row of the final `orders` table.\"\"\"\r\n\u001b[?2004l\r"]
[2491.554078, "o", "\u001b[?2004h> "]
[2491.554672, "o", "    rename_at = _orders_rename_commit(ops_dir, _committed_transactions(ops_dir))\r\n\u001b[?2004l\r"]
[2491.554725, "o", "\u001b[?2004h"]
[2491.554775, "o", "> "]
[2491.554913, "o", "    if rename_at is None:\r\n\u001b[?2004l\r"]
[2491.554951, "o", "\u001b[?2004h"]
[2491.555006, "o", "> "]
[2491.555291, "o", "        return orders[\"_loaded_at\"].copy()\r\n\u001b[?2004l\r"]
[2491.555324, "o", "\u001b[?2004h"]
[2491.555369, "o", "> \r\n\u001b[?2004l\r"]
[2491.555407, "o", "\u001b[?2004h"]
[2491.555444, "o", "> "]
[2491.555933, "o", "    loaded = orders[\"_loaded_at\"].astype(\"int64\").to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.556012, "o", "\u001b[?2004h> "]
[2491.556554, "o", "    ordered = orders[\"ordered_at\"].astype(\"int64\").to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.556586, "o", "\u001b[?2004h"]
[2491.556623, "o", "> "]
[2491.55686, "o", "    rename = int(rename_at.value)\r\n\u001b[?2004l\r"]
[2491.556897, "o", "\u001b[?2004h"]
[2491.556937, "o", "> "]
[2491.557572, "o", "    intervals = _legacy_intervals(ops_dir, _committed_transactions(ops_dir), rename_at)\r\n\u001b[?2004l\r"]
[2491.557608, "o", "\u001b[?2004h"]
[2491.557643, "o", "> \r\n\u001b[?2004l\r"]
[2491.557686, "o", "\u001b[?2004h"]
[2491.55772, "o", "> "]
[2491.557912, "o", "    visible = loaded.copy()\r\n\u001b[?2004l\r"]
[2491.557949, "o", "\u001b[?2004h"]
[2491.558, "o", "> "]
[2491.558222, "o", "    pre_rename = ordered < rename\r\n\u001b[?2004l\r"]
[2491.558261, "o", "\u001b[?2004h"]
[2491.558302, "o", "> "]
[2491.558658, "o", "    if not pre_rename.any() or len(intervals) == 0:\r\n\u001b[?2004l\r"]
[2491.558694, "o", "\u001b[?2004h"]
[2491.558733, "o", "> "]
[2491.559223, "o", "        visible[pre_rename] = np.maximum(loaded[pre_rename], rename)\r\n\u001b[?2004l\r"]
[2491.559262, "o", "\u001b[?2004h"]
[2491.559299, "o", "> "]
[2491.559882, "o", "        return pd.Series(pd.to_datetime(visible, utc=True), index=orders.index)\r\n\u001b[?2004l\r"]
[2491.559921, "o", "\u001b[?2004h"]
[2491.559939, "o", "> \r\n\u001b[?2004l\r"]
[2491.560031, "o", "\u001b[?2004h> "]
[2491.560215, "o", "    starts = intervals[:, 0]\r\n\u001b[?2004l\r"]
[2491.56025, "o", "\u001b[?2004h"]
[2491.560287, "o", "> "]
[2491.560472, "o", "    ends = intervals[:, 1]\r\n\u001b[?2004l\r"]
[2491.560505, "o", "\u001b[?2004h"]
[2491.560544, "o", "> "]
[2491.560738, "o", "    commit = intervals[:, 2]\r\n\u001b[?2004l\r"]
[2491.560788, "o", "\u001b[?2004h> "]
[2491.561336, "o", "    pos = np.searchsorted(starts, ordered[pre_rename], side=\"right\") - 1\r\n\u001b[?2004l\r"]
[2491.561386, "o", "\u001b[?2004h"]
[2491.561437, "o", "> "]
[2491.561723, "o", "    clipped = np.clip(pos, 0, len(starts) - 1)\r\n\u001b[?2004l\r"]
[2491.561772, "o", "\u001b[?2004h"]
[2491.561826, "o", "> "]
[2491.56225, "o", "    known = (pos >= 0) & (ordered[pre_rename] < ends[clipped])\r\n\u001b[?2004l\r"]
[2491.5623, "o", "\u001b[?2004h> "]
[2491.562542, "o", "    old_commit = commit[clipped]\r\n\u001b[?2004l\r"]
[2491.562589, "o", "\u001b[?2004h> "]
[2491.563073, "o", "    replacement_commit = np.maximum(loaded[pre_rename], rename)\r\n\u001b[?2004l\r"]
[2491.563129, "o", "\u001b[?2004h> "]
[2491.563667, "o", "    visible[pre_rename] = np.where(known, old_commit, replacement_commit)\r\n\u001b[?2004l\r"]
[2491.563716, "o", "\u001b[?2004h"]
[2491.56376, "o", "> "]
[2491.564291, "o", "    return pd.Series(pd.to_datetime(visible, utc=True), index=orders.index)\r\n\u001b[?2004l\r"]
[2491.56434, "o", "\u001b[?2004h> "]
[2491.564388, "o", "PY\r\n\u001b[?2004l\r"]
[2491.567368, "o", "\u001b[?2004h"]
[2491.567449, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2491.567489, "o", "\r\n\u001b[?2004l\r"]
[2491.56753, "o", "\u001b[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2491.567745, "o", "cat > churn/status.py <<'PY'\r\n\u001b[?2004l\r"]
[2491.567826, "o", "\u001b[?2004h> "]
[2491.568353, "o", "\"\"\"Latest account status visible to the live warehouse query.\"\"\"\r\n\u001b[?2004l\r"]
[2491.568411, "o", "\u001b[?2004h"]
[2491.568427, "o", "> "]
[2491.568582, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[2491.568635, "o", "\u001b[?2004h> "]
[2491.568804, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[2491.568845, "o", "\u001b[?2004h"]
[2491.568861, "o", "> "]
[2491.568928, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2491.569284, "o", "EPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n\u001b[?2004l\r"]
[2491.569326, "o", "\u001b[?2004h"]
[2491.56936, "o", "> "]
[2491.569498, "o", "STRIDE = 10 ** 10\r\n\u001b[?2004l\r"]
[2491.56954, "o", "\u001b[?2004h"]
[2491.569588, "o", "> "]
[2491.569625, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.569659, "o", "> \r\n\u001b[?2004l\r"]
[2491.569706, "o", "\u001b[?2004h"]
[2491.569766, "o", "> "]
[2491.569879, "o", "def _seconds(values):\r\n\u001b[?2004l\r"]
[2491.569926, "o", "\u001b[?2004h"]
[2491.569981, "o", "> "]
[2491.570565, "o", "    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.570609, "o", "\u001b[?2004h"]
[2491.570654, "o", "> "]
[2491.570689, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[2491.570729, "o", "> \r\n\u001b[?2004l\r"]
[2491.570764, "o", "\u001b[?2004h"]
[2491.570803, "o", "> "]
[2491.571079, "o", "def latest_status(points, snapshots):\r\n\u001b[?2004l\r"]
[2491.571131, "o", "\u001b[?2004h"]
[2491.57117, "o", "> "]
[2491.571862, "o", "    \"\"\"Snapshot with the latest date among rows whose load committed before each prediction.\"\"\"\r\n\u001b[?2004l\r"]
[2491.571934, "o", "\u001b[?2004h> "]
[2491.572541, "o", "    event = snapshots[\"snapshot_date\"].astype(\"int64\").to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.572591, "o", "\u001b[?2004h> "]
[2491.572938, "o", "    loaded = _seconds(snapshots[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[2491.572998, "o", "\u001b[?2004h> "]
[2491.573507, "o", "    customer = snapshots[\"customer_id\"].to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.573529, "o", "\u001b[?2004h"]
[2491.573599, "o", "> "]
[2491.573811, "o", "    key = customer * STRIDE + loaded\r\n\u001b[?2004l\r"]
[2491.573871, "o", "\u001b[?2004h"]
[2491.573906, "o", "> "]
[2491.574189, "o", "    order = np.argsort(key, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2491.574227, "o", "\u001b[?2004h"]
[2491.574265, "o", "> "]
[2491.574461, "o", "    customer = customer[order]\r\n\u001b[?2004l\r"]
[2491.574495, "o", "\u001b[?2004h"]
[2491.574533, "o", "> "]
[2491.574694, "o", "    event = event[order]\r\n\u001b[?2004l\r"]
[2491.574726, "o", "\u001b[?2004h"]
[2491.574766, "o", "> "]
[2491.575179, "o", "    status = snapshots[\"status\"].to_numpy(dtype=object)[order]\r\n\u001b[?2004l\r"]
[2491.575218, "o", "\u001b[?2004h"]
[2491.575257, "o", "> \r\n\u001b[?2004l\r"]
[2491.575292, "o", "\u001b[?2004h"]
[2491.575328, "o", "> "]
[2491.575798, "o", "    # Reset the running maximum of snapshot date at every customer boundary.\r\n\u001b[?2004l\r"]
[2491.575839, "o", "\u001b[?2004h> "]
[2491.576217, "o", "    running_max = np.empty(len(event), dtype=event.dtype)\r\n\u001b[?2004l\r"]
[2491.576269, "o", "\u001b[?2004h> "]
[2491.576411, "o", "    previous = None\r\n\u001b[?2004l\r"]
[2491.576458, "o", "\u001b[?2004h> "]
[2491.57662, "o", "    current_max = None\r\n\u001b[?2004l\r"]
[2491.576664, "o", "\u001b[?2004h"]
[2491.576701, "o", "> "]
[2491.577071, "o", "    for i, (cid, value) in enumerate(zip(customer, event)):\r\n\u001b[?2004l\r"]
[2491.577122, "o", "\u001b[?2004h"]
[2491.577157, "o", "> "]
[2491.577314, "o", "        if cid != previous:\r\n\u001b[?2004l\r"]
[2491.577358, "o", "\u001b[?2004h"]
[2491.577389, "o", "> "]
[2491.577588, "o", "            current_max = value\r\n\u001b[?2004l\r"]
[2491.577629, "o", "\u001b[?2004h"]
[2491.577662, "o", "> "]
[2491.577829, "o", "            previous = cid\r\n\u001b[?2004l\r"]
[2491.577869, "o", "\u001b[?2004h"]
[2491.577901, "o", "> "]
[2491.578124, "o", "        elif value > current_max:\r\n\u001b[?2004l\r"]
[2491.578173, "o", "\u001b[?2004h"]
[2491.578208, "o", "> "]
[2491.578391, "o", "            current_max = value\r\n\u001b[?2004l\r"]
[2491.578441, "o", "\u001b[?2004h> "]
[2491.578689, "o", "        running_max[i] = current_max\r\n\u001b[?2004l\r"]
[2491.578739, "o", "\u001b[?2004h> "]
[2491.579152, "o", "    changed = np.r_[True, running_max[1:] != running_max[:-1]]\r\n\u001b[?2004l\r"]
[2491.579201, "o", "\u001b[?2004h> "]
[2491.57985, "o", "    best_status = pd.Series(status, index=snapshots.index).where(changed).ffill().to_numpy(dtype=object)\r\n\u001b[?2004l\r"]
[2491.579901, "o", "\u001b[?2004h"]
[2491.579924, "o", "> \r\n\u001b[?2004l\r"]
[2491.579981, "o", "\u001b[?2004h"]
[2491.580013, "o", "> "]
[2491.580616, "o", "    point_key = points[\"customer_id\"].to_numpy(dtype=\"int64\") * STRIDE + _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[2491.580669, "o", "\u001b[?2004h"]
[2491.580707, "o", "> "]
[2491.581035, "o", "    pos = np.searchsorted(key, point_key, side=\"left\")\r\n\u001b[?2004l\r"]
[2491.581085, "o", "\u001b[?2004h> "]
[2491.581435, "o", "    result = np.full(len(points), None, dtype=object)\r\n\u001b[?2004l\r"]
[2491.581472, "o", "\u001b[?2004h"]
[2491.581503, "o", "> "]
[2491.581639, "o", "    known = pos > 0\r\n\u001b[?2004l\r"]
[2491.581678, "o", "\u001b[?2004h"]
[2491.581719, "o", "> "]
[2491.582018, "o", "    result[known] = best_status[pos[known] - 1]\r\n\u001b[?2004l\r"]
[2491.582057, "o", "\u001b[?2004h"]
[2491.582089, "o", "> "]
[2491.582485, "o", "    return pd.Series(result, index=points.index, dtype=\"object\")\r\n\u001b[?2004l\r"]
[2491.582525, "o", "\u001b[?2004h"]
[2491.582555, "o", "> "]
[2491.582584, "o", "PY\r\n"]
[2491.582628, "o", "\u001b[?2004l\r"]
[2491.585539, "o", "\u001b[?2004h"]
[2491.585589, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2491.585618, "o", "\r\n\u001b[?2004l\r"]
[2491.585647, "o", "\u001b[?2004h"]
[2491.585676, "o", "root@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
[2491.585875, "o", "cat > churn/encoding.py <<'PY'\r\n\u001b[?2004l\r"]
[2491.585936, "o", "\u001b[?2004h"]
[2491.585978, "o", "> "]
[2491.586314, "o", "\"\"\"Point-in-time smoothed district target encoding.\"\"\"\r\n\u001b[?2004l\r"]
[2491.586353, "o", "\u001b[?2004h"]
[2491.586381, "o", "> "]
[2491.586504, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[2491.586543, "o", "\u001b[?2004h"]
[2491.586575, "o", "> "]
[2491.586702, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[2491.586738, "o", "\u001b[?2004h"]
[2491.58677, "o", "> "]
[2491.586801, "o", "\r\n\u001b[?2004l\r"]
[2491.58683, "o", "\u001b[?2004h"]
[2491.58686, "o", "> "]
[2491.587138, "o", "EPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n\u001b[?2004l\r"]
[2491.587178, "o", "\u001b[?2004h"]
[2491.587209, "o", "> "]
[2491.587332, "o", "STRIDE = 10 ** 10\r\n\u001b[?2004l\r"]
[2491.587366, "o", "\u001b[?2004h"]
[2491.587397, "o", "> "]
[2491.587426, "o", "\r\n\u001b[?2004l\r"]
[2491.587457, "o", "\u001b[?2004h"]
[2491.587486, "o", "> \r\n\u001b[?2004l\r"]
[2491.587517, "o", "\u001b[?2004h"]
[2491.587549, "o", "> "]
[2491.587682, "o", "def _seconds(values):\r\n\u001b[?2004l\r"]
[2491.58772, "o", "\u001b[?2004h"]
[2491.587751, "o", "> "]
[2491.588271, "o", "    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.588307, "o", "\u001b[?2004h"]
[2491.588336, "o", "> "]
[2491.588366, "o", "\r\n\u001b[?2004l\r"]
[2491.588395, "o", "\u001b[?2004h"]
[2491.588424, "o", "> \r\n\u001b[?2004l\r"]
[2491.588456, "o", "\u001b[?2004h"]
[2491.588486, "o", "> "]
[2491.588822, "o", "def district_encoding(points, labels, customers, m=20):\r\n\u001b[?2004l\r"]
[2491.588861, "o", "\u001b[?2004h"]
[2491.588891, "o", "> "]
[2491.589419, "o", "    \"\"\"Reproduce the live SQL using label rows committed before each prediction.\"\"\"\r\n\u001b[?2004l\r"]
[2491.589459, "o", "\u001b[?2004h"]
[2491.589491, "o", "> "]
[2491.589936, "o", "    districts = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n\u001b[?2004l\r"]
[2491.589983, "o", "\u001b[?2004h"]
[2491.590023, "o", "> "]
[2491.590174, "o", "    lab = labels.copy()\r\n\u001b[?2004l\r"]
[2491.590217, "o", "\u001b[?2004h"]
[2491.590247, "o", "> "]
[2491.59065, "o", "    lab[\"postcode_district\"] = lab[\"customer_id\"].map(districts)\r\n\u001b[?2004l\r"]
[2491.59069, "o", "\u001b[?2004h"]
[2491.59072, "o", "> "]
[2491.591081, "o", "    lab = lab[lab[\"postcode_district\"].notna()].copy()\r\n\u001b[?2004l\r"]
[2491.591118, "o", "\u001b[?2004h"]
[2491.59115, "o", "> "]
[2491.591179, "o", "\r\n\u001b[?2004l\r"]
[2491.591208, "o", "\u001b[?2004h"]
[2491.59124, "o", "> "]
[2491.591422, "o", "    all_districts = pd.concat(\r\n\u001b[?2004l\r"]
[2491.591464, "o", "\u001b[?2004h"]
[2491.591495, "o", "> "]
[2491.592067, "o", "        [lab[\"postcode_district\"], points[\"customer_id\"].map(districts)], ignore_index=True\r\n\u001b[?2004l\r"]
[2491.59211, "o", "\u001b[?2004h"]
[2491.592141, "o", "> "]
[2491.592185, "o", "    )\r\n\u001b[?2004l\r"]
[2491.59223, "o", "\u001b[?2004h"]
[2491.59226, "o", "> "]
[2491.59274, "o", "    codes = all_districts.astype(\"category\").cat.codes.to_numpy(dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.592786, "o", "\u001b[?2004h"]
[2491.592816, "o", "> "]
[2491.593036, "o", "    lab_codes = codes[:len(lab)]\r\n\u001b[?2004l\r"]
[2491.593079, "o", "\u001b[?2004h"]
[2491.59311, "o", "> "]
[2491.593328, "o", "    point_codes = codes[len(lab):]\r\n\u001b[?2004l\r"]
[2491.593371, "o", "\u001b[?2004h"]
[2491.5934, "o", "> "]
[2491.59343, "o", "\r\n\u001b[?2004l\r"]
[2491.593459, "o", "\u001b[?2004h"]
[2491.593489, "o", "> "]
[2491.59401, "o", "    y = pd.to_numeric(lab[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2491.594058, "o", "\u001b[?2004h"]
[2491.594104, "o", "> "]
[2491.594237, "o", "    valid = ~np.isnan(y)\r\n\u001b[?2004l\r"]
[2491.594275, "o", "\u001b[?2004h"]
[2491.594306, "o", "> "]
[2491.594552, "o", "    y_filled = np.where(valid, y, 0.0)\r\n\u001b[?2004l\r"]
[2491.594594, "o", "\u001b[?2004h"]
[2491.594624, "o", "> "]
[2491.594655, "o", "\r\n\u001b[?2004l\r"]
[2491.594691, "o", "\u001b[?2004h"]
[2491.594719, "o", "> "]
[2491.595149, "o", "    # Global prior: cumulative sum and non-null count by commit time.\r\n\u001b[?2004l\r"]
[2491.59519, "o", "\u001b[?2004h"]
[2491.595229, "o", "> "]
[2491.595484, "o", "    loaded = _seconds(lab[\"_loaded_at\"])\r\n\u001b[?2004l\r"]
[2491.595521, "o", "\u001b[?2004h"]
[2491.595558, "o", "> "]
[2491.595857, "o", "    order = np.argsort(loaded, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2491.595895, "o", "\u001b[?2004h"]
[2491.595924, "o", "> "]
[2491.596138, "o", "    global_load = loaded[order]\r\n\u001b[?2004l\r"]
[2491.596175, "o", "\u001b[?2004h"]
[2491.596205, "o", "> "]
[2491.59648, "o", "    global_sum = np.cumsum(y_filled[order])\r\n\u001b[?2004l\r"]
[2491.596518, "o", "\u001b[?2004h"]
[2491.596547, "o", "> "]
[2491.596913, "o", "    global_count = np.cumsum(valid[order]).astype(\"int64\")\r\n\u001b[?2004l\r"]
[2491.596954, "o", "\u001b[?2004h"]
[2491.596995, "o", "> "]
[2491.597389, "o", "    global_rows = np.arange(1, len(lab) + 1, dtype=\"int64\")[order]\r\n\u001b[?2004l\r"]
[2491.597422, "o", "\u001b[?2004h"]
[2491.59746, "o", "> \r\n\u001b[?2004l\r"]
[2491.5975, "o", "\u001b[?2004h"]
[2491.597539, "o", "> "]
[2491.59806, "o", "    # District numerator/denominator: cumulative values reset at each district boundary.\r\n\u001b[?2004l\r"]
[2491.598095, "o", "\u001b[?2004h"]
[2491.598137, "o", "> "]
[2491.598438, "o", "    key = lab_codes.astype(\"int64\") * STRIDE + loaded\r\n\u001b[?2004l\r"]
[2491.59848, "o", "\u001b[?2004h"]
[2491.598517, "o", "> "]
[2491.598777, "o", "    order2 = np.argsort(key, kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2491.598819, "o", "\u001b[?2004h"]
[2491.598854, "o", "> "]
[2491.599041, "o", "    district_key = key[order2]\r\n\u001b[?2004l\r"]
[2491.599075, "o", "\u001b[?2004h"]
[2491.599112, "o", "> "]
[2491.599334, "o", "    district_sorted = lab_codes[order2]\r\n\u001b[?2004l\r"]
[2491.59937, "o", "\u001b[?2004h"]
[2491.599406, "o", "> "]
[2491.599669, "o", "    district_sum = np.cumsum(y_filled[order2])\r\n\u001b[?2004l\r"]
[2491.599705, "o", "\u001b[?2004h"]
[2491.599746, "o", "> "]
[2491.600103, "o", "    district_count = np.cumsum(valid[order2]).astype(\"int64\")\r\n\u001b[?2004l\r"]
[2491.600138, "o", "\u001b[?2004h"]
[2491.600176, "o", "> "]
[2491.600479, "o", "    district_rows = np.empty(len(lab), dtype=\"int64\")\r\n\u001b[?2004l\r"]
[2491.600527, "o", "\u001b[?2004h"]
[2491.600564, "o", "> "]
[2491.600663, "o", "    previous = None\r\n\u001b[?2004l\r"]
[2491.600698, "o", "\u001b[?2004h"]
[2491.600735, "o", "> "]
[2491.600801, "o", "    count = 0\r\n\u001b[?2004l\r"]
[2491.600837, "o", "\u001b[?2004h"]
[2491.600873, "o", "> "]
[2491.601146, "o", "    for i, cid in enumerate(district_sorted):\r\n\u001b[?2004l\r"]
[2491.6012, "o", "\u001b[?2004h"]
[2491.601236, "o", "> "]
[2491.601363, "o", "        if cid != previous:\r\n\u001b[?2004l\r"]
[2491.601397, "o", "\u001b[?2004h"]
[2491.601434, "o", "> "]
[2491.601516, "o", "            count = 0\r\n\u001b[?2004l\r"]
[2491.601552, "o", "\u001b[?2004h"]
[2491.601579, "o", "> "]
[2491.601706, "o", "            previous = cid\r\n\u001b[?2004l\r"]
[2491.601734, "o", "\u001b[?2004h> "]
[2491.60184, "o", "        count += 1\r\n\u001b[?2004l\r"]
[2491.601866, "o", "\u001b[?2004h"]
[2491.601892, "o", "> "]
[2491.602054, "o", "        district_rows[i] = count\r\n\u001b[?2004l\r"]
[2491.602073, "o", "\u001b[?2004h"]
[2491.602107, "o", "> \r\n\u001b[?2004l\r"]
[2491.602143, "o", "\u001b[?2004h> "]
[2491.602302, "o", "    t = _seconds(points[\"as_of\"])\r\n\u001b[?2004l\r"]
[2491.602324, "o", "\u001b[?2004h"]
[2491.602348, "o", "> "]
[2491.602603, "o", "    gp = np.searchsorted(global_load, t, side=\"left\")\r\n\u001b[?2004l\r"]
[2491.602638, "o", "\u001b[?2004h"]
[2491.60266, "o", "> "]
[2491.60301, "o", "    global_n = np.where(gp > 0, global_rows[np.maximum(gp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2491.603039, "o", "\u001b[?2004h> "]
[2491.603399, "o", "    global_s = np.where(gp > 0, global_sum[np.maximum(gp - 1, 0)], 0.0)\r\n\u001b[?2004l\r"]
[2491.603425, "o", "\u001b[?2004h"]
[2491.603449, "o", "> "]
[2491.6038, "o", "    global_seen = np.where(gp > 0, global_count[np.maximum(gp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2491.603831, "o", "\u001b[?2004h"]
[2491.603851, "o", "> "]
[2491.604125, "o", "    prior = np.full(len(points), 0.05, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2491.604151, "o", "\u001b[?2004h"]
[2491.604176, "o", "> "]
[2491.604332, "o", "    has_prior = global_seen > 0\r\n\u001b[?2004l\r"]
[2491.604362, "o", "\u001b[?2004h"]
[2491.604388, "o", "> "]
[2491.604719, "o", "    prior[has_prior] = global_s[has_prior] / global_seen[has_prior]\r\n\u001b[?2004l\r"]
[2491.604745, "o", "\u001b[?2004h"]
[2491.604769, "o", "> \r\n\u001b[?2004l\r"]
[2491.604806, "o", "\u001b[?2004h"]
[2491.604832, "o", "> "]
[2491.605093, "o", "    point_key = point_codes.astype(\"int64\") * STRIDE + t\r\n\u001b[?2004l\r"]
[2491.605122, "o", "\u001b[?2004h> "]
[2491.605434, "o", "    hp = np.searchsorted(district_key, point_key, side=\"left\")\r\n\u001b[?2004l\r"]
[2491.605463, "o", "\u001b[?2004h"]
[2491.605488, "o", "> "]
[2491.605835, "o", "    district_n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2491.60586, "o", "\u001b[?2004h"]
[2491.605883, "o", "> "]
[2491.606247, "o", "    district_s = np.where(hp > 0, district_sum[np.maximum(hp - 1, 0)], 0.0)\r\n\u001b[?2004l\r"]
[2491.606276, "o", "\u001b[?2004h> "]
[2491.6068, "o", "    return pd.Series((district_s + m * prior) / (district_n + m), index=points.index, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2491.606828, "o", "\u001b[?2004h"]
[2491.606847, "o", "> "]
[2491.60687, "o", "PY\r\n\u001b[?2004l\r"]
[2491.609684, "o", "\u001b[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# "]
