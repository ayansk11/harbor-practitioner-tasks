[3148.629046, "i", "nl -ba churn/encoding.py; python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom churn.extract import load_extract\nfrom churn.encoding import _seconds\nT=load_extract('/app/data')\ncustomers=T['customers'].set_index('customer_id'); labels=T['labels'].copy(); labels['district']=labels.customer_id.map(customers.postcode_district)\ncid,t=100012,pd.Timestamp('2026-01-12T06:00:00Z'); d=customers.loc[cid,'postcode_district']\nz=labels[(labels.district==d)&(labels._loaded_at<t)]\nprint('direct',d,'n',len(z),'sum',z.churned_30d.sum())\nall_d=pd.concat([labels.district,pd.Series([d])],ignore_index=True)\ncodes=all_d.astype('category').cat.codes.to_numpy(dtype='int64'); lc=codes[:-1]; pc=codes[-1]\nloaded=_seconds(labels._loaded_at); tsec=_seconds(pd.Series([t]))[0]\nkey=lc.astype('int64')*10**10+loaded; pk=int(pc)*10**10+tsec\no=np.argsort(key,kind='mergesort'); dk=key[o]; dc=lc[o]\nhp=np.searchsorted(dk,pk,side='left')\nprint('direct count before point key',hp,'total district rows',np.sum(dc==pc),'direct sum before key',labels.c"]
[3148.629169, "i", "hurned_30d.to_numpy()[o][:hp].sum())\nprint('group last rows:')\nprint(pd.DataFrame({'district':dc[max(0,hp-8):hp], 'loaded':loaded[o][max(0,hp-8):hp], 'y':labels.churned_30d.to_numpy()[o][max(0,hp-8):hp], 'key':dk[max(0,hp-8):hp]}).to_string(index=False))\nPY\n"]
