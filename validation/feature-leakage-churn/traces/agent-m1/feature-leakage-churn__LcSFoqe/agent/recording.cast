[3472.616153, "i", "python3 - <<'PY'\nimport json,re,pandas as pd,numpy as np\nfrom churn.extract import load_extract\nfrom churn.visibility import _committed_transactions,_orders_rename_commit,_legacy_intervals,order_commit_times\nD='/app/data'; ops=D+'/_ops'\nT=load_extract(D); o=T['orders']; eff=order_commit_times(o,ops)\ncommitted=_committed_transactions(ops); rename=_orders_rename_commit(ops,committed); intervals=_legacy_intervals(ops,committed,rename)\npat=re.compile(r'^\\S+ legacy_orders run=\\S+ selected orders where ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)$')\nrows=[]\nfor s in open(ops+'/scheduler.log'):\n m=pat.match(s.rstrip())\n if m and m.group(5)=='orders' and int(m.group(4)) in committed and int(m.group(3))>0 and committed[int(m.group(4))]<rename:\n  rows.append((pd.Timestamp(m.group(1)).value,pd.Timestamp(m.group(2)).value,int(m.group(3)),int(m.group(4))))\nz=pd.DataFrame(rows,columns=['start','end','selected','txn']).sort_values(['start','txn']).drop_duplicates('start')\nloade"]
[3472.616297, "i", "d=o['_loaded_at'].to_numpy(dtype='datetime64[ns]').astype('int64'); event=o['ordered_at'].to_numpy(dtype='datetime64[ns]').astype('int64')\npre=event<int(rename); pos=np.searchsorted(z.start.to_numpy(),event[pre],side='right')-1; known=(pos>=0)&(event[pre]<z.end.to_numpy()[np.clip(pos,0,len(z)-1)])\nidx=np.clip(pos,0,len(z)-1)\nsummary=pd.DataFrame({'txn':z.txn.iloc[idx[known]].to_numpy(),'selected':z.selected.iloc[idx[known]].to_numpy(),'event':event[pre][known],'eff':eff.to_numpy(dtype='datetime64[ns]').astype('int64')[pre][known]})\ncounts=summary.groupby('txn').size().rename('mapped'); sums=summary.groupby('txn').eff.min().rename('min_eff')\ncheck=z.set_index('txn').join(counts).join(sums)\ncheck['count_diff']=check.mapped-check.selected\nprint('rename',rename,'intervals',len(z),'pre-rename rows',pre.sum(),'known',known.sum(),'unmapped',(~known).sum())\nprint('count differences nonzero',int((check.count_diff!=0).sum()),'sum selected',int(check.selected.sum()),'sum mapped',int(check.mapped.sum()))\nprint(check[chec"]
