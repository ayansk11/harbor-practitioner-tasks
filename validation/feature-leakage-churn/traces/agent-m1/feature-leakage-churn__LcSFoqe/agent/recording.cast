[96.432446, "i", "python3 - <<'PY'\nimport re\nfrom collections import Counter,defaultdict\nL=open('data/_ops/scheduler.log').read().splitlines()\nprint('total',len(L))\n# Categorize by job, then state/description; preserve unusual texts.\nby=defaultdict(list)\nfor s in L:\n m=re.match(r'^(\\S+) (\\w+) (.*)$',s)\n if not m: print('MALFORMED',s); continue\n by[m.group(2)].append(s)\nfor j,xs in by.items():\n print('\\nJOB',j,'count',len(xs),'first',xs[0],'last',xs[-1])\n kinds=Counter()\n unusual=[]\n for s in xs:\n  body=s.split(' ',2)[2]\n  if ' state=success' in s: kinds['success']+=1\n  elif ' state=running' in s: kinds['running']+=1\n  elif ' selected orders' in s: kinds['order-selected']+=1\n  elif ' wrote ' in s and 'sent txn' in s: kinds['wrote-txn']+=1\n  elif ' wrote ' in s: kinds['wrote']+=1\n  elif ' sent txn' in s: kinds['txn']+=1\n  elif ' state=' in s: kinds[body.split('state=',1)[1].split()[0]]+=1\n  else: kinds['other']+=1; unusual.append(s)\n print(dict(kinds))\n print('unusual first 30:')\n for s in unusual[:30]: print(' ',s)\nPY\n"]
[96.432548, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
