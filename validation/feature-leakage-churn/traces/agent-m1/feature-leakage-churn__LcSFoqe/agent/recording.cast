[2183.800954, "o", "\u001b[?2004h"]
[2183.800996, "o", "> "]
[2183.801225, "o", "def tenure_days(points, customers):\r\n\u001b[?2004l\r"]
[2183.801264, "o", "\u001b[?2004h"]
[2183.801293, "o", "> "]
[2183.801851, "o", "    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\r\n\u001b[?2004l\r"]
[2183.801887, "o", "\u001b[?2004h"]
[2183.801917, "o", "> "]
[2183.802364, "o", "    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400.0\r\n\u001b[?2004l\r"]
[2183.802406, "o", "\u001b[?2004h"]
