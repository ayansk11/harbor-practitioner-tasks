[3148.636508, "o", "PY\r\n\u001b[?2004l\r"]
[3148.637478, "o", "     1\t\"\"\"Point-in-time smoothed district target encoding.\"\"\"\r\n     2\timport numpy as np\r\n     3\timport pandas as pd\r\n     4\t\r\n     5\tEPOCH = pd.Timestamp(\"1970-01-01\", tz=\"UTC\")\r\n     6\tSTRIDE = 10 ** 10\r\n     7\t\r\n"]
[3148.637527, "o", "     8\t\r\n     9\tdef _seconds(values):\r\n    10\t    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype=\"int64\")\r\n    11\t\r\n    12\t\r\n    13\tdef district_encoding(points, labels, customers, m=20):\r\n    14\t    \"\"\"Reproduce the live SQL using label rows committed before each prediction.\"\"\"\r\n    15\t    districts = customers.set_index(\"customer_id\")[\"postcode_district\"]\r\n    16\t    lab = labels.copy()\r\n    17\t    lab[\"postcode_district\"] = lab[\"customer_id\"].map(districts)\r\n    18\t    lab = lab[lab[\"postcode_district\"].notna()].copy().reset_index(drop=True)\r\n    19\t\r\n"]
[3148.637557, "o", "    20\t    all_districts = pd.concat(\r\n    21\t        [lab[\"postcode_district\"], points[\"customer_id\"].map(districts)], ignore_index=True\r\n    22\t    )\r\n    23\t    codes = all_districts.astype(\"category\").cat.codes.to_numpy(dtype=\"int64\")\r\n    24\t    lab_codes = codes[:len(lab)]\r\n    25\t    point_codes = codes[len(lab):]\r\n    26\t\r\n    27\t    y = pd.to_numeric(lab[\"churned_30d\"], errors=\"coerce\").to_numpy(dtype=\"float64\")\r\n    28\t    valid = ~np.isnan(y)\r\n    29\t    y_filled = np.nan_to_num(y, nan=0.0)\r\n    30\t    rows = np.arange(1, len(lab) + 1, dtype=\"int64\")\r\n"]
[3148.637584, "o", "    31\t\r\n    32\t    # Global prior: all label rows visible to the query at time t.\r\n    33\t    loaded = _seconds(lab[\"_loaded_at\"])\r\n    34\t    global_order = np.argsort(loaded, kind=\"mergesort\")\r\n    35\t    global_load = loaded[global_order]\r\n    36\t    global_sum = np.cumsum(y_filled[global_order])\r\n    37\t    global_rows = rows[global_order]\r\n    38\t    global_seen = np.cumsum(valid[global_order]).astype(\"int64\")\r\n    39\t\r\n    40\t    # District statistics: cumulative values reset at each district group.\r\n    41\t    key = lab_codes.astype(\"int64\") * STRIDE + loaded\r\n    42\t    order = np.argsort(key, kind=\"mergesort\")\r\n    43\t    district_key = key[order]\r\n    44\t    district_codes = lab_codes[order]\r\n    45\t"]
[3148.637629, "o", "    starts = np.flatnonzero(np.r_[True, district_codes[1:] != district_codes[:-1]])\r\n    46\t    group_ends = np.r_[starts[1:], len(lab)]\r\n    47\t    group_start_sum = np.where(starts == 0, 0.0, np.cumsum(y_filled[order])[starts - 1])\r\n    48\t    group_start_rows = np.where(starts == 0, 0, rows[order][starts - 1])\r\n    49\t    cumulative_sum = np.cumsum(y_filled[order])\r\n    50\t    cumulative_rows = rows[order]\r\n    51\t    district_sum = cumulative_sum - np.repeat(group_start_sum, group_ends - starts)\r\n    52\t    cumulative_count = np.arange(1, len(lab) + 1, dtype=\"int64\")\r\n    53\t    district_rows = cumulative_count - np.repeat(group_start_rows, group_ends - starts)\r\n    54\t\r\n    55\t    t = _seconds(points[\"as_of\"])\r\n    56\t    gp = np.searchsorted(global_load, t, side=\"left\")\r\n"]
[3148.637667, "o", "    57\t    global_n = np.where(gp > 0, global_rows[np.maximum(gp - 1, 0)], 0)\r\n    58\t    global_s = np.where(gp > 0, global_sum[np.maximum(gp - 1, 0)], 0.0)\r\n    59\t    global_count = np.where(gp > 0, global_seen[np.maximum(gp - 1, 0)], 0)\r\n    60\t    prior = np.full(len(points), 0.05, dtype=\"float64\")\r\n    61\t    has_prior = global_count > 0\r\n    62\t    prior[has_prior] = global_s[has_prior] / global_count[has_prior]\r\n    63\t\r\n    64\t    point_key = point_codes.astype(\"int64\") * STRIDE + t\r\n    65\t    hp = np.searchsorted(district_key, point_key, side=\"left\")\r\n    66\t    n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)\r\n    67\t    s = np.where(hp > 0, district_sum[np.maximum(hp - 1, 0)], 0.0)\r\n"]
[3148.637694, "o", "    68\t    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\r\n"]
