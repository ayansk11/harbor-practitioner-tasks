[2965.858672, "o", "\u001b[?2004h> "]
[2965.858932, "o", "print('point key',pk,'search pos',pos,'matching keys',np.sum(key==pk),'key min/max',key.min(),key.max())\r\n\u001b[?2004l\r"]
