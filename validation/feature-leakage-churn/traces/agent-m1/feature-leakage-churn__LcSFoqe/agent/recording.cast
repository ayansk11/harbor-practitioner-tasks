[81.816505, "i", "python3 - <<'PY'\nfrom collections import Counter,defaultdict\nimport re, json\np='data/_ops/scheduler.log'\nlines=open(p).read().splitlines()\nprint('lines',len(lines))\nprint('first 30:'); print('\\n'.join(lines[:30]))\nprint('last 10:'); print('\\n'.join(lines[-10:]))\nc=Counter(); states=Counter(); jobs=Counter()\nfor x in lines:\n # ignore timestamp\n if ' job=' in x: pass\n jobs[x.split()[1] if len(x.split())>1 else '?']+=1\n for s in ['state=running','state=success','state=failed','state=skipped']:\n  if s in x: states[s]+=1\nprint('state counts',states)\n# lines that don't have common normal patterns\nweird=[x for x in lines if not re.search(r'state=(running|success)',x) and 'selected orders' not in x]\nprint('non-standard lines',len(weird)); print('\\n'.join(weird[:100]))\nPY\n"]
