[2629.063766, "i", "python3 - <<'PY'\nimport pandas as pd, json, numpy as np\nf=pd.read_parquet('/tmp/features.parquet')\nprint('shape',f.shape)\nprint('columns',list(f.columns))\nprint(f.dtypes.to_string())\nprint('\\nnulls:')\nprint(f.isna().sum().to_string())\nprint('\\nkey unique',f[['customer_id','as_of']].drop_duplicates().shape[0])\n\nsamples=[json.loads(x) for x in open('/app/logs/live_2026-01_sample.jsonl')]\ns=pd.DataFrame([{'customer_id':r['customer_id'],'as_of':pd.to_datetime(r['as_of'],utc=True),**r['features']} for r in samples])\nz=f.merge(s,on=['customer_id','as_of'],suffixes=('_out','_live'),indicator=True)\nprint('\\nsample joins',len(z),z['_merge'].value_counts().to_dict())\nfeatures=['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','app_minutes_7d','te_district']\nfor feat in features:\n a=z[feat+'_out']; b=z[feat+'_live']\n if b.dtype == object:\n  ok=(a.astype(object).where(pd.notna(a),None)==b.astype(object).where(pd.notna(b),None))\n else:\n  na=a.isna() & b.isna()\n "]
[2629.063918, "i", " ok=na | ((~a.isna()) & (~b.isna()) & ((a-b).abs() <= 1e-6 + 1e-9*b.abs()))\n print(feat,'mismatches',int((~ok).sum()),'of',len(z))\n if (~ok).any():\n  print(z.loc[~ok,['customer_id','as_of',feat+'_out',feat+'_live']].head().to_string(index=False))\nPY\n"]
