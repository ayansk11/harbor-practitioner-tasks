[96.433946, "o", " kinds=Counter()\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.43402, "o", ">  unusual=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.434068, "o", " for s in xs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.434144, "o", "  body=s.split(' ',2)[2]\r\n\u001b[?2004l\r"]
[96.434179, "o", "\u001b[?2004h> "]
[96.434282, "o", "  if ' state=success' in s: kinds['success']+=1\r\n\u001b[?2004l\r"]
[96.434314, "o", "\u001b[?2004h> "]
[96.434434, "o", "  elif ' state=running' in s: kinds['running']+=1\r\n\u001b[?2004l\r"]
[96.434469, "o", "\u001b[?2004h> "]
[96.434603, "o", "  elif ' selected orders' in s: kinds['order-selected']+=1\r\n\u001b[?2004l\r"]
[96.43467, "o", "\u001b[?2004h> "]
[96.434779, "o", "  elif ' wrote ' in s and 'sent txn' in s: kinds['wrote-txn']+=1\r\n\u001b[?2004l\r"]
[96.43481, "o", "\u001b[?2004h"]
[96.434835, "o", "> "]
[96.4349, "o", "  elif ' wrote ' in s: kinds['wrote']+=1\r\n\u001b[?2004l\r"]
[96.434928, "o", "\u001b[?2004h> "]
[96.435063, "o", "  elif ' sent txn' in s: kinds['txn']+=1\r\n\u001b[?2004l\r"]
[96.435094, "o", "\u001b[?2004h> "]
[96.435254, "o", "  elif ' state=' in s: kinds[body.split('state=',1)[1].split()[0]]+=1\r\n\u001b[?2004l\r"]
[96.435287, "o", "\u001b[?2004h> "]
[96.435393, "o", "  else: kinds['other']+=1; unusual.append(s)\r\n\u001b[?2004l\r"]
[96.435423, "o", "\u001b[?2004h> "]
[96.435467, "o", " print(dict(kinds))\r\n\u001b[?2004l\r"]
[96.435491, "o", "\u001b[?2004h> "]
[96.435564, "o", " print('unusual first 30:')\r\n\u001b[?2004l\r"]
[96.435591, "o", "\u001b[?2004h> "]
[96.435683, "o", " for s in unusual[:30]: print(' ',s)\r\n\u001b[?2004l\r"]
