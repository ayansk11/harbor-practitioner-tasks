[1338.58567, "i", "python3 - <<'PY'\nimport pandas as pd,re,json\nfrom collections import defaultdict\nc=pd.DataFrame(json.loads(x) for x in open('data/_ops/commits.jsonl')); c['at']=pd.to_datetime(c['at'],utc=True)\ncm={int(t):o for t,o in zip(c.txn,c.outcome)}\npat=re.compile(r'^\\S+ (legacy_orders|orders_hourly|legacy_backfill) run=(\\S+) (?:selected orders where ordered_at >= (\\S+) and ordered_at < (\\S+)|copied table orders where ordered_at < (\\S+)): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)$')\nrows=[]\nfor s in open('data/_ops/scheduler.log'):\n m=pat.match(s)\n if m:\n  job,run,lo,hi,cut,n,txn,target=m.groups(); n=int(n); txn=int(txn)\n  rows.append((job,run,lo or cut,hi,target,n,txn,cm.get(txn,'absent')))\nz=pd.DataFrame(rows,columns=['job','run','lo','hi','target','n','txn','outcome'])\nprint(z.groupby(['job','target','outcome']).agg(txns=('txn','size'),selected=('n','sum'),first=('run','min'),last=('run','max')).to_string())\nprint('\\nfailed selected:')\nprint(z[(z.outcome=='rollback')&(z.n>0)].to_string(index=False))\nPY\n"]
[1338.585886, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[1338.585978, "o", "\u001b[?2004h> "]
