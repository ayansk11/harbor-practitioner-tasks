[608.268743, "i", "cat > /tmp/proto.py <<'PY'\nimport pandas as pd, numpy as np, json, re\nD='/app/data'\n# Load data\ncols=dict(customers=['customer_id','signup_at','plan','postcode_district','last_login_at','_updated_at'],plan_changes=['customer_id','changed_at','old_plan','new_plan','_loaded_at'],scoring_points=['customer_id','as_of','trigger','app_minutes_7d'],orders=['order_id','customer_id','ordered_at','kind','amount_cents','_load_job','_loaded_at'],tickets=['ticket_id','customer_id','opened_at','topic','_loaded_at'],status_snapshots=['customer_id','snapshot_date','status','_loaded_at'],labels=['customer_id','as_of','churned_30d','_loaded_at'])\nT={k:pd.read_csv(f'{D}/{k}.csv') for k in cols}\nfor k,ts in [('customers',['signup_at','last_login_at','_updated_at']),('plan_changes',['changed_at','_loaded_at']),('scoring_points',['as_of']),('orders',['ordered_at','_loaded_at']),('tickets',['opened_at','_loaded_at']),('status_snapshots',['_loaded_at']),('labels',['as_of','_loaded_at'])]:\n for c in ts:T[k][c]=pd.to_datetime(T[k][c],"]
[608.268822, "i", "utc=True)\nT['status_snapshots']['snapshot_date']=pd.to_datetime(T['status_snapshots']['snapshot_date'],utc=True)\npts=T['scoring_points'].copy(); p=pts\n\n# Parse committed selected-order intervals from scheduler. These are rows committed to a table with the name in the log.\ncommits=pd.DataFrame(json.loads(s) for s in open(f'{D}/_ops/commits.jsonl'))\ncommits['at']=pd.to_datetime(commits['at'],utc=True)\ncmap={int(r.txn):r.at for r in commits.itertuples() if r.outcome=='commit'}\nintervals=[]\npat=re.compile(r'^(\\S+) legacy_orders run=(\\S+) selected orders where ordered_at >= (\\S+) and ordered_at < (\\S+): (\\d+) rows; sent txn (\\d+) to commit into (\\S+)$')\nfor line in open(f'{D}/_ops/scheduler.log'):\n m=pat.match(line)\n if m:\n  at=cmap.get(int(m.group(6)))\n  if at is not None:\n   intervals.append((pd.Timestamp(m.group(3)),pd.Timestamp(m.group(4)),at))\nintervals=pd.DataFrame(intervals,columns=['start','end','at']).sort_values(['start','end','at'])\n# migration txn: schema transaction has null table, from scheduler tran"]
[608.268855, "i", "saction id\nmig=None\nfor line in open(f'{D}/_ops/scheduler.log'):\n m=re.search(r'schema_migrations run=\\S+ sent txn (\\d+) to commit',line)\n if m:\n  tx=int(m.group(1)); r=commits[commits.txn==tx].iloc[0]\n  if r.outcome=='commit': mig=r.at\nprint('legacy intervals',len(intervals),'first',intervals.iloc[0].to_dict(),'last',intervals.iloc[-1].to_dict(),'migration',mig)\n# Every pre-migration order is assigned to the committed legacy job interval containing its event timestamp.\no=T['orders'].copy()\npre=o['ordered_at']<mig\nstarts=intervals.start.to_numpy(dtype='datetime64[ns]'); ends=intervals.end.to_numpy(dtype='datetime64[ns]'); ats=intervals.at.to_numpy(dtype='datetime64[ns]')\n# rows are event-day non-overlapping; use searchsorted on starts, then validate interval\nidx=np.searchsorted(starts,o.loc[pre,'ordered_at'].to_numpy(dtype='datetime64[ns]'),side='right')-1\nvis=o['_loaded_at'].to_numpy(dtype='datetime64[ns]').copy()\nvalid=(idx>=0)&(o.loc[pre,'ordered_at'].to_numpy(dtype='datetime64[ns]')<ends[np.clip(idx,0,len"]
[608.268876, "i", "(ends)-1)])\nvis[pre.to_numpy()]=ats[np.clip(idx,0,len(ats)-1)]\n# Rows loaded into the replacement before the rename become visible when that table becomes `orders`.\nvis[pre.to_numpy() & (o['_loaded_at'].to_numpy(dtype='datetime64[ns]')<mig.to_datetime64())]=mig.to_datetime64()\no['effective_loaded_at']=pd.Series(vis,index=o.index)\nprint('unmapped',(~valid).sum(),'effective range',pd.Series(vis).min(),pd.Series(vis).max(),'before migration',pre.sum())\n\n# Features\ncustomers=T['customers'].set_index('customer_id'); p=p.reset_index(drop=True)\nout=p[['customer_id','as_of']].copy()\n# status: latest event snapshot among rows loaded before t\ndef latest_status(points,s):\n left=points[['customer_id','as_of']].reset_index(); left['idx']=-1\n # per customer merge asof loaded visibility tricky. Use sorted events by loaded, process points by time.\n s=s.sort_values('_loaded_at')\n res=pd.Series(index=points.index,dtype=object)\n for cid, pp in points.groupby('customer_id',sort=False):\n  ss=s[s.customer_id==cid].sort_values(['sn"]
[608.268896, "i", "apshot_date','_loaded_at'])\n  # latest snapshot_date among loaded<t\n  vals=[]\n  for t in pp.as_of:\n   z=ss[ss._loaded_at<t]\n   vals.append(z.sort_values('snapshot_date').iloc[-1].status if len(z) else None)\n  res.loc[pp.index]=vals\n return res\nout['status']=latest_status(p,T['status_snapshots'])\n# plan via initial old_plan and loaded changes\npc=T['plan_changes'].sort_values('_loaded_at')\ninitial=pc.sort_values('changed_at').groupby('customer_id').first()['old_plan']\nplans={}\nfor cid,g in pc.groupby('customer_id',sort=False):\n g=g.sort_values(['changed_at','new_plan'])\n plans[cid]=(initial.get(cid),g[['changed_at','new_plan','_loaded_at']].values.tolist())\nvals=[]\nfor cid,t in zip(p.customer_id,p.as_of):\n v=initial.get(cid)\n for changed,new,load in plans[cid][1]:\n  if load<t:v=new\n vals.append(v)\nout['plan']=pd.Series(vals,index=p.index)\n# app fallback\nq=p.sort_values(['customer_id','as_of']).copy(); q['app_minutes_7d']=q.groupby('customer_id').app_minutes_7d.ffill(); out['app_minutes_7d']=q.app_minutes_7d.rei"]
[608.268915, "i", "ndex(p.index)\n# labels: all loaded before t, current immutable districts\ndis=customers.postcode_district\nlab=T['labels']; lab['district']=lab.customer_id.map(dis)\nlab=lab.sort_values('_loaded_at')\n# direct loops for sample + all? 58k x labels; do vectorized below later. Prototype sample first.\n# order features loops per point on visible subset\nof=[]\norders_by={cid:g[['ordered_at','amount_cents','effective_loaded_at']].sort_values('ordered_at') for cid,g in o.groupby('customer_id',sort=False)}\nfor cid,t in zip(p.customer_id,p.as_of):\n g=orders_by.get(cid,pd.DataFrame(columns=['ordered_at','amount_cents','effective_loaded_at']))\n z=g[(g.effective_loaded_at<t)&(g.ordered_at<t)]\n a=z[z.ordered_at>=t-pd.Timedelta(days=7)]\n b=z[z.ordered_at>=t-pd.Timedelta(days=30)]\n of.append((len(a),len(b),int(b.amount_cents.sum()) if len(b) else 0,(t-z.iloc[-1].ordered_at).total_seconds()/86400 if len(z) else np.nan))\nfor i,n in enumerate(['orders_7d','orders_30d','spend_30d_cents','days_since_last_order']):out[n]=[x[i] for x in"]
[608.268938, "o", "cat > /tmp/proto.py <<'PY'\r\n\u001b[?2004l\r"]
[608.268957, "i", " of]\n# tickets\ntf=[]\ntk_by={cid:g[['opened_at','_loaded_at']].sort_values('opened_at') for cid,g in T['tickets'].groupby('customer_id',sort=False)}\nfor cid,t in zip(p.customer_id,p.as_of):\n g=tk_by.get(cid,pd.DataFrame(columns=['opened_at','_loaded_at'])); z=g[(g._loaded_at<t)&(g.opened_at>=t-pd.Timedelta(days=30))&(g.opened_at<t)];tf.append(len(z))\nout['tickets_30d']=tf\nout['tenure_days']=(p.as_of-p.customer_id.map(customers.signup_at)).dt.total_seconds()/86400\n# target encoding for all points by binary search on loaded time\n# Build cum arrays over labels sorted by load. Need district n/s dynamically. For each point, labels available. Use 2D simple loops grouped? Build arrays for each district and global.\n# Since labels ~30k points 58k, do merge/cumulative in chunks via searchsorted global and per district.\ncodes,un=pd.factorize(lab.district,sort=True)\n# global prior at load index\nys=lab.churned_30d.to_numpy(); cg=np.r_[0,np.cumsum(ys)]\nloadn=lab._loaded_at.to_numpy(dtype='datetime64[ns]')\n# per district dic"]
[608.268985, "i", "tionaries\nper={}\nfor d,g in lab.groupby('district',sort=False):\n gg=g.sort_values('_loaded_at'); per[d]=(gg._loaded_at.to_numpy(dtype='datetime64[ns]'),np.r_[0,np.cumsum(gg.churned_30d.to_numpy())])\nte=[]\nfor cid,t in zip(p.customer_id,p.as_of):\n d=dis.loc[cid]\n ng=int(np.searchsorted(loadn,t.to_datetime64())); pg=cg[ng]/ng if ng else .05\n ln,cs=per.get(d,(np.array([],dtype='datetime64[ns]'),np.array([0])))\n n=int(np.searchsorted(ln,t.to_datetime64()));s=cs[n]\n te.append((s+20*pg)/(n+20))\nout['te_district']=te\nout=out.set_index(['customer_id','as_of'])\n# compare samples\nsamples=pd.DataFrame([json.loads(x) for x in open('/app/logs/live_2026-01_sample.jsonl')])\nfor feat in ['orders_7d','orders_30d','spend_30d_cents','tickets_30d','days_since_last_order','tenure_days','status','plan','app_minutes_7d','te_district']:\n vals=[]\n for r in samples.itertuples():\n  expected=out.loc[(r.customer_id,pd.Timestamp(r.as_of)),feat]; actual=r.features[feat]\n  vals.append((pd.isna(expected) and actual is None) or (isinstance(ac"]
[608.269004, "i", "tual,str) and expected==actual) or (isinstance(actual,(int,float)) and not pd.isna(expected) and abs(float(expected)-float(actual))<=1e-6+1e-9*abs(float(actual))))\n print(feat,'mismatches',len(vals)-sum(vals),'of',len(vals))\n for r,ok in zip(samples.itertuples(),vals):\n  if not ok:\n   e=out.loc[(r.customer_id,pd.Timestamp(r.as_of)),feat]\n   print(' example',r.customer_id,r.as_of,'expected',e,'actual',r.features[feat]);break\nPY\npython3 /tmp/proto.py\n"]
