[2183.781303, "o", "\u001b[?2004h"]
[2183.781344, "o", "> "]
[2183.781906, "o", "        frame = frame.sort_values([\"customer_id\", event_col], kind=\"mergesort\")\r\n\u001b[?2004l\r"]
[2183.781948, "o", "\u001b[?2004h> "]
[2183.782134, "o", "        groups = {}\r\n\u001b[?2004l\r"]
[2183.782178, "o", "\u001b[?2004h> "]
[2183.782655, "o", "        for cid, group in frame.groupby(\"customer_id\", sort=False):\r\n\u001b[?2004l\r"]
