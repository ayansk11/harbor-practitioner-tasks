[2183.72026, "i", "chsorted(times, t, side=\"left\")\n            if hi:\n                seen = loads[:hi] < t\n                if seen.any():\n                    event = times[:hi][seen]\n                    tickets_30d[i] = np.count_nonzero(event >= t - np.timedelta64(30, \"D\"))\n\n    out = points[[\"customer_id\", \"as_of\"]].copy()\n    out[\"orders_7d\"] = orders_7d\n    out[\"orders_30d\"] = orders_30d\n    out[\"spend_30d_cents\"] = spend\n    out[\"tickets_30d\"] = tickets_30d\n    out[\"days_since_last_order\"] = last_order_days\n    return out\n\n\ndef tenure_days(points, customers):\n    signup = points[\"customer_id\"].map(customers.set_index(\"customer_id\")[\"signup_at\"])\n    return (points[\"as_of\"] - signup).dt.total_seconds() / 86400.0\nPY\n"]
