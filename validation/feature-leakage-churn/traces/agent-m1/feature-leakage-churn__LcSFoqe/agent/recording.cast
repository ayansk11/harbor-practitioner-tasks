[53.517759, "o", "     1\t\"\"\"Account status from the billing system's status snapshots, point in time (INC-2041).\r\n     2\t\r\n     3\tA snapshot dated D records the status at the end of day D, so a prediction at t may only use snapshots dated before\r\n     4\tdate(t).\r\n     5\t\"\"\"\r\n     6\timport pandas as pd\r\n     7\t\r\n"]
[53.517803, "o", "     8\t\r\n     9\tdef latest_status(points, snapshots):\r\n    10\t    \"\"\"Status of the customer's latest snapshot dated before the prediction's UTC date (null if none).\"\"\"\r\n"]
[53.51783, "o", "    11\t    left = points[[\"customer_id\"]].assign(day=points[\"as_of\"].dt.floor(\"D\")).reset_index()\r\n    12\t    left = left.sort_values(\"day\", kind=\"mergesort\")\r\n    13\t    snaps = snapshots.sort_values(\"snapshot_date\", kind=\"mergesort\")[[\"customer_id\", \"snapshot_date\", \"status\"]]\r\n    14\t    snaps = snaps.assign(snapshot_date=snaps[\"snapshot_date\"].astype(left[\"day\"].dtype))\r\n    15\t    m = pd.merge_asof(left, snaps, left_on=\"day\", right_on=\"snapshot_date\", by=\"customer_id\",\r\n    16\t                      allow_exact_matches=False)\r\n    17\t    return m.set_index(\"index\")[\"status\"].reindex(points.index)\r\n"]
