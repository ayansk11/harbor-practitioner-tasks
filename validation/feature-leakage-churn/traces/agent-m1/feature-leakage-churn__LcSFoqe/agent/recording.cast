[2965.852702, "o", "s=T['status_snapshots']; points=pts\r\n\u001b[?2004l\r"]
[2965.852717, "o", "\u001b[?2004h"]
[2965.85273, "o", "> "]
[2965.852862, "o", "EPOCH=pd.Timestamp('1970-01-01',tz='UTC'); STRIDE=10**10\r\n\u001b[?2004l\r"]
[2965.852877, "o", "\u001b[?2004h"]
[2965.85289, "o", "> "]
[2965.853085, "o", "def sec(v): return ((v-EPOCH)//pd.Timedelta(seconds=1)).to_numpy(dtype='int64')\r\n\u001b[?2004l\r"]
[2965.853101, "o", "\u001b[?2004h"]
[2965.853115, "o", "> "]
[2965.853525, "o", "event=s.snapshot_date.to_numpy(dtype='datetime64[ns]').astype('int64'); loaded=sec(s._loaded_at); customer=s.customer_id.to_numpy(dtype='int64'); key=customer*STRIDE+loaded\r\n\u001b[?2004l\r"]
[2965.85354, "o", "\u001b[?2004h"]
[2965.853554, "o", "> "]
[2965.853887, "o", "order=np.argsort(key,kind='mergesort'); customer_s=customer[order]; event_s=event[order]; status_s=s.status.to_numpy(dtype=object)[order]\r\n\u001b[?2004l\r"]
[2965.853903, "o", "\u001b[?2004h"]
[2965.853916, "o", "> "]
[2965.854089, "o", "running=np.empty(len(event_s),dtype=event_s.dtype); prev=None; cur=None\r\n\u001b[?2004l\r"]
[2965.854105, "o", "\u001b[?2004h"]
[2965.854118, "o", "> "]
[2965.854244, "o", "for i,(cid,val) in enumerate(zip(customer_s,event_s)):\r\n\u001b[?2004l\r"]
[2965.854257, "o", "\u001b[?2004h"]
[2965.854271, "o", "> "]
[2965.854347, "o", " if cid!=prev: cur=val; prev=cid\r\n\u001b[?2004l\r"]
[2965.854365, "o", "\u001b[?2004h> "]
[2965.854424, "o", " elif val>cur: cur=val\r\n\u001b[?2004l\r"]
[2965.854438, "o", "\u001b[?2004h"]
[2965.854451, "o", "> "]
[2965.854486, "o", " running[i]=cur\r\n\u001b[?2004l\r"]
[2965.854502, "o", "\u001b[?2004h> "]
[2965.854636, "o", "boundary=np.r_[True,customer_s[1:]!=customer_s[:-1]]\r\n\u001b[?2004l\r"]
[2965.854658, "o", "\u001b[?2004h> "]
[2965.8548, "o", "changed=boundary | np.r_[False,running[1:]!=running[:-1]]\r\n\u001b[?2004l\r"]
[2965.854844, "o", "\u001b[?2004h"]
[2965.854868, "o", "> "]
[2965.855017, "o", "best=pd.Series(status_s).where(changed).ffill().to_numpy(dtype=object)\r\n\u001b[?2004l\r"]
[2965.855039, "o", "\u001b[?2004h> "]
[2965.85517, "o", "for cid,t in zip(points.customer_id,points.as_of):\r\n\u001b[?2004l\r"]
[2965.855186, "o", "\u001b[?2004h"]
[2965.855201, "o", "> "]
[2965.855417, "o", " pk=int(cid)*STRIDE+sec(pd.Series([t]))[0]; pos=np.searchsorted(key,pk,side='left')\r\n\u001b[?2004l\r\u001b[?2004h"]
[2965.855439, "o", "> "]
[2965.855741, "o", " print('point',cid,'key',pk,'pos',pos,'insert key neighbors',key[max(0,pos-2):pos+2], 'best around',best[max(0,pos-2):pos+2])\r\n\u001b[?2004l\r"]
[2965.855761, "o", "\u001b[?2004h> "]
[2965.85585, "o", " # customer rows in sorted order\r\n\u001b[?2004l\r"]
[2965.85587, "o", "\u001b[?2004h> "]
[2965.855973, "o", " loc=np.flatnonzero(customer_s==cid)\r\n\u001b[?2004l\r"]
[2965.85599, "o", "\u001b[?2004h"]
[2965.856005, "o", "> "]
[2965.856173, "o", " print('customer sorted load/date/status/max/boundary/changed/best')\r\n\u001b[?2004l\r"]
[2965.856192, "o", "\u001b[?2004h> "]
[2965.85668, "o", " print(pd.DataFrame({'loaded':loaded[order][loc],'date':event_s[loc],'status':status_s[loc],'max':running[loc],'boundary':boundary[loc],'changed':changed[loc],'best':best[loc]}).to_string(index=False))\r\n\u001b[?2004l\r"]
[2965.856704, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2965.856722, "o", "\u001b[?2004h"]
[2965.856735, "o", "> "]
[2965.856845, "o", "# Reproduce encoding internals for sample\r\n\u001b[?2004l\r"]
[2965.856862, "o", "\u001b[?2004h"]
[2965.856878, "o", "> "]
[2965.857236, "o", "labels=T['labels'].copy(); customers=T['customers'].set_index('customer_id'); labels['district']=labels.customer_id.map(customers.postcode_district)\r\n\u001b[?2004l\r"]
[2965.857259, "o", "\u001b[?2004h"]
[2965.857272, "o", "> "]
[2965.857495, "o", "cid,t=100012,pd.Timestamp('2026-01-12T06:00:00Z'); d=customers.loc[cid,'postcode_district']\r\n\u001b[?2004l\r"]
[2965.857516, "o", "\u001b[?2004h> "]
[2965.857915, "o", "all_d=pd.concat([labels.district,pd.Series([d])],ignore_index=True); codes=all_d.astype('category').cat.codes.to_numpy(dtype='int64'); lc=codes[:-1]; pc=codes[-1]\r\n\u001b[?2004l\r"]
[2965.857935, "o", "\u001b[?2004h> "]
[2965.858226, "o", "loaded=_seconds(labels._loaded_at); key=lc.astype('int64')*STRIDE+loaded; pk=int(pc)*STRIDE+sec(pd.Series([t]))[0]\r\n\u001b[?2004l\r"]
[2965.858251, "o", "\u001b[?2004h> "]
