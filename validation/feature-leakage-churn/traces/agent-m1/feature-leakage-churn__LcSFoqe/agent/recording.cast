[2864.261824, "o", "    hp = np.searchsorted(district_key, point_key, side=\"left\")\r\n\u001b[?2004l\r"]
[2864.261862, "o", "\u001b[?2004h"]
[2864.261903, "o", "> "]
[2864.262302, "o", "    n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)\r\n\u001b[?2004l\r"]
[2864.262339, "o", "\u001b[?2004h"]
[2864.262382, "o", "> "]
[2864.262783, "o", "    s = np.where(hp > 0, district_sum[np.maximum(hp - 1, 0)], 0.0)\r\n\u001b[?2004l\r"]
[2864.262823, "o", "\u001b[?2004h"]
[2864.262856, "o", "> "]
[2864.263383, "o", "    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype=\"float64\")\r\n\u001b[?2004l\r"]
[2864.263426, "o", "\u001b[?2004h"]
[2864.263463, "o", "> "]
