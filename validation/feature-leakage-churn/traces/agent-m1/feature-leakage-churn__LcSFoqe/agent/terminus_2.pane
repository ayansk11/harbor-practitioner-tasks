[?2004l     1	"""Feature queries of the live churn scoring service: a read-only copy of the service's `features` module.
     2	
     3	This copy is the contract between the live service and the offline pipeline in `churn/`. It is kept for reference:
     4	nothing in this repository imports or runs it, there is no warehouse connection here, and editing it changes nothing.
     5	
     6	How the service uses it. A scoring request names a customer and a moment: the 06:00 batch run (trigger `batch`), or
     7	the support desk when a ticket is opened (trigger `ticket`, at the ticket's `opened_at`). For each request the service
     8	runs every query in QUERIES once, at the moment of the request, against the warehouse tables as they stand at that
     9	moment, and takes the first column of the first row as the feature's value; a query that returns no row, or NULL,
    10	gives a null value. The service then scores the 11 values with the deployed model, if one is attached, and logs them
    11	with the request.
    12	
    13	Parameters of every query:
    14	    :customer_id     the request's customer
    15	    :now             the moment of the request (the `as_of` the scoring service records for it)
    16	    :app_minutes_7d  the product-analytics reading that came with the request, NULL when it came without one
    17	
    18	The warehouse is PostgreSQL. Timestamps are `timestamptz` and sessions run in UTC, so INTERVAL '7 days' is exactly
    19	7 x 86,400 seconds and EXTRACT(EPOCH FROM <interval>) is a number of seconds. The tables, and when their rows and
    20	values are committed: docs/WAREHOUSE.md.
    21	"""
    22	
    23	QUERIES = {
    24	    # orders in the 7 days before the request
    25	    "orders_7d": """
    26	        SELECT COUNT(*)
    27	        FROM orders
    28	        WHERE customer_id = :customer_id
    29	          AND ordered_at >= :now - INTERVAL '7 days'
    30	          AND ordered_at < :now
    31	    """,
    32	    # orders in the 30 days before the request
    33	    "orders_30d": """
    34	        SELECT COUNT(*)
    35	        FROM orders
    36	        WHERE customer_id = :customer_id
    37	          AND ordered_at >= :now - INTERVAL '30 days'
    38	          AND ordered_at < :now
    39	    """,
    40	    # amount of those orders, in cents (0 when there are none)
    41	    "spend_30d_cents": """
    42	        SELECT COALESCE(SUM(amount_cents), 0)
    43	        FROM orders
    44	        WHERE customer_id = :customer_id
    45	          AND ordered_at >= :now - INTERVAL '30 days'
    46	          AND ordered_at < :now
    47	    """,
    48	    # support tickets opened in the 30 days before the request
    49	    "tickets_30d": """
    50	        SELECT COUNT(*)
    51	        FROM tickets
    52	        WHERE customer_id = :customer_id
    53	          AND opened_at >= :now - INTERVAL '30 days'
    54	          AND opened_at < :now
    55	    """,
    56	    # days since the latest order before the request (NULL when there is none)
    57	    "days_since_last_order": """
    58	        SELECT EXTRACT(EPOCH FROM (:now - MAX(ordered_at))) / 86400.0
    59	        FROM orders
    60	        WHERE customer_id = :customer_id
    61	          AND ordered_at < :now
    62	    """,
    63	    # days since sign-up
    64	    "tenure_days": """
    65	        SELECT EXTRACT(EPOCH FROM (:now - signup_at)) / 86400.0
    66	        FROM customers
    67	        WHERE customer_id = :customer_id
    68	    """,
    69	    # account status of the latest snapshot (no row: NULL)
    70	    "status": """
    71	        SELECT status
    72	        FROM status_snapshots
    73	        WHERE customer_id = :customer_id
    74	        ORDER BY snapshot_date DESC
    75	        LIMIT 1
    76	    """,
    77	    # subscription plan on the customer record
    78	    "plan": """
    79	        SELECT plan
    80	        FROM customers
    81	        WHERE customer_id = :customer_id
    82	    """,
    83	    # days since the last login on the customer record (NULL when the record has none)
    84	    "days_since_last_login": """
    85	        SELECT EXTRACT(EPOCH FROM (:now - last_login_at)) / 86400.0
    86	        FROM customers
    87	        WHERE customer_id = :customer_id
    88	    """,
    89	    # app minutes over the last 7 days: the request's own reading, else the reading of the customer's latest earlier
    90	    # request that had one (NULL when there is none)
    91	    "app_minutes_7d": """
    92	        SELECT COALESCE(
    93	            CAST(:app_minutes_7d AS double precision),
    94	            (SELECT app_minutes_7d
    95	             FROM scoring_points
    96	             WHERE customer_id = :customer_id
    97	               AND as_of < :now
    98	               AND app_minutes_7d IS NOT NULL
    99	             ORDER BY as_of DESC
   100	             LIMIT 1))
   101	    """,
   102	    # smoothed churn rate of the customer's postcode district: (s + 20 p) / (n + 20), where p is the mean churned_30d
   103	    # of all label rows (0.05 when there are none), and n and s are the number of label rows of customers in the same
   104	    # district and the sum of their churned_30d
   105	    "te_district": """
   106	        WITH lab AS (
   107	            SELECT l.churned_30d, c.postcode_district
   108	            FROM labels l
   109	            JOIN customers c ON c.customer_id = l.customer_id
   110	        ),
   111	        own AS (
   112	            SELECT postcode_district
   113	            FROM customers
   114	            WHERE customer_id = :customer_id
   115	        )
   116	        SELECT (COALESCE(SUM(lab.churned_30d) FILTER (WHERE lab.postcode_district = own.postcode_district), 0)
   117	                + 20 * COALESCE(AVG(lab.churned_30d), 0.05))
   118	               / (COUNT(*) FILTER (WHERE lab.postcode_district = own.postcode_district) + 20)
   119	        FROM lab CROSS JOIN own
   120	    """,
   121	}
   122	
   123	FEATURES = list(QUERIES)
[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# for f in churn/extract.py churn/windows.py churn/status.py churn/attributes.py churn/impute.py churn/encoding.py; do echo "===== $f ====="; nl -ba "$f"; done
[?2004l===== churn/extract.py =====
     1	"""Load a warehouse extract (the seven CSV files described in docs/WAREHOUSE.md) into pandas frames.
     2	
     3	Every timestamp column is parsed to a UTC timestamp, the load metadata columns included, so each frame carries
     4	everything its CSV file has.
     5	"""
     6	import os
     7	import pandas as pd
     8	
     9	TIMESTAMPS = {
    10	    "customers": ["signup_at", "last_login_at", "_updated_at"],
    11	    "plan_changes": ["changed_at", "_loaded_at"],
    12	    "scoring_points": ["as_of"],
    13	    "orders": ["ordered_at", "_loaded_at"],
    14	    "tickets": ["opened_at", "_loaded_at"],
    15	    "status_snapshots": ["snapshot_date", "_loaded_at"],
    16	    "labels": ["as_of", "_loaded_at"],
    17	}
    18	
    19	
    20	def load_extract(data_dir):
    21	    tables = {}
    22	    for name, cols in TIMESTAMPS.items():
    23	        df = pd.read_csv(os.path.join(data_dir, f"{name}.csv"), dtype={"postcode_district": "str"})
    24	        for c in cols:
    25	            df[c] = pd.to_datetime(df[c], utc=True)
    26	        tables[name] = df
    27	    tables["scoring_points"]["app_minutes_7d"] = tables["scoring_points"]["app_minutes_7d"].astype("float64")
    28	    return tables
===== churn/windows.py =====
     1	"""Activity features over trailing windows (orders, spend, tickets) and simple time-since features.
     2	
     3	Point in time (INC-2041): a window is [t - W days, t) on the exact event timestamps, so an event stamped at or after
     4	the prediction time is never counted and nothing later in the day leaks in.
     5	"""
     6	import numpy as np
     7	import pandas as pd
     8	
     9	EPOCH = pd.Timestamp("1970-01-01", tz="UTC")
    10	STRIDE = 10 ** 10  # composite key customer_id * STRIDE + epoch seconds (seconds stay below 1e10 until 2286)
    11	
    12	
    13	def _seconds(ts):
    14	    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype="int64")
    15	
    16	
    17	def _window(points, events, ts_col, days, amount_col=None):
    18	    """Per prediction: number (and amount sum) of the customer's events with t - days <= ts < t."""
    19	    ev_key = events["customer_id"].to_numpy(dtype="int64") * STRIDE + _seconds(events[ts_col])
    20	    order = np.argsort(ev_key, kind="stable")
    21	    ev_key = ev_key[order]
    22	    cid = points["customer_id"].to_numpy(dtype="int64") * STRIDE
    23	    t = _seconds(points["as_of"])
    24	    hi = np.searchsorted(ev_key, cid + t, side="left")
    25	    lo = np.searchsorted(ev_key, cid + t - days * 86400, side="left")
    26	    count = hi - lo
    27	    if amount_col is None:
    28	        return count, None
    29	    pref = np.concatenate([[0], np.cumsum(events[amount_col].to_numpy(dtype="int64")[order])])
    30	    return count, pref[hi] - pref[lo]
    31	
    32	
    33	def activity_features(points, orders, tickets):
    34	    out = points[["customer_id", "as_of"]].copy()
    35	    out["orders_7d"], _ = _window(points, orders, "ordered_at", 7)
    36	    out["orders_30d"], out["spend_30d_cents"] = _window(points, orders, "ordered_at", 30, "amount_cents")
    37	    out["tickets_30d"], _ = _window(points, tickets, "opened_at", 30)
    38	
    39	    # time since the last order strictly before the prediction
    40	    o = orders.sort_values("ordered_at")[["customer_id", "ordered_at"]]
    41	    left = out[["customer_id", "as_of"]].reset_index().sort_values("as_of")
    42	    last = pd.merge_asof(left, o, left_on="as_of", right_on="ordered_at", by="customer_id",
    43	                         allow_exact_matches=False).set_index("index").sort_index()["ordered_at"]
    44	    out["days_since_last_order"] = (out["as_of"] - last).dt.total_seconds() / 86400
    45	    return out
    46	
    47	
    48	def tenure_days(points, customers):
    49	    signup = points["customer_id"].map(customers.set_index("customer_id")["signup_at"])
    50	    return (points["as_of"] - signup).dt.total_seconds() / 86400
===== churn/status.py =====
     1	"""Account status from the billing system's status snapshots, point in time (INC-2041).
     2	
     3	A snapshot dated D records the status at the end of day D, so a prediction at t may only use snapshots dated before
     4	date(t).
     5	"""
     6	import pandas as pd
     7	
     8	
     9	def latest_status(points, snapshots):
    10	    """Status of the customer's latest snapshot dated before the prediction's UTC date (null if none)."""
    11	    left = points[["customer_id"]].assign(day=points["as_of"].dt.floor("D")).reset_index()
    12	    left = left.sort_values("day", kind="mergesort")
    13	    snaps = snapshots.sort_values("snapshot_date", kind="mergesort")[["customer_id", "snapshot_date", "status"]]
    14	    snaps = snaps.assign(snapshot_date=snaps["snapshot_date"].astype(left["day"].dtype))
    15	    m = pd.merge_asof(left, snaps, left_on="day", right_on="snapshot_date", by="customer_id",
    16	                      allow_exact_matches=False)
    17	    return m.set_index("index")["status"].reindex(points.index)
===== churn/attributes.py =====
     1	"""Customer attributes from the customer record (new in v3): the subscription plan and the days since the last login.
     2	
     3	Point in time: a last login at or after the prediction time is ignored (the feature is null then), so the feature
     4	never looks ahead of t.
     5	"""
     6	
     7	
     8	def plan(points, customers):
     9	    """The customer's subscription plan."""
    10	    return points["customer_id"].map(customers.set_index("customer_id")["plan"])
    11	
    12	
    13	def days_since_last_login(points, customers):
    14	    """t minus the customer's last login, in days; null when the record has no login before t."""
    15	    last = points["customer_id"].map(customers.set_index("customer_id")["last_login_at"])
    16	    days = (points["as_of"] - last).dt.total_seconds() / 86400
    17	    return days.where(last < points["as_of"])
===== churn/impute.py =====
     1	"""Gap filling for upstream readings that arrive with holes (analytics export outages, devices offline).
     2	
     3	Point in time (INC-2041): a missing reading takes the customer's most recent earlier reading, never a later one; with
     4	no earlier reading it stays null.
     5	"""
     6	
     7	
     8	def fill_app_minutes(points):
     9	    """Fill missing app_minutes_7d from the same customer's last earlier reading."""
    10	    pts = points.sort_values(["customer_id", "as_of"], kind="mergesort")
    11	    filled = pts.groupby("customer_id")["app_minutes_7d"].ffill()
    12	    return filled.reindex(points.index)
===== churn/encoding.py =====
     1	"""Target encoding of high-cardinality categoricals, point in time (INC-2041).
     2	
     3	A label row records whether the customer churned in the 30 days after its own prediction, so its outcome is final only
     4	once that window has closed (as_of + 30 days). A prediction at t uses only labels whose window closed before t, for the
     5	district counts and for the prior alike; its own label and every later one are never seen.
     6	"""
     7	import numpy as np
     8	import pandas as pd
     9	
    10	PRIOR_WEIGHT = 20
    11	DEFAULT_PRIOR = 0.05
    12	LABEL_WINDOW_DAYS = 30
    13	EPOCH = pd.Timestamp("1970-01-01", tz="UTC")
    14	STRIDE = 10 ** 10
    15	
    16	
    17	def _seconds(ts):
    18	    return ((ts - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype="int64")
    19	
    20	
    21	def district_encoding(points, labels, customers, m=PRIOR_WEIGHT):
    22	    """Smoothed churn rate of the customer's postcode district, from labels whose window closed before t."""
    23	    district = customers.set_index("customer_id")["postcode_district"]
    24	    lab_d = labels["customer_id"].map(district)
    25	    pt_d = points["customer_id"].map(district)
    26	    codes, _ = pd.factorize(pd.concat([lab_d, pt_d], ignore_index=True))
    27	    lab_code, pt_code = codes[:len(labels)].astype("int64"), codes[len(labels):].astype("int64")
    28	    closed = _seconds(labels["as_of"]) + LABEL_WINDOW_DAYS * 86400
    29	    y = labels["churned_30d"].to_numpy(dtype="int64")
    30	    t = _seconds(points["as_of"])
    31	
    32	    order = np.argsort(closed, kind="stable")
    33	    ycum = np.concatenate([[0], np.cumsum(y[order])])
    34	    N = np.searchsorted(closed[order], t, side="left")
    35	    S = ycum[N]
    36	    prior = np.full(len(t), DEFAULT_PRIOR)
    37	    has = N > 0
    38	    prior[has] = S[has] / N[has]
    39	
    40	    key = lab_code * STRIDE + closed
    41	    o2 = np.argsort(key, kind="stable")
    42	    ycum2 = np.concatenate([[0], np.cumsum(y[o2])])
    43	    hi = np.searchsorted(key[o2], pt_code * STRIDE + t, side="left")
    44	    lo = np.searchsorted(key[o2], pt_code * STRIDE, side="left")
    45	    n, s = hi - lo, ycum2[hi] - ycum2[lo]
    46	    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype="float64")
[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# nl -ba docs/WAREHOUSE.md | sed -n '1,180p'
[?2004l     1	# Warehouse tables (churn scoring)
     2	
     3	Written 2025-02-14 by the data platform for the warehouse and its nightly loaders as they were on that date, and not
     4	updated since. The scheduler's own records of every job run and transaction, later changes included, are in each
     5	extract's `_ops/` folder (below).
     6	
     7	The seven tables below are the warehouse tables that the live scoring service (`live/features.py`) and the churn
     8	pipeline (`churn/`) read. This page says what each table holds and which system writes it. Every brand of the company
     9	runs the same warehouse and jobs; each brand's job runs, failures and changes are its own.
    10	
    11	## Reading the warehouse
    12	- A query that starts at a moment t sees exactly the rows and values committed before t: a row committed at or after
    13	  t is not seen, and a value overwritten at or after t is seen as it was before the overwrite, whatever the date of
    14	  the event the row records.
    15	- A query reads each table by the name it has when the query starts.
    16	- `_loaded_at` is the commit time of the load that wrote the row; in `orders`, `_load_job` names that load.
    17	- An extract is a copy of every table as the warehouse held it at one moment: the rows and values committed before
    18	  that moment, with the `_ops/` records written before it.
    19	- Timestamps are UTC, written as ISO 8601 with a `Z` suffix and whole seconds (`2025-02-04T06:00:00Z`);
    20	  `snapshot_date` is a UTC date (`YYYY-MM-DD`); amounts are integer cents. Columns whose names start with `_` are
    21	  written by the loaders, not by the source systems.
    22	
    23	## The scheduler's records (`_ops/`)
    24	- `_ops/scheduler.log` has one UTC event per line, `<time> <job> run=<run> <event>`: each task's start
    25	  (`state=running`) and end (`state=success` or `state=failed`), and between them the lines the task writes, such as
    26	  the rows it selected or copied, the transaction it sent (`sent txn <n> to commit`), the statements it ran and the
    27	  checks it made.
    28	- `_ops/commits.jsonl` has one JSON object per transaction a scheduled job sent: `txn`, `at`, `outcome` (`commit` or
    29	  `rollback`), `table` and `rows` (the table the transaction writes rows into and how many; null for schema
    30	  statements).
    31	- `_ops/commits.jsonl` is the commit log of the scheduled jobs: a transaction is committed if and only if its outcome
    32	  is `commit`, and it is committed at its `at`; the scheduler's task states describe tasks, not commits.
    33	- Change data capture (`tickets`), the sign-up service and the scoring service write without the scheduler and are not
    34	  in `_ops/`.
    35	
    36	## Tables
    37	
    38	### `customers`
    39	`customer_id, signup_at, plan, postcode_district, last_login_at, _updated_at`: one row per customer.
    40	- The sign-up service writes the row at `signup_at`: the plan chosen at sign-up (`basic`, `plus` or `family`), the
    41	  postcode district, an empty `last_login_at`, and `_updated_at` = `signup_at`. `signup_at` and `postcode_district`
    42	  never change.
    43	- `crm_sync` reads the CRM at its start. For each customer whose plan or last login in the CRM (the latest login to
    44	  the app or website before the sync's start) differs from the row, it overwrites `plan` and `last_login_at` with the
    45	  CRM's values and sets `_updated_at` to the sync's commit time.
    46	- Only plan changes are logged (`plan_changes`); no history of `last_login_at` is kept.
    47	
    48	### `plan_changes`
    49	`customer_id, changed_at, old_plan, new_plan, _loaded_at`: one row per plan change that `crm_sync` has applied. Each
    50	sync writes one row for every change made in the CRM before its start that no earlier sync applied; `changed_at` is
    51	when the customer made the change in the CRM, `_loaded_at` the commit of the sync that applied it. A customer's rows
    52	are every change applied since sign-up, so the earliest row's `old_plan` is the plan chosen at sign-up. When one sync
    53	applies several changes of a customer, the plan after that sync is the `new_plan` of the latest of them (by
    54	`changed_at`), the CRM's plan at the sync's start.
    55	
    56	### `scoring_points`
    57	`customer_id, as_of, trigger, app_minutes_7d`: one row per scoring request, written by the scoring service at the
    58	moment of the request, `as_of`. `trigger` is `batch` (the 06:00 run, which scores a customer every 14 days, on the
    59	customer's billing weekday) or `ticket` (a request the support desk sends when a ticket is opened, for some of the
    60	tickets, at the ticket's `opened_at`). `app_minutes_7d` is the product-analytics reading that came with the request (the customer's minutes in
    61	the app over the last 7 days), empty when the request came without one (analytics export outages, devices offline).
    62	`(customer_id, as_of)` is unique.
    63	
    64	### `orders`
    65	`order_id, customer_id, ordered_at, kind, amount_cents, _load_job, _loaded_at`. `kind` is `box` (the weekly box,
    66	charged by billing at 05:30 on the customer's billing weekday; `ordered_at` is the charge) or `addon` (an extra item,
    67	ordered at any time). Each order exists in the order system, which the loaders read, from its `ordered_at` on.
    68	The nightly `legacy_orders` job writes the table: each run selects orders from the order system and sends them to
    69	`orders` in one transaction.
    70	
    71	### `tickets`
    72	`ticket_id, customer_id, opened_at, topic, _loaded_at`: support tickets, written by change data capture from the
    73	support desk 1 to 30 seconds after `opened_at`.
    74	
    75	### `status_snapshots`
    76	`customer_id, snapshot_date, status, _loaded_at`: the billing system's account status (`active`, `paused`,
    77	`payment_failed` or `cancelled`) at the end of day `snapshot_date`. Billing records a row for a customer on the
    78	sign-up day, on every day the status changed, and on the first day of every month, up to the cancellation (a
    79	`cancelled` row is the customer's last); there is at most one row per customer and date.
    80	`billing_export` writes each day's partition (all the rows dated D) in one transaction.
    81	
    82	### `labels`
    83	`customer_id, as_of, churned_30d, _loaded_at`: the outcome of a prediction (`customer_id` and `as_of` as in
    84	`scoring_points`): `churned_30d` is 1 if the customer cancelled in `(as_of, as_of + 30 days]`, else 0. The outcome
    85	becomes known at the cancellation, or when the 30 days have passed without one.
    86	`label_job` writes, in one transaction per run, a row for each prediction whose outcome became known before the run
    87	started and that has no row yet.
[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# nl -ba live/features.py
[?2004l     1	"""Feature queries of the live churn scoring service: a read-only copy of the service's `features` module.
     2	
     3	This copy is the contract between the live service and the offline pipeline in `churn/`. It is kept for reference:
     4	nothing in this repository imports or runs it, there is no warehouse connection here, and editing it changes nothing.
     5	
     6	How the service uses it. A scoring request names a customer and a moment: the 06:00 batch run (trigger `batch`), or
     7	the support desk when a ticket is opened (trigger `ticket`, at the ticket's `opened_at`). For each request the service
     8	runs every query in QUERIES once, at the moment of the request, against the warehouse tables as they stand at that
     9	moment, and takes the first column of the first row as the feature's value; a query that returns no row, or NULL,
    10	gives a null value. The service then scores the 11 values with the deployed model, if one is attached, and logs them
    11	with the request.
    12	
    13	Parameters of every query:
    14	    :customer_id     the request's customer
    15	    :now             the moment of the request (the `as_of` the scoring service records for it)
    16	    :app_minutes_7d  the product-analytics reading that came with the request, NULL when it came without one
    17	
    18	The warehouse is PostgreSQL. Timestamps are `timestamptz` and sessions run in UTC, so INTERVAL '7 days' is exactly
    19	7 x 86,400 seconds and EXTRACT(EPOCH FROM <interval>) is a number of seconds. The tables, and when their rows and
    20	values are committed: docs/WAREHOUSE.md.
    21	"""
    22	
    23	QUERIES = {
    24	    # orders in the 7 days before the request
    25	    "orders_7d": """
    26	        SELECT COUNT(*)
    27	        FROM orders
    28	        WHERE customer_id = :customer_id
    29	          AND ordered_at >= :now - INTERVAL '7 days'
    30	          AND ordered_at < :now
    31	    """,
    32	    # orders in the 30 days before the request
    33	    "orders_30d": """
    34	        SELECT COUNT(*)
    35	        FROM orders
    36	        WHERE customer_id = :customer_id
    37	          AND ordered_at >= :now - INTERVAL '30 days'
    38	          AND ordered_at < :now
    39	    """,
    40	    # amount of those orders, in cents (0 when there are none)
    41	    "spend_30d_cents": """
    42	        SELECT COALESCE(SUM(amount_cents), 0)
    43	        FROM orders
    44	        WHERE customer_id = :customer_id
    45	          AND ordered_at >= :now - INTERVAL '30 days'
    46	          AND ordered_at < :now
    47	    """,
    48	    # support tickets opened in the 30 days before the request
    49	    "tickets_30d": """
    50	        SELECT COUNT(*)
    51	        FROM tickets
    52	        WHERE customer_id = :customer_id
    53	          AND opened_at >= :now - INTERVAL '30 days'
    54	          AND opened_at < :now
    55	    """,
    56	    # days since the latest order before the request (NULL when there is none)
    57	    "days_since_last_order": """
    58	        SELECT EXTRACT(EPOCH FROM (:now - MAX(ordered_at))) / 86400.0
    59	        FROM orders
    60	        WHERE customer_id = :customer_id
    61	          AND ordered_at < :now
    62	    """,
    63	    # days since sign-up
    64	    "tenure_days": """
    65	        SELECT EXTRACT(EPOCH FROM (:now - signup_at)) / 86400.0
    66	        FROM customers
    67	        WHERE customer_id = :customer_id
    68	    """,
    69	    # account status of the latest snapshot (no row: NULL)
    70	    "status": """
    71	        SELECT status
    72	        FROM status_snapshots
    73	        WHERE customer_id = :customer_id
    74	        ORDER BY snapshot_date DESC
    75	        LIMIT 1
    76	    """,
    77	    # subscription plan on the customer record
    78	    "plan": """
    79	        SELECT plan
    80	        FROM customers
    81	        WHERE customer_id = :customer_id
    82	    """,
    83	    # days since the last login on the customer record (NULL when the record has none)
    84	    "days_since_last_login": """
    85	        SELECT EXTRACT(EPOCH FROM (:now - last_login_at)) / 86400.0
    86	        FROM customers
    87	        WHERE customer_id = :customer_id
    88	    """,
    89	    # app minutes over the last 7 days: the request's own reading, else the reading of the customer's latest earlier
    90	    # request that had one (NULL when there is none)
    91	    "app_minutes_7d": """
    92	        SELECT COALESCE(
    93	            CAST(:app_minutes_7d AS double precision),
    94	            (SELECT app_minutes_7d
    95	             FROM scoring_points
    96	             WHERE customer_id = :customer_id
    97	               AND as_of < :now
    98	               AND app_minutes_7d IS NOT NULL
    99	             ORDER BY as_of DESC
   100	             LIMIT 1))
   101	    """,
   102	    # smoothed churn rate of the customer's postcode district: (s + 20 p) / (n + 20), where p is the mean churned_30d
   103	    # of all label rows (0.05 when there are none), and n and s are the number of label rows of customers in the same
   104	    # district and the sum of their churned_30d
   105	    "te_district": """
   106	        WITH lab AS (
   107	            SELECT l.churned_30d, c.postcode_district
   108	            FROM labels l
   109	            JOIN customers c ON c.customer_id = l.customer_id
   110	        ),
   111	        own AS (
   112	            SELECT postcode_district
   113	            FROM customers
   114	            WHERE customer_id = :customer_id
   115	        )
   116	        SELECT (COALESCE(SUM(lab.churned_30d) FILTER (WHERE lab.postcode_district = own.postcode_district), 0)
   117	                + 20 * COALESCE(AVG(lab.churned_30d), 0.05))
   118	               / (COUNT(*) FILTER (WHERE lab.postcode_district = own.postcode_district) + 20)
   119	        FROM lab CROSS JOIN own
   120	    """,
   121	}
   122	
   123	FEATURES = list(QUERIES)
