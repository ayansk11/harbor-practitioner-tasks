[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# cat > /tmp/proto.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np, json, re
[?2004l[?2004h> D='/app/data'
[?2004l[?2004h> # Load data
[?2004l[?2004h> cols=dict(customers=['customer_id','signup_at','plan','postcode_district','last_login_at','_updated_at'],plan_changes=['customer_id','changed_at','old_plan','new_plan','_loaded_at'],scoring_points=['customer_id','as_of','trigger','app_minutes_7d'],orders=['order_id','customer_id','ordered_at','kind','amount_cents','_load_job','_loaded_at'],tickets=['ticket_id','customer_id','opened_at','topic','_loaded_at'],status_snapshots=['customer_id','snapshot_date','status','_loaded_at'],labels=['customer_id','as_of','churned_30d','_loaded_at'])
[?2004l[?2004h> T={k:pd.read_csv(f'{D}/{k}.csv') for k in cols}
[?2004l[?2004h> for k,ts in [('customers',['signup_at','last_login_at','_updated_at']),('plan_changes',['changed_at','_loaded_at']),('scoring_points',['as_of']),('orders',['ordered_at','_loaded_at']),('tickets',['opened_at','_loaded_at']),('status_snapshots',['_loaded_at']),('labels',['as_of','_loaded_at'])]:
[?2004l[?2004h>  for c in ts:T[k][c]=pd.to_datetime(T[k][c],utc=True)
[?2004l[?2004h> T['status_snapshots']['snapshot_date']=pd.to_datetime(T['status_snapshots']['snapshot_date'],utc=True)
[?2004l[?2004h> pts=T['scoring_points'].copy(); p=pts
[?2004l[?2004h> 
[?2004l[?2004h> # Parse committed selected-order intervals from scheduler. These are rows committed to a table with the name in the log.
[?2004l[?2004h> commits=pd.DataFrame(json.loads(s) for s in open(f'{D}/_ops/commits.jsonl'))
[?2004l[?2004h> commits['at']=pd.to_datetime(commits['at'],utc=True)
[?2004l[?2004h> cmap={int(r.txn):r.at for r in commits.itertuples() if r.outcome=='commit'}
[?2004l[?2004h> intervals=[]
[?2004l[?2004h> pat=re.compile(r'^(\S+) legacy_orders run=(\S+) selected orders where ordered_at >= (\S+) and ordered_at < (\S+): (\d+) rows; sent txn (\d+) to commit into (\S+)$')
[?2004l[?2004h> for line in open(f'{D}/_ops/scheduler.log'):
[?2004l[?2004h>  m=pat.match(line)
[?2004l[?2004h>  if m:
[?2004l[?2004h>   at=cmap.get(int(m.group(6)))
[?2004l[?2004h>   if at is not None:
[?2004l[?2004h>    intervals.append((pd.Timestamp(m.group(3)),pd.Timestamp(m.group(4)),at))
[?2004l[?2004h> intervals=pd.DataFrame(intervals,columns=['start','end','at']).sort_values(['start','end','at'])
[?2004l[?2004h> # migration txn: schema transaction has null table, from scheduler transaction id
[?2004l[?2004h> mig=None
[?2004l[?2004h> for line in open(f'{D}/_ops/scheduler.log'):
[?2004l[?2004h>  m=re.search(r'schema_migrations run=\S+ sent txn (\d+) to commit',line)
[?2004l[?2004h>  if m:
[?2004l[?2004h>   tx=int(m.group(1)); r=commits[commits.txn==tx].iloc[0]
[?2004l[?2004h>   if r.outcome=='commit': mig=r.at
[?2004l[?2004h> print('legacy intervals',len(intervals),'first',intervals.iloc[0].to_dict(),'last',intervals.iloc[-1].to_dict(),'migration',mig)
[?2004l[?2004h> # Every pre-migration order is assigned to the committed legacy job interval containing its event timestamp.
[?2004l[?2004h> o=T['orders'].copy()
[?2004l[?2004h> pre=o['ordered_at']<mig
[?2004l[?2004h> starts=intervals.start.to_numpy(dtype='datetime64[ns]'); ends=intervals.end.to_numpy(dtype='datetime64[ns]'); ats=intervals.at.to_numpy(dtype='datetime64[ns]')
[?2004l[?2004h> # rows are event-day non-overlapping; use searchsorted on starts, then validate interval
[?2004l[?2004h> idx=np.searchsorted(starts,o.loc[pre,'ordered_at'].to_numpy(dtype='datetime64[ns]'),side='right')-1
[?2004l[?2004h> vis=o['_loaded_at'].to_numpy(dtype='datetime64[ns]').copy()
[?2004l[?2004h> valid=(idx>=0)&(o.loc[pre,'ordered_at'].to_numpy(dtype='datetime64[ns]')<ends[np.clip(idx,0,len(ends)-1)])
[?2004l[?2004h> vis[pre.to_numpy()]=ats[np.clip(idx,0,len(ats)-1)]
[?2004l[?2004h> # Rows loaded into the replacement before the rename become visible when that table becomes `orders`.
[?2004l[?2004h> vis[pre.to_numpy() & (o['_loaded_at'].to_numpy(dtype='datetime64[ns]')<mig.to_datetime64())]=mig.to_datetime64()
[?2004l[?2004h> o['effective_loaded_at']=pd.Series(vis,index=o.index)
[?2004l[?2004h> print('unmapped',(~valid).sum(),'effective range',pd.Series(vis).min(),pd.Series(vis).max(),'before migration',pre.sum())
[?2004l[?2004h> 
[?2004l[?2004h> # Features
[?2004l[?2004h> customers=T['customers'].set_index('customer_id'); p=p.reset_index(drop=True)
[?2004l[?2004h> out=p[['customer_id','as_of']].copy()
[?2004l[?2004h> # status: latest event snapshot among rows loaded before t
[?2004l[?2004h> def latest_status(points,s):
[?2004l[?2004h>  left=points[['customer_id','as_of']].reset_index(); left['idx']=-1
[?2004l[?2004h>  # per customer merge asof loaded visibility tricky. Use sorted events by loaded, process points by time.
[?2004l[?2004h>  s=s.sort_values('_loaded_at')
[?2004l[?2004h>  res=pd.Series(index=points.index,dtype=object)
[?2004l[?2004h>  for cid, pp in points.groupby('customer_id',sort=False):
[?2004l[?2004h>   ss=s[s.customer_id==cid].sort_values(['snapshot_date','_loaded_at'])
[?2004l[?2004h>   # latest snapshot_date among loaded<t
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for t in pp.as_of:
[?2004l[?2004h>    z=ss[ss._loaded_at<t]
[?2004l[?2004h>    vals.append(z.sort_values('snapshot_date').iloc[-1].status if len(z) else None)
[?2004l[?2004h>   res.loc[pp.index]=vals
[?2004l[?2004h>  return res
[?2004l[?2004h> out['status']=latest_status(p,T['status_snapshots'])
[?2004l[?2004h> # plan via initial old_plan and loaded changes
[?2004l[?2004h> pc=T['plan_changes'].sort_values('_loaded_at')
[?2004l[?2004h> initial=pc.sort_values('changed_at').groupby('customer_id').first()['old_plan']
[?2004l[?2004h> plans={}
[?2004l[?2004h> for cid,g in pc.groupby('customer_id',sort=False):
[?2004l[?2004h>  g=g.sort_values(['changed_at','new_plan'])
[?2004l[?2004h>  plans[cid]=(initial.get(cid),g[['changed_at','new_plan','_loaded_at']].values.tolist())
[?2004l[?2004h> vals=[]
[?2004l[?2004h> for cid,t in zip(p.customer_id,p.as_of):
[?2004l[?2004h>  v=initial.get(cid)
[?2004l[?2004h>  for changed,new,load in plans[cid][1]:
[?2004l[?2004h>   if load<t:v=new
[?2004l[?2004h>  vals.append(v)
[?2004l[?2004h> out['plan']=pd.Series(vals,index=p.index)
[?2004l[?2004h> # app fallback
[?2004l[?2004h> q=p.sort_values(['customer_id','as_of']).copy(); q['app_minutes_7d']=q.groupby('customer_id').app_minutes_7d.ffill(); out['app_minutes_7d']=q.app_minutes_7d.reindex(p.index)
[?2004l[?2004h> # labels: all loaded before t, current immutable districts
[?2004l[?2004h> dis=customers.postcode_district
[?2004l[?2004h> lab=T['labels']; lab['district']=lab.customer_id.map(dis)
[?2004l[?2004h> lab=lab.sort_values('_loaded_at')
[?2004l[?2004h> # direct loops for sample + all? 58k x labels; do vectorized below later. Prototype sample first.
[?2004l[?2004h> # order features loops per point on visible subset
