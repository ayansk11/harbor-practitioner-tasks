[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# cat > churn/visibility.py <<'PY'
[?2004l[?2004h> """Warehouse visibility metadata reconstructed from an extract's `_ops` records.
[?2004l[?2004h> 
[?2004l[?2004h> Append rows normally become visible at their `_loaded_at`, but a table can be replaced by a
[?2004l[?2004h> backfill/rename.  A query reads the table *name* which was current when it started, so rows in the
[?2004l[?2004h> replacement are not visible merely because they were loaded into its old name.
[?2004l[?2004h> """
[?2004l[?2004h> import os
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> _SELECT_RE = re.compile(
[?2004l[?2004h>     r"^\S+ legacy_orders run=\S+ selected orders where ordered_at >= (\S+) "
[?2004l[?2004h>     r"and ordered_at < (\S+): (\d+) rows; sent txn (\d+) to commit into (\S+)$"
[?2004l[?2004h> )
[?2004l[?2004h> _STATEMENT_RE = re.compile(
[?2004l[?2004h>     r"statement:\s*ALTER TABLE\s+([A-Za-z_][A-Za-z0-9_]*)\s+RENAME TO\s+"
[?2004l[?2004h>     r"([A-Za-z_][A-Za-z0-9_]*)\s*$"
[?2004l[?2004h> )
[?2004l[?2004h> _TXN_RE = re.compile(r"schema_migrations run=\S+ sent txn (\d+) to commit")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _committed_transactions(ops_dir):
[?2004l[?2004h>     path = os.path.join(ops_dir, "commits.jsonl")
[?2004l[?2004h>     committed = {}
[?2004l[?2004h>     with open(path, encoding="utf-8") as fh:
[?2004l[?2004h>         for line in fh:
[?2004l[?2004h>             row = json.loads(line)
[?2004l[?2004h>             if row.get("outcome") == "commit" and row.get("at"):
[?2004l[?2004h>                 committed[int(row["txn"])] = pd.to_datetime(row["at"], utc=True)
[?2004l[?2004h>     return committed
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _orders_rename_commit(ops_dir, committed):
[?2004l[?2004h>     """Find the last committed schema transaction which renamed another table to `orders`."""
[?2004l[?2004h>     statements = []
[?2004l[?2004h>     candidates = []
[?2004l[?2004h>     with open(os.path.join(ops_dir, "scheduler.log"), encoding="utf-8") as fh:
[?2004l[?2004h>         for line in fh:
[?2004l[?2004h>             match = _STATEMENT_RE.search(line)
[?2004l[?2004h>             if match:
[?2004l[?2004h>                 statements.append((match.group(1), match.group(2)))
[?2004l[?2004h>                 continue
[?2004l[?2004h>             match = _TXN_RE.search(line)
[?2004l[?2004h>             if match:
[?2004l[?2004h>                 txn = int(match.group(1))
[?2004l[?2004h>                 if any(new_name == "orders" for _old_name, new_name in statements):
[?2004l[?2004h>                     candidates.append((txn, tuple(statements)))
[?2004l[?2004h>                 statements = []
[?2004l[?2004h>     for txn, _statements in reversed(candidates):
[?2004l[?2004h>         at = committed.get(txn)
[?2004l[?2004h>         if at is not None:
[?2004l[?2004h>             return at
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _legacy_intervals(ops_dir, committed, rename_at):
[?2004l[?2004h>     intervals = []
[?2004l[?2004h>     with open(os.path.join(ops_dir, "scheduler.log"), encoding="utf-8") as fh:
[?2004l[?2004h>         for line in fh:
[?2004l[?2004h>             match = _SELECT_RE.match(line.rstrip("\n"))
[?2004l[?2004h>             if not match:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             start, end, selected, txn, table = match.groups()
[?2004l[?2004h>             if table != "orders" or int(selected) == 0:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             at = committed.get(int(txn))
[?2004l[?2004h>             if at is not None and at < rename_at:
[?2004l[?2004h>                 intervals.append((pd.Timestamp(start), pd.Timestamp(end), at))
[?2004l[?2004h>     if not intervals:
[?2004l[?2004h>         return pd.DataFrame(columns=["start", "end", "at"])
[?2004l[?2004h>     result = pd.DataFrame(intervals, columns=["start", "end", "at"])
[?2004l[?2004h>     # A failed transaction was retried.  The first committed selection of an event interval
[?2004l[?2004h>     # is the moment those rows became visible in the old table.
[?2004l[?2004h>     result = result.sort_values(["start", "at"], kind="mergesort")
[?2004l[?2004h>     result = result.drop_duplicates("start", keep="first")
[?2004l[?2004h>     return result
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def order_commit_times(orders, ops_dir):
[?2004l[?2004h>     """Effective commit time of each row of the final `orders` table.
[?2004l[?2004h> 
[?2004l[?2004h>     For rows from a replacement table, this accounts for the time before that table was the one
[?2004l[?2004h>     named `orders`.  Rows selected by the old daily loader use its committed transaction time.
[?2004l[?2004h>     """
[?2004l[?2004h>     visible = orders["_loaded_at"].copy()
[?2004l[?2004h>     rename_at = _orders_rename_commit(ops_dir, _committed_transactions(ops_dir))
[?2004l[?2004h>     if rename_at is None:
[?2004l[?2004h>         return visible
[?2004l[?2004h> 
[?2004l[?2004h>     intervals = _legacy_intervals(ops_dir, _committed_transactions(ops_dir), rename_at)
[?2004l[?2004h>     loaded = orders["_loaded_at"].to_numpy(dtype="datetime64[ns]")
[?2004l[?2004h>     ordered = orders["ordered_at"].to_numpy(dtype="datetime64[ns]")
[?2004l[?2004h>     rename = rename_at.to_datetime64()
[?2004l[?2004h>     pre_rename = ordered < rename
[?2004l[?2004h> 
[?2004l[?2004h>     if intervals.empty:
[?2004l[?2004h>         visible.iloc[pre_rename] = np.maximum(loaded[pre_rename], rename)
[?2004l[?2004h>         return pd.to_datetime(visible, utc=True)
[?2004l[?2004h> 
[?2004l[?2004h>     starts = intervals["start"].to_numpy(dtype="datetime64[ns]")
[?2004l[?2004h>     ends = intervals["end"].to_numpy(dtype="datetime64[ns]")
[?2004l[?2004h>     commit = intervals["at"].to_numpy(dtype="datetime64[ns]")
[?2004l[?2004h>     pos = np.searchsorted(starts, ordered[pre_rename], side="right") - 1
[?2004l[?2004h>     clipped = np.clip(pos, 0, len(starts) - 1)
[?2004l[?2004h>     known = (pos >= 0) & (ordered[pre_rename] < ends[clipped])
[?2004l[?2004h>     old_commit = commit[clipped]
[?2004l[?2004h>     replacement_commit = np.maximum(loaded[pre_rename], rename)
[?2004l[?2004h>     visible.iloc[pre_rename] = np.where(known, old_commit, replacement_commit)
[?2004l[?2004h>     return pd.to_datetime(visible, utc=True)
[?2004l[?2004h> PY
[?2004l[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# 
[?2004l[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# cat > churn/windows.py <<'PY'
[?2004l[?2004h> """Point-in-time order and ticket features."""
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> EPOCH = pd.Timestamp("1970-01-01", tz="UTC")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _seconds(values):
[?2004l[?2004h>     return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _timestamp(value):
[?2004l[?2004h>     return value.to_datetime64()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def activity_features(points, orders, tickets):
[?2004l[?2004h>     """Live order/ticket values using only rows committed before each prediction."""
[?2004l[?2004h>     n = len(points)
[?2004l[?2004h>     orders_7d = np.zeros(n, dtype="int64")
[?2004l[?2004h>     orders_30d = np.zeros(n, dtype="int64")
[?2004l[?2004h>     spend = np.zeros(n, dtype="int64")
[?2004l[?2004h>     tickets_30d = np.zeros(n, dtype="int64")
