[?2004hroot@42ee24c8-046d-4801-92a5-bb933463bfe0:/app# python3 - <<'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> from collections import Counter,defaultdict
[?2004l[?2004h> L=open('data/_ops/scheduler.log').read().splitlines()
[?2004l[?2004h> print('total',len(L))
[?2004l[?2004h> # Categorize by job, then state/description; preserve unusual texts.
[?2004l[?2004h> by=defaultdict(list)
[?2004l[?2004h> for s in L:
[?2004l[?2004h>  m=re.match(r'^(\S+) (\w+) (.*)$',s)
[?2004l[?2004h>  if not m: print('MALFORMED',s); continue
[?2004l[?2004h>  by[m.group(2)].append(s)
[?2004l[?2004h> for j,xs in by.items():
[?2004l[?2004h>  print('\nJOB',j,'count',len(xs),'first',xs[0],'last',xs[-1])
[?2004l[?2004h>  kinds=Counter()
[?2004l[?2004h>  unusual=[]
[?2004l[?2004h>  for s in xs:
[?2004l[?2004h>   body=s.split(' ',2)[2]
[?2004l[?2004h>   if ' state=success' in s: kinds['success']+=1
[?2004l[?2004h>   elif ' state=running' in s: kinds['running']+=1
[?2004l[?2004h>   elif ' selected orders' in s: kinds['order-selected']+=1
[?2004l[?2004h>   elif ' wrote ' in s and 'sent txn' in s: kinds['wrote-txn']+=1
[?2004l[?2004h>   elif ' wrote ' in s: kinds['wrote']+=1
[?2004l[?2004h>   elif ' sent txn' in s: kinds['txn']+=1
[?2004l[?2004h>   elif ' state=' in s: kinds[body.split('state=',1)[1].split()[0]]+=1
[?2004l[?2004h>   else: kinds['other']+=1; unusual.append(s)
[?2004l[?2004h>  print(dict(kinds))
[?2004l[?2004h>  print('unusual first 30:')
[?2004l[?2004h>  for s in unusual[:30]: print(' ',s)
[?2004l[?2004h> PY
