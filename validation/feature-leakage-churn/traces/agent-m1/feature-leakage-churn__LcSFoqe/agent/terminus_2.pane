[?2004l_id.map(customers.postcode_district)
cid,t=100012,pd.Timestamp('2026-01-12T06:00:00Z'); d=customers.loc[cid,'postcode_district']
all_d=pd.concat([labels.district,pd.Series([d])],ignore_index=True); codes=all_d.astype('category').cat.codes.to_numpy(dtype='int64'); lc=codes[:-1]; pc=codes[-1]
loaded=_seconds(labels._loaded_at); key=lc.astype('int64')*STRIDE+loaded; pk=int(pc)*STRIDE+sec(pd.Series([t]))[0]
pos=np.searchsorted(np.sort(key),pk,side='left')
print('\nencoding d',repr(d),'code',pc,'lab code range',lc.min(),lc.max(),'unique',len(np.unique(lc)))
print('point key',pk,'search pos',pos,'matching keys',np.sum(key==pk),'key min/max',key.min(),key.max())
# show keys around desired district by sorting with key
o=np.argsort(key,kind='mergesort'); ii=np.flatnonzero(lc[o]==pc)
print('district sorted range',ii[:1],ii[-1:],'keys',key[o][ii[:3]],key[o][ii[-3:]])
print('point code map back',all_d.astype('category').cat.categories[pc])
