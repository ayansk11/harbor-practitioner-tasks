[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from churn.extract import load_extract
[?2004l[?2004h> from churn.status import latest_status
[?2004l[?2004h> from churn.encoding import _seconds
[?2004l[?2004h> T=load_extract('/app/data')
[?2004l[?2004h> pts=pd.DataFrame({'customer_id':[100220,101169],'as_of':pd.to_datetime(['2026-01-06T06:00:00Z','2026-01-07T06:00:00Z'],utc=True)})
[?2004l[?2004h> print('status helper',latest_status(pts,T['status_snapshots']).tolist())
[?2004l[?2004h> 
[?2004l[?2004h> # Reproduce status internals
[?2004l[?2004h> s=T['status_snapshots']; points=pts
[?2004l[?2004h> EPOCH=pd.Timestamp('1970-01-01',tz='UTC'); STRIDE=10**10
[?2004l[?2004h> def sec(v): return ((v-EPOCH)//pd.Timedelta(seconds=1)).to_numpy(dtype='int64')
[?2004l[?2004h> event=s.snapshot_date.to_numpy(dtype='datetime64[ns]').astype('int64'); loaded=sec(s._loaded_at); customer=s.customer_id.to_numpy(dtype='int64'); key=customer*STRIDE+loaded
[?2004l[?2004h> order=np.argsort(key,kind='mergesort'); customer_s=customer[order]; event_s=event[order]; status_s=s.status.to_numpy(dtype=object)[order]
[?2004l[?2004h> running=np.empty(len(event_s),dtype=event_s.dtype); prev=None; cur=None
[?2004l[?2004h> for i,(cid,val) in enumerate(zip(customer_s,event_s)):
[?2004l[?2004h>  if cid!=prev: cur=val; prev=cid
[?2004l[?2004h>  elif val>cur: cur=val
[?2004l[?2004h>  running[i]=cur
[?2004l[?2004h> boundary=np.r_[True,customer_s[1:]!=customer_s[:-1]]
[?2004l[?2004h> changed=boundary | np.r_[False,running[1:]!=running[:-1]]
[?2004l[?2004h> best=pd.Series(status_s).where(changed).ffill().to_numpy(dtype=object)
[?2004l[?2004h> for cid,t in zip(points.customer_id,points.as_of):
[?2004l[?2004h>  pk=int(cid)*STRIDE+sec(pd.Series([t]))[0]; pos=np.searchsorted(key,pk,side='left')
[?2004l[?2004h>  print('point',cid,'key',pk,'pos',pos,'insert key neighbors',key[max(0,pos-2):pos+2], 'best around',best[max(0,pos-2):pos+2])
[?2004l[?2004h>  # customer rows in sorted order
[?2004l[?2004h>  loc=np.flatnonzero(customer_s==cid)
[?2004l[?2004h>  print('customer sorted load/date/status/max/boundary/changed/best')
[?2004l[?2004h>  print(pd.DataFrame({'loaded':loaded[order][loc],'date':event_s[loc],'status':status_s[loc],'max':running[loc],'boundary':boundary[loc],'changed':changed[loc],'best':best[loc]}).to_string(index=False))
[?2004l[?2004h> 
