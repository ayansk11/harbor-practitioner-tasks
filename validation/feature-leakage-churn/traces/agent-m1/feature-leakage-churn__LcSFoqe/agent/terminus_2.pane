[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def district_encoding(points, labels, customers, m=20):
[?2004l[?2004h>     """Reproduce the live SQL using label rows committed before each prediction."""
[?2004l[?2004h>     districts = customers.set_index("customer_id")["postcode_district"]
[?2004l[?2004h>     lab = labels.copy()
[?2004l[?2004h>     lab["postcode_district"] = lab["customer_id"].map(districts)
[?2004l[?2004h>     lab = lab[lab["postcode_district"].notna()].copy().reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h>     all_districts = pd.concat(
[?2004l[?2004h>         [lab["postcode_district"], points["customer_id"].map(districts)], ignore_index=True
[?2004l[?2004h>     )
[?2004l[?2004h>     codes = all_districts.astype("category").cat.codes.to_numpy(dtype="int64")
[?2004l[?2004h>     lab_codes = codes[:len(lab)]
[?2004l[?2004h>     point_codes = codes[len(lab):]
[?2004l[?2004h> 
[?2004l[?2004h>     y = pd.to_numeric(lab["churned_30d"], errors="coerce").to_numpy(dtype="float64")
[?2004l[?2004h>     y_filled = np.nan_to_num(y, nan=0.0)
[?2004l[?2004h>     raw_sum = np.cumsum(y_filled)
[?2004l[?2004h>     raw_rows = np.arange(1, len(lab) + 1, dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h>     loaded = _seconds(lab["_loaded_at"])
[?2004l[?2004h> 
[?2004l[?2004h>     # Global prior from all label rows visible at the prediction time.
[?2004l[?2004h>     global_order = np.argsort(loaded, kind="mergesort")
[?2004l[?2004h>     global_load = loaded[global_order]
[?2004l[?2004h>     global_sum = raw_sum[global_order]
[?2004l[?2004h>     global_rows = raw_rows[global_order]
[?2004l[?2004h> 
[?2004l[?2004h>     # District statistics are cumulative only within that district.
[?2004l[?2004h>     key = lab_codes.astype("int64") * STRIDE + loaded
[?2004l[?2004h>     order = np.argsort(key, kind="mergesort")
[?2004l[?2004h>     district_key = key[order]
[?2004l[?2004h>     district_order = lab_codes[order]
[?2004l[?2004h>     boundaries = np.r_[True, district_order[1:] != district_order[:-1]]
[?2004l[?2004h>     starts = np.flatnonzero(boundaries)
[?2004l[?2004h>     previous_start = np.maximum(starts - 1, -1)
[?2004l[?2004h>     group_start_for_row = np.repeat(starts, np.diff(np.r_[starts, len(lab)]))
[?2004l[?2004h>     previous_before_group = np.where(group_start_for_row == 0, -1, group_start_for_row - 1)
[?2004l[?2004h>     district_sum = raw_sum[order] - np.where(previous_before_group >= 0, raw_sum[order][previous_before_group], 0.0)
[?2004l[?2004h>     district_rows = raw_rows[order] - np.where(previous_before_group >= 0, raw_rows[order][previous_before_group], 0)
[?2004l[?2004h> 
