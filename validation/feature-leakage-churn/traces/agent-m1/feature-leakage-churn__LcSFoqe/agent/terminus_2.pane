[?2004l     1	"""Point-in-time smoothed district target encoding."""
     2	import numpy as np
     3	import pandas as pd
     4	
     5	EPOCH = pd.Timestamp("1970-01-01", tz="UTC")
     6	STRIDE = 10 ** 10
     7	
     8	
     9	def _seconds(values):
    10	    return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype="int64")
    11	
    12	
    13	def district_encoding(points, labels, customers, m=20):
    14	    """Reproduce the live SQL using label rows committed before each prediction."""
    15	    districts = customers.set_index("customer_id")["postcode_district"]
    16	    lab = labels.copy()
    17	    lab["postcode_district"] = lab["customer_id"].map(districts)
    18	    lab = lab[lab["postcode_district"].notna()].copy().reset_index(drop=True)
    19	
    20	    all_districts = pd.concat(
    21	        [lab["postcode_district"], points["customer_id"].map(districts)], ignore_index=True
    22	    )
    23	    codes = all_districts.astype("category").cat.codes.to_numpy(dtype="int64")
    24	    lab_codes = codes[:len(lab)]
    25	    point_codes = codes[len(lab):]
    26	
    27	    y = pd.to_numeric(lab["churned_30d"], errors="coerce").to_numpy(dtype="float64")
    28	    valid = ~np.isnan(y)
    29	    y_filled = np.nan_to_num(y, nan=0.0)
    30	    rows = np.arange(1, len(lab) + 1, dtype="int64")
    31	
    32	    # Global prior: all label rows visible to the query at time t.
    33	    loaded = _seconds(lab["_loaded_at"])
    34	    global_order = np.argsort(loaded, kind="mergesort")
    35	    global_load = loaded[global_order]
    36	    global_sum = np.cumsum(y_filled[global_order])
    37	    global_rows = rows[global_order]
    38	    global_seen = np.cumsum(valid[global_order]).astype("int64")
    39	
    40	    # District statistics: cumulative values reset at each district group.
    41	    key = lab_codes.astype("int64") * STRIDE + loaded
    42	    order = np.argsort(key, kind="mergesort")
    43	    district_key = key[order]
    44	    district_codes = lab_codes[order]
    45	    starts = np.flatnonzero(np.r_[True, district_codes[1:] != district_codes[:-1]])
    46	    group_ends = np.r_[starts[1:], len(lab)]
    47	    group_start_sum = np.where(starts == 0, 0.0, np.cumsum(y_filled[order])[starts - 1])
    48	    group_start_rows = np.where(starts == 0, 0, rows[order][starts - 1])
    49	    cumulative_sum = np.cumsum(y_filled[order])
    50	    cumulative_rows = rows[order]
    51	    district_sum = cumulative_sum - np.repeat(group_start_sum, group_ends - starts)
    52	    cumulative_count = np.arange(1, len(lab) + 1, dtype="int64")
    53	    district_rows = cumulative_count - np.repeat(group_start_rows, group_ends - starts)
    54	
    55	    t = _seconds(points["as_of"])
    56	    gp = np.searchsorted(global_load, t, side="left")
    57	    global_n = np.where(gp > 0, global_rows[np.maximum(gp - 1, 0)], 0)
    58	    global_s = np.where(gp > 0, global_sum[np.maximum(gp - 1, 0)], 0.0)
    59	    global_count = np.where(gp > 0, global_seen[np.maximum(gp - 1, 0)], 0)
    60	    prior = np.full(len(points), 0.05, dtype="float64")
    61	    has_prior = global_count > 0
    62	    prior[has_prior] = global_s[has_prior] / global_count[has_prior]
    63	
    64	    point_key = point_codes.astype("int64") * STRIDE + t
    65	    hp = np.searchsorted(district_key, point_key, side="left")
    66	    n = np.where(hp > 0, district_rows[np.maximum(hp - 1, 0)], 0)
    67	    s = np.where(hp > 0, district_sum[np.maximum(hp - 1, 0)], 0.0)
    68	    return pd.Series((s + m * prior) / (n + m), index=points.index, dtype="float64")
