[?2004l[?2004h> """Latest account status visible to the live warehouse query."""
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> EPOCH = pd.Timestamp("1970-01-01", tz="UTC")
[?2004l[?2004h> STRIDE = 10 ** 10
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _seconds(values):
[?2004l[?2004h>     return ((values - EPOCH) // pd.Timedelta(seconds=1)).to_numpy(dtype="int64")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def latest_status(points, snapshots):
[?2004l[?2004h>     """Snapshot with the latest date among rows whose load committed before each prediction."""
[?2004l[?2004h>     event = snapshots["snapshot_date"].to_numpy(dtype="datetime64[ns]").astype("int64")
[?2004l[?2004h>     loaded = _seconds(snapshots["_loaded_at"])
[?2004l[?2004h>     customer = snapshots["customer_id"].to_numpy(dtype="int64")
[?2004l[?2004h>     key = customer * STRIDE + loaded
[?2004l[?2004h>     order = np.argsort(key, kind="mergesort")
[?2004l[?2004h>     customer = customer[order]
[?2004l[?2004h>     event = event[order]
[?2004l[?2004h>     status = snapshots["status"].to_numpy(dtype=object)[order]
[?2004l[?2004h> 
[?2004l[?2004h>     # The best status is a running maximum of snapshot date, resetting for each customer.
[?2004l[?2004h>     running_max = np.empty(len(event), dtype=event.dtype)
[?2004l[?2004h>     previous = None
[?2004l[?2004h>     current_max = None
[?2004l[?2004h>     for i, (cid, value) in enumerate(zip(customer, event)):
[?2004l[?2004h>         if cid != previous:
[?2004l[?2004h>             current_max = value
[?2004l[?2004h>             previous = cid
[?2004l[?2004h>         elif value > current_max:
[?2004l[?2004h>             current_max = value
[?2004l[?2004h>         running_max[i] = current_max
[?2004l[?2004h>     changed = np.r_[True, running_max[1:] != running_max[:-1]]
[?2004l[?2004h>     best_status = pd.Series(status).where(changed).ffill().to_numpy(dtype=object)
[?2004l[?2004h> 
[?2004l[?2004h>     point_key = points["customer_id"].to_numpy(dtype="int64") * STRIDE + _seconds(points["as_of"])
[?2004l[?2004h>     pos = np.searchsorted(key, point_key, side="left")
[?2004l[?2004h>     result = np.full(len(points), None, dtype=object)
[?2004l[?2004h>     known = pos > 0
[?2004l[?2004h>     result[known] = best_status[pos[known] - 1]
[?2004l[?2004h>     return pd.Series(result, index=points.index, dtype="object")
