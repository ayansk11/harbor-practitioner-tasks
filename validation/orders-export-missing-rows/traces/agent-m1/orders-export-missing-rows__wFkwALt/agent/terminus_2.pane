     1	"""API tests for the orders service (run from /app: python -m pytest -q tests).
     2	
     3	Each test builds a small database in a temporary folder and talks to the app through Flask's test client."""
     4	import sqlite3
     5	
     6	import pytest
     7	
     8	from orders_service import create_app
     9	
    10	SCHEMA = """
    11	CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, segment TEXT NOT NULL,
    12	                        created_at TEXT NOT NULL);
    13	CREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id),
    14	                     created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL,
    15	                     currency TEXT NOT NULL, channel TEXT NOT NULL);
    16	CREATE INDEX orders_created_at ON orders(created_at);
    17	CREATE INDEX orders_customer ON orders(customer_id, created_at);
    18	"""
    19	
    20	
    21	def make_db(path, n_orders=57):
    22	    con = sqlite3.connect(path)
    23	    con.executescript(SCHEMA)
    24	    con.executemany("INSERT INTO customers VALUES (?, ?, ?, ?, ?)",
    25	                    [(c, f"Customer {c}", f"c{c}@example.org", "retail", "2025-01-01T00:00:00Z") for c in (1, 2, 3)])
    26	    rows = []
    27	    for i in range(1, n_orders + 1):
    28	        minute, second = divmod(i * 7, 60)
    29	        rows.append((i, 1 + i % 2, f"2026-03-01T10:{minute:02d}:{second:02d}Z", "paid", 1000 + i, "USD", "web"))
    30	    con.executemany("INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?, ?)", rows)
    31	    con.commit()
    32	    con.close()
    33	    return rows
    34	
    35	
    36	@pytest.fixture()
    37	def client(tmp_path):
    38	    db = tmp_path / "orders.db"
    39	    make_db(db)
    40	    return create_app(str(db)).test_client()
    41	
    42	
    43	def walk(client, path, limit):
    44	    out, cursor = [], None
    45	    for _ in range(1000):
    46	        q = {"limit": limit} if cursor is None else {"limit": limit, "cursor": cursor}
    47	        body = client.get(path, query_string=q).get_json()
    48	        out += body["orders"]
    49	        cursor = body["next_cursor"]
    50	        if cursor is None:
    51	            return out
    52	    raise AssertionError("too many pages")
    53	
    54	
    55	def test_count(client):
    56	    assert client.get("/orders/count").get_json() == {"count": 57}
    57	
    58	
    59	def test_get_order(client):
    60	    assert client.get("/orders/5").get_json() == {"id": 5, "customer_id": 2, "created_at": "2026-03-01T10:00:35Z",
    61	                                                  "status": "paid", "total_cents": 1005, "currency": "USD"}
    62	    assert client.get("/orders/999").status_code == 404
    63	
    64	
    65	def test_first_page_newest_first(client):
    66	    body = client.get("/orders").get_json()
    67	    assert [o["id"] for o in body["orders"]] == list(range(57, 0, -1))
    68	    assert body["next_cursor"] is None
