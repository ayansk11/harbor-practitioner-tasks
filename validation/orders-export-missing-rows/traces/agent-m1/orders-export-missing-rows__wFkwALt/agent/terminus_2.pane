     1	"""Queries behind the customer views (account page, support tool)."""
     2	from .db import ORDER_COLUMNS
     3	from .pagination import encode_cursor
     4	
     5	
     6	def customer_exists(con, customer_id):
     7	    return con.execute("SELECT 1 FROM customers WHERE id = ?", (customer_id,)).fetchone() is not None
     8	
     9	
    10	def customer_orders_page(con, customer_id, limit, cursor):
    11	    """One page of a customer's orders, newest first. Returns (rows, next_cursor).
    12	
    13	    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index
    14	    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112)."""
    15	    sql = f"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?"
    16	    args = [customer_id]
    17	    if cursor is not None:
    18	        sql += " AND created_at < ?"
    19	        args.append(cursor.created_at)
    20	    sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
    21	    args.append(limit)
    22	    rows = con.execute(sql, args).fetchall()
    23	    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None
    24	    return rows, next_cursor
===== db.py =====
     1	"""One SQLite connection per request. Other systems (checkout, the POS sync, back-office imports) write to the same
     2	database file, so the API never caches rows: every request reads what is committed at that moment."""
     3	import sqlite3
     4	
     5	from flask import current_app, g
     6	
     7	ORDER_FIELDS = ("id", "customer_id", "created_at", "status", "total_cents", "currency")
     8	ORDER_COLUMNS = ", ".join(ORDER_FIELDS)
     9	
    10	
    11	def get_db():
    12	    if "db" not in g:
    13	        con = sqlite3.connect(current_app.config["DATABASE"], timeout=10)
    14	        con.row_factory = sqlite3.Row
    15	        g.db = con
    16	    return g.db
    17	
    18	
    19	def close_db(_exc=None):
    20	    con = g.pop("db", None)
    21	    if con is not None:
    22	        con.close()
    23	
    24	
    25	def order_json(row):
    26	    return {name: row[name] for name in ORDER_FIELDS}
===== __main__.py =====
     1	"""Start the orders API: python -m orders_service --db data/orders.db --port 8080"""
     2	import argparse
     3	import os
     4	
     5	from waitress import serve
     6	
     7	from .app import create_app
     8	
     9	
    10	def main():
    11	    parser = argparse.ArgumentParser(prog="python -m orders_service", description=__doc__)
    12	    parser.add_argument("--db", required=True, help="path to the SQLite orders database")
    13	    parser.add_argument("--host", default="127.0.0.1")
    14	    parser.add_argument("--port", type=int, default=8080)
    15	    parser.add_argument("--threads", type=int, default=4)
    16	    args = parser.parse_args()
    17	    if not os.path.isfile(args.db):
    18	        parser.error(f"database not found: {args.db}")
    19	    app = create_app(os.path.abspath(args.db))
    20	    serve(app, host=args.host, port=args.port, threads=args.threads, ident="orders-api")
    21	
    22	
    23	if __name__ == "__main__":
    24	    main()
===== export_orders.py =====
     1	"""Nightly finance export: page through GET /orders and write one CSV row per order.
     2	
     3	    python tools/export_orders.py --base http://127.0.0.1:8080 --limit 200 --out /tmp/orders.csv [--log export.log]
     4	
     5	Runs from cron at 02:00 UTC against production. It only follows next_cursor; it never builds cursors itself.
     6	"""
     7	import argparse
     8	import csv
     9	import datetime as dt
    10	import json
    11	import sys
    12	import urllib.parse
    13	import urllib.request
    14	
    15	FIELDS = ["id", "customer_id", "created_at", "status", "total_cents", "currency"]
    16	
    17	
    18	def now():
    19	    t = dt.datetime.now(dt.timezone.utc)
    20	    return t.strftime("%Y-%m-%dT%H:%M:%S.") + f"{t.microsecond // 1000:03d}Z"
    21	
    22	
    23	def get(base, path, params=None):
    24	    url = base.rstrip("/") + path + ("?" + urllib.parse.urlencode(params) if params else "")
    25	    with urllib.request.urlopen(url, timeout=60) as resp:
    26	        return resp.status, json.load(resp)
    27	
    28	
    29	def main():
    30	    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    31	    ap.add_argument("--base", default="http://127.0.0.1:8080")
    32	    ap.add_argument("--limit", type=int, default=200)
    33	    ap.add_argument("--out", required=True)
    34	    ap.add_argument("--log", help="append the request log here (default: stderr)")
    35	    args = ap.parse_args()
    36	    log = open(args.log, "a") if args.log else sys.stderr
    37	    print(f"# export_orders.py started {now()} base={args.base} limit={args.limit} out={args.out}", file=log)
    38	    status, body = get(args.base, "/orders/count")
    39	    total = body["count"]
    40	    print(f"{now()} GET /orders/count {status} count={total}", file=log)
    41	    rows = pages = 0
    42	    cursor = None
    43	    with open(args.out, "w", newline="") as f:
    44	        w = csv.writer(f)
    45	        w.writerow(FIELDS)
    46	        while True:
    47	            params = {"limit": args.limit}
    48	            if cursor is not None:
    49	                params["cursor"] = cursor
    50	            status, body = get(args.base, "/orders", params)
    51	            pages += 1
    52	            for o in body["orders"]:
    53	                w.writerow([o[k] for k in FIELDS])
    54	            rows += len(body["orders"])
    55	            shown = "/orders?" + "&".join(f"{k}={v}" for k, v in params.items())
    56	            print(f"{now()} GET {shown} {status} rows={len(body['orders'])} next_cursor={body['next_cursor'] or 'null'}",
    57	                  file=log)
    58	            cursor = body["next_cursor"]
    59	            if cursor is None:
    60	                break
    61	    print(f"# done {now()}: {rows} rows written, {pages} pages, count at start was {total}", file=log)
    62	    if log is not sys.stderr:
    63	        log.close()
    64	
    65	
    66	if __name__ == "__main__":
    67	    main()
