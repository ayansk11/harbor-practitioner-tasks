[383.267456, "o", "===== tests 1-140 =====\r\n"]
[383.268969, "o", "\"\"\"API tests for the orders service (run from /app: python -m pytest -q tests).\r\n\r\nEach test builds a small database in a temporary folder and talks to the app through Flask's test client.\"\"\"\r\nimport sqlite3\r\n\r\nimport pytest\r\n\r\n"]
[383.269019, "o", "from orders_service import create_app\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, segment TEXT NOT NULL,\r\n                        created_at TEXT NOT NULL);\r\nCREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id),\r\n                     created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL,\r\n                     currency TEXT NOT NULL, channel TEXT NOT NULL);\r\n"]
[383.269054, "o", "CREATE INDEX orders_created_at ON orders(created_at);\r\nCREATE INDEX orders_customer ON orders(customer_id, created_at);\r\n\"\"\"\r\n\r\n\r\ndef make_db(path, n_orders=57):\r\n    con = sqlite3.connect(path)\r\n    con.executescript(SCHEMA)\r\n    con.executemany(\"INSERT INTO customers VALUES (?, ?, ?, ?, ?)\",\r\n                    [(c, f\"Customer {c}\", f\"c{c}@example.org\", \"retail\", \"2025-01-01T00:00:00Z\") for c in (1, 2, 3)])\r\n    rows = []\r\n    for i in range(1, n_orders + 1):\r\n        minute, second = divmod(i * 7, 60)\r\n        rows.append((i, 1 + i % 2, f\"2026-03-01T10:{minute:02d}:{second:02d}Z\", \"paid\", 1000 + i, \"USD\", \"web\"))\r\n    con.executemany(\"INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?, ?)\", rows)\r\n    con.commit()\r\n    con.close()\r\n    return rows\r\n\r\n\r\n@pytest.fixture()\r\ndef client(tmp_path):\r\n    db = tmp_path / \"orders.db\"\r\n    make_db(db)\r\n    return create_app(str(db)).test_client()\r\n\r\n\r\ndef walk(client, path, limit):\r\n    out, cursor = [], None\r\n    for _ in range(1000):\r\n        q = {\"limit\": limit} if cur"]
[383.269089, "o", "sor is None else {\"limit\": limit, \"cursor\": cursor}\r\n        body = client.get(path, query_string=q).get_json()\r\n        out += body[\"orders\"]\r\n        cursor = body[\"next_cursor\"]\r\n        if cursor is None:\r\n            return out\r\n    raise AssertionError(\"too many pages\")\r\n\r\n\r\ndef test_count(client):\r\n    assert client.get(\"/orders/count\").get_json() == {\"count\": 57}\r\n\r\n\r\ndef test_get_order(client):\r\n    assert client.get(\"/orders/5\").get_json() == {\"id\": 5, \"customer_id\": 2, \"created_at\": \"2026-03-01T10:00:35Z\",\r\n                                                  \"status\": \"paid\", \"total_cents\": 1005, \"currency\": \"USD\"}\r\n    assert client.get(\"/orders/999\").status_code == 404\r\n"]
[383.269122, "o", "\r\n\r\ndef test_first_page_newest_first(client):\r\n    body = client.get(\"/orders\").get_json()\r\n    assert [o[\"id\"] for o in body[\"orders\"]] == list(range(57, 0, -1))\r\n    assert body[\"next_cursor\"] is None\r\n\r\n\r\n@pytest.mark.parametrize(\"limit\", [1, 5, 10, 57, 100])\r\ndef test_walk_returns_every_order_once(client, limit):\r\n"]
[383.269146, "o", "    ids = [o[\"id\"] for o in walk(client, \"/orders\", limit)]\r\n    assert ids == list(range(57, 0, -1))\r\n\r\n\r\ndef test_customer_orders(client):\r\n    ids = [o[\"id\"] for o in walk(client, \"/customers/1/orders\", 4)]\r\n    assert ids == [i for i in range(57, 0, -1) if i % 2 == 0]\r\n    assert client.get(\"/customers/3/orders\").get_json() == {\"orders\": [], \"next_cursor\": None}\r\n    assert client.get(\"/customers/42/orders\").status_code == 404\r\n\r\n"]
[383.269163, "o", "\r\n@pytest.mark.parametrize(\"query\", [\"limit=0\", \"limit=501\", \"limit=-1\", \"limit=ten\", \"cursor=not-a-cursor\"])\r\ndef test_bad_parameters(client, query):\r\n    assert client.get(f\"/orders?{query}\").status_code == 400\r\n"]
[383.269362, "o", "===== export 1-140 =====\r\n"]
[383.27061, "o", "\"\"\"Nightly finance export: page through GET /orders and write one CSV row per order.\r\n\r\n    python tools/export_orders.py --base http://127.0.0.1:8080 --limit 200 --out /tmp/orders.csv [--log export.log]\r\n\r\nRuns from cron at 02:00 UTC against production. It only follows next_cursor; it never builds cursors itself.\r\n\"\"\"\r\n"]
[383.270649, "o", "import argparse\r\nimport csv\r\nimport datetime as dt\r\nimport json\r\nimport sys\r\nimport urllib.parse\r\n"]
[383.270702, "o", "import urllib.request\r\n\r\nFIELDS = [\"id\", \"customer_id\", \"created_at\", \"status\", \"total_cents\", \"currency\"]\r\n\r\n\r\ndef now():\r\n    t = dt.datetime.now(dt.timezone.utc)\r\n    return t.strftime(\"%Y-%m-%dT%H:%M:%S.\") + f\"{t.microsecond // 1000:03d}Z\"\r\n\r\n\r\ndef get(base, path, params=None):\r\n    url = base.rstrip(\"/\") + path + (\"?\" + urllib.parse.urlencode(params) if params else \"\")\r\n    with urllib.request.urlopen(url, timeout=60) as resp:\r\n        return resp.status, json.load(resp)\r\n\r\n\r\ndef main():\r\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    ap.add_argument(\"--base\", default=\"http://127.0.0.1:8080\")\r\n    ap.add_argument(\"--limit\", type=int, default=200)\r\n    ap.add_argument(\"--out\", required=True)\r\n"]
[383.270735, "o", "    ap.add_argument(\"--log\", help=\"append the request log here (default: stderr)\")\r\n    args = ap.parse_args()\r\n    log = open(args.log, \"a\") if args.log else sys.stderr\r\n    print(f\"# export_orders.py started {now()} base={args.base} limit={args.limit} out={args.out}\", file=log)\r\n    status, body = get(args.base, \"/orders/count\")\r\n    total = body[\"count\"]\r\n    print(f\"{now()} GET /orders/count {status} count={total}\", file=log)\r\n    rows = pages = 0\r\n    cursor = None\r\n    with open(args.out, \"w\", newline=\"\") as f:\r\n        w = csv.writer(f)\r\n"]
[383.270767, "o", "        w.writerow(FIELDS)\r\n        while True:\r\n            params = {\"limit\": args.limit}\r\n            if cursor is not None:\r\n                params[\"cursor\"] = cursor\r\n            status, body = get(args.base, \"/orders\", params)\r\n            pages += 1\r\n            for o in body[\"orders\"]:\r\n                w.writerow([o[k] for k in FIELDS])\r\n            rows += len(body[\"orders\"])\r\n            shown = \"/orders?\" + \"&\".join(f\"{k}={v}\" for k, v in params.items())\r\n            print(f\"{now()} GET {shown} {status} rows={len(body['orders'])} next_cursor={body['next_cursor'] or 'null'}\",\r\n                  file=log)\r\n            cursor = body[\"next_cursor\"]\r\n            if cursor is None:\r\n                break\r\n    print(f\"# done {now()}: {rows} rows written, {pages} pages, count at start was {total}\", file=log)\r\n    if log is not sys.stderr:\r\n"]
[383.270803, "o", "        log.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[383.271035, "o", "\u001b[?2004h"]
[383.271063, "o", "root@ee148197-bdef-4f9a-a33b-e21fbf214eb5:/app# "]
[384.155193, "i", "python - <<'PY'\nimport sqlite3, time\ncon=sqlite3.connect('file:/app/data/orders.db?mode=ro', uri=True)\ncursor=('2026-01-01T00:00:00Z', 123456)\ncases = [\n ('global row value', \"SELECT id FROM orders WHERE (created_at,id) < (?,?) ORDER BY created_at DESC,id DESC LIMIT 200\", ('2026-01-01T00:00:00Z',123456)),\n ('global constrained OR', \"SELECT id FROM orders WHERE created_at <= ? AND (created_at < ? OR (created_at=? AND id<?)) ORDER BY created_at DESC,id DESC LIMIT 200\", ('2026-01-01T00:00:00Z','2026-01-01T00:00:00Z',123456)),\n ('customer row value', \"SELECT id FROM orders INDEXED BY orders_customer WHERE customer_id=? AND (created_at,id) < (?,?) ORDER BY created_at DESC,id DESC LIMIT 20\", (3649,'2026-01-01T00:00:00Z',123456)),\n ('customer constrained OR', \"SELECT id FROM orders INDEXED BY orders_customer WHERE customer_id=? AND created_at<=? AND (created_at<? OR (created_at=? AND id<?)) ORDER BY created_at DESC,id DESC LIMIT 20\", (3649,'2026-01-01T00:00:00Z','2026-01-01T00:00:00Z',123456)),\n]\nfor name,sql,args i"]
[384.155226, "i", "n cases:\n    print('\\n--',name)\n    for row in con.execute('EXPLAIN QUERY PLAN '+sql,args): print(row)\n    start=time.perf_counter(); total=0\n    for _ in range(100): total += len(con.execute(sql,args).fetchall())\n    print('100 executions:', round(time.perf_counter()-start,4),'seconds, rows',total)\ncon.close()\nPY\n"]
