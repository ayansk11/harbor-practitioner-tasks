[803.696868, "i", "rm -rf /tmp/orders-concurrent; mkdir /tmp/orders-concurrent; python - <<'PY'\nimport sqlite3\np='/tmp/orders-concurrent/orders.db'\ncon=sqlite3.connect(p)\ncon.executescript('''\nCREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, segment TEXT NOT NULL, created_at TEXT NOT NULL);\nCREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id), created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL, currency TEXT NOT NULL, channel TEXT NOT NULL);\nCREATE INDEX orders_created_at ON orders(created_at);\nCREATE INDEX orders_customer ON orders(customer_id, created_at);\n''')\ncon.execute('INSERT INTO customers VALUES (1,?,?,?,?,?)',('Customer 1','c1@example.org','wholesale','2020-01-01T00:00:00Z'))\ncon.executemany('INSERT INTO orders (id,customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,?,?,?,?,?)',[(i,1,'2026-01-01T00:00:00Z','paid',i,'USD','web') for i in range(1,121)])\ncon.commit(); con.close"]
[803.69697, "i", "()\nPY\npython -m orders_service --db /tmp/orders-concurrent/orders.db --port 18083 >/tmp/orders-concurrent/service.log 2>&1 & svc=$!; for i in $(seq 1 50); do python - <<'PY' >/dev/null 2>&1 && break\nimport urllib.request\nurllib.request.urlopen('http://127.0.0.1:18083/orders/count', timeout=1)\nPY\nsleep 0.1; done; python - <<'PY'\nimport json, subprocess, urllib.parse, urllib.request\nbase='http://127.0.0.1:18083'\ndef get(path,params=None):\n    url=base+path+(('?' + urllib.parse.urlencode(params)) if params else '')\n    with urllib.request.urlopen(url,timeout=10) as r: return json.load(r)\ndef first_page():\n    body=get('/orders',{'limit':7})\n    return [o['id'] for o in body['orders']], body['next_cursor']\nids,cursor=first_page()\nstarted_before=len(ids)\n# New order sorts ahead of the current pass; POS backfill sorts inside the remainder.\nsubprocess.run(['python','-c','''import sqlite3\\np=\"/tmp/orders-concurrent/orders.db\"\\nc=sqlite3.connect(p,timeout=10)\\nc.execute(\"INSERT INTO orders (customer_id,created_at,stat"]
[803.697029, "i", "us,total_cents,currency,channel) VALUES (1,?,?,?,?,?)\",(\"2026-01-01T00:00:00Z\",\"paid\",999999,\"USD\",\"web\"))\\nc.execute(\"INSERT INTO orders (customer_id,created_at,status,total_cents,currency,channel) VALUES (1,?,?,?,?,?)\",(\"2025-01-01T00:00:00Z\",\"paid\",1000,\"USD\",\"pos\"))\\nc.commit()\\nc.close()'''],check=True)\nwhile cursor is not None:\n    body=get('/orders',{'limit':7,'cursor':cursor})\n    ids += [o['id'] for o in body['orders']]\n    cursor=body['next_cursor']\nassert len(ids)==len(set(ids)), ids\nassert set(range(1,121)) <= set(ids), (len(ids),min(set(range(1,121))-set(ids),default=None))\nassert ids.count(999999) <= 1\nassert ids.count(100000) <= 1\nwalk=[o['id'] for o in get('/orders',{'limit':20})['orders']] if False else None\ndef full(path,limit):\n    out=[]; cursor=None\n    while True:\n        q={'limit':limit}\n        if cursor is not None:q['cursor']=cursor\n        b=get(path,q);out += [o['id'] for o in b['orders']];cursor=b['next_cursor']\n        if cursor is None:return out\nafter=full('/orders',20)\nassert"]
[803.697041, "i", " set(range(1,121)) | {100000,100001} == set(after), (len(after),after[:5],after[-5:])\ncustomer=full('/customers/1/orders',10)\nassert customer==after\nprint('concurrent walk ok:',len(ids),'unique;', 'all new/old inserts visible afterward')\nprint('after count:',get('/orders/count'))\nPY\nrc=$?; kill $svc; wait $svc 2>/dev/null || true; echo \"concurrent rc=$rc\"; cat /tmp/orders-concurrent/service.log\n"]
