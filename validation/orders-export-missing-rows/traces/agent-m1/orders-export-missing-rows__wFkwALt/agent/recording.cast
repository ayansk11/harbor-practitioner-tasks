[324.537059, "i", "python - <<'PY'\nimport sqlite3\np='/app/data/orders.db'\ncon=sqlite3.connect(f'file:{p}?mode=ro', uri=True)\nprint('sqlite version', sqlite3.sqlite_version)\nprint('\\nSCHEMA:')\nfor row in con.execute(\"SELECT type,name,sql FROM sqlite_master WHERE type IN ('table','index') ORDER BY type,name\"):\n    print(row)\nprint('\\nCOUNTS:', con.execute('SELECT (SELECT count(*) FROM orders),(SELECT count(*) FROM customers)').fetchone())\nprint('created_at range:', con.execute('SELECT min(created_at),max(created_at) FROM orders').fetchone())\nprint('ties on created_at:', con.execute('SELECT count(*) FROM (SELECT created_at FROM orders GROUP BY created_at HAVING count(*)>1)').fetchone()[0])\nprint('largest tie group:', con.execute('SELECT max(n) FROM (SELECT count(*) n FROM orders GROUP BY created_at)').fetchone()[0])\nprint('id range:', con.execute('SELECT min(id),max(id) FROM orders').fetchone())\nprint('order-id monotonic vs date violations:', con.execute(\"SELECT count(*) FROM orders a JOIN orders b ON b.id=a.id+1 WHERE a.created_a"]
[324.537195, "i", "t > b.created_at\").fetchone()[0])\ncon.close()\nPY\n"]
