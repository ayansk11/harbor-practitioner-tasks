[409.261157, "i", "python - <<'PY'\nimport sqlite3\ncon=sqlite3.connect('file:/app/data/orders.db?mode=ro', uri=True)\nrow=con.execute(\"SELECT created_at,id FROM orders WHERE (created_at,id) < ('2026-01-01T00:00:00Z',123456) ORDER BY created_at DESC,id DESC LIMIT 1\").fetchone()\nprint('first row returned by row-value:', row)\nprint('rows equal timestamp:', con.execute(\"SELECT count(*) FROM orders WHERE created_at='2026-01-01T00:00:00Z'\").fetchone()[0])\nfor cursor in [('2026-03-19T20:36:19Z', 999999999), ('2026-03-19T20:36:19Z', 0)]:\n    print('\\ncursor',cursor)\n    for name,sql,args in [\n      ('row value',\"SELECT id FROM orders WHERE (created_at,id) < (?,?) ORDER BY created_at DESC,id DESC LIMIT 10\",cursor),\n      ('OR',\"SELECT id FROM orders WHERE created_at < ? OR (created_at = ? AND id < ?) ORDER BY created_at DESC,id DESC LIMIT 10\",(cursor[0],cursor[0],cursor[1])),\n    ]:\n        got=con.execute(sql,args).fetchall()\n        print(name,got)\n        print(' plan:',con.execute('EXPLAIN QUERY PLAN '+sql,args).fetchall())\ncon.close("]
