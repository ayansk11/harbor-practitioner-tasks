[444.024509, "i", "alk      :',len(or_ids),or_pages,round(or_elapsed,4))\nprint('identical:',row_ids==or_ids)\nprint('ordering correct:',row_ids==list(range(48213,0,-1)))\n\n# Locate a group sharing one second and test both predicates immediately before and inside it.\ng=con.execute(\"SELECT created_at,count(*) n FROM orders GROUP BY created_at HAVING n>1 ORDER BY created_at DESC LIMIT 1\").fetchone()\nprint('\\ntie:',g['created_at'],g['n'])\nprint('last five at/above:',con.execute(\"SELECT id FROM orders WHERE created_at >= ? ORDER BY created_at DESC,id DESC LIMIT ?\",(g['created_at'],g['n'])).fetchall())\nfor cursor_id in (2**63-1,0):\n    for name,sql,args in [\n      ('row value',\"SELECT id FROM orders WHERE (created_at,id) < (?,?) ORDER BY created_at DESC,id DESC LIMIT 20\",(g['created_at'],cursor_id)),\n      ('OR',\"SELECT id FROM orders WHERE created_at < ? OR (created_at=? AND id<?) ORDER BY created_at DESC,id DESC LIMIT 20\",(g['created_at'],g['created_at'],cursor_id)),\n    ]:\n        print(name,'cursor id',cursor_id,'=>',[r[0] for r in"]
