[410.343014, "i", "python - <<'PY'\nimport sqlite3,time\ncon=sqlite3.connect('file:/app/data/orders.db?mode=ro', uri=True)\n# Simulate a complete walk at limit=200 with corrected OR predicate, recording count and query time.\nc=con.execute(\"SELECT created_at,id FROM orders ORDER BY created_at DESC,id DESC LIMIT 1\").fetchone()\ntotal=0; pages=0; elapsed=0.0\nwhile c is not None:\n    start=time.perf_counter()\n    rows=con.execute(\"SELECT id FROM orders WHERE created_at < ? OR (created_at=? AND id<?) ORDER BY created_at DESC,id DESC LIMIT 200\",(c[0],c[0],c[1])).fetchall()\n    elapsed+=time.perf_counter()-start\n    total+=len(rows); pages+=1\n    c=rows[-1] if len(rows)==200 else None\nprint('walk total/pages/seconds:',total,pages,round(elapsed,4))\nprint('global OR plan:')\nprint(con.execute(\"EXPLAIN QUERY PLAN SELECT id FROM orders WHERE created_at < ? OR (created_at=? AND id<?) ORDER BY created_at DESC,id DESC LIMIT 200\",('2026-01-01T00:00:00Z','2026-01-01T00:00:00Z',123456)).fetchall())\nprint('customer OR plan:')\nprint(con.execute(\"EXPLA"]
[410.343125, "i", "IN QUERY PLAN SELECT id FROM orders INDEXED BY orders_customer WHERE customer_id=? AND (created_at < ? OR (created_at=? AND id<?)) ORDER BY created_at DESC,id DESC LIMIT 20\",(3649,'2026-01-01T00:00:00Z','2026-01-01T00:00:00Z',123456)).fetchall())\ncon.close()\nPY\n"]
