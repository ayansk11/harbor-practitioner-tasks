[346.067816, "o", "     1\t\"\"\"API tests for the orders service (run from /app: python -m pytest -q tests).\r\n     2\t\r\n     3\tEach test builds a small database in a temporary folder and talks to the app through Flask's test client.\"\"\"\r\n     4\timport sqlite3\r\n"]
[346.067848, "o", "     5\t\r\n     6\timport pytest\r\n     7\t\r\n     8\tfrom orders_service import create_app\r\n     9\t\r\n    10\tSCHEMA = \"\"\"\r\n    11\tCREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, segment TEXT NOT NULL,\r\n"]
[346.067869, "o", "    12\t                        created_at TEXT NOT NULL);\r\n    13\tCREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id),\r\n    14\t                     created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL,\r\n    15\t                     currency TEXT NOT NULL, channel TEXT NOT NULL);\r\n    16\tCREATE INDEX orders_created_at ON orders(created_at);\r\n    17\tCREATE INDEX orders_customer ON orders(customer_id, created_at);\r\n    18\t\"\"\"\r\n    19\t\r\n"]
[346.067892, "o", "    20\t\r\n    21\tdef make_db(path, n_orders=57):\r\n    22\t    con = sqlite3.connect(path)\r\n    23\t    con.executescript(SCHEMA)\r\n    24\t    con.executemany(\"INSERT INTO customers VALUES (?, ?, ?, ?, ?)\",\r\n    25\t                    [(c, f\"Customer {c}\", f\"c{c}@example.org\", \"retail\", \"2025-01-01T00:00:00Z\") for c in (1, 2, 3)])\r\n    26\t    rows = []\r\n    27\t    for i in range(1, n_orders + 1):\r\n    28\t        minute, second = divmod(i * 7, 60)\r\n    29\t        rows.append((i, 1 + i % 2, f\"2026-03-01T10:{minute:02d}:{second:02d}Z\", \"paid\", 1000 + i, \"USD\", \"web\"))\r\n"]
[346.067917, "o", "    30\t    con.executemany(\"INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?, ?)\", rows)\r\n    31\t    con.commit()\r\n    32\t    con.close()\r\n    33\t    return rows\r\n    34\t\r\n    35\t\r\n    36\t@pytest.fixture()\r\n    37\tdef client(tmp_path):\r\n"]
[346.067939, "o", "    38\t    db = tmp_path / \"orders.db\"\r\n    39\t    make_db(db)\r\n    40\t    return create_app(str(db)).test_client()\r\n    41\t\r\n    42\t\r\n    43\tdef walk(client, path, limit):\r\n    44\t    out, cursor = [], None\r\n"]
[346.067988, "o", "    45\t    for _ in range(1000):\r\n    46\t        q = {\"limit\": limit} if cursor is None else {\"limit\": limit, \"cursor\": cursor}\r\n    47\t        body = client.get(path, query_string=q).get_json()\r\n    48\t        out += body[\"orders\"]\r\n"]
[346.06802, "o", "    49\t        cursor = body[\"next_cursor\"]\r\n    50\t        if cursor is None:\r\n    51\t            return out\r\n    52\t    raise AssertionError(\"too many pages\")"]
[346.068047, "o", "\r\n    53\t\r\n    54\t\r\n    55\tdef test_count(client):\r\n    56\t    assert client.get(\"/orders/count\").get_json() == {\"count\": 57}\r\n    57\t\r\n    58\t"]
[346.06808, "o", "\r\n    59\tdef test_get_order(client):\r\n    60\t    assert client.get(\"/orders/5\").get_json() == {\"id\": 5, \"customer_id\": 2, \"created_at\": \"2026-03-01T10:00:35Z\",\r\n    61\t                                                  \"status\": \"paid\", \"total_cents\": 1005, \"currency\": \"USD\"}\r\n    62\t    assert client.get(\"/orders/999\").status_code == 404\r\n    63\t\r\n    64\t\r\n    65\tdef test_first_page_newest_first(client):\r\n    66\t    body = client.get(\"/orders\").get_json()\r\n    67\t    assert [o[\"id\"] for o in body[\"orders\"]] == list(range(57, 0, -1))\r\n"]
[346.068108, "o", "    68\t    assert body[\"next_cursor\"] is None\r\n    69\t\r\n    70\t\r\n    71\t@pytest.mark.parametrize(\"limit\", [1, 5, 10, 57, 100])\r\n    72\tdef test_walk_returns_every_order_once(client, limit):\r\n    73\t    ids = [o[\"id\"] for o in walk(client, \"/orders\", limit)]\r\n    74\t    assert ids == list(range(57, 0, -1))\r\n    75\t\r\n    76\t\r\n"]
[346.06813, "o", "    77\tdef test_customer_orders(client):\r\n    78\t    ids = [o[\"id\"] for o in walk(client, \"/customers/1/orders\", 4)]\r\n    79\t    assert ids == [i for i in range(57, 0, -1) if i % 2 == 0]\r\n    80\t    assert client.get(\"/customers/3/orders\").get_json() == {\"orders\": [], \"next_cursor\": None}\r\n"]
[346.06815, "o", "    81\t    assert client.get(\"/customers/42/orders\").status_code == 404\r\n    82\t\r\n    83\t\r\n    84\t@pytest.mark.parametrize(\"query\", [\"limit=0\", \"limit=501\", \"limit=-1\", \"limit=ten\", \"cursor=not-a-cursor\"])\r\n    85\tdef test_bad_parameters(client, query):\r\n    86\t    assert client.get(f\"/orders?{query}\").status_code == 400\r\n"]
