[525.492867, "i", "python - <<'PY'\nimport sqlite3,time\ncon=sqlite3.connect('file:/app/data/orders.db?mode=ro', uri=True)\n\ndef walk(sql_factory):\n    c=con.execute(\"SELECT created_at,id FROM orders ORDER BY created_at DESC,id DESC LIMIT 1\").fetchone()\n    ids=[]; elapsed=0.0; pages=0\n    while c is not None:\n        sql,args=sql_factory(c)\n        start=time.perf_counter(); rows=con.execute(sql,args).fetchall(); elapsed+=time.perf_counter()-start\n        ids.extend(r[0] for r in rows); pages+=1\n        c=(rows[-1][0],rows[-1][1]) if len(rows)==200 else None\n    return ids,pages,elapsed\nrow=walk(lambda c: (\"SELECT created_at,id FROM orders WHERE (created_at,id) < (?,?) ORDER BY created_at DESC,id DESC LIMIT 200\",(c[0],c[1])))\norwalk=walk(lambda c: (\"SELECT created_at,id FROM orders WHERE created_at < ? OR (created_at=? AND id<?) ORDER BY created_at DESC,id DESC LIMIT 200\",(c[0],c[0],c[1])))\nprint('row-value walk:',len(row[0]),row[1],round(row[2],4))\nprint('OR walk      :',len(orwalk[0]),orwalk[1],round(orwalk[2],4))\nprint('identi"]
[525.492899, "i", "cal:',row[0]==orwalk[0])\nprint('expected ids/order:',row[0]==list(range(48213,0,-1)))\ng=con.execute(\"SELECT created_at,count(*) n FROM orders GROUP BY created_at HAVING n>1 ORDER BY created_at DESC LIMIT 1\").fetchone()\nprint('\\ntie:',g[0],g[1])\nfor cursor_id in ((1<<63)-1,0):\n    got_row=[r[0] for r in con.execute(\"SELECT id FROM orders WHERE (created_at,id) < (?,?) ORDER BY created_at DESC,id DESC LIMIT 20\",(g[0],cursor_id))]\n    got_or=[r[0] for r in con.execute(\"SELECT id FROM orders WHERE created_at < ? OR (created_at=? AND id<?) ORDER BY created_at DESC,id DESC LIMIT 20\",(g[0],g[0],cursor_id))]\n    print('cursor id',cursor_id,'row-value',got_row,'OR',got_or,'equal',got_row==got_or)\ncon.close()\nPY\n"]
