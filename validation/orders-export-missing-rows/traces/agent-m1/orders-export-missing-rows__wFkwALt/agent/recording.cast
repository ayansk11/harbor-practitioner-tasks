[879.819782, "i", "rm -rf /tmp/orders-concurrent; mkdir /tmp/orders-concurrent; python - <<'PY'\nimport sqlite3\np='/tmp/orders-concurrent/orders.db'\ncon=sqlite3.connect(p)\ncon.executescript('''\nCREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, segment TEXT NOT NULL, created_at TEXT NOT NULL);\nCREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id), created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL, currency TEXT NOT NULL, channel TEXT NOT NULL);\nCREATE INDEX orders_created_at ON orders(created_at);\nCREATE INDEX orders_customer ON orders(customer_id, created_at);\n''')\ncon.execute('INSERT INTO customers (id,name,email,segment,created_at) VALUES (?,?,?,?,?)',(1,'Customer 1','c1@example.org','wholesale','2020-01-01T00:00:00Z'))\ncon.executemany('INSERT INTO orders (id,customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,?,?,?,?,?)',[(i,1,'2026-01-01T00:00:00Z','paid',i,'USD','web') for i in ran"]
[879.819917, "i", "ge(1,121)])\ncon.commit(); con.close()\nPY\npython -m orders_service --db /tmp/orders-concurrent/orders.db --port 18083 >/tmp/orders-concurrent/service.log 2>&1 & svc=$!; for i in $(seq 1 50); do python - <<'PY' >/dev/null 2>&1 && break\nimport urllib.request\nurllib.request.urlopen('http://127.0.0.1:18083/orders/count', timeout=1)\nPY\nsleep 0.1; done; python - <<'PY'\nimport json, subprocess, urllib.parse, urllib.request\nbase='http://127.0.0.1:18083'\ndef get(path,params=None):\n    url=base+path+(('?' + urllib.parse.urlencode(params)) if params else '')\n    with urllib.request.urlopen(url,timeout=10) as r: return json.load(r)\ndef full(path,limit):\n    out=[]; cursor=None\n    while True:\n        q={'limit':limit}\n        if cursor is not None: q['cursor']=cursor\n        b=get(path,q); out += [o['id'] for o in b['orders']]; cursor=b['next_cursor']\n        if cursor is None: return out\nbody=get('/orders',{'limit':7})\nids=[o['id'] for o in body['orders']]\ncursor=body['next_cursor']\nassert ids == [120,119,118,117,116,115"]
[879.819992, "i", ",114], ids\n# Simulate checkout and POS sync between two client requests.\nsubprocess.run(['python','-c','''import sqlite3\\nc=sqlite3.connect(\"/tmp/orders-concurrent/orders.db\",timeout=10)\\nc.execute(\"INSERT INTO orders (customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,?,?,?,?)\",(1,\"2026-01-01T00:00:00Z\",\"paid\",999999,\"USD\",\"web\"))\\nc.execute(\"INSERT INTO orders (customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,?,?,?,?)\",(1,\"2025-01-01T00:00:00Z\",\"paid\",1000,\"USD\",\"pos\"))\\nc.commit()'''],check=True)\nwhile cursor is not None:\n    body=get('/orders',{'limit':7,'cursor':cursor})\n    ids += [o['id'] for o in body['orders']]\n    cursor=body['next_cursor']\nassert len(ids)==len(set(ids)), ids\nassert set(range(1,121)) <= set(ids)\nassert ids.count(121) <= 1\nassert ids.count(122) <= 1\nafter=full('/orders',20)\ncustomer=full('/customers/1/orders',10)\nassert after == customer\nassert after == list(range(121,0,-1))+[122], (len(after),after[:5],after[-5:])\nassert get('/orders/count"]
[879.820054, "i", "') == {'count':122}\nprint('concurrent walk ok:',len(ids),'unique existing orders; later walk:',len(after))\nPY\nrc=$?; kill $svc; wait $svc 2>/dev/null || true; echo \"concurrent rc=$rc\"; cat /tmp/orders-concurrent/service.log\n"]
