[803.724748, "o", "    with urllib.request.urlopen(url,timeout=10) as r: return json.load(r)\r\n\u001b[?2004l\r"]
[803.724784, "o", "\u001b[?2004h> "]
[803.724832, "o", "def first_page():\r\n\u001b[?2004l\r"]
[803.724868, "o", "\u001b[?2004h> "]
[803.724972, "o", "    body=get('/orders',{'limit':7})\r\n\u001b[?2004l\r"]
[803.725008, "o", "\u001b[?2004h> "]
[803.725206, "o", "    return [o['id'] for o in body['orders']], body['next_cursor']\r\n\u001b[?2004l\r"]
[803.725242, "o", "\u001b[?2004h> "]
[803.72531, "o", "ids,cursor=first_page()\r\n\u001b[?2004l\r"]
[803.725346, "o", "\u001b[?2004h> "]
[803.725412, "o", "started_before=len(ids)\r\n\u001b[?2004l\r"]
[803.725447, "o", "\u001b[?2004h> "]
[803.725704, "o", "# New order sorts ahead of the current pass; POS backfill sorts inside the remainder.\r\n\u001b[?2004l\r"]
[803.72574, "o", "\u001b[?2004h> "]
[803.727213, "o", "subprocess.run(['python','-c','''import sqlite3\\np=\"/tmp/orders-concurrent/orders.db\"\\nc=sqlite3.connect(p,timeout=10)\\nc.execute(\"INSERT INTO orders (customer_id,created_at,status,total_cents,currency,channel) VALUES (1,?,?,?,?,?)\",(\"2026-01-01T00:00:00Z\",\"paid\",999999,\"USD\",\"web\"))\\nc.execute(\"INSERT INTO orders (customer_id,created_at,status,total_cents,currency,channel) VALUES (1,?,?,?,?,?)\",(\"2025-01-01T00:00:00Z\",\"paid\",1000,\"USD\",\"pos\"))\\nc.commit()\\nc.close()'''],check=True)\r\n\u001b[?2004l\r"]
[803.727257, "o", "\u001b[?2004h> "]
[803.727322, "o", "while cursor is not None:\r\n\u001b[?2004l\r"]
[803.727356, "o", "\u001b[?2004h> "]
[803.727507, "o", "    body=get('/orders',{'limit':7,'cursor':cursor})\r\n\u001b[?2004l\r"]
[803.727542, "o", "\u001b[?2004h> "]
[803.727676, "o", "    ids += [o['id'] for o in body['orders']]\r\n\u001b[?2004l\r"]
[803.727712, "o", "\u001b[?2004h> "]
[803.727798, "o", "    cursor=body['next_cursor']\r\n\u001b[?2004l\r"]
[803.727833, "o", "\u001b[?2004h> "]
[803.72794, "o", "assert len(ids)==len(set(ids)), ids\r\n\u001b[?2004l\r"]
[803.727974, "o", "\u001b[?2004h> "]
[803.728278, "o", "assert set(range(1,121)) <= set(ids), (len(ids),min(set(range(1,121))-set(ids),default=None))\r\n\u001b[?2004l\r\u001b[?2004h"]
[803.728336, "o", "> "]
[803.72838, "o", "assert ids.count(999999) <= 1\r\n\u001b[?2004l\r"]
[803.728418, "o", "\u001b[?2004h> "]
[803.7285, "o", "assert ids.count(100000) <= 1\r\n\u001b[?2004l\r"]
[803.728535, "o", "\u001b[?2004h> "]
[803.72878, "o", "walk=[o['id'] for o in get('/orders',{'limit':20})['orders']] if False else None\r\n\u001b[?2004l\r"]
[803.728817, "o", "\u001b[?2004h> "]
[803.728874, "o", "def full(path,limit):\r\n\u001b[?2004l\r"]
[803.72891, "o", "\u001b[?2004h> "]
[803.728976, "o", "    out=[]; cursor=None\r\n\u001b[?2004l\r"]
[803.729012, "o", "\u001b[?2004h> "]
[803.72905, "o", "    while True:\r\n\u001b[?2004l\r"]
[803.729087, "o", "\u001b[?2004h> "]
[803.729165, "o", "        q={'limit':limit}\r\n\u001b[?2004l\r"]
[803.729202, "o", "\u001b[?2004h> "]
[803.729344, "o", "        if cursor is not None:q['cursor']=cursor\r\n\u001b[?2004l\r"]
[803.729379, "o", "\u001b[?2004h> "]
[803.729627, "o", "        b=get(path,q);out += [o['id'] for o in b['orders']];cursor=b['next_cursor']\r\n\u001b[?2004l\r"]
[803.729663, "o", "\u001b[?2004h> "]
[803.72977, "o", "        if cursor is None:return out\r\n\u001b[?2004l\r"]
[803.729805, "o", "\u001b[?2004h> "]
[803.729877, "o", "after=full('/orders',20)\r\n\u001b[?2004l\r"]
[803.729913, "o", "\u001b[?2004h> "]
[803.730191, "o", "assert set(range(1,121)) | {100000,100001} == set(after), (len(after),after[:5],after[-5:])\r\n\u001b[?2004l\r"]
[803.730227, "o", "\u001b[?2004h> "]
[803.730343, "o", "customer=full('/customers/1/orders',10)\r\n\u001b[?2004l\r"]
[803.730379, "o", "\u001b[?2004h> "]
[803.730441, "o", "assert customer==after\r\n\u001b[?2004l\r"]
[803.730476, "o", "\u001b[?2004h> "]
[803.730742, "o", "print('concurrent walk ok:',len(ids),'unique;', 'all new/old inserts visible afterward')\r\n\u001b[?2004l\r"]
[803.730777, "o", "\u001b[?2004h> "]
[803.730897, "o", "print('after count:',get('/orders/count'))\r\n\u001b[?2004l\r"]
[803.730924, "o", "\u001b[?2004h"]
[803.730951, "o", "> PY\r\n"]
