[865.051128, "i", "rm -rf /tmp/orders-perf; mkdir /tmp/orders-perf; python - <<'PY'\nimport sqlite3\np='/tmp/orders-perf/orders.db'\ncon=sqlite3.connect(p)\ncon.executescript('''\nCREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, segment TEXT NOT NULL, created_at TEXT NOT NULL);\nCREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id), created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL, currency TEXT NOT NULL, channel TEXT NOT NULL);\nCREATE INDEX orders_created_at ON orders(created_at);\nCREATE INDEX orders_customer ON orders(customer_id, created_at);\n''')\ncon.executemany('INSERT INTO customers VALUES (?,?,?,?,?)', [(i, f'Customer {i}', f'c{i}@example.org', 'retail', '2020-01-01T00:00:00Z') for i in range(1,6)])\nrows=[(i,1+(i%5),'2026-01-01T00:00:00Z','paid',i,'USD','web') for i in range(1,5001)]\nrows += [(100000,1,'2024-01-01T00:00:00Z','paid',100000,'USD','pos_backfill'),(100001,2,'2024-01-01T00:00:00Z','paid',10"]
[865.051257, "i", "0001,'USD','pos_backfill')]\ncon.executemany('INSERT INTO orders (id,customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,?,?,?,?,?)',rows)\ncon.commit(); con.close()\nPY\npython -m orders_service --db /tmp/orders-perf/orders.db --port 18082 >/tmp/orders-perf.log 2>&1 & pid=$!; for i in $(seq 1 50); do python - <<'PY' >/dev/null 2>&1 && break\nimport urllib.request\nurllib.request.urlopen('http://127.0.0.1:18082/orders/count', timeout=1)\nPY\nsleep 0.1; done; python - <<'PY'\nimport json, urllib.parse, urllib.request\nbase='http://127.0.0.1:18082'\ndef get(path, params=None):\n    url=base+path+(('?' + urllib.parse.urlencode(params)) if params else '')\n    with urllib.request.urlopen(url,timeout=10) as r: return json.load(r)\ndef walk(path,limit):\n    ids=[]; cursor=None\n    while True:\n        q={'limit':limit}\n        if cursor is not None: q['cursor']=cursor\n        body=get(path,q); ids += [o['id'] for o in body['orders']]; cursor=body['next_cursor']\n        if cursor is None: return ids\nfor limit i"]
[865.051279, "i", "n (1,7,499,500):\n    got=walk('/orders',limit)\n    expected=list(range(5000,0,-1))+[100001,100000]\n    assert got == expected, (limit,len(got))\n    print('same-second global walk',limit,'ok',len(got))\nfor cid in (1,2,3,4,5):\n    got=walk(f'/customers/{cid}/orders',7)\n    expected=[i for i in range(5000,0,-1) if 1+(i%5)==cid]\n    if cid==1: expected.append(100000)\n    if cid==2: expected.append(100001)\n    assert got == expected, (cid,len(got),len(expected))\n    print('same-second customer walk',cid,'ok',len(got))\nassert get('/orders/count') == {'count':5002}\nPY\nrc=$?; kill $pid; wait $pid 2>/dev/null || true; echo \"synthetic rc=$rc\"; cat /tmp/orders-perf.log\n"]
