[655.721567, "i", "python - <<'PY'\np='tests/test_api.py'\ns=open(p).read()\nmarker='''@pytest.mark.parametrize(\"limit\", [1, 5, 10, 57, 100])\\ndef test_walk_returns_every_order_once(client, limit):\\n    ids = [o[\"id\"] for o in walk(client, \"/orders\", limit)]\\n    assert ids == list(range(57, 0, -1))\\n\\n\\n'''\naddition='''@pytest.mark.parametrize(\"limit\", [1, 3, 7, 57])\\ndef test_walk_does_not_skip_same_second_orders(tmp_path, limit):\\n    db = tmp_path / \"orders.db\"\\n    make_db(db)\\n    con = sqlite3.connect(db)\\n    con.execute(\"UPDATE orders SET created_at = '2026-03-01T10:00:00Z'\")\\n    con.commit()\\n    con.close()\\n\\n    client = create_app(str(db)).test_client()\\n    ids = [o[\"id\"] for o in walk(client, \"/orders\", limit)]\\n    assert ids == list(range(57, 0, -1))\\n\\n\\ndef test_empty_page_after_exact_multiple(tmp_path):\\n    db = tmp_path / \"orders.db\"\\n    make_db(db, n_orders=6)\\n    con = sqlite3.connect(db)\\n    con.execute(\"UPDATE orders SET created_at = '2026-03-01T10:00:00Z'\")\\n    con.commit()\\n    con.close()\\n\\n    "]
[655.721812, "i", "client = create_app(str(db)).test_client()\\n    first = client.get(\"/orders?limit=3\").get_json()\\n    assert [o[\"id\"] for o in first[\"orders\"]] == [6, 5, 4]\\n    assert first[\"next_cursor\"] is not None\\n    second = client.get(\"/orders\", query_string={\"limit\": 3, \"cursor\": first[\"next_cursor\"]}).get_json()\\n    assert second == {\"orders\": [], \"next_cursor\": None}\\n\\n\\n'''\nassert marker in s\ns=s.replace(marker,marker+addition)\nopen(p,'w').write(s)\nPY\npython -m pytest -q tests\n"]
