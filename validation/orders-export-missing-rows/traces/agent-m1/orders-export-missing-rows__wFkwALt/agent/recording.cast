[713.626971, "i", "_app(str(db)).test_client()\\n    first = client.get(\"/orders?limit=4\").get_json()\\n    assert [o[\"id\"] for o in first[\"orders\"]] == [20, 19, 18, 17]\\n\\n    # A POS order synced late gets a high id and an old placement date.\\n    inserted_id = 101\\n    con = sqlite3.connect(db)\\n    con.execute(\\n        \"INSERT INTO orders (id, customer_id, created_at, status, total_cents, currency, channel) \"\\n        \"VALUES (?, ?, ?, ?, ?, ?, ?)\",\\n        (inserted_id, 1, \"2025-01-01T00:00:00Z\", \"paid\", 2000, \"USD\", \"pos\"),\\n    )\\n    con.commit()\\n    con.close()\\n\\n    ids = [o[\"id\"] for o in first[\"orders\"]]\\n    cursor = first[\"next_cursor\"]\\n    while cursor is not None:\\n        body = client.get(\"/orders\", query_string={\"limit\": 4, \"cursor\": cursor}).get_json()\\n        ids += [o[\"id\"] for o in body[\"orders\"]]\\n        cursor = body[\"next_cursor\"]\\n\\n    assert len(ids) == len(set(ids))\\n    assert set(range(1, 21)) <= set(ids)\\n    assert ids.count(inserted_id) <= 1\\n    after = [o[\"id\"] for o in walk(client, \"/o"]
