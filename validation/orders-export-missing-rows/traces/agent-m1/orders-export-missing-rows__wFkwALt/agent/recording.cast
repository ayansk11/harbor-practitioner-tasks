[345.03822, "o", "===== queries.py =====\r\n"]
[345.039505, "o", "     1\t\"\"\"Queries behind the customer views (account page, support tool).\"\"\"\r\n     2\tfrom .db import ORDER_COLUMNS\r\n     3\tfrom .pagination import encode_cursor\r\n     4\t\r\n     5\t\r\n     6\tdef customer_exists(con, customer_id):\r\n     7\t    return con.execute(\"SELECT 1 FROM customers WHERE id = ?\", (customer_id,)).fetchone() is not None\r\n"]
[345.039574, "o", "     8\t\r\n     9\t\r\n    10\tdef customer_orders_page(con, customer_id, limit, cursor):\r\n    11\t    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\r\n    12\t\r\n    13\t    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index\r\n"]
[345.039624, "o", "    14\t    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112).\"\"\"\r\n    15\t    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\r\n    16\t    args = [customer_id]\r\n    17\t    if cursor is not None:\r\n    18\t        sql += \" AND created_at < ?\"\r\n    19\t        args.append(cursor.created_at)\r\n    20\t    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n    21\t    args.append(limit)\r\n    22\t    rows = con.execute(sql, args).fetchall()\r\n    23\t    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n    24\t    return rows, next_cursor\r\n"]
[345.039757, "o", "===== db.py =====\r\n"]
[345.040701, "o", "     1\t\"\"\"One SQLite connection per request. Other systems (checkout, the POS sync, back-office imports) write to the same\r\n     2\tdatabase file, so the API never caches rows: every request reads what is committed at that moment.\"\"\"\r\n     3\timport sqlite3\r\n     4\t\r\n     5\tfrom flask import current_app, g\r\n     6\t\r\n     7\tORDER_FIELDS = (\"id\", \"customer_id\", \"created_at\", \"status\", \"total_cents\", \"currency\")\r\n"]
[345.04074, "o", "     8\tORDER_COLUMNS = \", \".join(ORDER_FIELDS)\r\n     9\t\r\n    10\t\r\n    11\tdef get_db():\r\n    12\t    if \"db\" not in g:\r\n    13\t        con = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=10)\r\n"]
[345.040787, "o", "    14\t        con.row_factory = sqlite3.Row\r\n    15\t        g.db = con\r\n    16\t    return g.db\r\n    17\t\r\n    18\t\r\n    19\tdef close_db(_exc=None):\r\n    20\t    con = g.pop(\"db\", None)\r\n    21\t    if con is not None:\r\n    22\t        con.close()\r\n    23\t\r\n    24\t\r\n"]
[345.040821, "o", "    25\tdef order_json(row):\r\n    26\t    return {name: row[name] for name in ORDER_FIELDS}\r\n"]
[345.040919, "o", "===== __main__.py =====\r\n"]
[345.041981, "o", "     1\t\"\"\"Start the orders API: python -m orders_service --db data/orders.db --port 8080\"\"\"\r\n     2\timport argparse\r\n     3\timport os\r\n     4\t\r\n"]
[345.04199, "o", "     5\tfrom waitress import serve\r\n     6\t\r\n     7\tfrom .app import create_app\r\n"]
[345.04206, "o", "     8\t\r\n     9\t\r\n    10\tdef main():\r\n    11\t    parser = argparse.ArgumentParser(prog=\"python -m orders_service\", description=__doc__)\r\n    12\t    parser.add_argument(\"--db\", required=True, help=\"path to the SQLite orders database\")\r\n    13\t    parser.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    14\t    parser.add_argument(\"--port\", type=int, default=8080)\r\n    15\t    parser.add_argument(\"--threads\", type=int, default=4)\r\n    16\t    args = parser.parse_args()\r\n    17\t    if not os.path.isfile(args.db):\r\n"]
[345.042079, "o", "    18\t        parser.error(f\"database not found: {args.db}\")\r\n    19\t    app = create_app(os.path.abspath(args.db))\r\n    20\t    serve(app, host=args.host, port=args.port, threads=args.threads, ident=\"orders-api\")\r\n    21\t\r\n    22\t\r\n    23\tif __name__ == \"__main__\":\r\n    24\t    main()\r\n"]
[345.042208, "o", "===== export_orders.py =====\r\n"]
[345.043075, "o", "     1\t\"\"\"Nightly finance export: page through GET /orders and write one CSV row per order.\r\n     2\t\r\n     3\t    python tools/export_orders.py --base http://127.0.0.1:8080 --limit 200 --out /tmp/orders.csv [--log export.log]\r\n     4"]
[345.043084, "o", "\t\r\n     5\tRuns from cron at 02:00 UTC against production. It only follows next_cursor; it never builds cursors itself.\r\n     6\t\"\"\"\r\n"]
[345.043147, "o", "     7\timport argparse\r\n     8\timport csv\r\n     9\timport datetime as dt\r\n    10\timport json\r\n    11\timport sys\r\n    12\timport urllib.parse\r\n    13\timport urllib.request\r\n    14\t\r\n    15\tFIELDS = [\"id\", \"customer_id\", \"created_at\", \"status\", \"total_cents\", \"currency\"]\r\n    16\t\r\n    17\t\r\n"]
[345.04318, "o", "    18\tdef now():\r\n    19\t    t = dt.datetime.now(dt.timezone.utc)\r\n    20\t    return t.strftime(\"%Y-%m-%dT%H:%M:%S.\") + f\"{t.microsecond // 1000:03d}Z\"\r\n    21\t\r\n    22\t\r\n    23\tdef get(base, path, params=None):\r\n    24\t    url = base.rstrip(\"/\") + path + (\"?\" + urllib.parse.urlencode(params) if params else \"\")\r\n    25\t    with urllib.request.urlopen(url, timeout=60) as resp:\r\n    26\t        return resp.status, json.load(resp)\r\n    27\t\r\n    28\t\r\n    29\tdef main():\r\n    30\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    31\t    ap.add_argument(\"--base\", default=\"http://127.0.0.1:8080\")\r\n    32\t    ap.add_argument(\"--limit\", type=int, default=200)\r\n    33"]
[345.043218, "o", "\t    ap.add_argument(\"--out\", required=True)\r\n    34\t    ap.add_argument(\"--log\", help=\"append the request log here (default: stderr)\")\r\n    35\t    args = ap.parse_args()\r\n    36\t    log = open(args.log, \"a\") if args.log else sys.stderr\r\n    37\t    print(f\"# export_orders.py started {now()} base={args.base} limit={args.limit} out={args.out}\", file=log)\r\n    38\t    status, body = get(args.base, \"/orders/count\")\r\n    39\t    total = body[\"count\"]\r\n"]
[345.043246, "o", "    40\t    print(f\"{now()} GET /orders/count {status} count={total}\", file=log)\r\n    41\t    rows = pages = 0\r\n    42\t    cursor = None\r\n    43\t    with open(args.out, \"w\", newline=\"\") as f:\r\n    44\t        w = csv.writer(f)\r\n    45\t        w.writerow(FIELDS)\r\n    46\t        while True:\r\n    47\t            params = {\"limit\": args.limit}\r\n"]
[345.043295, "o", "    48\t            if cursor is not None:\r\n    49\t                params[\"cursor\"] = cursor\r\n    50\t            status, body = get(args.base, \"/orders\", params)\r\n    51\t            pages += 1\r\n    52\t            for o in body[\"orders\"]:\r\n    53\t                w.writerow([o[k] for k in FIELDS])\r\n    54\t            rows += len(body[\"orders\"])\r\n    55\t            shown = \"/orders?\" + \"&\".join(f\"{k}={v}\" for k, v in params.items())\r\n    56\t            print(f\"{now()} GET {shown} {status} rows={len(body['orders'])} next_cursor={body['next_cursor'] or 'null'}\",\r\n    57\t                  file=log)"]
[345.04332, "o", "\r\n    58\t            cursor = body[\"next_cursor\"]\r\n    59\t            if cursor is None:\r\n    60\t                break\r\n    61\t    print(f\"# done {now()}: {rows} rows written, {pages} pages, count at start was {total}\", file=log)\r\n    62\t    if log is not sys.stderr:\r\n    63\t        log.close()\r\n    64\t\r\n    65\t\r\n    66\tif __name__ == \"__main__\":\r\n    67\t    main()\r\n"]
