[71.609035, "o", "\u001b[?2004h> "]
[71.609227, "o", "+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[71.609262, "o", "\u001b[?2004h> "]
