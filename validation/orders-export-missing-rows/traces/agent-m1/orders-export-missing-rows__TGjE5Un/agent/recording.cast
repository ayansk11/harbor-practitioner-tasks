[94.054061, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: orders_service/queries.py\n@@\n-def customer_orders_page(con, customer_id, limit, cursor):\n-    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\n-\n-    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index\n-    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112).\"\"\"\n-    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\n-    args = [customer_id]\n-    if cursor is not None:\n-        sql += \" AND created_at < ?\"\n-        args.append(cursor.created_at)\n-    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\n-    args.append(limit)\n-    rows = con.execute(sql, args).fetchall()\n-    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\n-    return rows, next_cursor\n+def customer_orders_page(con, customer_id, limit, cursor):\n+    \"\"\"One page of a customer's orders, newest f"]
[94.054207, "i", "irst.\n+\n+    Mirrors the pagination logic in :func:`pagination.paginate` but forces the\n+    ``orders_customer`` index for efficiency on large customers.\n+    \"\"\"\n+    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\n+    args = [customer_id]\n+    if cursor is not None:\n+        # Composite cursor condition matching pagination.paginate\n+        sql += \" AND ((created_at < ?) OR (created_at = ? AND id < ?))\"\n+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\n+    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\n+    args.append(limit)\n+    rows = con.execute(sql, args).fetchall()\n+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\n+    return rows, next_cursor\n*** End Patch\nPATCH\n"]
