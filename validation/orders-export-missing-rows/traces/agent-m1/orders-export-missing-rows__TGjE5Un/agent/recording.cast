[115.152171, "o", "\u001b[?2004h"]
[115.152193, "o", "> "]
[115.152223, "o", "+\r\n\u001b[?2004l\r"]
[115.152275, "o", "\u001b[?2004h> "]
[115.152871, "o", "+    Mirrors the pagination logic in :func:`pagination.paginate` but forces the\r\n\u001b[?2004l\r"]
[115.152918, "o", "\u001b[?2004h"]
[115.152959, "o", "> "]
[115.153435, "o", "+    ``orders_customer`` index for efficiency on large customers.\r\n"]
[115.15347, "o", "\u001b[?2004l\r"]
[115.153507, "o", "\u001b[?2004h"]
[115.153547, "o", "> "]
[115.153597, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[115.153653, "o", "\u001b[?2004h"]
[115.153693, "o", "> "]
[115.15441, "o", "+    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\r\n\u001b[?2004l\r"]
[115.154453, "o", "\u001b[?2004h"]
[115.154487, "o", "> "]
[115.154671, "o", "+    args = [customer_id]\r\n\u001b[?2004l\r"]
[115.154714, "o", "\u001b[?2004h"]
[115.154755, "o", "> "]
[115.154961, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[115.155007, "o", "\u001b[?2004h"]
[115.15504, "o", "> "]
[115.155539, "o", "+        # Composite cursor condition matching pagination.paginate\r\n\u001b[?2004l\r"]
[115.155583, "o", "\u001b[?2004h"]
[115.155617, "o", "> "]
[115.156147, "o", "+        sql += \" AND ((created_at < ?) OR (created_at = ? AND id < ?))\"\r\n\u001b[?2004l\r"]
[115.156191, "o", "\u001b[?2004h"]
[115.156239, "o", "> "]
[115.156755, "o", "+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[115.156801, "o", "\u001b[?2004h"]
[115.156851, "o", "> "]
[115.157256, "o", "+    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[115.157298, "o", "\u001b[?2004h"]
[115.157343, "o", "> "]
[115.157526, "o", "+    args.append(limit)\r\n\u001b[?2004l\r"]
[115.15757, "o", "\u001b[?2004h"]
[115.157609, "o", "> "]
[115.157951, "o", "+    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[115.157998, "o", "\u001b[?2004h"]
[115.158019, "o", "> "]
[115.158629, "o", "+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[115.158668, "o", "\u001b[?2004h"]
[115.15871, "o", "> "]
[115.158942, "o", "+    return rows, next_cursor\r\n\u001b[?2004l\r"]
[115.158988, "o", "\u001b[?2004h"]
[115.159026, "o", "> "]
[115.159168, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[115.159214, "o", "\u001b[?2004h"]
[115.159253, "o", "> "]
[115.159298, "o", "PATCH\r\n\u001b[?2004l\r"]
[115.159343, "o", "\u001b[?2004h"]
[115.159384, "o", "> "]
