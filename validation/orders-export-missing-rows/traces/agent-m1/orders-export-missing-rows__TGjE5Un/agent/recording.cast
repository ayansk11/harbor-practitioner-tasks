[70.107651, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: orders_service/pagination.py\n@@\n-Cursor = namedtuple(\"Cursor\", [\"created_at\"])\n+# The cursor must contain both the timestamp and the order id to correctly\n+# handle rows that share the same `created_at`.  The API orders rows by\n+# `created_at DESC, id DESC`, so we store both values.\n+Cursor = namedtuple(\"Cursor\", [\"created_at\", \"id\"])\n@@\n-def encode_cursor(row):\n-    \"\"\"Cursor for the page after `row` (the last row of the current page).\"\"\"\n-    return base64.urlsafe_b64encode(row[\"created_at\"].encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\n+def encode_cursor(row):\n+    \"\"\"Encode a cursor for the page after ``row``.\n+\n+    The cursor is a base64url string (no padding) of the form\n+    ``<created_at>:<id>`` where ``created_at`` is the ISO‑8601 timestamp and\n+    ``id`` is the integer order id.\n+    \"\"\"\n+    raw = f\"{row['created_at']}:{row['id']}\"\n+    return base64.urlsafe_b64encode(raw.encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\n@@\n-def decode_cursor(raw"]
[70.107783, "i", "):\n-    \"\"\"Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400.\"\"\"\n-    if raw is None:\n-        return None\n-    try:\n-        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\n-    except (ValueError, binascii.Error, UnicodeError):\n-        raise BadRequest(\"invalid cursor\") from None\n-    if not _TIMESTAMP.fullmatch(text):\n-        raise BadRequest(\"invalid cursor\")\n-    return Cursor(created_at=text)\n+def decode_cursor(raw):\n+    \"\"\"Parse the ``cursor`` query parameter; returns ``None`` when absent.\n+\n+    The cursor must decode to ``<timestamp>:<id>``.  ``timestamp`` must match the\n+    ISO‑8601 format defined by ``_TIMESTAMP`` and ``id`` must be a decimal\n+    integer.  Any malformed cursor triggers a ``400 Bad Request``.\n+    \"\"\"\n+    if raw is None:\n+        return None\n+    try:\n+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\n+    except (ValueError, binascii.Error, Uni"]
[70.10781, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[70.107821, "i", "codeError):\n+        raise BadRequest(\"invalid cursor\") from None\n+    if \":\" not in text:\n+        raise BadRequest(\"invalid cursor\")\n+    ts, id_str = text.split(\":\", 1)\n+    if not _TIMESTAMP.fullmatch(ts) or not id_str.isdigit():\n+        raise BadRequest(\"invalid cursor\")\n+    return Cursor(created_at=ts, id=int(id_str))\n@@\n-    if cursor is not None:\n-        clauses.append(\"created_at < ?\")\n-        args.append(cursor.created_at)\n+    if cursor is not None:\n+        # Composite key condition to correctly paginate when timestamps are equal.\n+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\n+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\n*** End Patch\nPATCH\n"]
[70.108106, "o", "codeError):\r\n+        raise BadRequest(\"invalid cursor\") from None\r\n+    if \":\" not in text:\r\n+        raise BadRequest(\"invalid cursor\")\r\n+    ts, id_str = text.split(\":\", 1)\r\n+    if not _TIMESTAMP.fullmatch(ts) or not id_str.isdigit():\r\n+        raise BadRequest(\"invalid cursor\")\r\n+    return Cursor(created_at=ts, id=int(id_str))\r\n@@\r\n-    if cursor is not None:\r\n-        clauses.append(\"created_at < ?\")\r\n-        args.append(cursor.created_at)\r\n+    if cursor is not None:\r\n+        # Composite key condition to correctly paginate when timestamps are equal.\r\n+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n*** End Patch\r\nPATCH\r\n"]
