[?2004l[?2004h> +    try:
[?2004l[?2004h> +        text = base64.urlsafe_b64decode((raw + "=" * (-len(raw) % 4)).encode("ascii")).decode("ascii")
[?2004l[?2004h> +    except (ValueError, binascii.Error, UnicodeError):
[?2004l[?2004h> +        raise BadRequest("invalid cursor") from None
[?2004l[?2004h> +    if ":" not in text:
[?2004l[?2004h> +        raise BadRequest("invalid cursor")
[?2004l[?2004h> +    ts, id_str = text.split(":", 1)
