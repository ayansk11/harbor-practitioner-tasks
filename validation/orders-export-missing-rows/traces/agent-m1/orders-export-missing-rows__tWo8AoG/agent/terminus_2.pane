[?2004l[?2004h> got slower and slower, and rows shifted between pages whenever checkout inserted a new order. A keyset page starts
[?2004l[?2004h> right after the last row the client has seen, so it costs the same at any depth and does not move under inserts.
[?2004l[?2004h> 
[?2004l[?2004h> Listings are ordered newest first (created_at DESC, id DESC; docs/API.md). The cursor handed to clients is opaque:
[?2004l[?2004h> base64url of the position of the last row on the page.
[?2004l[?2004h> """
[?2004l[?2004h> import base64
[?2004l[?2004h> import binascii
[?2004l[?2004h> import re
[?2004l[?2004h> from collections import namedtuple
[?2004l[?2004h> 
[?2004l[?2004h> from werkzeug.exceptions import BadRequest
[?2004l[?2004h> 
[?2004l[?2004h> DEFAULT_LIMIT = 100
[?2004l[?2004h> MAX_LIMIT = 500
[?2004l[?2004h> 
[?2004l[?2004h> _TIMESTAMP = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
[?2004l[?2004h> _DIGITS = re.compile(r"[0-9]{1,6}")
[?2004l[?2004h> 
[?2004l[?2004h> Cursor = namedtuple("Cursor", ["created_at", "id"])
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_limit(raw):
[?2004l[?2004h>     """The `limit` query parameter: an integer from 1 to MAX_LIMIT, DEFAULT_LIMIT when absent."""
[?2004l[?2004h>     if raw is None:
[?2004l[?2004h>         return DEFAULT_LIMIT
[?2004l[?2004h>     if not _DIGITS.fullmatch(raw) or not 1 <= int(raw) <= MAX_LIMIT:
[?2004l[?2004h>         raise BadRequest(f"limit must be an integer from 1 to {MAX_LIMIT}")
[?2004l[?2004h>     return int(raw)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def encode_cursor(row):
[?2004l[?2004h>     """Cursor for the page after `row` (the last row of the current page)."""
[?2004l[?2004h>     val = f"{row['created_at']}|{row['id']}"
[?2004l[?2004h>     return base64.urlsafe_b64encode(val.encode("ascii")).decode("ascii").rstrip("=")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def decode_cursor(raw):
[?2004l[?2004h>     """Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400."""
[?2004l[?2004h>     if raw is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     try:
[?2004l[?2004h>         text = base64.urlsafe_b64decode((raw + "=" * (-len(raw) % 4)).encode("ascii")).decode("ascii")
[?2004l[?2004h>     except (ValueError, binascii.Error, UnicodeError):
[?2004l[?2004h>         raise BadRequest("invalid cursor") from None
[?2004l[?2004h>     if "|" not in text:
[?2004l[?2004h>         raise BadRequest("invalid cursor")
[?2004l[?2004h>     created_at, id_str = text.split("|", 1)
[?2004l[?2004h>     if not _TIMESTAMP.fullmatch(created_at) or not id_str.isdigit():
[?2004l[?2004h>         raise BadRequest("invalid cursor")
[?2004l[?2004h>     return Cursor(created_at=created_at, id=int(id_str))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def paginate(con, columns, table, limit, cursor, where="", params=()):
[?2004l[?2004h>     """One page of `SELECT columns FROM table [WHERE where]`, newest first.
[?2004l[?2004h> 
[?2004l[?2004h>     Returns (rows, next_cursor); next_cursor is None on the last page."""
[?2004l[?2004h>     clauses = [where] if where else []
[?2004l[?2004h>     args = list(params)
[?2004l[?2004h>     if cursor is not None:
[?2004l[?2004h>         clauses.append("(created_at < ? OR (created_at = ? AND id < ?))")
[?2004l[?2004h>         args.extend([cursor.created_at, cursor.created_at, cursor.id])
[?2004l[?2004h>     sql = f"SELECT {columns} FROM {table}"
[?2004l[?2004h>     if clauses:
[?2004l[?2004h>         sql += " WHERE " + " AND ".join(f"({c})" for c in clauses)
[?2004l[?2004h>     sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
[?2004l[?2004h>     args.append(limit)
[?2004l[?2004h>     rows = con.execute(sql, args).fetchall()
[?2004l[?2004h>     next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None
[?2004l[?2004h>     return rows, next_cursor
[?2004l[?2004h> EOF
[?2004l[?2004hroot@03657ef7-ca00-43f2-a5f3-33210a1f95d3:/app# cat <<'EOF' > /app/orders_service/queries.py
[?2004l[?2004h> """Queries behind the customer views (account page, support tool)."""
[?2004l[?2004h> from .db import ORDER_COLUMNS
[?2004l[?2004h> from .pagination import encode_cursor
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def customer_exists(con, customer_id):
[?2004l[?2004h>     return con.execute("SELECT 1 FROM customers WHERE id = ?", (customer_id,)).fetchone() is not None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def customer_orders_page(con, customer_id, limit, cursor):
[?2004l[?2004h>     """One page of a customer's orders, newest first. Returns (rows, next_cursor).
[?2004l[?2004h> 
[?2004l[?2004h>     Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index
[?2004l[?2004h>     (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112)."""
[?2004l[?2004h>     sql = f"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?"
[?2004l[?2004h>     args = [customer_id]
[?2004l[?2004h>     if cursor is not None:
[?2004l[?2004h>         sql += " AND (created_at < ? OR (created_at = ? AND id < ?))"
[?2004l[?2004h>         args.extend([cursor.created_at, cursor.created_at, cursor.id])
[?2004l[?2004h>     sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
[?2004l[?2004h>     args.append(limit)
[?2004l[?2004h>     rows = con.execute(sql, args).fetchall()
[?2004l[?2004h>     next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None
[?2004l[?2004h>     return rows, next_cursor
[?2004l[?2004h> EOF
