[73.61157, "o", "Listings are ordered newest first (created_at DESC, id DESC; docs/API.md). The cursor handed to clients is opaque:\r\n\u001b[?2004l\r"]
[73.611584, "o", "\u001b[?2004h> "]
[73.611736, "o", "base64url of the position of the last row on the page.\r\n\u001b[?2004l\r"]
