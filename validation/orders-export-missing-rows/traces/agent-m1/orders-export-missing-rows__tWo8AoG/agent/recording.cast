[73.610628, "o", "\u001b[?2004h> "]
[73.610897, "o", "got slower and slower, and rows shifted between pages whenever checkout inserted a new order. A keyset page starts\r\n\u001b[?2004l\r"]
[73.610939, "o", "\u001b[?2004h> "]
[73.611231, "o", "right after the last row the client has seen, so it costs the same at any depth and does not move under inserts.\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.611243, "o", "> \r\n\u001b[?2004l\r"]
[73.61128, "o", "\u001b[?2004h"]
