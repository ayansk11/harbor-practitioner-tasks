[73.611839, "o", "import base64\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.61185, "o", "> "]
[73.611895, "o", "import binascii\r\n\u001b[?2004l\r"]
[73.611938, "o", "\u001b[?2004h> "]
[73.611975, "o", "import re\r\n\u001b[?2004l\r"]
[73.611997, "o", "\u001b[?2004h> "]
[73.612075, "o", "from collections import namedtuple\r\n\u001b[?2004l\r"]
[73.612085, "o", "\u001b[?2004h> "]
[73.612125, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.612167, "o", "> "]
[73.612235, "o", "from werkzeug.exceptions import BadRequest\r\n\u001b[?2004l\r"]
[73.612273, "o", "\u001b[?2004h"]
[73.612284, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.612335, "o", "DEFAULT_LIMIT = 100\r\n\u001b[?2004l\r"]
[73.61237, "o", "\u001b[?2004h"]
[73.612381, "o", "> "]
[73.6124, "o", "MAX_LIMIT = 500\r\n\u001b[?2004l\r"]
[73.612456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.612663, "o", "_TIMESTAMP = re.compile(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\")\r\n\u001b[?2004l\r"]
[73.612705, "o", "\u001b[?2004h> "]
[73.612782, "o", "_DIGITS = re.compile(r\"[0-9]{1,6}\")\r\n\u001b[?2004l\r"]
[73.612792, "o", "\u001b[?2004h> "]
[73.612839, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.61297, "o", "Cursor = namedtuple(\"Cursor\", [\"created_at\", \"id\"])\r\n\u001b[?2004l\r"]
[73.613019, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.61306, "o", "\u001b[?2004h> "]
[73.613104, "o", "def parse_limit(raw):\r\n\u001b[?2004l\r"]
[73.613145, "o", "\u001b[?2004h> "]
[73.61338, "o", "    \"\"\"The `limit` query parameter: an integer from 1 to MAX_LIMIT, DEFAULT_LIMIT when absent.\"\"\"\r\n\u001b[?2004l\r"]
[73.613422, "o", "\u001b[?2004h> "]
[73.613466, "o", "    if raw is None:\r\n\u001b[?2004l\r"]
[73.613502, "o", "\u001b[?2004h"]
[73.613513, "o", "> "]
[73.613568, "o", "        return DEFAULT_LIMIT\r\n\u001b[?2004l\r"]
[73.61358, "o", "\u001b[?2004h> "]
[73.613772, "o", "    if not _DIGITS.fullmatch(raw) or not 1 <= int(raw) <= MAX_LIMIT:\r\n\u001b[?2004l\r"]
[73.613783, "o", "\u001b[?2004h> "]
[73.613992, "o", "        raise BadRequest(f\"limit must be an integer from 1 to {MAX_LIMIT}\")\r\n\u001b[?2004l\r"]
[73.614005, "o", "\u001b[?2004h> "]
[73.614066, "o", "    return int(raw)\r\n\u001b[?2004l\r"]
[73.614163, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.614207, "o", "def encode_cursor(row):\r\n\u001b[?2004l\r"]
[73.614244, "o", "\u001b[?2004h> "]
[73.614436, "o", "    \"\"\"Cursor for the page after `row` (the last row of the current page).\"\"\"\r\n\u001b[?2004l\r"]
[73.614477, "o", "\u001b[?2004h> "]
[73.614586, "o", "    val = f\"{row['created_at']}|{row['id']}\"\r\n\u001b[?2004l\r"]
[73.614624, "o", "\u001b[?2004h> "]
[73.614835, "o", "    return base64.urlsafe_b64encode(val.encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[73.614878, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.614888, "o", "\r\n\u001b[?2004l\r"]
[73.614929, "o", "\u001b[?2004h> "]
[73.614989, "o", "def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[73.615001, "o", "\u001b[?2004h"]
[73.615043, "o", "> "]
[73.615267, "o", "    \"\"\"Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400.\"\"\"\r\n\u001b[?2004l\r"]
[73.615278, "o", "\u001b[?2004h"]
[73.615287, "o", "> "]
[73.615349, "o", "    if raw is None:\r\n\u001b[?2004l\r"]
[73.61536, "o", "\u001b[?2004h"]
[73.615401, "o", "> "]
[73.615436, "o", "        return None\r\n\u001b[?2004l\r"]
[73.615447, "o", "\u001b[?2004h"]
[73.615456, "o", "> "]
[73.615495, "o", "    try:\r\n\u001b[?2004l\r"]
[73.61553, "o", "\u001b[?2004h> "]
[73.615786, "o", "        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[73.615828, "o", "\u001b[?2004h> "]
[73.615958, "o", "    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[73.616019, "o", "\u001b[?2004h> "]
[73.61613, "o", "        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[73.61617, "o", "\u001b[?2004h> "]
[73.616223, "o", "    if \"|\" not in text:\r\n\u001b[?2004l\r"]
[73.616261, "o", "\u001b[?2004h> "]
[73.616363, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[73.616404, "o", "\u001b[?2004h> "]
[73.616506, "o", "    created_at, id_str = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[73.616546, "o", "\u001b[?2004h> "]
[73.616716, "o", "    if not _TIMESTAMP.fullmatch(created_at) or not id_str.isdigit():\r\n\u001b[?2004l\r"]
[73.616757, "o", "\u001b[?2004h> "]
[73.616858, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[73.616897, "o", "\u001b[?2004h> "]
[73.617048, "o", "    return Cursor(created_at=created_at, id=int(id_str))\r\n\u001b[?2004l\r"]
[73.617059, "o", "\u001b[?2004h"]
[73.617116, "o", "> "]
[73.617167, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.617308, "o", "def paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n\u001b[?2004l\r"]
[73.617328, "o", "\u001b[?2004h> "]
[73.617528, "o", "    \"\"\"One page of `SELECT columns FROM table [WHERE where]`, newest first.\r\n\u001b[?2004l\r"]
[73.617536, "o", "\u001b[?2004h"]
[73.617579, "o", "> \r\n\u001b[?2004l\r"]
[73.617593, "o", "\u001b[?2004h> "]
[73.617774, "o", "    Returns (rows, next_cursor); next_cursor is None on the last page.\"\"\"\r\n\u001b[?2004l\r"]
[73.617818, "o", "\u001b[?2004h> "]
[73.617902, "o", "    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[73.617911, "o", "\u001b[?2004h"]
[73.617944, "o", "> "]
[73.618001, "o", "    args = list(params)\r\n\u001b[?2004l\r"]
[73.61801, "o", "\u001b[?2004h> "]
[73.61809, "o", "    if cursor is not None:\r\n\u001b[?2004l\r"]
[73.618099, "o", "\u001b[?2004h"]
[73.618137, "o", "> "]
[73.618308, "o", "        clauses.append(\"(created_at < ? OR (created_at = ? AND id < ?))\")\r\n\u001b[?2004l\r"]
[73.618316, "o", "\u001b[?2004h"]
[73.618365, "o", "> "]
[73.618515, "o", "        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[73.618556, "o", "\u001b[?2004h> "]
[73.618652, "o", "    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r"]
[73.618693, "o", "\u001b[?2004h> "]
[73.618725, "o", "    if clauses:\r\n\u001b[?2004l\r"]
[73.618735, "o", "\u001b[?2004h> "]
[73.61892, "o", "        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r"]
[73.618963, "o", "\u001b[?2004h> "]
[73.619102, "o", "    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[73.619109, "o", "\u001b[?2004h"]
[73.619159, "o", "> "]
[73.619201, "o", "    args.append(limit)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.619323, "o", "    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[73.619365, "o", "\u001b[?2004h> "]
[73.619547, "o", "    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[73.619588, "o", "\u001b[?2004h> "]
[73.619653, "o", "    return rows, next_cursor\r\n\u001b[?2004l\r"]
[73.619696, "o", "\u001b[?2004h"]
[73.619705, "o", "> EOF\r\n\u001b[?2004l\r"]
[73.621275, "o", "\u001b[?2004h"]
[73.621322, "o", "root@03657ef7-ca00-43f2-a5f3-33210a1f95d3:/app# "]
[73.991511, "i", "cat <<'EOF' > /app/orders_service/queries.py\n\"\"\"Queries behind the customer views (account page, support tool).\"\"\"\nfrom .db import ORDER_COLUMNS\nfrom .pagination import encode_cursor\n\n\ndef customer_exists(con, customer_id):\n    return con.execute(\"SELECT 1 FROM customers WHERE id = ?\", (customer_id,)).fetchone() is not None\n\n\ndef customer_orders_page(con, customer_id, limit, cursor):\n    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\n\n    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index\n    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112).\"\"\"\n    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\n    args = [customer_id]\n    if cursor is not None:\n        sql += \" AND (created_at < ? OR (created_at = ? AND id < ?))\"\n        args.extend([cursor.created_at, cursor.created_at, cursor.id])\n    sql += \" ORDER BY created_at DESC, id "]
[73.991615, "i", "DESC LIMIT ?\"\n    args.append(limit)\n    rows = con.execute(sql, args).fetchall()\n    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\n    return rows, next_cursor\nEOF\n"]
[73.991998, "o", "cat <<'EOF' > /app/orders_service/queries.py\r\n"]
