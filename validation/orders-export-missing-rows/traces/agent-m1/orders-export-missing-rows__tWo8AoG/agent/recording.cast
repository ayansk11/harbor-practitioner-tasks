[74.000352, "o", "\u001b[?2004h"]
[74.000376, "o", "> "]
[74.000931, "o", "        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n"]
[74.000954, "o", "\u001b[?2004l\r"]
[74.000977, "o", "\u001b[?2004h"]
