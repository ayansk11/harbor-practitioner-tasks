[73.995039, "o", "\u001b[?2004h"]
[73.995063, "o", "> "]
[73.995527, "o", "def customer_orders_page(con, customer_id, limit, cursor):\r\n"]
[73.995552, "o", "\u001b[?2004l\r"]
[73.995573, "o", "\u001b[?2004h"]
[73.995597, "o", "> "]
[73.996271, "o", "    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\r\n\u001b[?2004l\r"]
[73.996316, "o", "\u001b[?2004h"]
[73.996346, "o", "> \r\n\u001b[?2004l\r"]
[73.99639, "o", "\u001b[?2004h"]
[73.996415, "o", "> "]
[73.997299, "o", "    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index\r\n\u001b[?2004l\r"]
[73.997344, "o", "\u001b[?2004h"]
[73.997378, "o", "> "]
[73.998255, "o", "    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112).\"\"\"\r\n\u001b[?2004l\r"]
[73.998312, "o", "\u001b[?2004h"]
[73.998352, "o", "> "]
[73.999106, "o", "    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\r\n\u001b[?2004l\r"]
