[?2004l[?2004h> +
[?2004l[?2004h> +def paginate(con, columns, table, limit, cursor, where="", params=()):
[?2004l[?2004h> +    """Retrieve one page of rows.
[?2004l[?2004h> +
[?2004l[?2004h> +    ``con`` – SQLite connection.
[?2004l[?2004h> +    ``columns`` – comma‑separated column list for the ``SELECT`` clause.
[?2004l[?2004h> +    ``table`` – name of the table to query.
[?2004l[?2004h> +    ``limit`` – maximum number of rows to return (already validated).
[?2004l[?2004h> +    ``cursor`` – optional :class:`Cursor` indicating the last row seen.
[?2004l[?2004h> +    ``where`` – additional SQL fragment (without ``WHERE``) for filtering.
[?2004l[?2004h> +    ``params`` – parameters for the additional ``where`` fragment.
[?2004l[?2004h> +
[?2004l[?2004h> +    Returns a tuple ``(rows, next_cursor)`` where ``next_cursor`` is ``None`` on
[?2004l[?2004h> +    the final page.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    clauses = [where] if where else []
[?2004l[?2004h> +    args = list(params)
[?2004l[?2004h> +    if cursor is not None:
[?2004l[?2004h> +        # Keyset condition respecting the ordering (created_at DESC, id DESC).
[?2004l[?2004h> +        # We need rows that are *earlier* than the cursor position:
[?2004l[?2004h> +        #   created_at < cursor.created_at
[?2004l[?2004h> +        #   OR (created_at = cursor.created_at AND id < cursor.id)
[?2004l[?2004h> +        clauses.append("(created_at < ?) OR (created_at = ? AND id < ?)")
[?2004l[?2004h> +        args.extend([cursor.created_at, cursor.created_at, cursor.id])
[?2004l[?2004h> +    sql = f"SELECT {columns} FROM {table}"
[?2004l[?2004h> +    if clauses:
[?2004l[?2004h> +        sql += " WHERE " + " AND ".join(f"({c})" for c in clauses)
[?2004l[?2004h> +    sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
[?2004l[?2004h> +    args.append(limit)
[?2004l[?2004h> +    rows = con.execute(sql, args).fetchall()
[?2004l[?2004h> +    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None
[?2004l[?2004h> +    return rows, next_cursor
