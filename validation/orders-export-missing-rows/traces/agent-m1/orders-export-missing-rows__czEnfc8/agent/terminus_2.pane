[?2004l[?2004h> +    ``|`` separator is safe because timestamps never contain it and ids are
[?2004l[?2004h> +    decimal numbers.  Padding ``=`` characters are stripped for brevity.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    raw = f"{row['created_at']}|{row['id']}"
[?2004l[?2004h> +    return base64.urlsafe_b64encode(raw.encode("ascii")).decode("ascii").rstrip("=")
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def decode_cursor(raw):
[?2004l[?2004h> +    """Parse the ``cursor`` query parameter; ``None`` when absent.
