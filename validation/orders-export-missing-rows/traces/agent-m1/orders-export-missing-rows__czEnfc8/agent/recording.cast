[135.678347, "o", "> "]
[135.678596, "o", "+    Returns an integer between 1 and ``MAX_LIMIT``. If ``raw`` is ``None`` the\r\n\u001b[?2004l\r"]
[135.678629, "o", "\u001b[?2004h> "]
[135.678717, "o", "+    default limit is used.\r\n\u001b[?2004l\r"]
[135.678735, "o", "\u001b[?2004h"]
[135.678755, "o", "> "]
[135.678783, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[135.678801, "o", "\u001b[?2004h> "]
[135.678874, "o", "+    if raw is None:\r\n\u001b[?2004l\r"]
[135.678893, "o", "\u001b[?2004h"]
[135.678912, "o", "> "]
[135.678998, "o", "+        return DEFAULT_LIMIT\r\n\u001b[?2004l\r"]
[135.679035, "o", "\u001b[?2004h> "]
[135.679246, "o", "+    if not _DIGITS.fullmatch(raw) or not 1 <= int(raw) <= MAX_LIMIT:\r\n\u001b[?2004l\r"]
[135.679265, "o", "\u001b[?2004h"]
[135.6793, "o", "> "]
[135.679588, "o", "+        raise BadRequest(f\"limit must be an integer from 1 to {MAX_LIMIT}\")\r\n\u001b[?2004l\r"]
[135.679619, "o", "\u001b[?2004h> "]
[135.679688, "o", "+    return int(raw)\r\n\u001b[?2004l\r"]
[135.679709, "o", "\u001b[?2004h> "]
[135.679729, "o", "+\r\n\u001b[?2004l\r"]
