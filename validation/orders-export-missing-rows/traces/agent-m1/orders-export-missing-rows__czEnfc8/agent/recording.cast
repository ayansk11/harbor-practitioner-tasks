[148.608743, "o", "> "]
[148.609082, "o", "+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[148.609107, "o", "\u001b[?2004h"]
[148.609127, "o", "> "]
[148.609314, "o", "+    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[148.609337, "o", "\u001b[?2004h"]
[148.609355, "o", "> "]
[148.609532, "o", "+        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[148.609559, "o", "\u001b[?2004h"]
[148.609578, "o", "> "]
