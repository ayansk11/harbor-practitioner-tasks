[122.966693, "o", "\u001b[?2004h> "]
[122.96674, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.966824, "o", "+    ``con`` – SQLite connection.\r\n\u001b[?2004l\r"]
[122.966873, "o", "\u001b[?2004h> "]
[122.967094, "o", "+    ``columns`` – comma‑separated column list for the ``SELECT`` clause.\r\n\u001b[?2004l\r"]
[122.96714, "o", "\u001b[?2004h> "]
[122.967267, "o", "+    ``table`` – name of the table to query.\r\n\u001b[?2004l\r"]
[122.967311, "o", "\u001b[?2004h> "]
[122.967528, "o", "+    ``limit`` – maximum number of rows to return (already validated).\r\n\u001b[?2004l\r"]
[122.967575, "o", "\u001b[?2004h> "]
[122.967789, "o", "+    ``cursor`` – optional :class:`Cursor` indicating the last row seen.\r\n\u001b[?2004l\r"]
[122.967845, "o", "\u001b[?2004h> "]
[122.968057, "o", "+    ``where`` – additional SQL fragment (without ``WHERE``) for filtering.\r\n\u001b[?2004l\r"]
[122.968103, "o", "\u001b[?2004h> "]
[122.968304, "o", "+    ``params`` – parameters for the additional ``where`` fragment.\r\n\u001b[?2004l\r"]
[122.968355, "o", "\u001b[?2004h> "]
[122.968402, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.968631, "o", "+    Returns a tuple ``(rows, next_cursor)`` where ``next_cursor`` is ``None`` on\r\n\u001b[?2004l\r"]
[122.968683, "o", "\u001b[?2004h> "]
[122.96873, "o", "+    the final page.\r\n\u001b[?2004l\r"]
[122.968778, "o", "\u001b[?2004h> +    \"\"\"\r\n\u001b[?2004l\r"]
[122.96883, "o", "\u001b[?2004h> "]
[122.968949, "o", "+    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[122.96903, "o", "\u001b[?2004h> "]
[122.969084, "o", "+    args = list(params)\r\n\u001b[?2004l\r"]
[122.969125, "o", "\u001b[?2004h> "]
[122.969166, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[122.969205, "o", "\u001b[?2004h> "]
[122.96945, "o", "+        # Keyset condition respecting the ordering (created_at DESC, id DESC).\r\n\u001b[?2004l\r"]
[122.969479, "o", "\u001b[?2004h> "]
[122.969699, "o", "+        # We need rows that are *earlier* than the cursor position:\r\n\u001b[?2004l\r"]
[122.96974, "o", "\u001b[?2004h> "]
[122.969868, "o", "+        #   created_at < cursor.created_at\r\n\u001b[?2004l\r"]
[122.969999, "o", "\u001b[?2004h> "]
[122.97014, "o", "+        #   OR (created_at = cursor.created_at AND id < cursor.id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.970412, "o", "+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.97062, "o", "+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[122.970669, "o", "\u001b[?2004h> "]
[122.970822, "o", "+    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.970889, "o", "+    if clauses:\r\n\u001b[?2004l\r"]
[122.971004, "o", "\u001b[?2004h> "]
[122.971119, "o", "+        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.97117, "o", "> "]
[122.971336, "o", "+    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[122.971497, "o", "\u001b[?2004h> +    args.append(limit)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.971603, "o", "+    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.971676, "o", "> "]
[122.971869, "o", "+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.971927, "o", "> "]
[122.971992, "o", "+    return rows, next_cursor\r\n\u001b[?2004l\r"]
[122.972025, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[122.972067, "o", "\u001b[?2004h> +EOF\r\n\u001b[?2004l\r"]
[122.972098, "o", "\u001b[?2004h> "]
[123.993996, "i", "python - <<'PY'\nimport importlib, sys, os\nsys.path.insert(0, os.getcwd())\nmod = importlib.import_module('orders_service.pagination')\nprint('Cursor class:', mod.Cursor)\nrow = {'created_at': '2026-10-27T12:00:00Z', 'id': 123}\ncur = mod.encode_cursor(row)\nprint('Encoded cursor:', cur)\nprint('Decoded:', mod.decode_cursor(cur))\nPY\n"]
