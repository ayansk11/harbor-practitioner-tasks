[148.607296, "o", "\u001b[?2004h"]
[148.607315, "o", "> "]
[148.607529, "o", "+    \"\"\"Parse the ``cursor`` query parameter; ``None`` when absent.\r\n\u001b[?2004l\r"]
[148.607551, "o", "\u001b[?2004h"]
[148.607571, "o", "> +\r\n\u001b[?2004l\r"]
[148.607598, "o", "\u001b[?2004h"]
[148.607616, "o", "> "]
[148.607857, "o", "+    The decoded value must match ``\"{timestamp}|{id}\"`` where ``timestamp``\r\n\u001b[?2004l\r"]
[148.60788, "o", "\u001b[?2004h"]
[148.60789, "o", "> "]
[148.608181, "o", "+    conforms to the ISO‑8601 format used by the API and ``id`` is a positive integer.\r\n\u001b[?2004l\r"]
[148.608201, "o", "\u001b[?2004h"]
[148.60822, "o", "> "]
[148.608354, "o", "+    Invalid values raise ``BadRequest``.\r\n\u001b[?2004l\r"]
[148.608376, "o", "\u001b[?2004h"]
[148.608395, "o", "> "]
[148.608417, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[148.60844, "o", "\u001b[?2004h"]
[148.608464, "o", "> "]
