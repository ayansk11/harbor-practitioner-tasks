[84.079716, "o", "\u001b[?2004h"]
[84.079751, "o", "> "]
[84.080323, "o", "+    The decoded value must match ``\"{timestamp}|{id}\"`` where ``timestamp``\r\n\u001b[?2004l\r"]
[84.080377, "o", "\u001b[?2004h"]
[84.080413, "o", "> "]
[84.081053, "o", "+    conforms to the ISO‑8601 format used by the API and ``id`` is a positive\r\n\u001b[?2004l\r"]
[84.081118, "o", "\u001b[?2004h> "]
[84.081606, "o", "+    integer.  Any deviation results in a ``400 Bad Request``.\r\n\u001b[?2004l\r"]
[84.081652, "o", "\u001b[?2004h"]
[84.0817, "o", "> "]
[84.081758, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[84.081805, "o", "\u001b[?2004h"]
[84.081839, "o", "> "]
[84.082001, "o", "+    if raw is None:\r\n\u001b[?2004l\r"]
[84.082056, "o", "\u001b[?2004h"]
[84.08209, "o", "> "]
[84.082269, "o", "+        return None\r\n\u001b[?2004l\r"]
[84.082324, "o", "\u001b[?2004h"]
[84.082363, "o", "> "]
[84.082431, "o", "+    try:\r\n\u001b[?2004l\r"]
[84.082508, "o", "\u001b[?2004h> "]
[84.083321, "o", "+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[84.083374, "o", "\u001b[?2004h"]
[84.083407, "o", "> "]
[84.083845, "o", "+    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[84.083892, "o", "\u001b[?2004h"]
[84.083929, "o", "> "]
[84.084282, "o", "+        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[84.084332, "o", "\u001b[?2004h"]
[84.084368, "o", "> "]
[84.084522, "o", "+    if \"|\" not in text:\r\n\u001b[?2004l\r"]
[84.084565, "o", "\u001b[?2004h"]
[84.0846, "o", "> "]
[84.084857, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[84.084895, "o", "\u001b[?2004h"]
[84.084935, "o", "> "]
[84.085149, "o", "+    ts, id_str = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[84.085192, "o", "\u001b[?2004h"]
[84.085228, "o", "> "]
[84.085659, "o", "+    if not _TIMESTAMP.fullmatch(ts) or not _DIGITS.fullmatch(id_str):\r\n\u001b[?2004l\r"]
[84.0857, "o", "\u001b[?2004h"]
[84.085737, "o", "> "]
[84.085996, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[84.086036, "o", "\u001b[?2004h"]
[84.086076, "o", "> "]
[84.086367, "o", "+    return Cursor(created_at=ts, id=int(id_str))\r\n\u001b[?2004l\r"]
[84.086405, "o", "\u001b[?2004h"]
[84.086441, "o", "> "]
[84.086492, "o", "+\r\n\u001b[?2004l\r"]
[84.08653, "o", "\u001b[?2004h> "]
[84.086567, "o", "+\r\n\u001b[?2004l\r"]
[84.086603, "o", "\u001b[?2004h> "]
[84.087033, "o", "+def paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n\u001b[?2004l\r"]
[84.087074, "o", "\u001b[?2004h"]
[84.087106, "o", "> "]
[84.087314, "o", "+    \"\"\"Retrieve one page of rows.\r\n\u001b[?2004l\r"]
[84.087359, "o", "\u001b[?2004h"]
[84.087397, "o", "> "]
[84.087433, "o", "+\r\n\u001b[?2004l\r"]
[84.087488, "o", "\u001b[?2004h> "]
[84.087694, "o", "+    ``con`` – SQLite connection.\r\n\u001b[?2004l\r"]
[84.087736, "o", "\u001b[?2004h"]
[84.087772, "o", "> "]
[84.088236, "o", "+    ``columns`` – comma‑separated column list for the ``SELECT`` clause.\r\n\u001b[?2004l\r"]
[84.088281, "o", "\u001b[?2004h"]
[84.088311, "o", "> "]
[84.088605, "o", "+    ``table`` – name of the table to query.\r\n\u001b[?2004l\r"]
[84.088639, "o", "\u001b[?2004h"]
[84.088678, "o", "> "]
[84.089114, "o", "+    ``limit`` – maximum number of rows to return (already validated).\r\n\u001b[?2004l\r"]
[84.089156, "o", "\u001b[?2004h"]
[84.089197, "o", "> "]
[84.08965, "o", "+    ``cursor`` – optional :class:`Cursor` indicating the last row seen.\r\n\u001b[?2004l\r"]
[84.089696, "o", "\u001b[?2004h"]
[84.089732, "o", "> "]
[84.090206, "o", "+    ``where`` – additional SQL fragment (without ``WHERE``) for filtering.\r\n\u001b[?2004l\r"]
[84.090248, "o", "\u001b[?2004h"]
[84.090282, "o", "> "]
[84.090711, "o", "+    ``params`` – parameters for the additional ``where`` fragment.\r\n\u001b[?2004l\r"]
[84.09075, "o", "\u001b[?2004h"]
[84.090797, "o", "> "]
[84.090834, "o", "+\r\n\u001b[?2004l\r"]
[84.090869, "o", "\u001b[?2004h> "]
[84.091354, "o", "+    Returns a tuple ``(rows, next_cursor)`` where ``next_cursor`` is ``None`` on\r\n\u001b[?2004l\r"]
[84.091405, "o", "\u001b[?2004h> "]
[84.091551, "o", "+    the final page.\r\n\u001b[?2004l\r"]
[84.091592, "o", "\u001b[?2004h"]
[84.091629, "o", "> "]
[84.091675, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[84.091719, "o", "\u001b[?2004h"]
[84.09176, "o", "> "]
[84.091987, "o", "+    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[84.092043, "o", "\u001b[?2004h"]
[84.092085, "o", "> "]
[84.092222, "o", "+    args = list(params)\r\n\u001b[?2004l\r"]
[84.092265, "o", "\u001b[?2004h"]
[84.092305, "o", "> "]
[84.09248, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[84.092527, "o", "\u001b[?2004h> "]
[84.093031, "o", "+        # Keyset condition respecting the ordering (created_at DESC, id DESC).\r\n\u001b[?2004l\r"]
[84.093072, "o", "\u001b[?2004h"]
[84.093112, "o", "> "]
[84.093535, "o", "+        # We need rows that are *earlier* than the cursor position:\r\n\u001b[?2004l\r"]
[84.093574, "o", "\u001b[?2004h"]
[84.093615, "o", "> "]
[84.093871, "o", "+        #   created_at < cursor.created_at\r\n\u001b[?2004l\r"]
[84.093914, "o", "\u001b[?2004h"]
[84.093955, "o", "> "]
[84.094341, "o", "+        #   OR (created_at = cursor.created_at AND id < cursor.id)\r\n\u001b[?2004l\r"]
[84.094383, "o", "\u001b[?2004h"]
[84.094423, "o", "> "]
[84.110569, "o", "+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n\u001b[?2004l\r"]
[84.110641, "o", "\u001b[?2004h"]
[84.110686, "o", "> "]
[84.111189, "o", "+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[84.111239, "o", "\u001b[?2004h"]
[84.111281, "o", "> "]
[84.111625, "o", "+    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r"]
[84.111686, "o", "\u001b[?2004h"]
[84.11173, "o", "> "]
[84.111848, "o", "+    if clauses:\r\n\u001b[?2004l\r"]
[84.111898, "o", "\u001b[?2004h"]
[84.11194, "o", "> "]
[84.112439, "o", "+        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r"]
[84.112504, "o", "\u001b[?2004h"]
[84.11254, "o", "> "]
[84.112976, "o", "+    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[84.113027, "o", "\u001b[?2004h"]
[84.113063, "o", "> "]
[84.113242, "o", "+    args.append(limit)\r\n"]
[84.113277, "o", "\u001b[?2004l\r"]
[84.113321, "o", "\u001b[?2004h"]
[84.113354, "o", "> "]
[84.113695, "o", "+    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[84.113751, "o", "\u001b[?2004h"]
[84.113784, "o", "> "]
[84.114375, "o", "+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[84.114429, "o", "\u001b[?2004h"]
[84.114485, "o", "> "]
[84.114709, "o", "+    return rows, next_cursor\r\n\u001b[?2004l\r"]
[84.114758, "o", "\u001b[?2004h"]
[84.114794, "o", "> "]
[84.11483, "o", "+\r\n\u001b[?2004l\r"]
[84.114864, "o", "\u001b[?2004h"]
[84.114897, "o", "> "]
[84.114938, "o", "+EOF\r\n\u001b[?2004l\r"]
[84.114983, "o", "\u001b[?2004h"]
[84.115015, "o", "> "]
[85.083254, "i", "python - <<'PY'\nimport importlib, sys, os\nsys.path.insert(0, os.getcwd())\nmod = importlib.import_module('orders_service.pagination')\nprint('Cursor class:', mod.Cursor)\nrow = {'created_at': '2026-10-27T12:00:00Z', 'id': 123}\ncur = mod.encode_cursor(row)\nprint('Encoded cursor:', cur)\nprint('Decoded:', mod.decode_cursor(cur))\nPY\n"]
