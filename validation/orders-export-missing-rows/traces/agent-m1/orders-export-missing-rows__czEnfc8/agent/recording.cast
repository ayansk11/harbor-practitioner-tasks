[43.386511, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.386535, "o", "> "]
[43.386597, "o", "+def encode_cursor(row):\r\n\u001b[?2004l\r"]
[43.386631, "o", "\u001b[?2004h> "]
[43.386788, "o", "+    \"\"\"Encode a cursor for the page after ``row``.\r\n\u001b[?2004l\r"]
[43.386806, "o", "\u001b[?2004h"]
[43.386842, "o", "> +\r\n\u001b[?2004l\r"]
[43.386876, "o", "\u001b[?2004h> "]
[43.387115, "o", "+    The cursor is a base64‑url string containing ``\"{created_at}|{id}\"``.  The\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.387145, "o", "> "]
[43.387375, "o", "+    ``|`` separator is safe because timestamps never contain it and ids are\r\n\u001b[?2004l\r"]
[43.387404, "o", "\u001b[?2004h> "]
[43.387631, "o", "+    decimal numbers.  Padding ``=`` characters are stripped for brevity.\r\n\u001b[?2004l\r"]
[43.387668, "o", "\u001b[?2004h> "]
[43.387702, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[43.387729, "o", "\u001b[?2004h> "]
[43.38786, "o", "+    raw = f\"{row['created_at']}|{row['id']}\"\r\n\u001b[?2004l\r"]
[43.387878, "o", "\u001b[?2004h> "]
[43.388152, "o", "+    return base64.urlsafe_b64encode(raw.encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[43.388178, "o", "\u001b[?2004h> "]
[43.388196, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.388214, "o", "> +\r\n\u001b[?2004l\r"]
[43.388245, "o", "\u001b[?2004h> "]
[43.388331, "o", "+def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[43.388374, "o", "\u001b[?2004h> "]
[43.388595, "o", "+    \"\"\"Parse the ``cursor`` query parameter; ``None`` when absent.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.388638, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.38887, "o", "+    The decoded value must match ``\"{timestamp}|{id}\"`` where ``timestamp``\r\n\u001b[?2004l\r"]
[43.388896, "o", "\u001b[?2004h> "]
[43.389144, "o", "+    conforms to the ISO‑8601 format used by the API and ``id`` is a positive\r\n\u001b[?2004l\r"]
[43.389168, "o", "\u001b[?2004h> "]
[43.389364, "o", "+    integer.  Any deviation results in a ``400 Bad Request``.\r\n\u001b[?2004l\r"]
[43.389399, "o", "\u001b[?2004h> "]
[43.389417, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[43.389447, "o", "\u001b[?2004h> "]
[43.389524, "o", "+    if raw is None:\r\n\u001b[?2004l\r"]
[43.389559, "o", "\u001b[?2004h> "]
[43.389618, "o", "+        return None\r\n\u001b[?2004l\r"]
[43.389652, "o", "\u001b[?2004h> "]
[43.389687, "o", "+    try:\r\n\u001b[?2004l\r"]
[43.389715, "o", "\u001b[?2004h> "]
[43.390027, "o", "+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[43.39005, "o", "\u001b[?2004h> "]
[43.390226, "o", "+    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[43.390261, "o", "\u001b[?2004h> "]
[43.390424, "o", "+        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[43.390446, "o", "\u001b[?2004h> "]
[43.39054, "o", "+    if \"|\" not in text:\r\n\u001b[?2004l\r"]
[43.390559, "o", "\u001b[?2004h> "]
[43.390703, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[43.390737, "o", "\u001b[?2004h> "]
[43.390845, "o", "+    ts, id_str = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[43.390864, "o", "\u001b[?2004h> "]
[43.391124, "o", "+    if not _TIMESTAMP.fullmatch(ts) or not _DIGITS.fullmatch(id_str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.39126, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[43.391283, "o", "\u001b[?2004h> "]
[43.391442, "o", "+    return Cursor(created_at=ts, id=int(id_str))\r\n\u001b[?2004l\r"]
[43.391484, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[43.391503, "o", "\u001b[?2004h> "]
[43.391525, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.391562, "o", "> "]
[43.391782, "o", "+def paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.391809, "o", "> "]
[43.391922, "o", "+    \"\"\"Retrieve one page of rows.\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.391965, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.392005, "o", "> "]
[43.392087, "o", "+    ``con`` – SQLite connection.\r\n\u001b[?2004l\r"]
[43.392122, "o", "\u001b[?2004h> "]
[43.392355, "o", "+    ``columns`` – comma‑separated column list for the ``SELECT`` clause.\r\n\u001b[?2004l\r"]
[43.392383, "o", "\u001b[?2004h> "]
[43.392533, "o", "+    ``table`` – name of the table to query.\r\n\u001b[?2004l\r"]
[43.39256, "o", "\u001b[?2004h> "]
[43.392787, "o", "+    ``limit`` – maximum number of rows to return (already validated).\r\n\u001b[?2004l\r"]
[43.392812, "o", "\u001b[?2004h> "]
[43.393048, "o", "+    ``cursor`` – optional :class:`Cursor` indicating the last row seen.\r\n\u001b[?2004l\r"]
[43.393081, "o", "\u001b[?2004h> "]
[43.393313, "o", "+    ``where`` – additional SQL fragment (without ``WHERE``) for filtering.\r\n\u001b[?2004l\r"]
[43.393351, "o", "\u001b[?2004h> "]
[43.39356, "o", "+    ``params`` – parameters for the additional ``where`` fragment.\r\n\u001b[?2004l\r"]
[43.393601, "o", "\u001b[?2004h> +\r\n"]
[43.393629, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[43.393888, "o", "+    Returns a tuple ``(rows, next_cursor)`` where ``next_cursor`` is ``None`` on\r\n\u001b[?2004l\r"]
[43.393908, "o", "\u001b[?2004h> "]
[43.393984, "o", "+    the final page.\r\n\u001b[?2004l\r"]
[43.394008, "o", "\u001b[?2004h> "]
[43.394043, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[43.394061, "o", "\u001b[?2004h> "]
[43.394195, "o", "+    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[43.394212, "o", "\u001b[?2004h> "]
[43.394304, "o", "+    args = list(params)\r\n\u001b[?2004l\r"]
[43.394327, "o", "\u001b[?2004h> "]
[43.39442, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[43.394463, "o", "\u001b[?2004h> "]
[43.394699, "o", "+        # Keyset condition respecting the ordering (created_at DESC, id DESC).\r\n\u001b[?2004l\r"]
[43.394722, "o", "\u001b[?2004h> "]
[43.39494, "o", "+        # We need rows that are *earlier* than the cursor position:\r\n\u001b[?2004l\r"]
[43.394969, "o", "\u001b[?2004h> "]
[43.395102, "o", "+        #   created_at < cursor.created_at\r\n\u001b[?2004l\r"]
[43.395136, "o", "\u001b[?2004h> "]
[43.39534, "o", "+        #   OR (created_at = cursor.created_at AND id < cursor.id)\r\n\u001b[?2004l\r"]
[43.395374, "o", "\u001b[?2004h> "]
[43.395603, "o", "+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n\u001b[?2004l\r"]
[43.395622, "o", "\u001b[?2004h> "]
[43.395849, "o", "+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[43.395879, "o", "\u001b[?2004h> "]
[43.396013, "o", "+    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r"]
[43.396037, "o", "\u001b[?2004h> "]
[43.396096, "o", "+    if clauses:\r\n\u001b[?2004l\r"]
[43.396122, "o", "\u001b[?2004h> "]
[43.396334, "o", "+        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r"]
[43.396361, "o", "\u001b[?2004h> "]
[43.396542, "o", "+    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[43.396578, "o", "\u001b[?2004h> "]
[43.396645, "o", "+    args.append(limit)\r\n\u001b[?2004l\r"]
[43.396679, "o", "\u001b[?2004h> "]
[43.396816, "o", "+    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[43.396845, "o", "\u001b[?2004h> "]
[43.397083, "o", "+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[43.397119, "o", "\u001b[?2004h> "]
[43.397218, "o", "+    return rows, next_cursor\r\n\u001b[?2004l\r"]
[43.39726, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.3973, "o", "> "]
[43.397343, "o", "*** End Patch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.397367, "o", "PATCH\r\n\u001b[?2004l\r"]
[43.39786, "o", "bash: apply_patch: command not found\r\n"]
[43.39813, "o", "\u001b[?2004hroot@8cbee267-0bfa-4ff7-a2a6-cad9c8cee69f:/app# "]
