[57.16884, "o", "print('Encoded cursor:', cur)\r\n\u001b[?2004l\r"]
[57.168899, "o", "\u001b[?2004h> "]
[57.16915, "o", "print('Decoded:', mod.decode_cursor(cur))\r\n\u001b[?2004l\r"]
