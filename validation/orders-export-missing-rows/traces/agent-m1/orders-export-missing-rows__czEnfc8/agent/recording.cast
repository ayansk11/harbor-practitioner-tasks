[57.167211, "o", "\u001b[?2004h"]
[57.167249, "o", "> "]
[57.167627, "o", "mod = importlib.import_module('orders_service.pagination')\r\n\u001b[?2004l\r"]
[57.167667, "o", "\u001b[?2004h"]
[57.167711, "o", "> "]
[57.16791, "o", "print('Cursor class:', mod.Cursor)\r\n\u001b[?2004l\r"]
[57.167949, "o", "\u001b[?2004h"]
[57.167988, "o", "> "]
[57.168315, "o", "row = {'created_at': '2026-10-27T12:00:00Z', 'id': 123}\r\n\u001b[?2004l\r"]
[57.16838, "o", "\u001b[?2004h"]
