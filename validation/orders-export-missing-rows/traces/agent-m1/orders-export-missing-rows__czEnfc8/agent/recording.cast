[135.679774, "o", "+\r\n\u001b[?2004l\r"]
[135.679796, "o", "\u001b[?2004h> "]
[135.679889, "o", "+def encode_cursor(row):\r\n\u001b[?2004l\r"]
[135.679923, "o", "\u001b[?2004h> "]
[135.680069, "o", "+    \"\"\"Encode a cursor for the page after ``row``.\r\n\u001b[?2004l\r"]
[135.680099, "o", "\u001b[?2004h> "]
[135.680126, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[135.680155, "o", "> "]
[135.680377, "o", "+    The cursor is a base64‑url string containing ``\"{created_at}|{id}\"``.\r\n\u001b[?2004l\r"]
[135.680406, "o", "\u001b[?2004h> "]
[135.680586, "o", "+    Padding ``=`` characters are stripped for brevity.\r\n\u001b[?2004l\r"]
[135.680617, "o", "\u001b[?2004h> "]
[135.680645, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[135.680675, "o", "\u001b[?2004h> "]
[135.680816, "o", "+    raw = f\"{row['created_at']}|{row['id']}\"\r\n\u001b[?2004l\r"]
[135.680839, "o", "\u001b[?2004h> "]
[135.681113, "o", "+    return base64.urlsafe_b64encode(raw.encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[135.681144, "o", "\u001b[?2004h> "]
[135.681168, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[135.681195, "o", "> +\r\n\u001b[?2004l\r"]
[135.681221, "o", "\u001b[?2004h> "]
[135.681297, "o", "+def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[135.681319, "o", "\u001b[?2004h> "]
[135.681542, "o", "+    \"\"\"Parse the ``cursor`` query parameter; ``None`` when absent.\r\n\u001b[?2004l\r"]
[135.681573, "o", "\u001b[?2004h> +\r\n"]
[135.681609, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[135.681845, "o", "+    The decoded value must match ``\"{timestamp}|{id}\"`` where ``timestamp``\r\n\u001b[?2004l\r"]
[135.681877, "o", "\u001b[?2004h> "]
[135.682124, "o", "+    conforms to the ISO‑8601 format used by the API and ``id`` is a positive\r\n\u001b[?2004l\r"]
[135.68216, "o", "\u001b[?2004h> "]
[135.68231, "o", "+    integer. Invalid values raise ``BadRequest``.\r\n\u001b[?2004l\r"]
[135.68233, "o", "\u001b[?2004h"]
[135.682354, "o", "> "]
[135.682388, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[135.682413, "o", "> "]
[135.682478, "o", "+    if raw is None:\r\n\u001b[?2004l\r"]
[135.6825, "o", "\u001b[?2004h> "]
[135.682567, "o", "+        return None\r\n\u001b[?2004l\r"]
[135.682589, "o", "\u001b[?2004h> "]
[135.682633, "o", "+    try:\r\n\u001b[?2004l\r"]
[135.682662, "o", "\u001b[?2004h> "]
[135.682984, "o", "+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[135.683016, "o", "\u001b[?2004h> "]
[135.683192, "o", "+    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[135.683225, "o", "\u001b[?2004h> "]
[135.683379, "o", "+        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[135.683407, "o", "\u001b[?2004h> "]
[135.6835, "o", "+    if \"|\" not in text:\r\n\u001b[?2004l\r"]
[135.68354, "o", "\u001b[?2004h> "]
[135.68368, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[135.683707, "o", "\u001b[?2004h> "]
[135.683827, "o", "+    ts, id_str = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[135.683876, "o", "\u001b[?2004h> "]
[135.684113, "o", "+    if not _TIMESTAMP.fullmatch(ts) or not _DIGITS.fullmatch(id_str):\r\n\u001b[?2004l\r"]
[135.684153, "o", "\u001b[?2004h> "]
[135.684282, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[135.684309, "o", "\u001b[?2004h> "]
[135.684478, "o", "+    return Cursor(created_at=ts, id=int(id_str))\r\n\u001b[?2004l\r"]
[135.684507, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[135.684525, "o", "\u001b[?2004h"]
[135.684545, "o", "> +\r\n\u001b[?2004l\r"]
[135.684562, "o", "\u001b[?2004h"]
[135.68458, "o", "> "]
[135.6848, "o", "+def paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n\u001b[?2004l\r"]
[135.684824, "o", "\u001b[?2004h> "]
[135.684938, "o", "+    \"\"\"Retrieve one page of rows.\r\n\u001b[?2004l\r"]
[135.684962, "o", "\u001b[?2004h> "]
[135.684998, "o", "+\r\n\u001b[?2004l\r"]
[135.685016, "o", "\u001b[?2004h> "]
[135.685121, "o", "+    ``con`` – SQLite connection.\r\n\u001b[?2004l\r"]
[135.68514, "o", "\u001b[?2004h> "]
[135.68539, "o", "+    ``columns`` – comma‑separated column list for the ``SELECT`` clause.\r\n\u001b[?2004l\r"]
[135.685408, "o", "\u001b[?2004h"]
[135.685435, "o", "> "]
[135.685578, "o", "+    ``table`` – name of the table to query.\r\n\u001b[?2004l\r"]
[135.685606, "o", "\u001b[?2004h> "]
[135.685762, "o", "+    ``limit`` – maximum number of rows to return.\r\n\u001b[?2004l\r"]
[135.685784, "o", "\u001b[?2004h> "]
[135.686022, "o", "+    ``cursor`` – optional :class:`Cursor` indicating the last row seen.\r\n\u001b[?2004l\r"]
[135.68604, "o", "\u001b[?2004h"]
[135.686064, "o", "> "]
[135.686248, "o", "+    ``where`` – additional SQL fragment (without ``WHERE``).\r\n\u001b[?2004l\r"]
[135.686266, "o", "\u001b[?2004h"]
[135.686284, "o", "> "]
[135.686501, "o", "+    ``params`` – parameters for the additional ``where`` fragment.\r\n\u001b[?2004l\r"]
[135.686523, "o", "\u001b[?2004h> "]
[135.686546, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[135.686577, "o", "> "]
[135.686841, "o", "+    Returns ``(rows, next_cursor)`` where ``next_cursor`` is ``None`` on the final page.\r\n\u001b[?2004l\r"]
[135.686867, "o", "\u001b[?2004h> "]
[135.686901, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[135.686918, "o", "\u001b[?2004h> "]
[135.687052, "o", "+    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[135.687071, "o", "\u001b[?2004h"]
[135.687089, "o", "> "]
[135.68716, "o", "+    args = list(params)\r\n\u001b[?2004l\r"]
[135.687187, "o", "\u001b[?2004h"]
[135.687212, "o", "> "]
[135.687283, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[135.687317, "o", "\u001b[?2004h> "]
[135.687528, "o", "+        # keyset condition: rows earlier than the cursor position\r\n\u001b[?2004l\r"]
[135.687555, "o", "\u001b[?2004h> "]
[135.687783, "o", "+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n\u001b[?2004l\r"]
[135.687801, "o", "\u001b[?2004h> "]
[135.688031, "o", "+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[135.688067, "o", "\u001b[?2004h> "]
[135.688197, "o", "+    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r"]
[135.688215, "o", "\u001b[?2004h"]
[135.688234, "o", "> "]
[135.688289, "o", "+    if clauses:\r\n\u001b[?2004l\r"]
[135.688332, "o", "\u001b[?2004h> "]
[135.68853, "o", "+        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r"]
[135.688559, "o", "\u001b[?2004h> "]
[135.68873, "o", "+    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[135.688753, "o", "\u001b[?2004h> "]
[135.688834, "o", "+    args.append(limit)\r\n\u001b[?2004l\r"]
[135.688854, "o", "\u001b[?2004h> "]
[135.689006, "o", "+    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[135.689027, "o", "\u001b[?2004h"]
[135.689055, "o", "> "]
[135.689271, "o", "+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[135.68929, "o", "\u001b[?2004h> "]
[135.689396, "o", "+    return rows, next_cursor\r\n\u001b[?2004l\r"]
[135.689428, "o", "\u001b[?2004h> "]
[135.689489, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[135.689533, "o", "> +EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
