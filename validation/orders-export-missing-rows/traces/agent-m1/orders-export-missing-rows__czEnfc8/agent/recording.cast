[148.605739, "o", "+def encode_cursor(row):\r\n\u001b[?2004l\r"]
[148.605763, "o", "\u001b[?2004h"]
[148.605782, "o", "> "]
[148.605946, "o", "+    \"\"\"Encode a cursor for the page after ``row``.\r\n\u001b[?2004l\r"]
[148.605969, "o", "\u001b[?2004h"]
[148.605989, "o", "> +\r\n\u001b[?2004l\r"]
[148.606009, "o", "\u001b[?2004h"]
[148.606028, "o", "> "]
[148.606268, "o", "+    The cursor is a base64‑url string containing ``\"{created_at}|{id}\"``.\r\n\u001b[?2004l\r"]
[148.606292, "o", "\u001b[?2004h"]
[148.60631, "o", "> "]
[148.606499, "o", "+    Padding ``=`` characters are stripped for brevity.\r\n\u001b[?2004l\r"]
[148.606521, "o", "\u001b[?2004h"]
[148.60654, "o", "> "]
[148.606566, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[148.606587, "o", "\u001b[?2004h"]
[148.606606, "o", "> "]
[148.60675, "o", "+    raw = f\"{row['created_at']}|{row['id']}\"\r\n\u001b[?2004l\r"]
[148.606772, "o", "\u001b[?2004h"]
[148.606791, "o", "> "]
[148.607061, "o", "+    return base64.urlsafe_b64encode(raw.encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[148.607082, "o", "\u001b[?2004h"]
[148.607101, "o", "> +\r\n\u001b[?2004l\r"]
