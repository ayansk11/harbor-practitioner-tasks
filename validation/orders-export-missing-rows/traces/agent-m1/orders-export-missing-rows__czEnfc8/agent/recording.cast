[148.610726, "o", "\u001b[?2004h"]
[148.610744, "o", "> "]
[148.610955, "o", "+def paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n\u001b[?2004l\r"]
[148.610981, "o", "\u001b[?2004h"]
[148.611, "o", "> "]
[148.611103, "o", "+    \"\"\"Retrieve one page of rows.\r\n\u001b[?2004l\r"]
[148.611126, "o", "\u001b[?2004h"]
[148.611144, "o", "> +\r\n\u001b[?2004l\r"]
[148.611167, "o", "\u001b[?2004h"]
[148.611185, "o", "> "]
[148.611289, "o", "+    ``con`` – SQLite connection.\r\n\u001b[?2004l\r"]
[148.61131, "o", "\u001b[?2004h"]
[148.61133, "o", "> "]
[148.611583, "o", "+    ``columns`` – comma‑separated column list for the ``SELECT`` clause.\r\n\u001b[?2004l\r"]
[148.611605, "o", "\u001b[?2004h"]
[148.611623, "o", "> "]
[148.611765, "o", "+    ``table`` – name of the table to query.\r\n\u001b[?2004l\r"]
[148.611789, "o", "\u001b[?2004h"]
[148.611808, "o", "> "]
[148.61204, "o", "+    ``limit`` – maximum number of rows to return (already validated).\r\n\u001b[?2004l\r"]
[148.612063, "o", "\u001b[?2004h"]
[148.612081, "o", "> "]
[148.612322, "o", "+    ``cursor`` – optional :class:`Cursor` indicating the last row seen.\r\n\u001b[?2004l\r"]
[148.612343, "o", "\u001b[?2004h"]
[148.612361, "o", "> "]
[148.612576, "o", "+    ``where`` – additional SQL fragment (without ``WHERE``).\r\n\u001b[?2004l\r"]
[148.612598, "o", "\u001b[?2004h"]
[148.612617, "o", "> "]
[148.612846, "o", "+    ``params`` – parameters for the additional ``where`` fragment.\r\n\u001b[?2004l\r"]
[148.612872, "o", "\u001b[?2004h"]
[148.61289, "o", "> +\r\n\u001b[?2004l\r"]
[148.612912, "o", "\u001b[?2004h"]
[148.612931, "o", "> "]
[148.613229, "o", "+    Returns ``(rows, next_cursor)`` where ``next_cursor`` is ``None`` on the final page.\r\n\u001b[?2004l\r"]
[148.613252, "o", "\u001b[?2004h"]
[148.613271, "o", "> "]
[148.613322, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.613362, "o", "> "]
[148.613477, "o", "+    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[148.613513, "o", "\u001b[?2004h"]
[148.613541, "o", "> "]
[148.61359, "o", "+    args = list(params)\r\n\u001b[?2004l\r"]
[148.613628, "o", "\u001b[?2004h> "]
[148.613728, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[148.613761, "o", "\u001b[?2004h"]
[148.613777, "o", "> "]
[148.613966, "o", "+        # keyset condition: rows earlier than the cursor position\r\n\u001b[?2004l\r"]
[148.614005, "o", "\u001b[?2004h> "]
[148.614228, "o", "+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n\u001b[?2004l\r"]
[148.614268, "o", "\u001b[?2004h> "]
[148.614494, "o", "+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[148.614533, "o", "\u001b[?2004h"]
[148.614567, "o", "> "]
[148.614682, "o", "+    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r"]
[148.614718, "o", "\u001b[?2004h> "]
[148.614776, "o", "+    if clauses:\r\n\u001b[?2004l\r"]
[148.614802, "o", "\u001b[?2004h"]
[148.614831, "o", "> "]
[148.615045, "o", "+        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r"]
[148.615076, "o", "\u001b[?2004h"]
[148.61511, "o", "> "]
[148.615258, "o", "+    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[148.615285, "o", "\u001b[?2004h"]
[148.615314, "o", "> "]
[148.61536, "o", "+    args.append(limit)\r\n\u001b[?2004l\r"]
[148.615394, "o", "\u001b[?2004h> "]
[148.615577, "o", "+    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.615628, "o", "> "]
[148.615831, "o", "+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[148.615866, "o", "\u001b[?2004h"]
[148.61588, "o", "> "]
[148.615959, "o", "+    return rows, next_cursor\r\n\u001b[?2004l\r"]
[148.615993, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[148.616024, "o", "\u001b[?2004h> "]
[148.616053, "o", "+EOF\r\n\u001b[?2004l\r"]
[148.616078, "o", "\u001b[?2004h"]
[148.616105, "o", "> "]
[149.622277, "i", "python - <<'PY'\nimport importlib, sys, os\nsys.path.insert(0, os.getcwd())\nmod = importlib.import_module('orders_service.pagination')\nprint('Cursor class:', mod.Cursor)\nrow = {'created_at': '2026-10-27T12:00:00Z', 'id': 123}\ncur = mod.encode_cursor(row)\nprint('Encoded cursor:', cur)\nprint('Decoded:', mod.decode_cursor(cur))\nPY\n"]
