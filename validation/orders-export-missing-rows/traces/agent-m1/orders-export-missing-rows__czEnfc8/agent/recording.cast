[148.60968, "o", "\u001b[?2004h"]
[148.609699, "o", "> "]
[148.609852, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[148.609875, "o", "\u001b[?2004h"]
[148.609893, "o", "> "]
[148.610014, "o", "+    ts, id_str = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[148.610035, "o", "\u001b[?2004h"]
[148.610053, "o", "> "]
[148.610269, "o", "+    if not _TIMESTAMP.fullmatch(ts) or not _DIGITS.fullmatch(id_str):\r\n\u001b[?2004l\r"]
[148.61029, "o", "\u001b[?2004h"]
[148.610308, "o", "> "]
[148.610432, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[148.610458, "o", "\u001b[?2004h"]
[148.610477, "o", "> "]
[148.610623, "o", "+    return Cursor(created_at=ts, id=int(id_str))\r\n\u001b[?2004l\r"]
