[135.677437, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[135.67749, "o", "\u001b[?2004h> "]
[135.67773, "o", "+# Cursor holds both timestamp and primary key to uniquely identify a page position.\r\n\u001b[?2004l\r"]
[135.677764, "o", "\u001b[?2004h> "]
[135.677925, "o", "+Cursor = namedtuple(\"Cursor\", [\"created_at\", \"id\"])\r\n\u001b[?2004l\r"]
[135.677959, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[135.677991, "o", "\u001b[?2004h> +\r\n"]
[135.678022, "o", "\u001b[?2004l\r\u001b[?2004h> "]
