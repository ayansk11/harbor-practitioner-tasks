[160.317725, "i", "cd /app && python3 << 'EOF'\nimport sqlite3, time\ncon = sqlite3.connect('data/orders.db')\ncon.row_factory = sqlite3.Row\n\n# Query plan: first page no cursor\nprint(\"== /orders first page (no cursor), limit 500 ==\")\nfor r in con.execute(\"EXPLAIN QUERY PLAN SELECT id, customer_id, created_at, status, total_cents, currency FROM orders ORDER BY created_at DESC, id DESC LIMIT 500\"):\n    print(dict(r))\n\n# Query plan: cursor page\nprint(\"== /orders cursor page, limit 500 ==\")\nfor r in con.execute(\"EXPLAIN QUERY PLAN SELECT id, customer_id, created_at, status, total_cents, currency FROM orders WHERE (created_at < ? OR (created_at = ? AND id < ?)) ORDER BY created_at DESC, id DESC LIMIT 500\", ('2025-01-01T00:00:00Z','2025-01-01T00:00:00Z', 20000)):\n    print(dict(r))\n\n# Query plan: customer cursor page\nprint(\"== /customers/<id>/orders cursor page, limit 500 ==\")\nfor r in con.execute(\"EXPLAIN QUERY PLAN SELECT id, customer_id, created_at, status, total_cents, currency FROM orders INDEXED BY orders_customer WHERE customer_i"]
[160.317777, "i", "d = ? AND (created_at < ? OR (created_at = ? AND id < ?)) ORDER BY created_at DESC, id DESC LIMIT 500\", (5, '2025-01-01T00:00:00Z','2025-01-01T00:00:00Z', 20000)):\n    print(dict(r))\n\n# Timing\nimport datetime\ndef t(label, fn):\n    s=time.perf_counter(); fn(); e=time.perf_counter()\n    print(f\"{label}: {e-s:.4f}s\")\n\nt(\"/orders first page limit500\", lambda: con.execute(\"SELECT id FROM orders ORDER BY created_at DESC, id DESC LIMIT 500\").fetchall())\nt(\"/orders cursor page limit500\", lambda: con.execute(\"SELECT id FROM orders WHERE (created_at < ? OR (created_at = ? AND id < ?)) ORDER BY created_at DESC, id DESC LIMIT 500\", ('2025-01-01T00:00:00Z','2025-01-01T00:00:00Z',20000)).fetchall())\nt(\"/orders cursor page limit1\", lambda: con.execute(\"SELECT id FROM orders WHERE (created_at < ? OR (created_at = ? AND id < ?)) ORDER BY created_at DESC, id DESC LIMIT 1\", ('2025-01-01T00:00:00Z','2025-01-01T00:00:00Z',20000)).fetchall())\nEOF\n"]
