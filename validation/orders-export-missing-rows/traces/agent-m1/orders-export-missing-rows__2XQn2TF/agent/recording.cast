[200.263299, "i", "te(\"SELECT id,created_at FROM orders\")}\nprint(\"sample backfill check: id max\", max(row))\n# customer\nfor cid in (5,):\n    doc_c=[r['id'] for r in con.execute(\"SELECT id FROM orders WHERE customer_id=? ORDER BY created_at DESC, id DESC\",(cid,))]\n    for lim in (1,20,500):\n        got=walk(f\"/customers/{cid}/orders\",lim)\n        print(f\"cust {cid} limit {lim}: got {len(got)} doc {len(doc_c)} match={got==doc_c}\")\n# exact multiple of limit: last page may be empty -> next_cursor null only on last page\n# check next_cursor null exactly when walk ends\nprint(\"OK\")\nEOF\n"]
