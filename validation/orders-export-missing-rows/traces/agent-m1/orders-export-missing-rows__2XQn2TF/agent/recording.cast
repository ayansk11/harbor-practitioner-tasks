[8.122872, "o", "# orders-api\r\n\r\nRead-only HTTP API over the merchant's orders database (Flask, served by waitress). Contract: `docs/API.md`.\r\nOpen incident: `INCIDENT.md`.\r\n\r\n| Path | What |\r\n|---|---|\r\n| `orders_service/app.py` | routes |\r\n| `orders_service/pagination.py` | `limit` and cursor parsing, the shared keyset pagination helper |\r\n| `orders_service/queries.py` | customer views (account page, support tool) |\r\n| `orders_service/db.py` | one SQLite connection per request, the order fields |\r\n| `orders_service/__main__.py` | `python -m orders_service --db ... --port ...` |\r\n| `tools/export_orders.py` | the nightly finance export (a client of `GET /orders`) |\r\n| `tests/test_api.py` | API tests (pytest, Flask test client, small temporary databases) |\r\n| `data/orders.db` | development copy of the production database, taken when the 2026-10-27 export started |\r\n| `logs/export-2026-10-27.log` | request log of that export |\r\n\r\nRun the service and the export against the development copy:\r\n\r\n```\r\ncd /app\r\npython -m orders_serv"]
[8.12292, "o", "ice --db data/orders.db --port 8080 &\r\npython tools/export_orders.py --base http://127.0.0.1:8080 --limit 200 --out /tmp/orders.csv\r\n```\r\n\r\nRun the tests: `cd /app && python -m pytest -q tests`. Inspect the data: `python -c \"import sqlite3; ...\"` (there is\r\nno `sqlite3` command-line tool in the image).\r\n"]
[8.123148, "o", "\u001b[?2004h"]
[8.123177, "o", "root@fb06ebc6-9b06-4470-a6b4-fbbf1c070d25:/app# "]
[8.585895, "i", "cat /app/tools/export_orders.py\n"]
[8.586041, "o", "cat /app/tools/export_orders.py\r\n\u001b[?2004l\r"]
[8.586981, "o", "\"\"\"Nightly finance export: page through GET /orders and write one CSV row per order.\r\n\r\n    python tools/export_orders.py --base http://127.0.0.1:8080 --limit 200 --out /tmp/orders.csv [--log export.log]\r\n\r\nRuns from cron at 02:00 UTC against production. It only follows next_cursor; it never builds cursors itself.\r\n\"\"\"\r\nimport argparse\r\nimport csv\r\nimport datetime as dt\r\nimport json\r\nimport sys\r\nimport urllib.parse\r\nimport urllib.request\r\n\r\nFIELDS = [\"id\", \"customer_id\", \"created_at\", \"status\", \"total_cents\", \"currency\"]\r\n\r\n\r\ndef now():\r\n    t = dt.datetime.now(dt.timezone.utc)\r\n    return t.strftime(\"%Y-%m-%dT%H:%M:%S.\") + f\"{t.microsecond // 1000:03d}Z\"\r\n\r\n\r\ndef get(base, path, params=None):\r\n    url = base.rstrip(\"/\") + path + (\"?\" + urllib.parse.urlencode(params) if params else \"\")\r\n    with urllib.request.urlopen(url, timeout=60) as resp:\r\n        return resp.status, json.load(resp)\r\n\r\n\r\ndef main():\r\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatte"]
[8.587031, "o", "r)\r\n    ap.add_argument(\"--base\", default=\"http://127.0.0.1:8080\")\r\n    ap.add_argument(\"--limit\", type=int, default=200)\r\n    ap.add_argument(\"--out\", required=True)\r\n    ap.add_argument(\"--log\", help=\"append the request log here (default: stderr)\")\r\n    args = ap.parse_args()\r\n    log = open(args.log, \"a\") if args.log else sys.stderr\r\n    print(f\"# export_orders.py started {now()} base={args.base} limit={args.limit} out={args.out}\", file=log)\r\n    status, body = get(args.base, \"/orders/count\")\r\n    total = body[\"count\"]\r\n    print(f\"{now()} GET /orders/count {status} count={total}\", file=log)\r\n    rows = pages = 0\r\n    cursor = None\r\n    with open(args.out, \"w\", newline=\"\") as f:\r\n        w = csv.writer(f)\r\n        w.writerow(FIELDS)\r\n        while True:\r\n            params = {\"limit\": args.limit}\r\n            if cursor is not None:\r\n                params[\"cursor\"] = cursor\r\n            status, body = get(args.base, \"/orders\", params)\r\n            pages += 1\r\n            for o in body[\"orders\"]:\r\n         "]
[8.587074, "o", "       w.writerow([o[k] for k in FIELDS])\r\n            rows += len(body[\"orders\"])\r\n            shown = \"/orders?\" + \"&\".join(f\"{k}={v}\" for k, v in params.items())\r\n            print(f\"{now()} GET {shown} {status} rows={len(body['orders'])} next_cursor={body['next_cursor'] or 'null'}\",\r\n                  file=log)\r\n            cursor = body[\"next_cursor\"]\r\n            if cursor is None:\r\n                break\r\n    print(f\"# done {now()}: {rows} rows written, {pages} pages, count at start was {total}\", file=log)\r\n    if log is not sys.stderr:\r\n        log.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
