[271.165689, "i", "cd /app && cat > /tmp/conc_test.py << 'PYEOF'\nimport sqlite3, threading, time, json, urllib.request, urllib.parse, sys\nBASE=\"http://127.0.0.1:8099\"\ndef get(path, params=None):\n    url=BASE+path+(\"?\"+urllib.parse.urlencode(params) if params else \"\")\n    with urllib.request.urlopen(url, timeout=10) as r:\n        return json.load(r)\ncon0=sqlite3.connect('/tmp/ins.db'); con0.row_factory=sqlite3.Row\nexisting=[r['id'] for r in con0.execute(\"SELECT id FROM orders\")]  # ids at walk start\nexisting_set=set(existing)\nmaxid=con0.execute(\"SELECT max(id) FROM orders\").fetchone()[0]\nnew_ids=[]\nstop=False\nstop_evt=threading.Event()\ndef inserter():\n    c=sqlite3.connect('/tmp/ins.db')\n    nid=maxid\n    # batch1: normal new orders with fresh timestamps, batch2: backfill high-id old-date\n    ts=f\"2026-11-{(i%28)+1:02d}T00:00:00Z\" \n    while not stop_evt.is_set():\n        c.execute(\"INSERT INTO orders (id, customer_id, created_at, status, total_cents, currency, channel) VALUES (?,?,?,?,?,?,?)\",\n                  (nid,1,f\"2026-11"]
[271.165822, "i", "-{(nid%28)+1:02d}T10:00:00Z\",\"paid\",100,\"USD\",\"web\"))\n        new_ids.append(nid); nid+=1\n        c.execute(\"INSERT INTO orders (id, customer_id, created_at, status, total_cents, currency, channel) VALUES (?,?,?,?,?,?,?)\",\n                  (nid,2,f\"2024-01-01T00:00:00Z\",\"shipped\",200,\"USD\",\"pos_backfill\"))\n        new_ids.append(nid); nid+=1\n        c.commit()\n        time.sleep(0.05)\nth=threading.Thread(target=inserter); th.start()\n\ncount0=get(\"/orders/count\")[\"count\"]\nprint(\"count at start:\", count0, \"existing ids:\", len(existing_set))\nt0=time.time()\nseen=[]; seen_count={}\ncursor=None; pages=0\nwhile True:\n    p={\"limit\":200}\n    if cursor: p[\"cursor\"]=cursor\n    b=get(\"/orders\",p); pages+=1\n    for o in b[\"orders\"]:\n        seen.append(o[\"id\"]); seen_count[o[\"id\"]]=seen_count.get(o[\"id\"],0)+1\n        assert o[\"id\"]==o[\"id\"]\n    cursor=b[\"next_cursor\"]\n    if cursor is None: break\nstop_evt.set(); th.join()\nwalk_sec=time.time()-t0\nprint(f\"walk done: {pages} pages, {len(seen)} ids in {walk_sec:.1f}s\")\n# invar"]
[271.165869, "i", "iants\nmissing=[i for i in existing if i not in seen_count]\nprint(\"existing orders missing from walk:\", len(missing))\ndupes_existing={k:v for k,v in seen_count.items() if k in existing_set and v>1}\ndupes_new={k:v for k,v in seen_count.items() if k not in existing_set and v>1}\nprint(\"duplicated existing:\", len(dupes_existing), \"duplicated new:\", len(dupes_new))\n# order check: returned sequence must be sorted by (created_at DESC, id DESC)\nmm={r['id']:(r['created_at'],r['id']) for r in con0.execute(\"SELECT id,created_at FROM orders\")}\nkeys=[mm[i] for i in seen]\nok=all(keys[i]>=keys[i+1] for i in range(len(keys)-1))\nprint(\"sequence sorted newest-first:\", ok)\nnew_count=get(\"/orders/count\")[\"count\"]\nprint(\"count after inserts:\", new_count, \"(grew from\", count0,\")\")\nassert not missing, \"existing orders lost!\"\nassert not dupes_existing and not dupes_new, \"dupes!\"\nassert ok, \"out of order\"\nassert new_count > count0\nprint(\"ALL CONCURRENT INVARIANTS PASSED\")\nPYEOF\npython3 /tmp/conc_test.py\n"]
