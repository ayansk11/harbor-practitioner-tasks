[169.639713, "i", "cd /app && python3 << 'EOF'\nimport sqlite3\nfrom orders_service import create_app\ncon = sqlite3.connect('data/orders.db'); con.row_factory=sqlite3.Row\n# documented order for /orders\ndoc = [r['id'] for r in con.execute(\"SELECT id FROM orders ORDER BY created_at DESC, id DESC\")]\nprint(\"total documented orders:\", len(doc))\n\napp = create_app('data/orders.db'); c = app.test_client()\ndef walk(path, limit):\n    out, cursor = [], None\n    for _ in range(100000):\n        q={\"limit\":limit};\n        if cursor: q[\"cursor\"]=cursor\n        b=c.get(path, query_string=q).get_json()\n        out += [o['id'] for o in b['orders']]\n        assert len(b['orders']) <= limit\n        if b['next_cursor'] is None:\n            return out\n        cursor=b['next_cursor']\n    raise AssertionError(\"too many pages\")\n\nfor lim in [1, 200, 500]:\n    got = walk(\"/orders\", lim)\n    print(f\"limit {lim}: got {len(got)}, match doc = {got==doc}, unique = {len(set(got))==len(got)}\")\n\n# customer walk\ncid=5\ndoc_c=[r['id'] for r in con.execute(\"SELECT id "]
[169.639798, "i", "FROM orders WHERE customer_id=? ORDER BY created_at DESC, id DESC\",(cid,))]\nfor lim in [1,20,500]:\n    got=walk(f\"/customers/{cid}/orders\", lim)\n    print(f\"cust {cid} limit {lim}: got {len(got)} doc {len(doc_c)} match={got==doc_c}\")\nprint(\"customer 5 order count:\", len(doc_c))\nEOF\n"]
