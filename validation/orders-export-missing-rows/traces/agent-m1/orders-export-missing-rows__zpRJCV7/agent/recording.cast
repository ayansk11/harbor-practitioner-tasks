[190.669001, "o", "\u001b[?2004h"]
[190.669053, "o", "> "]
[190.669182, "o", "    make_db(path, 0)\r\n\u001b[?2004l\r"]
[190.669225, "o", "\u001b[?2004h"]
[190.669265, "o", "> "]
[190.669469, "o", "    con = sqlite3.connect(path)\r\n\u001b[?2004l\r"]
[190.669513, "o", "\u001b[?2004h"]
[190.669553, "o", "> "]
[190.670113, "o", "    # Deliberately write ids in a different order from the requested timestamp order.\r\n\u001b[?2004l\r"]
[190.670158, "o", "\u001b[?2004h"]
[190.670187, "o", "> "]
[190.670321, "o", "    rows = [\r\n\u001b[?2004l\r"]
[190.670365, "o", "\u001b[?2004h> "]
[190.670804, "o", "        (1, 1, \"2026-03-01T10:00:00Z\", \"paid\", 101, \"USD\", \"web\"),\r\n\u001b[?2004l\r"]
[190.670854, "o", "\u001b[?2004h"]
