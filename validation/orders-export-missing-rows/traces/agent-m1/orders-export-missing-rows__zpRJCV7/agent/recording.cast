[510.611675, "i", "python3 - <<'PY'\nimport sqlite3, tempfile\nfrom orders_service import create_app\nSCHEMA='''CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, segment TEXT NOT NULL, created_at TEXT NOT NULL); CREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id), created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL, currency TEXT NOT NULL, channel TEXT NOT NULL); CREATE INDEX orders_created_at ON orders(created_at); CREATE INDEX orders_customer ON orders(customer_id, created_at);'''\npath=tempfile.mktemp(suffix='.db'); con=sqlite3.connect(path); con.executescript(SCHEMA)\nfor i in range(1,41): con.execute(\"INSERT INTO customers VALUES (?,?,?,?,?)\",(i,f'C{i}',f'c{i}@x','retail','2019-01-01T00:00:00Z'))\n# Deliberately reuse one second and put IDs in reverse insertion order for the tie.\nrows=[((i*7)%40+1,1+(i*13)%40,'2020-01-01T00:00:00Z','paid',i,'USD','web') for i in range(1,401)]\nrows.sort(key=lambda r:-r[0])\n"]
[510.611774, "i", "for customer_id,_,_,_,_,_,_ in rows: pass\nfor i,(customer_id,_,created_at,status,total,currency,channel) in enumerate(rows,1):\n    con.execute('INSERT INTO orders (id,customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,?,?,?,?,?)',(i,customer_id,created_at,status,total,currency,channel))\ncon.commit(); con.close()\nclient=create_app(path).test_client()\nfor limit in range(1,501):\n    out=[]; cursor=None\n    for _ in range(1000):\n        q={'limit':limit} if cursor is None else {'limit':limit,'cursor':cursor}\n        r=client.get('/orders',query_string=q)\n        assert r.status_code==200, (limit,r.status_code,r.get_json())\n        b=r.get_json(); out.extend(b['orders']); cursor=b['next_cursor']\n        if cursor is None: break\n    else: raise AssertionError(limit)\n    ids=[o['id'] for o in out]\n    assert ids==sorted(ids,reverse=True), limit\n    assert len(ids)==len(set(ids))==400, limit\n    if limit in (1,100,400,500): print('limit',limit,'OK')\nprint('all 500 page sizes returned 400 unique r"]
