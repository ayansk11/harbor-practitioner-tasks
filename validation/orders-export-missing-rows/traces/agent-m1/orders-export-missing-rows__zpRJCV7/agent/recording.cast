[214.674144, "i", "printf '%s\\n' '--- pagination actual ---'; cat -n /app/orders_service/pagination.py; printf '%s\\n' '--- queries actual ---'; cat -n /app/orders_service/queries.py; printf '%s\\n' '--- checks ---'; python3 - <<'PY'\nfrom orders_service.pagination import encode_cursor, decode_cursor\nimport sqlite3\nc=sqlite3.connect('/app/data/orders.db'); c.row_factory=sqlite3.Row\nr=c.execute('select id,created_at from orders order by created_at desc,id desc limit 1').fetchone()\ns=encode_cursor(r); print(r['id'],r['created_at'],s)\ntry: print(decode_cursor(s))\nexcept Exception as e: print(type(e).__name__,e)\nPY\n"]
