[902.308297, "i", "python3 - <<'PY'\nimport os, sqlite3\ncon=sqlite3.connect('/app/data/orders.db')\nprint('database count:',con.execute('SELECT COUNT(*) FROM orders').fetchone()[0])\nprint('integrity:',con.execute('PRAGMA integrity_check').fetchone()[0])\nprint('orders object:',con.execute(\"SELECT type,name FROM sqlite_master WHERE name='orders'\").fetchone())\nprint('customers object:',con.execute(\"SELECT type,name FROM sqlite_master WHERE name='customers'\").fetchone())\nprint('bytecode dirs remaining:',[os.path.join(r,d) for r,dirs,files in os.walk('/app') for d in dirs if d=='__pycache__'])\nPY\n"]
