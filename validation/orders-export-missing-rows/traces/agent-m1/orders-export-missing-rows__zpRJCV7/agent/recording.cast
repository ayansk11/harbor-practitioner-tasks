[504.345379, "o", "        client = create_app(\u001b[96mstr\u001b[39;49;00m(db)).test_client()\u001b[90m\u001b[39;49;00m\r\n        body = client.get(\u001b[33m\"\u001b[39;49;00m\u001b[33m/orders?limit=5\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).get_json()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(body[\u001b[33m\"\u001b[39;49;00m\u001b[33morders\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]) == \u001b[94m5\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m body[\u001b[33m\"\u001b[39;49;00m\u001b[33mnext_cursor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        body = client.get(\u001b[33m\"\u001b[39;49;00m\u001b[33m/orders\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, query_string={\u001b[33m\"\u001b[39;49;00m\u001b[33mlimit\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94m5\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mcursor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: body[\u001b[33m\"\u001b[39;49;00m\u001b[33mnext_cursor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]}).get_json()\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m body == {\u001b[33m\"\u001b[39;49;00m\u001b[33morders\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: [], \u001b[33m\"\u001b[39;49;00m\u001b[33mnext_cursor\u001b[39;49;00m\u001b[33m\"\u001b[39;49"]
[504.345435, "o", ";00m: \u001b[94mNone\u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: assert {'orders': [{...6MDA6MDdafDE'} == {'orders': []...cursor': None}\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE         Differing items:\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m{\u001b[33m'\u001b[39;49;00m\u001b[33morders\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: [{\u001b[33m'\u001b[39;49;00m\u001b[33mid\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: \u001b[94m5\u001b[39;49;00m, \u001b[33m'\u001b[39;49;00m\u001b[33mcustomer_id\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: \u001b[94m2\u001b[39;49;00m, \u001b[33m'\u001b[39;49;00m\u001b[33mcreated_at\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: \u001b[33m'\u001b[39;49;00m\u001b[33m2026-03-01T10:00:35Z\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m, \u001b[33m'\u001b[39;49;00m\u001b[33mstatus\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: \u001b[33m'\u001b[39;49;00m\u001b[33mpaid\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m, ...}, {\u001b[33m'\u001b[39;49;00m\u001b[33mid\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: \u001b[94m4\u001b[39;49;00m, \u001b[33m'\u001b[39;4...\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE         ...Full output truncated, use '-vv' to show\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_api.py\u001b[0m:157: AssertionError\r\n"]
