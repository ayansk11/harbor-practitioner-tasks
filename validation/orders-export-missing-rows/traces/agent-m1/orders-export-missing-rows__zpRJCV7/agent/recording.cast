[847.063934, "i", "python3 - <<'PY'\nimport sqlite3,tempfile\nfrom orders_service import create_app\nschema='''CREATE TABLE customers(id INTEGER PRIMARY KEY,name TEXT,email TEXT,segment TEXT,created_at TEXT); CREATE TABLE orders(id INTEGER PRIMARY KEY AUTOINCREMENT,customer_id INTEGER,created_at TEXT,status TEXT,total_cents INTEGER,currency TEXT,channel TEXT); CREATE INDEX orders_created_at ON orders(created_at); CREATE INDEX orders_customer ON orders(customer_id,created_at);'''\np=tempfile.mktemp(suffix='.db'); c=sqlite3.connect(p); c.executescript(schema)\nc.executemany(\"INSERT INTO customers VALUES (?,?,?,?,?)\",[(1,'A','a@x','r','2019-01-01T00:00:00Z'),(2,'B','b@x','r','2019-01-01T00:00:00Z')])\nc.executemany(\"INSERT INTO orders(id,customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,'paid',1,'USD','web')\",[(1,1,'2020-01-01T00:00:00Z'),(2,1,'2020-01-01T00:00:00Z'),(3,2,'2020-01-01T00:00:00Z'),(4,2,'2020-01-01T00:00:01Z'),(5,2,'2020-01-01T00:00:01Z')])\nc.commit(); c.close()\nclient=create_app(p).test_client(); fir"]
[847.064041, "i", "st=client.get('/orders?limit=2').get_json(); assert [r['id'] for r in first['orders']]==[5,4]\nw=sqlite3.connect(p)\nw.execute(\"INSERT INTO orders(customer_id,created_at,status,total_cents,currency,channel) VALUES (1,'2020-01-01T00:00:02Z','paid',9,'USD','web')\")\nnew_id=w.execute('SELECT last_insert_rowid()').fetchone()[0]\nw.execute(\"INSERT INTO orders(id,customer_id,created_at,status,total_cents,currency,channel) VALUES (100000,2,'2020-01-01T00:00:00Z','paid',9,'USD','backfill')\")\nw.commit(); w.close()\nids=first['orders']; cursor=first['next_cursor']\nwhile cursor is not None:\n b=client.get('/orders',query_string={'limit':2,'cursor':cursor}).get_json(); ids.extend(b['orders']); cursor=b['next_cursor']\nwalk=[r['id'] for r in ids]\nassert walk[:5]==[5,4,3,2,1] and 100000 in walk and walk.count(100000)==1 and new_id not in walk and len(walk)==len(set(walk)),walk\nprint('global concurrent walk:',walk)\nids=[]; cursor=None\nwhile True:\n q={'limit':2} if cursor is None else {'limit':2,'cursor':cursor}; b=client.get('/cus"]
