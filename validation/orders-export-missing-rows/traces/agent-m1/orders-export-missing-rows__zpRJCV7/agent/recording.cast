[884.480321, "i", "python3 - <<'PY'\nimport os, sqlite3, tempfile, time\np=tempfile.mktemp(suffix='.db')\nc=sqlite3.connect(p)\nc.executescript(\"CREATE TABLE orders(id INTEGER PRIMARY KEY,customer_id INTEGER,created_at TEXT,status TEXT,total_cents INTEGER,currency TEXT,channel TEXT); CREATE INDEX orders_created_at ON orders(created_at);\")\nsql=\"INSERT INTO orders(customer_id,created_at,status,total_cents,currency,channel,id) VALUES (1,'2020-01-01T00:00:00Z','paid',1,'USD','web',?)\"\nc.executemany(sql,[(i,) for i in range(1,100001)])\nc.commit(); c.row_factory=sqlite3.Row\nq='SELECT id FROM orders WHERE (created_at,id)<(?,?) ORDER BY created_at DESC,id DESC LIMIT 500'\nargs=('2020-01-01T00:00:00Z',99500)\nt=time.perf_counter(); rows=c.execute(q,args).fetchall(); dt=time.perf_counter()-t\nids=[r['id'] for r in rows]\nprint('boundary page:',ids[0],ids[-1],len(ids),'seconds',round(dt,6))\nassert ids==list(range(99499,98999,-1))\nprint('plan:',c.execute('EXPLAIN QUERY PLAN '+q,args).fetchall())\nc.close(); os.remove(p)\nPY\n"]
