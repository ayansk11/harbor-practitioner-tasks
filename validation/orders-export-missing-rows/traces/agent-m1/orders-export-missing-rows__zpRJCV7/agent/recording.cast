[622.966449, "i", "python3 - <<'PY'\nimport sqlite3, tempfile\nfrom orders_service import create_app\n\nSCHEMA='''\nCREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, segment TEXT NOT NULL, created_at TEXT NOT NULL);\nCREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id), created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL, currency TEXT NOT NULL, channel TEXT NOT NULL);\nCREATE INDEX orders_created_at ON orders(created_at);\nCREATE INDEX orders_customer ON orders(customer_id, created_at);\n'''\npath=tempfile.mktemp(suffix='.db')\ncon=sqlite3.connect(path); con.executescript(SCHEMA)\ncon.execute(\"INSERT INTO customers VALUES (1,'A','a@x','retail','2019-01-01T00:00:00Z')\")\ncon.execute(\"INSERT INTO customers VALUES (2,'B','b@x','wholesale','2019-01-01T00:00:00Z')\")\ninitial=[(1,1,'2020-01-01T00:00:00Z'),(2,1,'2020-01-01T00:00:00Z'),(3,2,'2020-01-01T00:00:00Z'),(4,2,'2020-01-01T00:00:01Z'),(5,2,'2020-01-01T00:00:01Z')]\ncon."]
[622.966539, "i", "executemany(\"INSERT INTO orders (id,customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,'paid',100,'USD','web')\",initial)\ncon.commit(); con.close()\nclient=create_app(path).test_client()\nfirst=client.get('/orders?limit=2').get_json()\nassert [o['id'] for o in first['orders']]==[5,4]\nwriter=sqlite3.connect(path)\nwriter.execute(\"INSERT INTO orders (customer_id,created_at,status,total_cents,currency,channel) VALUES (1,'2020-01-01T00:00:02Z','paid',900,'USD','web')\")\nnew_id=writer.execute('SELECT last_insert_rowid()').fetchone()[0]\nwriter.execute(\"INSERT INTO orders (id,customer_id,created_at,status,total_cents,currency,channel) VALUES (100000,2,'2020-01-01T00:00:00Z','paid',901,'USD','pos_backfill')\")\nwriter.commit(); writer.close()\nids=list(first['orders']); cursor=first['next_cursor']\nwhile cursor is not None:\n    body=client.get('/orders',query_string={'limit':2,'cursor':cursor}).get_json()\n    ids.extend(body['orders']); cursor=body['next_cursor']\nwalk_ids=[o['id'] for o in ids]\nassert walk"]
[622.966563, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[622.96658, "i", "_ids[:5]==[5,4,3,2,1]\nassert 100000 in walk_ids\nassert walk_ids.count(100000)==1\nassert new_id not in walk_ids\nassert len(walk_ids)==len(set(walk_ids))\nprint('concurrent high-id backfill walk:',walk_ids)\n\nids=[]; cursor=None\nwhile True:\n    q={'limit':2} if cursor is None else {'limit':2,'cursor':cursor}\n    body=client.get('/customers/2/orders',query_string=q).get_json()\n    ids.extend(o['id'] for o in body['orders']); cursor=body['next_cursor']\n    if cursor is None: break\nassert ids==[5,4,3,100000],ids\nprint('customer concurrent walk:',ids)\nPY\n"]
