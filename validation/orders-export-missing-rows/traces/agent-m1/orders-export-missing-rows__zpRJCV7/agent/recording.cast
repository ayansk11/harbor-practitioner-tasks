[990.119339, "i", "python3 - <<'PY'\nimport sqlite3, tempfile\nfrom orders_service import create_app\nschema='''\nCREATE TABLE customers(id INTEGER PRIMARY KEY,name TEXT,email TEXT,segment TEXT,created_at TEXT);\nCREATE TABLE orders(id INTEGER PRIMARY KEY AUTOINCREMENT,customer_id INTEGER,created_at TEXT,status TEXT,total_cents INTEGER,currency TEXT,channel TEXT);\nCREATE INDEX orders_created_at ON orders(created_at);\nCREATE INDEX orders_customer ON orders(customer_id,created_at);\n'''\np=tempfile.mktemp(suffix='.db')\nc=sqlite3.connect(p); c.executescript(schema)\nc.executemany(\"INSERT INTO customers VALUES (?,?,?,?,?)\",[\n (1,'A','a@x','retail','2019-01-01T00:00:00Z'),\n (2,'B','b@x','retail','2019-01-01T00:00:00Z')])\ninitial=[\n (1,1,'2020-01-01T00:00:00Z'),\n (2,1,'2020-01-01T00:00:00Z'),\n (3,2,'2020-01-01T00:00:00Z'),\n (4,2,'2020-01-01T00:00:01Z'),\n (5,2,'2020-01-01T00:00:01Z')]\nc.executemany(\"INSERT INTO orders(id,customer_id,created_at,status,total_cents,currency,channel) VALUES (?,?,?,'paid',1,'USD','web')\",initial)\nc.commit(); c.clo"]
[990.122655, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[990.122676, "i", "se()\nclient=create_app(p).test_client()\nfirst=client.get('/orders?limit=2').get_json()\nassert [r['id'] for r in first['orders']]==[5,4]\nw=sqlite3.connect(p)\nw.execute(\"INSERT INTO orders(customer_id,created_at,status,total_cents,currency,channel) VALUES (1,'2020-01-01T00:00:02Z','paid',9,'USD','web')\")\nnew_id=w.execute('SELECT last_insert_rowid()').fetchone()[0]\nw.execute(\"INSERT INTO orders(id,customer_id,created_at,status,total_cents,currency,channel) VALUES (100000,2,'2020-01-01T00:00:00Z','paid',9,'USD','backfill')\")\nw.commit(); w.close()\nids=first['orders']; cursor=first['next_cursor']\nwhile cursor is not None:\n    body=client.get('/orders',query_string={'limit':2,'cursor':cursor}).get_json()\n    ids.extend(body['orders']); cursor=body['next_cursor']\nwalk=[r['id'] for r in ids]\nassert walk==[5,4,100000,3,2,1],walk\nassert new_id not in walk and len(walk)==len(set(walk))\nprint('global concurrent walk:',walk)\nids=[]; cursor=None\nwhile True:\n    q={'limit':2} if cursor is None else {'limit':2,'cursor':cursor"]
[990.122693, "o", "> import sqlite3, tempfile\r\n\u001b[?2004l\r\u001b[?2004h> from orders_service import create_app\r\n\u001b[?2004l\r\u001b[?2004h> schema='''\r\n\u001b[?2004l\r\u001b[?2004h> CREATE TABLE customers(id INTEGER PRIMARY KEY,name TEXT,email TEXT,segment TEXT,created_at TEXT);\r\n\u001b[?2004l\r\u001b[?2004h> CREATE TABLE orders(id INTEGER PRIMARY KEY AUTOINCREMENT,customer_id INTEGER,created_at TEXT,status TEXT,total_cents INTEGER,currency TEXT,channel TEXT);\r\n\u001b[?2004l\r\u001b[?2004h> CREATE INDEX orders_created_at ON orders(created_at);\r\n\u001b[?2004l\r\u001b[?2004h> CREATE INDEX orders_customer ON orders(customer_id,created_at);\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p=tempfile.mktemp(suffix='.db')\r\n\u001b[?2004l\r\u001b[?2004h> c=sqlite3.connect(p); c.executescript(schema)\r\n\u001b[?2004l\r\u001b[?2004h> c.executemany(\"INSERT INTO customers VALUES (?,?,?,?,?)\",[\r\n\u001b[?2004l\r\u001b[?2004h>  (1,'A','a@x','retail','2019-01-01T00:00:00Z'),\r\n\u001b[?2004l\r\u001b[?2004h>  (2,'B','b@x','retail','2019-01-01T00:00:00Z')])\r\n\u001b[?2004l\r\u001b[?2004h> initial=[\r\n\u001b[?2004l\r"]
