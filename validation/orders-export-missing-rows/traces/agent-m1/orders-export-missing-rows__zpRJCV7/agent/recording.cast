[87.784768, "i", "python3 - <<'PY'\nimport sqlite3,time\nsrc='/app/data/orders.db'; dst='/tmp/orders-benchmark.db'\ntry: __import__('os').remove(dst)\nexcept FileNotFoundError: pass\nc=sqlite3.connect(dst)\nc.execute(\"ATTACH DATABASE ? AS source\",(src,))\nfor name,sql in c.execute(\"attach 'source' as source; select name,sql from source.sqlite_master where type='table' and name in ('orders','customers')\"):\n c.execute(f'CREATE TABLE {name} AS SELECT * FROM source.{name}')\nc.commit()\nq='SELECT id FROM orders WHERE (created_at,id)<(?,?) ORDER BY created_at DESC,id DESC LIMIT 1'\nc.execute(q,('2024-05-16T22:23:55Z',46373)).fetchall()\nfor label in ('existing',):\n t=time.perf_counter(); [c.execute(q,('2024-05-16T22:23:55Z',46373)).fetchone() for _ in range(100)]; print(label,time.perf_counter()-t)\nt=time.perf_counter(); c.execute('CREATE INDEX orders_created_at_id ON orders(created_at,id)'); print('create global index',time.perf_counter()-t)\nt=time.perf_counter(); c.execute('CREATE INDEX orders_customer_created_at_id ON orders(customer_id,cr"]
