[738.883439, "i", "python3 - <<'PY'\nimport os, sqlite3, tempfile, time\nfrom orders_service.pagination import Cursor, paginate\n\npath=tempfile.mktemp(suffix='.db')\ncon=sqlite3.connect(path)\ncon.executescript('''\nCREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id INTEGER NOT NULL, created_at TEXT NOT NULL, status TEXT NOT NULL, total_cents INTEGER NOT NULL, currency TEXT NOT NULL, channel TEXT NOT NULL);\nCREATE INDEX orders_created_at ON orders(created_at);\nCREATE INDEX orders_customer ON orders(customer_id,created_at);\n''')\ncon.executemany(\"INSERT INTO orders (customer_id,created_at,status,total_cents,currency,channel) VALUES (1,'2020-01-01T00:00:00Z','paid',1,'USD','web')\", [(i,) for i in range(1,100001)])\ncon.commit()\ncon.row_factory=sqlite3.Row\n\ndef split_page(cursor, limit):\n    if cursor is None:\n        return con.execute('SELECT id FROM orders ORDER BY created_at DESC,id DESC LIMIT ?',(limit,)).fetchall()\n    rows=con.execute('SELECT id FROM orders WHERE created_at=? AND id<? ORDER BY id DESC LIMIT ?',(cursor.created"]
[738.88353, "i", "_at,cursor.id,limit)).fetchall()\n    if len(rows)<limit:\n        rows += con.execute('SELECT id FROM orders WHERE created_at<? ORDER BY created_at DESC,id DESC LIMIT ?',(cursor.created_at,limit-len(rows))).fetchall()\n    return rows\n\nfor label, fn in [('current row-value', lambda c,l: paginate(con,'id','orders',l,c)[0]), ('split keyset', split_page)]:\n    cursor=None; t=time.perf_counter(); pages=0\n    for _ in range(1000):\n        rows=fn(cursor,500)\n        if not rows: break\n        pages+=1\n        cursor=Cursor(rows[-1]['created_at'],rows[-1]['id'])\n    print(label,'pages',pages,'seconds',round(time.perf_counter()-t,4))\ncon.close(); os.remove(path)\nPY\n"]
