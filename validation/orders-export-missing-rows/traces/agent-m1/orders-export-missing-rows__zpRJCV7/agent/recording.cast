[190.143368, "o", "\r\n\u001b[?2004l\r"]
[190.143395, "o", "\u001b[?2004h> "]
[190.143576, "o", "def _cursor_text(created_at, order_id):\r\n\u001b[?2004l\r"]
[190.143606, "o", "\u001b[?2004h"]
[190.143637, "o", "> "]
[190.14397, "o", "    payload = f\"{_CURSOR_VERSION}:{created_at}:{order_id}\".encode(\"ascii\")\r\n\u001b[?2004l\r"]
[190.144001, "o", "\u001b[?2004h"]
[190.144028, "o", "> "]
[190.144356, "o", "    return base64.urlsafe_b64encode(payload).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[190.144391, "o", "\u001b[?2004h"]
[190.144419, "o", "> \r\n\u001b[?2004l\r"]
[190.144446, "o", "\u001b[?2004h> "]
[190.144473, "o", "\r\n\u001b[?2004l\r"]
[190.1445, "o", "\u001b[?2004h> "]
[190.144634, "o", "def encode_cursor(row):\r\n\u001b[?2004l\r"]
[190.144661, "o", "\u001b[?2004h"]
[190.144689, "o", "> "]
[190.145036, "o", "    \"\"\"Cursor for the page after `row` (the last row of the current page).\"\"\"\r\n\u001b[?2004l\r"]
[190.145065, "o", "\u001b[?2004h"]
[190.145092, "o", "> "]
[190.145331, "o", "    return _cursor_text(row[\"created_at\"], row[\"id\"])\r\n\u001b[?2004l\r"]
