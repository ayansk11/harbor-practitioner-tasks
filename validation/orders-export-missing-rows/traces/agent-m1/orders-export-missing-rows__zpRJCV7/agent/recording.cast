[19.395799, "o", "--- queries.py ---\r\n"]
[19.39725, "o", "\"\"\"Queries behind the customer views (account page, support tool).\"\"\"\r\nfrom .db import ORDER_COLUMNS\r\nfrom .pagination import encode_cursor\r\n\r\n\r\ndef customer_exists(con, customer_id):\r\n    return con.execute(\"SELECT 1 FROM customers WHERE id = ?\", (customer_id,)).fetchone() is not None\r\n\r\n\r\ndef customer_orders_page(con, customer_id, limit, cursor):\r\n    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\r\n\r\n    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index\r\n    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112).\"\"\"\r\n    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\r\n    args = [customer_id]\r\n    if cursor is not None:\r\n        sql += \" AND created_at < ?\"\r\n        args.append(cursor.created_at)\r\n    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n    args.append(limit)\r\n    rows = con.execute(sql, args).fetchall()\r\n    ne"]
[19.397278, "o", "xt_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n    return rows, next_cursor\r\n"]
[19.397493, "o", "--- db.py ---\r\n"]
[19.399384, "o", "\"\"\"One SQLite connection per request. Other systems (checkout, the POS sync, back-office imports) write to the same\r\ndatabase file, so the API never caches rows: every request reads what is committed at that moment.\"\"\"\r\nimport sqlite3\r\n\r\nfrom flask import current_app, g\r\n\r\nORDER_FIELDS = (\"id\", \"customer_id\", \"created_at\", \"status\", \"total_cents\", \"currency\")\r\nORDER_COLUMNS = \", \".join(ORDER_FIELDS)\r\n\r\n\r\ndef get_db():\r\n    if \"db\" not in g:\r\n        con = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=10)\r\n        con.row_factory = sqlite3.Row\r\n        g.db = con\r\n    return g.db\r\n\r\n\r\ndef close_db(_exc=None):"]
[19.399402, "o", "\r\n    con = g.pop(\"db\", None)\r\n    if con is not None:\r\n        con.close()\r\n\r\n\r\ndef order_json(row):\r\n    return {name: row[name] for name in ORDER_FIELDS}\r\n"]
[19.399602, "o", "--- __main__.py ---\r\n"]
[19.400947, "o", "\"\"\"Start the orders API: python -m orders_service --db data/orders.db --port 8080\"\"\"\r\nimport argparse\r\nimport os\r\n\r\nfrom waitress import serve\r\n\r\nfrom .app import create_app\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(prog=\"python -m orders_service\", description=__doc__)\r\n    parser.add_argument(\"--db\", required=True, help=\"path to the SQLite orders database\")\r\n    parser.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    parser.add_argument(\"--port\", type=int, default=8080)\r\n    parser.add_argument(\"--threads\", type=int, default=4)\r\n    args = parser.parse_args()\r\n    if not os.path.isfile(args.db):\r\n        parser.error(f\"database not found: {args.db}\")\r\n    app = create_app(os.path.abspath(args.db))\r\n    serve(app, host=args.host, port=args.port, threads=args.threads, ident=\"orders-api\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[19.401159, "o", "--- export client ---\r\n"]
[19.402165, "o", "\"\"\"Nightly finance export: page through GET /orders and write one CSV row per order.\r\n\r\n    python tools/export_orders.py --base http://127.0.0.1:8080 --limit 200 --out /tmp/orders.csv [--log export.log]\r\n\r\nRuns from cron at 02:00 UTC against production. It only follows next_cursor; it never builds cursors itself.\r\n\"\"\"\r\nimport argparse\r\nimport csv\r\nimport datetime as dt\r\nimport json\r\nimport sys\r\nimport urllib.parse\r\nimport urllib.request\r\n\r\nFIELDS = [\"id\", \"customer_id\", \"created_at\", \"status\", \"total_cents\", \"currency\"]\r\n\r\n\r\ndef now():\r\n    t = dt.datetime.now(dt.timezone.utc)\r\n    return t.strftime(\"%Y-%m-%dT%H:%M:%S.\") + f\"{t.microsecond // 1000:03d}Z\"\r\n\r\n\r\ndef get(base, path, params=None):\r\n    url = base.rstrip(\"/\") + path + (\"?\" + urllib.parse.urlencode(params) if params else \"\")\r\n    with urllib.request.urlopen(url, timeout=60) as resp:\r\n        return resp.status, json.load(resp)\r\n\r\n\r\ndef main():\r\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatte"]
[19.402214, "o", "r)\r\n    ap.add_argument(\"--base\", default=\"http://127.0.0.1:8080\")\r\n    ap.add_argument(\"--limit\", type=int, default=200)\r\n    ap.add_argument(\"--out\", required=True)\r\n    ap.add_argument(\"--log\", help=\"append the request log here (default: stderr)\")\r\n    args = ap.parse_args()\r\n    log = open(args.log, \"a\") if args.log else sys.stderr\r\n    print(f\"# export_orders.py started {now()} base={args.base} limit={args.limit} out={args.out}\", file=log)\r\n    status, body = get(args.base, \"/orders/count\")\r\n    total = body[\"count\"]\r\n    print(f\"{now()} GET /orders/count {status} count={total}\", file=log)\r\n    rows = pages = 0\r\n    cursor = None\r\n    with open(args.out, \"w\", newline=\"\") as f:\r\n        w = csv.writer(f)\r\n        w.writerow(FIELDS)\r\n        while True:\r\n            params = {\"limit\": args.limit}\r\n            if cursor is not None:\r\n                params[\"cursor\"] = cursor\r\n            status, body = get(args.base, \"/orders\", params)\r\n            pages += 1\r\n            for o in body[\"orders\"]:\r\n         "]
[19.402254, "o", "       w.writerow([o[k] for k in FIELDS])\r\n            rows += len(body[\"orders\"])\r\n            shown = \"/orders?\" + \"&\".join(f\"{k}={v}\" for k, v in params.items())\r\n            print(f\"{now()} GET {shown} {status} rows={len(body['orders'])} next_cursor={body['next_cursor'] or 'null'}\",\r\n                  file=log)\r\n            cursor = body[\"next_cursor\"]\r\n            if cursor is None:\r\n                break\r\n    print(f\"# done {now()}: {rows} rows written, {pages} pages, count at start was {total}\", file=log)\r\n    if log is not sys.stderr:\r\n        log.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
