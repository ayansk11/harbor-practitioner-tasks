[30.934772, "i", "python3 - <<'PY'\nimport base64, sqlite3\nc=sqlite3.connect('/app/data/orders.db')\nprint('tie groups with ranges:')\nfor created,n,lo,hi in c.execute('select created_at,count(*) n,min(id),max(id) from orders group by created_at having n>1 order by n desc limit 12'):\n print(created,n,lo,hi)\nprint('decoded first/last logged cursors:')\nfor s in ['MjAyNi0wNy0yNVQwNjowNDoxM1o','MjAyNC0wMS0xOFQwOToxMToxN1o']:\n print(s, base64.urlsafe_b64decode(s+'='*(-len(s)%4)).decode())\nprint('query plan without cursor:')\nfor row in c.execute('explain query plan select * from orders order by created_at desc,id desc limit 100'): print(row)\nPY\n"]
