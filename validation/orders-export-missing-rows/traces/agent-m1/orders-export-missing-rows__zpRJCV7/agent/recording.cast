[436.694996, "i", "python3 - <<'PY'\nimport csv, sqlite3\nwith open('/tmp/incident-export.csv', newline='') as f:\n    rows=list(csv.DictReader(f))\nids=[int(r['id']) for r in rows]\ncon=sqlite3.connect('/app/data/orders.db')\nexpected=[r[0] for r in con.execute('SELECT id FROM orders ORDER BY created_at DESC, id DESC')]\nprint('export rows:',len(ids))\nprint('database count:',con.execute('select count(*) from orders').fetchone()[0])\nprint('order exactly matches contract:',ids==expected)\nprint('unique:',len(ids)==len(set(ids)))\nprint('missing:',len(set(expected)-set(ids)),'extra:',len(set(ids)-set(expected)))\nPY\n"]
[436.695117, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[436.695176, "o", "\u001b[?2004h> "]
