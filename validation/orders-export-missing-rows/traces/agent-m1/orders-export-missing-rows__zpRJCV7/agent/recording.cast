[980.27002, "i", "python3 - <<'PY'\nimport os, sqlite3, tempfile, time\np=tempfile.mktemp(suffix='.db')\nc=sqlite3.connect(p)\nc.executescript(\"CREATE TABLE orders(id INTEGER PRIMARY KEY,customer_id INTEGER,created_at TEXT,status TEXT,total_cents INTEGER,currency TEXT,channel TEXT); CREATE INDEX orders_created_at ON orders(created_at);\")\nsql=\"INSERT INTO orders(id,customer_id,created_at,status,total_cents,currency,channel) VALUES (?,1,'2020-01-01T00:00:00Z','paid',1,'USD','web')\"\nc.executemany(sql,[(i,) for i in range(1,100001)])\nc.commit(); c.row_factory=sqlite3.Row\nqueries={\n 'row_value':('SELECT id FROM orders WHERE (created_at,id)<(?,?) ORDER BY created_at DESC,id DESC LIMIT 500',('2020-01-01T00:00:00Z',99500)),\n 'same_second':('SELECT id FROM orders WHERE created_at=? AND id<? ORDER BY id DESC LIMIT 500',('2020-01-01T00:00:00Z',99500)),\n}\nfor name,(q,args) in queries.items():\n    t=time.perf_counter(); rows=c.execute(q,args).fetchall(); dt=time.perf_counter()-t\n    print(name,'page',rows[0]['id'],rows[-1]['id'],len(rows),'sec"]
[980.270188, "i", "onds',round(dt,6))\n    print('  plan:',c.execute('EXPLAIN QUERY PLAN '+q,args).fetchall())\nc.close(); os.remove(p)\nPY\n"]
