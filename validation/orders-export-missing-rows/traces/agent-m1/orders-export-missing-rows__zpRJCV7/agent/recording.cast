[286.459589, "i", "sed -n '55,105p' /app/orders_service/pagination.py\npython3 - <<'PY'\nimport base64\nfrom orders_service.pagination import _CURSOR,_CURSOR_VERSION,_cursor_text,_validate_timestamp,decode_cursor\ncreated='2026-10-27T01:53:21Z'; oid=46000\nraw=_cursor_text(created,oid)\npadded=raw+'='*(-len(raw)%4)\ntext=base64.urlsafe_b64decode(padded.encode('ascii')).decode('ascii')\nparts=text.split(':')\nprint('raw=',repr(raw),'len=',len(raw))\nprint('raw_match=',bool(_CURSOR.fullmatch(raw)))\nprint('decoded=',repr(text),'parts=',parts)\nprint('version_match=',parts[0]==_CURSOR_VERSION)\nprint('timestamp_match=',_validate_timestamp(parts[1]))\nprint('id_match=',parts[2].isdigit())\nprint('reencoded_equal=',_cursor_text(parts[1],int(parts[2]))==raw)\ntry:\n    print('decoded_cursor=',decode_cursor(raw))\nexcept Exception as exc:\n    print('decode_error=',repr(exc))\nPY\n"]
[286.459845, "o", "sed -n '55,105p' /app/orders_service/pagination.py\r\n\u001b[?2004l\r"]
[286.461159, "o", "        datetime.strptime(value, \"%Y-%m-%dT%H:%M:%SZ\")\r\n    except ValueError:\r\n        return False\r\n    return True\r\n\r\n\r\ndef decode_cursor(raw):\r\n    \"\"\"Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400.\"\"\"\r\n    if raw is None:\r\n        return None\r\n    if not _CURSOR.fullmatch(raw):\r\n        raise BadRequest(\"invalid cursor\")\r\n    try:\r\n        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n"]
[286.461214, "o", "    except (ValueError, binascii.Error, UnicodeError):\r\n        raise BadRequest(\"invalid cursor\") from None\r\n    parts = text.split(\":\")\r\n    if len(parts) != 3 or parts[0] != _CURSOR_VERSION or not _validate_timestamp(parts[1]):\r\n        raise BadRequest(\"invalid cursor\")\r\n    if not parts[2].isdigit():\r\n        raise BadRequest(\"invalid cursor\")\r\n    order_id = int(parts[2])\r\n    if order_id > _MAX_SQLITE_INTEGER or _cursor_text(parts[1], order_id) != raw:\r\n        raise BadRequest(\"invalid cursor\")\r\n    return Cursor(created_at=parts[1], id=order_id)\r\n\r\n\r\ndef paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n    \"\"\"One page of `SELECT columns FROM table [WHERE where]`, newest first.\r\n\r\n    Returns (rows, next_cursor); next_cursor is None on the last page. The row-value predicate is the strict part of\r\n    (created_at DESC, id DESC) that follows the last row, so all orders sharing its timestamp remain on later pages.\r\n    \"\"\"\r\n    clauses = [where] if where else []\r\n    args = list(params"]
[286.461261, "o", ")\r\n    if cursor is not None:\r\n        clauses.append(\"(created_at, id) < (?, ?)\")\r\n        args.extend((cursor.created_at, cursor.id))\r\n    sql = f\"SELECT {columns} FROM {table}\"\r\n    if clauses:\r\n        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n    args.append(limit)\r\n    rows = con.execute(sql, args).fetchall()\r\n    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n    return rows, next_cursor\r\n"]
