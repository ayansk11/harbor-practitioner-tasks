[215.24185, "i", "python3 - <<'PY'\nimport os, sqlite3, time\nsrc='/app/data/orders.db'; dst='/tmp/orders-benchmark.db'\ntry: os.remove(dst)\nexcept FileNotFoundError: pass\ncon=sqlite3.connect(dst)\ncon.execute(\"ATTACH DATABASE ? AS source\",(src,))\nfor typ,name,sql in con.execute(\"select type,name,sql from source.sqlite_master where type in ('table','index') and sql is not null\").fetchall():\n    if typ=='table' and name in ('orders','customers'):\n        con.execute(sql)\nfor typ,name,sql in con.execute(\"select type,name,sql from source.sqlite_master where type in ('table','index') and sql is not null\").fetchall():\n    if typ=='index' and name in ('orders_created_at','orders_customer'):\n        con.execute(sql)\ncon.execute('INSERT INTO customers SELECT * FROM source.customers')\ncon.execute('INSERT INTO orders SELECT * FROM source.orders')\ncon.commit()\ncreated, oid = '2024-05-16T22:23:55Z', 46373\nqueries = {\n    'row_value': ('SELECT id FROM orders WHERE (created_at,id)<(?,?) ORDER BY created_at DESC,id DESC LIMIT 200',(created,oid))"]
[215.241961, "i", ",\n    'expanded_or': ('SELECT id FROM orders WHERE (created_at<? OR (created_at=? AND id<?)) ORDER BY created_at DESC,id DESC LIMIT 200',(created,created,oid)),\n    'le_and_row_value': ('SELECT id FROM orders WHERE created_at<=? AND (created_at,id)<(?,?) ORDER BY created_at DESC,id DESC LIMIT 200',(created,created,oid)),\n}\nfor name,(q,args) in queries.items():\n    print('\\n',name,con.execute('explain query plan '+q,args).fetchall())\n    con.execute(q,args).fetchall()\n    t=time.perf_counter()\n    for _ in range(200): con.execute(q,args).fetchall()\n    print('seconds:',time.perf_counter()-t)\ncq='SELECT id FROM orders INDEXED BY orders_customer WHERE customer_id=? AND (created_at<? OR (created_at=? AND id<?)) ORDER BY created_at DESC,id DESC LIMIT 20'\ncargs=(5,created,created,oid)\nprint('\\ncustomer expanded plan:',con.execute('explain query plan '+cq,cargs).fetchall())\nt=time.perf_counter()\nfor _ in range(200): con.execute(cq,cargs).fetchall()\nprint('customer seconds:',time.perf_counter()-t)\ncon.close()\nPY\n"]
