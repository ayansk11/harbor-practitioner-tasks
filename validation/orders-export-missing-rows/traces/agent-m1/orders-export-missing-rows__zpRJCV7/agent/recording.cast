[259.153049, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_exact_multiple_ends_with_an_empty_page\u001b[39;49;00m(client):\u001b[90m\u001b[39;49;00m\r\n        body = client.get(\u001b[33m\"\u001b[39;49;00m\u001b[33m/orders?limit=5\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).get_json()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(body[\u001b[33m\"\u001b[39;49;00m\u001b[33morders\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]) == \u001b[94m5\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m body[\u001b[33m\"\u001b[39;49;00m\u001b[33mnext_cursor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[259.153092, "o", "        body = client.get(\u001b[33m\"\u001b[39;49;00m\u001b[33m/orders\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, query_string={\u001b[33m\"\u001b[39;49;00m\u001b[33mlimit\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94m5\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mcursor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: body[\u001b[33m\"\u001b[39;49;00m\u001b[33mnext_cursor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]}).get_json()\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m body == {\u001b[33m\"\u001b[39;49;00m\u001b[33morders\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: [], \u001b[33m\"\u001b[39;49;00m\u001b[33mnext_cursor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94mNone\u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\r\n"]
[259.153151, "o", "\u001b[1m\u001b[31mE       AssertionError: assert {'error': 'invalid cursor'} == {'orders': []...cursor': None}\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE         Left contains 1 more item:\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m{\u001b[33m'\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: \u001b[33m'\u001b[39;49;00m\u001b[33minvalid cursor\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\u001b[0m\r\n\u001b[1m\u001b[31mE         Right contains 2 more items:\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m{\u001b[33m'\u001b[39;49;00m\u001b[33mnext_cursor\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: \u001b[94mNone\u001b[39;49;00m, \u001b[33m'\u001b[39;49;00m\u001b[33morders\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m: []}\u001b[90m\u001b[39;49;00m\u001b[0m\r\n\u001b[1m\u001b[31mE         Use -v to get more diff\u001b[0m\r\n"]
