[624.981489, "i", "python3 - <<'PY'\nimport sqlite3\nfrom orders_service import create_app\napp=create_app('/app/data/orders.db'); client=app.test_client()\nassert client.get('/orders/count').get_json()=={'count':48213}\nassert client.get('/orders/46000').status_code==200\nassert client.get('/orders/999999999').status_code==404\nassert client.get('/customers/999999999/orders').status_code==404\nfor query in ('limit=0','limit=501','limit=-1','limit=ten','cursor=not-a-cursor','cursor='+('a'*10000)):\n    response=client.get('/orders?'+query)\n    assert response.status_code==400,(query,response.status_code)\nfor path,limit in (('/orders',97),('/customers/5/orders',20)):\n    ids=[]; cursor=None\n    while True:\n        q={'limit':limit} if cursor is None else {'limit':limit,'cursor':cursor}\n        body=client.get(path,query_string=q).get_json(); ids.extend(o['id'] for o in body['orders']); cursor=body['next_cursor']\n        if cursor is None: break\n    con=sqlite3.connect('/app/data/orders.db')\n    where='' if path=='/orders' else 'WHERE cus"]
[624.981581, "i", "tomer_id=5'\n    expected=[r[0] for r in con.execute(f'SELECT id FROM orders {where} ORDER BY created_at DESC,id DESC')]\n    con.close()\n    assert ids==expected\n    print(path,'limit',limit,'rows',len(ids),'OK')\nprint('endpoint/error acceptance checks OK')\nPY\nps aux | grep '[p]ython3 -m orders_service' || true\n"]
