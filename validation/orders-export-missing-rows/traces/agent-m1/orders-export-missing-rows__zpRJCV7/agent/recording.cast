[354.978141, "i", "python3 - <<'PY'\nimport sqlite3,time\nc=sqlite3.connect('/app/data/orders.db')\ncreated, oid = '2024-05-16T22:23:55Z', 30000\nqueries = {\n    'row_value': ('select count(*) from orders where (created_at,id)<(?,?)',(created,oid)),\n    'explicit': ('select count(*) from orders where created_at<? or (created_at=? and id<?)',(created,created,oid)),\n    'same_tie': ('select count(*) from orders where created_at=? and id<?',(created,oid)),\n}\nfor name,(q,args) in queries.items():\n    print(name,c.execute(q,args).fetchone()[0])\nq='select count(*) from orders where (created_at,id)<(?,?)'\nprint('plan',c.execute('explain query plan '+q,(created,oid)).fetchall())\nprint('remaining at tie:',c.execute('select min(id),max(id) from orders where created_at=? and id<?',(created,oid)).fetchone())\ncq='select count(*) from orders indexed by orders_customer where customer_id=? and (created_at,id)<(?,?)'\nprint('customer row-value plan',c.execute('explain query plan '+cq,(5,created,oid)).fetchall())\nPY\n"]
