[29.327307, "o", "     1\t\"\"\"Flask application for the orders API. Endpoints and response formats: docs/API.md.\"\"\"\r\n     2\tfrom flask import Flask, abort, jsonify, request\r\n     3\tfrom werkzeug.exceptions import HTTPException\r\n     4\t\r\n"]
[29.327375, "o", "     5\tfrom . import db, pagination, queries\r\n     6\t\r\n     7\t\r\n     8\tdef create_app(database):\r\n     9\t    app = Flask(__name__)\r\n    10\t    app.config[\"DATABASE\"] = database\r\n    11\t    app.json.sort_keys = False\r\n    12\t    app.teardown_appcontext(db.close_db)\r\n    13\t\r\n    14\t    @app.errorhandler(HTTPException)\r\n    15\t    def http_error(exc):\r\n    16\t        return jsonify(error=exc.description), exc.code\r\n    17\t\r\n    18\t    @app.get(\"/orders\")\r\n    19\t    def list_orders():\r\n    20\t        limit = pagination.parse_limit(request.args.get(\"limit\"))\r\n    21\t        cursor = pagination.decode_cursor(request.args.get(\"cursor\"))\r\n    22\t        rows, next_cursor = pagination.paginate(db.get_db(), db.ORDER_COLUMNS, \"orders\", limit, cursor)\r\n    23\t        return jsonify(orders=[db.order_json(r) for r in rows], next_cursor=next_cursor)\r\n    24\t\r\n    25\t    @app.get(\"/orders/count\")\r\n    26\t    def count_orders():\r\n    27\t        (n,) = db.get_db().execute(\"SELECT COUNT(*) FROM orders\").fetchone()\r\n    28\t   "]
[29.327438, "o", "     return jsonify(count=n)\r\n    29\t\r\n    30\t    @app.get(\"/orders/<int:order_id>\")\r\n    31\t    def get_order(order_id):\r\n    32\t        row = db.get_db().execute(f\"SELECT {db.ORDER_COLUMNS} FROM orders WHERE id = ?\", (order_id,)).fetchone()\r\n    33\t        if row is None:\r\n    34\t            abort(404, description=\"order not found\")\r\n    35\t        return jsonify(db.order_json(row))\r\n    36\t\r\n    37\t    @app.get(\"/customers/<int:customer_id>/orders\")\r\n    38\t    def customer_orders(customer_id):\r\n    39\t        con = db.get_db()\r\n"]
[29.327482, "o", "    40\t        if not queries.customer_exists(con, customer_id):\r\n    41\t            abort(404, description=\"customer not found\")\r\n    42\t        limit = pagination.parse_limit(request.args.get(\"limit\"))\r\n    43\t        cursor = pagination.decode_cursor(request.args.get(\"cursor\"))\r\n    44\t        rows, next_cursor = queries.customer_orders_page(con, customer_id, limit, cursor)\r\n    45\t        return jsonify(orders=[db.order_json(r) for r in rows], next_cursor=next_cursor)\r\n    46\t\r\n    47\t    return app\r\n"]
