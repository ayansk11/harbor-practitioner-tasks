[190.145381, "o", "> \r\n\u001b[?2004l\r"]
[190.145415, "o", "\u001b[?2004h"]
[190.145442, "o", "> \r\n\u001b[?2004l\r"]
[190.145478, "o", "\u001b[?2004h> "]
[190.145643, "o", "def _validate_timestamp(value):\r\n\u001b[?2004l\r"]
[190.145674, "o", "\u001b[?2004h"]
[190.145702, "o", "> "]
[190.14588, "o", "    if not _TIMESTAMP.fullmatch(value):\r\n\u001b[?2004l\r"]
[190.145914, "o", "\u001b[?2004h"]
[190.145941, "o", "> "]
[190.146033, "o", "        return False\r\n\u001b[?2004l\r"]
[190.146064, "o", "\u001b[?2004h"]
[190.146091, "o", "> "]
[190.146133, "o", "    try:\r\n\u001b[?2004l\r"]
[190.146168, "o", "\u001b[?2004h"]
[190.146195, "o", "> "]
[190.146442, "o", "        datetime.strptime(value, \"%Y-%m-%dT%H:%M:%SZ\")\r\n\u001b[?2004l\r"]
[190.146469, "o", "\u001b[?2004h"]
[190.146496, "o", "> "]
[190.1466, "o", "    except ValueError:\r\n\u001b[?2004l\r"]
[190.146643, "o", "\u001b[?2004h"]
[190.14668, "o", "> "]
[190.146765, "o", "        return False\r\n\u001b[?2004l\r"]
[190.146795, "o", "\u001b[?2004h"]
[190.146821, "o", "> "]
[190.146895, "o", "    return True\r\n\u001b[?2004l\r"]
[190.146927, "o", "\u001b[?2004h"]
[190.146954, "o", "> \r\n\u001b[?2004l\r"]
[190.14698, "o", "\u001b[?2004h"]
[190.147007, "o", "> \r\n\u001b[?2004l\r"]
[190.147034, "o", "\u001b[?2004h> "]
[190.147159, "o", "def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[190.147189, "o", "\u001b[?2004h"]
[190.147215, "o", "> "]
[190.147631, "o", "    \"\"\"Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400.\"\"\"\r\n\u001b[?2004l\r"]
[190.14766, "o", "\u001b[?2004h"]
[190.147688, "o", "> "]
[190.14778, "o", "    if raw is None:\r\n\u001b[?2004l\r"]
[190.147809, "o", "\u001b[?2004h"]
[190.147836, "o", "> "]
[190.147928, "o", "        return None\r\n\u001b[?2004l\r"]
[190.147961, "o", "\u001b[?2004h"]
[190.147987, "o", "> "]
[190.148144, "o", "    if not _CURSOR.fullmatch(raw):\r\n\u001b[?2004l\r"]
[190.148174, "o", "\u001b[?2004h"]
[190.1482, "o", "> "]
[190.148393, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[190.148422, "o", "\u001b[?2004h"]
[190.148463, "o", "> "]
[190.148494, "o", "    try:\r\n"]
[190.148525, "o", "\u001b[?2004l\r\u001b[?2004h"]
[190.148551, "o", "> "]
[190.149014, "o", "        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[190.149044, "o", "\u001b[?2004h"]
[190.149071, "o", "> "]
[190.149314, "o", "    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[190.149344, "o", "\u001b[?2004h"]
[190.149371, "o", "> "]
[190.149606, "o", "        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[190.149645, "o", "\u001b[?2004h"]
[190.149673, "o", "> "]
[190.149796, "o", "    parts = text.split(\":\")\r\n\u001b[?2004l\r"]
[190.149829, "o", "\u001b[?2004h"]
[190.149856, "o", "> "]
[190.150261, "o", "    if len(parts) != 3 or parts[0] != _CURSOR_VERSION or not _validate_timestamp(parts[1]):\r\n\u001b[?2004l\r"]
[190.150293, "o", "\u001b[?2004h"]
[190.150319, "o", "> "]
[190.150512, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[190.150543, "o", "\u001b[?2004h"]
[190.15057, "o", "> "]
[190.150717, "o", "    if not parts[2].isdigit():\r\n\u001b[?2004l\r"]
[190.150744, "o", "\u001b[?2004h"]
[190.150771, "o", "> "]
[190.150965, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[190.150997, "o", "\u001b[?2004h"]
[190.151024, "o", "> "]
[190.151155, "o", "    order_id = int(parts[2])\r\n\u001b[?2004l\r"]
[190.151184, "o", "\u001b[?2004h"]
[190.151211, "o", "> "]
[190.151575, "o", "    if order_id > _MAX_SQLITE_INTEGER or _cursor_text(parts[1], order_id) != raw:\r\n\u001b[?2004l\r"]
[190.151607, "o", "\u001b[?2004h"]
[190.151635, "o", "> "]
[190.151832, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[190.151863, "o", "\u001b[?2004h"]
[190.151889, "o", "> "]
[190.152121, "o", "    return Cursor(created_at=parts[1], id=order_id)\r\n\u001b[?2004l\r"]
[190.152158, "o", "\u001b[?2004h"]
[190.152186, "o", "> \r\n\u001b[?2004l\r"]
[190.152214, "o", "\u001b[?2004h"]
[190.15224, "o", "> \r\n\u001b[?2004l\r"]
[190.152267, "o", "\u001b[?2004h> "]
[190.152594, "o", "def paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n\u001b[?2004l\r"]
[190.152632, "o", "\u001b[?2004h"]
[190.152658, "o", "> "]
[190.152995, "o", "    \"\"\"One page of `SELECT columns FROM table [WHERE where]`, newest first.\r\n\u001b[?2004l\r"]
[190.153027, "o", "\u001b[?2004h"]
[190.153054, "o", "> \r\n\u001b[?2004l\r"]
[190.15308, "o", "\u001b[?2004h"]
[190.153106, "o", "> "]
[190.153624, "o", "    Returns (rows, next_cursor); next_cursor is None on the last page. The row-value predicate is the strict part of\r\n\u001b[?2004l\r"]
[190.153658, "o", "\u001b[?2004h"]
[190.153685, "o", "> "]
[190.154198, "o", "    (created_at DESC, id DESC) that follows the last row, so all orders sharing its timestamp remain on later pages.\r\n\u001b[?2004l\r"]
[190.154229, "o", "\u001b[?2004h"]
[190.154255, "o", "> "]
[190.154294, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[190.154324, "o", "\u001b[?2004h"]
[190.154351, "o", "> "]
[190.154526, "o", "    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[190.154554, "o", "\u001b[?2004h"]
[190.154581, "o", "> "]
[190.154698, "o", "    args = list(params)\r\n\u001b[?2004l\r"]
[190.154726, "o", "\u001b[?2004h"]
[190.154753, "o", "> "]
[190.154875, "o", "    if cursor is not None:\r\n\u001b[?2004l\r"]
[190.154905, "o", "\u001b[?2004h"]
[190.154925, "o", "> "]
[190.155162, "o", "        clauses.append(\"(created_at, id) < (?, ?)\")\r\n\u001b[?2004l\r"]
[190.155198, "o", "\u001b[?2004h> "]
[190.155477, "o", "        args.extend((cursor.created_at, cursor.id))\r\n\u001b[?2004l\r"]
[190.155508, "o", "\u001b[?2004h"]
[190.155529, "o", "> "]
[190.155735, "o", "    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r"]
[190.155767, "o", "\u001b[?2004h"]
[190.155795, "o", "> "]
[190.155867, "o", "    if clauses:\r\n\u001b[?2004l\r"]
[190.155899, "o", "\u001b[?2004h"]
[190.155926, "o", "> "]
[190.156224, "o", "        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r"]
[190.15628, "o", "\u001b[?2004h> "]
[190.156542, "o", "    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[190.156562, "o", "\u001b[?2004h"]
[190.156579, "o", "> "]
[190.156719, "o", "    args.append(limit)\r\n\u001b[?2004l\r"]
[190.156745, "o", "\u001b[?2004h"]
[190.156762, "o", "> "]
[190.156988, "o", "    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[190.157006, "o", "\u001b[?2004h"]
[190.157023, "o", "> "]
[190.15722, "o", "    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[190.157238, "o", "\u001b[?2004h"]
[190.157255, "o", "> "]
[190.157331, "o", "    return rows, next_cursor\r\n\u001b[?2004l\r"]
[190.15735, "o", "\u001b[?2004h"]
[190.157367, "o", "> "]
[190.157385, "o", "PY\r\n\u001b[?2004l\r"]
[190.160463, "o", "\u001b[?2004hroot@41c40823-1fe5-4dd3-b66f-d86754d36fac:/app# \r\n\u001b[?2004l\r"]
[190.160516, "o", "\u001b[?2004hroot@41c40823-1fe5-4dd3-b66f-d86754d36fac:/app# "]
[190.160648, "o", "cat > /app/orders_service/queries.py <<'PY'\r\n\u001b[?2004l\r"]
[190.160671, "o", "\u001b[?2004h"]
[190.160687, "o", "> "]
[190.160877, "o", "\"\"\"Queries behind the customer views (account page, support tool).\"\"\"\r\n\u001b[?2004l\r"]
[190.160897, "o", "\u001b[?2004h> "]
[190.16099, "o", "from .db import ORDER_COLUMNS\r\n\u001b[?2004l\r"]
[190.161011, "o", "\u001b[?2004h> "]
[190.16113, "o", "from .pagination import encode_cursor\r\n\u001b[?2004l\r"]
[190.161162, "o", "\u001b[?2004h"]
[190.161173, "o", "> \r\n\u001b[?2004l\r"]
[190.161209, "o", "\u001b[?2004h"]
[190.161242, "o", "> "]
[190.161279, "o", "\r\n\u001b[?2004l\r"]
[190.161304, "o", "\u001b[?2004h> "]
[190.16149, "o", "def customer_exists(con, customer_id):\r\n\u001b[?2004l\r"]
[190.161525, "o", "\u001b[?2004h> "]
[190.16201, "o", "    return con.execute(\"SELECT 1 FROM customers WHERE id = ?\", (customer_id,)).fetchone() is not None\r\n\u001b[?2004l\r"]
[190.162059, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.162091, "o", "\u001b[?2004h"]
[190.1621, "o", "> "]
[190.162145, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.162182, "o", "> "]
[190.162454, "o", "def customer_orders_page(con, customer_id, limit, cursor):\r\n\u001b[?2004l\r"]
[190.162489, "o", "\u001b[?2004h> "]
[190.162893, "o", "    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\r\n\u001b[?2004l\r"]
[190.162942, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.16297, "o", "\u001b[?2004h"]
[190.16298, "o", "> "]
[190.163772, "o", "    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.164081, "o", "    (customer_id, created_at) for big wholesale accounts (PERF-112). The compound row-value comparison includes id,\r\n\u001b[?2004l\r"]
[190.164149, "o", "\u001b[?2004h> "]
[190.164393, "o", "    so orders that share a timestamp are not skipped.\r\n\u001b[?2004l\r"]
[190.164443, "o", "\u001b[?2004h> "]
[190.164485, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[190.164533, "o", "\u001b[?2004h> "]
[190.164966, "o", "    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\r\n\u001b[?2004l\r"]
[190.165014, "o", "\u001b[?2004h"]
[190.165022, "o", "> "]
[190.165137, "o", "    args = [customer_id]\r\n\u001b[?2004l\r"]
[190.165188, "o", "\u001b[?2004h"]
[190.165239, "o", "> "]
[190.16531, "o", "    if cursor is not None:\r\n\u001b[?2004l\r"]
[190.165358, "o", "\u001b[?2004h> "]
[190.165566, "o", "        sql += \" AND (created_at, id) < (?, ?)\"\r\n\u001b[?2004l\r"]
[190.165605, "o", "\u001b[?2004h"]
[190.165656, "o", "> "]
[190.165853, "o", "        args.extend((cursor.created_at, cursor.id))\r\n\u001b[?2004l\r"]
[190.165898, "o", "\u001b[?2004h> "]
[190.166152, "o", "    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[190.166198, "o", "\u001b[?2004h> "]
[190.166301, "o", "    args.append(limit)\r\n\u001b[?2004l\r"]
[190.166339, "o", "\u001b[?2004h"]
[190.166349, "o", "> "]
[190.166557, "o", "    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[190.166601, "o", "\u001b[?2004h> "]
[190.166957, "o", "    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[190.167001, "o", "\u001b[?2004h> "]
[190.167133, "o", "    return rows, next_cursor\r\n\u001b[?2004l\r"]
[190.167171, "o", "\u001b[?2004h> "]
[190.167216, "o", "PY\r\n\u001b[?2004l\r"]
[190.169003, "o", "\u001b[?2004h"]
[190.169018, "o", "root@41c40823-1fe5-4dd3-b66f-d86754d36fac:/app# "]
[190.668058, "i", "cat >> /app/tests/test_api.py <<'PY'\n\n\ndef make_tied_db(path):\n    make_db(path, 0)\n    con = sqlite3.connect(path)\n    # Deliberately write ids in a different order from the requested timestamp order.\n    rows = [\n        (1, 1, \"2026-03-01T10:00:00Z\", \"paid\", 101, \"USD\", \"web\"),\n        (2, 2, \"2026-03-01T10:00:00Z\", \"paid\", 102, \"USD\", \"web\"),\n        (3, 1, \"2026-03-01T10:00:00Z\", \"paid\", 103, \"USD\", \"web\"),\n        (4, 2, \"2026-03-01T10:00:01Z\", \"paid\", 104, \"USD\", \"web\"),\n        (5, 1, \"2026-03-01T10:00:01Z\", \"paid\", 105, \"USD\", \"web\"),\n    ]\n    con.executemany(\"INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?, ?)\", rows)\n    con.commit()\n    con.close()\n    return rows\n\n\n@pytest.fixture()\ndef tied_client(tmp_path):\n    db = tmp_path / \"tied.db\"\n    make_tied_db(db)\n    return create_app(str(db)).test_client()\n\n\n@pytest.mark.parametrize(\"limit\", [1, 2, 4, 5, 500])\ndef test_walk_includes_all_orders_sharing_a_timestamp(tied_client, limit):\n    out, cursor = [], None\n    pages = []\n    for _ in range(10):\n   "]
[190.668096, "i", "     q = {\"limit\": limit} if cursor is None else {\"limit\": limit, \"cursor\": cursor}\n        response = tied_client.get(\"/orders\", query_string=q)\n        assert response.status_code == 200\n        body = response.get_json()\n        pages.append(len(body[\"orders\"]))\n        out += body[\"orders\"]\n        cursor = body[\"next_cursor\"]\n        if cursor is None:\n            break\n    else:\n        raise AssertionError(\"too many pages\")\n\n    assert [o[\"id\"] for o in out] == [5, 4, 3, 2, 1]\n    expected = [limit] * (5 // limit) + ([5 % limit] if 5 % limit else [0])\n    assert pages == expected\n\n\ndef test_customer_walk_includes_all_orders_sharing_a_timestamp(tied_client):\n    out, cursor = [], None\n    for _ in range(10):\n        q = {\"limit\": 2} if cursor is None else {\"limit\": 2, \"cursor\": cursor}\n        body = tied_client.get(\"/customers/1/orders\", query_string=q).get_json()\n        out += body[\"orders\"]\n        cursor = body[\"next_cursor\"]\n        if cursor is None:\n            break\n    else:\n        raise Asse"]
[190.668236, "i", "rtionError(\"too many pages\")\n    assert [o[\"id\"] for o in out] == [5, 3, 1]\n\n\ndef test_exact_multiple_ends_with_an_empty_page(client):\n    body = client.get(\"/orders?limit=5\").get_json()\n    assert len(body[\"orders\"]) == 5\n    assert body[\"next_cursor\"] is not None\n    body = client.get(\"/orders\", query_string={\"limit\": 5, \"cursor\": body[\"next_cursor\"]}).get_json()\n    assert body == {\"orders\": [], \"next_cursor\": None}\nPY\npython3 -m pytest -q /app/tests/test_api.py\n"]
[190.668451, "o", "cat >> /app/tests/test_api.py <<'PY'\r\n\u001b[?2004l\r"]
[190.668548, "o", "\u001b[?2004h"]
[190.66861, "o", "> \r\n\u001b[?2004l\r"]
[190.668702, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.668764, "o", "\u001b[?2004h"]
[190.668814, "o", "> "]
