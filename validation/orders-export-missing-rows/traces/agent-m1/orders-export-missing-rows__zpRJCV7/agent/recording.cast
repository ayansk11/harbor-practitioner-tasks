[29.870659, "o", "from .db import ORDER_COLUMNS\r\n     3\tfrom .pagination import encode_cursor\r\n     4\t\r\n     5\t\r\n     6\tdef customer_exists(con, customer_id):\r\n     7\t    return con.execute(\"SELECT 1 FROM customers WHERE id = ?\", (customer_id,)).fetchone() is not None\r\n     8\t\r\n     9\t\r\n    10\tdef customer_orders_page(con, customer_id, limit, cursor):\r\n    11\t    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\r\n    12\t\r\n    13\t    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index\r\n    14\t    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112).\"\"\"\r\n    15\t    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\r\n    16\t    args = [customer_id]\r\n    17\t    if cursor is not None:\r\n    18\t        sql += \" AND created_at < ?\"\r\n    19\t        args.append(cursor.created_at)\r\n    20\t    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n    21\t    args.appen"]
[29.870687, "o", "d(limit)\r\n    22\t    rows = con.execute(sql, args).fetchall()\r\n    23\t    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n    24\t    return rows, next_cursor\r\n\u001b[?2004hroot@41c40823-1fe5-4dd3-b66f-d86754d36fac:/app# "]
[30.409307, "i", "nl -ba /app/orders_service/db.py | sed -n '1,240p'; printf '\\n--- __main__ ---\\n'; nl -ba /app/orders_service/__main__.py; printf '\\n--- init ---\\n'; cat /app/orders_service/__init__.py\n"]
[30.409904, "o", "nl -ba /app/orders_service/db.py | sed -n '1,240p'; printf '\\n--- __main__ ---\\n'; nl -ba /app/orders_service/__main__.py; printf '\\n--- init ---\\n'; cat /app/orders_service/__init__.py\r\n\u001b[?2004l\r"]
[30.411751, "o", "     1\t\"\"\"One SQLite connection per request. Other systems (checkout, the POS sync, back-office imports) write to the same\r\n     2\tdatabase file, so the API never caches rows: every request reads what is committed at that moment.\"\"\"\r\n     3\timport sqlite3\r\n     4\t\r\n     5\tfrom flask import current_app, g\r\n     6\t\r\n     7\tORDER_FIELDS = (\"id\", \"customer_id\", \"created_at\", \"status\", \"total_cents\", \"currency\")\r\n     8\tORDER_COLUMNS = \", \".join(ORDER_FIELDS)\r\n     9\t\r\n    10\t\r\n"]
[30.411794, "o", "    11\tdef get_db():\r\n    12\t    if \"db\" not in g:\r\n    13\t        con = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=10)\r\n    14\t        con.row_factory = sqlite3.Row\r\n    15\t        g.db = con\r\n"]
[30.411833, "o", "    16\t    return g.db\r\n    17\t\r\n    18\t\r\n    19\tdef close_db(_exc=None):\r\n    20\t    con = g.pop(\"db\", None)\r\n    21\t    if con is not None:\r\n    22\t        con.close()\r\n    23\t\r\n    24\t\r\n    25\tdef order_json(row):\r\n    26\t    return {name: row[name] for name in ORDER_FIELDS}\r\n"]
[30.412037, "o", "\r\n--- __main__ ---\r\n"]
[30.413945, "o", "     1\t\"\"\"Start the orders API: python -m orders_service --db data/orders.db --port 8080\"\"\"\r\n     2\timport argparse\r\n     3\timport os\r\n     4\t\r\n     5\tfrom waitress import serve\r\n     6\t\r\n     7\tfrom .app import create_app\r\n"]
[30.414006, "o", "     8\t\r\n     9\t\r\n    10\tdef main():\r\n    11\t    parser = argparse.ArgumentParser(prog=\"python -m orders_service\", description=__doc__)\r\n    12\t    parser.add_argument(\"--db\", required=True, help=\"path to the SQLite orders database\")\r\n    13\t    parser.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    14\t    parser.add_argument(\"--port\", type=int, default=8080)\r\n    15\t    parser.add_argument(\"--threads\", type=int, default=4)\r\n"]
[30.414062, "o", "    16\t    args = parser.parse_args()\r\n    17\t    if not os.path.isfile(args.db):\r\n    18\t        parser.error(f\"database not found: {args.db}\")\r\n"]
[30.414107, "o", "    19\t    app = create_app(os.path.abspath(args.db))\r\n    20\t    serve(app, host=args.host, port=args.port, threads=args.threads, ident=\"orders-api\")\r\n    21\t\r\n    22\t\r\n    23\tif __name__ == \"__main__\":\r\n    24\t    main()\r\n"]
[30.414379, "o", "\r\n--- init ---\r\n"]
[30.415347, "o", "\"\"\"Orders API: read-only HTTP access to the merchant's orders database (see docs/API.md).\"\"\"\r\nfrom .app import create_app\r\n\r\n__all__ = [\"create_app\"]\r\n"]
