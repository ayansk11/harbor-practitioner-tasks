[421.678106, "i", "python3 - <<'PY'\np='/app/tests/test_api.py'\ns=open(p).read()\nold='''def test_exact_multiple_ends_with_an_empty_page(client):\n    body = client.get(\"/orders?limit=5\").get_json()\n    assert len(body[\"orders\"]) == 5\n    assert body[\"next_cursor\"] is not None\n    body = client.get(\"/orders\", query_string={\"limit\": 5, \"cursor\": body[\"next_cursor\"]}).get_json()\n    assert body == {\"orders\": [], \"next_cursor\": None}\n'''\nnew='''def test_exact_multiple_ends_with_an_empty_page(tmp_path):\n    db = tmp_path / \"multiple.db\"\n    make_db(db, 10)\n    client = create_app(str(db)).test_client()\n    body = client.get(\"/orders?limit=5\").get_json()\n    assert len(body[\"orders\"]) == 5\n    assert body[\"next_cursor\"] is not None\n    body = client.get(\"/orders\", query_string={\"limit\": 5, \"cursor\": body[\"next_cursor\"]}).get_json()\n    assert body == {\"orders\": [], \"next_cursor\": None}\n'''\nassert old in s\nopen(p,'w').write(s.replace(old,new))\nPY\npython3 -m pytest -q /app/tests/test_api.py\n"]
