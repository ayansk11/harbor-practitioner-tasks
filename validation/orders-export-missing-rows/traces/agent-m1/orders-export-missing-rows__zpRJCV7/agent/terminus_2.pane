"""Queries behind the customer views (account page, support tool)."""
from .db import ORDER_COLUMNS
from .pagination import encode_cursor


def customer_exists(con, customer_id):
    return con.execute("SELECT 1 FROM customers WHERE id = ?", (customer_id,)).fetchone() is not None


def customer_orders_page(con, customer_id, limit, cursor):
    """One page of a customer's orders, newest first. Returns (rows, next_cursor).

    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index
    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112)."""
    sql = f"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?"
    args = [customer_id]
    if cursor is not None:
        sql += " AND created_at < ?"
        args.append(cursor.created_at)
    sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
    args.append(limit)
    rows = con.execute(sql, args).fetchall()
    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None
    return rows, next_cursor
--- db.py ---
"""One SQLite connection per request. Other systems (checkout, the POS sync, back-office imports) write to the same
database file, so the API never caches rows: every request reads what is committed at that moment."""
import sqlite3

from flask import current_app, g

ORDER_FIELDS = ("id", "customer_id", "created_at", "status", "total_cents", "currency")
ORDER_COLUMNS = ", ".join(ORDER_FIELDS)


def get_db():
    if "db" not in g:
        con = sqlite3.connect(current_app.config["DATABASE"], timeout=10)
        con.row_factory = sqlite3.Row
        g.db = con
    return g.db


def close_db(_exc=None):
    con = g.pop("db", None)
    if con is not None:
        con.close()


def order_json(row):
    return {name: row[name] for name in ORDER_FIELDS}
--- __main__.py ---
"""Start the orders API: python -m orders_service --db data/orders.db --port 8080"""
import argparse
import os

from waitress import serve

from .app import create_app


def main():
    parser = argparse.ArgumentParser(prog="python -m orders_service", description=__doc__)
    parser.add_argument("--db", required=True, help="path to the SQLite orders database")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument("--threads", type=int, default=4)
    args = parser.parse_args()
    if not os.path.isfile(args.db):
        parser.error(f"database not found: {args.db}")
    app = create_app(os.path.abspath(args.db))
    serve(app, host=args.host, port=args.port, threads=args.threads, ident="orders-api")


if __name__ == "__main__":
    main()
--- export client ---
"""Nightly finance export: page through GET /orders and write one CSV row per order.

    python tools/export_orders.py --base http://127.0.0.1:8080 --limit 200 --out /tmp/orders.csv [--log export.log]

Runs from cron at 02:00 UTC against production. It only follows next_cursor; it never builds cursors itself.
"""
import argparse
import csv
import datetime as dt
import json
import sys
import urllib.parse
import urllib.request

FIELDS = ["id", "customer_id", "created_at", "status", "total_cents", "currency"]


def now():
    t = dt.datetime.now(dt.timezone.utc)
    return t.strftime("%Y-%m-%dT%H:%M:%S.") + f"{t.microsecond // 1000:03d}Z"


def get(base, path, params=None):
    url = base.rstrip("/") + path + ("?" + urllib.parse.urlencode(params) if params else "")
    with urllib.request.urlopen(url, timeout=60) as resp:
        return resp.status, json.load(resp)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--base", default="http://127.0.0.1:8080")
    ap.add_argument("--limit", type=int, default=200)
    ap.add_argument("--out", required=True)
    ap.add_argument("--log", help="append the request log here (default: stderr)")
    args = ap.parse_args()
    log = open(args.log, "a") if args.log else sys.stderr
    print(f"# export_orders.py started {now()} base={args.base} limit={args.limit} out={args.out}", file=log)
    status, body = get(args.base, "/orders/count")
    total = body["count"]
    print(f"{now()} GET /orders/count {status} count={total}", file=log)
    rows = pages = 0
    cursor = None
    with open(args.out, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(FIELDS)
        while True:
            params = {"limit": args.limit}
            if cursor is not None:
                params["cursor"] = cursor
            status, body = get(args.base, "/orders", params)
            pages += 1
            for o in body["orders"]:
                w.writerow([o[k] for k in FIELDS])
            rows += len(body["orders"])
            shown = "/orders?" + "&".join(f"{k}={v}" for k, v in params.items())
            print(f"{now()} GET {shown} {status} rows={len(body['orders'])} next_cursor={body['next_cursor'] or 'null'}",
                  file=log)
            cursor = body["next_cursor"]
            if cursor is None:
                break
    print(f"# done {now()}: {rows} rows written, {pages} pages, count at start was {total}", file=log)
    if log is not sys.stderr:
        log.close()


if __name__ == "__main__":
    main()
