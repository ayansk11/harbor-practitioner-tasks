[?2004l[?2004h>     return int(raw)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _cursor_text(created_at, order_id):
[?2004l[?2004h>     payload = f"{_CURSOR_VERSION}:{created_at}:{order_id}".encode("ascii")
[?2004l[?2004h>     return base64.urlsafe_b64encode(payload).decode("ascii").rstrip("=")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def encode_cursor(row):
[?2004l[?2004h>     """Cursor for the page after `row` (the last row of the current page)."""
[?2004l[?2004h>     return _cursor_text(row["created_at"], row["id"])
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _validate_timestamp(value):
[?2004l[?2004h>     if not _TIMESTAMP.fullmatch(value):
[?2004l[?2004h>         return False
[?2004l[?2004h>     try:
[?2004l[?2004h>         datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ")
