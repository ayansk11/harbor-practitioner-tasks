client=create_app(p).test_client()
first=client.get('/orders?limit=2').get_json()
assert [r['id'] for r in first['orders']]==[5,4]
w=sqlite3.connect(p)
w.execute("INSERT INTO orders(customer_id,created_at,status,total_cents,currency,channel) VALUES (1,'2020-01-01T00:00:02Z','paid',9,'USD','web')")
new_id=w.execute('SELECT last_insert_rowid()').fetchone()[0]
w.execute("INSERT INTO orders(id,customer_id,created_at,status,total_cents,currency,channel) VALUES (100000,2,'2020-01-01T00:00:00Z','paid',9,'USD','backfill')")
w.commit(); w.close()
ids=first['orders']; cursor=first['next_cursor']
while cursor is not None:
    body=client.get('/orders',query_string={'limit':2,'cursor':cursor}).get_json()
    ids.extend(body['orders']); cursor=body['next_cursor']
walk=[r['id'] for r in ids]
assert walk==[5,4,100000,3,2,1],walk
assert new_id not in walk and len(walk)==len(set(walk))
print('global concurrent walk:',walk)
ids=[]; cursor=None
while True:
    q={'limit':2} if cursor is None else {'limit':2,'cursor':cursor}
    body=client.get('/customers/2/orders',query_string=q).get_json()
    ids.extend(r['id'] for r in body['orders']); cursor=body['next_cursor']
    if cursor is None:
        break
assert ids==[5,4,100000,3],ids
print('customer concurrent walk:',ids)
