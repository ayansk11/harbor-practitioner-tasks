def paginate(con, columns, table, limit, cursor, where="", params=()):
    """One page of `SELECT columns FROM table [WHERE where]`, newest first.

    Returns (rows, next_cursor); next_cursor is None on the last page. The row-value predicate is the strict part of
    (created_at DESC, id DESC) that follows the last row, so all orders sharing its timestamp remain on later pages.
    """
    clauses = [where] if where else []
    args = list(params)
    if cursor is not None:
        clauses.append("(created_at, id) < (?, ?)")
        args.extend((cursor.created_at, cursor.id))
    sql = f"SELECT {columns} FROM {table}"
    if clauses:
        sql += " WHERE " + " AND ".join(f"({c})" for c in clauses)
    sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
    args.append(limit)
    rows = con.execute(sql, args).fetchall()
    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None
    return rows, next_cursor
PY

