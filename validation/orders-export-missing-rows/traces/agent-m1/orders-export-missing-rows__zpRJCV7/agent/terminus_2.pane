[?2004l[?2004h> def paginate(con, columns, table, limit, cursor, where="", params=()):
[?2004l[?2004h>     """One page of `SELECT columns FROM table [WHERE where]`, newest first.
[?2004l[?2004h> 
[?2004l[?2004h>     Returns (rows, next_cursor); next_cursor is None on the last page. The row-value predicate is the strict part of
[?2004l[?2004h>     (created_at DESC, id DESC) that follows the last row, so all orders sharing its timestamp remain on later pages.
[?2004l[?2004h>     """
[?2004l[?2004h>     clauses = [where] if where else []
[?2004l[?2004h>     args = list(params)
[?2004l[?2004h>     if cursor is not None:
[?2004l[?2004h>         clauses.append("(created_at, id) < (?, ?)")
[?2004l[?2004h>         args.extend((cursor.created_at, cursor.id))
