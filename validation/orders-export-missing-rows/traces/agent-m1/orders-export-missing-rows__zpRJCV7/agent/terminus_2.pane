    61	def decode_cursor(raw):
    62	    """Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400."""
    63	    if raw is None:
    64	        return None
    65	    if not _CURSOR.fullmatch(raw):
    66	        raise BadRequest("invalid cursor")
    67	    try:
    68	        text = base64.urlsafe_b64decode((raw + "=" * (-len(raw) % 4)).encode("ascii")).decode("ascii")
    69	    except (ValueError, binascii.Error, UnicodeError):
    70	        raise BadRequest("invalid cursor") from None
    71	    parts = text.split(":")
    72	    if len(parts) != 3 or parts[0] != _CURSOR_VERSION or not _validate_timestamp(parts[1]):
    73	        raise BadRequest("invalid cursor")
    74	    if not parts[2].isdigit():
    75	        raise BadRequest("invalid cursor")
    76	    order_id = int(parts[2])
    77	    if order_id > _MAX_SQLITE_INTEGER or _cursor_text(parts[1], order_id) != raw:
    78	        raise BadRequest("invalid cursor")
    79	    return Cursor(created_at=parts[1], id=order_id)
    80	
    81	
    82	def paginate(con, columns, table, limit, cursor, where="", params=()):
    83	    """One page of `SELECT columns FROM table [WHERE where]`, newest first.
    84	
    85	    Returns (rows, next_cursor); next_cursor is None on the last page. The row-value predicate is the strict part of
    86	    (created_at DESC, id DESC) that follows the last row, so all orders sharing its timestamp remain on later pages.
    87	    """
    88	    clauses = [where] if where else []
    89	    args = list(params)
    90	    if cursor is not None:
    91	        clauses.append("(created_at, id) < (?, ?)")
    92	        args.extend((cursor.created_at, cursor.id))
    93	    sql = f"SELECT {columns} FROM {table}"
    94	    if clauses:
    95	        sql += " WHERE " + " AND ".join(f"({c})" for c in clauses)
    96	    sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
    97	    args.append(limit)
    98	    rows = con.execute(sql, args).fetchall()
    99	    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None
   100	    return rows, next_cursor
--- queries actual ---
     1	"""Queries behind the customer views (account page, support tool)."""
     2	from .db import ORDER_COLUMNS
     3	from .pagination import encode_cursor
     4	
     5	
     6	def customer_exists(con, customer_id):
     7	    return con.execute("SELECT 1 FROM customers WHERE id = ?", (customer_id,)).fetchone() is not None
     8	
     9	
    10	def customer_orders_page(con, customer_id, limit, cursor):
    11	    """One page of a customer's orders, newest first. Returns (rows, next_cursor).
    12	
    13	    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index
    14	    (customer_id, created_at) for big wholesale accounts (PERF-112). The compound row-value comparison includes id,
    15	    so orders that share a timestamp are not skipped.
    16	    """
    17	    sql = f"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?"
    18	    args = [customer_id]
    19	    if cursor is not None:
    20	        sql += " AND (created_at, id) < (?, ?)"
    21	        args.extend((cursor.created_at, cursor.id))
    22	    sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
    23	    args.append(limit)
    24	    rows = con.execute(sql, args).fetchall()
    25	    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None
    26	    return rows, next_cursor
