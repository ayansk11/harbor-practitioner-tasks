[235.17393, "i", "python3 << 'PYEOF'\nimport urllib.request, json, sqlite3\ndef get(url):\n    return json.loads(urllib.request.urlopen(url, timeout=20).read())\nprint('count now:', get('http://127.0.0.1:8080/orders/count'))\n\n# fresh full walk\nseen=set(); cursor=None\nwhile True:\n    url='http://127.0.0.1:8080/orders?limit=500'\n    if cursor is not None: url+=f'&cursor={cursor}'\n    b=get(url)\n    for o in b['orders']: seen.add(o['id'])\n    cursor=b['next_cursor']\n    if cursor is None: break\nprint('fresh walk total:', len(seen), 'has 999001:', 999001 in seen, '999002:', 999002 in seen, '48214(newest):', 48214 in seen)\n\n# customer 5 walk must include its inserts if any for customer 5\nc5=set(); cursor=None\nwhile True:\n    url='http://127.0.0.1:8080/customers/5/orders?limit=10'\n    if cursor is not None: url+=f'&cursor={cursor}'\n    b=get(url)\n    for o in b['orders']: c5.add(o['id'])\n    cursor=b['next_cursor']\n    if cursor is None: break\nprint('customer 5 walk:', sorted(c5))\nPYEOF\n"]
