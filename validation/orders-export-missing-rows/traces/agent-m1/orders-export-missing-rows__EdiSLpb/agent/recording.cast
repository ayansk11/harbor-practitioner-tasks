[28.327758, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/app/data/orders.db')\n# Check for created_at ties\nprint('Top 5 timestamps with most orders:')\nfor r in conn.execute('SELECT created_at, COUNT(*) c FROM orders GROUP BY created_at ORDER BY c DESC LIMIT 5'):\n    print(r)\nprint()\n# Check customer 5\nprint('Customer 5 order count:', conn.execute('SELECT COUNT(*) FROM orders WHERE customer_id=5').fetchone())\nprint('Total orders:', conn.execute('SELECT COUNT(*) FROM orders').fetchone())\n# Check indexes\nprint('\\nIndexes:')\nfor r in conn.execute('SELECT name, sql FROM sqlite_master WHERE type=\\'index\\''):\n    print(r)\n\"\n"]
