[174.969941, "i", "cat > /app/orders_service/__main__.py << 'PYEOF'\n\"\"\"Start the orders API: python -m orders_service --db data/orders.db --port 8080\"\"\"\nimport argparse\nimport os\n\nfrom waitress import serve\n\nfrom .app import create_app\nfrom .db import ensure_indexes\n\n\ndef main():\n    parser = argparse.ArgumentParser(prog=\"python -m orders_service\", description=__doc__)\n    parser.add_argument(\"--db\", required=True, help=\"path to the SQLite orders database\")\n    parser.add_argument(\"--host\", default=\"127.0.0.1\")\n    parser.add_argument(\"--port\", type=int, default=8080)\n    parser.add_argument(\"--threads\", type=int, default=4)\n    args = parser.parse_args()\n    if not os.path.isfile(args.db):\n        parser.error(f\"database not found: {args.db}\")\n    db_path = os.path.abspath(args.db)\n    try:\n        ensure_indexes(db_path)\n    except Exception:\n        # Index creation is an optimization; never let it block startup.\n        pass\n    app = create_app(db_path)\n    serve(app, host=args.host, port=args.port, threads=args.threads, i"]
[174.970075, "i", "dent=\"orders-api\")\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
