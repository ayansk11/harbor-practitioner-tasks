[65.334215, "i", "cat > /app/orders_service/__main__.py << 'PYEOF'\n\"\"\"python -m orders_service --db <path to orders.db> --port <port>\"\"\"\nimport argparse\n\nfrom waitress import serve\n\nfrom .app import create_app\nfrom .db import ensure_indexes\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Orders API\")\n    parser.add_argument(\"--db\", required=True, help=\"path to orders.db\")\n    parser.add_argument(\"--port\", type=int, required=True, help=\"port to listen on\")\n    args = parser.parse_args()\n\n    ensure_indexes(args.db)\n\n    app = create_app(args.db)\n    serve(app, host=\"127.0.0.1\", port=args.port)\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
