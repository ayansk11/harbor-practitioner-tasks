[103.284877, "i", "python3 << 'PYEOF'\nimport urllib.request, time, json\n\ndef get(url):\n    t0=time.time()\n    r=urllib.request.urlopen(url, timeout=15)\n    body=json.loads(r.read())\n    return body, r.status, time.time()-t0\n\nbody, status, dt = get(\"http://127.0.0.1:8080/orders/count\")\nprint(\"count:\", body, \"status:\", status, \"dt: %.3f\" % dt)\n\ndef walk(base, limit):\n    seen=[]; cursor=None; pages=0; order_ok=True\n    prev=None\n    while True:\n        url=f\"{base}?limit={limit}\"\n        if cursor is not None: url+=f\"&cursor={cursor}\"\n        b,s,dt=get(url)\n        pages+=1\n        for o in b[\"orders\"]:\n            if prev is not None:\n                ca, ia, cb, ib = prev[\"created_at\"], prev[\"id\"], o[\"created_at\"], o[\"id\"]\n                if (ca,ia) < (cb,ib):  # prev should be >= next in (created_at,id) desc\n                    order_ok=False\n            seen.append(o[\"id\"])\n            prev=o\n        cursor=b[\"next_cursor\"]\n        if cursor is None: break\n    return seen, pages, order_ok\n\nseen, pages, order_ok = walk(\"http:/"]
[103.285001, "i", "/127.0.0.1:8080/orders\", 200)\nprint(f\"/orders limit=200: {len(seen)} orders, {pages} pages, unique={len(set(seen))}, order_ok={order_ok}\")\n\nseen5, p5, ok5 = walk(\"http://127.0.0.1:8080/customers/5/orders\", 20)\nprint(f\"/customers/5/orders limit=20: {len(seen5)} orders, {p5} pages, unique={len(set(seen5))}, order_ok={ok5}\")\n\n# deep page timing: last cursor of a full walk to measure deep latency\nt0=time.time()\nb,s,dt=get(\"http://127.0.0.1:8080/orders?limit=500\")\nprint(f\"first page limit=500: {len(b['orders'])} rows dt={dt:.3f}\")\nPYEOF\n"]
