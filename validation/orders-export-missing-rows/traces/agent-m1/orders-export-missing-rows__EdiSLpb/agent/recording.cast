[64.802946, "i", "cat > /app/orders_service/db.py << 'PYEOF'\n\"\"\"One SQLite connection per request. Other systems (checkout, the POS sync, back-office imports) write to the same\ndatabase file, so the API never caches rows: every request reads what is committed at that moment.\"\"\"\nimport sqlite3\n\nfrom flask import current_app, g\n\nORDER_FIELDS = (\"id\", \"customer_id\", \"created_at\", \"status\", \"total_cents\", \"currency\")\nORDER_COLUMNS = \", \".join(ORDER_FIELDS)\n\n\ndef get_db():\n    if \"db\" not in g:\n        con = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=10)\n        con.row_factory = sqlite3.Row\n        g.db = con\n    return g.db\n\n\ndef close_db(_exc=None):\n    con = g.pop(\"db\", None)\n    if con is not None:\n        con.close()\n\n\ndef order_json(row):\n    return {name: row[name] for name in ORDER_FIELDS}\n\n\ndef ensure_indexes(db_path):\n    \"\"\"Create composite indexes for keyset pagination if they do not exist yet.\"\"\"\n    con = sqlite3.connect(db_path, timeout=30)\n    con.execute(\"CREATE INDEX IF NOT EXISTS orders_created_at_i"]
[64.803042, "i", "d ON orders(created_at, id)\")\n    con.execute(\"CREATE INDEX IF NOT EXISTS orders_customer_created_at_id ON orders(customer_id, created_at, id)\")\n    con.commit()\n    con.close()\nPYEOF\n"]
