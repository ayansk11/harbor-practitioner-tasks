[180.021326, "i", "python3 << 'PYEOF'\nimport urllib.request, time, json, sqlite3, threading\n\ndef get(url):\n    r=urllib.request.urlopen(url, timeout=20)\n    return json.loads(r.read())\n\n# Starting set\ncon=sqlite3.connect('data/orders.db'); con.row_factory=sqlite3.Row\nstart = {r['id']: (r['created_at'], r['id']) for r in con.execute('SELECT id, created_at FROM orders')}\nmax_id_start = max(r['id'] for r in con.execute('SELECT id FROM orders'))\nprint('start count:', len(start), 'max_id_start:', max_id_start)\n\ncursor_holder={'cursor':None}\nwalk_done=threading.Event()\nwalk_ids=[]; walk_pairs=[]\n\ndef walk():\n    cursor=None\n    while True:\n        url=f\"http://127.0.0.1:8080/orders?limit=200\"\n        if cursor is not None: url+=f\"&cursor={cursor}\"\n        b=get(url)\n        for o in b['orders']:\n            walk_ids.append(o['id']); walk_pairs.append((o['created_at'], o['id']))\n        cursor=b['next_cursor']\n        if cursor is None:\n            walk_done.set(); return\n\nwt=threading.Thread(target=walk); wt.start()\n\n# wait a few pag"]
[180.021356, "i", "es\nfor _ in range(50):\n    if not walk_done.is_set(): time.sleep(0.15); break\n    time.sleep(0.15)\n\n# now insert: new (newest) + backfilled (high id, old date)\nc2=sqlite3.connect('data/orders.db', timeout=15)\nnew_ts='2099-01-01T00:00:00Z'\nc2.execute('INSERT INTO orders (customer_id, created_at, status, total_cents, currency, channel) VALUES (1,?,?,?,?,?)',(new_ts,'paid',111,'USD','web'))\n# backfilled: old date, high id\nc2.execute('INSERT INTO orders (id, customer_id, created_at, status, total_cents, currency, channel) VALUES (?,?,?,?,?,?,?)',\n           (999001, 2, '2020-01-01T00:00:00Z','paid',222,'USD','pos'))\n# another backfill mid-range\nc2.execute('INSERT INTO orders (id, customer_id, created_at, status, total_cents, currency, channel) VALUES (?,?,?,?,?,?,?)',\n           (999002, 1, '2024-06-01T00:00:00Z','shipped',333,'EUR','pos'))\nc2.commit(); c2.close()\nprint('inserted 3 orders')\n\nwt.join()\nwalk_set=set(walk_ids)\nprint('walk total:', len(walk_ids), 'unique:', len(walk_set))\n\n# every original must be pr"]
[180.02165, "i", "esent exactly once\nmissing=[i for i in start if i not in walk_set]\nprint('originals missing from walk:', len(missing), missing[:10])\n# inserted should appear at most once\nins=[999001,999002]\nfor i in ins:\n    print(f'inserted {i} count in walk:', walk_ids.count(i))\n# ordering check: strictly descending (created_at,id)\nok=all(walk_pairs[i] > walk_pairs[i+1] for i in range(len(walk_pairs)-1))\nprint('walk strictly descending (created_at,id):', ok)\nPYEOF\n"]
