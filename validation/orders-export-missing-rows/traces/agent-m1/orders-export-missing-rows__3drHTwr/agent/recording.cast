[72.754402, "o", "\u001b[?2004h"]
[72.754437, "o", "> \r\n"]
[72.754492, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[72.754682, "o", "def encode_cursor(row):\r\n\u001b[?2004l\r"]
[72.754743, "o", "\u001b[?2004h> "]
[72.755247, "o", "    \"\"\"Cursor for the page after `row` (the last row of the current page).\"\"\"\r\n\u001b[?2004l\r"]
[72.75531, "o", "\u001b[?2004h> "]
[72.755524, "o", "    # Format: created_at|id\r\n\u001b[?2004l\r"]
[72.755567, "o", "\u001b[?2004h"]
[72.755619, "o", "> "]
[72.755949, "o", "    cursor_text = f\"{row['created_at']}|{row['id']}\"\r\n\u001b[?2004l\r"]
[72.755995, "o", "\u001b[?2004h"]
[72.75604, "o", "> "]
[72.756815, "o", "    return base64.urlsafe_b64encode(cursor_text.encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[72.756877, "o", "\u001b[?2004h> "]
[72.756936, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.756983, "o", "> \r\n\u001b[?2004l\r"]
[72.757028, "o", "\u001b[?2004h> "]
[72.757246, "o", "def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[72.757289, "o", "\u001b[?2004h"]
[72.757333, "o", "> "]
[72.758091, "o", "    \"\"\"Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400.\"\"\"\r\n\u001b[?2004l\r"]
[72.758133, "o", "\u001b[?2004h"]
[72.758179, "o", "> "]
[72.758315, "o", "    if raw is None:\r\n\u001b[?2004l\r"]
[72.758372, "o", "\u001b[?2004h"]
[72.758434, "o", "> "]
[72.758616, "o", "        return None\r\n\u001b[?2004l\r"]
[72.758675, "o", "\u001b[?2004h> "]
[72.758729, "o", "    try:\r\n\u001b[?2004l\r"]
[72.758771, "o", "\u001b[?2004h"]
[72.758821, "o", "> "]
[72.759623, "o", "        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[72.759671, "o", "\u001b[?2004h"]
[72.759715, "o", "> "]
[72.760138, "o", "    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[72.760175, "o", "\u001b[?2004h"]
[72.760216, "o", "> "]
[72.760636, "o", "        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[72.760681, "o", "\u001b[?2004h"]
[72.76072, "o", "> "]
[72.760908, "o", "    if \"|\" not in text:\r\n\u001b[?2004l\r"]
[72.760964, "o", "\u001b[?2004h"]
[72.761009, "o", "> "]
[72.761286, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[72.761336, "o", "\u001b[?2004h> "]
[72.761681, "o", "    created_at, id_str = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[72.76177, "o", "\u001b[?2004h> "]
[72.762168, "o", "    if not _TIMESTAMP.fullmatch(created_at) or not id_str.isdigit():\r\n\u001b[?2004l\r"]
[72.76221, "o", "\u001b[?2004h"]
[72.76225, "o", "> "]
[72.762525, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[72.762563, "o", "\u001b[?2004h"]
[72.762602, "o", "> "]
[72.762971, "o", "    return Cursor(created_at=created_at, id=int(id_str))\r\n\u001b[?2004l\r"]
[72.763013, "o", "\u001b[?2004h"]
[72.76305, "o", "> \r\n"]
[72.763094, "o", "\u001b[?2004l\r\u001b[?2004h"]
[72.763136, "o", "> \r\n\u001b[?2004l\r"]
[72.763175, "o", "\u001b[?2004h> "]
[72.763629, "o", "def paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n\u001b[?2004l\r"]
[72.763668, "o", "\u001b[?2004h"]
[72.763734, "o", "> "]
[72.764178, "o", "    \"\"\"One page of `SELECT columns FROM table [WHERE where]`, newest first.\r\n\u001b[?2004l\r"]
[72.764223, "o", "\u001b[?2004h> \r\n"]
[72.764268, "o", "\u001b[?2004l\r"]
[72.764308, "o", "\u001b[?2004h> "]
[72.764782, "o", "    Returns (rows, next_cursor); next_cursor is None on the last page.\"\"\"\r\n\u001b[?2004l\r"]
[72.764824, "o", "\u001b[?2004h"]
[72.764864, "o", "> "]
[72.765107, "o", "    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[72.76515, "o", "\u001b[?2004h"]
[72.765188, "o", "> "]
[72.765334, "o", "    args = list(params)\r\n\u001b[?2004l\r"]
[72.765385, "o", "\u001b[?2004h"]
[72.76543, "o", "> "]
[72.765571, "o", "    if cursor is not None:\r\n\u001b[?2004l\r"]
[72.765611, "o", "\u001b[?2004h"]
[72.765648, "o", "> "]
[72.76611, "o", "        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n\u001b[?2004l\r"]
[72.766156, "o", "\u001b[?2004h"]
[72.766195, "o", "> "]
[72.766733, "o", "        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[72.766772, "o", "\u001b[?2004h"]
[72.766813, "o", "> "]
[72.767042, "o", "    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r"]
[72.767086, "o", "\u001b[?2004h"]
[72.767132, "o", "> "]
[72.767184, "o", "    if clauses:\r\n\u001b[?2004l\r"]
[72.767229, "o", "\u001b[?2004h> "]
[72.767636, "o", "        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r"]
[72.767674, "o", "\u001b[?2004h> "]
[72.768019, "o", "    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[72.768056, "o", "\u001b[?2004h"]
[72.768101, "o", "> "]
[72.768212, "o", "    args.append(limit)\r\n\u001b[?2004l\r"]
[72.768248, "o", "\u001b[?2004h"]
[72.768294, "o", "> "]
[72.768547, "o", "    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[72.768584, "o", "\u001b[?2004h"]
[72.768628, "o", "> "]
[72.769058, "o", "    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[72.769096, "o", "\u001b[?2004h"]
[72.76912, "o", "> "]
[72.769283, "o", "    return rows, next_cursor\r\n\u001b[?2004l\r"]
[72.769316, "o", "\u001b[?2004h"]
[72.769364, "o", "> "]
[72.769409, "o", "EOF\r\n\u001b[?2004l\r"]
[72.771442, "o", "\u001b[?2004h"]
[72.771489, "o", "root@c8b29f60-857e-437b-a6aa-f3cc9b4ac246:/app# "]
[73.305969, "i", "cat <<'EOF' > /app/orders_service/queries.py\n\"\"\"Queries behind the customer views (account page, support tool).\"\"\"\nfrom .db import ORDER_COLUMNS\nfrom .pagination import encode_cursor\n\n\ndef customer_exists(con, customer_id):\n    return con.execute(\"SELECT 1 FROM customers WHERE id = ?\", (customer_id,)).fetchone() is not None\n\n\ndef customer_orders_page(con, customer_id, limit, cursor):\n    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\n\n    Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index\n    (customer_id, created_at) instead of scanning orders_created_at for big wholesale accounts (PERF-112).\"\"\"\n    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\n    args = [customer_id]\n    if cursor is not None:\n        sql += \" AND ((created_at < ?) OR (created_at = ? AND id < ?))\"\n        args.extend([cursor.created_at, cursor.created_at, cursor.id])\n    sql += \" ORDER BY created_at DESC, i"]
[73.306017, "i", "d DESC LIMIT ?\"\n    args.append(limit)\n    rows = con.execute(sql, args).fetchall()\n    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\n    return rows, next_cursor\nEOF\n"]
[73.306477, "o", "cat <<'EOF' > /app/orders_service/queries.py\r\n\u001b[?2004l\r"]
