[?2004l[?2004h>         sql += " AND ((created_at < ?) OR (created_at = ? AND id < ?))"
[?2004l[?2004h>         args.extend([cursor.created_at, cursor.created_at, cursor.id])
[?2004l[?2004h>     sql += " ORDER BY created_at DESC, id DESC LIMIT ?"
