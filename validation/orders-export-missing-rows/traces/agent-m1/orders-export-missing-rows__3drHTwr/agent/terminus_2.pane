[?2004l[?2004h> def customer_orders_page(con, customer_id, limit, cursor):
[?2004l[?2004h>     """One page of a customer's orders, newest first. Returns (rows, next_cursor).
[?2004l[?2004h> 
[?2004l[?2004h>     Same keyset scheme as pagination.paginate, written out here so that SQLite picks the orders_customer index
