[78.29109, "o", "\"\"\"Orders API: read-only HTTP access to the merchant's orders database (see docs/API.md).\"\"\"\r\nfrom .app import create_app\r\n\r\n__all__ = [\"create_app\"]\r\n"]
[78.291357, "o", "\u001b[?2004hroot@26f61bdf-5b07-4c3e-bf42-3441116eaf48:/app# "]
[78.746342, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: orders_service/__init__.py\n@@\n-# Existing content (if any) – leave untouched unless it interferes.\n+\"\"\"Top‑level package for the orders service.\n+\n+The test suite expects ``orders_service.create_app`` to be importable. The original\n+package did not re‑export the factory function defined in ``orders_service/app.py``.\n+We import it here and expose it via ``__all__`` so that ``from orders_service import\n+create_app`` works without needing to know the internal module layout.\n+\"\"\"\n+\n+from .app import create_app\n+\n+__all__ = [\"create_app\"]\n*** End Patch\nPATCH\nPATCH"]
[78.746495, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[78.746577, "o", "\u001b[?2004h> "]
