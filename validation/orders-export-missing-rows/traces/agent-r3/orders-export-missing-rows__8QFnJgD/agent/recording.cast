[35.144729, "i", " parameter; None when absent. A malformed cursor is a 400.\"\"\"\n-    if raw is None:\n-        return None\n-    try:\n-        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\n-    except (ValueError, binascii.Error, UnicodeError):\n-        raise BadRequest(\"invalid cursor\") from None\n-    if not _TIMESTAMP.fullmatch(text):\n-        raise BadRequest(\"invalid cursor\")\n-    return Cursor(created_at=text)\n+def decode_cursor(raw):\n+    \"\"\"Parse the ``cursor`` query parameter; ``None`` when absent.\n+\n+    The decoded value must be ``\"<timestamp>|<id>\"`` where ``timestamp`` matches the\n+    ISO‑8601 UTC format and ``id`` is a positive integer. Invalid formats raise ``BadRequest``.\n+    \"\"\"\n+    if raw is None:\n+        return None\n+    try:\n+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\n+    except (ValueError, binascii.Error, UnicodeError):\n+        raise BadRequest(\"invalid cursor\") from None\n+    if \"|\" not in te"]
[35.144794, "i", "xt:\n+        raise BadRequest(\"invalid cursor\")\n+    ts, id_part = text.split(\"|\", 1)\n+    if not _TIMESTAMP.fullmatch(ts) or not _DIGITS.fullmatch(id_part):\n+        raise BadRequest(\"invalid cursor\")\n+    return Cursor(created_at=ts, id=int(id_part))\n@@\n-    if cursor is not None:\n-        clauses.append(\"created_at < ?\")\n-        args.append(cursor.created_at)\n+    if cursor is not None:\n+        # Continue after the last seen row: rows must be *older* (smaller created_at)\n+        # or, if the timestamp is equal, have a smaller id.\n+        clauses.append(\"(created_at < ? OR (created_at = ? AND id < ?))\")\n+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\n*** End Patch\nPATCH\nPATCH"]
