[62.783987, "o", "\u001b[?2004h> "]
[62.784057, "o", "+def encode_cursor(row):\r\n\u001b[?2004l\r"]
[62.784074, "o", "\u001b[?2004h"]
[62.784107, "o", "> "]
[62.784218, "o", "+    \"\"\"Encode a cursor for the page after ``row``.\r\n\u001b[?2004l\r"]
[62.784239, "o", "\u001b[?2004h> "]
[62.784275, "o", "+\r\n\u001b[?2004l\r"]
[62.784313, "o", "\u001b[?2004h> "]
[62.784516, "o", "+    The cursor is a URL‑safe base64 encoding of the string ``\"{created_at}|{id}\"``.\r\n\u001b[?2004l\r"]
[62.784539, "o", "\u001b[?2004h"]
[62.784557, "o", "> "]
[62.784744, "o", "+    This opaque token uniquely identifies the position in the ordered result set.\r\n\u001b[?2004l\r"]
[62.78477, "o", "\u001b[?2004h> "]
[62.784799, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[62.784819, "o", "\u001b[?2004h"]
[62.784838, "o", "> "]
[62.784945, "o", "+    raw = f\"{row['created_at']}|{row['id']}\"\r\n\u001b[?2004l\r"]
[62.784976, "o", "\u001b[?2004h> "]
[62.785192, "o", "+    return base64.urlsafe_b64encode(raw.encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[62.785215, "o", "\u001b[?2004h> "]
[62.785233, "o", "@@\r\n\u001b[?2004l\r"]
[62.78525, "o", "\u001b[?2004h"]
[62.785291, "o", "> "]
[62.785328, "o", "-def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[62.78535, "o", "\u001b[?2004h> "]
[62.78559, "o", "-    \"\"\"Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400.\"\"\"\r\n\u001b[?2004l\r"]
[62.785621, "o", "\u001b[?2004h> "]
[62.785676, "o", "-    if raw is None:\r\n\u001b[?2004l\r"]
[62.7857, "o", "\u001b[?2004h> "]
[62.785761, "o", "-        return None\r\n\u001b[?2004l\r"]
[62.785783, "o", "\u001b[?2004h> "]
[62.785816, "o", "-    try:\r\n\u001b[?2004l\r"]
[62.78584, "o", "\u001b[?2004h> "]
[62.786107, "o", "-        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[62.786133, "o", "\u001b[?2004h"]
[62.78615, "o", "> "]
[62.786286, "o", "-    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[62.786295, "o", "\u001b[?2004h"]
[62.786325, "o", "> "]
[62.786449, "o", "-        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[62.786487, "o", "\u001b[?2004h> "]
[62.786581, "o", "-    if not _TIMESTAMP.fullmatch(text):\r\n\u001b[?2004l\r"]
[62.786611, "o", "\u001b[?2004h> "]
[62.78672, "o", "-        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[62.786756, "o", "\u001b[?2004h> "]
[62.78684, "o", "-    return Cursor(created_at=text)\r\n\u001b[?2004l\r"]
[62.786878, "o", "\u001b[?2004h> "]
[62.78694, "o", "+def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[62.786966, "o", "\u001b[?2004h"]
[62.786978, "o", "> "]
[62.787144, "o", "+    \"\"\"Parse the ``cursor`` query parameter; ``None`` when absent.\r\n\u001b[?2004l\r"]
[62.787168, "o", "\u001b[?2004h> "]
[62.787205, "o", "+\r\n\u001b[?2004l\r"]
[62.787225, "o", "\u001b[?2004h> "]
[62.787485, "o", "+    The decoded value must be ``\"<timestamp>|<id>\"`` where ``timestamp`` matches the ISO‑8601 UTC format\r\n\u001b[?2004l\r"]
[62.787511, "o", "\u001b[?2004h> "]
[62.787702, "o", "+    and ``id`` is a positive integer. Invalid formats raise ``BadRequest``.\r\n\u001b[?2004l\r"]
[62.787751, "o", "\u001b[?2004h> "]
[62.78777, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[62.787794, "o", "\u001b[?2004h> "]
[62.787843, "o", "+    if raw is None:\r\n\u001b[?2004l\r"]
[62.787884, "o", "\u001b[?2004h> "]
[62.787928, "o", "+        return None\r\n\u001b[?2004l\r"]
[62.787953, "o", "\u001b[?2004h> "]
[62.787986, "o", "+    try:\r\n\u001b[?2004l\r"]
[62.788018, "o", "\u001b[?2004h> "]
[62.788281, "o", "+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[62.788309, "o", "\u001b[?2004h> "]
[62.78844, "o", "+    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[62.788459, "o", "\u001b[?2004h> "]
[62.788601, "o", "+        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[62.788618, "o", "\u001b[?2004h"]
[62.788628, "o", "> "]
[62.788694, "o", "+    if \"|\" not in text:\r\n\u001b[?2004l\r"]
[62.788711, "o", "\u001b[?2004h"]
[62.788728, "o", "> "]
[62.788835, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[62.788857, "o", "\u001b[?2004h> "]
[62.788955, "o", "+    ts, id_part = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[62.788989, "o", "\u001b[?2004h> "]
[62.78917, "o", "+    if not _TIMESTAMP.fullmatch(ts) or not _DIGITS.fullmatch(id_part):\r\n\u001b[?2004l\r"]
[62.78921, "o", "\u001b[?2004h> "]
[62.789316, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[62.789342, "o", "\u001b[?2004h> "]
[62.789477, "o", "+    return Cursor(created_at=ts, id=int(id_part))\r\n\u001b[?2004l\r"]
[62.789497, "o", "\u001b[?2004h"]
[62.789537, "o", "> "]
[62.789556, "o", "@@\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.789618, "o", "-    if cursor is not None:\r\n\u001b[?2004l\r"]
[62.789638, "o", "\u001b[?2004h> "]
[62.789755, "o", "-        clauses.append(\"created_at < ?\")\r\n\u001b[?2004l\r"]
[62.789781, "o", "\u001b[?2004h"]
[62.789799, "o", "> "]
[62.789888, "o", "-        args.append(cursor.created_at)\r\n\u001b[?2004l\r"]
[62.789909, "o", "\u001b[?2004h"]
[62.789926, "o", "> "]
[62.789992, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[62.79001, "o", "\u001b[?2004h"]
[62.790019, "o", "> "]
[62.790238, "o", "+        # Continue after the last seen row: rows must be *older* (smaller created_at)\r\n\u001b[?2004l\r"]
[62.790267, "o", "\u001b[?2004h"]
[62.790285, "o", "> "]
[62.790425, "o", "+        # or, if the timestamp is equal, have a smaller id.\r\n\u001b[?2004l\r"]
[62.790443, "o", "\u001b[?2004h"]
[62.790457, "o", "> "]
[62.790651, "o", "+        clauses.append(\"(created_at < ? OR (created_at = ? AND id < ?))\")\r\n\u001b[?2004l\r"]
[62.790674, "o", "\u001b[?2004h> "]
[62.790855, "o", "+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[62.790874, "o", "\u001b[?2004h"]
[62.79089, "o", "> "]
[62.790931, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[62.79095, "o", "\u001b[?2004h> "]
[62.790988, "o", "PY\r\n\u001b[?2004l\r"]
[62.792846, "o", "\u001b[?2004h"]
[62.792889, "o", "root@26f61bdf-5b07-4c3e-bf42-3441116eaf48:/app# "]
[63.208858, "i", "cat > orders_service/queries.py <<'PY'\n\"\"\"Queries behind the customer views (account page, support tool).\"\"\"\nfrom .db import ORDER_COLUMNS\nfrom .pagination import encode_cursor, Cursor\n\n\ndef customer_exists(con, customer_id):\n    return con.execute(\"SELECT 1 FROM customers WHERE id = ?\", (customer_id,)).fetchone() is not None\n\n\ndef customer_orders_page(con, customer_id, limit, cursor):\n    \"\"\"One page of a customer's orders, newest first. Returns (rows, next_cursor).\n\n    Uses the same keyset pagination scheme as ``pagination.paginate`` but forces the\n    ``orders_customer`` index for efficiency on large customer histories.\n    \"\"\"\n    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\n    args = [customer_id]\n    if cursor is not None:\n        # Same logic as paginate: rows older than the cursor, or same timestamp with smaller id.\n        sql += \" AND (created_at < ? OR (created_at = ? AND id < ?))\"\n        args.extend([cursor.created_at, cursor.created_at, cursor.id"]
[63.20889, "i", "])\n    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\n    args.append(limit)\n    rows = con.execute(sql, args).fetchall()\n    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\n    return rows, next_cursor\nPY\n"]
[63.209061, "o", "cat > orders_service/queries.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
