[41.944714, "o", "\u001b[?2004h> "]
[41.944793, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[41.944839, "o", "\u001b[?2004h> "]
[41.945055, "o", "+        # Use a tuple comparison to respect both columns of the ordering.\r\n\u001b[?2004l\r"]
[41.945092, "o", "\u001b[?2004h> "]
[41.945252, "o", "+        clauses.append(\"(created_at, id) < (?, ?)\")\r\n\u001b[?2004l\r"]
[41.945272, "o", "\u001b[?2004h"]
[41.945291, "o", "> "]
[41.945472, "o", "+        args.extend([cursor.created_at, cursor.id])\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.945526, "o", "> "]
[41.945568, "o", "*** End Patch\r\n\u001b[?2004l\r\u001b[?2004h"]
