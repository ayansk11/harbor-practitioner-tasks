[41.933255, "i", "ursor` query parameter; None when absent. A malformed cursor is a 400.\"\"\"\n-    if raw is None:\n-        return None\n-    try:\n-        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\n-    except (ValueError, binascii.Error, UnicodeError):\n-        raise BadRequest(\"invalid cursor\") from None\n-    if not _TIMESTAMP.fullmatch(text):\n-        raise BadRequest(\"invalid cursor\")\n-    return Cursor(created_at=text)\n+def decode_cursor(raw):\n+    \"\"\"Parse the ``cursor`` query parameter; returns ``None`` when absent.\n+\n+    Expected format: base64‑url encoding of ``\"{created_at}|{id}\"``.\n+    If decoding fails or the components are malformed, a ``400 Bad Request`` is raised.\n+    \"\"\"\n+    if raw is None:\n+        return None\n+    try:\n+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\n+    except (ValueError, binascii.Error, UnicodeError):\n+        raise BadRequest(\"invalid cursor\") from None\n+    try:\n+        create"]
[41.933329, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[41.933381, "i", "d_at, id_str = text.split(\"|\", 1)\n+    except ValueError:\n+        raise BadRequest(\"invalid cursor\") from None\n+    if not _TIMESTAMP.fullmatch(created_at) or not _DIGITS.fullmatch(id_str):\n+        raise BadRequest(\"invalid cursor\")\n+    return Cursor(created_at=created_at, id=int(id_str))\n@@\n-    if cursor is not None:\n-        clauses.append(\"created_at < ?\")\n-        args.append(cursor.created_at)\n+    if cursor is not None:\n+        # Use a tuple comparison to respect both columns of the ordering.\n+        clauses.append(\"(created_at, id) < (?, ?)\")\n+        args.extend([cursor.created_at, cursor.id])\n*** End Patch\nPATCH\n"]
