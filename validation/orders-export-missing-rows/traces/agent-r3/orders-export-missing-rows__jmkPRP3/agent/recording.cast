[41.936711, "o", "\u001b[?2004h> "]
[41.937373, "o", "-    return base64.urlsafe_b64encode(row[\"created_at\"].encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
