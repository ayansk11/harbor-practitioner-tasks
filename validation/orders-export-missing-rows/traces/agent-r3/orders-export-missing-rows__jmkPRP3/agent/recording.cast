[41.94405, "o", "\u001b[?2004h> "]
[41.944216, "o", "+    return Cursor(created_at=created_at, id=int(id_str))\r\n\u001b[?2004l\r"]
[41.944251, "o", "\u001b[?2004h> @@\r\n"]
[41.944259, "o", "\u001b[?2004l\r"]
