[41.942315, "o", "\u001b[?2004h> "]
[41.942624, "o", "+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[41.942657, "o", "\u001b[?2004h> "]
[41.942829, "o", "+    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[41.942847, "o", "\u001b[?2004h"]
[41.942858, "o", "> "]
[41.943025, "o", "+        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[41.943044, "o", "\u001b[?2004h"]
[41.943062, "o", "> "]
[41.943115, "o", "+    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.94327, "o", "+        created_at, id_str = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[41.943314, "o", "\u001b[?2004h> "]
[41.943367, "o", "+    except ValueError:\r\n\u001b[?2004l\r"]
