[41.934727, "o", "\u001b[?2004h> "]
[41.93528, "o", "+# The cursor must include both timestamp and id to guarantee a strict ordering.\r\n\u001b[?2004l\r"]
[41.935317, "o", "\u001b[?2004h"]
[41.935349, "o", "> "]
[41.935673, "o", "+Cursor = namedtuple(\"Cursor\", [\"created_at\", \"id\"])\r\n\u001b[?2004l\r"]
[41.935714, "o", "\u001b[?2004h"]
