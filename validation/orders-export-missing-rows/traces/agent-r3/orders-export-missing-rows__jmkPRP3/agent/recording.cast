[126.204318, "o", "    try:\r\n\u001b[?2004l\r"]
[126.204343, "o", "\u001b[?2004h> "]
[126.204472, "o", "        created_at, id_str = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[126.204499, "o", "\u001b[?2004h> "]
[126.204561, "o", "    except ValueError:\r\n\u001b[?2004l\r"]
[126.204587, "o", "\u001b[?2004h> "]
[126.204725, "o", "        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[126.204753, "o", "\u001b[?2004h> "]
[126.204965, "o", "    if not _TIMESTAMP.fullmatch(created_at) or not _DIGITS.fullmatch(id_str):\r\n\u001b[?2004l\r"]
[126.204988, "o", "\u001b[?2004h"]
[126.205007, "o", "> "]
[126.205119, "o", "        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[126.205148, "o", "\u001b[?2004h"]
[126.205206, "o", "> "]
[126.205325, "o", "    return Cursor(created_at=created_at, id=int(id_str))\r\n\u001b[?2004l\r"]
[126.205349, "o", "\u001b[?2004h"]
[126.205368, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[126.20538, "o", "> \r\n\u001b[?2004l\r"]
[126.205422, "o", "\u001b[?2004h> "]
[126.205588, "o", "def paginate(con, columns, table, limit, cursor, where=\"\", params=()):\r\n\u001b[?2004l\r"]
[126.205608, "o", "\u001b[?2004h> "]
[126.205804, "o", "    \"\"\"One page of `SELECT columns FROM table [WHERE where]`, newest first.\r\n\u001b[?2004l\r"]
[126.205828, "o", "\u001b[?2004h"]
[126.205845, "o", "> \r\n\u001b[?2004l\r"]
[126.205866, "o", "\u001b[?2004h"]
[126.205887, "o", "> "]
[126.206054, "o", "    Returns (rows, next_cursor); next_cursor is None on the last page.\r\n\u001b[?2004l\r"]
[126.206075, "o", "\u001b[?2004h"]
[126.206093, "o", "> "]
[126.206112, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[126.20613, "o", "\u001b[?2004h"]
[126.206147, "o", "> "]
[126.206237, "o", "    clauses = [where] if where else []\r\n\u001b[?2004l\r"]
[126.206258, "o", "\u001b[?2004h> "]
[126.206328, "o", "    args = list(params)\r\n\u001b[?2004l\r"]
[126.206343, "o", "\u001b[?2004h"]
[126.206363, "o", "> "]
[126.206428, "o", "    if cursor is not None:\r\n\u001b[?2004l\r"]
[126.206443, "o", "\u001b[?2004h"]
[126.20646, "o", "> "]
[126.206641, "o", "        # Use a tuple comparison to respect both columns of the ordering.\r\n\u001b[?2004l\r"]
[126.206658, "o", "\u001b[?2004h"]
[126.206679, "o", "> "]
[126.206804, "o", "        clauses.append(\"(created_at, id) < (?, ?)\")\r\n\u001b[?2004l\r"]
[126.206825, "o", "\u001b[?2004h"]
[126.206849, "o", "> "]
[126.20697, "o", "        args.extend([cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[126.206984, "o", "\u001b[?2004h"]
[126.207006, "o", "> "]
[126.20714, "o", "    sql = f\"SELECT {columns} FROM {table}\"\r\n\u001b[?2004l\r"]
[126.20716, "o", "\u001b[?2004h> "]
[126.207212, "o", "    if clauses:\r\n\u001b[?2004l\r"]
[126.207229, "o", "\u001b[?2004h"]
[126.207246, "o", "> "]
[126.207411, "o", "        sql += \" WHERE \" + \" AND \".join(f\"({c})\" for c in clauses)\r\n\u001b[?2004l\r"]
[126.207427, "o", "\u001b[?2004h> "]
[126.207584, "o", "    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[126.207596, "o", "\u001b[?2004h"]
[126.207634, "o", "> "]
[126.207677, "o", "    args.append(limit)\r\n\u001b[?2004l\r"]
[126.207697, "o", "\u001b[?2004h"]
[126.207714, "o", "> "]
[126.207834, "o", "    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[126.20786, "o", "\u001b[?2004h"]
[126.207883, "o", "> "]
[126.208057, "o", "    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[126.208081, "o", "\u001b[?2004h"]
[126.208108, "o", "> "]
[126.208174, "o", "    return rows, next_cursor\r\n\u001b[?2004l\r"]
[126.20819, "o", "\u001b[?2004h"]
[126.208209, "o", "> "]
[126.20822, "o", "EOF\r\n\u001b[?2004l\r"]
[126.209949, "o", "\u001b[?2004hroot@70a17961-2398-4256-84f0-cbd5f77f0061:/app# "]
