[33.923951, "o", "STAMP.fullmatch(ts) or not _DIGITS.fullmatch(id_part):\r\n+        raise BadRequest(\"invalid cursor\")\r\n+    return Cursor(created_at=ts, id=int(id_part))\r\n@@\r\n-    if cursor is not None:\r\n-        clauses.append(\"created_at < ?\")\r\n-        args.append(cursor.created_at)\r\n+    if cursor is not None:\r\n+        # The keyset condition must handle rows with the"]
[33.924021, "o", " same timestamp.\r\n+        # We want rows that are *older* than the cursor row, i.e.:\r\n+        #   created_at < cursor.created_at\r\n+        #   OR (created_at = cursor.created_at "]
[33.924047, "o", "AND id < cursor.id)\r\n+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n*** End Patch\r\nPATCH\r\nPATCH\u001b[?2004h> "]
