[33.939671, "o", "\u001b[?2004h> "]
[33.939858, "o", "-        args.append(cursor.created_at)\r\n\u001b[?2004l\r"]
[33.9399, "o", "\u001b[?2004h"]
[33.939929, "o", "> "]
[33.940037, "o", "+    if cursor is not None:\r\n\u001b[?2004l\r"]
[33.940069, "o", "\u001b[?2004h> "]
[33.940444, "o", "+        # The keyset condition must handle rows with the same timestamp.\r\n\u001b[?2004l\r"]
[33.940484, "o", "\u001b[?2004h"]
[33.940512, "o", "> "]
[33.940809, "o", "+        # We want rows that are *older* than the cursor row, i.e.:\r\n\u001b[?2004l\r"]
[33.940851, "o", "\u001b[?2004h> "]
[33.941094, "o", "+        #   created_at < cursor.created_at\r\n\u001b[?2004l\r"]
[33.941131, "o", "\u001b[?2004h> "]
[33.941458, "o", "+        #   OR (created_at = cursor.created_at AND id < cursor.id)\r\n\u001b[?2004l\r"]
[33.941495, "o", "\u001b[?2004h"]
[33.941538, "o", "> "]
[33.94188, "o", "+        clauses.append(\"(created_at < ?) OR (created_at = ? AND id < ?)\")\r\n\u001b[?2004l\r"]
[33.941915, "o", "\u001b[?2004h> "]
[33.942299, "o", "+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[33.942334, "o", "\u001b[?2004h"]
[33.942391, "o", "> "]
