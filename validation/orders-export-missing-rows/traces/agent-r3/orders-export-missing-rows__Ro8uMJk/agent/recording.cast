[87.776815, "i", "python - <<'PY'\nimport subprocess, time, requests, json, os, signal\n\n# Start the service in the background\nport = 8081\nproc = subprocess.Popen([\n    'python', '-m', 'orders_service', '--db', 'data/orders.db', '--port', str(port)\n], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n# Give it a moment to start\ntime.sleep(1)\n\nbase = f'http://127.0.0.1:{port}'\n# Get total count\nresp = requests.get(f'{base}/orders/count')\ncount = resp.json()['count']\nprint('Count endpoint:', count)\n\n# Walk through all orders with limit=200\nlimit = 200\ncursor = None\nseen = 0\nwhile True:\n    params = {'limit': str(limit)}\n    if cursor:\n        params['cursor'] = cursor\n    r = requests.get(f'{base}/orders', params=params)\n    data = r.json()\n    orders = data['orders']\n    seen += len(orders)\n    cursor = data['next_cursor']\n    if not cursor:\n        break\nprint('Rows walked:', seen)\nassert seen == count, f'Walked {seen} vs count {count}'\n\n# Clean up service\nos.kill(proc.pid, signal.SIGTERM)\nproc.wait()\nPY\n"]
