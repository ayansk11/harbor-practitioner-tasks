[53.059041, "o", "\u001b[?2004l\r"]
[53.059055, "o", "\u001b[?2004h> "]
[53.059278, "o", "    The pagination logic mirrors :func:`pagination.paginate` but forces SQLite to use the\r\n\u001b[?2004l\r"]
[53.059312, "o", "\u001b[?2004h> "]
[53.059518, "o", "    ``orders_customer`` index (customer_id, created_at) for efficiency on large accounts.\r\n\u001b[?2004l\r"]
[53.059539, "o", "\u001b[?2004h"]
[53.059555, "o", "> "]
[53.059765, "o", "    It now uses the composite cursor (created_at, id) to correctly handle rows that share the\r\n\u001b[?2004l\r"]
[53.059782, "o", "\u001b[?2004h> "]
[53.059838, "o", "    same timestamp.\r\n\u001b[?2004l\r"]
[53.059859, "o", "\u001b[?2004h> "]
[53.05988, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[53.059899, "o", "\u001b[?2004h"]
[53.059913, "o", "> "]
[53.060136, "o", "    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\r\n\u001b[?2004l\r"]
[53.060151, "o", "\u001b[?2004h"]
[53.060164, "o", "> "]
[53.060226, "o", "    args = [customer_id]\r\n\u001b[?2004l\r"]
[53.060248, "o", "\u001b[?2004h"]
[53.060262, "o", "> "]
[53.060322, "o", "    if cursor is not None:\r\n\u001b[?2004l\r"]
[53.060335, "o", "\u001b[?2004h"]
[53.060349, "o", "> "]
[53.060519, "o", "        sql += \" AND ((created_at < ?) OR (created_at = ? AND id < ?))\"\r\n\u001b[?2004l\r"]
[53.060538, "o", "\u001b[?2004h> "]
[53.060711, "o", "        args.extend([cursor.created_at, cursor.created_at, cursor.id])\r\n\u001b[?2004l\r"]
[53.060725, "o", "\u001b[?2004h"]
[53.060739, "o", "> "]
[53.060882, "o", "    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\r\n\u001b[?2004l\r"]
[53.060901, "o", "\u001b[?2004h"]
[53.060915, "o", "> "]
[53.060983, "o", "    args.append(limit)\r\n\u001b[?2004l\r"]
[53.061, "o", "\u001b[?2004h"]
[53.061015, "o", "> "]
[53.061149, "o", "    rows = con.execute(sql, args).fetchall()\r\n\u001b[?2004l\r"]
[53.061165, "o", "\u001b[?2004h"]
[53.061178, "o", "> "]
[53.061418, "o", "    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\r\n\u001b[?2004l\r"]
[53.061435, "o", "\u001b[?2004h"]
[53.061447, "o", "> "]
[53.06154, "o", "    return rows, next_cursor\r\n\u001b[?2004l\r"]
[53.061555, "o", "\u001b[?2004h"]
[53.061574, "o", "> "]
[53.061587, "o", "PY\r\n\u001b[?2004l\r"]
[53.063877, "o", "\u001b[?2004h"]
[53.063898, "o", "root@d729ffce-f3f1-4d94-8061-5ea6fbde87a4:/app# "]
