[109.253199, "i", "python - <<'PY'\nimport subprocess, time, os, signal, json, urllib.request, urllib.parse\n\nport = 8081\nproc = subprocess.Popen([\n    'python', '-m', 'orders_service', '--db', 'data/orders.db', '--port', str(port)\n], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n# give the server a moment to start\ntime.sleep(1)\n\nbase = f'http://127.0.0.1:{port}'\n\n# helper to perform GET and decode JSON\ndef get_json(path, params=None):\n    url = f\"{base}{path}\"\n    if params:\n        url += '?' + urllib.parse.urlencode(params)\n    with urllib.request.urlopen(url) as resp:\n        return json.load(resp)\n\n# 1. total count\ncount_data = get_json('/orders/count')\ncount = count_data['count']\nprint('Count endpoint:', count)\n\n# 2. walk through orders\nlimit = 200\ncursor = None\nseen = 0\nwhile True:\n    params = {'limit': str(limit)}\n    if cursor:\n        params['cursor'] = cursor\n    page = get_json('/orders', params)\n    orders = page['orders']\n    seen += len(orders)\n    cursor = page['next_cursor']\n    if not cursor:\n        br"]
[109.253238, "i", "eak\nprint('Rows walked:', seen)\nassert seen == count, f'Walked {seen} vs count {count}'\n\n# cleanup\nos.kill(proc.pid, signal.SIGTERM)\nproc.wait()\nPY\n"]
