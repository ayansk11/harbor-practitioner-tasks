[33.926535, "o", "-def encode_cursor(row):\r\n"]
[33.926541, "o", "\u001b[?2004l\r"]
[33.926589, "o", "\u001b[?2004h> "]
[33.926968, "o", "-    \"\"\"Cursor for the page after `row` (the last row of the current page).\"\"\"\r\n\u001b[?2004l\r"]
[33.927016, "o", "\u001b[?2004h> "]
[33.92751, "o", "-    return base64.urlsafe_b64encode(row[\"created_at\"].encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[33.927555, "o", "\u001b[?2004h> "]
[33.927676, "o", "+def encode_cursor(row):\r\n"]
[33.927685, "o", "\u001b[?2004l\r"]
[33.92773, "o", "\u001b[?2004h"]
[33.927737, "o", "> "]
[33.928132, "o", "+    \"\"\"Encode a cursor for the page after `row` (the last row of the current page).\r\n"]
[33.928138, "o", "\u001b[?2004l\r"]
[33.928177, "o", "\u001b[?2004h> "]
[33.9282, "o", "+\r\n"]
[33.928231, "o", "\u001b[?2004l\r"]
[33.928239, "o", "\u001b[?2004h"]
[33.928271, "o", "> "]
[33.928637, "o", "+    The cursor contains the `created_at` timestamp and the `id` of the row,\r\n\u001b[?2004l\r"]
[33.928707, "o", "\u001b[?2004h> "]
[33.929071, "o", "+    concatenated with a pipe character.  The string is then base64‑url\r\n\u001b[?2004l\r"]
[33.929104, "o", "\u001b[?2004h"]
[33.929137, "o", "> "]
[33.92938, "o", "+    encoded without padding to keep it opaque.\r\n\u001b[?2004l\r"]
[33.929423, "o", "\u001b[?2004h"]
[33.929462, "o", "> "]
[33.929506, "o", "+    \"\"\"\r\n"]
[33.929514, "o", "\u001b[?2004l\r"]
[33.929547, "o", "\u001b[?2004h"]
[33.929582, "o", "> "]
[33.929896, "o", "+    # ``row`` is a sqlite3.Row which supports mapping access.\r\n\u001b[?2004l\r"]
[33.92994, "o", "\u001b[?2004h> "]
[33.930186, "o", "+    raw = f\"{row['created_at']}|{row['id']}\"\r\n\u001b[?2004l\r"]
[33.930233, "o", "\u001b[?2004h"]
[33.930265, "o", "> "]
[33.930691, "o", "+    return base64.urlsafe_b64encode(raw.encode(\"ascii\")).decode(\"ascii\").rstrip(\"=\")\r\n\u001b[?2004l\r"]
[33.930725, "o", "\u001b[?2004h"]
[33.930734, "o", "> "]
[33.930772, "o", "@@\r\n"]
[33.930779, "o", "\u001b[?2004l\r"]
[33.930816, "o", "\u001b[?2004h"]
[33.930824, "o", "> "]
[33.930965, "o", "-def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[33.930998, "o", "\u001b[?2004h"]
[33.931034, "o", "> "]
[33.931517, "o", "-    \"\"\"Parse the `cursor` query parameter; None when absent. A malformed cursor is a 400.\"\"\"\r\n\u001b[?2004l\r"]
[33.93157, "o", "\u001b[?2004h"]
[33.931603, "o", "> "]
[33.931693, "o", "-    if raw is None:\r\n\u001b[?2004l\r"]
[33.931734, "o", "\u001b[?2004h> "]
[33.931855, "o", "-        return None\r\n\u001b[?2004l\r"]
[33.931899, "o", "\u001b[?2004h"]
[33.931926, "o", "> "]
[33.931985, "o", "-    try:\r\n\u001b[?2004l\r"]
[33.932025, "o", "\u001b[?2004h> "]
[33.932552, "o", "-        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[33.932592, "o", "\u001b[?2004h"]
[33.932624, "o", "> "]
[33.932887, "o", "-    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[33.932926, "o", "\u001b[?2004h"]
[33.932958, "o", "> "]
[33.933212, "o", "-        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[33.933266, "o", "\u001b[?2004h> "]
[33.933474, "o", "-    if not _TIMESTAMP.fullmatch(text):\r\n\u001b[?2004l\r"]
[33.933515, "o", "\u001b[?2004h"]
[33.933547, "o", "> "]
[33.933759, "o", "-        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[33.933798, "o", "\u001b[?2004h"]
[33.933834, "o", "> "]
[33.934, "o", "-    return Cursor(created_at=text)\r\n\u001b[?2004l\r"]
[33.934046, "o", "\u001b[?2004h"]
[33.934077, "o", "> "]
[33.93418, "o", "+def decode_cursor(raw):\r\n\u001b[?2004l\r"]
[33.934214, "o", "\u001b[?2004h"]
[33.934256, "o", "> "]
[33.934572, "o", "+    \"\"\"Parse the `cursor` query parameter; ``None`` when absent.\r\n\u001b[?2004l\r"]
[33.934611, "o", "\u001b[?2004h> +\r\n"]
[33.934639, "o", "\u001b[?2004l\r"]
[33.934671, "o", "\u001b[?2004h"]
[33.934701, "o", "> "]
[33.934972, "o", "+    The cursor is expected to be the base64‑url encoding of\r\n\u001b[?2004l\r"]
[33.935003, "o", "\u001b[?2004h"]
[33.935034, "o", "> "]
[33.935377, "o", "+    ``\"<timestamp>|<id>\"``.  A malformed cursor results in a ``400``.\r\n\u001b[?2004l\r"]
[33.93541, "o", "\u001b[?2004h"]
[33.935439, "o", "> "]
[33.935471, "o", "+    \"\"\"\r\n"]
[33.935512, "o", "\u001b[?2004l\r\u001b[?2004h"]
[33.935545, "o", "> "]
[33.935616, "o", "+    if raw is None:\r\n\u001b[?2004l\r"]
[33.935661, "o", "\u001b[?2004h> "]
[33.935763, "o", "+        return None\r\n\u001b[?2004l\r"]
[33.935801, "o", "\u001b[?2004h"]
[33.935831, "o", "> "]
[33.935872, "o", "+    try:\r\n\u001b[?2004l\r"]
[33.935904, "o", "\u001b[?2004h"]
[33.935934, "o", "> "]
[33.936435, "o", "+        text = base64.urlsafe_b64decode((raw + \"=\" * (-len(raw) % 4)).encode(\"ascii\")).decode(\"ascii\")\r\n\u001b[?2004l\r"]
[33.936467, "o", "\u001b[?2004h"]
[33.936496, "o", "> "]
[33.936762, "o", "+    except (ValueError, binascii.Error, UnicodeError):\r\n\u001b[?2004l\r"]
[33.9368, "o", "\u001b[?2004h> "]
[33.937074, "o", "+        raise BadRequest(\"invalid cursor\") from None\r\n\u001b[?2004l\r"]
[33.937108, "o", "\u001b[?2004h"]
[33.937138, "o", "> "]
[33.937349, "o", "+    # Split into timestamp and id parts.\r\n\u001b[?2004l\r"]
[33.937382, "o", "\u001b[?2004h"]
[33.93741, "o", "> "]
[33.93744, "o", "+    try:"]
[33.937471, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.9375, "o", "> "]
[33.937685, "o", "+        ts, id_part = text.split(\"|\", 1)\r\n\u001b[?2004l\r"]
[33.937725, "o", "\u001b[?2004h> "]
[33.937846, "o", "+    except ValueError:\r\n\u001b[?2004l\r"]
[33.937888, "o", "\u001b[?2004h> "]
