[34.889776, "i", "irst. Returns (rows, next_cursor).\n+\n+    The pagination logic mirrors :func:`pagination.paginate` but forces SQLite to use the\n+    ``orders_customer`` index (customer_id, created_at) for efficiency on large accounts.\n+    It now uses the composite cursor (created_at, id) to correctly handle rows that share the\n+    same timestamp.\n+    \"\"\"\n+    sql = f\"SELECT {ORDER_COLUMNS} FROM orders INDEXED BY orders_customer WHERE customer_id = ?\"\n+    args = [customer_id]\n+    if cursor is not None:\n+        # Same composite condition as in pagination.paginate.\n+        sql += \" AND ((created_at < ?) OR (created_at = ? AND id < ?))\"\n+        args.extend([cursor.created_at, cursor.created_at, cursor.id])\n+    sql += \" ORDER BY created_at DESC, id DESC LIMIT ?\"\n+    args.append(limit)\n+    rows = con.execute(sql, args).fetchall()\n+    next_cursor = encode_cursor(rows[-1]) if len(rows) == limit else None\n+    return rows, next_cursor\n*** End Patch\nPATCH\nPATCH"]
