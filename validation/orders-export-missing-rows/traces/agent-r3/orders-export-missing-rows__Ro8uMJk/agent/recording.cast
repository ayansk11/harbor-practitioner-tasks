[33.938179, "o", "\u001b[?2004h"]
[33.938209, "o", "> "]
[33.938552, "o", "+    if not _TIMESTAMP.fullmatch(ts) or not _DIGITS.fullmatch(id_part):\r\n\u001b[?2004l\r"]
[33.938594, "o", "\u001b[?2004h"]
[33.938622, "o", "> "]
[33.938818, "o", "+        raise BadRequest(\"invalid cursor\")\r\n\u001b[?2004l\r"]
[33.938849, "o", "\u001b[?2004h"]
[33.938881, "o", "> "]
[33.939114, "o", "+    return Cursor(created_at=ts, id=int(id_part))\r\n\u001b[?2004l\r"]
[33.939147, "o", "\u001b[?2004h"]
[33.939177, "o", "> "]
[33.939208, "o", "@@\r\n\u001b[?2004l\r"]
[33.939259, "o", "\u001b[?2004h> "]
[33.939379, "o", "-    if cursor is not None:\r\n\u001b[?2004l\r"]
[33.939421, "o", "\u001b[?2004h> "]
