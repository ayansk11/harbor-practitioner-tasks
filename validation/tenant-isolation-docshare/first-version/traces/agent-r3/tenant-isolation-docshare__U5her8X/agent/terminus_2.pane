[?2004l[?2004h> bp = Blueprint("share", __name__)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def now_iso():
[?2004l[?2004h>     return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.post("/api/files/<file_id>/shares")
[?2004l[?2004h> @login_required
[?2004l[?2004h> def create_share(file_id):
[?2004l[?2004h>     if g.identity.role not in ("member", "org_admin"):
[?2004l[?2004h>         abort(403)
[?2004l[?2004h>     row = db.query_one("SELECT id, org_id FROM files WHERE id = ?", (file_id,))
[?2004l[?2004h>     if row is None:
[?2004l[?2004h>         abort(404)
[?2004l[?2004h>     if not g.identity.is_support:
[?2004l[?2004h>         org_id = require_active_org()
[?2004l[?2004h>         if row["org_id"] != org_id:
[?2004l[?2004h>             abort(404)
