[244.380067, "o", "\r\n"]
[244.381885, "o", "\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\r\nimport functools\r\nfrom dataclasses import dataclass, field\r\n\r\nfrom flask import abort, g, jsonify, request\r\n\r\nfrom . import db\r\n\r\n\r\n@dataclass\r\n"]
[244.38194, "o", "class Identity:\r\n    user_id: str\r\n    email: str\r\n    name: str\r\n    is_support: bool\r\n    org_id: str | None          # the active organisation for this request\r\n    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n\r\n\r\ndef _bearer_token():\r\n    header = request.headers.get(\"Authorization\", \"\")\r\n"]
[244.381969, "o", "    if not header.startswith(\"Bearer \"):\r\n        return None\r\n    return header[len(\"Bearer \"):].strip() or None\r\n\r\n\r\ndef load_identity():\r\n    \"\"\"Load and validate the caller and active organisation for this request.\"\"\"\r\n    if getattr(g, \"identity_loaded\", False):\r\n        return getattr(g, \"identity\", None)\r\n\r\n    token = _bearer_token()\r\n    if token is None:\r\n        return None\r\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n    if user is None:\r\n        return None\r\n\r\n    memberships = {r[\"org_id\"]: r[\"role\"] for r in\r\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    requested_org = request.headers.get(\"X-Org-Id\")\r\n\r\n    if user[\"is_support\"]:\r\n        role = \"support\"\r\n        if requested_org is None:\r\n"]
[244.381983, "o", "            org_id = None\r\n        else:\r\n            # A support header chooses the org used by list endpoints, but it must still be real.\r\n            if db.query_one(\"SELECT 1 FROM orgs WHERE id = ?\", (requested_org,)) is None:\r\n                abort(404, description=\"unknown_org\")\r\n"]
[244.381994, "o", "            org_id = requested_org\r\n    else:\r\n"]
[244.382005, "o", "        org_id = requested_org if requested_org is not None else user[\"home_org_id\"]\r\n        membership = db.query_one(\"SELECT role FROM memberships WHERE user_id = ? AND org_id = ?\",\r\n                                  (user[\"id\"], org_id)) if org_id is not None else None\r\n        if membership is None:\r\n"]
[244.382027, "o", "            # Do not reveal whether an organisation id exists but is not one of the caller's orgs.\r\n            abort(404, description=\"unknown_org\")\r\n        org_id = requested_org if requested_org is not None else user[\"home_org_id\"]\r\n        role = membership[\"role\"]\r\n\r\n    ident = Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"],\r\n                     is_support=bool(user[\"is_support\"]), org_id=org_id, role=role,"]
[244.382036, "o", "\r\n                     memberships=memberships)\r\n    g.identity_loaded = True\r\n    g.identity = ident\r\n    return ident\r\n"]
[244.382045, "o", "\r\n\r\ndef login_required(view):\r\n"]
[244.382054, "o", "    @functools.wraps(view)\r\n    def wrapper(*args, **kwargs):\r\n        if hasattr(g, \"identity\"):"]
[244.382064, "o", "\r\n            return view(*args, **kwargs)\r\n        ident = load_identity()\r\n"]
[244.382072, "o", "        if ident is None:\r\n            return jsonify(error=\"unauthorized\"), 401\r\n        g.identity = ident\r\n"]
[244.382082, "o", "        return view(*args, **kwargs)\r\n    return wrapper\r\n\r\n"]
[244.382091, "o", "\r\ndef require_active_org():\r\n    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\r\n    org_id = g.identity.org_id"]
[244.3821, "o", "\r\n    if org_id is None:\r\n        abort(400, description=\"x_org_id_required\")\r\n"]
[244.382108, "o", "    return org_id\r\n"]
[244.382545, "o", "=== app.py ===\r\n"]
[244.384747, "o", "\"\"\"Flask application factory.\"\"\""]
[244.384853, "o", "\r\nfrom flask import Flask, g, jsonify, request\r\nfrom werkzeug.exceptions import HTTPException\r\n\r\nfrom . import db\r\nfrom .auth import load_identity, login_required\r\nfrom .routes import admin, export, files, folders, share, thumbs\r\n\r\n\r\ndef create_app(db_path):\r\n    app = Flask(__name__)\r\n    app.config[\"DB_PATH\"] = db_path\r\n    app.teardown_appcontext(db.close_db)\r\n    for module in (files, folders, thumbs, export, share, admin):\r\n        app.register_blueprint(module.bp)\r\n\r\n    @app.before_request\r\n    def authenticate_api_request():\r\n        \"\"\"Apply the login and active-org policy before any API route can run.\"\"\"\r\n        path = request.path\r\n        if path != \"/api\" and not path.startswith(\"/api/\"):\r\n            return None\r\n        # Only the exact health GET is public.\r\n        if request.method == \"GET\" and path == \"/api/health\":\r\n            return None\r\n        ident = load_identity()\r\n        if ident is None:\r\n            return jsonify(error=\"unauthorized\"), 401\r\n        g.identity = ident\r\n       "]
[244.384895, "o", " return None\r\n\r\n    @app.errorhandler(HTTPException)\r\n    def http_error(exc):\r\n        code = exc.description if exc.code == 400 and exc.description and \" \" not in exc.description else exc.name\r\n        status = exc.code\r\n        # A valid caller has no permitted endpoint here; 404 avoids revealing method-specific details.\r\n        if status == 405 and (request.path == \"/api\" or request.path.startswith(\"/api/\")):\r\n            status = 404\r\n            code = \"Not Found\"\r\n        return jsonify(error=code.lower().replace(\" \", \"_\")), status\r\n\r\n    @app.get(\"/api/health\")\r\n    def health():\r\n        return jsonify(ok=True)\r\n\r\n    @app.get(\"/api/me\")\r\n    @login_required\r\n    def me():\r\n        ident = g.identity\r\n        return jsonify(user={\"id\": ident.user_id, \"email\": ident.email, \"name\": ident.name,\r\n                             \"is_support\": ident.is_support},\r\n                       active_org_id=ident.org_id, role=ident.role,\r\n                       memberships=[{\"org_id\": o, \"role\": r} for o, r in sorte"]
[244.384906, "o", "d(ident.memberships.items())])\r\n\r\n    return app\r\n"]
[244.385442, "o", "=== files.py ===\r\n"]
[244.386885, "o", "\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\r\nfrom flask import Blueprint, Response, abort, g, jsonify, request\r\n\r\n"]
[244.387009, "o", "from .. import db\r\nfrom ..auth import login_required, require_active_org\r\n\r\nbp = Blueprint(\"files\", __name__)\r\n\r\n\r\ndef get_file_or_404(file_id):\r\n    \"\"\"Fetch a file only if the active caller is allowed to see that file.\"\"\"\r\n    if g.identity.is_support:\r\n        row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\r\n    else:\r\n        row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ? AND org_id = ?\",\r\n                           (file_id, g.identity.org_id))\r\n    if row is None:\r\n        abort(404)\r\n    return row\r\n\r\n\r\n@bp.get(\"/api/files\")\r\n@login_required\r\ndef list_files():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(files=[db.file_json(r) for r in rows])\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>\")\r\n@login_required\r\ndef get_file(file_id):\r\n    return jsonify(db.file_json(get_file_or_404(file_id)))\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>"]
[244.387769, "o", "/download\")\r\n@login_required\r\ndef download(file_id):\r\n    row = get_file_or_404(file_id)\r\n    return file_response(row)\r\n\r\n\r\ndef file_response(row):\r\n    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\r\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\r\n    return resp\r\n\r\n\r\n@bp.patch(\"/api/files/<file_id>\")\r\n@login_required\r\ndef rename(file_id):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(403)\r\n    row = get_file_or_404(file_id)\r\n    body = request.get_json(silent=True) or {}\r\n    name = body.get(\"name\")\r\n    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\r\n        abort(400, description=\"bad_name\")\r\n    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\r\n\r\n\r\n@bp.delete(\"/api/files/<file_id>\")\r\n@login_required\r\ndef delete(file_id):\r\n    if g.identity.role != \"org_admin\":\r\n        abort(403)\r\n    row = get_file_or_404(file_id"]
[244.387821, "o", ")\r\n    conn = db.get_db()\r\n    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\r\n    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\r\n    conn.commit()\r\n    return \"\", 204\r\n\u001b[?2004hroot@d4ccd7b6-ea4d-48a5-a845-5e95f7dffe6e:/app# "]
[244.772777, "i", "printf '%s\\n' '=== export.py ==='; sed -n '1,220p' docshare/routes/export.py; printf '%s\\n' '=== share.py ==='; sed -n '1,240p' docshare/routes/share.py; printf '%s\\n' '=== thumbs.py ==='; sed -n '1,180p' docshare/routes/thumbs.py; printf '%s\\n' '=== folders.py ==='; sed -n '1,160p' docshare/routes/folders.py\n"]
[244.775443, "o", "printf '%s\\n' '=== export.py ==='; sed -n '1,220p' docshare/routes/export.py; printf '%s\\n' '=== share.py ==='; sed -n '1,240p' docshare/routes/share.py; printf '%s\\n' '=== thumbs.py ==='; sed -n '1,180p' docshare/routes/thumbs.py; printf '%s\\n' '=== folders.py ==='; sed -n '1,160p' docshare/routes/folders.py\r\n\u001b[?2004l\r"]
[244.775542, "o", "=== export.py ===\r\n"]
[244.778373, "o", "\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\nimport base64\r\n\r\nfrom flask import Blueprint, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"export\", __name__)\r\nMAX_IDS = 50\r\n\r\n\r\n@bp.post(\"/api/export\")\r\n@login_required\r\ndef export():\r\n"]
[244.778457, "o", "    body = request.get_json(silent=True) or {}\r\n    ids = body.get(\"file_ids\")\r\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n        abort(400, description=\"bad_file_ids\")\r\n\r\n    # Validate every id before serialising any content: export is all-or-nothing.\r\n    placeholders = \",\".join(\"?\" for _ in ids)\r\n    rows = db.query_all(f\"SELECT id, org_id, name, mime_type, size, content FROM files \"\r\n                        f\"WHERE id IN ({placeholders})\", ids)\r\n    by_id = {row[\"id\"]: row for row in rows}\r\n    if any(file_id not in by_id for file_id in ids):\r\n        abort(404)\r\n"]
[244.778514, "o", "    if not g.identity.is_support:\r\n        active_org = g.identity.org_id\r\n        if any(row[\"org_id\"] != active_org for row in by_id.values()):\r\n            abort(404)\r\n\r\n    out = []\r\n    for file_id in ids:\r\n        row = by_id[file_id]\r\n        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n    return jsonify(files=out)\r\n"]
[244.778689, "o", "=== share.py ===\r\n"]
[244.780092, "o", "\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\r\nimport secrets\r\nfrom datetime import datetime, timezone\r\n\r\nfrom flask import Blueprint, abort, g, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\nfrom .files import file_response\r\n\r\nbp = Blueprint(\"share\", __name__)\r\n"]
[244.780182, "o", "\r\n\r\ndef now_iso():\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\n@bp.post(\"/api/files/<file_id>/shares\")\r\n@login_required\r\ndef create_share(file_id):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(403)\r\n    if g.identity.is_support:\r\n        row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\r\n    else:\r\n"]
[244.780262, "o", "        row = db.query_one(\"SELECT id FROM files WHERE id = ? AND org_id = ?\",\r\n                           (file_id, g.identity.org_id))\r\n    if row is None:\r\n        abort(404)\r\n    token = secrets.token_urlsafe(18)\r\n    created = now_iso()\r\n    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\r\n               (token, row[\"id\"], g.identity.user_id, created))\r\n    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\r\n\r\n\r\n@bp.delete(\"/api/shares/<token>\")\r\n@login_required\r\ndef revoke_share(token):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(404)\r\n    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\r\n                       (token,))\r\n    if row is None or row[\"org_id\"] != g.identity.org_id:\r\n        abort(404)\r\n    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n    return \"\", 204\r\n\r\n"]
[244.780327, "o", "\r\n@bp.get(\"/s/<token>\")\r\ndef public_download(token):\r\n    row = db.query_one(\"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\r\n                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (token,))\r\n    if row is None:\r\n        abort(404)\r\n    return file_response(row)\r\n"]
[244.780464, "o", "=== thumbs.py ===\r\n"]
[244.781856, "o", "\"\"\"SVG previews for the file grid.\"\"\"\r\nimport html\r\n\r\nfrom flask import Blueprint, Response, abort, g\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"thumbs\", __name__)\r\n\r\nTEXT_TYPES = (\"text/\", \"application/json\")\r\n\r\n\r\ndef render_thumb(name, mime_type, content):\r\n    lines = []\r\n    if mime_type.startswith(TEXT_TYPES):\r\n        text = bytes(content).decode(\"utf-8\", \"replace\")\r\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\r\n    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\r\n             f\"<title>{html.escape(name)}</title>\",\r\n             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n    for i, ln in enumerate(lines):\r\n        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\r\n    parts.append(\"</svg>\")\r\n"]
[244.781923, "o", "    return \"\\n\".join(parts)\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/thumb\")\r\n@login_required\r\ndef thumb(file_id):\r\n    if g.identity.is_support:\r\n        row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n    else:\r\n        row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ? AND org_id = ?\",\r\n                           (file_id, g.identity.org_id))\r\n    if row is None:\r\n        abort(404)\r\n"]
[244.781975, "o", "    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n    return Response(svg, mimetype=\"image/svg+xml\")\r\n"]
[244.78212, "o", "=== folders.py ===\r\n"]
[244.78448, "o", "\"\"\"Folder endpoints: the folders of the active organisation and their files.\"\"\"\r\nfrom flask import Blueprint, abort, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_active_org\r\n\r\nbp = Blueprint(\"folders\", __name__)\r\n\r\n\r\n@bp.get(\"/api/folders\")\r\n"]
[244.784537, "o", "@login_required\r\ndef list_folders():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(\"SELECT id, org_id, name FROM folders WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(folders=[db.folder_json(r) for r in rows])\r\n\r\n\r\n@bp.get(\"/api/folders/<folder_id>/files\")\r\n@login_required\r\ndef folder_files(folder_id):\r\n    org_id = require_active_org()\r\n"]
[244.784581, "o", "    folder = db.query_one(\"SELECT id, org_id, name FROM folders WHERE id = ? AND org_id = ?\", (folder_id, org_id))\r\n    if folder is None:\r\n        abort(404)\r\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE folder_id = ? AND org_id = ? ORDER BY name\",\r\n                        (folder_id, org_id))\r\n    return jsonify(folder=db.folder_json(folder), files=[db.file_json(r) for r in rows])\r\n"]
