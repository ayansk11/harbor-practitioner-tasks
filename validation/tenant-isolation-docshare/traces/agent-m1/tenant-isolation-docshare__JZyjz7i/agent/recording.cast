[15.816585, "i", "echo '=== auth.py ==='; nl -ba docshare/auth.py; echo '=== db.py ==='; nl -ba docshare/db.py\n"]
[15.817519, "o", "echo '=== auth.py ==='; nl -ba docshare/auth.py; echo '=== db.py ==='; nl -ba docshare/db.py\r\n\u001b[?2004l\r"]
[15.817584, "o", "=== auth.py ===\r\n"]
[15.819027, "o", "     1\t\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\r\n     2\timport functools\r\n     3\tfrom dataclasses import dataclass, field\r\n     4\t\r\n     5\tfrom flask import g, jsonify, request\r\n     6\t\r\n"]
[15.81911, "o", "     7\tfrom . import db\r\n     8\t\r\n"]
[15.819172, "o", "     9\t\r\n    10\t@dataclass\r\n    11\tclass Identity:\r\n    12\t    user_id: str\r\n    13\t    email: str\r\n    14\t    name: str\r\n    15\t    is_support: bool\r\n    16\t    org_id: str | None          # the active organisation for this request\r\n    17\t    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n    18\t    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n    19\t\r\n    20\t\r\n    21\tdef _bearer_token():\r\n    22\t    header = request.headers.get(\"Authorization\", \"\")\r\n    23\t    if not header.startswith(\"Bearer \"):\r\n    24\t        return None\r\n    25\t    return header[len(\"Bearer \"):].strip() or None\r\n    26\t\r\n    27\t\r\n    28\tdef load_identity():\r\n    29\t    token = _bearer_token()\r\n"]
[15.819221, "o", "    30\t    if token is None:\r\n    31\t        return None\r\n    32\t    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n    33\t    if user is None:\r\n    34\t        return None\r\n    35\t    memberships = {r[\"org_id\"]: r[\"role\"] for r in\r\n    36\t                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    37\t    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.\r\n    38\t    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\r\n    39\t    if user[\"is_support\"]:\r\n    40\t        role = \"support\"\r\n    41\t    else:\r\n    42\t        role = memberships.get(org_id, \"member\")\r\n    43\t    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\r\n    44\t                    org_id=org_id, role=role, memberships=memberships)\r\n    45\t\r\n"]
[15.819274, "o", "    46\t\r\n    47\tdef login_required(view):\r\n    48\t    @functools.wraps(view)\r\n    49\t    def wrapper(*args, **kwargs):\r\n    50\t        ident = load_identity()\r\n    51\t        if ident is None:\r\n    52\t            return jsonify(error=\"unauthorized\"), 401\r\n    53\t        g.identity = ident\r\n    54\t        return view(*args, **kwargs)\r\n    55\t    return wrapper\r\n    56\t\r\n    57\t\r\n    58\tdef require_active_org():\r\n"]
[15.81932, "o", "    59\t    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\r\n    60\t    org_id = g.identity.org_id\r\n    61\t    if org_id is None:\r\n    62\t        from flask import abort\r\n    63\t        abort(400, description=\"x_org_id_required\")\r\n    64\t    return org_id\r\n"]
[15.819526, "o", "=== db.py ===\r\n"]
[15.820658, "o", "     1\t\"\"\"SQLite access. One connection per request (see app.py); rows come back as sqlite3.Row.\"\"\"\r\n     2\timport sqlite3\r\n     3\t\r\n     4\tfrom flask import g\r\n     5\t\r\n     6\tSCHEMA = \"\"\"\r\n     7\tCREATE TABLE IF NOT EXISTS orgs (\r\n     8\t    id TEXT PRIMARY KEY,\r\n     9\t    name TEXT NOT NULL\r\n    10\t);\r\n    11\t"]
[15.820719, "o", "CREATE TABLE IF NOT EXISTS users (\r\n    12\t    id TEXT PRIMARY KEY,\r\n    13\t    email TEXT NOT NULL UNIQUE,\r\n    14\t    name TEXT NOT NULL,\r\n    15\t    token TEXT NOT NULL UNIQUE,\r\n    16\t    home_org_id TEXT REFERENCES orgs(id),\r\n    17\t    is_support INTEGER NOT NULL DEFAULT 0\r\n"]
[15.820766, "o", "    18\t);\r\n    19\tCREATE TABLE IF NOT EXISTS memberships (\r\n    20\t    user_id TEXT NOT NULL REFERENCES users(id),\r\n    21\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    22\t    role TEXT NOT NULL CHECK (role IN ('member', 'org_admin')),\r\n    23\t    PRIMARY KEY (user_id, org_id)\r\n    24\t);\r\n    25\tCREATE TABLE IF NOT EXISTS folders (\r\n    26\t    id TEXT PRIMARY KEY,\r\n    27\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    28\t    name TEXT NOT NULL\r\n    29\t);\r\n    30\tCREATE TABLE IF NOT EXISTS files (\r\n    31\t    id TEXT PRIMARY KEY,\r\n    32\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    33\t    folder_id TEXT NOT NULL REFERENCES folders(id),\r\n    34\t    name TEXT NOT NULL,\r\n    35\t    mime_type TEXT NOT NULL,\r\n    36\t    size INTEGER NOT NULL,\r\n    37\t    content BLOB NOT NULL,\r\n"]
[15.820812, "o", "    38\t    uploaded_by TEXT NOT NULL REFERENCES users(id),\r\n    39\t    created_at TEXT NOT NULL\r\n    40\t);\r\n    41\tCREATE TABLE IF NOT EXISTS shares (\r\n    42\t    token TEXT PRIMARY KEY,\r\n    43\t    file_id TEXT NOT NULL REFERENCES files(id),\r\n    44\t    created_by TEXT NOT NULL REFERENCES users(id),\r\n    45\t    created_at TEXT NOT NULL,\r\n    46\t    revoked_at TEXT\r\n    47\t);\r\n    48\tCREATE INDEX IF NOT EXISTS files_org ON files(org_id, name);\r\n    49\tCREATE INDEX IF NOT EXISTS files_folder ON files(folder_id, name);\r\n    50\tCREATE INDEX IF NOT EXISTS shares_file ON shares(file_id);\r\n"]
[15.820862, "o", "    51\t\"\"\"\r\n    52\t\r\n    53\tFILE_COLUMNS = \"id, org_id, folder_id, name, mime_type, size, uploaded_by, created_at\"\r\n    54\t\r\n    55\t\r\n    56\tdef connect(path):\r\n"]
[15.820916, "o", "    57\t    conn = sqlite3.connect(path, timeout=10)\r\n    58\t    conn.row_factory = sqlite3.Row\r\n    59\t    conn.execute(\"PRAGMA foreign_keys = ON\")\r\n    60\t    conn.execute(\"PRAGMA busy_timeout = 10000\")\r\n    61\t    return conn\r\n    62\t\r\n    63\t\r\n    64\tdef get_db():\r\n    65\t    if \"db\" not in g:\r\n    66\t        from flask import current_app\r\n    67\t        g.db = connect(current_app.config[\"DB_PATH\"])\r\n    68\t    return g.db\r\n    69\t\r\n    70\t\r\n    71\tdef close_db(_exc=None):\r\n    72\t"]
[15.820961, "o", "    conn = g.pop(\"db\", None)\r\n    73\t    if conn is not None:\r\n    74\t        conn.close()\r\n    75\t\r\n    76\t\r\n    77\tdef query_one(sql, params=()):\r\n    78\t    return get_db().execute(sql, params).fetchone()\r\n    79\t\r\n    80\t\r\n    81\tdef query_all(sql, params=()):\r\n    82\t    return get_db().execute(sql, params).fetchall()\r\n    83\t\r\n    84\t\r\n    85\tdef execute(sql, params=()):\r\n    86\t    conn = get_db()\r\n    87\t    cur = conn.execute(sql, params)\r\n    88\t    conn.commit()\r\n    89\t    return cur.rowcount\r\n"]
[15.821004, "o", "    90\t\r\n    91\t\r\n    92\tdef file_json(row):\r\n    93\t    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"folder_id\": row[\"folder_id\"], \"name\": row[\"name\"],\r\n    94\t            \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"], \"uploaded_by\": row[\"uploaded_by\"],\r\n    95\t            \"created_at\": row[\"created_at\"]}\r\n    96\t\r\n    97\t\r\n    98\tdef folder_json(row):\r\n    99\t    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"name\": row[\"name\"]}\r\n"]
