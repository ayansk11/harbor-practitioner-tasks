[16.540717, "o", "     1\t\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\r\n     2\tfrom flask import Blueprint, Response, abort, g, jsonify, request\r\n     3\t\r\n     4\tfrom .. import db\r\n     5\tfrom ..auth import login_required, require_active_org\r\n     6\t\r\n"]
[16.540778, "o", "     7\tbp = Blueprint(\"files\", __name__)\r\n     8\t\r\n     9\t\r\n    10\tdef get_file_or_404(file_id):\r\n    11\t    row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\r\n    12\t    if row is None:\r\n    13\t        abort(404)\r\n    14\t    return row\r\n"]
[16.540816, "o", "    15\t\r\n    16\t\r\n    17\t@bp.get(\"/api/files\")\r\n    18\t@login_required\r\n    19\tdef list_files():\r\n    20\t    org_id = require_active_org()\r\n    21\t    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    22\t    return jsonify(files=[db.file_json(r) for r in rows])\r\n    23\t\r\n    24\t\r\n    25\t@bp.get(\"/api/files/<file_id>\")\r\n    26\t@login_required\r\n    27\tdef get_file(file_id):\r\n    28\t    return jsonify(db.file_json(get_file_or_404(file_id)))\r\n    29\t\r\n    30\t\r\n    31\t@bp.get(\"/api/files/<file_id>/download\")\r\n    32\t@login_required\r\n    33\tdef download(file_id):\r\n"]
[16.540863, "o", "    34\t    row = get_file_or_404(file_id)\r\n    35\t    return file_response(row)\r\n    36\t\r\n    37\t\r\n    38\tdef file_response(row):\r\n    39\t    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\r\n    40\t    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\r\n    41\t    return resp\r\n    42\t\r\n    43\t\r\n"]
[16.540899, "o", "    44\t@bp.patch(\"/api/files/<file_id>\")\r\n    45\t@login_required\r\n    46\tdef rename(file_id):\r\n    47\t    if g.identity.role not in (\"member\", \"org_admin\"):\r\n    48\t        abort(403)\r\n    49\t    row = get_file_or_404(file_id)\r\n    50\t    body = request.get_json(silent=True) or {}\r\n    51\t    name = body.get(\"name\")\r\n    52\t    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\r\n    53\t        abort(400, description=\"bad_name\")\r\n    54\t    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n    55\t    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\r\n    56\t\r\n"]
[16.540943, "o", "    57\t\r\n    58\t@bp.delete(\"/api/files/<file_id>\")\r\n    59\t@login_required\r\n    60\tdef delete(file_id):\r\n    61\t    row = get_file_or_404(file_id)\r\n    62\t    conn = db.get_db()\r\n    63\t    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\r\n    64\t    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\r\n    65\t    conn.commit()\r\n    66\t    return \"\", 204\r\n"]
