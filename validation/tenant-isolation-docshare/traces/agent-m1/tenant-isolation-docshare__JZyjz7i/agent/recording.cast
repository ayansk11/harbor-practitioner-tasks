[51.77776, "i", "sed -n '1,220p' docshare/routes/thumbs.py\n"]
[51.77798, "o", "sed -n '1,220p' docshare/routes/thumbs.py\r\n\u001b[?2004l\r"]
[51.779376, "o", "\"\"\"SVG previews for the file grid.\"\"\"\r\nimport html\r\n\r\nfrom flask import Blueprint, Response, abort\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"thumbs\", __name__)\r\n\r\nTEXT_TYPES = (\"text/\", \"application/json\")\r\n\r\n\r\ndef render_thumb(name, mime_type, content):\r\n    lines = []\r\n    if mime_type.startswith(TEXT_TYPES):\r\n        text = bytes(content).decode(\"utf-8\", \"replace\")\r\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\r\n    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\r\n             f\"<title>{html.escape(name)}</title>\",\r\n"]
[51.779446, "o", "             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n    for i, ln in enumerate(lines):\r\n        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\r\n    parts.append(\"</svg>\")\r\n    return \"\\n\".join(parts)\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/thumb\")\r\n@login_required\r\ndef thumb(file_id):\r\n"]
[51.779502, "o", "    row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404)\r\n    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n    return Response(svg, mimetype=\"image/svg+xml\")\r\n"]
[51.779663, "o", "\u001b[?2004hroot@d4ccd7b6-ea4d-48a5-a845-5e95f7dffe6e:/app# "]
[52.155536, "i", "sed -n '1,110p' docshare/db.py\n"]
[52.155751, "o", "sed -n '1,110p' docshare/db.py\r\n\u001b[?2004l\r"]
[52.157246, "o", "\"\"\"SQLite access. One connection per request (see app.py); rows come back as sqlite3.Row.\"\"\"\r\nimport sqlite3\r\n\r\nfrom flask import g\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS orgs (\r\n    id TEXT PRIMARY KEY,\r\n    name TEXT NOT NULL\r\n"]
[52.157261, "o", ");\r\nCREATE TABLE IF NOT EXISTS users (\r\n    id TEXT PRIMARY KEY,\r\n    email TEXT NOT NULL UNIQUE,\r\n    name TEXT NOT NULL,\r\n    token TEXT NOT NULL UNIQUE,\r\n"]
[52.157271, "o", "    home_org_id TEXT REFERENCES orgs(id),\r\n    is_support INTEGER NOT NULL DEFAULT 0\r\n);\r\n"]
[52.157294, "o", "CREATE TABLE IF NOT EXISTS memberships (\r\n    user_id TEXT NOT NULL REFERENCES users(id),\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    role TEXT NOT NULL CHECK (role IN ('member', 'org_admin')),\r\n    PRIMARY KEY (user_id, org_id)\r\n);\r\n"]
[52.15744, "o", "CREATE TABLE IF NOT EXISTS folders (\r\n    id TEXT PRIMARY KEY,\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    name TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS files (\r\n    id TEXT PRIMARY KEY,\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    folder_id TEXT NOT NULL REFERENCES folders(id),\r\n    name TEXT NOT NULL,\r\n    mime_type TEXT NOT NULL,\r\n    size INTEGER NOT NULL,\r\n    content BLOB NOT NULL,\r\n    uploaded_by TEXT NOT NULL REFERENCES users(id),\r\n    created_at TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS shares (\r\n    token TEXT PRIMARY KEY,\r\n"]
[52.1575, "o", "    file_id TEXT NOT NULL REFERENCES files(id),\r\n    created_by TEXT NOT NULL REFERENCES users(id),\r\n    created_at TEXT NOT NULL,\r\n    revoked_at TEXT\r\n);\r\nCREATE INDEX IF NOT EXISTS files_org ON files(org_id, name);\r\nCREATE INDEX IF NOT EXISTS files_folder ON files(folder_id, name);\r\nCREATE INDEX IF NOT EXISTS shares_file ON shares(file_id);\r\n\"\"\"\r\n\r\nFILE_COLUMNS = \"id, org_id, folder_id, name, mime_type, size, uploaded_by, created_at\"\r\n\r\n\r\ndef connect(path):\r\n    conn = sqlite3.connect(path, timeout=10)\r\n    conn.row_factory = sqlite3.Row\r\n    conn.execute(\"PRAGMA foreign_keys = ON\")\r\n    conn.execute(\"PRAGMA busy_timeout = 10000\")\r\n    return conn\r\n\r\n\r\ndef get_db():\r\n    if \"db\" not in g:\r\n        from flask import current_app\r\n        g.db = connect(current_app.config[\"DB_PATH\"])\r\n    return g.db\r\n\r\n\r\ndef close_db(_exc=None):\r\n    conn = g.pop(\"db\", None)\r\n    if conn is not None:\r\n        conn.close()\r\n\r\n\r\ndef query_one(sql, params=()):\r\n    return get_db().execute(sql, params).fetchone()\r\n\r\n\r\ndef query_"]
[52.157513, "o", "all(sql, params=()):\r\n    return get_db().execute(sql, params).fetchall()\r\n\r\n\r\ndef execute(sql, params=()):\r\n    conn = get_db()\r\n    cur = conn.execute(sql, params)\r\n    conn.commit()\r\n    return cur.rowcount\r\n\r\n\r\ndef file_json(row):\r\n    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"folder_id\": row[\"folder_id\"], \"name\": row[\"name\"],\r\n            \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"], \"uploaded_by\": row[\"uploaded_by\"],\r\n            \"created_at\": row[\"created_at\"]}\r\n\r\n\r\ndef folder_json(row):\r\n    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"name\": row[\"name\"]}\r\n"]
