[17.548168, "o", "echo '=== schema ==='; nl -ba docshare/db.py | sed -n '1,260p'; echo '=== serve ==='; nl -ba docshare/serve.py\r\n\u001b[?2004l\r"]
[17.548254, "o", "=== schema ===\r\n"]
[17.551084, "o", "     1\t\"\"\"SQLite access. One connection per request (see app.py); rows come back as sqlite3.Row.\"\"\"\r\n     2\timport sqlite3\r\n     3\t\r\n     4\tfrom flask import g\r\n     5\t\r\n     6\tSCHEMA = \"\"\"\r\n     7\tCREATE TABLE IF NOT EXISTS orgs (\r\n     8\t    id TEXT PRIMARY KEY,\r\n"]
[17.551139, "o", "     9\t    name TEXT NOT NULL\r\n    10\t);\r\n    11\tCREATE TABLE IF NOT EXISTS users (\r\n    12\t    id TEXT PRIMARY KEY,\r\n    13\t    email TEXT NOT NULL UNIQUE,\r\n    14\t    name TEXT NOT NULL,\r\n    15\t    token TEXT NOT NULL UNIQUE,\r\n"]
[17.551182, "o", "    16\t    home_org_id TEXT REFERENCES orgs(id),\r\n    17\t    is_support INTEGER NOT NULL DEFAULT 0\r\n    18\t);\r\n    19\tCREATE TABLE IF NOT EXISTS memberships (\r\n    20\t    user_id TEXT NOT NULL REFERENCES users(id),\r\n    21\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    22\t    role TEXT NOT NULL CHECK (role IN ('member', 'org_admin')),\r\n    23\t    PRIMARY KEY (user_id, org_id)\r\n    24\t);\r\n    25\tCREATE TABLE IF NOT EXISTS folders (\r\n"]
[17.551224, "o", "    26\t    id TEXT PRIMARY KEY,\r\n    27\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    28\t    name TEXT NOT NULL\r\n    29\t);\r\n    30\tCREATE TABLE IF NOT EXISTS files (\r\n    31\t    id TEXT PRIMARY KEY,\r\n    32\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    33\t    folder_id TEXT NOT NULL REFERENCES folders(id),\r\n    34\t    name TEXT NOT NULL,\r\n"]
[17.551291, "o", "    35\t    mime_type TEXT NOT NULL,\r\n    36\t    size INTEGER NOT NULL,\r\n    37\t    content BLOB NOT NULL,\r\n    38\t    uploaded_by TEXT NOT NULL REFERENCES users(id),\r\n    39\t    created_at TEXT NOT NULL\r\n    40\t);\r\n    41\tCREATE TABLE IF NOT EXISTS shares (\r\n    42\t    token TEXT PRIMARY KEY,\r\n    43\t    file_id TEXT NOT NULL REFERENCES files(id),\r\n    44\t    created_by TEXT NOT NULL REFERENCES users(id),\r\n    45\t    created_at TEXT NOT NULL,\r\n    46\t    revoked_at TEXT\r\n    47\t);\r\n"]
[17.551333, "o", "    48\tCREATE INDEX IF NOT EXISTS files_org ON files(org_id, name);\r\n    49\tCREATE INDEX IF NOT EXISTS files_folder ON files(folder_id, name);\r\n    50\tCREATE INDEX IF NOT EXISTS shares_file ON shares(file_id);\r\n    51\t\"\"\"\r\n    52\t\r\n    53\tFILE_COLUMNS = \"id, org_id, folder_id, name, mime_type, size, uploaded_by, created_at\"\r\n    54\t\r\n    55\t\r\n    56\tdef connect(path):\r\n    57\t    conn = sqlite3.connect(path, timeout=10)\r\n    58\t    conn.row_factory = sqlite3.Row\r\n    59\t    conn.execute(\"PRAGMA foreign_keys = ON\")\r\n    60\t    conn.execute(\"PRAGMA busy_timeout = 10000\")\r\n    61\t    return conn\r\n    62\t\r\n    63\t\r\n    64\tdef get_db():\r\n"]
[17.551362, "o", "    65\t    if \"db\" not in g:\r\n    66\t        from flask import current_app\r\n    67\t        g.db = connect(current_app.config[\"DB_PATH\"])\r\n    68\t    return g.db\r\n"]
[17.551442, "o", "    69\t\r\n    70\t\r\n    71\tdef close_db(_exc=None):\r\n    72\t    conn = g.pop(\"db\", None)\r\n    73\t    if conn is not None:\r\n    74\t        conn.close()\r\n    75\t\r\n    76\t\r\n"]
[17.551487, "o", "    77\tdef query_one(sql, params=()):\r\n    78\t    return get_db().execute(sql, params).fetchone()\r\n    79\t\r\n    80\t\r\n    81\tdef query_all(sql, params=()):\r\n    82\t    return get_db().execute(sql, params).fetchall()\r\n    83\t\r\n    84\t\r\n    85\tdef execute(sql, params=()):\r\n    86\t    conn = get_db()\r\n    87\t    cur = conn.execute(sql, params)\r\n    88\t    conn.commit()\r\n    89\t    return cur.rowcount\r\n    90\t\r\n    91\t\r\n    92\tdef file_json(row):\r\n    93\t    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"folder_id\": row[\"folder_id\"], \"name\": row[\"name\"],\r\n    94\t            \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"], \"uploaded_by\": row[\"uploaded_by\"],\r\n    95\t            \"created_at\": row[\"created_at\"]}\r\n"]
[17.551553, "o", "    96\t\r\n    97\t\r\n    98\tdef folder_json(row):\r\n    99\t    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"name\": row[\"name\"]}\r\n"]
[17.551807, "o", "=== serve ===\r\n"]
[17.55289, "o", "     1\t\"\"\"Run the API: python -m docshare.serve --db <path> --port <port>.\"\"\"\r\n     2\timport argparse\r\n     3\timport os\r\n     4\timport sys\r\n     5\t\r\n     6\tfrom waitress import serve\r\n     7\t\r\n     8\tfrom . import db\r\n     9\tfrom .app import create_app\r\n"]
[17.552948, "o", "    10\t\r\n    11\t\r\n    12\tdef main(argv=None):\r\n    13\t    p = argparse.ArgumentParser(description=\"docshare API server\")\r\n    14\t    p.add_argument(\"--db\", required=True, help=\"path to an existing docshare SQLite database\")\r\n    15\t    p.add_argument(\"--port\", type=int, default=8080)\r\n    16\t    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n"]
[17.553011, "o", "    17\t    p.add_argument(\"--threads\", type=int, default=4)\r\n    18\t    args = p.parse_args(argv)\r\n    19\t    if not os.path.isfile(args.db):\r\n    20\t        sys.exit(f\"database not found: {args.db}\")\r\n    21\t    conn = db.connect(args.db)\r\n    22\t    conn.execute(\"PRAGMA journal_mode = WAL\")\r\n    23\t    conn.close()\r\n    24\t    serve(create_app(os.path.abspath(args.db)), host=args.host, port=args.port, threads=args.threads,\r\n    25\t          ident=\"docshare\")\r\n    26\t\r\n    27\t\r\n    28\tif __name__ == \"__main__\":\r\n    29\t    main()\r\n"]
