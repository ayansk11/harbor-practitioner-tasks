[312.815707, "i", "python - <<'PY'\nfor path, marker in [('docshare/routes/files.py', 'def rename'), ('docshare/routes/export.py', 'def export')]:\n    text = open(path).read()\n    if path.endswith('files.py'):\n        text = text.replace('    body = request.get_json(silent=True) or {}\\n    name = body.get(\"name\")',\n                            '    body = request.get_json(silent=True)\\n    if not isinstance(body, dict):\\n        abort(400, description=\"bad_name\")\\n    name = body.get(\"name\")')\n    else:\n        text = text.replace('    body = request.get_json(silent=True) or {}\\n    ids = body.get(\"file_ids\")',\n                            '    body = request.get_json(silent=True)\\n    if not isinstance(body, dict):\\n        abort(400, description=\"bad_file_ids\")\\n    ids = body.get(\"file_ids\")')\n    open(path, 'w').write(text)\nPY\npython -m compileall -q docshare\npython -m pytest -q tests\nPYTHONPATH=/app python /tmp/verify_docshare.py\n"]
