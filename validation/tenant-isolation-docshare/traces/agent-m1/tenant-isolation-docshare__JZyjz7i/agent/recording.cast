[16.16485, "o", "=== app.py ===\r\n"]
[16.166222, "o", "     1\t\"\"\"Flask application factory.\"\"\"\r\n     2\tfrom flask import Flask, g, jsonify\r\n     3\tfrom werkzeug.exceptions import HTTPException\r\n     4\t\r\n     5\tfrom . import db\r\n     6\tfrom .auth import login_required\r\n     7\tfrom .routes import admin, export, files, folders, share, thumbs\r\n     8\t\r\n     9\t\r\n"]
[16.166262, "o", "    10\tdef create_app(db_path):\r\n    11\t    app = Flask(__name__)\r\n    12\t    app.config[\"DB_PATH\"] = db_path\r\n    13\t    app.teardown_appcontext(db.close_db)\r\n    14\t    for module in (files, folders, thumbs, export, share, admin):\r\n    15\t        app.register_blueprint(module.bp)\r\n    16\t\r\n    17\t    @app.errorhandler(HTTPException)\r\n    18\t    def http_error(exc):\r\n    19\t        code = exc.description if exc.code == 400 and exc.description and \" \" not in exc.description else exc.name\r\n    20\t        return jsonify(error=code.lower().replace(\" \", \"_\")), exc.code\r\n    21\t\r\n"]
[16.166311, "o", "    22\t    @app.get(\"/api/health\")\r\n    23\t    def health():\r\n    24\t        return jsonify(ok=True)\r\n    25\t\r\n    26\t    @app.get(\"/api/me\")\r\n    27\t    @login_required\r\n"]
[16.166372, "o", "    28\t    def me():\r\n    29\t        ident = g.identity\r\n    30\t        return jsonify(user={\"id\": ident.user_id, \"email\": ident.email, \"name\": ident.name,\r\n    31\t                             \"is_support\": ident.is_support},\r\n    32\t                       active_org_id=ident.org_id, role=ident.role,\r\n    33\t                       memberships=[{\"org_id\": o, \"role\": r} for o, r in sorted(ident.memberships.items())])\r\n    34\t\r\n    35\t    return app\r\n"]
