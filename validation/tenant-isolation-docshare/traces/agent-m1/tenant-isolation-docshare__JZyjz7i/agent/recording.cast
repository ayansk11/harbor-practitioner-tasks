[215.432326, "i", "cat > /tmp/verify_docshare.py <<'PY'\nimport base64\nfrom tempfile import TemporaryDirectory\n\nfrom docshare import seed\nfrom docshare.app import create_app\n\nwith TemporaryDirectory() as td:\n    path = td + '/test.db'\n    s = seed.build(path, seed.DEV_SPEC)\n    app = create_app(path)\n    app.config['TESTING'] = True\n    c = app.test_client()\n    users = {u['email']: u for u in s['users']}\n    files = {f['name']: f for f in s['files']}\n    def h(name, org=None):\n        u = users[name]\n        d = {'Authorization': 'Bearer ' + u['token']}\n        if org is not None: d['X-Org-Id'] = org\n        return d\n    orgs = {o['name']: o['id'] for o in s['orgs']}\n    hal, mar, tes = orgs.values()\n    ben = users['ben@haldenprice.example']\n    grace = users['grace@okafor-consulting.example']\n    riley = users['riley@support.docshare.example']\n\n    def org_files(org):\n        return [f for f in s['files'] if f['org_id'] == org]\n\n    def no_unauthorized_data(r, forbidden_file):\n        assert r.status_code in (403, 404), (r.st"]
[215.432493, "i", "atus_code, r.data)\n        assert forbidden_file['name'].encode() not in r.data\n        assert forbidden_file['content'] not in r.data\n\n    # Exact public endpoint, login, and invalid-token behavior.\n    assert c.get('/api/health').status_code == 200\n    assert c.get('/api/files').status_code == 401\n    assert c.get('/api/files', headers={'Authorization': 'Bearer nope'}).status_code == 401\n    assert c.get('/api/does-not-exist').status_code == 401\n    assert c.post('/api/does-not-exist').status_code == 401\n    assert c.get('/api/files', headers=h('ben@haldenprice.example')).status_code == 200\n\n    # Active organisation must be a membership, and objects must use active org only.\n    own = org_files(hal)[0]\n    foreign = next(f for f in s['files'] if f['org_id'] == mar)\n    for method, url, kwargs in [\n        ('get', f\"/api/files/{foreign['id']}\", {}),\n        ('get', f\"/api/files/{foreign['id']}/download\", {}),\n        ('get', f\"/api/files/{foreign['id']}/thumb\", {}),\n        ('patch', f\"/api/files/{foreign['"]
[215.432553, "i", "id']}\", {'json': {'name': 'stolen.txt'}}),\n        ('delete', f\"/api/files/{foreign['id']}\", {}),\n        ('post', f\"/api/files/{foreign['id']}/shares\", {}),\n        ('post', '/api/export', {'json': {'file_ids': [foreign['id']]}}),\n    ]:\n        r = getattr(c, method)(url, headers=h('ben@haldenprice.example'), **kwargs)\n        no_unauthorized_data(r, foreign)\n    for bad_org in ('not-a-real-org', mar):\n        assert c.get('/api/files', headers=h('ben@haldenprice.example', bad_org)).status_code == 404\n        assert c.get('/api/folders', headers=h('ben@haldenprice.example', bad_org)).status_code == 404\n\n    # A user in two orgs sees exactly the selected org and gets its correct role.\n    me = c.get('/api/me', headers=h('grace@okafor-consulting.example', tes)).get_json()\n    assert me['active_org_id'] == tes and me['role'] == 'org_admin'\n    ids = {f['id'] for f in c.get('/api/files', headers=h('grace@okafor-consulting.example', tes)).get_json()['files']}\n    assert ids == {f['id'] for f in org_files(tes)}\n "]
