[318.730124, "i", "python - <<'PY'\nimport json, time, urllib.request, urllib.error\nfrom docshare import seed\ns = seed.build('/tmp/docshare-run/test.db', seed.DEV_SPEC)\nben = next(u for u in s['users'] if u['email'] == 'ben@haldenprice.example')\nforeign = next(f for f in s['files'] if f['org_id'] != ben['home_org_id'])\nurl = 'http://127.0.0.1:18080'\nstart = time.monotonic()\nwhile time.monotonic() - start < 30:\n    try:\n        with urllib.request.urlopen(url + '/api/health', timeout=2) as r:\n            assert r.status == 200 and json.load(r) == {'ok': True}\n        break\n    except Exception:\n        time.sleep(.1)\nelse:\n    raise SystemExit('health did not become ready')\nreq = urllib.request.Request(url + f\"/api/files/{foreign['id']}/download\",\n                             headers={'Authorization': 'Bearer ' + ben['token']})\ntry:\n    urllib.request.urlopen(req, timeout=2)\nexcept urllib.error.HTTPError as e:\n    assert e.code in (403, 404), e.code\n    body = e.read()\n    assert foreign['name'].encode() not in body and bytes(for"]
