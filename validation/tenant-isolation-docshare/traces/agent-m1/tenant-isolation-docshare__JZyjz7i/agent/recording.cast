[17.228453, "o", "echo '=== export.py ==='; nl -ba docshare/routes/export.py; echo '=== share.py ==='; nl -ba docshare/routes/share.py; echo '=== admin.py ==='; nl -ba docshare/routes/admin.py\r\n\u001b[?2004l\r"]
[17.22854, "o", "=== export.py ===\r\n"]
[17.229777, "o", "     1\t\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\n     2\timport base64\r\n     3\t\r\n     4\tfrom flask import Blueprint, abort, g, jsonify, request\r\n     5\t\r\n     6\tfrom .. import db\r\n     7\tfrom ..auth import login_required\r\n     8\t\r\n     9\tbp = Blueprint(\"export\", __name__)\r\n"]
[17.229834, "o", "    10\t\r\n    11\tMAX_IDS = 50\r\n    12\t\r\n    13\t\r\n    14\t@bp.post(\"/api/export\")\r\n    15\t@login_required\r\n    16\tdef export():\r\n    17\t    body = request.get_json(silent=True) or {}\r\n    18\t    ids = body.get(\"file_ids\")\r\n    19\t    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n    20\t        abort(400, description=\"bad_file_ids\")\r\n    21\t    # A selection always comes from one folder view, so the first file tells us whose files these are.\r\n    22\t    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\r\n    23\t    if first is None:\r\n    24\t        abort(404)\r\n    25\t    if not g.identity.is_support and first[\"org_id\"] != g.identity.org_id:\r\n    26\t        abort(404)\r\n    27\t    out = []\r\n    28\t    for file_id in ids:\r\n    29\t        row = db.query_one(\"SELECT id, name, mime_type, size, content FROM files WHERE id = ?\", (file_id,))\r\n    30\t        if row is None:\r\n"]
[17.229883, "o", "    31\t            abort(404)\r\n    32\t        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n    33\t                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n    34\t    return jsonify(files=out)\r\n"]
[17.230053, "o", "=== share.py ===\r\n"]
[17.231374, "o", "     1\t\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\r\n     2\timport secrets\r\n     3\tfrom datetime import datetime, timezone\r\n     4\t\r\n     5\tfrom flask import Blueprint, abort, g, jsonify\r\n     6\t\r\n"]
[17.231428, "o", "     7\tfrom .. import db\r\n     8\tfrom ..auth import login_required\r\n     9\tfrom .files import file_response\r\n    10\t\r\n    11\tbp = Blueprint(\"share\", __name__)\r\n    12\t\r\n    13\t\r\n    14\tdef now_iso():\r\n    15\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n    16\t\r\n    17\t\r\n    18\t@bp.post(\"/api/files/<file_id>/shares\")\r\n    19\t@login_required\r\n    20\tdef create_share(file_id):\r\n    21\t    if g.identity.role not in (\"member\", \"org_admin\"):\r\n    22\t        abort(403)\r\n    23\t    row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\r\n    24\t    if row is None:\r\n    25\t        abort(404)\r\n    26\t    token = secrets.token_urlsafe(18)\r\n"]
[17.231483, "o", "    27\t    created = now_iso()\r\n    28\t    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\r\n    29\t               (token, row[\"id\"], g.identity.user_id, created))\r\n    30\t    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\r\n    31\t\r\n    32\t\r\n    33\t@bp.delete(\"/api/shares/<token>\")\r\n    34\t@login_required\r\n    35\tdef revoke_share(token):\r\n    36\t    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\r\n    37\t                       (token,))\r\n    38\t    if row is None or row[\"org_id\"] != g.identity.org_id or g.identity.role not in (\"member\", \"org_admin\"):\r\n    39\t        abort(404)\r\n    40\t    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n    41\t    return \"\", 204\r\n    42\t\r\n    43\t\r\n    44\t@bp.get(\"/s/<token>\")\r\n"]
[17.231532, "o", "    45\tdef public_download(token):\r\n    46\t    row = db.query_one(\"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\r\n    47\t                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (token,))\r\n    48\t    if row is None:\r\n    49\t        abort(404)\r\n    50\t    return file_response(row)\r\n"]
[17.231697, "o", "=== admin.py ===\r\n"]
[17.233894, "o", "     1\t\"\"\"Support console: an overview of every organisation (support staff only).\"\"\"\r\n     2\tfrom flask import Blueprint, abort, g, jsonify\r\n     3\t\r\n     4\tfrom .. import db\r\n"]
[17.233936, "o", "     5\tfrom ..auth import login_required\r\n     6\t\r\n     7\tbp = Blueprint(\"admin\", __name__)\r\n     8\t\r\n     9\t\r\n"]
[17.233969, "o", "    10\t@bp.get(\"/api/admin/orgs\")\r\n    11\t@login_required\r\n    12\tdef orgs():\r\n    13\t    if not g.identity.is_support:\r\n    14\t        abort(403)\r\n    15\t    rows = db.query_all(\"SELECT o.id, o.name, (SELECT COUNT(*) FROM files f WHERE f.org_id = o.id) AS file_count \"\r\n    16\t                        \"FROM orgs o ORDER BY o.name\")\r\n    17\t    return jsonify(orgs=[{\"id\": r[\"id\"], \"name\": r[\"name\"], \"file_count\": r[\"file_count\"]} for r in rows])\r\n"]
