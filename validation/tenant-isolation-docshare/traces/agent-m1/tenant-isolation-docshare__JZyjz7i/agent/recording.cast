[513.247338, "i", "python - <<'PY'\nimport os, signal\nfor entry in os.listdir('/proc'):\n    if not entry.isdigit():\n        continue\n    try:\n        cmd = open(f'/proc/{entry}/cmdline', 'rb').read().replace(b'\\0', b' ')\n    except OSError:\n        continue\n    if b'docshare.serve' in cmd:\n        try:\n            os.kill(int(entry), signal.SIGTERM)\n        except ProcessLookupError:\n            pass\nPY\nfind /app -maxdepth 4 -type f -not -path '*/__pycache__/*' -printf '%p\\n' | sort\npython -m compileall -q docshare\npython -m pytest -q tests\n"]
