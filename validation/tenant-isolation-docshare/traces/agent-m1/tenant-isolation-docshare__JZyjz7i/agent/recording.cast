[16.895798, "o", "     1\t\"\"\"Folder endpoints: the folders of the active organisation and their files.\"\"\"\r\n     2\tfrom flask import Blueprint, abort, jsonify\r\n     3\t\r\n     4\tfrom .. import db\r\n     5\tfrom ..auth import login_required, require_active_org\r\n     6\t\r\n     7\tbp = Blueprint(\"folders\", __name__)\r\n"]
[16.895857, "o", "     8\t\r\n     9\t\r\n    10\t@bp.get(\"/api/folders\")\r\n    11\t@login_required\r\n    12\tdef list_folders():\r\n    13\t    org_id = require_active_org()\r\n    14\t    rows = db.query_all(\"SELECT id, org_id, name FROM folders WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    15\t    return jsonify(folders=[db.folder_json(r) for r in rows])\r\n"]
[16.895892, "o", "    16\t\r\n    17\t\r\n    18\t@bp.get(\"/api/folders/<folder_id>/files\")\r\n    19\t@login_required\r\n    20\t"]
[16.895919, "o", "def folder_files(folder_id):\r\n    21\t    org_id = require_active_org()\r\n    22\t    folder = db.query_one(\"SELECT id, org_id, name FROM folders WHERE id = ? AND org_id = ?\", (folder_id, org_id))\r\n    23\t    if folder is None:\r\n"]
[16.895962, "o", "    24\t        abort(404)\r\n    25\t    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE folder_id = ? AND org_id = ? ORDER BY name\",\r\n    26\t                        (folder_id, org_id))\r\n"]
[16.895997, "o", "    27\t    return jsonify(folder=db.folder_json(folder), files=[db.file_json(r) for r in rows])\r\n"]
[16.896416, "o", "=== thumbs.py ===\r\n"]
[16.89749, "o", "     1\t\"\"\"SVG previews for the file grid.\"\"\"\r\n     2\timport html\r\n     3\t\r\n     4\tfrom flask import Blueprint, Response, abort\r\n     5\t\r\n     6\tfrom .. import db\r\n     7\tfrom ..auth import login_required\r\n     8\t\r\n     9\tbp = Blueprint(\"thumbs\", __name__)\r\n    10\t\r\n    11\tTEXT_TYPES = (\"text/\", \"application/json\")\r\n    12\t\r\n"]
[16.897542, "o", "    13\t\r\n    14\tdef render_thumb(name, mime_type, content):\r\n    15\t    lines = []\r\n    16\t    if mime_type.startswith(TEXT_TYPES):\r\n    17\t        text = bytes(content).decode(\"utf-8\", \"replace\")\r\n    18\t        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\r\n    19\t    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\r\n    20\t             f\"<title>{html.escape(name)}</title>\",\r\n    21\t             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n    22\t             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n    23\t    for i, ln in enumerate(lines):\r\n    24\t        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\r\n    25\t    parts.append(\"</svg>\")\r\n    26\t    return \"\\n\".join(parts)\r\n    27"]
[16.897573, "o", "\t\r\n    28\t\r\n    29\t@bp.get(\"/api/files/<file_id>/thumb\")\r\n    30\t@login_required\r\n    31\tdef thumb(file_id):\r\n"]
[16.897599, "o", "    32\t    row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n    33\t    if row is None:\r\n    34\t        abort(404)\r\n    35\t    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n    36\t    return Response(svg, mimetype=\"image/svg+xml\")\r\n"]
