[450.022658, "i", "python - <<'PY'\nimport json, sqlite3, time, urllib.error, urllib.request\npath = '/tmp/docshare-clean/test.db'\nconn = sqlite3.connect(path)\nconn.row_factory = sqlite3.Row\nben = conn.execute(\"SELECT * FROM users WHERE email = 'ben@haldenprice.example'\").fetchone()\nown = conn.execute('SELECT * FROM files WHERE org_id = ? LIMIT 1', (ben['home_org_id'],)).fetchone()\nforeign = conn.execute('SELECT * FROM files WHERE org_id != ? LIMIT 1', (ben['home_org_id'],)).fetchone()\nurl = 'http://127.0.0.1:18081'\nstart = time.monotonic()\nwhile time.monotonic() - start < 30:\n    try:\n        with urllib.request.urlopen(url + '/api/health', timeout=2) as r:\n            assert r.status == 200 and json.load(r) == {'ok': True}\n        break\n    except Exception:\n        time.sleep(.1)\nelse:\n    raise SystemExit('health did not become ready')\nheaders = {'Authorization': 'Bearer ' + ben['token']}\nwith urllib.request.urlopen(urllib.request.Request(url + f\"/api/files/{own['id']}/download\", headers=headers), timeout=2) as r:\n    assert "]
[450.022772, "i", "r.status == 200 and r.read() == bytes(own['content'])\n    assert 'attachment' in r.headers.get('Content-Disposition', '')\nreq = urllib.request.Request(url + f\"/api/files/{foreign['id']}/download\", headers=headers)\ntry:\n    urllib.request.urlopen(req, timeout=2)\nexcept urllib.error.HTTPError as e:\n    body = e.read()\n    assert e.code in (403, 404)\n    assert foreign['name'].encode() not in body and bytes(foreign['content']) not in body\nelse:\n    raise AssertionError('cross-org download unexpectedly allowed')\nprint('fresh unprivileged server verification passed')\nPY\nfor pid in $(ps -eo pid=,args= | awk '/[d]ocshare\\.serve/ {print $1}'); do kill \"$pid\" 2>/dev/null || true; done\nsleep .3\ncat /tmp/docshare-clean-server.log\n"]
