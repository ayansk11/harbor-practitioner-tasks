[148.373667, "o", "\u001b[?2004h> "]
[148.373912, "o", "    org_id: str | None          # the active organisation for this request\r\n\u001b[?2004l\r"]
[148.373965, "o", "\u001b[?2004h> "]
[148.374208, "o", "    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n\u001b[?2004l\r"]
[148.374259, "o", "\u001b[?2004h> "]
[148.374522, "o", "    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n\u001b[?2004l\r"]
[148.374581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.374629, "o", "\u001b[?2004h> "]
[148.374705, "o", "def _bearer_token():\r\n\u001b[?2004l\r"]
[148.37476, "o", "\u001b[?2004h> "]
[148.37494, "o", "    header = request.headers.get(\"Authorization\", \"\")\r\n\u001b[?2004l\r"]
[148.374993, "o", "\u001b[?2004h> "]
[148.375131, "o", "    if not header.startswith(\"Bearer \"):\r\n\u001b[?2004l\r"]
[148.375183, "o", "\u001b[?2004h> "]
[148.375243, "o", "        return None\r\n\u001b[?2004l\r"]
[148.375292, "o", "\u001b[?2004h> "]
[148.375478, "o", "    return header[len(\"Bearer \"):].strip() or None\r\n\u001b[?2004l\r"]
[148.375531, "o", "\u001b[?2004h> \r\n"]
[148.375581, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.375669, "o", "def load_identity():\r\n\u001b[?2004l\r"]
[148.375747, "o", "\u001b[?2004h> "]
[148.375999, "o", "    \"\"\"Load and validate the caller and active organisation for this request.\"\"\"\r\n\u001b[?2004l\r"]
[148.376051, "o", "\u001b[?2004h> "]
[148.376207, "o", "    if getattr(g, \"identity_loaded\", False):\r\n\u001b[?2004l\r"]
[148.376257, "o", "\u001b[?2004h> "]
[148.37641, "o", "        return getattr(g, \"identity\", None)\r\n\u001b[?2004l\r"]
[148.376463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[148.376512, "o", "> "]
[148.376586, "o", "    token = _bearer_token()\r\n\u001b[?2004l\r"]
[148.376634, "o", "\u001b[?2004h> "]
[148.376706, "o", "    if token is None:\r\n\u001b[?2004l\r"]
[148.376753, "o", "\u001b[?2004h> "]
[148.376816, "o", "        return None\r\n\u001b[?2004l\r"]
[148.376867, "o", "\u001b[?2004h> "]
[148.377276, "o", "    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n\u001b[?2004l\r"]
[148.377326, "o", "\u001b[?2004h> "]
[148.377426, "o", "    if user is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.377479, "o", "> "]
[148.37752, "o", "        return None\r\n\u001b[?2004l\r"]
[148.377563, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[148.377609, "o", "> "]
[148.377778, "o", "    memberships = {r[\"org_id\"]: r[\"role\"] for r in\r\n\u001b[?2004l\r"]
[148.37783, "o", "\u001b[?2004h> "]
[148.378248, "o", "                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n\u001b[?2004l\r"]
[148.378298, "o", "\u001b[?2004h> "]
[148.378468, "o", "    requested_org = request.headers.get(\"X-Org-Id\")\r\n\u001b[?2004l\r"]
[148.378512, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.378564, "o", "\u001b[?2004h> "]
[148.378619, "o", "    if user[\"is_support\"]:\r\n\u001b[?2004l\r"]
[148.378662, "o", "\u001b[?2004h> "]
[148.37873, "o", "        role = \"support\"\r\n\u001b[?2004l\r"]
[148.378775, "o", "\u001b[?2004h> "]
[148.378871, "o", "        if requested_org is None:\r\n\u001b[?2004l\r"]
[148.37892, "o", "\u001b[?2004h> "]
[148.37899, "o", "            org_id = None\r\n\u001b[?2004l\r"]
[148.37903, "o", "\u001b[?2004h> "]
[148.379068, "o", "        else:\r\n\u001b[?2004l\r"]
[148.37911, "o", "\u001b[?2004h> "]
[148.379418, "o", "            # A support header chooses the org used by list endpoints, but it must still be real.\r\n\u001b[?2004l\r"]
[148.379471, "o", "\u001b[?2004h> "]
[148.379739, "o", "            if db.query_one(\"SELECT 1 FROM orgs WHERE id = ?\", (requested_org,)) is None:\r\n\u001b[?2004l\r"]
[148.37978, "o", "\u001b[?2004h> "]
[148.379945, "o", "                abort(404, description=\"unknown_org\")\r\n\u001b[?2004l\r"]
[148.379981, "o", "\u001b[?2004h> "]
[148.38009, "o", "            org_id = requested_org\r\n\u001b[?2004l\r"]
[148.38013, "o", "\u001b[?2004h> "]
[148.380171, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.380212, "o", "> "]
[148.380498, "o", "        org_id = requested_org if requested_org is not None else user[\"home_org_id\"]\r\n\u001b[?2004l\r"]
[148.380532, "o", "\u001b[?2004h> "]
[148.380847, "o", "        membership = db.query_one(\"SELECT role FROM memberships WHERE user_id = ? AND org_id = ?\",\r\n\u001b[?2004l\r"]
[148.380887, "o", "\u001b[?2004h> "]
[148.381213, "o", "                                  (user[\"id\"], org_id)) if org_id is not None else None\r\n\u001b[?2004l\r"]
[148.381248, "o", "\u001b[?2004h"]
[148.38129, "o", "> "]
[148.381362, "o", "        if membership is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.381403, "o", "> "]
[148.38172, "o", "            # Do not reveal whether an organisation id exists but is not one of the caller's orgs.\r\n\u001b[?2004l\r"]
[148.381763, "o", "\u001b[?2004h> "]
[148.381913, "o", "            abort(404, description=\"unknown_org\")\r\n\u001b[?2004l\r"]
[148.381998, "o", "\u001b[?2004h> "]
[148.382217, "o", "        org_id = requested_org if requested_org is not None else user[\"home_org_id\"]\r\n\u001b[?2004l\r"]
[148.382268, "o", "\u001b[?2004h"]
[148.382315, "o", "> "]
[148.382387, "o", "        role = membership[\"role\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[148.382429, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[148.382693, "o", "    ident = Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"],\r\n\u001b[?2004l\r"]
[148.382738, "o", "\u001b[?2004h> "]
[148.383, "o", "                     is_support=bool(user[\"is_support\"]), org_id=org_id, role=role,\r\n\u001b[?2004l\r"]
[148.383043, "o", "\u001b[?2004h> "]
[148.383181, "o", "                     memberships=memberships)\r\n\u001b[?2004l\r"]
[148.383216, "o", "\u001b[?2004h> "]
[148.383307, "o", "    g.identity_loaded = True\r\n\u001b[?2004l\r"]
[148.383365, "o", "\u001b[?2004h> "]
[148.383423, "o", "    g.identity = ident\r\n\u001b[?2004l\r"]
[148.383465, "o", "\u001b[?2004h> "]
[148.383512, "o", "    return ident\r\n\u001b[?2004l\r"]
[148.383556, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[148.383598, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.383694, "o", "def login_required(view):\r\n\u001b[?2004l\r"]
[148.383736, "o", "\u001b[?2004h> "]
[148.383813, "o", "    @functools.wraps(view)\r\n\u001b[?2004l\r"]
[148.383855, "o", "\u001b[?2004h> "]
[148.383962, "o", "    def wrapper(*args, **kwargs):\r\n\u001b[?2004l\r"]
[148.384005, "o", "\u001b[?2004h> "]
[148.384107, "o", "        if hasattr(g, \"identity\"):\r\n\u001b[?2004l\r"]
[148.384148, "o", "\u001b[?2004h> "]
[148.384271, "o", "            return view(*args, **kwargs)\r\n\u001b[?2004l\r"]
[148.384313, "o", "\u001b[?2004h> "]
[148.384412, "o", "        ident = load_identity()\r\n\u001b[?2004l\r"]
[148.384459, "o", "\u001b[?2004h> "]
[148.384528, "o", "        if ident is None:\r\n\u001b[?2004l\r"]
[148.384572, "o", "\u001b[?2004h> "]
[148.384734, "o", "            return jsonify(error=\"unauthorized\"), 401\r\n\u001b[?2004l\r"]
[148.384776, "o", "\u001b[?2004h> "]
[148.384852, "o", "        g.identity = ident\r\n\u001b[?2004l\r"]
[148.384895, "o", "\u001b[?2004h> "]
[148.385002, "o", "        return view(*args, **kwargs)\r\n\u001b[?2004l\r"]
[148.385057, "o", "\u001b[?2004h> "]
[148.385098, "o", "    return wrapper\r\n\u001b[?2004l\r"]
[148.385147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.385177, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[148.385212, "o", "> "]
[148.385286, "o", "def require_active_org():\r\n\u001b[?2004l\r"]
[148.385323, "o", "\u001b[?2004h> "]
[148.385638, "o", "    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\r\n\u001b[?2004l\r"]
[148.385677, "o", "\u001b[?2004h> "]
[148.385768, "o", "    org_id = g.identity.org_id\r\n\u001b[?2004l\r"]
[148.385802, "o", "\u001b[?2004h> "]
[148.385878, "o", "    if org_id is None:\r\n\u001b[?2004l\r"]
[148.385911, "o", "\u001b[?2004h> "]
[148.386077, "o", "        abort(400, description=\"x_org_id_required\")\r\n\u001b[?2004l\r"]
[148.386158, "o", "\u001b[?2004h> "]
[148.386227, "o", "    return org_id\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[148.388862, "o", "\u001b[?2004hroot@d4ccd7b6-ea4d-48a5-a845-5e95f7dffe6e:/app# "]
[148.388933, "o", "\r\n\u001b[?2004l\r"]
[148.388983, "o", "\u001b[?2004hroot@d4ccd7b6-ea4d-48a5-a845-5e95f7dffe6e:/app# "]
[148.389071, "o", "cat > docshare/app.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.389122, "o", "> "]
[148.389178, "o", "\"\"\"Flask application factory.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.389331, "o", "from flask import Flask, g, jsonify, request\r\n\u001b[?2004l\r"]
[148.389405, "o", "\u001b[?2004h> "]
[148.389516, "o", "from werkzeug.exceptions import HTTPException\r\n\u001b[?2004l\r"]
[148.389568, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.389638, "o", "from . import db\r\n\u001b[?2004l\r"]
[148.389699, "o", "\u001b[?2004h> "]
[148.389777, "o", "from .auth import load_identity\r\n\u001b[?2004l\r"]
[148.389828, "o", "\u001b[?2004h> "]
[148.39002, "o", "from .routes import admin, export, files, folders, share, thumbs\r\n\u001b[?2004l\r"]
[148.390073, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.390125, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[148.390172, "o", "> "]
[148.390219, "o", "def create_app(db_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.390316, "o", "    app = Flask(__name__)\r\n\u001b[?2004l\r"]
[148.390385, "o", "\u001b[?2004h> "]
[148.39047, "o", "    app.config[\"DB_PATH\"] = db_path\r\n\u001b[?2004l\r"]
[148.390521, "o", "\u001b[?2004h> "]
[148.390633, "o", "    app.teardown_appcontext(db.close_db)\r\n\u001b[?2004l\r"]
[148.390681, "o", "\u001b[?2004h> "]
[148.390878, "o", "    for module in (files, folders, thumbs, export, share, admin):\r\n\u001b[?2004l\r"]
[148.390895, "o", "\u001b[?2004h> "]
[148.391054, "o", "        app.register_blueprint(module.bp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.391081, "o", "> \r\n\u001b[?2004l\r"]
[148.391098, "o", "\u001b[?2004h"]
[148.391114, "o", "> "]
[148.391193, "o", "    @app.before_request\r\n\u001b[?2004l\r"]
[148.39121, "o", "\u001b[?2004h> "]
[148.391341, "o", "    def authenticate_api_request():\r\n\u001b[?2004l\r"]
[148.391388, "o", "\u001b[?2004h> "]
[148.391654, "o", "        \"\"\"Apply the login and active-org policy before any API route can run.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.39167, "o", "> "]
[148.391772, "o", "        path = request.path\r\n\u001b[?2004l\r"]
[148.391788, "o", "\u001b[?2004h"]
[148.391804, "o", "> "]
[148.392006, "o", "        if path != \"/api\" and not path.startswith(\"/api/\"):\r\n\u001b[?2004l\r"]
[148.392022, "o", "\u001b[?2004h"]
[148.392038, "o", "> "]
[148.392118, "o", "            return None\r\n\u001b[?2004l\r"]
[148.392133, "o", "\u001b[?2004h"]
[148.392149, "o", "> "]
[148.392301, "o", "        # Only the exact health GET is public.\r\n\u001b[?2004l\r"]
[148.392318, "o", "\u001b[?2004h"]
[148.392334, "o", "> "]
[148.39254, "o", "        if request.method == \"GET\" and path == \"/api/health\":\r\n\u001b[?2004l\r"]
[148.392556, "o", "\u001b[?2004h"]
[148.392573, "o", "> "]
[148.392655, "o", "            return None\r\n\u001b[?2004l\r"]
[148.392671, "o", "\u001b[?2004h"]
[148.392687, "o", "> "]
[148.392791, "o", "        ident = load_identity()\r\n\u001b[?2004l\r"]
[148.392807, "o", "\u001b[?2004h"]
[148.392824, "o", "> "]
[148.39291, "o", "        if ident is None:\r\n\u001b[?2004l\r"]
[148.392926, "o", "\u001b[?2004h"]
[148.392942, "o", "> "]
[148.425517, "o", "            return jsonify(error=\"unauthorized\"), 401\r\n\u001b[?2004l\r\u001b[?2004h>         g.identity = ident\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @app.errorhandler(HTTPException)\r\n\u001b[?2004l\r\u001b[?2004h>     def http_error(exc):\r\n\u001b[?2004l\r\u001b[?2004h>         code = exc.description if exc.code == 400 and exc.description and \" \" not in exc.description else exc.name\r\n\u001b[?2004l\r\u001b[?2004h>         status = exc.code\r\n\u001b[?2004l\r\u001b[?2004h>         # A valid caller has no permitted endpoint here; 404 avoids revealing method-specific details.\r\n\u001b[?2004l\r\u001b[?2004h>         if status == 405 and (request.path == \"/api\" or request.path.startswith(\"/api/\")):\r\n\u001b[?2004l\r\u001b[?2004h>             status = 404\r\n\u001b[?2004l\r\u001b[?2004h>             code = \"Not Found\"\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify(error=code.lower().replace(\" \", \"_\")), status\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @app.get(\"/api/health\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.425695, "o", "    def health():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.425857, "o", "        return jsonify(ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.426168, "o", "    @app.get(\"/api/me\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.426223, "o", "    @login_required\r\n\u001b[?2004l\r\u001b[?2004h>     def me():\r\n\u001b[?2004l\r\u001b[?2004h>         ident = g.identity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.426762, "o", "        return jsonify(user={\"id\": ident.user_id, \"email\": ident.email, \"name\": ident.name,\r\n\u001b[?2004l\r"]
[148.426815, "o", "\u001b[?2004h"]
[148.426865, "o", "> "]
[148.427336, "o", "                             \"is_support\": ident.is_support},\r\n\u001b[?2004l\r"]
[148.427402, "o", "\u001b[?2004h"]
[148.427454, "o", "> "]
[148.427973, "o", "                       active_org_id=ident.org_id, role=ident.role,\r\n\u001b[?2004l\r"]
[148.428031, "o", "\u001b[?2004h"]
[148.428082, "o", "> "]
[148.428988, "o", "                       memberships=[{\"org_id\": o, \"role\": r} for o, r in sorted(ident.memberships.items())])\r\n\u001b[?2004l\r"]
[148.429054, "o", "\u001b[?2004h> "]
[148.429106, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.429153, "o", "> "]
[148.429272, "o", "    return app\r\n\u001b[?2004l\r"]
[148.429322, "o", "\u001b[?2004h"]
[148.429378, "o", "> PY\r\n"]
[148.429426, "o", "\u001b[?2004l\r"]
[148.431596, "o", "\u001b[?2004h"]
[148.431645, "o", "root@d4ccd7b6-ea4d-48a5-a845-5e95f7dffe6e:/app# "]
[148.755229, "i", "cat > docshare/routes/files.py <<'PY'\n\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\nfrom flask import Blueprint, Response, abort, g, jsonify, request\n\nfrom .. import db\nfrom ..auth import login_required, require_active_org\n\nbp = Blueprint(\"files\", __name__)\n\n\ndef get_file_or_404(file_id):\n    \"\"\"Fetch a file only if the active caller is allowed to see that file.\"\"\"\n    if g.identity.is_support:\n        row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\n    else:\n        row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ? AND org_id = ?\",\n                           (file_id, g.identity.org_id))\n    if row is None:\n        abort(404)\n    return row\n\n\n@bp.get(\"/api/files\")\n@login_required\ndef list_files():\n    org_id = require_active_org()\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\n    return jsonify(files=[db.file_json(r) for r in rows])\n\n\n@bp.get(\"/api/files/<fil"]
[148.755321, "i", "e_id>\")\n@login_required\ndef get_file(file_id):\n    return jsonify(db.file_json(get_file_or_404(file_id)))\n\n\n@bp.get(\"/api/files/<file_id>/download\")\n@login_required\ndef download(file_id):\n    row = get_file_or_404(file_id)\n    return file_response(row)\n\n\ndef file_response(row):\n    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\n    return resp\n\n\n@bp.patch(\"/api/files/<file_id>\")\n@login_required\ndef rename(file_id):\n    if g.identity.role not in (\"member\", \"org_admin\"):\n        abort(403)\n    row = get_file_or_404(file_id)\n    body = request.get_json(silent=True) or {}\n    name = body.get(\"name\")\n    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\n        abort(400, description=\"bad_name\")\n    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\n    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\n\n\n@bp.delete(\"/api/files/<file_id>\")\n@login_required\ndef del"]
[148.755358, "i", "ete(file_id):\n    if g.identity.role != \"org_admin\":\n        abort(403)\n    row = get_file_or_404(file_id)\n    conn = db.get_db()\n    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\n    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\n    conn.commit()\n    return \"\", 204\nPY\n\ncat > docshare/routes/thumbs.py <<'PY'\n\"\"\"SVG previews for the file grid.\"\"\"\nimport html\n\nfrom flask import Blueprint, Response, abort, g\n\nfrom .. import db\nfrom ..auth import login_required\n\nbp = Blueprint(\"thumbs\", __name__)\n\nTEXT_TYPES = (\"text/\", \"application/json\")\n\n\ndef render_thumb(name, mime_type, content):\n    lines = []\n    if mime_type.startswith(TEXT_TYPES):\n        text = bytes(content).decode(\"utf-8\", \"replace\")\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\n    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\n             f\"<title>{html.escape(name)}</title>\",\n             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\""]
[148.755383, "i", "199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\n             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\n    for i, ln in enumerate(lines):\n        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\n    parts.append(\"</svg>\")\n    return \"\\n\".join(parts)\n\n\n@bp.get(\"/api/files/<file_id>/thumb\")\n@login_required\ndef thumb(file_id):\n    if g.identity.is_support:\n        row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\n    else:\n        row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ? AND org_id = ?\",\n                           (file_id, g.identity.org_id))\n    if row is None:\n        abort(404)\n    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\n    return Response(svg, mimetype=\"image/svg+xml\")\nPY\n"]
