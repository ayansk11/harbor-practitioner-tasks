"""Who is calling: bearer token -> user, plus the active organisation for this request."""
import functools
from dataclasses import dataclass, field

from flask import abort, g, jsonify, request

from . import db


@dataclass
class Identity:
    user_id: str
    email: str
    name: str
    is_support: bool
    org_id: str | None          # the active organisation for this request
    role: str                   # "member", "org_admin" or "support"
    memberships: dict = field(default_factory=dict)   # org_id -> role


def _bearer_token():
    header = request.headers.get("Authorization", "")
    if not header.startswith("Bearer "):
        return None
    return header[len("Bearer "):].strip() or None


def load_identity():
    """Load and validate the caller and active organisation for this request."""
    if getattr(g, "identity_loaded", False):
        return getattr(g, "identity", None)

    token = _bearer_token()
    if token is None:
        return None
    user = db.query_one("SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?", (token,))
    if user is None:
        return None

    memberships = {r["org_id"]: r["role"] for r in
                   db.query_all("SELECT org_id, role FROM memberships WHERE user_id = ?", (user["id"],))}
    requested_org = request.headers.get("X-Org-Id")

    if user["is_support"]:
        role = "support"
        if requested_org is None:
            org_id = None
        else:
            # A support header chooses the org used by list endpoints, but it must still be real.
            if db.query_one("SELECT 1 FROM orgs WHERE id = ?", (requested_org,)) is None:
                abort(404, description="unknown_org")
            org_id = requested_org
    else:
        org_id = requested_org if requested_org is not None else user["home_org_id"]
        membership = db.query_one("SELECT role FROM memberships WHERE user_id = ? AND org_id = ?",
                                  (user["id"], org_id)) if org_id is not None else None
        if membership is None:
            # Do not reveal whether an organisation id exists but is not one of the caller's orgs.
            abort(404, description="unknown_org")
        org_id = requested_org if requested_org is not None else user["home_org_id"]
        role = membership["role"]

    ident = Identity(user_id=user["id"], email=user["email"], name=user["name"],
                     is_support=bool(user["is_support"]), org_id=org_id, role=role,
                     memberships=memberships)
    g.identity_loaded = True
    g.identity = ident
    return ident


def login_required(view):
    @functools.wraps(view)
    def wrapper(*args, **kwargs):
        if hasattr(g, "identity"):
            return view(*args, **kwargs)
        ident = load_identity()
        if ident is None:
            return jsonify(error="unauthorized"), 401
        g.identity = ident
        return view(*args, **kwargs)
    return wrapper


def require_active_org():
    """The active organisation id; support must name one with X-Org-Id before listing anything."""
    org_id = g.identity.org_id
    if org_id is None:
        abort(400, description="x_org_id_required")
    return org_id
=== app.py ===
"""Flask application factory."""
from flask import Flask, g, jsonify, request
from werkzeug.exceptions import HTTPException

from . import db
from .auth import load_identity, login_required
from .routes import admin, export, files, folders, share, thumbs


def create_app(db_path):
    app = Flask(__name__)
    app.config["DB_PATH"] = db_path
    app.teardown_appcontext(db.close_db)
    for module in (files, folders, thumbs, export, share, admin):
        app.register_blueprint(module.bp)

    @app.before_request
    def authenticate_api_request():
        """Apply the login and active-org policy before any API route can run."""
        path = request.path
        if path != "/api" and not path.startswith("/api/"):
            return None
        # Only the exact health GET is public.
        if request.method == "GET" and path == "/api/health":
            return None
        ident = load_identity()
        if ident is None:
            return jsonify(error="unauthorized"), 401
        g.identity = ident
        return None

    @app.errorhandler(HTTPException)
    def http_error(exc):
        code = exc.description if exc.code == 400 and exc.description and " " not in exc.description else exc.name
        status = exc.code
        # A valid caller has no permitted endpoint here; 404 avoids revealing method-specific details.
        if status == 405 and (request.path == "/api" or request.path.startswith("/api/")):
            status = 404
            code = "Not Found"
        return jsonify(error=code.lower().replace(" ", "_")), status

    @app.get("/api/health")
    def health():
        return jsonify(ok=True)

    @app.get("/api/me")
    @login_required
    def me():
        ident = g.identity
        return jsonify(user={"id": ident.user_id, "email": ident.email, "name": ident.name,
                             "is_support": ident.is_support},
                       active_org_id=ident.org_id, role=ident.role,
                       memberships=[{"org_id": o, "role": r} for o, r in sorted(ident.memberships.items())])

    return app
=== files.py ===
"""File endpoints: list, metadata, download, rename, delete."""
from flask import Blueprint, Response, abort, g, jsonify, request

from .. import db
from ..auth import login_required, require_active_org

bp = Blueprint("files", __name__)


def get_file_or_404(file_id):
    """Fetch a file only if the active caller is allowed to see that file."""
    if g.identity.is_support:
        row = db.query_one(f"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?", (file_id,))
    else:
        row = db.query_one(f"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ? AND org_id = ?",
                           (file_id, g.identity.org_id))
    if row is None:
        abort(404)
    return row


@bp.get("/api/files")
@login_required
def list_files():
    org_id = require_active_org()
    rows = db.query_all(f"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name", (org_id,))
    return jsonify(files=[db.file_json(r) for r in rows])


@bp.get("/api/files/<file_id>")
@login_required
def get_file(file_id):
    return jsonify(db.file_json(get_file_or_404(file_id)))


@bp.get("/api/files/<file_id>/download")
@login_required
def download(file_id):
    row = get_file_or_404(file_id)
    return file_response(row)


def file_response(row):
    resp = Response(bytes(row["content"]), mimetype=row["mime_type"])
    resp.headers["Content-Disposition"] = f'attachment; filename="{row["name"]}"'
    return resp


@bp.patch("/api/files/<file_id>")
@login_required
def rename(file_id):
    if g.identity.role not in ("member", "org_admin"):
        abort(403)
    row = get_file_or_404(file_id)
    body = request.get_json(silent=True) or {}
    name = body.get("name")
    if not isinstance(name, str) or not (1 <= len(name) <= 200) or "/" in name:
        abort(400, description="bad_name")
    db.execute("UPDATE files SET name = ? WHERE id = ?", (name, row["id"]))
    return jsonify(db.file_json(get_file_or_404(row["id"])))


@bp.delete("/api/files/<file_id>")
@login_required
def delete(file_id):
    if g.identity.role != "org_admin":
        abort(403)
    row = get_file_or_404(file_id)
    conn = db.get_db()
    conn.execute("DELETE FROM shares WHERE file_id = ?", (row["id"],))
    conn.execute("DELETE FROM files WHERE id = ?", (row["id"],))
    conn.commit()
    return "", 204
