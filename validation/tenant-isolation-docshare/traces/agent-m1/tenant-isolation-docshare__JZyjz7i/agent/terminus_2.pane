     1	"""Who is calling: bearer token -> user, plus the active organisation for this request."""
     2	import functools
     3	from dataclasses import dataclass, field
     4	
     5	from flask import g, jsonify, request
     6	
     7	from . import db
     8	
     9	
    10	@dataclass
    11	class Identity:
    12	    user_id: str
    13	    email: str
    14	    name: str
    15	    is_support: bool
    16	    org_id: str | None          # the active organisation for this request
    17	    role: str                   # "member", "org_admin" or "support"
    18	    memberships: dict = field(default_factory=dict)   # org_id -> role
    19	
    20	
    21	def _bearer_token():
    22	    header = request.headers.get("Authorization", "")
    23	    if not header.startswith("Bearer "):
    24	        return None
    25	    return header[len("Bearer "):].strip() or None
    26	
    27	
    28	def load_identity():
    29	    token = _bearer_token()
    30	    if token is None:
    31	        return None
    32	    user = db.query_one("SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?", (token,))
    33	    if user is None:
    34	        return None
    35	    memberships = {r["org_id"]: r["role"] for r in
    36	                   db.query_all("SELECT org_id, role FROM memberships WHERE user_id = ?", (user["id"],))}
    37	    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.
    38	    org_id = request.headers.get("X-Org-Id") or user["home_org_id"]
    39	    if user["is_support"]:
    40	        role = "support"
    41	    else:
    42	        role = memberships.get(org_id, "member")
    43	    return Identity(user_id=user["id"], email=user["email"], name=user["name"], is_support=bool(user["is_support"]),
    44	                    org_id=org_id, role=role, memberships=memberships)
    45	
    46	
    47	def login_required(view):
    48	    @functools.wraps(view)
    49	    def wrapper(*args, **kwargs):
    50	        ident = load_identity()
    51	        if ident is None:
    52	            return jsonify(error="unauthorized"), 401
    53	        g.identity = ident
    54	        return view(*args, **kwargs)
    55	    return wrapper
    56	
    57	
    58	def require_active_org():
    59	    """The active organisation id; support must name one with X-Org-Id before listing anything."""
    60	    org_id = g.identity.org_id
    61	    if org_id is None:
    62	        from flask import abort
    63	        abort(400, description="x_org_id_required")
    64	    return org_id
