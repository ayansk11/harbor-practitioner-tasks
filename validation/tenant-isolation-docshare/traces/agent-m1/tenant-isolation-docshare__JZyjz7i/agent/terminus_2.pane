     1	"""Flask application factory."""
     2	from flask import Flask, g, jsonify
     3	from werkzeug.exceptions import HTTPException
     4	
     5	from . import db
     6	from .auth import login_required
     7	from .routes import admin, export, files, folders, share, thumbs
     8	
     9	
    10	def create_app(db_path):
    11	    app = Flask(__name__)
    12	    app.config["DB_PATH"] = db_path
    13	    app.teardown_appcontext(db.close_db)
    14	    for module in (files, folders, thumbs, export, share, admin):
    15	        app.register_blueprint(module.bp)
    16	
    17	    @app.errorhandler(HTTPException)
    18	    def http_error(exc):
    19	        code = exc.description if exc.code == 400 and exc.description and " " not in exc.description else exc.name
    20	        return jsonify(error=code.lower().replace(" ", "_")), exc.code
    21	
    22	    @app.get("/api/health")
    23	    def health():
    24	        return jsonify(ok=True)
    25	
    26	    @app.get("/api/me")
    27	    @login_required
    28	    def me():
    29	        ident = g.identity
    30	        return jsonify(user={"id": ident.user_id, "email": ident.email, "name": ident.name,
    31	                             "is_support": ident.is_support},
    32	                       active_org_id=ident.org_id, role=ident.role,
    33	                       memberships=[{"org_id": o, "role": r} for o, r in sorted(ident.memberships.items())])
    34	
    35	    return app
