     1	"""File endpoints: list, metadata, download, rename, delete."""
     2	from flask import Blueprint, Response, abort, g, jsonify, request
     3	
     4	from .. import db
     5	from ..auth import login_required, require_active_org
     6	
     7	bp = Blueprint("files", __name__)
     8	
     9	
    10	def get_file_or_404(file_id):
    11	    row = db.query_one(f"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?", (file_id,))
    12	    if row is None:
    13	        abort(404)
    14	    return row
    15	
    16	
    17	@bp.get("/api/files")
    18	@login_required
    19	def list_files():
    20	    org_id = require_active_org()
    21	    rows = db.query_all(f"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name", (org_id,))
    22	    return jsonify(files=[db.file_json(r) for r in rows])
    23	
    24	
    25	@bp.get("/api/files/<file_id>")
    26	@login_required
    27	def get_file(file_id):
    28	    return jsonify(db.file_json(get_file_or_404(file_id)))
    29	
    30	
    31	@bp.get("/api/files/<file_id>/download")
    32	@login_required
    33	def download(file_id):
    34	    row = get_file_or_404(file_id)
    35	    return file_response(row)
    36	
    37	
    38	def file_response(row):
    39	    resp = Response(bytes(row["content"]), mimetype=row["mime_type"])
    40	    resp.headers["Content-Disposition"] = f'attachment; filename="{row["name"]}"'
    41	    return resp
    42	
    43	
    44	@bp.patch("/api/files/<file_id>")
    45	@login_required
    46	def rename(file_id):
    47	    if g.identity.role not in ("member", "org_admin"):
    48	        abort(403)
    49	    row = get_file_or_404(file_id)
    50	    body = request.get_json(silent=True) or {}
    51	    name = body.get("name")
    52	    if not isinstance(name, str) or not (1 <= len(name) <= 200) or "/" in name:
    53	        abort(400, description="bad_name")
    54	    db.execute("UPDATE files SET name = ? WHERE id = ?", (name, row["id"]))
    55	    return jsonify(db.file_json(get_file_or_404(row["id"])))
    56	
    57	
    58	@bp.delete("/api/files/<file_id>")
    59	@login_required
    60	def delete(file_id):
    61	    row = get_file_or_404(file_id)
    62	    conn = db.get_db()
    63	    conn.execute("DELETE FROM shares WHERE file_id = ?", (row["id"],))
    64	    conn.execute("DELETE FROM files WHERE id = ?", (row["id"],))
    65	    conn.commit()
    66	    return "", 204
