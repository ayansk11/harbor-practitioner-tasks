"""Who is calling: bearer token -> user, plus the active organisation for this request."""
import functools
from dataclasses import dataclass, field

from flask import g, jsonify, request

from . import db


@dataclass
class Identity:
    user_id: str
    email: str
    name: str
    is_support: bool
    org_id: str | None          # the active organisation for this request
    role: str                   # "member", "org_admin" or "support"
    memberships: dict = field(default_factory=dict)   # org_id -> role


def _bearer_token():
    header = request.headers.get("Authorization", "")
    if not header.startswith("Bearer "):
        return None
    return header[len("Bearer "):].strip() or None


def load_identity():
    token = _bearer_token()
    if token is None:
        return None
    user = db.query_one("SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?", (token,))
    if user is None:
        return None
    memberships = {r["org_id"]: r["role"] for r in
                   db.query_all("SELECT org_id, role FROM memberships WHERE user_id = ?", (user["id"],))}
    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.
    org_id = request.headers.get("X-Org-Id") or user["home_org_id"]
    if user["is_support"]:
        role = "support"
    else:
        role = memberships.get(org_id, "member")
    return Identity(user_id=user["id"], email=user["email"], name=user["name"], is_support=bool(user["is_support"]),
                    org_id=org_id, role=role, memberships=memberships)


def login_required(view):
    @functools.wraps(view)
    def wrapper(*args, **kwargs):
        ident = load_identity()
        if ident is None:
            return jsonify(error="unauthorized"), 401
        g.identity = ident
        return view(*args, **kwargs)
    return wrapper


def require_active_org():
    """The active organisation id; support must name one with X-Org-Id before listing anything."""
    org_id = g.identity.org_id
    if org_id is None:
        from flask import abort
        abort(400, description="x_org_id_required")
    return org_id
===== docshare/db.py =====
"""SQLite access. One connection per request (see app.py); rows come back as sqlite3.Row."""
import sqlite3

from flask import g

SCHEMA = """
CREATE TABLE IF NOT EXISTS orgs (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS users (
    id TEXT PRIMARY KEY,
    email TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL,
    token TEXT NOT NULL UNIQUE,
    home_org_id TEXT REFERENCES orgs(id),
    is_support INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS memberships (
    user_id TEXT NOT NULL REFERENCES users(id),
    org_id TEXT NOT NULL REFERENCES orgs(id),
    role TEXT NOT NULL CHECK (role IN ('member', 'org_admin')),
    PRIMARY KEY (user_id, org_id)
);
CREATE TABLE IF NOT EXISTS folders (
    id TEXT PRIMARY KEY,
    org_id TEXT NOT NULL REFERENCES orgs(id),
    name TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS files (
    id TEXT PRIMARY KEY,
    org_id TEXT NOT NULL REFERENCES orgs(id),
    folder_id TEXT NOT NULL REFERENCES folders(id),
    name TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    size INTEGER NOT NULL,
    content BLOB NOT NULL,
    uploaded_by TEXT NOT NULL REFERENCES users(id),
    created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS shares (
    token TEXT PRIMARY KEY,
    file_id TEXT NOT NULL REFERENCES files(id),
    created_by TEXT NOT NULL REFERENCES users(id),
    created_at TEXT NOT NULL,
    revoked_at TEXT
);
CREATE INDEX IF NOT EXISTS files_org ON files(org_id, name);
CREATE INDEX IF NOT EXISTS files_folder ON files(folder_id, name);
CREATE INDEX IF NOT EXISTS shares_file ON shares(file_id);
"""

FILE_COLUMNS = "id, org_id, folder_id, name, mime_type, size, uploaded_by, created_at"


def connect(path):
    conn = sqlite3.connect(path, timeout=10)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA busy_timeout = 10000")
    return conn


def get_db():
    if "db" not in g:
        from flask import current_app
        g.db = connect(current_app.config["DB_PATH"])
    return g.db


def close_db(_exc=None):
    conn = g.pop("db", None)
    if conn is not None:
        conn.close()


def query_one(sql, params=()):
    return get_db().execute(sql, params).fetchone()


def query_all(sql, params=()):
    return get_db().execute(sql, params).fetchall()


def execute(sql, params=()):
    conn = get_db()
    cur = conn.execute(sql, params)
    conn.commit()
    return cur.rowcount


def file_json(row):
    return {"id": row["id"], "org_id": row["org_id"], "folder_id": row["folder_id"], "name": row["name"],
            "mime_type": row["mime_type"], "size": row["size"], "uploaded_by": row["uploaded_by"],
            "created_at": row["created_at"]}


def folder_json(row):
    return {"id": row["id"], "org_id": row["org_id"], "name": row["name"]}
===== docshare/app.py =====
"""Flask application factory."""
from flask import Flask, g, jsonify
from werkzeug.exceptions import HTTPException

from . import db
from .auth import login_required
from .routes import admin, export, files, folders, share, thumbs


def create_app(db_path):
    app = Flask(__name__)
    app.config["DB_PATH"] = db_path
    app.teardown_appcontext(db.close_db)
    for module in (files, folders, thumbs, export, share, admin):
        app.register_blueprint(module.bp)

    @app.errorhandler(HTTPException)
    def http_error(exc):
        code = exc.description if exc.code == 400 and exc.description and " " not in exc.description else exc.name
        return jsonify(error=code.lower().replace(" ", "_")), exc.code

    @app.get("/api/health")
    def health():
        return jsonify(ok=True)

    @app.get("/api/me")
    @login_required
    def me():
        ident = g.identity
        return jsonify(user={"id": ident.user_id, "email": ident.email, "name": ident.name,
                             "is_support": ident.is_support},
                       active_org_id=ident.org_id, role=ident.role,
                       memberships=[{"org_id": o, "role": r} for o, r in sorted(ident.memberships.items())])

    return app
===== docshare/serve.py =====
"""Run the API: python -m docshare.serve --db <path> --port <port>."""
import argparse
import os
import sys

from waitress import serve

from . import db
from .app import create_app


def main(argv=None):
    p = argparse.ArgumentParser(description="docshare API server")
    p.add_argument("--db", required=True, help="path to an existing docshare SQLite database")
    p.add_argument("--port", type=int, default=8080)
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--threads", type=int, default=4)
    args = p.parse_args(argv)
    if not os.path.isfile(args.db):
        sys.exit(f"database not found: {args.db}")
    conn = db.connect(args.db)
    conn.execute("PRAGMA journal_mode = WAL")
    conn.close()
    serve(create_app(os.path.abspath(args.db)), host=args.host, port=args.port, threads=args.threads,
          ident="docshare")


if __name__ == "__main__":
    main()
