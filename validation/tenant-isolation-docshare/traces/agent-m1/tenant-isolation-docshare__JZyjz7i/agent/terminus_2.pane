     1	"""SQLite access. One connection per request (see app.py); rows come back as sqlite3.Row."""
     2	import sqlite3
     3	
     4	from flask import g
     5	
     6	SCHEMA = """
     7	CREATE TABLE IF NOT EXISTS orgs (
     8	    id TEXT PRIMARY KEY,
     9	    name TEXT NOT NULL
    10	);
    11	CREATE TABLE IF NOT EXISTS users (
    12	    id TEXT PRIMARY KEY,
    13	    email TEXT NOT NULL UNIQUE,
    14	    name TEXT NOT NULL,
    15	    token TEXT NOT NULL UNIQUE,
    16	    home_org_id TEXT REFERENCES orgs(id),
    17	    is_support INTEGER NOT NULL DEFAULT 0
    18	);
    19	CREATE TABLE IF NOT EXISTS memberships (
    20	    user_id TEXT NOT NULL REFERENCES users(id),
    21	    org_id TEXT NOT NULL REFERENCES orgs(id),
    22	    role TEXT NOT NULL CHECK (role IN ('member', 'org_admin')),
    23	    PRIMARY KEY (user_id, org_id)
    24	);
    25	CREATE TABLE IF NOT EXISTS folders (
    26	    id TEXT PRIMARY KEY,
    27	    org_id TEXT NOT NULL REFERENCES orgs(id),
    28	    name TEXT NOT NULL
    29	);
    30	CREATE TABLE IF NOT EXISTS files (
    31	    id TEXT PRIMARY KEY,
    32	    org_id TEXT NOT NULL REFERENCES orgs(id),
    33	    folder_id TEXT NOT NULL REFERENCES folders(id),
    34	    name TEXT NOT NULL,
    35	    mime_type TEXT NOT NULL,
    36	    size INTEGER NOT NULL,
    37	    content BLOB NOT NULL,
    38	    uploaded_by TEXT NOT NULL REFERENCES users(id),
    39	    created_at TEXT NOT NULL
    40	);
    41	CREATE TABLE IF NOT EXISTS shares (
    42	    token TEXT PRIMARY KEY,
    43	    file_id TEXT NOT NULL REFERENCES files(id),
    44	    created_by TEXT NOT NULL REFERENCES users(id),
    45	    created_at TEXT NOT NULL,
    46	    revoked_at TEXT
    47	);
    48	CREATE INDEX IF NOT EXISTS files_org ON files(org_id, name);
    49	CREATE INDEX IF NOT EXISTS files_folder ON files(folder_id, name);
    50	CREATE INDEX IF NOT EXISTS shares_file ON shares(file_id);
    51	"""
    52	
    53	FILE_COLUMNS = "id, org_id, folder_id, name, mime_type, size, uploaded_by, created_at"
    54	
    55	
    56	def connect(path):
    57	    conn = sqlite3.connect(path, timeout=10)
    58	    conn.row_factory = sqlite3.Row
    59	    conn.execute("PRAGMA foreign_keys = ON")
    60	    conn.execute("PRAGMA busy_timeout = 10000")
    61	    return conn
    62	
    63	
    64	def get_db():
    65	    if "db" not in g:
    66	        from flask import current_app
    67	        g.db = connect(current_app.config["DB_PATH"])
    68	    return g.db
    69	
    70	
    71	def close_db(_exc=None):
    72	    conn = g.pop("db", None)
    73	    if conn is not None:
    74	        conn.close()
    75	
    76	
    77	def query_one(sql, params=()):
    78	    return get_db().execute(sql, params).fetchone()
    79	
    80	
    81	def query_all(sql, params=()):
    82	    return get_db().execute(sql, params).fetchall()
    83	
    84	
    85	def execute(sql, params=()):
    86	    conn = get_db()
    87	    cur = conn.execute(sql, params)
    88	    conn.commit()
    89	    return cur.rowcount
    90	
    91	
    92	def file_json(row):
    93	    return {"id": row["id"], "org_id": row["org_id"], "folder_id": row["folder_id"], "name": row["name"],
    94	            "mime_type": row["mime_type"], "size": row["size"], "uploaded_by": row["uploaded_by"],
    95	            "created_at": row["created_at"]}
    96	
    97	
    98	def folder_json(row):
    99	    return {"id": row["id"], "org_id": row["org_id"], "name": row["name"]}
