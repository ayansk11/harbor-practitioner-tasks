[?2004l"""Flask application factory."""
from flask import Flask, g, jsonify
from werkzeug.exceptions import HTTPException

from . import db
from .auth import login_required
from .routes import admin, export, files, folders, share, thumbs


def create_app(db_path):
    app = Flask(__name__)
    app.config["DB_PATH"] = db_path
    app.teardown_appcontext(db.close_db)
    for module in (files, folders, thumbs, export, share, admin):
        app.register_blueprint(module.bp)

    @app.errorhandler(HTTPException)
    def http_error(exc):
        code = exc.description if exc.code == 400 and exc.description and " " not in exc.description else exc.name
        return jsonify(error=code.lower().replace(" ", "_")), exc.code

    @app.get("/api/health")
    def health():
        return jsonify(ok=True)

    @app.get("/api/me")
    @login_required
    def me():
        ident = g.identity
        return jsonify(user={"id": ident.user_id, "email": ident.email, "name": ident.name,
                             "is_support": ident.is_support},
                       active_org_id=ident.org_id, role=ident.role,
                       memberships=[{"org_id": o, "role": r} for o, r in sorted(ident.memberships.items())])

    return app
[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# cat /app/docshare/routes/files.py
[?2004l"""File endpoints: list, metadata, download, rename, delete."""
from flask import Blueprint, Response, abort, g, jsonify, request

from .. import db
from ..auth import login_required, require_active_org

bp = Blueprint("files", __name__)


def get_file_or_404(file_id):
    row = db.query_one(f"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?", (file_id,))
    if row is None:
        abort(404)
    return row


@bp.get("/api/files")
@login_required
def list_files():
    org_id = require_active_org()
    rows = db.query_all(f"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name", (org_id,))
    return jsonify(files=[db.file_json(r) for r in rows])


@bp.get("/api/files/<file_id>")
@login_required
def get_file(file_id):
    return jsonify(db.file_json(get_file_or_404(file_id)))


@bp.get("/api/files/<file_id>/download")
@login_required
def download(file_id):
    row = get_file_or_404(file_id)
    return file_response(row)


def file_response(row):
    resp = Response(bytes(row["content"]), mimetype=row["mime_type"])
    resp.headers["Content-Disposition"] = f'attachment; filename="{row["name"]}"'
    return resp


@bp.patch("/api/files/<file_id>")
@login_required
def rename(file_id):
    if g.identity.role not in ("member", "org_admin"):
        abort(403)
    row = get_file_or_404(file_id)
    body = request.get_json(silent=True) or {}
    name = body.get("name")
    if not isinstance(name, str) or not (1 <= len(name) <= 200) or "/" in name:
        abort(400, description="bad_name")
    db.execute("UPDATE files SET name = ? WHERE id = ?", (name, row["id"]))
    return jsonify(db.file_json(get_file_or_404(row["id"])))


@bp.delete("/api/files/<file_id>")
@login_required
def delete(file_id):
    row = get_file_or_404(file_id)
    conn = db.get_db()
    conn.execute("DELETE FROM shares WHERE file_id = ?", (row["id"],))
    conn.execute("DELETE FROM files WHERE id = ?", (row["id"],))
    conn.commit()
    return "", 204
[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# cat /app/docshare/routes/folders.py
[?2004l"""Folder endpoints: the folders of the active organisation and their files."""
from flask import Blueprint, abort, jsonify

from .. import db
from ..auth import login_required, require_active_org

bp = Blueprint("folders", __name__)


@bp.get("/api/folders")
@login_required
def list_folders():
    org_id = require_active_org()
    rows = db.query_all("SELECT id, org_id, name FROM folders WHERE org_id = ? ORDER BY name", (org_id,))
    return jsonify(folders=[db.folder_json(r) for r in rows])


@bp.get("/api/folders/<folder_id>/files")
@login_required
def folder_files(folder_id):
    org_id = require_active_org()
    folder = db.query_one("SELECT id, org_id, name FROM folders WHERE id = ? AND org_id = ?", (folder_id, org_id))
    if folder is None:
        abort(404)
    rows = db.query_all(f"SELECT {db.FILE_COLUMNS} FROM files WHERE folder_id = ? AND org_id = ? ORDER BY name",
                        (folder_id, org_id))
    return jsonify(folder=db.folder_json(folder), files=[db.file_json(r) for r in rows])
[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# cat /app/docshare/routes/thumbs.py
[?2004l"""SVG previews for the file grid."""
import html

from flask import Blueprint, Response, abort

from .. import db
from ..auth import login_required

bp = Blueprint("thumbs", __name__)

TEXT_TYPES = ("text/", "application/json")


def render_thumb(name, mime_type, content):
    lines = []
    if mime_type.startswith(TEXT_TYPES):
        text = bytes(content).decode("utf-8", "replace")
        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]
    parts = ['<svg xmlns="http://www.w3.org/2000/svg" width="160" height="200" viewBox="0 0 160 200">',
             f"<title>{html.escape(name)}</title>",
             '<rect x="0.5" y="0.5" width="159" height="199" fill="#ffffff" stroke="#c8ccd2"/>',
             f'<text x="8" y="18" font-size="9" font-weight="bold">{html.escape(name[:30])}</text>']
    for i, ln in enumerate(lines):
        parts.append(f'<text x="8" y="{40 + 14 * i}" font-size="8">{html.escape(ln[:34])}</text>')
    parts.append("</svg>")
    return "\n".join(parts)


@bp.get("/api/files/<file_id>/thumb")
@login_required
def thumb(file_id):
    row = db.query_one("SELECT name, mime_type, content FROM files WHERE id = ?", (file_id,))
    if row is None:
        abort(404)
    svg = render_thumb(row["name"], row["mime_type"], row["content"])
    return Response(svg, mimetype="image/svg+xml")
[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# cat /app/docshare/routes/export.py
[?2004l"""Bulk export: several files in one JSON response (used by the "Download selected" button)."""
import base64

from flask import Blueprint, abort, g, jsonify, request

from .. import db
from ..auth import login_required

bp = Blueprint("export", __name__)

MAX_IDS = 50


@bp.post("/api/export")
@login_required
def export():
    body = request.get_json(silent=True) or {}
    ids = body.get("file_ids")
    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):
        abort(400, description="bad_file_ids")
    # A selection always comes from one folder view, so the first file tells us whose files these are.
    first = db.query_one("SELECT org_id FROM files WHERE id = ?", (ids[0],))
    if first is None:
        abort(404)
    if not g.identity.is_support and first["org_id"] != g.identity.org_id:
        abort(404)
    out = []
    for file_id in ids:
        row = db.query_one("SELECT id, name, mime_type, size, content FROM files WHERE id = ?", (file_id,))
        if row is None:
            abort(404)
        out.append({"id": row["id"], "name": row["name"], "mime_type": row["mime_type"], "size": row["size"],
                    "content_b64": base64.b64encode(bytes(row["content"])).decode("ascii")})
    return jsonify(files=out)
[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# cat /app/docshare/routes/share.py
[?2004l"""Share links: create, revoke, and the public download behind /s/<token>."""
import secrets
from datetime import datetime, timezone

from flask import Blueprint, abort, g, jsonify

from .. import db
from ..auth import login_required
from .files import file_response

bp = Blueprint("share", __name__)


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


@bp.post("/api/files/<file_id>/shares")
@login_required
def create_share(file_id):
    if g.identity.role not in ("member", "org_admin"):
        abort(403)
    row = db.query_one("SELECT id FROM files WHERE id = ?", (file_id,))
    if row is None:
        abort(404)
    token = secrets.token_urlsafe(18)
    created = now_iso()
    db.execute("INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)",
               (token, row["id"], g.identity.user_id, created))
    return jsonify(token=token, url=f"/s/{token}", file_id=row["id"], created_at=created), 201


@bp.delete("/api/shares/<token>")
@login_required
def revoke_share(token):
    row = db.query_one("SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?",
                       (token,))
    if row is None or row["org_id"] != g.identity.org_id or g.identity.role not in ("member", "org_admin"):
        abort(404)
    db.execute("UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL", (now_iso(), token))
    return "", 204


@bp.get("/s/<token>")
def public_download(token):
    row = db.query_one("SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id "
                       "WHERE s.token = ? AND s.revoked_at IS NULL", (token,))
    if row is None:
        abort(404)
    return file_response(row)
