[?2004l[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# cat > /app/docshare/routes/thumbs.py << 'PYEOF'
[?2004l[?2004h> """SVG previews for the file grid."""
[?2004l[?2004h> import html
[?2004l[?2004h> 
[?2004l[?2004h> from flask import Blueprint, Response, abort, g
[?2004l[?2004h> 
[?2004l[?2004h> from .. import db
[?2004l[?2004h> from ..auth import login_required
[?2004l[?2004h> from .files import get_file_or_404
[?2004l[?2004h> 
[?2004l[?2004h> bp = Blueprint("thumbs", __name__)
[?2004l[?2004h> 
[?2004l[?2004h> TEXT_TYPES = ("text/", "application/json")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def render_thumb(name, mime_type, content):
[?2004l[?2004h>     lines = []
[?2004l[?2004h>     if mime_type.startswith(TEXT_TYPES):
[?2004l[?2004h>         text = bytes(content).decode("utf-8", "replace")
[?2004l[?2004h>         lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]
[?2004l[?2004h>     parts = ['<svg xmlns="http://www.w3.org/2000/svg" width="160" height="200" viewBox="0 0 160 200">',
[?2004l[?2004h>              f"<title>{html.escape(name)}</title>",
[?2004l[?2004h>              '<rect x="0.5" y="0.5" width="159" height="199" fill="#ffffff" stroke="#c8ccd2"/>',
[?2004l[?2004h>              f'<text x="8" y="18" font-size="9" font-weight="bold">{html.escape(name[:30])}</text>']
[?2004l[?2004h>     for i, ln in enumerate(lines):
[?2004l[?2004h>         parts.append(f'<text x="8" y="{40 + 14 * i}" font-size="8">{html.escape(ln[:34])}</text>')
[?2004l[?2004h>     parts.append("</svg>")
[?2004l[?2004h>     return "\n".join(parts)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.get("/api/files/<file_id>/thumb")
[?2004l[?2004h> @login_required
[?2004l[?2004h> def thumb(file_id):
[?2004l[?2004h>     row = get_file_or_404(file_id, "thumb")
[?2004l[?2004h>     svg = render_thumb(row["name"], row["mime_type"], row["content"])
[?2004l[?2004h>     return Response(svg, mimetype="image/svg+xml")
[?2004l[?2004h> PYEOF
[?2004l[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# cat > /app/docshare/routes/export.py << 'PYEOF'
[?2004l[?2004h> """Bulk export: several files in one JSON response (used by the "Download selected" button)."""
[?2004l[?2004h> import base64
[?2004l[?2004h> 
[?2004l[?2004h> from flask import Blueprint, abort, g, jsonify, request
[?2004l[?2004h> 
[?2004l[?2004h> from .. import db
[?2004l[?2004h> from ..auth import login_required
[?2004l[?2004h> 
[?2004l[?2004h> bp = Blueprint("export", __name__)
[?2004l[?2004h> 
[?2004l[?2004h> MAX_IDS = 50
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.post("/api/export")
[?2004l[?2004h> @login_required
[?2004l[?2004h> def export():
[?2004l[?2004h>     body = request.get_json(silent=True) or {}
[?2004l[?2004h>     ids = body.get("file_ids")
[?2004l[?2004h>     if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):
[?2004l[?2004h>         abort(400, description="bad_file_ids")
[?2004l[?2004h>     ident = g.identity
[?2004l[?2004h>     out = []
[?2004l[?2004h>     for file_id in ids:
[?2004l[?2004h>         row = db.query_one(f"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?", (file_id,))
[?2004l[?2004h>         if row is None:
[?2004l[?2004h>             abort(404)
[?2004l[?2004h>         if not ident.is_support and row["org_id"] != ident.org_id:
[?2004l[?2004h>             abort(404)
[?2004l[?2004h>         out.append({"id": row["id"], "name": row["name"], "mime_type": row["mime_type"],
[?2004l[?2004h>                     "size": row["size"],
[?2004l[?2004h>                     "content_b64": base64.b64encode(bytes(row["content"])).decode("ascii")})
[?2004l[?2004h>     return jsonify(files=out)
[?2004l[?2004h> PYEOF
[?2004l[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# cat > /app/docshare/routes/share.py << 'PYEOF'
[?2004l[?2004h> """Share links: create, revoke, and the public download behind /s/<token>."""
[?2004l[?2004h> import secrets
[?2004l[?2004h> from datetime import datetime, timezone
[?2004l[?2004h> 
[?2004l[?2004h> from flask import Blueprint, abort, g, jsonify
[?2004l[?2004h> 
[?2004l[?2004h> from .. import db
[?2004l[?2004h> from ..auth import login_required
[?2004l[?2004h> from .files import file_response, get_file_or_404
[?2004l[?2004h> 
[?2004l[?2004h> bp = Blueprint("share", __name__)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def now_iso():
[?2004l[?2004h>     return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.post("/api/files/<file_id>/shares")
[?2004l[?2004h> @login_required
[?2004l[?2004h> def create_share(file_id):
[?2004l[?2004h>     row = get_file_or_404(file_id, "share")
[?2004l[?2004h>     token = secrets.token_urlsafe(18)
[?2004l[?2004h>     created = now_iso()
[?2004l[?2004h>     db.execute("INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)",
[?2004l[?2004h>                (token, row["id"], g.identity.user_id, created))
[?2004l[?2004h>     return jsonify(token=token, url=f"/s/{token}", file_id=row["id"], created_at=created), 201
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.delete("/api/shares/<token>")
[?2004l[?2004h> @login_required
[?2004l[?2004h> def revoke_share(token):
[?2004l[?2004h>     ident = g.identity
[?2004l[?2004h>     if ident.is_support:
[?2004l[?2004h>         abort(403)
[?2004l[?2004h>     row = db.query_one("SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?",
[?2004l[?2004h>                        (token,))
[?2004l[?2004h>     if row is None or row["org_id"] != ident.org_id:
[?2004l[?2004h>         abort(404)
[?2004l[?2004h>     db.execute("UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL", (now_iso(), token))
[?2004l[?2004h>     return "", 204
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.get("/s/<token>")
[?2004l[?2004h> def public_download(token):
[?2004l[?2004h>     row = db.query_one("SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id "
[?2004l[?2004h>                        "WHERE s.token = ? AND s.revoked_at IS NULL", (token,))
[?2004l[?2004h>     if row is None:
[?2004l[?2004h>         abort(404)
[?2004l[?2004h>     return file_response(row)
[?2004l[?2004h> PYEOF
