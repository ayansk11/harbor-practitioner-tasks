"""Who is calling: bearer token -> user, plus the active organisation for this request."""
import functools
from dataclasses import dataclass, field

from flask import abort, g, jsonify, request

from . import db


@dataclass
class Identity:
    user_id: str
    email: str
    name: str
    is_support: bool
    org_id: str | None          # the active organisation for this request
    role: str                   # "member", "org_admin" or "support"
    memberships: dict = field(default_factory=dict)   # org_id -> role


def _bearer_token():
    header = request.headers.get("Authorization", "")
    if not header.startswith("Bearer "):
        return None
    return header[len("Bearer "):].strip() or None


def load_identity():
    token = _bearer_token()
    if token is None:
        return None
    user = db.query_one("SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?", (token,))
    if user is None:
        return None
    memberships = {r["org_id"]: r["role"] for r in
                   db.query_all("SELECT org_id, role FROM memberships WHERE user_id = ?", (user["id"],))}
    org_id = request.headers.get("X-Org-Id") or user["home_org_id"]
    if user["is_support"]:
        role = "support"
        # Support may name any existing organisation; a non-existent one is refused.
        if org_id is not None:
            if db.query_one("SELECT id FROM orgs WHERE id = ?", (org_id,)) is None:
                abort(404)
    else:
        # Member / org_admin: the active org must be one they belong to.
        if org_id is not None and org_id in memberships:
            role = memberships[org_id]
        else:
            abort(404)
    return Identity(user_id=user["id"], email=user["email"], name=user["name"],
                    is_support=bool(user["is_support"]), org_id=org_id, role=role,
                    memberships=memberships)


def login_required(view):
    @functools.wraps(view)
    def wrapper(*args, **kwargs):
        ident = load_identity()
        if ident is None:
            return jsonify(error="unauthorized"), 401
        g.identity = ident
        return view(*args, **kwargs)
    return wrapper


def require_active_org():
    """The active organisation id; support must name one with X-Org-Id before listing anything."""
    org_id = g.identity.org_id
    if org_id is None:
        abort(400, description="x_org_id_required")
    return org_id
=== files.py ===
"""File endpoints: list, metadata, download, rename, delete."""
from flask import Blueprint, Response, abort, g, jsonify, request

from .. import db
from ..auth import login_required, require_active_org

bp = Blueprint("files", __name__)


def get_file_or_404(file_id, action="read"):
    """Fetch a file by id and verify the caller may perform *action* on it.

    For member / org_admin the file must belong to the active organisation.
    For support, read / download / thumb / export are allowed on any file;
    every other action is refused.
    Delete additionally requires the org_admin role.
    """
    row = db.query_one(f"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?", (file_id,))
    if row is None:
        abort(404)
    ident = g.identity
    if ident.is_support:
        if action not in ("read", "download", "thumb", "export"):
            abort(403)
    else:
        if row["org_id"] != ident.org_id:
            abort(404)
        if action == "delete" and ident.role != "org_admin":
            abort(403)
    return row


@bp.get("/api/files")
@login_required
def list_files():
    org_id = require_active_org()
    rows = db.query_all(f"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name", (org_id,))
    return jsonify(files=[db.file_json(r) for r in rows])


@bp.get("/api/files/<file_id>")
@login_required
def get_file(file_id):
    return jsonify(db.file_json(get_file_or_404(file_id, "read")))


@bp.get("/api/files/<file_id>/download")
@login_required
def download(file_id):
    row = get_file_or_404(file_id, "download")
    return file_response(row)


def file_response(row):
    resp = Response(bytes(row["content"]), mimetype=row["mime_type"])
    resp.headers["Content-Disposition"] = f'attachment; filename="{row["name"]}"'
    return resp


@bp.patch("/api/files/<file_id>")
@login_required
def rename(file_id):
    row = get_file_or_404(file_id, "rename")
    body = request.get_json(silent=True) or {}
    name = body.get("name")
    if not isinstance(name, str) or not (1 <= len(name) <= 200) or "/" in name:
        abort(400, description="bad_name")
    db.execute("UPDATE files SET name = ? WHERE id = ?", (name, row["id"]))
    return jsonify(db.file_json(get_file_or_404(row["id"], "read")))


@bp.delete("/api/files/<file_id>")
@login_required
def delete(file_id):
    row = get_file_or_404(file_id, "delete")
    conn = db.get_db()
    conn.execute("DELETE FROM shares WHERE file_id = ?", (row["id"],))
    conn.execute("DELETE FROM files WHERE id = ?", (row["id"],))
    conn.commit()
    return "", 204
=== thumbs.py ===
"""SVG previews for the file grid."""
import html

from flask import Blueprint, Response, abort, g

from .. import db
from ..auth import login_required
from .files import get_file_or_404

bp = Blueprint("thumbs", __name__)

TEXT_TYPES = ("text/", "application/json")


def render_thumb(name, mime_type, content):
    lines = []
    if mime_type.startswith(TEXT_TYPES):
        text = bytes(content).decode("utf-8", "replace")
        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]
    parts = ['<svg xmlns="http://www.w3.org/2000/svg" width="160" height="200" viewBox="0 0 160 200">',
             f"<title>{html.escape(name)}</title>",
             '<rect x="0.5" y="0.5" width="159" height="199" fill="#ffffff" stroke="#c8ccd2"/>',
             f'<text x="8" y="18" font-size="9" font-weight="bold">{html.escape(name[:30])}</text>']
    for i, ln in enumerate(lines):
        parts.append(f'<text x="8" y="{40 + 14 * i}" font-size="8">{html.escape(ln[:34])}</text>')
    parts.append("</svg>")
    return "\n".join(parts)


@bp.get("/api/files/<file_id>/thumb")
@login_required
def thumb(file_id):
    row = get_file_or_404(file_id, "thumb")
    svg = render_thumb(row["name"], row["mime_type"], row["content"])
    return Response(svg, mimetype="image/svg+xml")
=== export.py ===
"""Bulk export: several files in one JSON response (used by the "Download selected" button)."""
import base64

from flask import Blueprint, abort, g, jsonify, request

from .. import db
from ..auth import login_required

bp = Blueprint("export", __name__)

MAX_IDS = 50


@bp.post("/api/export")
@login_required
def export():
    body = request.get_json(silent=True) or {}
    ids = body.get("file_ids")
    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):
        abort(400, description="bad_file_ids")
    ident = g.identity
    out = []
    for file_id in ids:
        row = db.query_one(f"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?", (file_id,))
        if row is None:
            abort(404)
        if not ident.is_support and row["org_id"] != ident.org_id:
            abort(404)
        out.append({"id": row["id"], "name": row["name"], "mime_type": row["mime_type"],
                    "size": row["size"],
                    "content_b64": base64.b64encode(bytes(row["content"])).decode("ascii")})
    return jsonify(files=out)
=== share.py ===
"""Share links: create, revoke, and the public download behind /s/<token>."""
import secrets
from datetime import datetime, timezone

from flask import Blueprint, abort, g, jsonify

from .. import db
from ..auth import login_required
from .files import file_response, get_file_or_404

bp = Blueprint("share", __name__)


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


@bp.post("/api/files/<file_id>/shares")
@login_required
def create_share(file_id):
    row = get_file_or_404(file_id, "share")
    token = secrets.token_urlsafe(18)
    created = now_iso()
    db.execute("INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)",
               (token, row["id"], g.identity.user_id, created))
    return jsonify(token=token, url=f"/s/{token}", file_id=row["id"], created_at=created), 201


@bp.delete("/api/shares/<token>")
@login_required
def revoke_share(token):
    ident = g.identity
    if ident.is_support:
        abort(403)
    row = db.query_one("SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?",
                       (token,))
    if row is None or row["org_id"] != ident.org_id:
        abort(404)
    db.execute("UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL", (now_iso(), token))
    return "", 204


@bp.get("/s/<token>")
def public_download(token):
    row = db.query_one("SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id "
                       "WHERE s.token = ? AND s.revoked_at IS NULL", (token,))
    if row is None:
        abort(404)
    return file_response(row)
