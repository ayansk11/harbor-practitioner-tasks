[82.320185, "o", "\"\"\"Feature tests for docshare (run from /app: python -m pytest -q tests).\"\"\"\r\nimport base64\r\n\r\nimport pytest\r\n\r\nfrom docshare import seed\r\nfrom docshare.app import create_app\r\n\r\n\r\n@pytest.fixture()\r\ndef env(tmp_path):\r\n    path = tmp_path / \"test.db\"\r\n    summary = seed.build(str(path), seed.DEV_SPEC)\r\n    app = create_app(str(path))\r\n    app.config[\"TESTING\"] = True\r\n    return app.test_client(), summary\r\n\r\n\r\ndef user(summary, email):\r\n    return next(u for u in summary[\"users\"] if u[\"email\"] == email)\r\n\r\n\r\ndef h(u, org_id=None):\r\n    headers = {\"Authorization\": f\"Bearer {u['token']}\"}\r\n    if org_id:\r\n        headers[\"X-Org-Id\"] = org_id\r\n    return headers\r\n\r\n\r\ndef org_files(summary, org_id):\r\n    return [f for f in summary[\"files\"] if f[\"org_id\"] == org_id]\r\n\r\n\r\ndef test_health(env):\r\n    client, _ = env\r\n    assert client.get(\"/api/health\").get_json() == {\"ok\": True}\r\n\r\n\r\ndef test_login_required(env):\r\n    client, s = env\r\n    assert client.get(\"/api/files\").status_code == 401\r\n    assert client.get(\"/ap"]
[82.320242, "o", "i/files\", headers={\"Authorization\": \"Bearer nope\"}).status_code == 401\r\n\r\n\r\ndef test_member_lists_and_downloads_own_files(env):\r\n    client, s = env\r\n    ben = user(s, \"ben@haldenprice.example\")\r\n    r = client.get(\"/api/files\", headers=h(ben))\r\n    assert r.status_code == 200\r\n    ids = {f[\"id\"] for f in r.get_json()[\"files\"]}\r\n    assert ids == {f[\"id\"] for f in org_files(s, ben[\"home_org_id\"])}\r\n    f = org_files(s, ben[\"home_org_id\"])[0]\r\n    r = client.get(f\"/api/files/{f['id']}/download\", headers=h(ben))\r\n    assert r.status_code == 200 and len(r.data) == f[\"size\"]\r\n\r\n\r\ndef test_folders(env):\r\n    client, s = env\r\n    ben = user(s, \"ben@haldenprice.example\")\r\n    folders = client.get(\"/api/folders\", headers=h(ben)).get_json()[\"folders\"]\r\n    assert folders and all(fo[\"org_id\"] == ben[\"home_org_id\"] for fo in folders)\r\n    r = client.get(f\"/api/folders/{folders[0]['id']}/files\", headers=h(ben))\r\n    assert r.status_code == 200\r\n    assert all(f[\"folder_id\"] == folders[0][\"id\"] for f in r.get_json()[\"file"]
[82.320291, "o", "s\"])\r\n\r\n\r\ndef test_share_link_round_trip(env):\r\n    client, s = env\r\n    dev = user(s, \"dev@marlowclinic.example\")\r\n    f = org_files(s, dev[\"home_org_id\"])[0]\r\n    r = client.post(f\"/api/files/{f['id']}/shares\", headers=h(dev))\r\n    assert r.status_code == 201\r\n    token = r.get_json()[\"token\"]\r\n    assert client.get(f\"/s/{token}\").status_code == 200\r\n    assert client.delete(f\"/api/shares/{token}\", headers=h(dev)).status_code == 204\r\n    assert client.get(f\"/s/{token}\").status_code == 404\r\n\r\n\r\ndef test_org_switching(env):\r\n    client, s = env\r\n    grace = user(s, \"grace@okafor-consulting.example\")\r\n    second = next(o for o in grace[\"orgs\"] if o != grace[\"home_org_id\"])\r\n    me = client.get(\"/api/me\", headers=h(grace, second)).get_json()\r\n    assert me[\"active_org_id\"] == second and me[\"role\"] == \"org_admin\"\r\n    ids = {f[\"id\"] for f in client.get(\"/api/files\", headers=h(grace, second)).get_json()[\"files\"]}\r\n    assert ids == {f[\"id\"] for f in org_files(s, second)}\r\n\r\n\r\ndef test_support_reads_any_org_but_ca"]
[82.320328, "o", "nnot_rename(env):\r\n    client, s = env\r\n    riley = user(s, \"riley@support.docshare.example\")\r\n    for org in s[\"orgs\"]:\r\n        f = org_files(s, org[\"id\"])[0]\r\n        assert client.get(f\"/api/files/{f['id']}\", headers=h(riley)).status_code == 200\r\n    f = s[\"files\"][0]\r\n    assert client.patch(f\"/api/files/{f['id']}\", json={\"name\": \"x.md\"}, headers=h(riley)).status_code in (403, 404)\r\n    assert client.get(\"/api/files\", headers=h(riley)).status_code == 400\r\n    assert client.get(\"/api/admin/orgs\", headers=h(riley)).status_code == 200\r\n\r\n\r\ndef test_admin_rename_and_delete(env):\r\n    client, s = env\r\n    anna = user(s, \"anna@haldenprice.example\")\r\n    f1, f2 = org_files(s, anna[\"home_org_id\"])[:2]\r\n    r = client.patch(f\"/api/files/{f1['id']}\", json={\"name\": \"renamed.md\"}, headers=h(anna))\r\n    assert r.status_code == 200 and r.get_json()[\"name\"] == \"renamed.md\"\r\n    assert client.delete(f\"/api/files/{f2['id']}\", headers=h(anna)).status_code == 204\r\n    assert client.get(f\"/api/files/{f2['id']}\", headers=h(a"]
[82.32036, "o", "nna)).status_code in (403, 404)\r\n\r\n\r\ndef test_export(env):\r\n    client, s = env\r\n    ben = user(s, \"ben@haldenprice.example\")\r\n    fs = org_files(s, ben[\"home_org_id\"])[:3]\r\n    r = client.post(\"/api/export\", json={\"file_ids\": [f[\"id\"] for f in fs]}, headers=h(ben))\r\n    assert r.status_code == 200\r\n    out = r.get_json()[\"files\"]\r\n    assert [x[\"id\"] for x in out] == [f[\"id\"] for f in fs]\r\n    assert all(len(base64.b64decode(x[\"content_b64\"])) == x[\"size\"] for x in out)\r\n"]
[82.32047, "o", "\u001b[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# "]
[83.321035, "i", "cat /app/docs/PERMISSIONS.md | tail -40\n"]
[83.321352, "o", "cat /app/docs/PERMISSIONS.md | tail -40\r\n\u001b[?2004l\r"]
[83.323346, "o", "  organisation's id in `X-Org-Id`.\r\n- Support may name any existing organisation in `X-Org-Id`; no membership is needed. For support this only chooses\r\n  what the list endpoints show. If support names an organisation that does not exist, the whole request is refused.\r\n  Without `X-Org-Id`, support's list endpoints answer `400`.\r\n\r\n## 3. What each role may do\r\n| Action | Endpoints | member | org_admin | support |\r\n|---|---|---|---|---|\r\n| read | `GET /api/files/<id>` | yes | yes | yes, any organisation |\r\n| download | `GET /api/files/<id>/download` | yes | yes | yes, any organisation |\r\n| thumb | `GET /api/files/<id>/thumb` | yes | yes | yes, any organisation |\r\n| list | `GET /api/files`, `GET /api/folders`, `GET /api/folders/<id>/files` | yes | yes | yes, the organisation it names |\r\n| export | `POST /api/export` | yes | yes | yes, any organisation |\r\n| rename | `PATCH /api/files/<id>` | yes | yes | no |\r\n| share | `POST /api/files/<id>/shares`, `DELETE /api/shares/<token>` | yes | yes | no |\r\n| delete | `DEL"]
[83.323414, "o", "ETE /api/files/<id>` | no | yes | no |\r\n| support console | `GET /api/admin/orgs` | no | no | yes |\r\n| who am I | `GET /api/me` | yes | yes | yes |\r\n\r\n- For member and org_admin, \"yes\" means: on files and folders of the active organisation only (section 2).\r\n- For support, \"any organisation\" means: any file of any organisation, whatever the active organisation is.\r\n- A list shows exactly the folders or files of the active organisation, and nothing of any other organisation.\r\n\r\n## 4. Export\r\n`POST /api/export` returns several files in one response. It is allowed only if the caller may `read` every requested\r\nid under the rules above. If even one id is not readable (a file of another organisation, a deleted file, an unknown\r\nid), the whole request is refused and the response holds no file at all.\r\n\r\n## 5. Share links\r\n- Creating a link (`POST /api/files/<id>/shares`) and revoking it (`DELETE /api/shares/<token>`) are the `share`\r\n  action on the link's file.\r\n- Anyone who has the link can download the file with"]
[83.323488, "o", " `GET /s/<token>`, without logging in, until the link is revoked\r\n  or the file is deleted. After that, or for an unknown token, the link answers `404`.\r\n\r\n## 6. Refusals\r\n- A refused request gets `403` or `404`; either is fine (404 avoids confirming that an id exists). The only other\r\n  refusal codes are `401` (section 1) and `400` (support listing without `X-Org-Id`, section 2).\r\n- A refusal holds no file data: no file contents and no name of a file the caller may not read. An error message may\r\n  repeat the id it was sent.\r\n- A refused request changes nothing: no file is renamed or deleted, no link is created or revoked.\r\n"]
[83.323708, "o", "\u001b[?2004h"]
[83.323757, "o", "root@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# "]
[172.91711, "i", "cat > /app/docshare/auth.py << 'PYEOF'\n\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\nimport functools\nfrom dataclasses import dataclass, field\n\nfrom flask import abort, g, jsonify, request\n\nfrom . import db\n\n\n@dataclass\nclass Identity:\n    user_id: str\n    email: str\n    name: str\n    is_support: bool\n    org_id: str | None          # the active organisation for this request\n    role: str                   # \"member\", \"org_admin\" or \"support\"\n    memberships: dict = field(default_factory=dict)   # org_id -> role\n\n\ndef _bearer_token():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    return header[len(\"Bearer \"):].strip() or None\n\n\ndef load_identity():\n    token = _bearer_token()\n    if token is None:\n        return None\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\n    if user is None:\n        return None\n    memberships = {r[\"org_"]
[172.917257, "i", "id\"]: r[\"role\"] for r in\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\n    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\n    if user[\"is_support\"]:\n        role = \"support\"\n        # Support may name any existing organisation; a non-existent one is refused.\n        if org_id is not None:\n            if db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,)) is None:\n                abort(404)\n    else:\n        # Member / org_admin: the active org must be one they belong to.\n        if org_id is not None and org_id in memberships:\n            role = memberships[org_id]\n        else:\n            abort(404)\n    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"],\n                    is_support=bool(user[\"is_support\"]), org_id=org_id, role=role,\n                    memberships=memberships)\n\n\ndef login_required(view):\n    @functools.wraps(view)\n    def wrapper(*args, **kwargs):\n        ident = load_identity()\n "]
[172.917345, "i", "       if ident is None:\n            return jsonify(error=\"unauthorized\"), 401\n        g.identity = ident\n        return view(*args, **kwargs)\n    return wrapper\n\n\ndef require_active_org():\n    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\n    org_id = g.identity.org_id\n    if org_id is None:\n        abort(400, description=\"x_org_id_required\")\n    return org_id\nPYEOF\n"]
[172.917673, "o", "cat > /app/docshare/auth.py << 'PYEOF'\r\n"]
