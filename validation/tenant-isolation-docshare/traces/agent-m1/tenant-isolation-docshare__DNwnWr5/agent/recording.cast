[173.305705, "i", "cat > /app/docshare/routes/files.py << 'PYEOF'\n\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\nfrom flask import Blueprint, Response, abort, g, jsonify, request\n\nfrom .. import db\nfrom ..auth import login_required, require_active_org\n\nbp = Blueprint(\"files\", __name__)\n\n\ndef get_file_or_404(file_id, action=\"read\"):\n    \"\"\"Fetch a file by id and verify the caller may perform *action* on it.\n\n    For member / org_admin the file must belong to the active organisation.\n    For support, read / download / thumb / export are allowed on any file;\n    every other action is refused.\n    Delete additionally requires the org_admin role.\n    \"\"\"\n    row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\n    if row is None:\n        abort(404)\n    ident = g.identity\n    if ident.is_support:\n        if action not in (\"read\", \"download\", \"thumb\", \"export\"):\n            abort(403)\n    else:\n        if row[\"org_id\"] != ident.org_id:\n            abort(404)\n        if action =="]
[173.305809, "i", " \"delete\" and ident.role != \"org_admin\":\n            abort(403)\n    return row\n\n\n@bp.get(\"/api/files\")\n@login_required\ndef list_files():\n    org_id = require_active_org()\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\n    return jsonify(files=[db.file_json(r) for r in rows])\n\n\n@bp.get(\"/api/files/<file_id>\")\n@login_required\ndef get_file(file_id):\n    return jsonify(db.file_json(get_file_or_404(file_id, \"read\")))\n\n\n@bp.get(\"/api/files/<file_id>/download\")\n@login_required\ndef download(file_id):\n    row = get_file_or_404(file_id, \"download\")\n    return file_response(row)\n\n\ndef file_response(row):\n    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\n    return resp\n\n\n@bp.patch(\"/api/files/<file_id>\")\n@login_required\ndef rename(file_id):\n    row = get_file_or_404(file_id, \"rename\")\n    body = request.get_json(silent=True) or {}\n    name = body.get(\"name\")\n   "]
[173.305837, "i", " if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\n        abort(400, description=\"bad_name\")\n    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\n    return jsonify(db.file_json(get_file_or_404(row[\"id\"], \"read\")))\n\n\n@bp.delete(\"/api/files/<file_id>\")\n@login_required\ndef delete(file_id):\n    row = get_file_or_404(file_id, \"delete\")\n    conn = db.get_db()\n    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\n    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\n    conn.commit()\n    return \"\", 204\nPYEOF\n"]
