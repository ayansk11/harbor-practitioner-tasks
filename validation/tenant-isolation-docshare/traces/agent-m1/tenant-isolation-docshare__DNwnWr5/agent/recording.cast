[337.383753, "o", "echo '=== auth.py ===' && cat /app/docshare/auth.py && echo '=== files.py ===' && cat /app/docshare/routes/files.py && echo '=== thumbs.py ===' && cat /app/docshare/routes/thumbs.py && echo '=== export.py ===' && cat /app/docshare/routes/export.py && echo '=== share.py ===' && cat /app/docshare/routes/share.py\r\n\u001b[?2004l\r"]
[337.383816, "o", "=== auth.py ===\r\n"]
[337.385038, "o", "\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\r\nimport functools\r\nfrom dataclasses import dataclass, field\r\n\r\nfrom flask import abort, g, jsonify, request\r\n\r\nfrom . import db\r\n\r\n\r\n@dataclass\r\nclass Identity:\r\n    user_id: str\r\n    email: str\r\n    name: str\r\n    is_support: bool\r\n    org_id: str | None          # the active organisation for this request\r\n    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n\r\n\r\ndef _bearer_token():\r\n    header = request.headers.get(\"Authorization\", \"\")\r\n    if not header.startswith(\"Bearer \"):\r\n        return None\r\n    return header[len(\"Bearer \"):].strip() or None\r\n\r\n\r\ndef load_identity():\r\n    token = _bearer_token()\r\n    if token is None:\r\n        return None\r\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n    if user is None:\r\n        return None\r\n    memberships = {r[\"org_id\"]:"]
[337.385065, "o", " r[\"role\"] for r in\r\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\r\n    if user[\"is_support\"]:\r\n        role = \"support\"\r\n        # Support may name any existing organisation; a non-existent one is refused.\r\n        if org_id is not None:\r\n            if db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,)) is None:\r\n                abort(404)\r\n    else:\r\n        # Member / org_admin: the active org must be one they belong to.\r\n        if org_id is not None and org_id in memberships:\r\n            role = memberships[org_id]\r\n        else:\r\n            abort(404)\r\n    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"],\r\n                    is_support=bool(user[\"is_support\"]), org_id=org_id, role=role,\r\n                    memberships=memberships)\r\n\r\n\r\ndef login_required(view):\r\n    @functools.wraps(view)\r\n    def wrapper(*args, **kwargs):\r\n        ident ="]
[337.385085, "o", " load_identity()\r\n        if ident is None:\r\n            return jsonify(error=\"unauthorized\"), 401\r\n        g.identity = ident\r\n        return view(*args, **kwargs)\r\n    return wrapper\r\n\r\n\r\ndef require_active_org():\r\n    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\r\n    org_id = g.identity.org_id\r\n    if org_id is None:\r\n        abort(400, description=\"x_org_id_required\")\r\n    return org_id\r\n"]
[337.385229, "o", "=== files.py ===\r\n"]
[337.386294, "o", "\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\r\nfrom flask import Blueprint, Response, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_active_org\r\n\r\nbp = Blueprint(\"files\", __name__)\r\n\r\n\r\ndef get_file_or_404(file_id, action=\"read\"):\r\n    \"\"\"Fetch a file by id and verify the caller may perform *action* on it.\r\n\r\n    For member / org_admin the file must belong to the active organisation.\r\n    For support, read / download / thumb / export are allowed on any file;\r\n    every other action is refused.\r\n    Delete additionally requires the org_admin role.\r\n    \"\"\"\r\n    row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404)\r\n    ident = g.identity\r\n    if ident.is_support:\r\n        if action not in (\"read\", \"download\", \"thumb\", \"export\"):\r\n            abort(403)\r\n    else:\r\n        if row[\"org_id\"] != ident.org_id:\r\n            abort(404)\r\n        if action == \"delete\" and ident."]
[337.386335, "o", "role != \"org_admin\":\r\n            abort(403)\r\n    return row\r\n\r\n\r\n@bp.get(\"/api/files\")\r\n@login_required\r\ndef list_files():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(files=[db.file_json(r) for r in rows])\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>\")\r\n@login_required\r\ndef get_file(file_id):\r\n    return jsonify(db.file_json(get_file_or_404(file_id, \"read\")))\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/download\")\r\n@login_required\r\ndef download(file_id):\r\n    row = get_file_or_404(file_id, \"download\")\r\n    return file_response(row)\r\n\r\n\r\ndef file_response(row):\r\n    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\r\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\r\n    return resp\r\n\r\n\r\n@bp.patch(\"/api/files/<file_id>\")\r\n@login_required\r\n"]
[337.386365, "o", "def rename(file_id):\r\n    row = get_file_or_404(file_id, \"rename\")\r\n    body = request.get_json(silent=True) or {}\r\n    name = body.get(\"name\")\r\n    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\r\n        abort(400, description=\"bad_name\")\r\n    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n    return jsonify(db.file_json(get_file_or_404(row[\"id\"], \"read\")))\r\n\r\n\r\n@bp.delete(\"/api/files/<file_id>\")\r\n@login_required\r\ndef delete(file_id):\r\n    row = get_file_or_404(file_id, \"delete\")\r\n    conn = db.get_db()\r\n    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\r\n    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\r\n    conn.commit()\r\n    return \"\", 204\r\n"]
[337.386525, "o", "=== thumbs.py ===\r\n"]
[337.387521, "o", "\"\"\"SVG previews for the file grid.\"\"\"\r\nimport html\r\n\r\nfrom flask import Blueprint, Response, abort, g\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\nfrom .files import get_file_or_404\r\n\r\nbp = Blueprint(\"thumbs\", __name__)\r\n\r\nTEXT_TYPES = (\"text/\", \"application/json\")\r\n\r\n\r\ndef render_thumb(name, mime_type, content):\r\n    lines = []\r\n    if mime_type.startswith(TEXT_TYPES):\r\n        text = bytes(content).decode(\"utf-8\", \"replace\")\r\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\r\n    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\r\n             f\"<title>{html.escape(name)}</title>\",\r\n             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n    for i, ln in enumerate(lines):\r\n        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\r\n"]
[337.387569, "o", "    parts.append(\"</svg>\")\r\n    return \"\\n\".join(parts)\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/thumb\")\r\n@login_required\r\ndef thumb(file_id):\r\n    row = get_file_or_404(file_id, \"thumb\")\r\n    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n    return Response(svg, mimetype=\"image/svg+xml\")\r\n"]
[337.387717, "o", "=== export.py ===\r\n"]
[337.388757, "o", "\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\nimport base64\r\n\r\nfrom flask import Blueprint, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"export\", __name__)\r\n\r\nMAX_IDS = 50\r\n\r\n\r\n@bp.post(\"/api/export\")\r\n@login_required\r\ndef export():\r\n    body = request.get_json(silent=True) or {}\r\n    ids = body.get(\"file_ids\")\r\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n        abort(400, description=\"bad_file_ids\")\r\n    ident = g.identity\r\n    out = []\r\n    for file_id in ids:\r\n        row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\r\n        if row is None:\r\n            abort(404)\r\n        if not ident.is_support and row[\"org_id\"] != ident.org_id:\r\n            abort(404)\r\n        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"],\r\n                    \"size\": row[\"size\"],\r\n   "]
[337.388779, "o", "                 \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n    return jsonify(files=out)\r\n"]
[337.388911, "o", "=== share.py ===\r\n"]
[337.389902, "o", "\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\r\nimport secrets\r\nfrom datetime import datetime, timezone\r\n\r\nfrom flask import Blueprint, abort, g, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\nfrom .files import file_response, get_file_or_404\r\n\r\nbp = Blueprint(\"share\", __name__)\r\n\r\n\r\ndef now_iso():\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\n@bp.post(\"/api/files/<file_id>/shares\")\r\n@login_required\r\ndef create_share(file_id):\r\n    row = get_file_or_404(file_id, \"share\")\r\n"]
[337.389937, "o", "    token = secrets.token_urlsafe(18)\r\n    created = now_iso()\r\n    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\r\n               (token, row[\"id\"], g.identity.user_id, created))\r\n    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\r\n\r\n\r\n@bp.delete(\"/api/shares/<token>\")\r\n@login_required\r\ndef revoke_share(token):\r\n    ident = g.identity\r\n    if ident.is_support:\r\n        abort(403)\r\n"]
[337.38998, "o", "    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\r\n                       (token,))\r\n    if row is None or row[\"org_id\"] != ident.org_id:\r\n        abort(404)\r\n    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n    return \"\", 204\r\n\r\n\r\n@bp.get(\"/s/<token>\")\r\ndef public_download(token):\r\n    row = db.query_one(\"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\r\n                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (token,))\r\n    if row is None:\r\n        abort(404)\r\n    return file_response(row)\r\n"]
[337.390173, "o", "\u001b[?2004h"]
