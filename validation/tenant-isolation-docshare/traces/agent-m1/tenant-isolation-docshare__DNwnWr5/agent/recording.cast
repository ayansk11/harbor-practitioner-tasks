[13.212852, "o", "cat /app/docshare/serve.py\r\n\u001b[?2004l\r"]
[13.214055, "o", "\"\"\"Run the API: python -m docshare.serve --db <path> --port <port>.\"\"\"\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nfrom waitress import serve\r\n\r\nfrom . import db\r\nfrom .app import create_app\r\n\r\n\r\ndef main(argv=None):\r\n    p = argparse.ArgumentParser(description=\"docshare API server\")\r\n    p.add_argument(\"--db\", required=True, help=\"path to an existing docshare SQLite database\")\r\n    p.add_argument(\"--port\", type=int, default=8080)\r\n    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    p.add_argument(\"--threads\", type=int, default=4)\r\n    args = p.parse_args(argv)\r\n    if not os.path.isfile(args.db):\r\n        sys.exit(f\"database not found: {args.db}\")\r\n    conn = db.connect(args.db)\r\n    conn.execute(\"PRAGMA journal_mode = WAL\")\r\n    conn.close()\r\n    serve(create_app(os.path.abspath(args.db)), host=args.host, port=args.port, threads=args.threads,\r\n          ident=\"docshare\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[13.214277, "o", "\u001b[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# "]
