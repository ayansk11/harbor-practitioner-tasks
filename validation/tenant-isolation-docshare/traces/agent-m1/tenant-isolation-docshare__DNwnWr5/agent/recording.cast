[301.809086, "i", "cat > /tmp/sectest.py << 'PYEOF'\nimport urllib.request, urllib.error, json, sys\n\nBASE = \"http://127.0.0.1:8099\"\n\ndef req(method, path, token=None, org_id=None, body=None):\n    url = BASE + path\n    headers = {\"Content-Type\": \"application/json\"}\n    if token: headers[\"Authorization\"] = \"Bearer \" + token\n    if org_id: headers[\"X-Org-Id\"] = org_id\n    data = json.dumps(body).encode() if body else None\n    r = urllib.request.Request(url, data=data, headers=headers, method=method)\n    try:\n        resp = urllib.request.urlopen(r)\n        return resp.status, resp.read(), dict(resp.headers)\n    except urllib.error.HTTPError as e:\n        return e.code, e.read(), dict(e.headers)\n\nBEN = \"dsk_2e09e4b8245edebc817af708207473b7\"\nANNA = \"dsk_c35d7d3b92e4016e27e47ffc284a2d4f\"\nCHLOE = \"dsk_91d5d9efb044d527dd1775a93cdba284\"\nDEV = \"dsk_46371f37e9a462ce0fa030a07210d3db\"\nGRACE = \"dsk_1428dfad70ce79934498d7d67c213c12\"\nRILEY = \"dsk_f9c215672ac38adf41b079157a6d7ff3\"\n\nHALDEN = \"21bade02-6a6a-4768-b2ed-66ffdcc99396\"\nMARLOW = \"6102dd"]
[301.809187, "i", "70-63e8-440e-9dd8-904f07489671\"\nTESS = \"83faac57-2f56-4652-866d-e486522c4f8d\"\n\npassed = failed = 0\ndef check(name, cond, detail=\"\"):\n    global passed, failed\n    if cond:\n        passed += 1\n        print(\"  PASS: \" + name)\n    else:\n        failed += 1\n        print(\"  FAIL: \" + name + \" \" + str(detail))\n\ns, b, _ = req(\"GET\", \"/api/health\")\ncheck(\"health\", s == 200 and json.loads(b) == {\"ok\": True})\n\ns, b, _ = req(\"GET\", \"/api/files\")\ncheck(\"no token 401\", s == 401, s)\n\ns, b, _ = req(\"GET\", \"/api/files\", token=\"dsk_bad\")\ncheck(\"bad token 401\", s == 401, s)\n\ns, b, _ = req(\"GET\", \"/api/files\", token=BEN)\nd = json.loads(b)\ncheck(\"ben lists halden\", s == 200 and len(d[\"files\"]) > 0)\nhalden_files = d[\"files\"]\n\ns, b, _ = req(\"GET\", \"/api/files\", token=CHLOE)\nd = json.loads(b)\nmarlow_files = d[\"files\"]\ncheck(\"chloe lists marlow\", s == 200 and len(marlow_files) > 0)\n\nmf = marlow_files[0][\"id\"]\ns, b, _ = req(\"GET\", \"/api/files/\" + mf + \"/download\", token=BEN)\ncheck(\"ben download marlow REFUSED\", s in (403, 404), s)\n"]
[301.809216, "i", "\ns, b, _ = req(\"GET\", \"/api/files/\" + mf, token=BEN)\ncheck(\"ben read marlow REFUSED\", s in (403, 404), s)\n\ns, b, _ = req(\"GET\", \"/api/files/\" + mf + \"/thumb\", token=BEN)\ncheck(\"ben thumb marlow REFUSED\", s in (403, 404), s)\n\ns, b, _ = req(\"GET\", \"/api/files\", token=BEN, org_id=MARLOW)\ncheck(\"ben switch to marlow REFUSED\", s in (403, 404), s)\n\ns, b, _ = req(\"GET\", \"/api/files\", token=GRACE, org_id=TESS)\ncheck(\"grace switch to tessaract OK\", s == 200, s)\n\nd = json.loads(b)\ntess_files = d[\"files\"]\ncheck(\"grace lists tessaract\", len(tess_files) > 0)\n\ns, b, _ = req(\"GET\", \"/api/files/\" + mf + \"/download\", token=GRACE, org_id=TESS)\ncheck(\"grace(tess) dl marlow REFUSED\", s in (403, 404), s)\n\ns, b, _ = req(\"GET\", \"/api/files/\" + mf + \"/download\", token=GRACE, org_id=MARLOW)\ncheck(\"grace(marlow) dl marlow OK\", s == 200, s)\n\ns, b, _ = req(\"GET\", \"/api/files\", token=RILEY)\ncheck(\"support list no org 400\", s == 400, s)\ns, b, _ = req(\"GET\", \"/api/folders\", token=RILEY)\ncheck(\"support folders no org 400\", s == 400, s)\n\ns, "]
[301.809242, "i", "b, _ = req(\"GET\", \"/api/files\", token=RILEY, org_id=HALDEN)\ncheck(\"support list halden OK\", s == 200, s)\n\ns, b, _ = req(\"GET\", \"/api/files\", token=RILEY, org_id=\"nonexistent\")\ncheck(\"support nonexistent org 404\", s == 404, s)\n\ns, b, _ = req(\"GET\", \"/api/files/\" + halden_files[0][\"id\"], token=RILEY)\ncheck(\"support read halden OK\", s == 200, s)\n\ns, b, _ = req(\"GET\", \"/api/files/\" + mf, token=RILEY)\ncheck(\"support read marlow OK\", s == 200, s)\n\ns, b, _ = req(\"PATCH\", \"/api/files/\" + halden_files[0][\"id\"], token=RILEY, body={\"name\": \"x\"})\ncheck(\"support rename REFUSED\", s in (403, 404), s)\n\ns, b, _ = req(\"DELETE\", \"/api/files/\" + halden_files[0][\"id\"], token=RILEY)\ncheck(\"support delete REFUSED\", s in (403, 404), s)\n\ns, b, _ = req(\"POST\", \"/api/files/\" + halden_files[0][\"id\"] + \"/shares\", token=RILEY)\ncheck(\"support share REFUSED\", s in (403, 404), s)\n\nhf = halden_files[0][\"id\"]\ns, b, _ = req(\"DELETE\", \"/api/files/\" + hf, token=BEN)\ncheck(\"member delete REFUSED\", s in (403, 404), s)\n\ns, b, _ = req(\"DELETE\", \"/api"]
[301.809265, "i", "/files/\" + hf, token=ANNA)\ncheck(\"admin delete OK\", s == 204, s)\n\ns, b, _ = req(\"GET\", \"/api/files/\" + hf, token=BEN)\ncheck(\"deleted file gone\", s == 404, s)\n\ns, b, _ = req(\"POST\", \"/api/export\", token=BEN, body={\"file_ids\": [mf]})\ncheck(\"cross-org export REFUSED\", s in (403, 404), s)\n\nexport_id = halden_files[1][\"id\"] if len(halden_files) > 1 else halden_files[0][\"id\"]\ns, b, _ = req(\"POST\", \"/api/export\", token=BEN, body={\"file_ids\": [export_id]})\ncheck(\"same-org export OK\", s == 200, s)\n\ns, b, _ = req(\"POST\", \"/api/export\", token=RILEY, body={\"file_ids\": [marlow_files[0][\"id\"]]})\ncheck(\"support export any org OK\", s == 200, s)\n\ns, b, _ = req(\"POST\", \"/api/files/\" + marlow_files[0][\"id\"] + \"/shares\", token=CHLOE)\ncheck(\"create share OK\", s == 201, s)\ntoken_val = json.loads(b)[\"token\"]\n\ns, b, _ = req(\"GET\", \"/s/\" + token_val)\ncheck(\"public share download OK\", s == 200, s)\n\ns, b, _ = req(\"POST\", \"/api/files/\" + marlow_files[0][\"id\"] + \"/shares\", token=BEN)\ncheck(\"ben share marlow REFUSED\", s in (403, 404), s)\n"]
[301.809289, "i", "\ns, b, _ = req(\"DELETE\", \"/api/shares/\" + token_val, token=CHLOE)\ncheck(\"revoke share OK\", s == 204, s)\n\ns, b, _ = req(\"GET\", \"/s/\" + token_val)\ncheck(\"revoked share 404\", s == 404, s)\n\ns, b, _ = req(\"GET\", \"/api/me\", token=BEN)\nd = json.loads(b)\ncheck(\"me works\", s == 200 and d[\"user\"][\"name\"] == \"Ben Carver\", s)\n\ns, b, _ = req(\"GET\", \"/api/me\", token=RILEY)\nd = json.loads(b)\ncheck(\"support me no org\", s == 200 and d[\"active_org_id\"] is None and d[\"role\"] == \"support\", s)\n\ns, b, _ = req(\"GET\", \"/api/admin/orgs\", token=RILEY)\ncheck(\"support admin orgs OK\", s == 200, s)\ns, b, _ = req(\"GET\", \"/api/admin/orgs\", token=BEN)\ncheck(\"member admin orgs REFUSED\", s in (403, 404), s)\n\nsep = \"=\" * 40\nprint(\"\\n\" + sep)\nprint(str(passed) + \" passed, \" + str(failed) + \" failed\")\nsys.exit(1 if failed else 0)\nPYEOF\n"]
