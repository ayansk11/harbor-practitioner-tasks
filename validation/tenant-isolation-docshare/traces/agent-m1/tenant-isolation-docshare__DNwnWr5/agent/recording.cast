[233.174529, "i", "echo '--- Cross-org export (Ben exporting Marlow file) ---'\nMARLOW_FILE=$(curl -s -H \"Authorization: Bearer dsk_91d5d9efb044d527dd1775a93cdba284\" http://127.0.0.1:8099/api/files | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d['files'][0]['id'])\")\ncurl -s -w \"\\nHTTP %{http_code}\" -X POST -H \"Authorization: Bearer dsk_2e09e4b8245edebc817af708207473b7\" -H \"Content-Type: application/json\" -d \"{\\\"file_ids\\\":[\\\"$MARLOW_FILE\\\"]}\" http://127.0.0.1:8099/api/export\necho ''\necho '--- Share link still works ---'\nFILE_ID=$(curl -s -H \"Authorization: Bearer dsk_91d5d9efb044d527dd1775a93cdba284\" http://127.0.0.1:8099/api/files | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d['files'][0]['id'])\")\nSHARE_TOKEN=$(curl -s -X POST -H \"Authorization: Bearer dsk_91d5d9efb044d527dd1775a93cdba284\" http://127.0.0.1:8099/api/files/$FILE_ID/shares | python3 -c \"import sys,json; print(json.load(sys.stdin)['token'])\")\necho \"Share token: $SHARE_TOKEN\"\ncurl -s -w \"\\nHTTP %{http_code}\" http://127.0.0.1:8099/s/$SH"]
[233.174626, "i", "ARE_TOKEN | head -c 100\necho ''\n"]
