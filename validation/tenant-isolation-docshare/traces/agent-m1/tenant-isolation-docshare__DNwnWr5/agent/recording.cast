[18.167207, "o", "cat /app/docshare/app.py\r\n\u001b[?2004l\r"]
[18.168424, "o", "\"\"\"Flask application factory.\"\"\"\r\nfrom flask import Flask, g, jsonify\r\nfrom werkzeug.exceptions import HTTPException\r\n\r\nfrom . import db\r\nfrom .auth import login_required\r\nfrom .routes import admin, export, files, folders, share, thumbs\r\n\r\n\r\ndef create_app(db_path):\r\n    app = Flask(__name__)\r\n    app.config[\"DB_PATH\"] = db_path\r\n    app.teardown_appcontext(db.close_db)\r\n    for module in (files, folders, thumbs, export, share, admin):\r\n        app.register_blueprint(module.bp)\r\n\r\n    @app.errorhandler(HTTPException)\r\n    def http_error(exc):\r\n        code = exc.description if exc.code == 400 and exc.description and \" \" not in exc.description else exc.name\r\n        return jsonify(error=code.lower().replace(\" \", \"_\")), exc.code\r\n\r\n    @app.get(\"/api/health\")\r\n    def health():\r\n        return jsonify(ok=True)\r\n\r\n    @app.get(\"/api/me\")\r\n    @login_required\r\n    def me():\r\n        ident = g.identity\r\n        return jsonify(user={\"id\": ident.user_id, \"email\": ident.email, \"name\": ident.name,\r\n                   "]
[18.168483, "o", "          \"is_support\": ident.is_support},\r\n                       active_org_id=ident.org_id, role=ident.role,\r\n                       memberships=[{\"org_id\": o, \"role\": r} for o, r in sorted(ident.memberships.items())])\r\n\r\n    return app\r\n"]
[18.168628, "o", "\u001b[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# "]
[18.672096, "i", "cat /app/docshare/routes/files.py\n"]
[18.672297, "o", "cat /app/docshare/routes/files.py\r\n\u001b[?2004l\r"]
[18.67394, "o", "\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\r\nfrom flask import Blueprint, Response, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_active_org\r\n\r\nbp = Blueprint(\"files\", __name__)\r\n\r\n\r\ndef get_file_or_404(file_id):\r\n    row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404)\r\n    return row\r\n\r\n\r\n@bp.get(\"/api/files\")\r\n@login_required\r\ndef list_files():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(files=[db.file_json(r) for r in rows])\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>\")\r\n@login_required\r\ndef get_file(file_id):\r\n    return jsonify(db.file_json(get_file_or_404(file_id)))\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/download\")\r\n@login_required\r\ndef download(file_id):\r\n    row = get_file_or_404(file_id)\r\n    return file_response(row)\r\n\r\n\r\ndef file_response(row):\r\n    "]
[18.674018, "o", "resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\r\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\r\n    return resp\r\n\r\n\r\n@bp.patch(\"/api/files/<file_id>\")\r\n@login_required\r\ndef rename(file_id):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(403)\r\n    row = get_file_or_404(file_id)\r\n    body = request.get_json(silent=True) or {}\r\n    name = body.get(\"name\")\r\n    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\r\n        abort(400, description=\"bad_name\")\r\n    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\r\n\r\n\r\n@bp.delete(\"/api/files/<file_id>\")\r\n@login_required\r\ndef delete(file_id):\r\n    row = get_file_or_404(file_id)\r\n    conn = db.get_db()\r\n    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\r\n    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\r\n    conn.commit()\r\n    return \"\", 204\r\n"]
[18.674131, "o", "\u001b[?2004hroot@73bf05f9-4184-4dba-9dc9-ae8bfa8f40b6:/app# "]
