[174.818282, "o", "    ident = g.identity\r\n\u001b[?2004l\r"]
[174.818305, "o", "\u001b[?2004h"]
[174.81833, "o", "> "]
[174.818411, "o", "    if ident.is_support:\r\n\u001b[?2004l\r"]
[174.818439, "o", "\u001b[?2004h"]
[174.81847, "o", "> "]
[174.818532, "o", "        abort(403)\r\n\u001b[?2004l\r"]
[174.818553, "o", "\u001b[?2004h"]
[174.818574, "o", "> "]
[174.818949, "o", "    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\r\n\u001b[?2004l\r"]
[174.818984, "o", "\u001b[?2004h"]
[174.81901, "o", "> "]
[174.819121, "o", "                       (token,))\r\n\u001b[?2004l\r"]
[174.819147, "o", "\u001b[?2004h"]
[174.819176, "o", "> "]
[174.81934, "o", "    if row is None or row[\"org_id\"] != ident.org_id:\r\n\u001b[?2004l\r"]
[174.819367, "o", "\u001b[?2004h"]
[174.819391, "o", "> "]
[174.819454, "o", "        abort(404)\r\n\u001b[?2004l\r"]
[174.819492, "o", "\u001b[?2004h> "]
[174.819853, "o", "    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n\u001b[?2004l\r"]
[174.819927, "o", "\u001b[?2004h> "]
[174.819975, "o", "    return \"\", 204\r\n\u001b[?2004l\r"]
[174.820013, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.820043, "o", "\u001b[?2004h"]
[174.820077, "o", "> \r\n\u001b[?2004l\r"]
[174.820105, "o", "\u001b[?2004h> "]
[174.820176, "o", "@bp.get(\"/s/<token>\")\r\n\u001b[?2004l\r"]
[174.8202, "o", "\u001b[?2004h"]
[174.820226, "o", "> "]
[174.820318, "o", "def public_download(token):\r\n\u001b[?2004l\r"]
[174.820345, "o", "\u001b[?2004h"]
[174.820368, "o", "> "]
[174.82075, "o", "    row = db.query_one(\"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\r\n\u001b[?2004l\r"]
[174.820778, "o", "\u001b[?2004h"]
[174.820801, "o", "> "]
[174.82105, "o", "                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (token,))\r\n\u001b[?2004l\r"]
[174.821075, "o", "\u001b[?2004h"]
[174.821098, "o", "> "]
[174.821161, "o", "    if row is None:\r\n\u001b[?2004l\r"]
[174.821187, "o", "\u001b[?2004h"]
[174.821209, "o", "> "]
[174.821275, "o", "        abort(404)\r\n\u001b[?2004l\r"]
[174.821301, "o", "\u001b[?2004h> "]
[174.821411, "o", "    return file_response(row)\r\n\u001b[?2004l\r"]
[174.821436, "o", "\u001b[?2004h"]
[174.821462, "o", "> "]
[174.821486, "o", "PYEOF\r\n"]
