[173.831326, "o", "\u001b[?2004h> "]
[173.832031, "o", "             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n\u001b[?2004l\r"]
[173.832083, "o", "\u001b[?2004h"]
[173.832134, "o", "> "]
[173.832961, "o", "             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n\u001b[?2004l\r"]
