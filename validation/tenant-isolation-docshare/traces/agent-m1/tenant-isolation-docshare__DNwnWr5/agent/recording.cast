[263.019995, "i", "kill %1 2>/dev/null; python3 << 'PYTEST'\nimport urllib.request, urllib.error, json, sys\n\nBASE = \"http://127.0.0.1:8099\"\n\ndef req(method, path, token=None, org_id=None, body=None):\n    url = BASE + path\n    headers = {\"Content-Type\": \"application/json\"}\n    if token: headers[\"Authorization\"] = f\"Bearer {token}\"\n    if org_id: headers[\"X-Org-Id\"] = org_id\n    data = json.dumps(body).encode() if body else None\n    r = urllib.request.Request(url, data=data, headers=headers, method=method)\n    try:\n        resp = urllib.request.urlopen(r)\n        return resp.status, resp.read(), dict(resp.headers)\n    except urllib.error.HTTPError as e:\n        return e.code, e.read(), dict(e.headers)\n\n# Tokens\nBEN = \"dsk_2e09e4b8245edebc817af708207473b7\"       # Halden member\nANNA = \"dsk_c35d7d3b92e4016e27e47ffc284a2d4f\"       # Halden org_admin\nCHLOE = \"dsk_91d5d9efb044d527dd1775a93cdba284\"      # Marlow org_admin\nDEV = \"dsk_46371f37e9a462ce0fa030a07210d3db\"        # Marlow member\nGRACE = \"dsk_1428dfad70ce79934498d7d67c213c12\"  "]
[263.02009, "i", "    # Marlow member + Tessaract org_admin\nRILEY = \"dsk_f9c215672ac38adf41b079157a6d7ff3\"      # support\n\nHALDEN = \"21bade02-6a6a-4768-b2ed-66ffdcc99396\"\nMARLOW = \"6102dd70-63e8-440e-9dd8-904f07489671\"\nTESS = \"83faac57-2f56-4652-866d-e486522c4f8d\"\n\npassed = failed = 0\ndef check(name, cond, detail=\"\"):\n    global passed, failed\n    if cond:\n        passed += 1\n        print(f\"  PASS: {name}\")\n    else:\n        failed += 1\n        print(f\"  FAIL: {name} {detail}\")\n\n# Health\ns, b, _ = req(\"GET\", \"/api/health\")\ncheck(\"health\", s == 200 and json.loads(b) == {\"ok\": True})\n\n# No token -> 401\ns, b, _ = req(\"GET\", \"/api/files\")\ncheck(\"no token 401\", s == 401, f\"got {s}\")\n\n# Bad token -> 401\ns, b, _ = req(\"GET\", \"/api/files\", token=\"dsk_bad\")\ncheck(\"bad token 401\", s == 401, f\"got {s}\")\n\n# Ben lists Halden files\ns, b, _ = req(\"GET\", \"/api/files\", token=BEN)\nd = json.loads(b)\ncheck(\"ben lists halden\", s == 200 and len(d[\"files\"]) > 0)\nhalden_files = d[\"files\"]\n\n# Chloe lists Marlow files\ns, b, _ = req(\"GET\", \"/api/files\""]
[263.020123, "i", ", token=CHLOE)\nd = json.loads(b)\nmarlow_files = d[\"files\"]\ncheck(\"chloe lists marlow\", s == 200 and len(marlow_files) > 0)\n\n# Ben tries to download Marlow file (THE VULNERABILITY)\nmf = marlow_files[0][\"id\"]\ns, b, _ = req(\"GET\", f\"/api/files/{mf}/download\", token=BEN)\ncheck(\"ben download marlow file REFUSED\", s in (403, 404), f\"got {s}\")\ncheck(\"ben download marlow no content\", len(b) == 0 or b == b\"{\" , f\"body={b[:100]}\")\n\n# Ben tries to read Marlow file metadata\ns, b, _ = req(\"GET\", f\"/api/files/{mf}\", token=BEN)\ncheck(\"ben read marlow file REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Ben tries thumb of Marlow file\ns, b, _ = req(\"GET\", f\"/api/files/{mf}/thumb\", token=BEN)\ncheck(\"ben thumb marlow file REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Ben tries to switch to Marlow (not a member) -> refused\ns, b, _ = req(\"GET\", \"/api/files\", token=BEN, org_id=MARLOW)\ncheck(\"ben switch to marlow REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Grace switches to Tessaract (is member) -> works\ns, b, _ = req(\"GET\", \"/api/files\", toke"]
[263.020151, "i", "n=GRACE, org_id=TESS)\ncheck(\"grace switch to tessaract OK\", s == 200, f\"got {s}\")\n\n# Grace lists files in Tessaract context\ns, b, _ = req(\"GET\", \"/api/files\", token=GRACE, org_id=TESS)\nd = json.loads(b)\ntess_files = d[\"files\"]\ncheck(\"grace lists tessaract\", len(tess_files) > 0)\n\n# Grace tries to download a Marlow file while active org is Tessaract\ns, b, _ = req(\"GET\", f\"/api/files/{mf}/download\", token=GRACE, org_id=TESS)\ncheck(\"grace(tess) download marlow REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Grace switches to Marlow and downloads Marlow file\ns, b, _ = req(\"GET\", f\"/api/files/{mf}/download\", token=GRACE, org_id=MARLOW)\ncheck(\"grace(marlow) download marlow OK\", s == 200, f\"got {s}\")\n\n# Support without X-Org-Id on list -> 400\ns, b, _ = req(\"GET\", \"/api/files\", token=RILEY)\ncheck(\"support list no org 400\", s == 400, f\"got {s}\")\ns, b, _ = req(\"GET\", \"/api/folders\", token=RILEY)\ncheck(\"support folders no org 400\", s == 400, f\"got {s}\")\n\n# Support with X-Org-Id on list -> 200\ns, b, _ = req(\"GET\", \"/api/files\","]
[263.020175, "i", " token=RILEY, org_id=HALDEN)\ncheck(\"support list halden OK\", s == 200, f\"got {s}\")\n\n# Support with non-existent org -> 404\ns, b, _ = req(\"GET\", \"/api/files\", token=RILEY, org_id=\"nonexistent\")\ncheck(\"support nonexistent org 404\", s == 404, f\"got {s}\")\n\n# Support reads any org file (no X-Org-Id needed for read)\ns, b, _ = req(\"GET\", f\"/api/files/{halden_files[0]['id']}\", token=RILEY)\ncheck(\"support read halden file OK\", s == 200, f\"got {s}\")\n\n# Support reads Marlow file\ns, b, _ = req(\"GET\", f\"/api/files/{mf}\", token=RILEY)\ncheck(\"support read marlow file OK\", s == 200, f\"got {s}\")\n\n# Support tries to rename -> 403\ns, b, _ = req(\"PATCH\", f\"/api/files/{halden_files[0]['id']}\", token=RILEY, body={\"name\": \"x\"})\ncheck(\"support rename REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Support tries to delete -> 403\ns, b, _ = req(\"DELETE\", f\"/api/files/{halden_files[0]['id']}\", token=RILEY)\ncheck(\"support delete REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Support tries to share -> 403\ns, b, _ = req(\"POST\", f\"/api/files/{halden_f"]
[263.020201, "i", "iles[0]['id']}/shares\", token=RILEY)\ncheck(\"support share REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Member (Ben) tries to delete -> 403\nhf = halden_files[0][\"id\"]\ns, b, _ = req(\"DELETE\", f\"/api/files/{hf}\", token=BEN)\ncheck(\"member delete REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Org admin (Anna) deletes -> 204\ns, b, _ = req(\"DELETE\", f\"/api/files/{hf}\", token=ANNA)\ncheck(\"admin delete OK\", s == 204, f\"got {s}\")\n\n# File is gone\ns, b, _ = req(\"GET\", f\"/api/files/{hf}\", token=BEN)\ncheck(\"deleted file gone\", s == 404, f\"got {s}\")\n\n# Cross-org export: Ben exports a Marlow file\ns, b, _ = req(\"POST\", \"/api/export\", token=BEN, body={\"file_ids\": [mf]})\ncheck(\"cross-org export REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Same-org export works\ns, b, _ = req(\"POST\", \"/api/export\", token=BEN, body={\"file_ids\": [halden_files[1][\"id\"] if len(halden_files)>1 else halden_files[0][\"id\"]]})\ncheck(\"same-org export OK\", s == 200, f\"got {s}\")\n\n# Support exports any org file\ns, b, _ = req(\"POST\", \"/api/export\", token=RILEY, body={\"fi"]
[263.020224, "o", "kill %1 2>/dev/null; python3 << 'PYTEST'\r\n\u001b[?2004l\r"]
[263.020243, "i", "le_ids\": [marlow_files[0][\"id\"]]})\ncheck(\"support export any org OK\", s == 200, f\"got {s}\")\n\n# Share link: create, use, revoke\ns, b, _ = req(\"POST\", f\"/api/files/{marlow_files[0]['id']}/shares\", token=CHLOE)\ncheck(\"create share OK\", s == 201, f\"got {s}\")\ntoken_val = json.loads(b)[\"token\"]\n\ns, b, _ = req(\"GET\", f\"/s/{token_val}\")\ncheck(\"public share download OK\", s == 200, f\"got {s}\")\n\n# Cross-org share: Ben tries to create share on Marlow file\ns, b, _ = req(\"POST\", f\"/api/files/{marlow_files[0]['id']}/shares\", token=BEN)\ncheck(\"ben share marlow REFUSED\", s in (403, 404), f\"got {s}\")\n\n# Revoke\ns, b, _ = req(\"DELETE\", f\"/api/shares/{token_val}\", token=CHLOE)\ncheck(\"revoke share OK\", s == 204, f\"got {s}\")\n\ns, b, _ = req(\"GET\", f\"/s/{token_val}\")\ncheck(\"revoked share 404\", s == 404, f\"got {s}\")\n\n# /api/me\ns, b, _ = req(\"GET\", \"/api/me\", token=BEN)\nd = json.loads(b)\ncheck(\"me works\", s == 200 and d[\"user\"][\"name\"] == \"Ben Carver\", f\"got {s}\")\n\n# /api/me for support without X-Org-Id\ns, b, _ = req(\"GET\", \"/api/me\", "]
[263.020264, "i", "token=RILEY)\nd = json.loads(b)\ncheck(\"support me no org\", s == 200 and d[\"active_org_id\"] is None and d[\"role\"] == \"support\", f\"got {s}\")\n\n# admin/orgs: support only\ns, b, _ = req(\"GET\", \"/api/admin/orgs\", token=RILEY)\ncheck(\"support admin orgs OK\", s == 200, f\"got {s}\")\ns, b, _ = req(\"GET\", \"/api/admin/orgs\", token=BEN)\ncheck(\"member admin orgs REFUSED\", s in (403, 404), f\"got {s}\")\n\nprint(f\"\\n{'='*40}\n{passed} passed, {failed} failed\")\nsys.exit(1 if failed else 0)\nPYTEST\n"]
