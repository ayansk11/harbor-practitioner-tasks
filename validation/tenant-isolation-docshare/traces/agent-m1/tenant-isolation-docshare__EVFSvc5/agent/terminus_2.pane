    11	
    12	def main(argv=None):
    13	    p = argparse.ArgumentParser(description="docshare API server")
    14	    p.add_argument("--db", required=True, help="path to an existing docshare SQLite database")
    15	    p.add_argument("--port", type=int, default=8080)
    16	    p.add_argument("--host", default="127.0.0.1")
    17	    p.add_argument("--threads", type=int, default=4)
    18	    args = p.parse_args(argv)
    19	    if not os.path.isfile(args.db):
    20	        sys.exit(f"database not found: {args.db}")
    21	    conn = db.connect(args.db)
    22	    conn.execute("PRAGMA journal_mode = WAL")
    23	    conn.close()
    24	    serve(create_app(os.path.abspath(args.db)), host=args.host, port=args.port, threads=args.threads,
    25	          ident="docshare")
    26	
    27	
    28	if __name__ == "__main__":
    29	    main()
     1	"""Build a development database: python -m docshare.seed --out data/docshare.db [--force].
     2	
     3	Everything comes from one seeded random generator, so the same spec always gives the same rows.
     4	"""
     5	import argparse
     6	import base64
     7	import os
     8	import random
     9	import re
    10	import sqlite3
    11	import sys
    12	import uuid
    13	from datetime import datetime, timedelta, timezone
    14	
    15	from .db import SCHEMA
    16	
    17	DEV_SPEC = {
    18	    "seed": 4242,
    19	    "orgs": ["Halden & Price LLP", "Marlow Community Clinic", "Tessaract Robotics"],
    20	    "folders": ["Board", "Contracts", "Finance", "Operations", "People"],
    21	    "folders_per_org": 3,
    22	    "files_per_org": 10,
    23	    "users": [
    24	        {"name": "Anna Lindqvist", "email": "anna@haldenprice.example", "home": 0, "orgs": {0: "org_admin"}},
    25	        {"name": "Ben Carver", "email": "ben@haldenprice.example", "home": 0, "orgs": {0: "member"}},
    26	        {"name": "Chloe Ndiaye", "email": "chloe@marlowclinic.example", "home": 1, "orgs": {1: "org_admin"}},
    27	        {"name": "Dev Patel", "email": "dev@marlowclinic.example", "home": 1, "orgs": {1: "member"}},
    28	        {"name": "Elena Rossi", "email": "elena@tessaract.example", "home": 2, "orgs": {2: "org_admin"}},
    29	        {"name": "Felix Brandt", "email": "felix@tessaract.example", "home": 2, "orgs": {2: "member"}},
    30	        {"name": "Grace Okafor", "email": "grace@okafor-consulting.example", "home": 1,
    31	         "orgs": {1: "member", 2: "org_admin"}},
    32	        {"name": "Riley Chen", "email": "riley@support.docshare.example", "home": None, "orgs": {}, "support": True},
    33	    ],
    34	    "shares": 6,
    35	    "revoked_shares": 2,
    36	}
    37	
    38	TITLES = ["Board minutes", "Vendor contract", "Payroll summary", "Incident review", "Quarterly forecast",
    39	          "Lease renewal", "Hiring plan", "Insurance certificate", "Audit findings", "Pricing proposal",
    40	          "Data retention policy", "Customer escalation log", "Travel policy", "Project charter",
    41	          "Security questionnaire", "Budget variance", "Supplier onboarding", "Litigation hold notice",
    42	          "Capacity plan", "Expense report", "Training records", "Risk register", "Offsite agenda",
    43	          "Severance terms", "Grant application", "Maintenance schedule", "Procurement request",
    44	          "Patient intake checklist", "Firmware release notes", "Settlement draft"]
    45	SENTENCES = ["Figures are provisional until the month-end close.",
    46	             "Action items are tracked in the operations folder.",
    47	             "Circulate only to the people named on the distribution list.",
    48	             "The previous version is superseded by this document.",
    49	             "Comments are due by the end of next week.",
    50	             "Amounts are in the organisation's reporting currency.",
    51	             "Approval is recorded in the minutes of the next meeting.",
    52	             "Personal data in this file falls under the retention policy.",
    53	             "Questions go to the document owner named above.",
    54	             "This summary was prepared from the source systems on the date shown."]
    55	
    56	
    57	def _uuid(rng):
    58	    return str(uuid.UUID(int=rng.getrandbits(128), version=4))
    59	
    60	
    61	def _slug(text):
    62	    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    63	
    64	
    65	def _when(rng, base=datetime(2026, 3, 2, 8, 0, tzinfo=timezone.utc)):
    66	    return (base + timedelta(minutes=rng.randrange(0, 200 * 24 * 60))).strftime("%Y-%m-%dT%H:%M:%SZ")
    67	
    68	
    69	def _later(stamp, days):
    70	    t = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ") + timedelta(days=days)
    71	    return t.strftime("%Y-%m-%dT%H:%M:%SZ")
    72	
    73	
    74	def _content(rng, title, org_name, owner, marker, ext):
    75	    date = _when(rng)[:10]
    76	    body = " ".join(rng.sample(SENTENCES, rng.randint(2, 4)))
    77	    if ext == "csv":
    78	        rows = "\n".join(f"{rng.choice(['travel', 'software', 'hardware', 'services', 'facilities'])},"
    79	                         f"{rng.randint(100, 99999)}.{rng.randint(0, 99):02d}" for _ in range(rng.randint(3, 6)))
    80	        text = f"ref,{marker}\norganisation,{org_name}\nowner,{owner}\ncategory,amount\n{rows}\n"
    81	        return text.encode(), "text/csv"
    82	    text = f"# {title}\nOrganisation: {org_name}\nRef: {marker}\nOwner: {owner}\nDate: {date}\n\n{body}\n"
    83	    return text.encode(), ("text/markdown" if ext == "md" else "text/plain")
    84	
    85	
    86	def build(path, spec):
    87	    """Create a new database at path from spec; returns a summary dict (ids, tokens, markers) for tooling."""
    88	    rng = random.Random(spec["seed"])
    89	    if os.path.exists(path):
    90	        raise FileExistsError(path)
    91	    conn = sqlite3.connect(path)
    92	    conn.executescript(SCHEMA)
    93	    orgs = [{"id": _uuid(rng), "name": n} for n in spec["orgs"]]
    94	    conn.executemany("INSERT INTO orgs (id, name) VALUES (?, ?)", [(o["id"], o["name"]) for o in orgs])
    95	    users = []
    96	    for u in spec["users"]:
    97	        rec = {"id": _uuid(rng), "name": u["name"], "email": u["email"], "token": "dsk_%032x" % rng.getrandbits(128),
    98	               "home_org_id": orgs[u["home"]]["id"] if u.get("home") is not None else None,
    99	               "is_support": 1 if u.get("support") else 0,
   100	               "orgs": {orgs[i]["id"]: role for i, role in u.get("orgs", {}).items()}}
   101	        users.append(rec)
   102	        conn.execute("INSERT INTO users (id, email, name, token, home_org_id, is_support) VALUES (?, ?, ?, ?, ?, ?)",
   103	                     (rec["id"], rec["email"], rec["name"], rec["token"], rec["home_org_id"], rec["is_support"]))
   104	        for org_id, role in rec["orgs"].items():
   105	            conn.execute("INSERT INTO memberships (user_id, org_id, role) VALUES (?, ?, ?)", (rec["id"], org_id, role))
   106	    folders, files, markers = [], [], set()
   107	    titles = list(TITLES)
   108	    rng.shuffle(titles)
   109	    for o in orgs:
   110	        names = rng.sample(spec["folders"], spec["folders_per_org"])
   111	        org_folders = [{"id": _uuid(rng), "org_id": o["id"], "name": n} for n in names]
   112	        folders += org_folders
   113	        conn.executemany("INSERT INTO folders (id, org_id, name) VALUES (?, ?, ?)",
   114	                         [(f["id"], f["org_id"], f["name"]) for f in org_folders])
   115	        people = [u for u in users if o["id"] in u["orgs"]]
   116	        for _ in range(spec["files_per_org"]):
   117	            title = titles.pop() if titles else rng.choice(TITLES)
   118	            if not titles:
   119	                titles = list(TITLES)
   120	                rng.shuffle(titles)
   121	            ext = rng.choice(["md", "md", "txt", "csv"])
   122	            marker = "DSM-%016X" % rng.getrandbits(64)
   123	            assert marker not in markers
   124	            markers.add(marker)
   125	            owner = rng.choice(people)
   126	            content, mime = _content(rng, title, o["name"], owner["name"], marker, ext)
   127	            rec = {"id": _uuid(rng), "org_id": o["id"], "folder_id": rng.choice(org_folders)["id"],
   128	                   "name": f"{_slug(title)}-{rng.getrandbits(16):04x}.{ext}", "mime_type": mime,
   129	                   "size": len(content), "uploaded_by": owner["id"], "created_at": _when(rng), "marker": marker}
   130	            files.append(rec)
   131	            conn.execute("INSERT INTO files (id, org_id, folder_id, name, mime_type, size, content, uploaded_by, "
   132	                         "created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
   133	                         (rec["id"], rec["org_id"], rec["folder_id"], rec["name"], rec["mime_type"], rec["size"],
   134	                          content, rec["uploaded_by"], rec["created_at"]))
   135	    shares = []
   136	    for i, f in enumerate(rng.sample(files, spec["shares"])):
   137	        creator = rng.choice([u for u in users if f["org_id"] in u["orgs"]])
   138	        created = _when(rng)
   139	        rec = {"token": base64.urlsafe_b64encode(rng.randbytes(18)).decode(), "file_id": f["id"],
   140	               "created_by": creator["id"], "created_at": created,
   141	               "revoked_at": _later(created, rng.randint(1, 20)) if i < spec["revoked_shares"] else None}
   142	        shares.append(rec)
   143	        conn.execute("INSERT INTO shares (token, file_id, created_by, created_at, revoked_at) VALUES (?, ?, ?, ?, ?)",
   144	                     (rec["token"], rec["file_id"], rec["created_by"], rec["created_at"], rec["revoked_at"]))
   145	    conn.commit()
   146	    conn.close()
   147	    return {"orgs": orgs, "users": users, "folders": folders, "files": files, "shares": shares}
   148	
   149	
   150	def main(argv=None):
   151	    p = argparse.ArgumentParser(description="build a docshare development database")
   152	    p.add_argument("--out", required=True)
   153	    p.add_argument("--force", action="store_true", help="replace an existing file")
   154	    args = p.parse_args(argv)
   155	    if os.path.exists(args.out):
   156	        if not args.force:
   157	            sys.exit(f"{args.out} exists (use --force)")
   158	        os.remove(args.out)
   159	    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
   160	    s = build(args.out, DEV_SPEC)
   161	    print(f"wrote {args.out}: {len(s['orgs'])} orgs, {len(s['users'])} users, {len(s['files'])} files")
   162	
   163	
   164	if __name__ == "__main__":
   165	    main()
