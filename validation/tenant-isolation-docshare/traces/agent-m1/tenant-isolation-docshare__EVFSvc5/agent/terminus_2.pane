    45	def test_member_lists_and_downloads_own_files(env):
    46	    client, s = env
    47	    ben = user(s, "ben@haldenprice.example")
    48	    r = client.get("/api/files", headers=h(ben))
    49	    assert r.status_code == 200
    50	    ids = {f["id"] for f in r.get_json()["files"]}
    51	    assert ids == {f["id"] for f in org_files(s, ben["home_org_id"])}
    52	    f = org_files(s, ben["home_org_id"])[0]
    53	    r = client.get(f"/api/files/{f['id']}/download", headers=h(ben))
    54	    assert r.status_code == 200 and len(r.data) == f["size"]
