--- auth.py ---
     1	"""Who is calling: bearer token -> user, plus the validated active organisation."""
     2	import functools
     3	from dataclasses import dataclass, field
     4	
     5	from flask import abort, g, jsonify, request
     6	
     7	from . import db
     8	
     9	
    10	@dataclass
    11	class Identity:
    12	    user_id: str
    13	    email: str
    14	    name: str
    15	    is_support: bool
    16	    org_id: str | None          # the active organisation for this request
    17	    role: str                   # "member", "org_admin" or "support"
    18	    memberships: dict = field(default_factory=dict)   # org_id -> role
    19	
    20	
    21	def _bearer_token():
    22	    header = request.headers.get("Authorization", "")
    23	    if not header.startswith("Bearer "):
    24	        return None
    25	    return header[len("Bearer "):].strip() or None
    26	
    27	
    28	def load_identity():
    29	    token = _bearer_token()
    30	    if token is None:
    31	        return None
    32	    user = db.query_one("SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?", (token,))
    33	    if user is None:
    34	        return None
    35	    memberships = {r["org_id"]: r["role"] for r in
    36	                   db.query_all("SELECT org_id, role FROM memberships WHERE user_id = ?", (user["id"],))}
    37	
    38	    requested_org = request.headers.get("X-Org-Id")
    39	    if user["is_support"]:
    40	        # Support has no home organisation.  A header is optional, but if supplied it must name a real org.
    41	        if requested_org is None:
    42	            org_id = None
    43	        else:
    44	            if db.query_one("SELECT id FROM orgs WHERE id = ?", (requested_org,)) is None:
    45	                abort(403, description="active_org_forbidden")
    46	            org_id = requested_org
    47	        role = "support"
    48	    else:
    49	        # Do not silently trust an org id merely because the route compares against it later.
    50	        org_id = requested_org if requested_org is not None else user["home_org_id"]
    51	        role = memberships.get(org_id)
    52	        if (org_id is None or role is None or
    53	                db.query_one("SELECT id FROM orgs WHERE id = ?", (org_id,)) is None):
    54	            abort(403, description="active_org_forbidden")
    55	
    56	    return Identity(user_id=user["id"], email=user["email"], name=user["name"], is_support=bool(user["is_support"]),
    57	                    org_id=org_id, role=role, memberships=memberships)
    58	
    59	
    60	def login_required(view):
    61	    @functools.wraps(view)
    62	    def wrapper(*args, **kwargs):
    63	        ident = load_identity()
    64	        if ident is None:
    65	            return jsonify(error="unauthorized"), 401
    66	        g.identity = ident
    67	        return view(*args, **kwargs)
    68	    return wrapper
    69	
    70	
    71	def require_active_org():
    72	    """The active organisation id; support must name one with X-Org-Id before listing anything."""
    73	    org_id = g.identity.org_id
    74	    if org_id is None:
    75	        abort(400, description="x_org_id_required")
    76	    return org_id
    77	
    78	
    79	def require_readable_file(row):
    80	    """Apply the read rule to a file row already fetched by id."""
    81	    ident = g.identity
    82	    if ident.is_support or row["org_id"] == ident.org_id:
    83	        return row
    84	    # 404 avoids confirming that an inaccessible file id exists.
    85	    abort(404, description="not_found")
--- files.py ---
     1	"""File endpoints: list, metadata, download, rename, delete."""
     2	from flask import Blueprint, Response, abort, g, jsonify, request
     3	
     4	from .. import db
     5	from ..auth import login_required, require_active_org, require_readable_file
     6	
     7	bp = Blueprint("files", __name__)
     8	
     9	
    10	def get_readable_file(file_id, *, include_content=False):
    11	    columns = db.FILE_COLUMNS + (", content" if include_content else "")
    12	    row = db.query_one(f"SELECT {columns} FROM files WHERE id = ?", (file_id,))
    13	    if row is None:
    14	        abort(404, description="not_found")
    15	    return require_readable_file(row)
    16	
    17	
    18	def get_file_or_404(file_id):
    19	    """Compatibility helper used by file mutations; callers must still authorize the result."""
    20	    row = db.query_one(f"SELECT {db.FILE_COLUMNS} FROM files WHERE id = ?", (file_id,))
    21	    if row is None:
    22	        abort(404, description="not_found")
    23	    return row
    24	
    25	
    26	@bp.get("/api/files")
    27	@login_required
    28	def list_files():
    29	    org_id = require_active_org()
    30	    rows = db.query_all(f"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name", (org_id,))
    31	    return jsonify(files=[db.file_json(r) for r in rows])
    32	
    33	
    34	@bp.get("/api/files/<file_id>")
    35	@login_required
    36	def get_file(file_id):
    37	    return jsonify(db.file_json(get_readable_file(file_id)))
    38	
    39	
    40	@bp.get("/api/files/<file_id>/download")
    41	@login_required
    42	def download(file_id):
    43	    row = get_readable_file(file_id, include_content=True)
    44	    return file_response(row)
    45	
    46	
    47	def file_response(row):
    48	    resp = Response(bytes(row["content"]), mimetype=row["mime_type"])
    49	    resp.headers["Content-Disposition"] = f'attachment; filename="{row["name"]}"'
    50	    return resp
    51	
    52	
    53	@bp.patch("/api/files/<file_id>")
    54	@login_required
    55	def rename(file_id):
    56	    if g.identity.role not in ("member", "org_admin"):
    57	        abort(403, description="forbidden")
    58	    row = get_readable_file(file_id)
    59	    body = request.get_json(silent=True) or {}
    60	    name = body.get("name")
    61	    if not isinstance(name, str) or not (1 <= len(name) <= 200) or "/" in name:
    62	        abort(400, description="bad_name")
    63	    db.execute("UPDATE files SET name = ? WHERE id = ?", (name, row["id"]))
    64	    return jsonify(db.file_json(get_file_or_404(row["id"])))
    65	
    66	
    67	@bp.delete("/api/files/<file_id>")
    68	@login_required
    69	def delete(file_id):
    70	    if g.identity.role != "org_admin":
    71	        abort(403, description="forbidden")
    72	    row = get_readable_file(file_id)
    73	    conn = db.get_db()
    74	    conn.execute("DELETE FROM shares WHERE file_id = ?", (row["id"],))
    75	    conn.execute("DELETE FROM files WHERE id = ?", (row["id"],))
    76	    conn.commit()
    77	    return "", 204
