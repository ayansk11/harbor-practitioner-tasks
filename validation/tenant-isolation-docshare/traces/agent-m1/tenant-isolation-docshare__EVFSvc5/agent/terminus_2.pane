===== /app/docshare/routes/thumbs.py =====
     1	"""SVG previews for the file grid."""
     2	import html
     3	
     4	from flask import Blueprint, Response, abort
     5	
     6	from .. import db
     7	from ..auth import login_required
     8	
     9	bp = Blueprint("thumbs", __name__)
    10	
    11	TEXT_TYPES = ("text/", "application/json")
    12	
    13	
    14	def render_thumb(name, mime_type, content):
    15	    lines = []
    16	    if mime_type.startswith(TEXT_TYPES):
    17	        text = bytes(content).decode("utf-8", "replace")
    18	        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]
    19	    parts = ['<svg xmlns="http://www.w3.org/2000/svg" width="160" height="200" viewBox="0 0 160 200">',
    20	             f"<title>{html.escape(name)}</title>",
    21	             '<rect x="0.5" y="0.5" width="159" height="199" fill="#ffffff" stroke="#c8ccd2"/>',
    22	             f'<text x="8" y="18" font-size="9" font-weight="bold">{html.escape(name[:30])}</text>']
    23	    for i, ln in enumerate(lines):
    24	        parts.append(f'<text x="8" y="{40 + 14 * i}" font-size="8">{html.escape(ln[:34])}</text>')
    25	    parts.append("</svg>")
    26	    return "\n".join(parts)
    27	
    28	
    29	@bp.get("/api/files/<file_id>/thumb")
    30	@login_required
    31	def thumb(file_id):
    32	    row = db.query_one("SELECT name, mime_type, content FROM files WHERE id = ?", (file_id,))
    33	    if row is None:
    34	        abort(404)
    35	    svg = render_thumb(row["name"], row["mime_type"], row["content"])
    36	    return Response(svg, mimetype="image/svg+xml")

===== /app/docshare/routes/export.py =====
     1	"""Bulk export: several files in one JSON response (used by the "Download selected" button)."""
     2	import base64
     3	
     4	from flask import Blueprint, abort, g, jsonify, request
     5	
     6	from .. import db
     7	from ..auth import login_required
     8	
     9	bp = Blueprint("export", __name__)
    10	
    11	MAX_IDS = 50
    12	
    13	
    14	@bp.post("/api/export")
    15	@login_required
    16	def export():
    17	    body = request.get_json(silent=True) or {}
    18	    ids = body.get("file_ids")
    19	    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):
    20	        abort(400, description="bad_file_ids")
    21	    # A selection always comes from one folder view, so the first file tells us whose files these are.
    22	    first = db.query_one("SELECT org_id FROM files WHERE id = ?", (ids[0],))
    23	    if first is None:
    24	        abort(404)
    25	    if not g.identity.is_support and first["org_id"] != g.identity.org_id:
    26	        abort(404)
    27	    out = []
    28	    for file_id in ids:
    29	        row = db.query_one("SELECT id, name, mime_type, size, content FROM files WHERE id = ?", (file_id,))
    30	        if row is None:
    31	            abort(404)
    32	        out.append({"id": row["id"], "name": row["name"], "mime_type": row["mime_type"], "size": row["size"],
    33	                    "content_b64": base64.b64encode(bytes(row["content"])).decode("ascii")})
    34	    return jsonify(files=out)

===== /app/docshare/routes/share.py =====
     1	"""Share links: create, revoke, and the public download behind /s/<token>."""
     2	import secrets
     3	from datetime import datetime, timezone
     4	
     5	from flask import Blueprint, abort, g, jsonify
     6	
     7	from .. import db
     8	from ..auth import login_required
     9	from .files import file_response
    10	
    11	bp = Blueprint("share", __name__)
    12	
    13	
    14	def now_iso():
    15	    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    16	
    17	
    18	@bp.post("/api/files/<file_id>/shares")
    19	@login_required
    20	def create_share(file_id):
    21	    if g.identity.role not in ("member", "org_admin"):
    22	        abort(403)
    23	    row = db.query_one("SELECT id FROM files WHERE id = ?", (file_id,))
    24	    if row is None:
    25	        abort(404)
    26	    token = secrets.token_urlsafe(18)
    27	    created = now_iso()
    28	    db.execute("INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)",
    29	               (token, row["id"], g.identity.user_id, created))
    30	    return jsonify(token=token, url=f"/s/{token}", file_id=row["id"], created_at=created), 201
    31	
    32	
    33	@bp.delete("/api/shares/<token>")
    34	@login_required
    35	def revoke_share(token):
    36	    row = db.query_one("SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?",
    37	                       (token,))
    38	    if row is None or row["org_id"] != g.identity.org_id or g.identity.role not in ("member", "org_admin"):
    39	        abort(404)
    40	    db.execute("UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL", (now_iso(), token))
    41	    return "", 204
    42	
    43	
    44	@bp.get("/s/<token>")
    45	def public_download(token):
    46	    row = db.query_one("SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id "
    47	                       "WHERE s.token = ? AND s.revoked_at IS NULL", (token,))
    48	    if row is None:
    49	        abort(404)
    50	    return file_response(row)

