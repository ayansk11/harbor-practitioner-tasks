     9	
    10	@bp.get("/api/folders")
    11	@login_required
    12	def list_folders():
    13	    org_id = require_active_org()
    14	    rows = db.query_all("SELECT id, org_id, name FROM folders WHERE org_id = ? ORDER BY name", (org_id,))
