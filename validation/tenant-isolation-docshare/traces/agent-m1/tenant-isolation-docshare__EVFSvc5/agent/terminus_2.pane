     9	
    10	@pytest.fixture()
    11	def env(tmp_path):
    12	    path = tmp_path / "test.db"
    13	    summary = seed.build(str(path), seed.DEV_SPEC)
    14	    app = create_app(str(path))
    15	    app.config["TESTING"] = True
    16	    return app.test_client(), summary
