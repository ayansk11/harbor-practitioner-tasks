    60	    folders = client.get("/api/folders", headers=h(ben)).get_json()["folders"]
    61	    assert folders and all(fo["org_id"] == ben["home_org_id"] for fo in folders)
    62	    r = client.get(f"/api/folders/{folders[0]['id']}/files", headers=h(ben))
    63	    assert r.status_code == 200
    64	    assert all(f["folder_id"] == folders[0]["id"] for f in r.get_json()["files"])
