[35.961252, "o", "     1\t\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\r\n     2\timport secrets\r\n     3\tfrom datetime import datetime, timezone\r\n     4\t\r\n     5\tfrom flask import Blueprint, abort, g, jsonify\r\n     6\t\r\n     7\tfrom .. import db\r\n     8\tfrom ..auth import login_required\r\n     9\tfrom .files import file_response\r\n    10\t\r\n    11\tbp = Blueprint(\"share\", __name__)\r\n"]
[35.961318, "o", "    12\t\r\n    13\t\r\n    14\tdef now_iso():\r\n    15\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n    16\t\r\n    17\t\r\n    18\t@bp.post(\"/api/files/<file_id>/shares\")\r\n    19\t@login_required\r\n    20\tdef create_share(file_id):\r\n    21\t    if g.identity.role not in (\"member\", \"org_admin\"):\r\n    22\t        abort(403)\r\n    23\t    row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\r\n    24\t    if row is None:\r\n    25\t        abort(404)\r\n    26\t    token = secrets.token_urlsafe(18)\r\n    27\t    created = now_iso()\r\n    28\t    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\r\n    29\t               (token, row[\"id\"], g.identity.user_id, created))\r\n    30\t    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\r\n    31\t\r\n    32\t\r\n    33\t@bp.delete(\"/api/shares/<token>\")\r\n    34\t@login_required\r\n    35\tdef revoke_share(token):\r\n    36\t    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files"]
[35.961368, "o", " f ON f.id = s.file_id WHERE s.token = ?\",\r\n    37\t                       (token,))\r\n    38\t    if row is None or row[\"org_id\"] != g.identity.org_id or g.identity.role not in (\"member\", \"org_admin\"):\r\n    39\t        abort(404)\r\n    40\t    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n    41\t    return \"\", 204\r\n    42\t\r\n    43\t\r\n    44\t@bp.get(\"/s/<token>\")\r\n    45\tdef public_download(token):\r\n    46\t    row = db.query_one(\"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\r\n    47\t                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (token,))\r\n    48\t    if row is None:\r\n    49\t        abort(404)\r\n    50\t    return file_response(row)\r\n"]
