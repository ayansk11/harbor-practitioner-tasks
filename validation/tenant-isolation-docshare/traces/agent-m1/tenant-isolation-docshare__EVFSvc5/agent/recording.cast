[386.999813, "o", "     1\t\"\"\"Who is calling: bearer token -> user, plus the validated active organisation.\"\"\"\r\n     2\timport functools\r\n     3\tfrom dataclasses import dataclass, field\r\n     4\t\r\n     5\tfrom flask import abort, g, jsonify, request\r\n     6\t\r\n     7\tfrom . import db\r\n     8\t\r\n     9\t\r\n    10\t@dataclass\r\n"]
