[386.999926, "o", "    21\tdef _bearer_token():\r\n    22\t    header = request.headers.get(\"Authorization\", \"\")\r\n    23\t    if not header.startswith(\"Bearer \"):\r\n    24\t        return None\r\n    25\t    return header[len(\"Bearer \"):].strip() or None\r\n    26\t\r\n    27\t\r\n    28\tdef load_identity():\r\n    29\t    token = _bearer_token()\r\n    30\t    if token is None:\r\n    31\t        return None\r\n    32\t    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n    33\t    if user is None:\r\n    34\t        return None\r\n    35\t    memberships = {r[\"org_id\"]: r[\"role\"] for r in\r\n    36\t                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    37\t\r\n    38\t    requested_org = request.headers.get(\"X-Org-Id\")\r\n    39\t    if user[\"is_support\"]:\r\n    40\t        # Support has no home organisation.  A header is optional, but if supplied it must name a real org.\r\n    41\t        if requested_org is None:\r\n    42\t            org_id = None\r\n    43\t   "]
