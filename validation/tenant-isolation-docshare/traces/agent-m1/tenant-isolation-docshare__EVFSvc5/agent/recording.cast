[785.178942, "i", "rm -f /tmp/docshare-policy.db /tmp/docshare-policy.db-wal /tmp/docshare-policy.db-shm\nPYTHONPATH=/app python - <<'PY'\nimport sqlite3\nfrom docshare import seed\nfrom docshare.app import create_app\n\npath = '/tmp/docshare-policy.db'\ns = seed.build(path, seed.DEV_SPEC)\napp = create_app(path)\napp.config['TESTING'] = True\nc = app.test_client()\n# Every unauthenticated /api request, including unmatched and unlisted methods, must be 401.\nfor method, url in [('get', '/api/no-such-endpoint'), ('post', '/api/files'), ('patch', '/api/files/x'), ('options', '/api/files')]:\n    r = getattr(c, method)(url)\n    assert r.status_code == 401, (method, url, r.status_code, r.data)\n# Health remains the sole unauthenticated /api endpoint.\nassert c.get('/api/health').status_code == 200\n# Non-object malformed bodies must not become 500 errors.\nriley = next(u for u in s['users'] if u['is_support'])\nheaders = {'Authorization': 'Bearer ' + riley['token'], 'X-Org-Id': s['orgs'][0]['id']}\nassert c.patch('/api/files/x', json=['not', 'an', 'o"]
[785.179034, "i", "bject'], headers=headers).status_code == 400\nassert c.post('/api/export', json=['not', 'an', 'object'], headers=headers).status_code == 400\nconn = sqlite3.connect(path)\nassert conn.execute('SELECT COUNT(*) FROM files').fetchone()[0] == len(s['files'])\nassert conn.execute('SELECT COUNT(*) FROM shares').fetchone()[0] == len(s['shares'])\nprint('central auth and malformed-body checks passed')\nPY\n"]
[785.179887, "o", "rm -f /tmp/docshare-policy.db /tmp/docshare-policy.db-wal /tmp/docshare-policy.db-shm\r\n"]
