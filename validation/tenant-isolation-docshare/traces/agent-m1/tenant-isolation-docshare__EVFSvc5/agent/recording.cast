[772.429374, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('docshare/auth.py')\ns = p.read_text()\ns = s.replace('''def login_required(view):\n    @functools.wraps(view)\n    def wrapper(*args, **kwargs):\n        ident = load_identity()\n        if ident is None:\n            return jsonify(error=\"unauthorized\"), 401\n        g.identity = ident\n        return view(*args, **kwargs)\n    return wrapper\n''', '''def login_required(view):\n    @functools.wraps(view)\n    def wrapper(*args, **kwargs):\n        # The application-wide /api hook normally authenticates first.  Keep loading here\n        # as a fallback so this decorator remains independently safe.\n        ident = g.get(\"identity\")\n        if ident is None:\n            ident = load_identity()\n            if ident is None:\n                return jsonify(error=\"unauthorized\"), 401\n            g.identity = ident\n        return view(*args, **kwargs)\n    return wrapper\n''')\np.write_text(s)\n\np = Path('docshare/app.py')\ns = p.read_text()\ns = s.replace('from flask import Flask, g, "]
[772.429503, "i", "jsonify', 'from flask import Flask, g, jsonify, request')\ns = s.replace('from .auth import login_required', 'from .auth import load_identity, login_required')\ns = s.replace('''    for module in (files, folders, thumbs, export, share, admin):\n        app.register_blueprint(module.bp)\n\n    @app.errorhandler(HTTPException)\n''', '''    for module in (files, folders, thumbs, export, share, admin):\n        app.register_blueprint(module.bp)\n\n    @app.before_request\n    def authenticate_api():\n        \"\"\"Enforce section 1 for every /api endpoint, including unmatched routes.\"\"\"\n        path = request.path\n        if path != \"/api\" and not path.startswith(\"/api/\"):\n            return None\n        if request.endpoint == \"health\":\n            return None\n        ident = load_identity()\n        if ident is None:\n            return jsonify(error=\"unauthorized\"), 401\n        g.identity = ident\n        return None\n\n    @app.errorhandler(HTTPException)\n''')\np.write_text(s)\n\np = Path('docshare/routes/files.py')\ns = p.read_text"]
