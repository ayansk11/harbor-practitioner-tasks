[785.186211, "o", "\u001b[?2004h"]
[785.186236, "o", "> "]
[785.187265, "o", "for method, url in [('get', '/api/no-such-endpoint'), ('post', '/api/files'), ('patch', '/api/files/x'), ('options', '/api/files')]:\r\n"]
[785.187288, "o", "\u001b[?2004l\r"]
[785.18732, "o", "\u001b[?2004h"]
[785.187343, "o", "> "]
