[11.398944, "o", "(\"/api/files\", headers=h(riley)).status_code == 400\r\n    98\t    assert client.get(\"/api/admin/orgs\", headers=h(riley)).status_code == 200\r\n    99\t\r\n   100\t\r\n   101\tdef test_admin_rename_and_delete(env):\r\n   102\t    client, s = env\r\n   103\t    anna = user(s, \"anna@haldenprice.example\")\r\n   104\t    f1, f2 = org_files(s, anna[\"home_org_id\"])[:2]\r\n   105\t    r = client.patch(f\"/api/files/{f1['id']}\", json={\"name\": \"renamed.md\"}, headers=h(anna))\r\n   106\t    assert r.status_code == 200 and r.get_json()[\"name\"] == \"renamed.md\"\r\n   107\t    assert client.delete(f\"/api/files/{f2['id']}\", headers=h(anna)).status_code == 204\r\n   108\t    assert client.get(f\"/api/files/{f2['id']}\", headers=h(anna)).status_code in (403, 404)\r\n   109\t\r\n"]
