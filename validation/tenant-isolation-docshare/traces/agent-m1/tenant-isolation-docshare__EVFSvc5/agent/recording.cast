[26.11153, "i", "printf '%s\\n' '===== app.py ====='; cat docshare/app.py; printf '%s\\n' '===== auth.py ====='; cat docshare/auth.py; printf '%s\\n' '===== db.py ====='; cat docshare/db.py\n"]
[26.112999, "o", "printf '%s\\n' '===== app.py ====='; cat docshare/app.py; printf '%s\\n' '===== auth.py ====='; cat docshare/auth.py; printf '%s\\n' '===== db.py ====='; cat docshare/db.py\r\n\u001b[?2004l\r"]
[26.113066, "o", "===== app.py =====\r\n"]
[26.115017, "o", "\"\"\"Flask application factory.\"\"\"\r\nfrom flask import Flask, g, jsonify\r\nfrom werkzeug.exceptions import HTTPException\r\n\r\nfrom . import db\r\nfrom .auth import login_required\r\nfrom .routes import admin, export, files, folders, share, thumbs\r\n\r\n\r\ndef create_app(db_path):\r\n    app = Flask(__name__)\r\n    app.config[\"DB_PATH\"] = db_path\r\n    app.teardown_appcontext(db.close_db)\r\n    for module in (files, folders, thumbs, export, share, admin):\r\n        app.register_blueprint(module.bp)\r\n\r\n    @app.errorhandler(HTTPException)\r\n    def http_error(exc):\r\n        code = exc.description if exc.code == 400 and exc.description and \" \" not in exc.description else exc.name\r\n        return jsonify(error=code.lower().replace(\" \", \"_\")), exc.code\r\n\r\n    @app.get(\"/api/health\")\r\n    def health():\r\n        return jsonify(ok=True)\r\n\r\n    @app.get(\"/api/me\")\r\n    @login_required\r\n    def me():\r\n"]
[26.115063, "o", "        ident = g.identity\r\n        return jsonify(user={\"id\": ident.user_id, \"email\": ident.email, \"name\": ident.name,\r\n                             \"is_support\": ident.is_support},\r\n                       active_org_id=ident.org_id, role=ident.role,\r\n                       memberships=[{\"org_id\": o, \"role\": r} for o, r in sorted(ident.memberships.items())])\r\n\r\n    return app\r\n"]
[26.115303, "o", "===== auth.py =====\r\n"]
[26.116876, "o", "\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\r\nimport functools\r\nfrom dataclasses import dataclass, field\r\n\r\nfrom flask import g, jsonify, request\r\n\r\nfrom . import db\r\n\r\n\r\n@dataclass\r\nclass Identity:\r\n    user_id: str\r\n    email: str\r\n    name: str\r\n    is_support: bool\r\n    org_id: str | None          # the active organisation for this request\r\n    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n\r\n\r\ndef _bearer_token():\r\n    header = request.headers.get(\"Authorization\", \"\")\r\n    if not header.startswith(\"Bearer \"):\r\n        return None\r\n    return header[len(\"Bearer \"):].strip() or None\r\n\r\n\r\ndef load_identity():\r\n    token = _bearer_token()\r\n    if token is None:\r\n        return None\r\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n    if user is None:\r\n        return None\r\n    memberships = {r[\"org_id\"]: r[\"rol"]
[26.116919, "o", "e\"] for r in\r\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.\r\n    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\r\n    if user[\"is_support\"]:\r\n        role = \"support\"\r\n    else:\r\n        role = memberships.get(org_id, \"member\")\r\n    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\r\n                    org_id=org_id, role=role, memberships=memberships)\r\n\r\n\r\ndef login_required(view):\r\n    @functools.wraps(view)\r\n    def wrapper(*args, **kwargs):\r\n        ident = load_identity()\r\n        if ident is None:\r\n            return jsonify(error=\"unauthorized\"), 401\r\n        g.identity = ident\r\n        return view(*args, **kwargs)\r\n    return wrapper\r\n\r\n\r\ndef require_active_org():\r\n    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anythi"]
[26.116958, "o", "ng.\"\"\"\r\n    org_id = g.identity.org_id\r\n    if org_id is None:\r\n        from flask import abort\r\n        abort(400, description=\"x_org_id_required\")\r\n    return org_id\r\n"]
[26.117058, "o", "===== db.py =====\r\n"]
[26.119019, "o", "\"\"\"SQLite access. One connection per request (see app.py); rows come back as sqlite3.Row.\"\"\"\r\nimport sqlite3\r\n\r\nfrom flask import g\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS orgs (\r\n    id TEXT PRIMARY KEY,\r\n    name TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS users (\r\n    id TEXT PRIMARY KEY,\r\n    email TEXT NOT NULL UNIQUE,\r\n    name TEXT NOT NULL,\r\n    token TEXT NOT NULL UNIQUE,\r\n    home_org_id TEXT REFERENCES orgs(id),\r\n    is_support INTEGER NOT NULL DEFAULT 0\r\n);\r\nCREATE TABLE IF NOT EXISTS memberships (\r\n    user_id TEXT NOT NULL REFERENCES users(id),\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    role TEXT NOT NULL CHECK (role IN ('member', 'org_admin')),\r\n"]
[26.11904, "o", "    PRIMARY KEY (user_id, org_id)\r\n);\r\nCREATE TABLE IF NOT EXISTS folders (\r\n    id TEXT PRIMARY KEY,\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    name TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS files (\r\n    id TEXT PRIMARY KEY,\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    folder_id TEXT NOT NULL REFERENCES folders(id),\r\n"]
[26.119154, "o", "    name TEXT NOT NULL,\r\n    mime_type TEXT NOT NULL,\r\n    size INTEGER NOT NULL,\r\n"]
[26.11921, "o", "    content BLOB NOT NULL,\r\n    uploaded_by TEXT NOT NULL REFERENCES users(id),\r\n    created_at TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS shares (\r\n    token TEXT PRIMARY KEY,\r\n    file_id TEXT NOT NULL REFERENCES files(id),\r\n    created_by TEXT NOT NULL REFERENCES users(id),\r\n    created_at TEXT NOT NULL,\r\n    revoked_at TEXT\r\n);\r\nCREATE INDEX IF NOT EXISTS files_org ON files(org_id, name);\r\nCREATE INDEX IF NOT EXISTS files_folder ON files(folder_id, name);\r\nCREATE INDEX IF NOT EXISTS shares_file ON shares(file_id);\r\n\"\"\"\r\n\r\nFILE_COLUMNS = \"id, org_id, folder_id, name, mime_type, size, uploaded_by, created_at\"\r\n\r\n\r\ndef connect(path):\r\n    conn = sqlite3.connect(path, timeout=10)\r\n    conn.row_factory = sqlite3.Row\r\n    conn.execute(\"PRAGMA foreign_keys = ON\")\r\n    conn.execute(\"PRAGMA busy_timeout = 10000\")\r\n    return conn\r\n\r\n\r\ndef get_db():\r\n    if \"db\" not in g:\r\n        from flask import current_app\r\n        g.db = connect(current_app.config[\"DB_PATH\"])\r\n    return g.db\r\n\r\n\r\ndef close_db(_exc=None):\r\n"]
[26.119263, "o", "    conn = g.pop(\"db\", None)\r\n    if conn is not None:\r\n        conn.close()\r\n\r\n\r\ndef query_one(sql, params=()):\r\n    return get_db().execute(sql, params).fetchone()\r\n\r\n\r\ndef query_all(sql, params=()):\r\n    return get_db().execute(sql, params).fetchall()\r\n\r\n\r\ndef execute(sql, params=()):\r\n    conn = get_db()\r\n    cur = conn.execute(sql, params)\r\n    conn.commit()\r\n    return cur.rowcount\r\n\r\n\r\ndef file_json(row):\r\n    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"folder_id\": row[\"folder_id\"], \"name\": row[\"name\"],\r\n            \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"], \"uploaded_by\": row[\"uploaded_by\"],\r\n            \"created_at\": row[\"created_at\"]}\r\n\r\n\r\ndef folder_json(row):\r\n    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"name\": row[\"name\"]}\r\n"]
