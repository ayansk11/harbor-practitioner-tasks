[125.164027, "i", "cat > docshare/auth.py <<'PY'\n\"\"\"Who is calling: bearer token -> user, plus the validated active organisation.\"\"\"\nimport functools\nfrom dataclasses import dataclass, field\n\nfrom flask import abort, g, jsonify, request\n\nfrom . import db\n\n\n@dataclass\nclass Identity:\n    user_id: str\n    email: str\n    name: str\n    is_support: bool\n    org_id: str | None          # the active organisation for this request\n    role: str                   # \"member\", \"org_admin\" or \"support\"\n    memberships: dict = field(default_factory=dict)   # org_id -> role\n\n\ndef _bearer_token():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    return header[len(\"Bearer \"):].strip() or None\n\n\ndef load_identity():\n    token = _bearer_token()\n    if token is None:\n        return None\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\n    if user is None:\n        return None\n    memberships = {r[\"org_id\"]: r[\"role\"] "]
[125.164124, "i", "for r in\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\n\n    requested_org = request.headers.get(\"X-Org-Id\")\n    if user[\"is_support\"]:\n        # Support has no home organisation.  A header is optional, but if supplied it must name a real org.\n        if requested_org is None:\n            org_id = None\n        else:\n            if db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (requested_org,)) is None:\n                abort(403, description=\"active_org_forbidden\")\n            org_id = requested_org\n        role = \"support\"\n    else:\n        # Do not silently trust an org id merely because the route compares against it later.\n        org_id = requested_org if requested_org is not None else user[\"home_org_id\"]\n        role = memberships.get(org_id)\n        if org_id is None or role is None:\n            abort(403, description=\"active_org_forbidden\")\n\n    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\""]
[125.164149, "i", "is_support\"]),\n                    org_id=org_id, role=role, memberships=memberships)\n\n\ndef login_required(view):\n    @functools.wraps(view)\n    def wrapper(*args, **kwargs):\n        ident = load_identity()\n        if ident is None:\n            return jsonify(error=\"unauthorized\"), 401\n        g.identity = ident\n        return view(*args, **kwargs)\n    return wrapper\n\n\ndef require_active_org():\n    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\n    org_id = g.identity.org_id\n    if org_id is None:\n        abort(400, description=\"x_org_id_required\")\n    return org_id\n\n\ndef require_readable_file(row):\n    \"\"\"Apply the read rule to a file row already fetched by id.\"\"\"\n    ident = g.identity\n    if ident.is_support or row[\"org_id\"] == ident.org_id:\n        return row\n    # 404 avoids confirming that an inaccessible file id exists.\n    abort(404, description=\"not_found\")\nPY\n\ncat > docshare/routes/files.py <<'PY'\n\"\"\"File endpoints: list, metadata, download, rename, de"]
[125.164166, "i", "lete.\"\"\"\nfrom flask import Blueprint, Response, abort, g, jsonify, request\n\nfrom .. import db\nfrom ..auth import login_required, require_active_org, require_readable_file\n\nbp = Blueprint(\"files\", __name__)\n\n\ndef get_readable_file(file_id, *, include_content=False):\n    columns = db.FILE_COLUMNS + (\", content\" if include_content else \"\")\n    row = db.query_one(f\"SELECT {columns} FROM files WHERE id = ?\", (file_id,))\n    if row is None:\n        abort(404, description=\"not_found\")\n    return require_readable_file(row)\n\n\ndef get_file_or_404(file_id):\n    \"\"\"Compatibility helper used by file mutations; callers must still authorize the result.\"\"\"\n    row = db.query_one(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE id = ?\", (file_id,))\n    if row is None:\n        abort(404, description=\"not_found\")\n    return row\n\n\n@bp.get(\"/api/files\")\n@login_required\ndef list_files():\n    org_id = require_active_org()\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\n    return"]
[125.164182, "i", " jsonify(files=[db.file_json(r) for r in rows])\n\n\n@bp.get(\"/api/files/<file_id>\")\n@login_required\ndef get_file(file_id):\n    return jsonify(db.file_json(get_readable_file(file_id)))\n\n\n@bp.get(\"/api/files/<file_id>/download\")\n@login_required\ndef download(file_id):\n    row = get_readable_file(file_id, include_content=True)\n    return file_response(row)\n\n\ndef file_response(row):\n    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\n    return resp\n\n\n@bp.patch(\"/api/files/<file_id>\")\n@login_required\ndef rename(file_id):\n    if g.identity.role not in (\"member\", \"org_admin\"):\n        abort(403, description=\"forbidden\")\n    row = get_readable_file(file_id)\n    body = request.get_json(silent=True) or {}\n    name = body.get(\"name\")\n    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\n        abort(400, description=\"bad_name\")\n    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"i"]
[125.164198, "i", "d\"]))\n    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\n\n\n@bp.delete(\"/api/files/<file_id>\")\n@login_required\ndef delete(file_id):\n    if g.identity.role != \"org_admin\":\n        abort(403, description=\"forbidden\")\n    row = get_readable_file(file_id)\n    conn = db.get_db()\n    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\n    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\n    conn.commit()\n    return \"\", 204\nPY\n\ncat > docshare/routes/thumbs.py <<'PY'\n\"\"\"SVG previews for the file grid.\"\"\"\nimport html\n\nfrom flask import Blueprint, Response, abort\n\nfrom .. import db\nfrom ..auth import login_required, require_readable_file\n\nbp = Blueprint(\"thumbs\", __name__)\n\nTEXT_TYPES = (\"text/\", \"application/json\")\n\n\ndef render_thumb(name, mime_type, content):\n    lines = []\n    if mime_type.startswith(TEXT_TYPES):\n        text = bytes(content).decode(\"utf-8\", \"replace\")\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\n    parts = ['<svg xmlns=\"http://www.w"]
[125.164215, "o", "cat > docshare/auth.py <<'PY'\r\n\u001b[?2004l\r"]
[125.164232, "i", "3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\n             f\"<title>{html.escape(name)}</title>\",\n             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\n             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\n    for i, ln in enumerate(lines):\n        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\n    parts.append(\"</svg>\")\n    return \"\\n\".join(parts)\n\n\n@bp.get(\"/api/files/<file_id>/thumb\")\n@login_required\ndef thumb(file_id):\n    row = db.query_one(\"SELECT id, org_id, name, mime_type, content FROM files WHERE id = ?\", (file_id,))\n    if row is None:\n        abort(404, description=\"not_found\")\n    require_readable_file(row)\n    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\n    return Response(svg, mimetype=\"image/svg+xml\")\nPY\n"]
