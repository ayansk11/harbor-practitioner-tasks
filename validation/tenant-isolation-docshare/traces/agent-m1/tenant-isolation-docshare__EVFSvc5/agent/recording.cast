[26.522624, "i", "printf '%s\\n' '===== routes/files.py ====='; cat docshare/routes/files.py; printf '%s\\n' '===== routes/folders.py ====='; cat docshare/routes/folders.py\n"]
[26.523389, "o", "printf '%s\\n' '===== routes/files.py ====='; cat docshare/routes/files.py; printf '%s\\n' '===== routes/folders.py ====='; cat docshare/routes/folders.py\r\n\u001b[?2004l\r"]
[26.523454, "o", "===== routes/files.py =====\r\n"]
[26.524715, "o", "\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\r\nfrom flask import Blueprint, Response, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_active_org\r\n\r\nbp = Blueprint(\"files\", __name__)\r\n\r\n\r\ndef get_file_or_404(file_id):\r\n    row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404)\r\n    return row\r\n\r\n\r\n@bp.get(\"/api/files\")\r\n@login_required\r\ndef list_files():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(files=[db.file_json(r) for r in rows])\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>\")\r\n@login_required\r\ndef get_file(file_id):\r\n    return jsonify(db.file_json(get_file_or_404(file_id)))\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/download\")\r\n@login_required\r\ndef download(file_id):\r\n    row = get_file_or_404(file_id)\r\n    return file_response(row)\r\n\r\n\r\ndef file_response(row):\r\n    "]
[26.524758, "o", "resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\r\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\r\n    return resp\r\n\r\n\r\n@bp.patch(\"/api/files/<file_id>\")\r\n@login_required\r\ndef rename(file_id):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(403)\r\n    row = get_file_or_404(file_id)\r\n    body = request.get_json(silent=True) or {}\r\n    name = body.get(\"name\")\r\n    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\r\n        abort(400, description=\"bad_name\")\r\n    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\r\n\r\n\r\n@bp.delete(\"/api/files/<file_id>\")\r\n@login_required\r\ndef delete(file_id):\r\n    row = get_file_or_404(file_id)\r\n    conn = db.get_db()\r\n    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\r\n    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\r\n    conn.commit()\r\n    return \"\", 204\r\n"]
[26.52492, "o", "===== routes/folders.py =====\r\n"]
[26.525957, "o", "\"\"\"Folder endpoints: the folders of the active organisation and their files.\"\"\"\r\nfrom flask import Blueprint, abort, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_active_org\r\n\r\nbp = Blueprint(\"folders\", __name__)\r\n\r\n\r\n@bp.get(\"/api/folders\")\r\n@login_required\r\ndef list_folders():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(\"SELECT id, org_id, name FROM folders WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(folders=[db.folder_json(r) for r in rows])\r\n\r\n\r\n@bp.get(\"/api/folders/<folder_id>/files\")\r\n@login_required\r\n"]
[26.525995, "o", "def folder_files(folder_id):\r\n    org_id = require_active_org()\r\n    folder = db.query_one(\"SELECT id, org_id, name FROM folders WHERE id = ? AND org_id = ?\", (folder_id, org_id))\r\n    if folder is None:\r\n        abort(404)\r\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE folder_id = ? AND org_id = ? ORDER BY name\",\r\n                        (folder_id, org_id))\r\n    return jsonify(folder=db.folder_json(folder), files=[db.file_json(r) for r in rows])\r\n"]
[26.526202, "o", "\u001b[?2004h"]
[26.526243, "o", "root@0275029c-4ae8-4559-97b7-b32bc7ab9898:/app# "]
