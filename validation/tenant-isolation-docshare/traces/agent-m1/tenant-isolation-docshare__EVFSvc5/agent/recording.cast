[186.28353, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('docshare/auth.py')\ns = p.read_text()\ns = s.replace('''        org_id = requested_org if requested_org is not None else user[\"home_org_id\"]\n        role = memberships.get(org_id)\n        if org_id is None or role is None:\n            abort(403, description=\"active_org_forbidden\")\n''', '''        org_id = requested_org if requested_org is not None else user[\"home_org_id\"]\n        role = memberships.get(org_id)\n        if (org_id is None or role is None or\n                db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,)) is None):\n            abort(403, description=\"active_org_forbidden\")\n''')\np.write_text(s)\nPY\npython -m compileall -q docshare\ngit diff -- docshare 2>/dev/null || true\n"]
