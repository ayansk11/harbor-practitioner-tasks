[186.695182, "i", "cat > /tmp/policy_check.py <<'PY'\nimport sqlite3\n\nfrom docshare import seed\nfrom docshare.app import create_app\n\npath = '/tmp/docshare-policy.db'\nsummary = seed.build(path, seed.DEV_SPEC)\napp = create_app(path)\napp.config['TESTING'] = True\nc = app.test_client()\nusers = {u['email']: u for u in summary['users']}\norgs = {o['name']: o['id'] for o in summary['orgs']}\nfiles = summary['files']\n\ndef u(email): return users[email]\ndef h(email, org=None):\n    out = {'Authorization': 'Bearer ' + users[email]['token']}\n    if org is not None: out['X-Org-Id'] = org\n    return out\n\ndef ofile(org, idx=0):\n    return next(f for f in files if f['org_id'] == orgs[org]) if idx == 0 else [f for f in files if f['org_id'] == orgs[org]][idx]\n\ndef denied_body(r, marker=None):\n    assert 400 <= r.status_code < 500, (r.status, r.data[:100])\n    assert not marker or marker.encode() not in r.data\n\nben = 'ben@haldenprice.example'\nanna = 'anna@haldenprice.example'\ngrace = 'grace@okafor-consulting.example'\nriley = 'riley@support.docshare.ex"]
[186.695271, "i", "ample'\ncross = ofile('Marlow Community Clinic')\nown = ofile('Halden & Price LLP', 1)\nmark = cross['name']\n\n# No/unknown token, health exception, public share exceptions.\nassert c.get('/api/health').status_code == 200\nfor url in ['/api/files', '/api/folders', '/api/me', '/api/admin/orgs']:\n    denied_body(c.get(url), mark)\n    denied_body(c.get(url, headers={'Authorization': 'Bearer nope'}), mark)\n\n# The reported vulnerability and all individual read paths.\nfor suffix in ['', '/download', '/thumb']:\n    r = c.get('/api/files/' + cross['id'] + suffix, headers=h(ben))\n    denied_body(r, mark)\n    assert r.status_code == 404\n\n# Invalid and cross-active organisations are refused on all request types.\nfor email in [ben, grace, riley]:\n    for url in ['/api/files', '/api/folders', '/api/me', '/api/admin/orgs']:\n        r = c.get(url, headers=h(email, 'does-not-exist'))\n        denied_body(r, mark)\n        assert r.status_code == 403\nr = c.get('/api/files/' + cross['id'] + '/download', headers=h(ben, orgs['Marlow Com"]
[186.695306, "i", "munity Clinic']))\nassert r.status_code == 404 and mark.encode() not in r.data\n\n# Valid switching (Grace: home Marlow member, second Tessaract admin) works.\ntess_file = ofile('Tessaract Robotics')\nfor suffix in ['', '/download', '/thumb']:\n    r = c.get('/api/files/' + tess_file['id'] + suffix, headers=h(grace, orgs['Tessaract Robotics']))\n    assert r.status_code == 200, (suffix, r.status)\n    if suffix == '/download': assert bytes(cross['content']) not in r.data\nme = c.get('/api/me', headers=h(grace, orgs['Tessaract Robotics'])).get_json()\nassert me['active_org_id'] == orgs['Tessaract Robotics'] and me['role'] == 'org_admin'\nassert c.get('/api/files', headers=h(grace, orgs['Tessaract Robotics'])).status_code == 200\nassert c.get('/api/folders', headers=h(grace, orgs['Tessaract Robotics'])).status_code == 200\n\n# Support can read anything even with no active org, but cannot list or mutate without active-org/membership.\nfor suffix in ['', '/download', '/thumb']:\n    r = c.get('/api/files/' + cross['id'] + suffix"]
[186.695328, "i", ", headers=h(riley))\n    assert r.status_code == 200\n    if suffix == '/download': assert cross['content'] in r.data\nassert c.get('/api/files', headers=h(riley)).status_code == 400\nassert c.get('/api/folders', headers=h(riley)).status_code == 400\nassert c.get('/api/admin/orgs', headers=h(riley)).status_code == 200\nr = c.patch('/api/files/' + cross['id'], json={'name': 'support-name.md'}, headers=h(riley))\nassert r.status_code == 403 and mark.encode() not in r.data\nr = c.delete('/api/files/' + cross['id'], headers=h(riley))\nassert r.status_code == 403 and mark.encode() not in r.data\nr = c.post('/api/files/' + cross['id'] + '/shares', headers=h(riley))\nassert r.status_code == 403 and mark.encode() not in r.data\n\n# Cross-org export must be all-or-nothing, with no partial content or filenames.\nr = c.post('/api/export', json={'file_ids': [own['id'], cross['id']]}, headers=h(ben))\ndenied_body(r, mark)\nassert r.status_code == 404\nassert own['name'].encode() not in r.data\nr = c.post('/api/export', json={'file_ids': [c"]
[186.695346, "i", "ross['id']]}, headers=h(riley))\nassert r.status_code == 200 and len(r.get_json()['files']) == 1\n\n# Members cannot delete; support and members cannot share/revoke outside active org.\nassert c.delete('/api/files/' + own['id'], headers=h(ben)).status_code == 403\nr = c.post('/api/files/' + cross['id'] + '/shares', headers=h(ben))\nassert r.status_code == 404 and mark.encode() not in r.data\nr = c.delete('/api/shares/definitely-unknown', headers=h(ben, 'does-not-exist'))\nassert r.status_code == 403\n\n# Role-specific mutations in the active org still work; then restore.\nr = c.patch('/api/files/' + own['id'], json={'name': 'policy-ok.md'}, headers=h(anna))\nassert r.status_code == 200 and r.get_json()['name'] == 'policy-ok.md'\nr = c.patch('/api/files/' + own['id'], json={'name': 'bad/name'}, headers=h(anna))\nassert r.status_code == 400\nassert c.patch('/api/files/' + own['id'], json={'name': 'policy-ok.md'}, headers=h(anna)).status_code == 200\nr = c.post('/api/files/' + own['id'] + '/shares', headers=h(ben))\nassert r.sta"]
[186.695361, "i", "tus_code == 201\nlink = r.get_json()['token']\nassert c.get('/s/' + link).status_code == 200\nassert c.delete('/api/shares/' + link, headers=h(ben)).status_code == 204\nassert c.get('/s/' + link).status_code == 404\n\n# Confirm refused requests (including invalid org and bad name) changed no table counts/content.\nconn = sqlite3.connect(path)\nassert conn.execute(\"SELECT name FROM files WHERE id=?\", (own['id'],)).fetchone()[0] == 'policy-ok.md'\nassert conn.execute('SELECT COUNT(*) FROM shares').fetchone()[0] == len(summary['shares'])\nconn.close()\nprint('policy matrix passed')\nPY\npython /tmp/policy_check.py\n"]
