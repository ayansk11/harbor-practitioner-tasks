[45.084424, "o", "    38\tdef file_response(row):\r\n    39\t    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\r\n    40\t    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\r\n    41\t    return resp\r\n    42\t\r\n    43\t\r\n    44\t@bp.patch(\"/api/files/<file_id>\")\r\n    45\t@login_required\r\n    46\tdef rename(file_id):\r\n    47\t    if g.identity.role not in (\"member\", \"org_admin\"):\r\n    48\t        abort(403)\r\n    49\t    row = get_file_or_404(file_id)\r\n    50\t    body = request.get_json(silent=True) or {}\r\n    51\t    name = body.get(\"name\")\r\n    52\t    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\r\n    53\t        abort(400, description=\"bad_name\")\r\n    54\t    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n    55\t    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\r\n    56\t\r\n    57\t\r\n    58\t@bp.delete(\"/api/files/<file_id>\")\r\n    59\t@login_required\r\n    60\tdef delete(file_id):\r\n    61\t    row = get_file_or_404(file_id)\r\n    62\t    con"]
