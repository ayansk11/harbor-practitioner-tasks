[248.503582, "o", "    42\t# The reported vulnerability and all individual read paths.\r\n    43\tfor suffix in ['', '/download', '/thumb']:\r\n    44\t    r = c.get('/api/files/' + cross['id'] + suffix, headers=h(ben))\r\n    45\t    denied_body(r, mark)\r\n    46\t    assert r.status_code == 404\r\n    47\t\r\n    48\t# Invalid and cross-active organisations are refused on all request types.\r\n    49\tfor email in [ben, grace, riley]:\r\n    50\t    for url in ['/api/files', '/api/folders', '/api/me', '/api/admin/orgs']:\r\n    51\t        r = c.get(url, headers=h(email, 'does-not-exist'))\r\n"]
[248.503633, "o", "    52\t        denied_body(r, mark)\r\n    53\t        assert r.status_code == 403\r\n    54\tr = c.get('/api/files/' + cross['id'] + '/download', headers=h(ben, orgs['Marlow Community Clinic']))\r\n    55\tassert r.status_code == 404 and mark.encode() not in r.data\r\n    56\t\r\n    57\t# Valid switching (Grace: home Marlow member, second Tessaract admin) works.\r\n    58\ttess_file = ofile('Tessaract Robotics')\r\n    59\tfor suffix in ['', '/download', '/thumb']:\r\n    60\t    r = c.get('/api/files/' + tess_file['id'] + suffix, headers=h(grace, orgs['Tessaract Robotics']))\r\n"]
[248.503674, "o", "    61\t    assert r.status_code == 200, (suffix, r.status)\r\n    62\t    if suffix == '/download': assert bytes(cross['content']) not in r.data\r\n    63\tme = c.get('/api/me', headers=h(grace, orgs['Tessaract Robotics'])).get_json()\r\n    64\tassert me['active_org_id'] == orgs['Tessaract Robotics'] and me['role'] == 'org_admin'\r\n"]
[248.503843, "o", "--- auth.py ---\r\n"]
[248.504803, "o", "     1\t\"\"\"Who is calling: bearer token -> user, plus the validated active organisation.\"\"\"\r\n     2\timport functools\r\n     3\tfrom dataclasses import dataclass, field\r\n     4\t\r\n     5\tfrom flask import abort, g, jsonify, request\r\n"]
[248.504857, "o", "     6\t\r\n     7\tfrom . import db\r\n     8\t\r\n     9\t\r\n    10\t@dataclass\r\n    11\tclass Identity:\r\n    12\t    user_id: str\r\n    13\t    email: str\r\n    14\t    name: str\r\n    15\t    is_support: bool\r\n    16\t    org_id: str | None          # the active organisation for this request\r\n    17\t    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n    18\t    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n    19\t\r\n    20\t\r\n    21\tdef _bearer_token():\r\n    22\t    header = request.headers.get(\"Authorization\", \"\")\r\n    23\t    if not header.startswith(\"Bearer \"):\r\n    24\t        return None\r\n"]
[248.504883, "o", "    25\t    return header[len(\"Bearer \"):].strip() or None\r\n    26\t\r\n    27\t\r\n    28\tdef load_identity():\r\n    29\t    token = _bearer_token()\r\n    30\t    if token is None:\r\n    31\t        return None\r\n    32\t    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n    33\t    if user is None:\r\n"]
[248.504907, "o", "    34\t        return None\r\n    35\t    memberships = {r[\"org_id\"]: r[\"role\"] for r in\r\n    36\t                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    37\t\r\n    38\t    requested_org = request.headers.get(\"X-Org-Id\")\r\n    39\t    if user[\"is_support\"]:\r\n    40\t        # Support has no home organisation.  A header is optional, but if supplied it must name a real org.\r\n    41\t        if requested_org is None:\r\n"]
[248.504928, "o", "    42\t            org_id = None\r\n    43\t        else:\r\n    44\t            if db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (requested_org,)) is None:\r\n    45\t                abort(403, description=\"active_org_forbidden\")\r\n    46\t            org_id = requested_org\r\n    47\t        role = \"support\"\r\n    48"]
[248.504949, "o", "\t    else:\r\n    49\t        # Do not silently trust an org id merely because the route compares against it later.\r\n    50\t        org_id = requested_org if requested_org is not None else user[\"home_org_id\"]\r\n    51\t        role = memberships.get(org_id)\r\n    52\t        if (org_id is None or role is None or\r\n    53\t                db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,)) is None):\r\n    54\t            abort(403, description=\"active_org_forbidden\")\r\n"]
[248.50497, "o", "    55\t\r\n    56\t    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\r\n    57\t                    org_id=org_id, role=role, memberships=memberships)\r\n    58\t\r\n    59\t\r\n"]
