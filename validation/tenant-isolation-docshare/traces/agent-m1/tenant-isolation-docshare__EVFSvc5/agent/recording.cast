[537.951895, "o", "\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\r\nfrom flask import Blueprint, Response, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_active_org, require_readable_file\r\n\r\nbp = Blueprint(\"files\", __name__)\r\n\r\n\r\ndef get_readable_file(file_id, *, include_content=False):\r\n    columns = db.FILE_COLUMNS + (\", content\" if include_content else \"\")\r\n    row = db.query_one(f\"SELECT {columns} FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404, description=\"not_found\")\r\n    return require_readable_file(row)\r\n\r\n\r\ndef get_file_or_404(file_id):\r\n    \"\"\"Compatibility helper used by file mutations; callers must still authorize the result.\"\"\"\r\n    row = db.query_one(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404, description=\"not_found\")\r\n    return row\r\n\r\n\r\n@bp.get(\"/api/files\")\r\n@login_required\r\ndef list_files():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(f\"SELECT"]
[537.951969, "o", " {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(files=[db.file_json(r) for r in rows])\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>\")\r\n@login_required\r\ndef get_file(file_id):\r\n    return jsonify(db.file_json(get_readable_file(file_id)))\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/download\")\r\n@login_required\r\ndef download(file_id):\r\n    row = get_readable_file(file_id, include_content=True)\r\n    return file_response(row)\r\n\r\n\r\ndef file_response(row):\r\n    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\r\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\r\n    return resp\r\n\r\n\r\n@bp.patch(\"/api/files/<file_id>\")\r\n@login_required\r\ndef rename(file_id):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(403, description=\"forbidden\")\r\n    row = get_readable_file(file_id)\r\n    body = request.get_json(silent=True) or {}\r\n    name = body.get(\"name\")\r\n    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name"]
[537.952053, "o", ":\r\n        abort(400, description=\"bad_name\")\r\n    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\r\n\r\n\r\n@bp.delete(\"/api/files/<file_id>\")\r\n@login_required\r\ndef delete(file_id):\r\n    if g.identity.role != \"org_admin\":\r\n        abort(403, description=\"forbidden\")\r\n    row = get_readable_file(file_id)\r\n    conn = db.get_db()\r\n    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\r\n    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\r\n    conn.commit()\r\n    return \"\", 204\r\n"]
[537.952122, "o", "--- routes/export.py ---\r\n"]
[537.952989, "o", "\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\nimport base64\r\n\r\nfrom flask import Blueprint, abort, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_readable_file\r\n\r\nbp = Blueprint(\"export\", __name__)\r\n\r\nMAX_IDS = 50\r\n\r\n\r\n@bp.post(\"/api/export\")\r\n@login_required\r\ndef export():\r\n    body = request.get_json(silent=True) or {}\r\n    ids = body.get(\"file_ids\")\r\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n        abort(400, description=\"bad_file_ids\")\r\n\r\n    placeholders = \",\".join(\"?\" for _ in ids)\r\n    rows = db.query_all(f\"SELECT id, org_id, name, mime_type, size, content FROM files WHERE id IN ({placeholders})\", ids)\r\n    by_id = {row[\"id\"]: row for row in rows}\r\n\r\n    # Validate every selection before serialising any file.\r\n    for file_id in ids:\r\n        row = by_id.get(file_id)\r\n        if row is None:\r\n            abort(404, description=\"not_found\")\r\n      "]
[537.953049, "o", "  require_readable_file(row)\r\n\r\n    out = []\r\n    for file_id in ids:\r\n        row = by_id[file_id]\r\n        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n    return jsonify(files=out)\r\n"]
[537.953148, "o", "--- routes/share.py ---\r\n"]
[537.954103, "o", "\"\"\"Share links: member/admin management and unauthenticated link downloads.\"\"\"\r\nimport secrets\r\nfrom datetime import datetime, timezone\r\n\r\nfrom flask import Blueprint, abort, g, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\nfrom .files import file_response\r\n\r\nbp = Blueprint(\"share\", __name__)\r\n\r\n\r\ndef now_iso():\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\n@bp.post(\"/api/files/<file_id>/shares\")\r\n@login_required\r\ndef create_share(file_id):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(403, description=\"forbidden\")\r\n    row = db.query_one(\"SELECT id, org_id FROM files WHERE id = ?\", (file_id,))\r\n    if row is None or row[\"org_id\"] != g.identity.org_id:\r\n        abort(404, description=\"not_found\")\r\n\r\n    # The primary key makes this loop inexpensive in practice; it also handles a rare collision cleanly.\r\n    while True:\r\n        token = secrets.token_urlsafe(18)\r\n        if db.query_one(\"SELECT 1 FROM shares WHERE token = ?\", (token,)) is"]
[537.954126, "o", " None:\r\n            break\r\n    created = now_iso()\r\n    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\r\n               (token, row[\"id\"], g.identity.user_id, created))\r\n    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\r\n\r\n\r\n@bp.delete(\"/api/shares/<token>\")\r\n@login_required\r\ndef revoke_share(token):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(404, description=\"not_found\")\r\n    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\r\n                       (token,))\r\n    if row is None or row[\"org_id\"] != g.identity.org_id:\r\n        abort(404, description=\"not_found\")\r\n    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n    return \"\", 204\r\n\r\n\r\n@bp.get(\"/s/<token>\")\r\ndef public_download(token):\r\n    row = db.query_one(\"SELECT f.name, f.mime_type, f.content FROM shares s JOIN files "]
[537.954233, "o", "f ON f.id = s.file_id \"\r\n                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (token,))\r\n    if row is None:\r\n        abort(404, description=\"not_found\")\r\n    return file_response(row)\r\n"]
[537.954275, "o", "--- routes/thumbs.py ---\r\n"]
[537.955172, "o", "\"\"\"SVG previews for the file grid.\"\"\"\r\nimport html\r\n\r\nfrom flask import Blueprint, Response, abort\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_readable_file\r\n\r\nbp = Blueprint(\"thumbs\", __name__)\r\n\r\nTEXT_TYPES = (\"text/\", \"application/json\")\r\n\r\n\r\ndef render_thumb(name, mime_type, content):\r\n    lines = []\r\n    if mime_type.startswith(TEXT_TYPES):\r\n        text = bytes(content).decode(\"utf-8\", \"replace\")\r\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\r\n    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\r\n             f\"<title>{html.escape(name)}</title>\",\r\n             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n    for i, ln in enumerate(lines):\r\n        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\r\n    parts.append(\"</svg>\")"]
[537.955192, "o", "\r\n    return \"\\n\".join(parts)\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/thumb\")\r\n@login_required\r\ndef thumb(file_id):\r\n    row = db.query_one(\"SELECT id, org_id, name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404, description=\"not_found\")\r\n    require_readable_file(row)\r\n    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n    return Response(svg, mimetype=\"image/svg+xml\")\r\n"]
