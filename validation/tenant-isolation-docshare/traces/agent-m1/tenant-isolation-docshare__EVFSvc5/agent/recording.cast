[10.913015, "o", "     7\tbp = Blueprint(\"admin\", __name__)\r\n     8\t\r\n"]
[10.913057, "o", "     9\t\r\n    10\t@bp.get(\"/api/admin/orgs\")\r\n    11\t@login_required\r\n    12\tdef orgs():\r\n    13\t    if not g.identity.is_support:\r\n    14\t        abort(403)\r\n    15\t    rows = db.query_all(\"SELECT o.id, o.name, (SELECT COUNT(*) FROM files f WHERE f.org_id = o.id) AS file_count \"\r\n    16\t                        \"FROM orgs o ORDER BY o.name\")\r\n    17\t    return jsonify(orgs=[{\"id\": r[\"id\"], \"name\": r[\"name\"], \"file_count\": r[\"file_count\"]} for r in rows])\r\n"]
