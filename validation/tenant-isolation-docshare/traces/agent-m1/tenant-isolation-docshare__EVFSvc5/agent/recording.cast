[857.966192, "i", "rm -f /tmp/docshare-policy.db /tmp/docshare-policy.db-wal /tmp/docshare-policy.db-shm\nPYTHONPATH=/app python - <<'PY'\nimport sqlite3\nfrom docshare import seed\nfrom docshare.app import create_app\n\npath = '/tmp/docshare-policy.db'\ns = seed.build(path, seed.DEV_SPEC)\napp = create_app(path)\napp.config['TESTING'] = True\nc = app.test_client()\n\nassert c.get('/api/health').status_code == 200\nassert c.get('/api/health', headers={'Authorization': 'Bearer bad'}).status_code == 200\nfor method in ('post', 'delete'):\n    r = getattr(c, method)('/api/health')\n    assert r.status_code == 401, (method, r.status_code)\n\nben = next(u for u in s['users'] if u['email'] == 'ben@haldenprice.example')\nanna = next(u for u in s['users'] if u['email'] == 'anna@haldenprice.example')\nben_h = {'Authorization': 'Bearer ' + ben['token']}\nassert c.get('/api/files', headers={**ben_h, 'X-Org-Id': ''}).status_code == 403\nassert c.post('/api/export', json={'file_ids': ['x']}, headers={**ben_h, 'X-Org-Id': ''}).status_code == 403\n\nfile_id = next(f"]
[857.966318, "i", "['id'] for f in s['files'] if f['org_id'] == ben['home_org_id'])\nheaders = {'Authorization': 'Bearer ' + anna['token']}\nassert c.patch('/api/files/' + file_id, json=['bad'], headers=headers).status_code == 400\nassert c.patch('/api/files/' + file_id, data='null', content_type='application/json', headers=headers).status_code == 400\nassert c.post('/api/export', json=['bad'], headers=headers).status_code == 400\n\nconn = sqlite3.connect(path)\nassert conn.execute('SELECT COUNT(*) FROM files').fetchone()[0] == len(s['files'])\nassert conn.execute('SELECT COUNT(*) FROM shares').fetchone()[0] == len(s['shares'])\nprint('strict auth and malformed-body checks passed')\nPY\n"]
