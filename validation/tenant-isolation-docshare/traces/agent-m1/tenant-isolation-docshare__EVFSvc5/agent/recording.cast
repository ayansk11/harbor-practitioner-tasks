[10.500241, "o", "     1\t# docshare API\r\n     2\t\r\n     3\tdocshare serves the documents that the ingest worker stores in its SQLite database (uploads go through the ingest\r\n     4\tworker, not this API). Who may call what is in `PERMISSIONS.md`.\r\n     5\t\r\n     6\t## Running it\r\n     7\t```\r\n     8\tpython -m docshare.serve --db <path to the SQLite file> --port <port>\r\n     9\t```\r\n    10\tThe service listens on 127.0.0.1, uses the database file given by `--db` (it must exist; the service never creates\r\n    11\tone) and keeps all its state there. `python -m docshare.seed --out <path>` builds a fresh development database.\r\n    12\t\r\n    13\t## Conventions\r\n    14\t- Logged-in requests send `Authorization: Bearer <token>`; `X-Org-Id: <organisation id>` chooses the active\r\n    15\t  organisation (`PERMISSIONS.md` section 2).\r\n    16\t- Request and response bodies are JSON unless stated. Errors are JSON `{\"error\": \"<code>\"}`.\r\n    17\t- Ids are UUID strings. Times are ISO 8601 strings in UTC, for example `2026-09-14T10:22:05Z`.\r\n"]
[10.500319, "o", "    18\t\r\n    19\t## Objects\r\n    20\t**File**: `id`, `org_id`, `folder_id`, `name`, `mime_type`, `size` (bytes, integer), `uploaded_by` (user id),\r\n    21\t`created_at`.\r\n    22\t\r\n    23\t**Folder**: `id`, `org_id`, `name`.\r\n    24\t\r\n    25\t## Endpoints\r\n    26\t| Method and path | Success | Body of a successful response |\r\n    27\t|---|---|---|\r\n    28\t| `GET /api/health` | 200 | `{\"ok\": true}`; no login |\r\n    29\t| `GET /api/me` | 200 | `{\"user\": {\"id\", \"email\", \"name\", \"is_support\"}, \"active_org_id\", \"role\", \"memberships\": [{\"org_id\", \"role\"}]}`; `active_org_id` is `null` and `role` is `\"support\"` for support without `X-Org-Id` |\r\n    30\t| `GET /api/files` | 200 | `{\"files\": [File, ...]}`: the files of the active organisation, sorted by name |\r\n    31\t| `GET /api/folders` | 200 | `{\"folders\": [Folder, ...]}`: the folders of the active organisation, sorted by name |\r\n    32\t| `GET /api/folders/<folder_id>/files` | 200 | `{\"folder\": Folder, \"files\": [File, ...]}`, files sorted by name |\r\n    33\t| `GET /api/files/<"]
[10.500365, "o", "file_id>` | 200 | File |\r\n    34\t| `GET /api/files/<file_id>/download` | 200 | the file's bytes, with its `mime_type` as Content-Type and `Content-Disposition: attachment; filename=\"<name>\"` |\r\n    35\t| `GET /api/files/<file_id>/thumb` | 200 | an `image/svg+xml` preview: the file name and the first lines of a text file |\r\n    36\t| `PATCH /api/files/<file_id>` with `{\"name\": \"<new name>\"}` | 200 | the updated File; the name must be 1 to 200 characters without `/`, else `400` |\r\n    37\t| `DELETE /api/files/<file_id>` | 204 | empty; the file and its share links are removed |\r\n    38\t| `POST /api/files/<file_id>/shares` | 201 | `{\"token\", \"url\", \"file_id\", \"created_at\"}`; `url` is `/s/<token>` |\r\n    39\t| `DELETE /api/shares/<token>` | 204 | empty; the link stops working |\r\n    40\t| `GET /s/<token>` | 200 | the file's bytes, like download; no login |\r\n    41\t| `POST /api/export` with `{\"file_ids\": [<id>, ...]}` (1 to 50 ids) | 200 | `{\"files\": [{\"id\", \"name\", \"mime_type\", \"size\", \"content_b64\"}, ...]}` in request"]
[10.500404, "o", " order; `content_b64` is the file's bytes in standard base64 |\r\n    42\t| `GET /api/admin/orgs` | 200 | `{\"orgs\": [{\"id\", \"name\", \"file_count\"}, ...]}` sorted by name |\r\n    43\t\r\n    44\tMalformed bodies (for example a missing `name`, or `file_ids` that is not a list of 1 to 50 strings) get `400`.\r\n    45\t\r\n    46\t## Database\r\n    47\tThe schema is in `docshare/db.py` (`SCHEMA`). Tables: `orgs`, `users`, `memberships`, `folders`, `files` (contents\r\n    48\tare stored in `files.content`), `shares` (`revoked_at` is set when a link is revoked).\r\n"]
[10.500593, "o", "\u001b[?2004hroot@0275029c-4ae8-4559-97b7-b32bc7ab9898:/app# "]
[10.898682, "i", "for f in /app/docshare/app.py /app/docshare/auth.py /app/docshare/db.py /app/docshare/serve.py /app/docshare/routes/__init__.py /app/docshare/routes/files.py /app/docshare/routes/folders.py /app/docshare/routes/thumbs.py /app/docshare/routes/export.py /app/docshare/routes/share.py /app/docshare/routes/admin.py; do printf '\\n===== %s =====\\n' \"$f\"; nl -ba \"$f\"; done\n"]
[10.900107, "o", "for f in /app/docshare/app.py /app/docshare/auth.py /app/docshare/db.py /app/docshare/serve.py /app/docshare/routes/__init__.py /app/docshare/routes/files.py /app/docshare/routes/folders.py /app/docshare/routes/thumbs.py /app/docshare/routes/export.py /app/docshare/routes/share.py /app/docshare/routes/admin.py; do printf '\\n===== %s =====\\n' \"$f\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[10.900215, "o", "\r\n===== /app/docshare/app.py =====\r\n"]
[10.901334, "o", "     1\t\"\"\"Flask application factory.\"\"\"\r\n     2\tfrom flask import Flask, g, jsonify\r\n     3\tfrom werkzeug.exceptions import HTTPException\r\n     4\t\r\n"]
[10.901373, "o", "     5\tfrom . import db\r\n     6\tfrom .auth import login_required\r\n     7\tfrom .routes import admin, export, files, folders, share, thumbs\r\n     8\t\r\n     9\t\r\n"]
[10.901438, "o", "    10\tdef create_app(db_path):\r\n    11\t    app = Flask(__name__)\r\n    12\t    app.config[\"DB_PATH\"] = db_path\r\n    13\t    app.teardown_appcontext(db.close_db)\r\n    14\t    for module in (files, folders, thumbs, export, share, admin):\r\n    15\t        app.register_blueprint(module.bp)\r\n    16\t\r\n    17\t    @app.errorhandler(HTTPException)\r\n    18\t    def http_error(exc):\r\n    19\t        code = exc.description if exc.code == 400 and exc.description and \" \" not in exc.description else exc.name\r\n    20\t        return jsonify(error=code.lower().replace(\" \", \"_\")), exc.code\r\n    21\t\r\n    22\t    @app.get(\"/api/health\")\r\n"]
[10.901482, "o", "    23\t    def health():\r\n    24\t        return jsonify(ok=True)\r\n    25\t\r\n    26\t    @app.get(\"/api/me\")\r\n    27\t    @login_required\r\n    28\t    def me():\r\n    29\t        ident = g.identity\r\n    30\t        return jsonify(user={\"id\": ident.user_id, \"email\": ident.email, \"name\": ident.name,\r\n    31\t                             \"is_support\": ident.is_support},\r\n    32\t                       active_org_id=ident.org_id, role=ident.role,\r\n    33\t                       memberships=[{\"org_id\": o, \"role\": r} for o, r in sorted(ident.memberships.items())])\r\n    34\t\r\n    35\t    return app\r\n"]
[10.901613, "o", "\r\n===== /app/docshare/auth.py =====\r\n"]
[10.902539, "o", "     1\t\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\r\n     2\timport functools\r\n     3\tfrom dataclasses import dataclass, field\r\n"]
[10.902584, "o", "     4\t\r\n     5\tfrom flask import g, jsonify, request\r\n     6\t\r\n     7\tfrom . import db\r\n     8\t\r\n     9\t\r\n    10\t@dataclass\r\n    11\tclass Identity:\r\n"]
[10.902625, "o", "    12\t    user_id: str\r\n    13\t    email: str\r\n    14\t    name: str\r\n    15\t    is_support: bool\r\n    16\t    org_id: str | None          # the active organisation for this request\r\n    17\t    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n    18\t    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n    19\t\r\n    20\t\r\n    21\tdef _bearer_token():\r\n    22\t    header = request.headers.get(\"Authorization\", \"\")\r\n    23\t    if not header.startswith(\"Bearer \"):\r\n    24\t        return None\r\n    25\t    return header[len(\"Bearer \"):].strip() or None\r\n"]
[10.902666, "o", "    26\t\r\n    27\t\r\n    28\tdef load_identity():\r\n    29\t    token = _bearer_token()\r\n    30\t    if token is None:\r\n    31\t        return None\r\n    32\t    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n    33\t    if user is None:\r\n    34\t        return None\r\n    35\t    memberships = {r[\"org_id\"]: r[\"role\"] for r in\r\n    36\t                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    37\t    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.\r\n    38\t    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\r\n    39\t    if user[\"is_support\"]:\r\n    40\t        role = \"support\"\r\n    41\t    else:\r\n"]
[10.902706, "o", "    42\t        role = memberships.get(org_id, \"member\")\r\n    43\t    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\r\n    44\t                    org_id=org_id, role=role, memberships=memberships)\r\n    45\t\r\n    46\t\r\n    47\tdef login_required(view):\r\n    48\t    @functools.wraps(view)\r\n    49\t    def wrapper(*args, **kwargs):\r\n    50\t        ident = load_identity()\r\n    51\t        if ident is None:\r\n    52\t            return jsonify(error=\"unauthorized\"), 401\r\n    53\t        g.identity = ident\r\n    54\t        return view(*args, **kwargs)\r\n    55\t    return wrapper\r\n    56\t\r\n    57\t\r\n"]
[10.902743, "o", "    58\tdef require_active_org():\r\n    59\t    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\r\n    60\t    org_id = g.identity.org_id\r\n    61\t    if org_id is None:\r\n    62\t        from flask import abort\r\n    63\t        abort(400, description=\"x_org_id_required\")\r\n    64\t    return org_id\r\n"]
[10.902852, "o", "\r\n===== /app/docshare/db.py =====\r\n"]
[10.903704, "o", "     1\t\"\"\"SQLite access. One connection per request (see app.py); rows come back as sqlite3.Row.\"\"\"\r\n     2\timport sqlite3\r\n     3\t\r\n"]
[10.903746, "o", "     4\tfrom flask import g\r\n     5\t\r\n     6\tSCHEMA = \"\"\"\r\n     7\tCREATE TABLE IF NOT EXISTS orgs (\r\n     8\t    id TEXT PRIMARY KEY,\r\n     9\t    name TEXT NOT NULL\r\n"]
[10.903778, "o", "    10\t);\r\n    11\tCREATE TABLE IF NOT EXISTS users (\r\n    12\t    id TEXT PRIMARY KEY,\r\n    13\t    email TEXT NOT NULL UNIQUE,\r\n    14\t    name TEXT NOT NULL,\r\n    15\t    token TEXT NOT NULL UNIQUE,\r\n    16\t    home_org_id TEXT REFERENCES orgs(id),\r\n    17\t    is_support INTEGER NOT NULL DEFAULT 0\r\n    18\t);\r\n    19\tCREATE TABLE IF NOT EXISTS memberships (\r\n    20\t    user_id TEXT NOT NULL REFERENCES users(id),\r\n    21\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    22\t    role TEXT NOT NULL CHECK (role IN ('member', 'org_admin')),\r\n"]
[10.903829, "o", "    23\t    PRIMARY KEY (user_id, org_id)\r\n    24\t);\r\n    25\tCREATE TABLE IF NOT EXISTS folders (\r\n    26\t    id TEXT PRIMARY KEY,\r\n    27\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    28\t    name TEXT NOT NULL\r\n    29\t);\r\n    30\tCREATE TABLE IF NOT EXISTS files (\r\n    31\t    id TEXT PRIMARY KEY,\r\n    32\t    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n"]
[10.903863, "o", "    33\t    folder_id TEXT NOT NULL REFERENCES folders(id),\r\n    34\t    name TEXT NOT NULL,\r\n    35\t    mime_type TEXT NOT NULL,\r\n    36\t    size INTEGER NOT NULL,\r\n    37\t    content BLOB NOT NULL,\r\n    38\t    uploaded_by TEXT NOT NULL REFERENCES users(id),\r\n    39\t    created_at TEXT NOT NULL\r\n    40\t);\r\n    41\tCREATE TABLE IF NOT EXISTS shares (\r\n    42\t    token TEXT PRIMARY KEY,\r\n    43\t    file_id TEXT NOT NULL REFERENCES files(id),\r\n    44\t    created_by TEXT NOT NULL REFERENCES users(id),\r\n    45\t    created_at TEXT NOT NULL,\r\n    46\t    revoked_at TEXT\r\n    47\t);\r\n    48\tCREATE INDEX IF NOT EXISTS files_org ON files(org_id, name);\r\n    49\tCREATE INDEX IF NOT EXISTS files_folder ON files(folder_id, name);\r\n"]
[10.903902, "o", "    50\tCREATE INDEX IF NOT EXISTS shares_file ON shares(file_id);\r\n    51\t\"\"\"\r\n    52\t\r\n    53\tFILE_COLUMNS = \"id, org_id, folder_id, name, mime_type, size, uploaded_by, created_at\"\r\n    54\t\r\n    55\t\r\n    56\tdef connect(path):\r\n    57\t    conn = sqlite3.connect(path, timeout=10)\r\n    58\t    conn.row_factory = sqlite3.Row\r\n    59\t    conn.execute(\"PRAGMA foreign_keys = ON\")\r\n    60\t    conn.execute(\"PRAGMA busy_timeout = 10000\")\r\n    61\t    return conn\r\n"]
[10.903935, "o", "    62\t\r\n    63\t\r\n    64\tdef get_db():\r\n    65\t    if \"db\" not in g:\r\n    66\t        from flask import current_app\r\n    67\t        g.db = connect(current_app.config[\"DB_PATH\"])\r\n    68\t    return g.db\r\n    69\t\r\n    70\t\r\n    71\tdef close_db(_exc=None):\r\n    72\t    conn = g.pop(\"db\", None)\r\n    73\t    if conn is not None:\r\n    74\t        conn.close()\r\n"]
[10.903976, "o", "    75\t\r\n    76\t\r\n    77\tdef query_one(sql, params=()):\r\n    78\t    return get_db().execute(sql, params).fetchone()\r\n    79\t\r\n    80\t\r\n    81\tdef query_all(sql, params=()):\r\n    82\t    return get_db().execute(sql, params).fetchall()\r\n    83\t\r\n    84\t\r\n    85\tdef execute(sql, params=()):\r\n    86\t    conn = get_db()\r\n    87\t    cur = conn.execute(sql, params)\r\n    88\t    conn.commit()\r\n"]
[10.904011, "o", "    89\t    return cur.rowcount\r\n    90\t\r\n    91\t\r\n    92\tdef file_json(row):\r\n    93\t    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"folder_id\": row[\"folder_id\"], \"name\": row[\"name\"],\r\n    94\t            \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"], \"uploaded_by\": row[\"uploaded_by\"],\r\n    95\t            \"created_at\": row[\"created_at\"]}\r\n    96\t\r\n    97\t\r\n    98\tdef folder_json(row):\r\n    99\t    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"name\": row[\"name\"]}\r\n"]
[10.904138, "o", "\r\n===== /app/docshare/serve.py =====\r\n"]
[10.905013, "o", "     1\t\"\"\"Run the API: python -m docshare.serve --db <path> --port <port>.\"\"\"\r\n     2\timport argparse\r\n     3\timport os\r\n     4\timport sys\r\n     5\t\r\n"]
[10.90505, "o", "     6\tfrom waitress import serve\r\n     7\t\r\n     8\tfrom . import db\r\n     9\tfrom .app import create_app\r\n    10\t\r\n    11\t\r\n"]
[10.905086, "o", "    12\tdef main(argv=None):\r\n    13\t    p = argparse.ArgumentParser(description=\"docshare API server\")\r\n    14\t    p.add_argument(\"--db\", required=True, help=\"path to an existing docshare SQLite database\")\r\n    15\t    p.add_argument(\"--port\", type=int, default=8080)\r\n    16\t    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    17\t    p.add_argument(\"--threads\", type=int, default=4)\r\n    18\t    args = p.parse_args(argv)\r\n    19\t    if not os.path.isfile(args.db):\r\n    20\t        sys.exit(f\"database not found: {args.db}\")\r\n    21\t    conn = db.connect(args.db)\r\n    22\t    conn.execute(\"PRAGMA journal_mode = WAL\")\r\n    23\t    conn.close()\r\n    24\t    serve(create_app(os.path.abspath(args.db)), host=args.host, port=args.port, threads=args.threads,\r\n    25\t          ident=\"docshare\")\r\n    26\t\r\n    27\t\r\n"]
[10.905129, "o", "    28\tif __name__ == \"__main__\":\r\n    29\t    main()\r\n"]
[10.905214, "o", "\r\n===== /app/docshare/routes/__init__.py =====\r\n"]
[10.906164, "o", "\r\n===== /app/docshare/routes/files.py =====\r\n"]
[10.907006, "o", "     1\t\"\"\"File endpoints: list, metadata, download, rename, delete.\"\"\"\r\n     2\tfrom flask import Blueprint, Response, abort, g, jsonify, request\r\n     3\t\r\n     4\tfrom .. import db\r\n     5\tfrom ..auth import login_required, require_active_org\r\n     6\t\r\n"]
[10.907066, "o", "     7\tbp = Blueprint(\"files\", __name__)\r\n     8\t\r\n     9\t\r\n    10\tdef get_file_or_404(file_id):\r\n    11\t    row = db.query_one(f\"SELECT {db.FILE_COLUMNS}, content FROM files WHERE id = ?\", (file_id,))\r\n    12\t    if row is None:\r\n    13\t        abort(404)\r\n"]
[10.907104, "o", "    14\t    return row\r\n    15\t\r\n    16\t\r\n    17\t@bp.get(\"/api/files\")\r\n    18\t@login_required\r\n    19\tdef list_files():\r\n    20\t    org_id = require_active_org()\r\n    21\t    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    22\t    return jsonify(files=[db.file_json(r) for r in rows])\r\n    23\t\r\n    24\t\r\n    25\t@bp.get(\"/api/files/<file_id>\")\r\n    26\t@login_required\r\n    27\tdef get_file(file_id):\r\n    28\t    return jsonify(db.file_json(get_file_or_404(file_id)))\r\n    29\t\r\n    30\t\r\n    31\t@bp.get(\"/api/files/<file_id>/download\")\r\n"]
[10.907142, "o", "    32\t@login_required\r\n    33\tdef download(file_id):\r\n    34\t    row = get_file_or_404(file_id)\r\n    35\t    return file_response(row)\r\n    36\t\r\n    37\t\r\n    38\tdef file_response(row):\r\n    39\t    resp = Response(bytes(row[\"content\"]), mimetype=row[\"mime_type\"])\r\n    40\t    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{row[\"name\"]}\"'\r\n    41\t    return resp\r\n    42\t\r\n    43\t\r\n"]
[10.907197, "o", "    44\t@bp.patch(\"/api/files/<file_id>\")\r\n    45\t@login_required\r\n    46\tdef rename(file_id):\r\n    47\t    if g.identity.role not in (\"member\", \"org_admin\"):\r\n    48\t        abort(403)\r\n    49\t    row = get_file_or_404(file_id)\r\n    50\t    body = request.get_json(silent=True) or {}\r\n    51\t    name = body.get(\"name\")\r\n    52\t    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\r\n    53\t        abort(400, description=\"bad_name\")\r\n    54\t    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n    55\t    return jsonify(db.file_json(get_file_or_404(row[\"id\"])))\r\n    56\t\r\n    57\t\r\n"]
[10.90724, "o", "    58\t@bp.delete(\"/api/files/<file_id>\")\r\n    59\t@login_required\r\n    60\tdef delete(file_id):\r\n    61\t    row = get_file_or_404(file_id)\r\n    62\t    conn = db.get_db()\r\n    63\t    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\r\n    64\t    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\r\n    65\t    conn.commit()\r\n    66\t    return \"\", 204\r\n"]
[10.907337, "o", "\r\n===== /app/docshare/routes/folders.py =====\r\n"]
[10.908602, "o", "     1\t\"\"\"Folder endpoints: the folders of the active organisation and their files.\"\"\"\r\n     2\tfrom flask import Blueprint, abort, jsonify\r\n     3\t\r\n     4\tfrom .. import db\r\n     5\tfrom ..auth import login_required, require_active_org\r\n     6\t\r\n"]
[10.908632, "o", "     7\tbp = Blueprint(\"folders\", __name__)\r\n     8\t\r\n     9\t\r\n    10\t@bp.get(\"/api/folders\")\r\n    11\t@login_required\r\n    12\tdef list_folders():\r\n    13\t    org_id = require_active_org()\r\n    14\t    rows = db.query_all(\"SELECT id, org_id, name FROM folders WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    15\t    return jsonify(folders=[db.folder_json(r) for r in rows])\r\n    16\t\r\n    17\t\r\n    18\t@bp.get(\"/api/folders/<folder_id>/files\")\r\n"]
[10.908691, "o", "    19\t@login_required\r\n    20\tdef folder_files(folder_id):\r\n    21\t    org_id = require_active_org()\r\n    22\t    folder = db.query_one(\"SELECT id, org_id, name FROM folders WHERE id = ? AND org_id = ?\", (folder_id, org_id))\r\n    23\t    if folder is None:\r\n    24\t        abort(404)\r\n    25\t    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE folder_id = ? AND org_id = ? ORDER BY name\",\r\n    26\t                        (folder_id, org_id))\r\n    27\t    return jsonify(folder=db.folder_json(folder), files=[db.file_json(r) for r in rows])\r\n"]
[10.908795, "o", "\r\n===== /app/docshare/routes/thumbs.py =====\r\n"]
[10.909647, "o", "     1\t\"\"\"SVG previews for the file grid.\"\"\"\r\n     2\timport html\r\n     3\t\r\n     4\tfrom flask import Blueprint, Response, abort\r\n     5\t\r\n"]
[10.909676, "o", "     6\tfrom .. import db\r\n     7\tfrom ..auth import login_required\r\n     8\t\r\n     9\tbp = Blueprint(\"thumbs\", __name__)\r\n    10\t\r\n"]
[10.909713, "o", "    11\tTEXT_TYPES = (\"text/\", \"application/json\")\r\n    12\t\r\n    13\t\r\n    14\tdef render_thumb(name, mime_type, content):\r\n    15\t    lines = []\r\n    16\t    if mime_type.startswith(TEXT_TYPES):\r\n    17\t        text = bytes(content).decode(\"utf-8\", \"replace\")\r\n    18\t        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\r\n    19\t    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\r\n    20\t             f\"<title>{html.escape(name)}</title>\",\r\n"]
[10.90975, "o", "    21\t             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n    22\t             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n    23\t    for i, ln in enumerate(lines):\r\n    24\t        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\r\n    25\t    parts.append(\"</svg>\")\r\n    26\t    return \"\\n\".join(parts)\r\n    27\t\r\n    28\t\r\n    29\t@bp.get(\"/api/files/<file_id>/thumb\")\r\n    30\t@login_required\r\n    31\tdef thumb(file_id):\r\n    32\t    row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n"]
[10.909761, "o", "    33\t    if row is None:\r\n    34\t        abort(404)\r\n    35\t    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n    36\t    return Response(svg, mimetype=\"image/svg+xml\")\r\n"]
[10.909886, "o", "\r\n===== /app/docshare/routes/export.py =====\r\n"]
[10.910738, "o", "     1\t\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\n     2\timport base64\r\n     3\t\r\n"]
[10.910771, "o", "     4\tfrom flask import Blueprint, abort, g, jsonify, request\r\n     5\t\r\n     6\tfrom .. import db\r\n     7\tfrom ..auth import login_required\r\n     8\t\r\n     9\tbp = Blueprint(\"export\", __name__)"]
[10.910805, "o", "\r\n    10\t\r\n    11\tMAX_IDS = 50\r\n    12\t\r\n    13\t\r\n    14\t@bp.post(\"/api/export\")\r\n    15\t@login_required\r\n    16\tdef export():\r\n    17\t    body = request.get_json(silent=True) or {}\r\n    18\t    ids = body.get(\"file_ids\")\r\n    19\t    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n    20\t        abort(400, description=\"bad_file_ids\")\r\n    21\t    # A selection always comes from one folder view, so the first file tells us whose files these are.\r\n    22\t    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\r\n    23\t    if first is None:\r\n    24\t        abort(404)\r\n    25\t    if not g.identity.is_support and first[\"org_id\"] != g.identity.org_id:\r\n"]
[10.910838, "o", "    26\t        abort(404)\r\n    27\t    out = []\r\n    28\t    for file_id in ids:\r\n    29\t        row = db.query_one(\"SELECT id, name, mime_type, size, content FROM files WHERE id = ?\", (file_id,))\r\n"]
[10.91085, "o", "    30\t        if row is None:\r\n    31\t            abort(404)\r\n    32\t        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n    33\t                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n    34\t    return jsonify(files=out)\r\n"]
[10.910975, "o", "\r\n===== /app/docshare/routes/share.py =====\r\n"]
[10.911822, "o", "     1\t\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\r\n     2\timport secrets\r\n     3\tfrom datetime import datetime, timezone\r\n     4\t\r\n"]
[10.911852, "o", "     5\tfrom flask import Blueprint, abort, g, jsonify\r\n     6\t\r\n     7\tfrom .. import db\r\n     8\tfrom ..auth import login_required\r\n     9\tfrom .files import file_response\r\n    10\t\r\n"]
[10.911885, "o", "    11\tbp = Blueprint(\"share\", __name__)\r\n    12\t\r\n    13\t\r\n    14\tdef now_iso():\r\n    15\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n    16\t\r\n    17\t\r\n    18\t@bp.post(\"/api/files/<file_id>/shares\")\r\n    19\t@login_required\r\n"]
[10.911917, "o", "    20\tdef create_share(file_id):\r\n    21\t    if g.identity.role not in (\"member\", \"org_admin\"):\r\n    22\t        abort(403)\r\n    23\t    row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\r\n    24\t    if row is None:\r\n    25\t        abort(404)\r\n    26\t    token = secrets.token_urlsafe(18)\r\n    27\t    created = now_iso()\r\n    28\t    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\r\n    29\t               (token, row[\"id\"], g.identity.user_id, created))\r\n    30"]
[10.911949, "o", "\t    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\r\n    31\t\r\n    32\t\r\n    33\t@bp.delete(\"/api/shares/<token>\")\r\n    34\t@login_required\r\n    35\tdef revoke_share(token):\r\n    36\t    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\r\n    37\t                       (token,))\r\n    38\t    if row is None or row[\"org_id\"] != g.identity.org_id or g.identity.role not in (\"member\", \"org_admin\"):\r\n    39\t        abort(404)\r\n    40\t    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n    41\t    return \"\", 204\r\n"]
[10.911987, "o", "    42\t\r\n    43\t\r\n    44\t@bp.get(\"/s/<token>\")\r\n    45\tdef public_download(token):\r\n    46\t    row = db.query_one(\"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\r\n    47\t                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (token,))\r\n    48\t    if row is None:\r\n    49\t        abort(404)\r\n    50\t    return file_response(row)\r\n"]
