[?2004l[?2004h> 
[?2004l[?2004h> def login_required(view):
[?2004l[?2004h>     """Require a valid bearer token and enforce the active organisation.
[?2004l[?2004h> 
[?2004l[?2004h>     The original implementation only loaded the identity and stored it on ``g``.
[?2004l[?2004h>     The permission policy mandates that *every* authenticated request validates the
[?2004l[?2004h>     active organisation (section 2). For support users the organisation header is
[?2004l[?2004h>     optional, so we invoke ``require_active_org`` only for non‑support identities.
[?2004l[?2004h>     """
[?2004l[?2004h>     @functools.wraps(view)
[?2004l[?2004h>     def wrapper(*args, **kwargs):
[?2004l[?2004h>         ident = load_identity()
