[?2004l for r in
                   db.query_all("SELECT org_id, role FROM memberships WHERE user_id = ?", (user["id"],))}
    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.
    org_id = request.headers.get("X-Org-Id") or user["home_org_id"]
    if user["is_support"]:
        role = "support"
    else:
        role = memberships.get(org_id, "member")
    return Identity(user_id=user["id"], email=user["email"], name=user["name"], is_support=bool(user["is_support"]),
                    org_id=org_id, role=role, memberships=memberships)


def require_active_org():
    """Validate and return the active organisation id.

    The policy (PERMISSIONS.md, section 2) requires:
    * The ``X-Org-Id`` header (or the user's home organisation) must resolve to an existing organisation.
    * For regular users (non‑support) the organisation must be one they belong to (present in ``g.identity.memberships``).
    * Support staff may choose any existing organisation, but must supply the header; otherwise a ``400`` is returned.
    """
    org_id = g.identity.org_id
    if org_id is None:
        from flask import abort
        abort(400, description="x_org_id_required")

    # Verify the organisation exists.
    org_row = db.query_one("SELECT id FROM orgs WHERE id = ?", (org_id,))
    if org_row is None:
        from flask import abort
        abort(404, description="org_not_found")

    if not g.identity.is_support:
        if org_id not in g.identity.memberships:
            from flask import abort
            abort(403, description="org_not_allowed")
    # Support staff are allowed any existing organisation (already verified above).
    return org_id


def login_required(view):
    """Require a valid bearer token and enforce the active organisation.

    The original implementation only loaded the identity and stored it on ``g``.
    The permission policy mandates that *every* authenticated request validates the
    active organisation (section 2). By invoking ``require_active_org`` here we
    guarantee that the checks are performed for all routes that use ``@login_required``.
    """
    @functools.wraps(view)
    def wrapper(*args, **kwargs):
        ident = load_identity()
        if ident is None:
            return jsonify(error="unauthorized"), 401
        g.identity = ident
        # Enforce active organisation validation for every protected endpoint.
        require_active_org()
        return view(*args, **kwargs)
    return wrapper
