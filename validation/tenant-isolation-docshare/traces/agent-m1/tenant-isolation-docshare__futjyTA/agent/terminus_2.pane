[?2004l[?2004h> 
[?2004l[?2004h> def require_active_org():
[?2004l[?2004h>     """Validate and return the active organisation id.
[?2004l[?2004h> 
[?2004l[?2004h>     The policy (PERMISSIONS.md, section 2) requires:
[?2004l[?2004h>     * The ``X-Org-Id`` header (or the user's home organisation) must resolve to an existing organisation.
[?2004l[?2004h>     * For regular users (non‑support) the organisation must be one they belong to (present in ``g.identity.memberships``).
[?2004l[?2004h>     * Support staff may choose any existing organisation, but must supply the header; otherwise a ``400`` is returned.
[?2004l[?2004h>     """
[?2004l[?2004h>     org_id = g.identity.org_id
[?2004l[?2004h>     if org_id is None:
[?2004l[?2004h>         from flask import abort
[?2004l[?2004h>         abort(400, description="x_org_id_required")
[?2004l[?2004h>     # Verify the organisation exists.
[?2004l[?2004h>     org_row = db.query_one("SELECT id FROM orgs WHERE id = ?", (org_id,))
[?2004l[?2004h>     if org_row is None:
[?2004l[?2004h>         from flask import abort
[?2004l[?2004h>         abort(404, description="org_not_found")
[?2004l[?2004h>     if not g.identity.is_support:
[?2004l[?2004h>         if org_id not in g.identity.memberships:
[?2004l[?2004h>             from flask import abort
[?2004l[?2004h>             abort(403, description="org_not_allowed")
[?2004l[?2004h>     # Support staff are allowed any existing organisation (already verified above).
[?2004l[?2004h>     return org_id
