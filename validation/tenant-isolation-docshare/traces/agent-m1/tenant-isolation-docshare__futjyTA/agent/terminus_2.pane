[?2004l[?2004h>         return None
[?2004l[?2004h>     user = db.query_one("SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?", (token,))
[?2004l[?2004h>     if user is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     memberships = {r["org_id"]: r["role"] for r in
[?2004l[?2004h>                    db.query_all("SELECT org_id, role FROM memberships WHERE user_id = ?", (user["id"],))}
[?2004l[?2004h>     # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.
[?2004l[?2004h>     org_id = request.headers.get("X-Org-Id") or user["home_org_id"]
[?2004l[?2004h>     if user["is_support"]:
[?2004l[?2004h>         role = "support"
[?2004l[?2004h>     else:
[?2004l[?2004h>         role = memberships.get(org_id, "member")
[?2004l[?2004h>     return Identity(user_id=user["id"], email=user["email"], name=user["name"], is_support=bool(user["is_support"]),
[?2004l[?2004h>                     org_id=org_id, role=role, memberships=memberships)
