[47.20969, "o", "export PYTHONPATH=$(pwd)\r\n\u001b[?2004l\r"]
[47.21098, "o", "\u001b[?2004h"]
[47.211035, "o", "root@6dac5c62-598e-49fe-8973-206b888602c1:/app# "]
