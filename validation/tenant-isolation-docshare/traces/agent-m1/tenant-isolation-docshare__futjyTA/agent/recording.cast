[46.211586, "o", "\u001b[?2004h"]
[46.211609, "o", "> "]
[46.211645, "o", "@dataclass\r\n\u001b[?2004l\r"]
[46.211667, "o", "\u001b[?2004h"]
[46.211684, "o", "> "]
[46.211737, "o", "class Identity:\r\n\u001b[?2004l\r"]
[46.211756, "o", "\u001b[?2004h"]
[46.211779, "o", "> "]
[46.211833, "o", "    user_id: str\r\n\u001b[?2004l\r"]
[46.211855, "o", "\u001b[?2004h"]
[46.211879, "o", "> "]
[46.211932, "o", "    email: str\r\n\u001b[?2004l\r"]
[46.211954, "o", "\u001b[?2004h"]
[46.211974, "o", "> "]
[46.212015, "o", "    name: str\r\n\u001b[?2004l\r"]
[46.212039, "o", "\u001b[?2004h"]
[46.212056, "o", "> "]
[46.212129, "o", "    is_support: bool\r\n\u001b[?2004l\r"]
[46.212148, "o", "\u001b[?2004h"]
[46.212171, "o", "> "]
[46.212398, "o", "    org_id: str | None          # the active organisation for this request\r\n\u001b[?2004l\r"]
[46.21242, "o", "\u001b[?2004h"]
[46.212442, "o", "> "]
[46.212651, "o", "    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n\u001b[?2004l\r"]
[46.212673, "o", "\u001b[?2004h"]
[46.212695, "o", "> "]
[46.212925, "o", "    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n\u001b[?2004l\r"]
[46.212951, "o", "\u001b[?2004h"]
[46.212969, "o", "> \r\n\u001b[?2004l\r"]
[46.212987, "o", "\u001b[?2004h"]
[46.213006, "o", "> \r\n\u001b[?2004l\r"]
[46.213029, "o", "\u001b[?2004h> "]
[46.213106, "o", "def _bearer_token():\r\n\u001b[?2004l\r"]
[46.213126, "o", "\u001b[?2004h"]
[46.213143, "o", "> "]
[46.213317, "o", "    header = request.headers.get(\"Authorization\", \"\")\r\n\u001b[?2004l\r"]
[46.213341, "o", "\u001b[?2004h> "]
[46.213477, "o", "    if not header.startswith(\"Bearer \"):\r\n\u001b[?2004l\r"]
[46.213497, "o", "\u001b[?2004h"]
[46.213514, "o", "> "]
[46.213587, "o", "        return None\r\n\u001b[?2004l\r"]
[46.213607, "o", "\u001b[?2004h"]
[46.213626, "o", "> "]
[46.213779, "o", "    return header[len(\"Bearer \"):].strip() or None\r\n\u001b[?2004l\r"]
[46.213803, "o", "\u001b[?2004h"]
[46.213841, "o", "> \r\n\u001b[?2004l\r"]
[46.213868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.21389, "o", "\u001b[?2004h"]
[46.213908, "o", "> "]
[46.21395, "o", "def load_identity():\r\n\u001b[?2004l\r"]
[46.213969, "o", "\u001b[?2004h"]
[46.213988, "o", "> "]
[46.214064, "o", "    token = _bearer_token()\r\n\u001b[?2004l\r"]
[46.214084, "o", "\u001b[?2004h"]
[46.214103, "o", "> "]
[46.214164, "o", "    if token is None:\r\n\u001b[?2004l\r"]
[46.214181, "o", "\u001b[?2004h"]
[46.214198, "o", "> "]
[46.214251, "o", "        return None\r\n\u001b[?2004l\r"]
[46.214272, "o", "\u001b[?2004h"]
[46.214289, "o", "> "]
[46.214627, "o", "    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n\u001b[?2004l\r"]
[46.214653, "o", "\u001b[?2004h"]
[46.214672, "o", "> "]
[46.214727, "o", "    if user is None:\r\n\u001b[?2004l\r"]
[46.214744, "o", "\u001b[?2004h"]
[46.214761, "o", "> "]
[46.21482, "o", "        return None\r\n\u001b[?2004l\r"]
[46.214839, "o", "\u001b[?2004h"]
[46.214859, "o", "> "]
[46.215012, "o", "    memberships = {r[\"org_id\"]: r[\"role\"] for r in\r\n\u001b[?2004l\r"]
[46.215029, "o", "\u001b[?2004h"]
[46.215051, "o", "> "]
[46.215363, "o", "                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n\u001b[?2004l\r"]
[46.215398, "o", "\u001b[?2004h> "]
[46.215725, "o", "    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.\r\n\u001b[?2004l\r"]
[46.215743, "o", "\u001b[?2004h"]
[46.21576, "o", "> "]
[46.215967, "o", "    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\r\n\u001b[?2004l\r"]
[46.215988, "o", "\u001b[?2004h"]
[46.216006, "o", "> "]
[46.216078, "o", "    if user[\"is_support\"]:\r\n\u001b[?2004l\r"]
[46.216095, "o", "\u001b[?2004h"]
[46.216118, "o", "> "]
[46.216182, "o", "        role = \"support\"\r\n\u001b[?2004l\r"]
[46.216199, "o", "\u001b[?2004h"]
[46.216218, "o", "> "]
[46.216243, "o", "    else:\r\n\u001b[?2004l\r"]
[46.21626, "o", "\u001b[?2004h"]
[46.216278, "o", "> "]
[46.216418, "o", "        role = memberships.get(org_id, \"member\")\r\n\u001b[?2004l\r"]
[46.216434, "o", "\u001b[?2004h"]
[46.216453, "o", "> "]
[46.216799, "o", "    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\r\n\u001b[?2004l\r"]
[46.216822, "o", "\u001b[?2004h"]
[46.216841, "o", "> "]
[46.217066, "o", "                    org_id=org_id, role=role, memberships=memberships)\r\n\u001b[?2004l\r"]
[46.217093, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.217116, "o", "\u001b[?2004h> "]
[46.217133, "o", "\r\n\u001b[?2004l\r"]
[46.217151, "o", "\u001b[?2004h"]
[46.217168, "o", "> "]
[46.217233, "o", "def require_active_org():\r\n\u001b[?2004l\r"]
[46.217253, "o", "\u001b[?2004h> "]
[46.217423, "o", "    \"\"\"Validate and return the active organisation id.\r\n\u001b[?2004l\r"]
[46.217442, "o", "\u001b[?2004h"]
[46.21746, "o", "> \r\n\u001b[?2004l\r"]
[46.217477, "o", "\u001b[?2004h> "]
[46.217649, "o", "    The policy (PERMISSIONS.md, section 2) requires:\r\n\u001b[?2004l\r"]
[46.217668, "o", "\u001b[?2004h"]
[46.217687, "o", "> "]
[46.218009, "o", "    * The ``X-Org-Id`` header (or the user's home organisation) must resolve to an existing organisation.\r\n\u001b[?2004l\r"]
[46.218035, "o", "\u001b[?2004h"]
[46.218054, "o", "> "]
[46.218413, "o", "    * For regular users (non‑support) the organisation must be one they belong to (present in ``g.identity.memberships``).\r\n\u001b[?2004l\r"]
[46.218441, "o", "\u001b[?2004h> "]
[46.218796, "o", "    * Support staff may choose any existing organisation, but must supply the header; otherwise a ``400`` is returned.\r\n\u001b[?2004l\r"]
[46.218818, "o", "\u001b[?2004h"]
[46.218836, "o", "> "]
[46.218889, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[46.218911, "o", "\u001b[?2004h> "]
[46.218992, "o", "    org_id = g.identity.org_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.219012, "o", "> "]
[46.219079, "o", "    if org_id is None:\r\n\u001b[?2004l\r"]
[46.219095, "o", "\u001b[?2004h"]
[46.219115, "o", "> "]
[46.219203, "o", "        from flask import abort\r\n\u001b[?2004l\r"]
[46.219219, "o", "\u001b[?2004h"]
[46.219236, "o", "> "]
[46.219389, "o", "        abort(400, description=\"x_org_id_required\")\r\n\u001b[?2004l\r"]
[46.219405, "o", "\u001b[?2004h"]
[46.219421, "o", "> \r\n\u001b[?2004l\r"]
[46.219443, "o", "\u001b[?2004h> "]
[46.219559, "o", "    # Verify the organisation exists.\r\n\u001b[?2004l\r"]
[46.219579, "o", "\u001b[?2004h"]
[46.219597, "o", "> "]
[46.219812, "o", "    org_row = db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,))\r\n\u001b[?2004l\r"]
[46.219831, "o", "\u001b[?2004h"]
[46.21985, "o", "> "]
[46.219926, "o", "    if org_row is None:\r\n\u001b[?2004l\r"]
[46.219942, "o", "\u001b[?2004h"]
[46.21996, "o", "> "]
[46.220054, "o", "        from flask import abort\r\n\u001b[?2004l\r"]
[46.22007, "o", "\u001b[?2004h"]
[46.220089, "o", "> "]
[46.220227, "o", "        abort(404, description=\"org_not_found\")\r\n\u001b[?2004l\r"]
[46.22025, "o", "\u001b[?2004h> \r\n"]
[46.220269, "o", "\u001b[?2004l\r"]
[46.220287, "o", "\u001b[?2004h> "]
[46.220391, "o", "    if not g.identity.is_support:\r\n\u001b[?2004l\r"]
[46.220412, "o", "\u001b[?2004h"]
[46.220431, "o", "> "]
[46.220571, "o", "        if org_id not in g.identity.memberships:\r\n\u001b[?2004l\r"]
[46.220605, "o", "\u001b[?2004h> "]
[46.220721, "o", "            from flask import abort\r\n\u001b[?2004l\r"]
[46.220742, "o", "\u001b[?2004h"]
[46.220763, "o", "> "]
[46.220938, "o", "            abort(403, description=\"org_not_allowed\")\r\n\u001b[?2004l\r"]
[46.220959, "o", "\u001b[?2004h"]
[46.220987, "o", "> "]
[46.22124, "o", "    # Support staff are allowed any existing organisation (already verified above).\r\n\u001b[?2004l\r"]
[46.221263, "o", "\u001b[?2004h"]
[46.22128, "o", "> "]
[46.221338, "o", "    return org_id\r\n\u001b[?2004l\r"]
[46.221358, "o", "\u001b[?2004h"]
[46.221379, "o", "> \r\n\u001b[?2004l\r"]
[46.221404, "o", "\u001b[?2004h"]
[46.221426, "o", "> \r\n\u001b[?2004l\r"]
[46.22145, "o", "\u001b[?2004h> "]
[46.221541, "o", "def login_required(view):\r\n\u001b[?2004l\r"]
[46.221562, "o", "\u001b[?2004h"]
[46.221583, "o", "> "]
[46.22181, "o", "    \"\"\"Require a valid bearer token and enforce the active organisation.\r\n\u001b[?2004l\r"]
[46.221831, "o", "\u001b[?2004h"]
[46.221854, "o", "> \r\n\u001b[?2004l\r"]
[46.221877, "o", "\u001b[?2004h"]
[46.221898, "o", "> "]
[46.222151, "o", "    The original implementation only loaded the identity and stored it on ``g``.\r\n\u001b[?2004l\r"]
[46.222173, "o", "\u001b[?2004h"]
[46.22219, "o", "> "]
[46.222446, "o", "    The permission policy mandates that *every* authenticated request validates the\r\n\u001b[?2004l\r"]
[46.222471, "o", "\u001b[?2004h"]
[46.222488, "o", "> "]
[46.222739, "o", "    active organisation (section 2). By invoking ``require_active_org`` here we\r\n\u001b[?2004l\r"]
[46.222759, "o", "\u001b[?2004h"]
[46.222779, "o", "> "]
[46.223072, "o", "    guarantee that the checks are performed for all routes that use ``@login_required``.\r\n\u001b[?2004l\r"]
[46.223105, "o", "\u001b[?2004h> "]
[46.223129, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[46.223152, "o", "\u001b[?2004h"]
[46.223174, "o", "> "]
[46.223268, "o", "    @functools.wraps(view)\r\n\u001b[?2004l\r"]
[46.223292, "o", "\u001b[?2004h"]
[46.22331, "o", "> "]
[46.22344, "o", "    def wrapper(*args, **kwargs):\r\n\u001b[?2004l\r"]
[46.223465, "o", "\u001b[?2004h"]
[46.223482, "o", "> "]
[46.223609, "o", "        ident = load_identity()\r\n\u001b[?2004l\r"]
[46.223637, "o", "\u001b[?2004h"]
[46.223654, "o", "> "]
[46.223766, "o", "        if ident is None:\r\n\u001b[?2004l\r"]
[46.223791, "o", "\u001b[?2004h"]
[46.223809, "o", "> "]
[46.224038, "o", "            return jsonify(error=\"unauthorized\"), 401\r\n\u001b[?2004l\r"]
[46.224069, "o", "\u001b[?2004h"]
[46.224088, "o", "> "]
[46.224191, "o", "        g.identity = ident\r\n\u001b[?2004l\r"]
[46.224217, "o", "\u001b[?2004h"]
[46.224234, "o", "> "]
[46.224867, "o", "        # Enforce active organisation validation for every protected endpoint.\r\n"]
[46.224887, "o", "\u001b[?2004l\r"]
[46.224951, "o", "\u001b[?2004h"]
[46.224983, "o", "> "]
[46.225307, "o", "        require_active_org()\r\n"]
[46.225326, "o", "\u001b[?2004l\r"]
[46.225379, "o", "\u001b[?2004h"]
[46.225415, "o", "> "]
[46.225842, "o", "        return view(*args, **kwargs)"]
[46.225867, "o", "\r\n\u001b[?2004l\r"]
[46.225936, "o", "\u001b[?2004h"]
[46.225968, "o", "> "]
[46.22618, "o", "    return wrapper\r\n"]
[46.226199, "o", "\u001b[?2004l\r"]
[46.226244, "o", "\u001b[?2004h"]
[46.226278, "o", "> "]
[46.226328, "o", "EOF\r\n"]
[46.226347, "o", "\u001b[?2004l\r"]
[46.244802, "o", "\u001b[?2004h"]
[46.244924, "o", "root@6dac5c62-598e-49fe-8973-206b888602c1:/app# "]
