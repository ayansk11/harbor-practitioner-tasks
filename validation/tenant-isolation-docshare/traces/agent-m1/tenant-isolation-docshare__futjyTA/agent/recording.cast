[27.452311, "o", "\u001b[31m\u001b[31m\u001b[1m1 error\u001b[0m\u001b[31m in 0.08s\u001b[0m\u001b[0m\r\n"]
[27.477303, "o", "\u001b[?2004hroot@6dac5c62-598e-49fe-8973-206b888602c1:/app# "]
[46.209972, "i", "cat > docshare/auth.py <<'EOF'\n\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\nimport functools\nfrom dataclasses import dataclass, field\n\nfrom flask import g, jsonify, request\n\nfrom . import db\n\n\n@dataclass\nclass Identity:\n    user_id: str\n    email: str\n    name: str\n    is_support: bool\n    org_id: str | None          # the active organisation for this request\n    role: str                   # \"member\", \"org_admin\" or \"support\"\n    memberships: dict = field(default_factory=dict)   # org_id -> role\n\n\ndef _bearer_token():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    return header[len(\"Bearer \"):].strip() or None\n\n\ndef load_identity():\n    token = _bearer_token()\n    if token is None:\n        return None\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\n    if user is None:\n        return None\n    memberships = {r[\"org_id\"]: r[\"role\"]"]
[46.210128, "i", " for r in\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\n    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.\n    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\n    if user[\"is_support\"]:\n        role = \"support\"\n    else:\n        role = memberships.get(org_id, \"member\")\n    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\n                    org_id=org_id, role=role, memberships=memberships)\n\n\ndef require_active_org():\n    \"\"\"Validate and return the active organisation id.\n\n    The policy (PERMISSIONS.md, section 2) requires:\n    * The ``X-Org-Id`` header (or the user's home organisation) must resolve to an existing organisation.\n    * For regular users (non‑support) the organisation must be one they belong to (present in ``g.identity.memberships``).\n    * Support staff may choose any existing organisation, but"]
[46.210187, "o", "cat > docshare/auth.py <<'EOF'\r\n\u001b[?2004l\r"]
[46.210225, "i", " must supply the header; otherwise a ``400`` is returned.\n    \"\"\"\n    org_id = g.identity.org_id\n    if org_id is None:\n        from flask import abort\n        abort(400, description=\"x_org_id_required\")\n\n    # Verify the organisation exists.\n    org_row = db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,))\n    if org_row is None:\n        from flask import abort\n        abort(404, description=\"org_not_found\")\n\n    if not g.identity.is_support:\n        if org_id not in g.identity.memberships:\n            from flask import abort\n            abort(403, description=\"org_not_allowed\")\n    # Support staff are allowed any existing organisation (already verified above).\n    return org_id\n\n\ndef login_required(view):\n    \"\"\"Require a valid bearer token and enforce the active organisation.\n\n    The original implementation only loaded the identity and stored it on ``g``.\n    The permission policy mandates that *every* authenticated request validates the\n    active organisation (section 2). By invoking ``require"]
[46.210261, "o", " for r in\r\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.\r\n    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\r\n    if user[\"is_support\"]:\r\n        role = \"support\"\r\n    else:\r\n        role = memberships.get(org_id, \"member\")\r\n    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\r\n                    org_id=org_id, role=role, memberships=memberships)\r\n\r\n\r\ndef require_active_org():\r\n    \"\"\"Validate and return the active organisation id.\r\n\r\n    The policy (PERMISSIONS.md, section 2) requires:\r\n    * Th"]
[46.210282, "i", "_active_org`` here we\n    guarantee that the checks are performed for all routes that use ``@login_required``.\n    \"\"\"\n    @functools.wraps(view)\n    def wrapper(*args, **kwargs):\n        ident = load_identity()\n        if ident is None:\n            return jsonify(error=\"unauthorized\"), 401\n        g.identity = ident\n        # Enforce active organisation validation for every protected endpoint.\n        require_active_org()\n        return view(*args, **kwargs)\n    return wrapper\nEOF\n"]
[46.21032, "o", "e ``X-Org-Id`` header (or the user's home organisation) must resolve to an existing organisation.\r\n    * For regular users (non‑support) the organisation must be one they belong to (present in ``g.identity.memberships``).\r\n    * Support staff may choose any existing organisation, but"]
[46.210386, "o", " must supply the header; otherwise a ``400`` is returned.\r\n    \"\"\"\r\n    org_id = g.identity.org_id\r\n    if org_id is None:\r\n        from flask import abort\r\n        abort(400, description=\"x_org_id_required\")\r\n\r\n    # Verify the organisation exists.\r\n    org_row = db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,))\r\n    if org_row is None:\r\n        from flask import abort\r\n        abort(404, description=\"org_not_found\")\r\n\r\n    if not g.identity.is_support:\r\n        if org_i"]
[46.210459, "o", "d not in g.identity.memberships:\r\n            from flask import abort\r\n            abort(403, description=\"org_not_allowed\")\r\n    # Support staff are allowed any existing organisation (already verified above).\r\n    return org_id\r\n\r\n\r\ndef login_required(view):\r\n    \"\"\"Require a valid bearer token and enforce the active organisation.\r\n\r\n    The original implementation only loaded the identity and stored it "]
[46.210513, "o", "on ``g``.\r\n    The permission policy mandates that *every* authenticated request validates the\r\n    active organisation (section 2). By invoking ``require_active_org`` here we\r\n    guarantee that the checks are performed for all routes that use ``@login_required``.\r\n    \"\"\"\r\n    @functools.wraps(view)\r\n    def wrapper(*args, **kwargs):\r\n        ident = load_ide"]
[46.210564, "o", "ntity()\r\n        if ident is None:\r\n            return jsonify(error=\"unauthorized\"), 401\r\n        g.identity = ident\r\n        # Enforce active organisation validation for every protected endpoint.\r\n        require_active_org()\r\n        return view(*args, **kwargs)\r\n    return wrapper\r\nEOF\r\n"]
[46.21062, "o", "\u001b[?2004h> "]
[46.210905, "o", "\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
