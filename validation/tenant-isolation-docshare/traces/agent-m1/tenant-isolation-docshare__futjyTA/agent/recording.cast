[26.114269, "o", "+    The original implementation only loaded the identity and stored it on ``g``.\r\n"]
[26.11429, "o", "\u001b[?2004l\r"]
[26.114327, "o", "\u001b[?2004h"]
[26.114361, "o", "> "]
[26.115223, "o", "+    The permission policy (docs/PERMISSIONS.md) mandates that *every* authenticated\r\n\u001b[?2004l\r"]
[26.1153, "o", "\u001b[?2004h"]
[26.115331, "o", "> "]
[26.116123, "o", "+    request validates the active organisation (section 2).  By invoking\r\n\u001b[?2004l\r"]
[26.116177, "o", "\u001b[?2004h"]
[26.116216, "o", "> "]
[26.117096, "o", "+    ``require_active_org`` here we guarantee that the checks are performed for all\r\n\u001b[?2004l\r"]
[26.117162, "o", "\u001b[?2004h"]
[26.117188, "o", "> "]
[26.118055, "o", "+    routes that use ``@login_required`` – which includes every API endpoint except\r\n"]
[26.118066, "o", "\u001b[?2004l\r"]
[26.118113, "o", "\u001b[?2004h"]
[26.118146, "o", "> "]
[26.118958, "o", "+    the health check and the public share link (both deliberately exempt).\r\n"]
[26.118966, "o", "\u001b[?2004l\r"]
[26.119026, "o", "\u001b[?2004h"]
[26.11906, "o", "> "]
[26.119159, "o", "+    \"\"\"\r\n"]
[26.119185, "o", "\u001b[?2004l\r"]
[26.11922, "o", "\u001b[?2004h"]
[26.119254, "o", "> "]
[26.119546, "o", "+    @functools.wraps(view)\r\n"]
[26.119571, "o", "\u001b[?2004l\r"]
[26.119607, "o", "\u001b[?2004h"]
[26.119641, "o", "> "]
[26.119997, "o", "+    def wrapper(*args, **kwargs):\r\n"]
[26.120032, "o", "\u001b[?2004l\r"]
[26.12006, "o", "\u001b[?2004h"]
[26.12009, "o", "> "]
[26.120434, "o", "+        ident = load_identity()\r\n"]
[26.120464, "o", "\u001b[?2004l\r"]
[26.120494, "o", "\u001b[?2004h"]
[26.120528, "o", "> "]
[26.120814, "o", "+        if ident is None:\r\n"]
[26.120842, "o", "\u001b[?2004l\r"]
[26.120897, "o", "\u001b[?2004h"]
[26.120927, "o", "> "]
[26.121504, "o", "+            return jsonify(error=\"unauthorized\"), 401\r\n"]
[26.121513, "o", "\u001b[?2004l\r"]
[26.121566, "o", "\u001b[?2004h"]
[26.121597, "o", "> "]
[26.121903, "o", "+        g.identity = ident\r\n\u001b[?2004l\r"]
[26.121957, "o", "\u001b[?2004h"]
[26.121991, "o", "> "]
[26.122784, "o", "+        # Enforce active organisation validation for every protected endpoint.\r\n"]
[26.122811, "o", "\u001b[?2004l\r"]
[26.122849, "o", "\u001b[?2004h"]
[26.12289, "o", "> "]
[26.123746, "o", "+        # ``require_active_org`` will abort with the appropriate HTTP error code\r\n"]
[26.123773, "o", "\u001b[?2004l\r"]
[26.123807, "o", "\u001b[?2004h"]
[26.123903, "o", "> "]
[26.124725, "o", "+        # if the organisation is missing, unknown, or not permitted for the user.\r\n\u001b[?2004l\r"]
[26.124781, "o", "\u001b[?2004h"]
[26.124826, "o", "> "]
[26.125113, "o", "+        require_active_org()\r\n\u001b[?2004l\r"]
[26.125189, "o", "\u001b[?2004h"]
[26.12523, "o", "> "]
[26.125601, "o", "+        return view(*args, **kwargs)\r\n\u001b[?2004l\r"]
[26.125659, "o", "\u001b[?2004h"]
[26.125719, "o", "> "]
[26.125921, "o", "+    return wrapper\r\n\u001b[?2004l\r"]
[26.125986, "o", "\u001b[?2004h"]
[26.126033, "o", "> @@"]
[26.126074, "o", "\r\n\u001b[?2004l\r"]
[26.126115, "o", "\u001b[?2004h"]
[26.126157, "o", "> "]
[26.126416, "o", "-def require_active_org():\r\n\u001b[?2004l\r"]
[26.126476, "o", "\u001b[?2004h"]
[26.126523, "o", "> "]
[26.127555, "o", "-    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\r\n\u001b[?2004l\r"]
[26.127609, "o", "\u001b[?2004h"]
[26.127638, "o", "> "]
[26.12796, "o", "-    org_id = g.identity.org_id\r\n"]
[26.127972, "o", "\u001b[?2004l\r"]
[26.128021, "o", "\u001b[?2004h"]
[26.128054, "o", "> "]
[26.128308, "o", "-    if org_id is None:\r\n"]
[26.128345, "o", "\u001b[?2004l\r"]
[26.128384, "o", "\u001b[?2004h"]
[26.12842, "o", "> "]
[26.128742, "o", "-        from flask import abort\r\n"]
[26.128777, "o", "\u001b[?2004l\r"]
[26.128811, "o", "\u001b[?2004h"]
[26.128847, "o", "> "]
[26.129408, "o", "-        abort(400, description=\"x_org_id_required\")\r\n"]
[26.129419, "o", "\u001b[?2004l\r"]
[26.129466, "o", "\u001b[?2004h"]
[26.129499, "o", "> "]
[26.129702, "o", "-    return org_id\r\n"]
[26.129738, "o", "\u001b[?2004l\r"]
[26.129771, "o", "\u001b[?2004h"]
[26.129805, "o", "> "]
[26.130087, "o", "+def require_active_org():\r\n"]
[26.130125, "o", "\u001b[?2004l\r"]
[26.130162, "o", "\u001b[?2004h"]
[26.130189, "o", "> "]
[26.130748, "o", "+    \"\"\"Validate and return the active organisation id.\r\n"]
[26.130758, "o", "\u001b[?2004l\r"]
[26.13081, "o", "\u001b[?2004h"]
[26.130844, "o", "> "]
[26.130886, "o", "+\r\n\u001b[?2004l\r"]
[26.130934, "o", "\u001b[?2004h"]
[26.130969, "o", "> "]
[26.131557, "o", "+    The policy (PERMISSIONS.md, section 2) requires:\r\n"]
[26.131579, "o", "\u001b[?2004l\r"]
[26.131622, "o", "\u001b[?2004h"]
[26.131662, "o", "> "]
[26.132533, "o", "+    * The ``X-Org-Id`` header (or the user's home organisation) must resolve to an\r\n"]
[26.132543, "o", "\u001b[?2004l\r"]
[26.132588, "o", "\u001b[?2004h"]
[26.132622, "o", "> "]
[26.13292, "o", "+      existing organisation.\r\n"]
[26.132932, "o", "\u001b[?2004l\r"]
[26.132981, "o", "\u001b[?2004h"]
[26.133014, "o", "> "]
[26.133907, "o", "+    * For regular users (non‑support) the organisation must be one they belong to\r\n"]
[26.133945, "o", "\u001b[?2004l\r"]
[26.133983, "o", "\u001b[?2004h"]
[26.134016, "o", "> "]
[26.134505, "o", "+      (present in ``g.identity.memberships``).\r\n"]
[26.134541, "o", "\u001b[?2004l\r"]
[26.134572, "o", "\u001b[?2004h"]
[26.134613, "o", "> "]
[26.135401, "o", "+    * Support staff may choose any existing organisation, but must supply the\r\n"]
[26.135411, "o", "\u001b[?2004l\r"]
[26.135456, "o", "\u001b[?2004h"]
[26.135488, "o", "> "]
[26.135998, "o", "+      header; otherwise a ``400`` is returned.\r\n"]
[26.136009, "o", "\u001b[?2004l\r"]
[26.136057, "o", "\u001b[?2004h"]
[26.13609, "o", "> "]
[26.136123, "o", "+\r\n\u001b[?2004l\r"]
[26.136169, "o", "\u001b[?2004h"]
[26.136204, "o", "> "]
[26.136893, "o", "+    The function aborts with a suitable 4xx status code when the requirements are\r\n\u001b[?2004l\r"]
[26.136938, "o", "\u001b[?2004h"]
[26.136978, "o", "> "]
[26.137474, "o", "+    not met and returns the validated organisation id otherwise.\r\n"]
[26.137512, "o", "\u001b[?2004l\r"]
[26.137545, "o", "\u001b[?2004h"]
[26.137575, "o", "> "]
[26.137615, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[26.13765, "o", "\u001b[?2004h"]
[26.137686, "o", "> "]
[26.13787, "o", "+    org_id = g.identity.org_id\r\n\u001b[?2004l\r"]
[26.137914, "o", "\u001b[?2004h"]
[26.13795, "o", "> "]
[26.138465, "o", "+    # If the header was omitted and the user is support, ``org_id`` will be ``None``.\r\n\u001b[?2004l\r"]
[26.1385, "o", "\u001b[?2004h"]
[26.138538, "o", "> "]
[26.138671, "o", "+    if org_id is None:\r\n\u001b[?2004l\r"]
[26.138706, "o", "\u001b[?2004h"]
[26.13874, "o", "> "]
[26.138939, "o", "+        from flask import abort\r\n\u001b[?2004l\r"]
[26.138993, "o", "\u001b[?2004h> "]
[26.139323, "o", "+        abort(400, description=\"x_org_id_required\")\r\n\u001b[?2004l\r"]
[26.139367, "o", "\u001b[?2004h"]
[26.139404, "o", "> "]
[26.139441, "o", "+\r\n\u001b[?2004l\r"]
[26.139477, "o", "\u001b[?2004h> "]
[26.139688, "o", "+    # Verify the organisation exists.\r\n\u001b[?2004l\r"]
[26.139723, "o", "\u001b[?2004h"]
[26.139765, "o", "> "]
[26.140245, "o", "+    org_row = db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,))\r\n\u001b[?2004l\r"]
[26.140283, "o", "\u001b[?2004h"]
[26.140324, "o", "> "]
[26.140481, "o", "+    if org_row is None:\r\n\u001b[?2004l\r"]
[26.140517, "o", "\u001b[?2004h"]
[26.140549, "o", "> "]
[26.14106, "o", "+        # For simplicity, return a 404 – callers should not learn whether the id\r\n\u001b[?2004l\r"]
[26.141103, "o", "\u001b[?2004h"]
[26.141143, "o", "> "]
[26.141503, "o", "+        # exists, matching the policy's allowance of 403/404.\r\n\u001b[?2004l\r"]
[26.141544, "o", "\u001b[?2004h"]
[26.141583, "o", "> "]
[26.141767, "o", "+        from flask import abort\r\n\u001b[?2004l\r"]
[26.141804, "o", "\u001b[?2004h"]
[26.141846, "o", "> "]
[26.142142, "o", "+        abort(404, description=\"org_not_found\")\r\n\u001b[?2004l\r"]
[26.142177, "o", "\u001b[?2004h"]
[26.142213, "o", "> "]
[26.142229, "o", "+\r\n\u001b[?2004l\r"]
[26.142267, "o", "\u001b[?2004h> "]
[26.142698, "o", "+    # Regular (non‑support) users must belong to the organisation.\r\n\u001b[?2004l\r"]
[26.142743, "o", "\u001b[?2004h"]
[26.142775, "o", "> "]
[26.142984, "o", "+    if not g.identity.is_support:\r\n\u001b[?2004l\r"]
[26.143025, "o", "\u001b[?2004h> "]
[26.143341, "o", "+        if org_id not in g.identity.memberships:\r\n\u001b[?2004l\r"]
[26.14339, "o", "\u001b[?2004h> "]
[26.143621, "o", "+            from flask import abort\r\n\u001b[?2004l\r"]
[26.143657, "o", "\u001b[?2004h"]
[26.14369, "o", "> "]
[26.144027, "o", "+            abort(403, description=\"org_not_allowed\")\r\n\u001b[?2004l\r"]
[26.144072, "o", "\u001b[?2004h"]
[26.144102, "o", "> "]
[26.14462, "o", "+    # Support staff are allowed any existing organisation (already checked above).\r\n\u001b[?2004l\r"]
[26.144656, "o", "\u001b[?2004h"]
[26.144691, "o", "> "]
[26.144794, "o", "+    return org_id\r\n\u001b[?2004l\r"]
[26.14483, "o", "\u001b[?2004h"]
[26.144888, "o", "> "]
[26.144971, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[26.145024, "o", "\u001b[?2004h> "]
