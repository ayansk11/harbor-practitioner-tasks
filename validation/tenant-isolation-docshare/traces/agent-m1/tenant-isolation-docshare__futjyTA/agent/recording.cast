[48.189365, "o", "\u001b[31m\u001b[1m_________________________________________________________ test_support_reads_any_org_but_cannot_rename _________________________________________________________\u001b[0m\r\n\r\n"]
[48.189387, "o", "env = (<FlaskClient <Flask 'docshare.app'>>, {'orgs': [{'id': '21bade02-6a6a-4768-b2ed-66ffdcc99396', 'name': 'Halden & Pric...6ffdcc99396', 'folder_id': '98d48663-6dd9-4e7b-8e1a-0cc7bcc3b287', 'name': 'payroll-summary-0a97.md', ...}, ...], ...})\r\n\r\n"]
[48.210206, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_support_reads_any_org_but_cannot_rename\u001b[39;49;00m(env):\u001b[90m\u001b[39;49;00m\r\n        client, s = env\u001b[90m\u001b[39;49;00m\r\n        riley = user(s, \u001b[33m\"\u001b[39;49;00m\u001b[33mriley@support.docshare.example\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m org \u001b[95min\u001b[39;49;00m s[\u001b[33m\"\u001b[39;49;00m\u001b[33morgs\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]:\u001b[90m\u001b[39;49;00m\r\n            f = org_files(s, org[\u001b[33m\"\u001b[39;49;00m\u001b[33mid\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m])[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m client.get(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/api/files/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mf[\u001b[33m'\u001b[39;49;00m\u001b[33mid\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m]\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, headers=h(riley)).status_code == \u001b[94m200\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[48.210225, "o", "\u001b[1m\u001b[31mE           AssertionError: assert 400 == 200\u001b[0m\r\n\u001b[1m\u001b[31mE            +  where 400 = <WrapperTestResponse streamed [400 BAD REQUEST]>.status_code\u001b[0m\r\n\u001b[1m\u001b[31mE            +    where <WrapperTestResponse streamed [400 BAD REQUEST]> = get('/api/files/d335427f-cd7d-41d4-a993-74b83e88aa32', headers={'Authorization': 'Bearer dsk_f9c215672ac38adf41b079157a6d7ff3'})\u001b[0m\r\n\u001b[1m\u001b[31mE            +      where get = <FlaskClient <Flask 'docshare.app'>>.get\u001b[0m\r\n"]
[48.210302, "o", "\u001b[1m\u001b[31mE            +      and   {'Authorization': 'Bearer dsk_f9c215672ac38adf41b079157a6d7ff3'} = h({'id': 'd84ae56d-b93b-4169-a144-c4eecf3c3005', 'name': 'Riley Chen', 'email': 'riley@support.docshare.example', 'token': 'dsk_f9c215672ac38adf41b079157a6d7ff3', ...})\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_api.py\u001b[0m:94: AssertionError\r\n"]
[48.21043, "o", "\u001b[36m\u001b[1m=================================================================== short test summary info ====================================================================\u001b[0m\r\n\u001b[31mFAILED\u001b[0m tests/test_api.py::\u001b[1mtest_support_reads_any_org_but_cannot_rename\u001b[0m - AssertionError: assert 400 == 200\r\n"]
[48.210501, "o", "\u001b[31m\u001b[31m\u001b[1m1 failed\u001b[0m, \u001b[32m8 passed\u001b[0m\u001b[31m in 0.43s\u001b[0m\u001b[0m\r\n"]
[48.251925, "o", "\u001b[?2004h"]
[48.252057, "o", "root@6dac5c62-598e-49fe-8973-206b888602c1:/app# "]
[87.855779, "i", "sed -n '1,200p' docshare/routes/folders.py\n"]
[87.855979, "o", "sed -n '1,200p' docshare/routes/folders.py\r\n\u001b[?2004l\r"]
[87.857479, "o", "\"\"\"Folder endpoints: the folders of the active organisation and their files.\"\"\"\r\nfrom flask import Blueprint, abort, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_active_org\r\n"]
[87.857513, "o", "\r\nbp = Blueprint(\"folders\", __name__)\r\n\r\n\r\n"]
[87.857541, "o", "@bp.get(\"/api/folders\")\r\n@login_required\r\ndef list_folders():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(\"SELECT id, org_id, name FROM folders WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(folders=[db.folder_json(r) for r in rows])\r\n\r\n\r\n@bp.get(\"/api/folders/<folder_id>/files\")\r\n@login_required\r\ndef folder_files(folder_id):\r\n    org_id = require_active_org()\r\n    folder = db.query_one(\"SELECT id, org_id, name FROM folders WHERE id = ? AND org_id = ?\", (folder_id, org_id))\r\n    if folder is None:\r\n        abort(404)\r\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE folder_id = ? AND org_id = ? ORDER BY name\",\r\n                        (folder_id, org_id))\r\n    return jsonify(folder=db.folder_json(folder), files=[db.file_json(r) for r in rows])\r\n"]
[87.857797, "o", "\u001b[?2004h"]
[87.857818, "o", "root@6dac5c62-598e-49fe-8973-206b888602c1:/app# "]
[88.223159, "i", "sed -n '1,200p' docshare/routes/export.py\n"]
[88.223343, "o", "sed -n '1,200p' docshare/routes/export.py\r\n\u001b[?2004l\r"]
[88.224788, "o", "\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\nimport base64\r\n\r\nfrom flask import Blueprint, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"export\", __name__)\r\n\r\nMAX_IDS = 50\r\n\r\n"]
[88.224846, "o", "\r\n@bp.post(\"/api/export\")\r\n@login_required\r\ndef export():\r\n    body = request.get_json(silent=True) or {}\r\n    ids = body.get(\"file_ids\")\r\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n        abort(400, description=\"bad_file_ids\")\r\n    # A selection always comes from one folder view, so the first file tells us whose files these are.\r\n    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\r\n"]
[88.224897, "o", "    if first is None:\r\n        abort(404)\r\n    if not g.identity.is_support and first[\"org_id\"] != g.identity.org_id:\r\n        abort(404)\r\n    out = []\r\n    for file_id in ids:\r\n        row = db.query_one(\"SELECT id, name, mime_type, size, content FROM files WHERE id = ?\", (file_id,))\r\n        if row is None:\r\n            abort(404)\r\n        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n    return jsonify(files=out)\r\n"]
[88.225082, "o", "\u001b[?2004h"]
[88.225123, "o", "root@6dac5c62-598e-49fe-8973-206b888602c1:/app# "]
[88.594878, "i", "sed -n '1,200p' docshare/routes/thumbs.py\n"]
[88.59508, "o", "sed -n '1,200p' docshare/routes/thumbs.py\r\n\u001b[?2004l\r"]
[88.596375, "o", "\"\"\"SVG previews for the file grid.\"\"\"\r\nimport html\r\n\r\nfrom flask import Blueprint, Response, abort\r\n\r\nfrom .. import db\r\n"]
[88.596416, "o", "from ..auth import login_required\r\n\r\nbp = Blueprint(\"thumbs\", __name__)\r\n\r\nTEXT_TYPES = (\"text/\", \"application/json\")\r\n\r\n\r\ndef render_thumb(name, mime_type, content):\r\n    lines = []\r\n    if mime_type.startswith(TEXT_TYPES):\r\n        text = bytes(content).decode(\"utf-8\", \"replace\")\r\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\r\n    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\r\n             f\"<title>{html.escape(name)}</title>\",\r\n             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n"]
[88.596447, "o", "             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n    for i, ln in enumerate(lines):\r\n        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\r\n    parts.append(\"</svg>\")\r\n    return \"\\n\".join(parts)\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/thumb\")\r\n@login_required\r\ndef thumb(file_id):\r\n    row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n"]
[88.596472, "o", "    if row is None:\r\n        abort(404)\r\n    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n    return Response(svg, mimetype=\"image/svg+xml\")\r\n"]
[88.59669, "o", "\u001b[?2004h"]
[88.596713, "o", "root@6dac5c62-598e-49fe-8973-206b888602c1:/app# "]
[88.981769, "i", "sed -n '1,200p' docshare/routes/admin.py\n"]
[88.98202, "o", "sed -n '1,200p' docshare/routes/admin.py\r\n\u001b[?2004l\r"]
[88.984338, "o", "\"\"\"Support console: an overview of every organisation (support staff only).\"\"\"\r\nfrom flask import Blueprint, abort, g, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"admin\", __name__)\r\n\r\n"]
[88.984357, "o", "\r\n@bp.get(\"/api/admin/orgs\")\r\n@login_required\r\ndef orgs():\r\n    if not g.identity.is_support:\r\n        abort(403)\r\n    rows = db.query_all(\"SELECT o.id, o.name, (SELECT COUNT(*) FROM files f WHERE f.org_id = o.id) AS file_count \"\r\n                        \"FROM orgs o ORDER BY o.name\")\r\n"]
[88.984366, "o", "    return jsonify(orgs=[{\"id\": r[\"id\"], \"name\": r[\"name\"], \"file_count\": r[\"file_count\"]} for r in rows])\r\n"]
[88.98463, "o", "\u001b[?2004hroot@6dac5c62-598e-49fe-8973-206b888602c1:/app# "]
[96.177304, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: docshare/auth.py\n@@\n-    @functools.wraps(view)\n-    def wrapper(*args, **kwargs):\n-        ident = load_identity()\n-        if ident is None:\n-            return jsonify(error=\"unauthorized\"), 401\n-        g.identity = ident\n-        # Enforce active organisation validation for every protected endpoint.\n-        # ``require_active_org`` will abort with the appropriate HTTP error code\n-        # if the organisation is missing, unknown, or not permitted for the user.\n-        require_active_org()\n-        return view(*args, **kwargs)\n+    @functools.wraps(view)\n+    def wrapper(*args, **kwargs):\n+        ident = load_identity()\n+        if ident is None:\n+            return jsonify(error=\"unauthorized\"), 401\n+        g.identity = ident\n+        # Enforce active‑organisation validation for regular users only.\n+        # Support staff are allowed to read any organisation without an X‑Org‑Id header,\n+        # and the endpoints that need an explicit org"]
[96.177345, "i", "anisation (list endpoints) call\n+        # ``require_active_org`` themselves.\n+        if not ident.is_support:\n+            require_active_org()\n+        return view(*args, **kwargs)\n*** End Patch\nPATCH\n"]
