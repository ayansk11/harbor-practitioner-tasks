[47.583422, "o", "pytest -q\r\n\u001b[?2004l\r"]
[47.950433, "o", "\u001b[32m.\u001b[0m"]
[47.967887, "o", "\u001b[32m.\u001b[0m"]
[47.999881, "o", "\u001b[32m.\u001b[0m"]
[48.027164, "o", "\u001b[32m.\u001b[0m"]
[48.062732, "o", "\u001b[32m.\u001b[0m"]
[48.080578, "o", "\u001b[32m.\u001b[0m"]
[48.121129, "o", "\u001b[31mF\u001b[0m"]
[48.157208, "o", "\u001b[32m.\u001b[0m"]
[48.18748, "o", "\u001b[32m.\u001b[0m"]
