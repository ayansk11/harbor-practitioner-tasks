[11.483495, "o", "root@4d975914-2fbc-48cb-acd8-3c453245c531:/app# "]
[12.002182, "i", "cat /app/docshare/db.py\n"]
[12.002505, "o", "cat /app/docshare/db.py\r\n"]
[12.002561, "o", "\u001b[?2004l\r"]
[12.00382, "o", "\"\"\"SQLite access. One connection per request (see app.py); rows come back as sqlite3.Row.\"\"\"\r\nimport sqlite3\r\n\r\nfrom flask import g\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS orgs (\r\n    id TEXT PRIMARY KEY,\r\n    name TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS users (\r\n    id TEXT PRIMARY KEY,\r\n    email TEXT NOT NULL UNIQUE,\r\n    name TEXT NOT NULL,\r\n    token TEXT NOT NULL UNIQUE,\r\n    home_org_id TEXT REFERENCES orgs(id),\r\n    is_support INTEGER NOT NULL DEFAULT 0\r\n);\r\nCREATE TABLE IF NOT EXISTS memberships (\r\n    user_id TEXT NOT NULL REFERENCES users(id),\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    role TEXT NOT NULL CHECK (role IN ('member', 'org_admin')),\r\n    PRIMARY KEY (user_id, org_id)\r\n);\r\nCREATE TABLE IF NOT EXISTS folders (\r\n    id TEXT PRIMARY KEY,\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    name TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS files (\r\n    id TEXT PRIMARY KEY,\r\n    org_id TEXT NOT NULL REFERENCES orgs(id),\r\n    folder_id TEXT NOT NULL REFERENCES folders(id),\r\n"]
[12.00388, "o", "    name TEXT NOT NULL,\r\n    mime_type TEXT NOT NULL,\r\n    size INTEGER NOT NULL,\r\n    content BLOB NOT NULL,\r\n    uploaded_by TEXT NOT NULL REFERENCES users(id),\r\n    created_at TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS shares (\r\n    token TEXT PRIMARY KEY,\r\n    file_id TEXT NOT NULL REFERENCES files(id),\r\n    created_by TEXT NOT NULL REFERENCES users(id),\r\n    created_at TEXT NOT NULL,\r\n    revoked_at TEXT\r\n);\r\nCREATE INDEX IF NOT EXISTS files_org ON files(org_id, name);\r\nCREATE INDEX IF NOT EXISTS files_folder ON files(folder_id, name);\r\nCREATE INDEX IF NOT EXISTS shares_file ON shares(file_id);\r\n\"\"\"\r\n\r\nFILE_COLUMNS = \"id, org_id, folder_id, name, mime_type, size, uploaded_by, created_at\"\r\n\r\n\r\ndef connect(path):\r\n    conn = sqlite3.connect(path, timeout=10)\r\n    conn.row_factory = sqlite3.Row\r\n    conn.execute(\"PRAGMA foreign_keys = ON\")\r\n    conn.execute(\"PRAGMA busy_timeout = 10000\")\r\n    return conn\r\n\r\n\r\ndef get_db():\r\n    if \"db\" not in g:\r\n        from flask import current_app\r\n        g.db = conn"]
[12.003935, "o", "ect(current_app.config[\"DB_PATH\"])\r\n    return g.db\r\n\r\n\r\ndef close_db(_exc=None):\r\n    conn = g.pop(\"db\", None)\r\n    if conn is not None:\r\n        conn.close()\r\n\r\n\r\ndef query_one(sql, params=()):\r\n    return get_db().execute(sql, params).fetchone()\r\n\r\n\r\ndef query_all(sql, params=()):\r\n    return get_db().execute(sql, params).fetchall()\r\n\r\n\r\ndef execute(sql, params=()):\r\n    conn = get_db()\r\n    cur = conn.execute(sql, params)\r\n    conn.commit()\r\n    return cur.rowcount\r\n\r\n\r\ndef file_json(row):\r\n    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"folder_id\": row[\"folder_id\"], \"name\": row[\"name\"],\r\n            \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"], \"uploaded_by\": row[\"uploaded_by\"],\r\n            \"created_at\": row[\"created_at\"]}\r\n\r\n\r\ndef folder_json(row):\r\n    return {\"id\": row[\"id\"], \"org_id\": row[\"org_id\"], \"name\": row[\"name\"]}\r\n"]
[12.004144, "o", "\u001b[?2004h"]
[12.004218, "o", "root@4d975914-2fbc-48cb-acd8-3c453245c531:/app# "]
[12.507055, "i", "cat /app/docshare/serve.py\n"]
[12.507203, "o", "cat /app/docshare/serve.py\r\n\u001b[?2004l\r"]
[12.509339, "o", "\"\"\"Run the API: python -m docshare.serve --db <path> --port <port>.\"\"\"\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nfrom waitress import serve\r\n\r\nfrom . import db\r\nfrom .app import create_app\r\n\r\n\r\ndef main(argv=None):\r\n    p = argparse.ArgumentParser(description=\"docshare API server\")\r\n    p.add_argument(\"--db\", required=True, help=\"path to an existing docshare SQLite database\")\r\n    p.add_argument(\"--port\", type=int, default=8080)\r\n    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    p.add_argument(\"--threads\", type=int, default=4)\r\n    args = p.parse_args(argv)\r\n    if not os.path.isfile(args.db):\r\n        sys.exit(f\"database not found: {args.db}\")\r\n    conn = db.connect(args.db)\r\n    conn.execute(\"PRAGMA journal_mode = WAL\")\r\n    conn.close()\r\n    serve(create_app(os.path.abspath(args.db)), host=args.host, port=args.port, threads=args.threads,\r\n          ident=\"docshare\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[12.509691, "o", "\u001b[?2004hroot@4d975914-2fbc-48cb-acd8-3c453245c531:/app# "]
