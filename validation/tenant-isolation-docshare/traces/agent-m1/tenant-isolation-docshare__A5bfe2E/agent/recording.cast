[82.861009, "o", "\u001b[?2004h> "]
[82.861058, "o", "        abort(404)\r\n\u001b[?2004l\r"]
[82.861094, "o", "\u001b[?2004h"]
[82.861115, "o", "> "]
[82.861317, "o", "    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n\u001b[?2004l\r"]
[82.86134, "o", "\u001b[?2004h"]
[82.861361, "o", "> "]
[82.861523, "o", "    return Response(svg, mimetype=\"image/svg+xml\")\r\n\u001b[?2004l\r"]
[82.861549, "o", "\u001b[?2004h"]
