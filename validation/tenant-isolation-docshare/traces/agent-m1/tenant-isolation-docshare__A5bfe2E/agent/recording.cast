[81.969773, "i", "cat > /app/docshare/auth.py << 'EOF'\n\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\nimport functools\nfrom dataclasses import dataclass, field\n\nfrom flask import abort, g, jsonify, request\n\nfrom . import db\n\n\n@dataclass\nclass Identity:\n    user_id: str\n    email: str\n    name: str\n    is_support: bool\n    org_id: str | None          # the active organisation for this request\n    role: str                   # \"member\", \"org_admin\" or \"support\"\n    memberships: dict = field(default_factory=dict)   # org_id -> role\n\n\ndef _bearer_token():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    return header[len(\"Bearer \"):].strip() or None\n\n\ndef load_identity():\n    token = _bearer_token()\n    if token is None:\n        return None\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\n    if user is None:\n        return None\n    memberships = {r[\"org_id"]
[81.969891, "i", "\"]: r[\"role\"] for r in\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\n    # Determine the active organisation\n    header_org = request.headers.get(\"X-Org-Id\")\n    if header_org is not None and header_org.strip():\n        org_id = header_org.strip()\n    elif user[\"is_support\"]:\n        org_id = None  # support has no home org; must use X-Org-Id for listing\n    else:\n        org_id = user[\"home_org_id\"]\n\n    if user[\"is_support\"]:\n        role = \"support\"\n        if org_id is not None:\n            # Support must name an existing organisation\n            org = db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,))\n            if org is None:\n                abort(404)\n    else:\n        # Member/org_admin: the active org must be one they belong to\n        if org_id is None:\n            abort(403)\n        if org_id not in memberships:\n            abort(403)\n        role = memberships[org_id]\n\n    return Identity(user_id=user[\"id\"], email=user[\"email\"]"]
[81.969923, "i", ", name=user[\"name\"], is_support=bool(user[\"is_support\"]),\n                    org_id=org_id, role=role, memberships=memberships)\n\n\ndef login_required(view):\n    @functools.wraps(view)\n    def wrapper(*args, **kwargs):\n        ident = load_identity()\n        if ident is None:\n            return jsonify(error=\"unauthorized\"), 401\n        g.identity = ident\n        return view(*args, **kwargs)\n    return wrapper\n\n\ndef require_active_org():\n    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\n    org_id = g.identity.org_id\n    if org_id is None:\n        abort(400, description=\"x_org_id_required\")\n    return org_id\nEOF\n"]
