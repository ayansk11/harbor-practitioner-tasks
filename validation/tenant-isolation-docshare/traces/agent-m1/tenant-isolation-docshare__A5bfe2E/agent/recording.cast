[83.336429, "i", "cat > /app/docshare/routes/export.py << 'EOF'\n\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\nimport base64\n\nfrom flask import Blueprint, abort, g, jsonify, request\n\nfrom .. import db\nfrom ..auth import login_required\n\nbp = Blueprint(\"export\", __name__)\n\nMAX_IDS = 50\n\n\n@bp.post(\"/api/export\")\n@login_required\ndef export():\n    body = request.get_json(silent=True) or {}\n    ids = body.get(\"file_ids\")\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\n        abort(400, description=\"bad_file_ids\")\n    out = []\n    for file_id in ids:\n        row = db.query_one(\"SELECT id, name, mime_type, size, content, org_id FROM files WHERE id = ?\", (file_id,))\n        if row is None:\n            abort(404)\n        if not g.identity.is_support and row[\"org_id\"] != g.identity.org_id:\n            abort(404)\n        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\n     "]
[83.336459, "i", "               \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\n    return jsonify(files=out)\nEOF\n"]
