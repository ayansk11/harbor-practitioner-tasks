[139.070258, "i", "python3 -c \"\nimport urllib.request, json\n\n# Test 1: Ben (Halden & Price member) tries to download Marlow file\nreq = urllib.request.Request('http://127.0.0.1:8080/api/files/20b5d1d4-8637-49fb-adad-7770457f9573/download')\nreq.add_header('Authorization', 'Bearer dsk_2e09e4b8245edebc817af708207473b7')\ntry:\n    resp = urllib.request.urlopen(req)\n    print(f'Test 1 FAIL: got {resp.status}')\nexcept urllib.error.HTTPError as e:\n    print(f'Test 1 PASS: got {e.code} (expected 404)')\n\n# Test 2: Ben lists his own files (should work)\nreq = urllib.request.Request('http://127.0.0.1:8080/api/files')\nreq.add_header('Authorization', 'Bearer dsk_2e09e4b8245edebc817af708207473b7')\nresp = urllib.request.urlopen(req)\ndata = json.loads(resp.read())\nprint(f'Test 2: Ben lists {len(data[\\\"files\\\"])} files, status {resp.status}')\n\n# Test 3: Grace switches to Tessaract and lists files (should work)\nreq = urllib.request.Request('http://127.0.0.1:8080/api/files')\nreq.add_header('Authorization', 'Bearer dsk_1428dfad70ce79934498d7d67c213c1"]
