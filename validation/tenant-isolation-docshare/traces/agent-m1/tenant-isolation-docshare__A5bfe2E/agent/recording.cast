[7.915557, "o", "# docshare\r\n\r\nThe document sharing API in front of the ingest worker's store: organisations, folders, files, share links and a\r\nsupport console. Python 3.12, Flask, waitress, SQLite.\r\n\r\n- Run: `python -m docshare.serve --db data/docshare.db --port 8080` (from /app).\r\n- Fresh development database: `python -m docshare.seed --out data/docshare.db --force`.\r\n- Feature tests: `python -m pytest -q tests`.\r\n- Docs: `docs/API.md` (endpoints), `docs/PERMISSIONS.md` (who may do what), `docs/DEV_USERS.md` (development users\r\n  and tokens).\r\n- Open security report: `SECURITY_REPORT.md`.\r\n\r\nLayout: `docshare/auth.py` (tokens and the active organisation), `docshare/routes/` (`files.py`, `folders.py`,\r\n`thumbs.py`, `export.py`, `share.py`, `admin.py`), `docshare/db.py` (schema and helpers), `docshare/seed.py`\r\n(development data).\r\n"]
[7.915733, "o", "\u001b[?2004h"]
[7.915814, "o", "root@4d975914-2fbc-48cb-acd8-3c453245c531:/app# "]
[11.481098, "i", "cat /app/docshare/auth.py\n"]
[11.481241, "o", "cat /app/docshare/auth.py\r\n\u001b[?2004l\r"]
[11.483179, "o", "\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\r\nimport functools\r\nfrom dataclasses import dataclass, field\r\n\r\nfrom flask import g, jsonify, request\r\n\r\nfrom . import db\r\n\r\n\r\n@dataclass\r\nclass Identity:\r\n    user_id: str\r\n    email: str\r\n    name: str\r\n    is_support: bool\r\n    org_id: str | None          # the active organisation for this request\r\n    role: str                   # \"member\", \"org_admin\" or \"support\"\r\n    memberships: dict = field(default_factory=dict)   # org_id -> role\r\n\r\n\r\ndef _bearer_token():\r\n    header = request.headers.get(\"Authorization\", \"\")\r\n    if not header.startswith(\"Bearer \"):\r\n        return None\r\n    return header[len(\"Bearer \"):].strip() or None\r\n\r\n\r\ndef load_identity():\r\n    token = _bearer_token()\r\n    if token is None:\r\n        return None\r\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\r\n    if user is None:\r\n        return None\r\n    memberships = {r[\"org_id\"]: r[\"rol"]
[11.48325, "o", "e\"] for r in\r\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\r\n    # The web client only offers organisations listed by /api/me, so the header names one of the user's orgs.\r\n    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\r\n    if user[\"is_support\"]:\r\n        role = \"support\"\r\n    else:\r\n        role = memberships.get(org_id, \"member\")\r\n    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\r\n                    org_id=org_id, role=role, memberships=memberships)\r\n\r\n\r\ndef login_required(view):\r\n    @functools.wraps(view)\r\n    def wrapper(*args, **kwargs):\r\n        ident = load_identity()\r\n        if ident is None:\r\n            return jsonify(error=\"unauthorized\"), 401\r\n        g.identity = ident\r\n        return view(*args, **kwargs)\r\n    return wrapper\r\n\r\n\r\ndef require_active_org():\r\n    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anythi"]
[11.483288, "o", "ng.\"\"\"\r\n    org_id = g.identity.org_id\r\n    if org_id is None:\r\n        from flask import abort\r\n        abort(400, description=\"x_org_id_required\")\r\n    return org_id\r\n"]
