[13.068988, "o", "ls /app/docshare/routes/\r\n\u001b[?2004l\r"]
[13.070256, "o", "__init__.py  admin.py  export.py  files.py  folders.py\tshare.py  thumbs.py\r\n"]
[13.070468, "o", "\u001b[?2004h"]
