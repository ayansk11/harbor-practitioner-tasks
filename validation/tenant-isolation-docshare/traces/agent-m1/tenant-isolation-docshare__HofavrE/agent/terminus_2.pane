[?2004l[?2004h> """Share links: create, revoke, and the public download behind /s/<token>."""
[?2004l[?2004h> import secrets
[?2004l[?2004h> from datetime import datetime, timezone
[?2004l[?2004h> 
[?2004l[?2004h> from flask import Blueprint, abort, g, jsonify
[?2004l[?2004h> 
[?2004l[?2004h> from .. import db
[?2004l[?2004h> from ..auth import login_required
[?2004l[?2004h> from .files import file_response, get_file_authorized
[?2004l[?2004h> 
[?2004l[?2004h> bp = Blueprint("share", __name__)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def now_iso():
[?2004l[?2004h>     return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.post("/api/files/<file_id>/shares")
[?2004l[?2004h> @login_required
[?2004l[?2004h> def create_share(file_id):
[?2004l[?2004h>     if g.identity.role not in ("member", "org_admin"):
[?2004l[?2004h>         abort(403)
[?2004l[?2004h>     row = get_file_authorized(file_id)
[?2004l[?2004h>     token = secrets.token_urlsafe(18)
[?2004l[?2004h>     created = now_iso()
[?2004l[?2004h>     db.execute("INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)",
[?2004l[?2004h>                (token, row["id"], g.identity.user_id, created))
[?2004l[?2004h>     return jsonify(token=token, url=f"/s/{token}", file_id=row["id"], created_at=created), 201
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.delete("/api/shares/<token>")
[?2004l[?2004h> @login_required
[?2004l[?2004h> def revoke_share(token):
[?2004l[?2004h>     row = db.query_one("SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?",
[?2004l[?2004h>                        (token,))
[?2004l[?2004h>     if row is None or row["org_id"] != g.identity.org_id or g.identity.role not in ("member", "org_admin"):
[?2004l[?2004h>         abort(404)
[?2004l[?2004h>     db.execute("UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL", (now_iso(), token))
[?2004l[?2004h>     return "", 204
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @bp.get("/s/<token>")
