[?2004l[?2004h> import functools
[?2004l[?2004h> from dataclasses import dataclass, field
[?2004l[?2004h> 
[?2004l[?2004h> from flask import g, jsonify, request, abort
[?2004l[?2004h> 
[?2004l[?2004h> from . import db
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass
[?2004l[?2004h> class Identity:
[?2004l[?2004h>     user_id: str
[?2004l[?2004h>     email: str
[?2004l[?2004h>     name: str
[?2004l[?2004h>     is_support: bool
[?2004l[?2004h>     org_id: str | None          # the active organisation for this request
[?2004l[?2004h>     role: str                   # "member", "org_admin" or "support"
[?2004l[?2004h>     memberships: dict = field(default_factory=dict)   # org_id -> role
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _bearer_token():
[?2004l[?2004h>     header = request.headers.get("Authorization", "")
[?2004l[?2004h>     if not header.startswith("Bearer "):
[?2004l[?2004h>         return None
[?2004l[?2004h>     return header[len("Bearer "):].strip() or None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_identity():
[?2004l[?2004h>     token = _bearer_token()
[?2004l[?2004h>     if token is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     user = db.query_one("SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?", (token,))
[?2004l[?2004h>     if user is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     memberships = {r["org_id"]: r["role"] for r in
[?2004l[?2004h>                    db.query_all("SELECT org_id, role FROM memberships WHERE user_id = ?", (user["id"],))}
[?2004l[?2004h>     
[?2004l[?2004h>     org_id = request.headers.get("X-Org-Id") or user["home_org_id"]
[?2004l[?2004h>     
[?2004l[?2004h>     if org_id is not None:
[?2004l[?2004h>         # Verify org exists
[?2004l[?2004h>         if not db.query_one("SELECT id FROM orgs WHERE id = ?", (org_id,)):
[?2004l[?2004h>             abort(403)
[?2004l[?2004h>         
[?2004l[?2004h>         if not user["is_support"]:
[?2004l[?2004h>             if org_id not in memberships:
[?2004l[?2004h>                 abort(403)
[?2004l[?2004h>             role = memberships[org_id]
[?2004l[?2004h>         else:
[?2004l[?2004h>             role = "support"
[?2004l[?2004h>     else:
[?2004l[?2004h>         # No org_id provided (and no home_org_id). This is only okay for support staff
[?2004l[?2004h>         # who aren't listing things yet.
[?2004l[?2004h>         if user["is_support"]:
[?2004l[?2004h>             role = "support"
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Non-support must have a home_org_id
[?2004l[?2004h>             abort(403)
[?2004l[?2004h>             
[?2004l[?2004h>     return Identity(user_id=user["id"], email=user["email"], name=user["name"], is_support=bool(user["is_support"]),
[?2004l[?2004h>                     org_id=org_id, role=role, memberships=memberships)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def login_required(view):
[?2004l[?2004h>     @functools.wraps(view)
[?2004l[?2004h>     def wrapper(*args, **kwargs):
[?2004l[?2004h>         ident = load_identity()
[?2004l[?2004h>         if ident is None:
