[83.793495, "o", "\u001b[?2004h"]
[83.793538, "o", "> "]
[83.794399, "o", "        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n\u001b[?2004l\r"]
[83.794455, "o", "\u001b[?2004h"]
[83.794495, "o", "> "]
[83.795254, "o", "                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n\u001b[?2004l\r"]
[83.795303, "o", "\u001b[?2004h"]
[83.795344, "o", "> "]
[83.795598, "o", "    return jsonify(files=out)\r\n\u001b[?2004l\r"]
[83.795661, "o", "\u001b[?2004h"]
[83.795709, "o", "> "]
