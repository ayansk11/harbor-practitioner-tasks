[56.266799, "o", "\u001b[?2004h"]
[56.266819, "o", "> "]
[56.267107, "o", "    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\r\n\u001b[?2004l\r"]
[56.267142, "o", "\u001b[?2004h"]
[56.267163, "o", "> "]
[56.26724, "o", "    org_id = g.identity.org_id\r\n\u001b[?2004l\r"]
[56.267266, "o", "\u001b[?2004h> "]
[56.267341, "o", "    if org_id is None:\r\n\u001b[?2004l\r"]
[56.267367, "o", "\u001b[?2004h> "]
