[83.790253, "o", "\u001b[?2004h"]
[83.790299, "o", "> "]
[83.790662, "o", "    body = request.get_json(silent=True) or {}\r\n"]
[83.790674, "o", "\u001b[?2004l\r"]
[83.790725, "o", "\u001b[?2004h"]
[83.790766, "o", "> "]
[83.791014, "o", "    ids = body.get(\"file_ids\")\r\n"]
[83.791043, "o", "\u001b[?2004l\r"]
[83.791092, "o", "\u001b[?2004h"]
[83.791104, "o", "> "]
[83.79199, "o", "    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n\u001b[?2004l\r"]
[83.792051, "o", "\u001b[?2004h"]
[83.792092, "o", "> "]
[83.79248, "o", "        abort(400, description=\"bad_file_ids\")\r\n\u001b[?2004l\r"]
[83.792528, "o", "\u001b[?2004h"]
[83.79257, "o", "> "]
[83.792685, "o", "    out = []\r\n\u001b[?2004l\r"]
[83.79274, "o", "\u001b[?2004h"]
[83.792779, "o", "> "]
[83.792974, "o", "    for file_id in ids:\r\n"]
[83.793003, "o", "\u001b[?2004l\r"]
[83.793047, "o", "\u001b[?2004h"]
[83.79309, "o", "> "]
