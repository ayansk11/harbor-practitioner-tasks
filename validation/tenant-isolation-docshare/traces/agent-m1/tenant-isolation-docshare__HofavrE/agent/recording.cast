[83.789784, "o", "\u001b[?2004h"]
[83.789824, "o", "> "]
[83.789963, "o", "@login_required\r\n\u001b[?2004l\r"]
[83.790019, "o", "\u001b[?2004h"]
[83.79006, "o", "> "]
[83.79019, "o", "def export():\r\n"]
