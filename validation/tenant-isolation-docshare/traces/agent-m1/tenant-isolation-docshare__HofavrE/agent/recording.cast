[23.587067, "o", "drwxr-xr-x 2 root root  157 Nov  3 10:36 .\r\ndrwxr-xr-x 3 root root  144 Nov  3 10:36 ..\r\n-rw-r--r-- 1 root root    0 Jan  1  1970 __init__.py\r\n-rw-r--r-- 1 root root  601 Jan  1  1970 admin.py\r\n-rw-r--r-- 1 root root 1303 Jan  1  1970 export.py\r\n-rw-r--r-- 1 root root 1972 Jan  1  1970 files.py\r\n-rw-r--r-- 1 root root 1025 Jan  1  1970 folders.py\r\n-rw-r--r-- 1 root root 1776 Jan  1  1970 share.py\r\n-rw-r--r-- 1 root root 1336 Jan  1  1970 thumbs.py\r\n"]
