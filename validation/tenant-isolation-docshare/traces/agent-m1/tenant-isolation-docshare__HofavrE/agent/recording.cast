[31.223267, "o", "cat /app/docshare/routes/export.py\r\n\u001b[?2004l\r"]
[31.224431, "o", "\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\nimport base64\r\n\r\nfrom flask import Blueprint, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"export\", __name__)\r\n\r\nMAX_IDS = 50\r\n\r\n\r\n@bp.post(\"/api/export\")\r\n@login_required\r\ndef export():\r\n    body = request.get_json(silent=True) or {}\r\n    ids = body.get(\"file_ids\")\r\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n        abort(400, description=\"bad_file_ids\")\r\n    # A selection always comes from one folder view, so the first file tells us whose files these are.\r\n    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\r\n    if first is None:\r\n        abort(404)\r\n    if not g.identity.is_support and first[\"org_id\"] != g.identity.org_id:\r\n        abort(404)\r\n    out = []\r\n    for file_id in ids:\r\n        row = db.query_one(\"SELECT id, name, mime_type, size, content FROM files "]
[31.224486, "o", "WHERE id = ?\", (file_id,))\r\n        if row is None:\r\n            abort(404)\r\n        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n    return jsonify(files=out)\r\n"]
[31.224628, "o", "\u001b[?2004h"]
[31.224653, "o", "root@04847430-05c3-4873-9351-cdf8cd85292b:/app# "]
[31.61071, "i", "cat /app/docshare/routes/admin.py\n"]
[31.610906, "o", "cat /app/docshare/routes/admin.py\r\n\u001b[?2004l\r"]
[31.612025, "o", "\"\"\"Support console: an overview of every organisation (support staff only).\"\"\"\r\nfrom flask import Blueprint, abort, g, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"admin\", __name__)\r\n\r\n\r\n@bp.get(\"/api/admin/orgs\")\r\n@login_required\r\ndef orgs():\r\n    if not g.identity.is_support:\r\n        abort(403)\r\n    rows = db.query_all(\"SELECT o.id, o.name, (SELECT COUNT(*) FROM files f WHERE f.org_id = o.id) AS file_count \"\r\n                        \"FROM orgs o ORDER BY o.name\")\r\n    return jsonify(orgs=[{\"id\": r[\"id\"], \"name\": r[\"name\"], \"file_count\": r[\"file_count\"]} for r in rows])\r\n"]
[31.612254, "o", "\u001b[?2004hroot@04847430-05c3-4873-9351-cdf8cd85292b:/app# "]
[56.256257, "i", "cat <<EOF > /app/docshare/auth.py\n\"\"\"Who is calling: bearer token -> user, plus the active organisation for this request.\"\"\"\nimport functools\nfrom dataclasses import dataclass, field\n\nfrom flask import g, jsonify, request, abort\n\nfrom . import db\n\n\n@dataclass\nclass Identity:\n    user_id: str\n    email: str\n    name: str\n    is_support: bool\n    org_id: str | None          # the active organisation for this request\n    role: str                   # \"member\", \"org_admin\" or \"support\"\n    memberships: dict = field(default_factory=dict)   # org_id -> role\n\n\ndef _bearer_token():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    return header[len(\"Bearer \"):].strip() or None\n\n\ndef load_identity():\n    token = _bearer_token()\n    if token is None:\n        return None\n    user = db.query_one(\"SELECT id, email, name, home_org_id, is_support FROM users WHERE token = ?\", (token,))\n    if user is None:\n        return None\n    memberships = {r[\"org_id\"]:"]
[56.256348, "i", " r[\"role\"] for r in\n                   db.query_all(\"SELECT org_id, role FROM memberships WHERE user_id = ?\", (user[\"id\"],))}\n    \n    org_id = request.headers.get(\"X-Org-Id\") or user[\"home_org_id\"]\n    \n    if org_id is not None:\n        # Verify org exists\n        if not db.query_one(\"SELECT id FROM orgs WHERE id = ?\", (org_id,)):\n            abort(403)\n        \n        if not user[\"is_support\"]:\n            if org_id not in memberships:\n                abort(403)\n            role = memberships[org_id]\n        else:\n            role = \"support\"\n    else:\n        # No org_id provided (and no home_org_id). This is only okay for support staff\n        # who aren't listing things yet.\n        if user[\"is_support\"]:\n            role = \"support\"\n        else:\n            # Non-support must have a home_org_id\n            abort(403)\n            \n    return Identity(user_id=user[\"id\"], email=user[\"email\"], name=user[\"name\"], is_support=bool(user[\"is_support\"]),\n                    org_id=org_id, role=role, membership"]
[56.256362, "i", "s=memberships)\n\n\ndef login_required(view):\n    @functools.wraps(view)\n    def wrapper(*args, **kwargs):\n        ident = load_identity()\n        if ident is None:\n            return jsonify(error=\"unauthorized\"), 401\n        g.identity = ident\n        return view(*args, **kwargs)\n    return wrapper\n\n\ndef require_active_org():\n    \"\"\"The active organisation id; support must name one with X-Org-Id before listing anything.\"\"\"\n    org_id = g.identity.org_id\n    if org_id is None:\n        abort(400, description=\"x_org_id_required\")\n    return org_id\nEOF\n"]
