[28.679633, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: docshare/routes/share.py\n@@\n @bp.post(\"/api/files/<file_id>/shares\")\n @login_required\n def create_share(file_id):\n     if g.identity.role not in (\"member\", \"org_admin\"):\n         abort(403)\n-    row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\n+    # Retrieve file with its organisation to enforce active‑org access.\n+    row = db.query_one(\"SELECT id, org_id FROM files WHERE id = ?\", (file_id,))\n     if row is None:\n         abort(404)\n+    # Members and org_admins must operate within their active organisation.\n+    # Support users cannot reach this point because their role is not in (member, org_admin).\n+    org_id = require_active_org()\n+    if row[\"org_id\"] != org_id:\n+        abort(404)\n*** End Patch\nPATCH\n"]
