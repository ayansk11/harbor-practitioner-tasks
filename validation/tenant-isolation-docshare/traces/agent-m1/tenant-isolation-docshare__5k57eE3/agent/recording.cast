[58.654643, "o", "@bp.patch(\"/api/files/<file_id>\")\r\n\u001b[?2004l\r"]
[58.654696, "o", "\u001b[?2004h> "]
[58.654749, "o", "@login_required\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.654802, "o", "> "]
[58.654851, "o", "def rename(file_id):\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.654912, "o", "> "]
[58.655077, "o", "    if g.identity.role not in (\"member\", \"org_admin\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.655129, "o", "> "]
[58.655178, "o", "        abort(403)\r\n\u001b[?2004l\r"]
[58.655231, "o", "\u001b[?2004h> "]
[58.655338, "o", "    row = get_file_or_404(file_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.655391, "o", "> "]
[58.655642, "o", "    # Verify the file belongs to the active organisation for members/org_admins.\r\n\u001b[?2004l\r"]
[58.65569, "o", "\u001b[?2004h> "]
[58.655798, "o", "    if not g.identity.is_support:\r\n\u001b[?2004l\r"]
[58.655851, "o", "\u001b[?2004h> "]
[58.655968, "o", "        org_id = require_active_org()\r\n\u001b[?2004l\r"]
[58.656028, "o", "\u001b[?2004h> "]
[58.656127, "o", "        if row[\"org_id\"] != org_id:\r\n\u001b[?2004l\r"]
[58.65618, "o", "\u001b[?2004h> "]
[58.65624, "o", "            abort(404)\r\n\u001b[?2004l\r"]
[58.656292, "o", "\u001b[?2004h> "]
[58.656438, "o", "    body = request.get_json(silent=True) or {}\r\n\u001b[?2004l\r"]
[58.656492, "o", "\u001b[?2004h> "]
[58.656571, "o", "    name = body.get(\"name\")\r\n\u001b[?2004l\r"]
[58.656627, "o", "\u001b[?2004h> "]
[58.656884, "o", "    if not isinstance(name, str) or not (1 <= len(name) <= 200) or \"/\" in name:\r\n\u001b[?2004l\r"]
[58.656945, "o", "\u001b[?2004h> "]
[58.657068, "o", "        abort(400, description=\"bad_name\")\r\n\u001b[?2004l\r"]
[58.65712, "o", "\u001b[?2004h> "]
[58.657355, "o", "    db.execute(\"UPDATE files SET name = ? WHERE id = ?\", (name, row[\"id\"]))\r\n\u001b[?2004l\r"]
[58.657409, "o", "\u001b[?2004h> "]
[58.657597, "o", "    return jsonify(db.file_json(get_file_or_404(row[\"id\"])) )\r\n\u001b[?2004l\r"]
[58.65765, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.657705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.657825, "o", "@bp.delete(\"/api/files/<file_id>\")\r\n\u001b[?2004l\r"]
[58.657897, "o", "\u001b[?2004h> "]
[58.657991, "o", "@login_required\r\n\u001b[?2004l\r"]
[58.658044, "o", "\u001b[?2004h> "]
[58.658104, "o", "def delete(file_id):\r\n\u001b[?2004l\r"]
[58.658157, "o", "\u001b[?2004h> "]
[58.65826, "o", "    row = get_file_or_404(file_id)\r\n\u001b[?2004l\r"]
[58.658312, "o", "\u001b[?2004h> "]
[58.658522, "o", "    # Only allow deletion of files within the active organisation.\r\n\u001b[?2004l\r"]
[58.658576, "o", "\u001b[?2004h> "]
[58.658674, "o", "    if not g.identity.is_support:\r\n\u001b[?2004l\r"]
[58.658731, "o", "\u001b[?2004h> "]
[58.658839, "o", "        org_id = require_active_org()\r\n\u001b[?2004l\r"]
[58.658906, "o", "\u001b[?2004h> "]
[58.659003, "o", "        if row[\"org_id\"] != org_id:\r\n\u001b[?2004l\r"]
[58.659058, "o", "\u001b[?2004h> "]
[58.65913, "o", "            abort(404)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.659228, "o", "    conn = db.get_db()\r\n\u001b[?2004l\r"]
[58.659358, "o", "\u001b[?2004h> "]
[58.659511, "o", "    conn.execute(\"DELETE FROM shares WHERE file_id = ?\", (row[\"id\"],))\r\n\u001b[?2004l\r"]
[58.659587, "o", "\u001b[?2004h> "]
[58.65981, "o", "    conn.execute(\"DELETE FROM files WHERE id = ?\", (row[\"id\"],))\r\n\u001b[?2004l\r"]
[58.6599, "o", "\u001b[?2004h> "]
[58.659976, "o", "    conn.commit()\r\n\u001b[?2004l\r"]
[58.660039, "o", "\u001b[?2004h> "]
[58.660055, "o", "    return \"\", 204\r\n\u001b[?2004l\r"]
[58.660138, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[58.663196, "o", "\u001b[?2004hroot@d4316b90-138a-4838-9145-a379053571f7:/app# "]
[59.660687, "i", "cat <<'EOF' > docshare/routes/share.py\n\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\nimport secrets\nfrom datetime import datetime, timezone\n\nfrom flask import Blueprint, abort, g, jsonify\n\nfrom .. import db\nfrom ..auth import login_required, require_active_org\nfrom .files import file_response\n\nbp = Blueprint(\"share\", __name__)\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\n@bp.post(\"/api/files/<file_id>/shares\")\n@login_required\ndef create_share(file_id):\n    if g.identity.role not in (\"member\", \"org_admin\"):\n        abort(403)\n    # Retrieve file with its organisation to enforce active‑org access.\n    row = db.query_one(\"SELECT id, org_id FROM files WHERE id = ?\", (file_id,))\n    if row is None:\n        abort(404)\n    # Members and org_admins must operate within their active organisation.\n    org_id = require_active_org()\n    if row[\"org_id\"] != org_id:\n        abort(404)\n    token = secrets.token_urlsafe(18)\n    created = now_iso()\n  "]
[59.660848, "i", "  db.execute(\n        \"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\n        (token, row[\"id\"], g.identity.user_id, created),\n    )\n    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\n\n\n@bp.delete(\"/api/shares/<token>\")\n@login_required\ndef revoke_share(token):\n    row = db.query_one(\n        \"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\n        (token,),\n    )\n    if row is None or row[\"org_id\"] != g.identity.org_id or g.identity.role not in (\"member\", \"org_admin\"):\n        abort(404)\n    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\n    return \"\", 204\n\n\n@bp.get(\"/s/<token>\")\ndef public_download(token):\n    row = db.query_one(\n        \"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\n        \"WHERE s.token = ? AND s.revoked_at IS NULL\",\n        (token,),\n    )\n    if row is None:\n   "]
[59.660929, "i", "     abort(404)\n    return file_response(row)\nEOF\n"]
