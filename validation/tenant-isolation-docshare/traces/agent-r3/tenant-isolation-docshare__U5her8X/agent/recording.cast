[31.298911, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: docshare/routes/files.py\n@@\n @bp.get(\"/api/files/<file_id>\")\n @login_required\n def get_file(file_id):\n-    return jsonify(db.file_json(get_file_or_404(file_id)))\n+    # Enforce active organisation for non‑support users.\n+    row = get_file_or_404(file_id)\n+    if not g.identity.is_support:\n+        # Ensure the file belongs to the caller's active organisation.\n+        org_id = require_active_org()\n+        if row[\"org_id\"] != org_id:\n+            abort(404)\n+    return jsonify(db.file_json(row))\n@@\n @bp.get(\"/api/files/<file_id>/download\")\n @login_required\n def download(file_id):\n-    row = get_file_or_404(file_id)\n-    return file_response(row)\n+    row = get_file_or_404(file_id)\n+    if not g.identity.is_support:\n+        org_id = require_active_org()\n+        if row[\"org_id\"] != org_id:\n+            abort(404)\n+    return file_response(row)\n@@\n @bp.patch(\"/api/files/<file_id>\")\n @login_required\n def rename(file_id):\n     if g.identity.role not in (\""]
[31.29894, "i", "member\", \"org_admin\"):\n         abort(403)\n-    row = get_file_or_404(file_id)\n+    row = get_file_or_404(file_id)\n+    if not g.identity.is_support:\n+        org_id = require_active_org()\n+        if row[\"org_id\"] != org_id:\n+            abort(404)\n*** End Patch\nPATCH\n"]
