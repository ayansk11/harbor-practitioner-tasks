[62.38872, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: docshare/routes/share.py\n@@\n-from ..auth import login_required\n+from ..auth import login_required, require_active_org\n@@\n @bp.post(\"/api/files/<file_id>/shares\")\n @login_required\n def create_share(file_id):\n     if g.identity.role not in (\"member\", \"org_admin\"):\n         abort(403)\n-    row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\n+    # Verify the file belongs to the active organisation (support cannot create shares).\n+    active_org_id = require_active_org()\n+    row = db.query_one(\"SELECT id, org_id FROM files WHERE id = ?\", (file_id,))\n     if row is None:\n         abort(404)\n+    if row[\"org_id\"] != active_org_id:\n+        abort(404)\n     token = secrets.token_urlsafe(18)\n*** End Patch\nPATCH\n"]
