[63.46844, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: docshare/routes/export.py\n@@\n-from ..auth import login_required\n+from ..auth import login_required, require_active_org\n@@\n @bp.post(\"/api/export\")\n @login_required\n def export():\n     body = request.get_json(silent=True) or {}\n@@\n-    # A selection always comes from one folder view, so the first file tells us whose files these are.\n-    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\n-    if first is None:\n-        abort(404)\n-    if not g.identity.is_support and first[\"org_id\"] != g.identity.org_id:\n-        abort(404)\n+    # Determine the active organisation for the request.\n+    active_org_id = require_active_org()\n+    # A selection always comes from one folder view, so the first file tells us whose files these are.\n+    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\n+    if first is None:\n+        abort(404)\n+    if not g.identity.is_support and first[\"org_id\"] != active_org_id:\n+        abort(404)\n@"]
[63.468614, "i", "@\n-    for file_id in ids:\n-        row = db.query_one(\"SELECT id, name, mime_type, size, content FROM files WHERE id = ?\", (file_id,))\n-        if row is None:\n-            abort(404)\n-        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\n-                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])) .decode(\"ascii\")})\n+    for file_id in ids:\n+        row = db.query_one(\"SELECT id, org_id, name, mime_type, size, content FROM files WHERE id = ?\", (file_id,))\n+        if row is None:\n+            abort(404)\n+        # Enforce per‑file organisation check for non‑support users.\n+        if not g.identity.is_support and row[\"org_id\"] != active_org_id:\n+            abort(404)\n+        out.append({\n+            \"id\": row[\"id\"],\n+            \"name\": row[\"name\"],\n+            \"mime_type\": row[\"mime_type\"],\n+            \"size\": row[\"size\"],\n+            \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\"),\n+        })\n*** End P"]
