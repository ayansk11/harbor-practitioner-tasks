[49.632161, "i", "sed -n '1,200p' docshare/routes/folders.py\n"]
[49.632346, "o", "sed -n '1,200p' docshare/routes/folders.py\r\n\u001b[?2004l\r"]
[49.635189, "o", "\"\"\"Folder endpoints: the folders of the active organisation and their files.\"\"\"\r\nfrom flask import Blueprint, abort, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required, require_active_org\r\n\r\nbp = Blueprint(\"folders\", __name__)\r\n\r\n\r\n@bp.get(\"/api/folders\")\r\n@login_required\r\ndef list_folders():\r\n    org_id = require_active_org()\r\n    rows = db.query_all(\"SELECT id, org_id, name FROM folders WHERE org_id = ? ORDER BY name\", (org_id,))\r\n    return jsonify(folders=[db.folder_json(r) for r in rows])"]
[49.635203, "o", "\r\n\r\n\r\n@bp.get(\"/api/folders/<folder_id>/files\")\r\n@login_required\r\ndef folder_files(folder_id):\r\n    org_id = require_active_org()\r\n"]
[49.63522, "o", "    folder = db.query_one(\"SELECT id, org_id, name FROM folders WHERE id = ? AND org_id = ?\", (folder_id, org_id))\r\n    if folder is None:\r\n        abort(404)\r\n    rows = db.query_all(f\"SELECT {db.FILE_COLUMNS} FROM files WHERE folder_id = ? AND org_id = ? ORDER BY name\",\r\n                        (folder_id, org_id))\r\n    return jsonify(folder=db.folder_json(folder), files=[db.file_json(r) for r in rows])\r\n"]
[49.635454, "o", "\u001b[?2004h"]
[49.635465, "o", "root@2882c453-506f-4266-b67f-004547220069:/app# "]
[50.087044, "i", "sed -n '1,200p' docshare/routes/share.py\n"]
[50.087412, "o", "sed -n '1,200p' docshare/routes/share.py\r\n"]
[50.087435, "o", "\u001b[?2004l\r"]
[50.090105, "o", "\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\r\nimport secrets\r\nfrom datetime import datetime, timezone\r\n\r\nfrom flask import Blueprint, abort, g, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\nfrom .files import file_response\r\n\r\nbp = Blueprint(\"share\", __name__)\r\n\r\n\r\n"]
[50.090162, "o", "def now_iso():\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\n@bp.post(\"/api/files/<file_id>/shares\")\r\n@login_required\r\ndef create_share(file_id):\r\n    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(403)\r\n    row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404)\r\n    token = secrets.token_urlsafe(18)\r\n"]
[50.090191, "o", "    created = now_iso()\r\n    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\r\n               (token, row[\"id\"], g.identity.user_id, created))\r\n    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\r\n\r\n\r\n@bp.delete(\"/api/shares/<token>\")\r\n@login_required\r\ndef revoke_share(token):\r\n    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\r\n                       (token,))\r\n    if row is None or row[\"org_id\"] != g.identity.org_id or g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(404)\r\n    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n    return \"\", 204\r\n\r\n\r\n@bp.get(\"/s/<token>\")\r\ndef public_download(token):\r\n    row = db.query_one(\"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\r\n                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (to"]
[50.090222, "o", "ken,))\r\n    if row is None:\r\n        abort(404)\r\n    return file_response(row)\r\n"]
[50.090479, "o", "\u001b[?2004h"]
[50.090511, "o", "root@2882c453-506f-4266-b67f-004547220069:/app# "]
[50.493198, "i", "sed -n '1,200p' docshare/routes/export.py\n"]
[50.493412, "o", "sed -n '1,200p' docshare/routes/export.py\r\n\u001b[?2004l\r"]
[50.495308, "o", "\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\nimport base64\r\n\r\nfrom flask import Blueprint, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\n"]
[50.495388, "o", "bp = Blueprint(\"export\", __name__)\r\n\r\nMAX_IDS = 50\r\n\r\n\r\n@bp.post(\"/api/export\")\r\n@login_required\r\ndef export():\r\n    body = request.get_json(silent=True) or {}\r\n    ids = body.get(\"file_ids\")\r\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n        abort(400, description=\"bad_file_ids\")\r\n    # A selection always comes from one folder view, so the first file tells us whose files these are.\r\n    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\r\n    if first is None:\r\n        abort(404)\r\n    if not g.identity.is_support and first[\"org_id\"] != g.identity.org_id:\r\n        abort(404)\r\n    out = []\r\n    for file_id in ids:\r\n        row = db.query_one(\"SELECT id, name, mime_type, size, content FROM files WHERE id = ?\", (file_id,))\r\n        if row is None:\r\n            abort(404)\r\n        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n                    \"content_b64\": base64"]
[50.495435, "o", ".b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n    return jsonify(files=out)\r\n"]
[50.495585, "o", "\u001b[?2004h"]
[50.495622, "o", "root@2882c453-506f-4266-b67f-004547220069:/app# "]
[50.872894, "i", "sed -n '1,200p' docshare/routes/admin.py\n"]
[50.873325, "o", "sed -n '1,200p' docshare/routes/admin.py\r\n\u001b[?2004l\r"]
[50.874902, "o", "\"\"\"Support console: an overview of every organisation (support staff only).\"\"\"\r\nfrom flask import Blueprint, abort, g, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"admin\", __name__)\r\n\r\n\r\n@bp.get(\"/api/admin/orgs\")\r\n@login_required\r\ndef orgs():\r\n    if not g.identity.is_support:\r\n        abort(403)\r\n    rows = db.query_all(\"SELECT o.id, o.name, (SELECT COUNT(*) FROM files f WHERE f.org_id = o.id) AS file_count \"\r\n                        \"FROM orgs o ORDER BY o.name\")\r\n    return jsonify(orgs=[{\"id\": r[\"id\"], \"name\": r[\"name\"], \"file_count\": r[\"file_count\"]} for r in rows])\r\n"]
[50.875627, "o", "\u001b[?2004h"]
[50.875687, "o", "root@2882c453-506f-4266-b67f-004547220069:/app# "]
[51.337714, "i", "sed -n '1,200p' docshare/routes/thumbs.py\n"]
[51.338249, "o", "sed -n '1,200p' docshare/routes/thumbs.py\r\n\u001b[?2004l\r"]
[51.340763, "o", "\"\"\"SVG previews for the file grid.\"\"\"\r\nimport html\r\n\r\nfrom flask import Blueprint, Response, abort\r\n"]
[51.340835, "o", "\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"thumbs\", __name__)\r\n"]
[51.340881, "o", "\r\nTEXT_TYPES = (\"text/\", \"application/json\")\r\n\r\n\r\ndef render_thumb(name, mime_type, content):\r\n    lines = []\r\n    if mime_type.startswith(TEXT_TYPES):\r\n        text = bytes(content).decode(\"utf-8\", \"replace\")\r\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()][:5]\r\n    parts = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"200\" viewBox=\"0 0 160 200\">',\r\n             f\"<title>{html.escape(name)}</title>\",\r\n             '<rect x=\"0.5\" y=\"0.5\" width=\"159\" height=\"199\" fill=\"#ffffff\" stroke=\"#c8ccd2\"/>',\r\n             f'<text x=\"8\" y=\"18\" font-size=\"9\" font-weight=\"bold\">{html.escape(name[:30])}</text>']\r\n    for i, ln in enumerate(lines):\r\n        parts.append(f'<text x=\"8\" y=\"{40 + 14 * i}\" font-size=\"8\">{html.escape(ln[:34])}</text>')\r\n    parts.append(\"</svg>\")\r\n    return \"\\n\".join(parts)\r\n\r\n\r\n@bp.get(\"/api/files/<file_id>/thumb\")\r\n@login_required\r\n"]
[51.340937, "o", "def thumb(file_id):\r\n    row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404)\r\n    svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\r\n    return Response(svg, mimetype=\"image/svg+xml\")\r\n"]
[51.341212, "o", "\u001b[?2004h"]
[51.341264, "o", "root@2882c453-506f-4266-b67f-004547220069:/app# "]
[61.389471, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: docshare/routes/thumbs.py\n@@\n-from ..auth import login_required\n+from ..auth import login_required, require_active_org\n@@\n @bp.get(\"/api/files/<file_id>/thumb\")\n @login_required\n def thumb(file_id):\n-    row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\n+    # Enforce the active‑organisation rule for read‑only access.\n+    active_org_id = require_active_org()\n+    row = db.query_one(\"SELECT org_id, name, mime_type, content FROM files WHERE id = ?\", (file_id,))\n     if row is None:\n         abort(404)\n+    if not g.identity.is_support and row[\"org_id\"] != active_org_id:\n+        abort(404)\n     svg = render_thumb(row[\"name\"], row[\"mime_type\"], row[\"content\"])\n     return Response(svg, mimetype=\"image/svg+xml\")\n*** End Patch\nPATCH\n"]
[61.38963, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[61.389688, "o", "\u001b[?2004h"]
[61.389748, "o", "> "]
[61.389802, "o", "*** Begin Patch\r\n\u001b[?2004l\r"]
