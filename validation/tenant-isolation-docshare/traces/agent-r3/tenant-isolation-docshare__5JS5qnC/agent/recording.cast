[61.390802, "o", "\u001b[?2004h"]
[61.390826, "o", "> "]
[61.390915, "o", " def thumb(file_id):\r\n\u001b[?2004l\r"]
[61.390957, "o", "\u001b[?2004h"]
[61.390998, "o", "> "]
[61.391367, "o", "-    row = db.query_one(\"SELECT name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n\u001b[?2004l\r"]
[61.391397, "o", "\u001b[?2004h> "]
[61.39169, "o", "+    # Enforce the active‑organisation rule for read‑only access.\r\n\u001b[?2004l\r"]
[61.391718, "o", "\u001b[?2004h"]
[61.391742, "o", "> "]
[61.39191, "o", "+    active_org_id = require_active_org()\r\n\u001b[?2004l\r"]
[61.391956, "o", "\u001b[?2004h> "]
[61.392423, "o", "+    row = db.query_one(\"SELECT org_id, name, mime_type, content FROM files WHERE id = ?\", (file_id,))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.392507, "o", "     if row is None:\r\n\u001b[?2004l\r"]
[61.392537, "o", "\u001b[?2004h> "]
[61.392624, "o", "         abort(404)\r\n\u001b[?2004l\r"]
[61.392689, "o", "\u001b[?2004h> "]
[61.392954, "o", "+    if not g.identity.is_support and row[\"org_id\"] != active_org_id:\r\n"]
