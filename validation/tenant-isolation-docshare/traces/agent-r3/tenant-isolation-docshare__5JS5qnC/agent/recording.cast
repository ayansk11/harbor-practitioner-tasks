[109.118625, "o", "        active_org_id = require_active_org()\u001b[90m\u001b[39;49;00m\r\n        body = request.get_json(silent=\u001b[94mTrue\u001b[39;49;00m) \u001b[95mor\u001b[39;49;00m {}\u001b[90m\u001b[39;49;00m\r\n        ids = body.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mfile_ids\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(ids, \u001b[96mlist\u001b[39;49;00m) \u001b[95mor\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m (\u001b[94m1\u001b[39;49;00m <= \u001b[96mlen\u001b[39;49;00m(ids) <= MAX_IDS) \u001b[95mor\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[96mall\u001b[39;49;00m(\u001b[96misinstance\u001b[39;49;00m(i, \u001b[96mstr\u001b[39;49;00m) \u001b[94mfor\u001b[39;49;00m i \u001b[95min\u001b[39;49;00m ids):\u001b[90m\u001b[39;49;00m\r\n            abort(\u001b[94m400\u001b[39;49;00m, description=\u001b[33m\"\u001b[39;49;00m\u001b[33mbad_file_ids\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# A selection always comes from one folder view, so the first file tells us whose files these are.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        first = db.query_one(\u001b[33m\"\u001b[39;49;00m\u001b[33mSELECT org_id FROM files WHERE id = ?\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,"]
[109.118682, "o", " (ids[\u001b[94m0\u001b[39;49;00m],))\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m first \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            abort(\u001b[94m404\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m g.identity.is_support \u001b[95mand\u001b[39;49;00m first[\u001b[33m\"\u001b[39;49;00m\u001b[33morg_id\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] != active_org_id:\u001b[90m\u001b[39;49;00m\r\n            abort(\u001b[94m404\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        out = []\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m file_id \u001b[95min\u001b[39;49;00m ids:\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m# Enforce per‑file organisation check for non‑support users.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m g.identity.is_support \u001b[95mand\u001b[39;49;00m row[\u001b[33m\"\u001b[39;49;00m\u001b[33morg_id\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] != active_org_id:\u001b[90m\u001b[39;49;00m\r\n                                             ^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           UnboundLocalError: cannot access local variable 'row' where it is not associated with a value\u001b[0m\r"]
