[95.763092, "i", "cat > docshare/routes/share.py <<'PY'\n\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\nimport secrets\nfrom datetime import datetime, timezone\n\nfrom flask import Blueprint, abort, g, jsonify\n\nfrom .. import db\nfrom ..auth import login_required, require_active_org\nfrom .files import file_response\n\nbp = Blueprint(\"share\", __name__)\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\n@bp.post(\"/api/files/<file_id>/shares\")\n@login_required\ndef create_share(file_id):\n    # Only members and org_admins can create shares.\n    if g.identity.role not in (\"member\", \"org_admin\"):\n        abort(403)\n    # Determine the active organisation for the request.\n    active_org_id = require_active_org()\n    # Fetch the file and verify it belongs to the active organisation.\n    row = db.query_one(\"SELECT id, org_id FROM files WHERE id = ?\", (file_id,))\n    if row is None:\n        abort(404)\n    if row[\"org_id\"] != active_org_id:\n        abort(404)\n    token = secrets."]
[95.763196, "i", "token_urlsafe(18)\n    created = now_iso()\n    db.execute(\n        \"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\n        (token, row[\"id\"], g.identity.user_id, created),\n    )\n    return (\n        jsonify(\n            token=token,\n            url=f\"/s/{token}\",\n            file_id=row[\"id\"],\n            created_at=created,\n        ),\n        201,\n    )\n\n\n@bp.delete(\"/api/shares/<token>\")\n@login_required\ndef revoke_share(token):\n    row = db.query_one(\n        \"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\n        (token,),\n    )\n    if (\n        row is None\n        or row[\"org_id\"] != g.identity.org_id\n        or g.identity.role not in (\"member\", \"org_admin\")\n    ):\n        abort(404)\n    db.execute(\n        \"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\",\n        (now_iso(), token),\n    )\n    return \"\", 204\n\n\n@bp.get(\"/s/<token>\")\ndef public_download(token):\n    row = db.query_one(\n        \"SELECT f.id"]
[95.763222, "i", ", f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\n        \"WHERE s.token = ? AND s.revoked_at IS NULL\",\n        (token,),\n    )\n    if row is None:\n        abort(404)\n    return file_response(row)\nPY\n"]
[95.763272, "o", "cat > docshare/routes/share.py <<'PY'\r\n"]
