[120.620086, "o", "\u001b[?2004hroot@2882c453-506f-4266-b67f-004547220069:/app# "]
[130.31334, "i", "cat > docshare/routes/export.py <<'PY'\n\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\nimport base64\n\nfrom flask import Blueprint, abort, g, jsonify, request\n\nfrom .. import db\nfrom ..auth import login_required, require_active_org\n\nbp = Blueprint(\"export\", __name__)\n\nMAX_IDS = 50\n\n\n@bp.post(\"/api/export\")\n@login_required\ndef export():\n    # Determine the active organisation for the request.\n    active_org_id = require_active_org()\n    body = request.get_json(silent=True) or {}\n    ids = body.get(\"file_ids\")\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\n        abort(400, description=\"bad_file_ids\")\n    # The first file determines the organisation of the selection.\n    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\n    if first is None:\n        abort(404)\n    if not g.identity.is_support and first[\"org_id\"] != active_org_id:\n        abort(404)\n    out = []\n    for file_id "]
[130.313486, "i", "in ids:\n        row = db.query_one(\n            \"SELECT id, org_id, name, mime_type, size, content FROM files WHERE id = ?\",\n            (file_id,),\n        )\n        if row is None:\n            abort(404)\n        if not g.identity.is_support and row[\"org_id\"] != active_org_id:\n            abort(404)\n        out.append(\n            {\n                \"id\": row[\"id\"],\n                \"name\": row[\"name\"],\n                \"mime_type\": row[\"mime_type\"],\n                \"size\": row[\"size\"],\n                \"content_b64\": base64.b64encode(bytes(row[\"content\"]))\n                .decode(\"ascii\"),\n            }\n        )\n    return jsonify(files=out)\nPY\n"]
[130.313824, "o", "cat > docshare/routes/export.py <<'PY'\r\n"]
