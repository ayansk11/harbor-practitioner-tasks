[54.403333, "o", "sed -n '200,400p' docshare/routes/folders.py\r\n\u001b[?2004l\r"]
[54.406223, "o", "\u001b[?2004h"]
[54.406275, "o", "root@06c25427-2bd6-4161-bf63-28169513f732:/app# "]
[62.224095, "i", "sed -n '1,200p' docshare/routes/share.py\n"]
[62.224499, "o", "sed -n '1,200p' docshare/routes/share.py\r\n\u001b[?2004l\r"]
[62.225862, "o", "\"\"\"Share links: create, revoke, and the public download behind /s/<token>.\"\"\"\r\nimport secrets\r\nfrom datetime import datetime, timezone\r\n\r\nfrom flask import Blueprint, abort, g, jsonify\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\nfrom .files import file_response\r\n"]
[62.225924, "o", "\r\nbp = Blueprint(\"share\", __name__)\r\n\r\n\r\ndef now_iso():\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\n@bp.post(\"/api/files/<file_id>/shares\")\r\n@login_required\r\ndef create_share(file_id):\r\n"]
[62.225987, "o", "    if g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(403)\r\n    row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\r\n    if row is None:\r\n        abort(404)\r\n    token = secrets.token_urlsafe(18)\r\n    created = now_iso()\r\n    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\r\n               (token, row[\"id\"], g.identity.user_id, created))\r\n    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\r\n\r\n\r\n@bp.delete(\"/api/shares/<token>\")\r\n@login_required\r\ndef revoke_share(token):\r\n    row = db.query_one(\"SELECT s.token, f.org_id FROM shares s JOIN files f ON f.id = s.file_id WHERE s.token = ?\",\r\n                       (token,))\r\n    if row is None or row[\"org_id\"] != g.identity.org_id or g.identity.role not in (\"member\", \"org_admin\"):\r\n        abort(404)\r\n    db.execute(\"UPDATE shares SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL\", (now_iso(), token))\r\n    return \"\", 204\r\n\r\n\r\n@bp.get(\"/s/<"]
[62.226036, "o", "token>\")\r\ndef public_download(token):\r\n    row = db.query_one(\"SELECT f.id, f.name, f.mime_type, f.content FROM shares s JOIN files f ON f.id = s.file_id \"\r\n                       \"WHERE s.token = ? AND s.revoked_at IS NULL\", (token,))\r\n    if row is None:\r\n        abort(404)\r\n    return file_response(row)\r\n"]
[62.226281, "o", "\u001b[?2004h"]
[62.226334, "o", "root@06c25427-2bd6-4161-bf63-28169513f732:/app# "]
[67.55952, "i", "sed -n '1,200p' docshare/routes/export.py\n"]
[67.559706, "o", "sed -n '1,200p' docshare/routes/export.py\r\n"]
[67.559735, "o", "\u001b[?2004l\r"]
[67.562098, "o", "\"\"\"Bulk export: several files in one JSON response (used by the \"Download selected\" button).\"\"\"\r\nimport base64\r\n"]
[67.562129, "o", "\r\nfrom flask import Blueprint, abort, g, jsonify, request\r\n\r\nfrom .. import db\r\nfrom ..auth import login_required\r\n\r\nbp = Blueprint(\"export\", __name__)\r\n"]
[67.562162, "o", "\r\nMAX_IDS = 50\r\n\r\n\r\n@bp.post(\"/api/export\")\r\n@login_required\r\ndef export():\r\n    body = request.get_json(silent=True) or {}\r\n    ids = body.get(\"file_ids\")\r\n    if not isinstance(ids, list) or not (1 <= len(ids) <= MAX_IDS) or not all(isinstance(i, str) for i in ids):\r\n        abort(400, description=\"bad_file_ids\")\r\n    # A selection always comes from one folder view, so the first file tells us whose files these are.\r\n"]
[67.562209, "o", "    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\r\n    if first is None:\r\n        abort(404)\r\n    if not g.identity.is_support and first[\"org_id\"] != g.identity.org_id:\r\n        abort(404)\r\n    out = []\r\n    for file_id in ids:\r\n        row = db.query_one(\"SELECT id, name, mime_type, size, content FROM files WHERE id = ?\", (file_id,))\r\n        if row is None:\r\n            abort(404)\r\n        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\r\n"]
[67.562238, "o", "                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\r\n"]
[67.562265, "o", "    return jsonify(files=out)\r\n"]
[67.562611, "o", "\u001b[?2004h"]
[67.562634, "o", "root@06c25427-2bd6-4161-bf63-28169513f732:/app# "]
[78.909208, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: docshare/routes/share.py\n@@\n-from ..auth import login_required\n+from ..auth import login_required, require_active_org\n@@\n @bp.post(\"/api/files/<file_id>/shares\")\n @login_required\n def create_share(file_id):\n-    if g.identity.role not in (\"member\", \"org_admin\"):\n-        abort(403)\n-    row = db.query_one(\"SELECT id FROM files WHERE id = ?\", (file_id,))\n-    if row is None:\n-        abort(404)\n-    token = secrets.token_urlsafe(18)\n-    created = now_iso()\n-    db.execute(\"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\n-               (token, row[\"id\"], g.identity.user_id, created))\n-    return jsonify(token=token, url=f\"/s/{token}\", file_id=row[\"id\"], created_at=created), 201\n+    # Only members and org_admins may create shares (support is explicitly denied).\n+    if g.identity.role not in (\"member\", \"org_admin\"):\n+        abort(403)\n+\n+    # Determine the active organisation for regular users. Support staff have no act"]
[78.9094, "i", "ive org\n+    # but are already excluded by the role check above.\n+    org_id = require_active_org()\n+\n+    # Fetch the file together with its organisation.\n+    row = db.query_one(\"SELECT id, org_id FROM files WHERE id = ?\", (file_id,))\n+    if row is None:\n+        abort(404)\n+    # Enforce that the file belongs to the active organisation for non‑support users.\n+    if not g.identity.is_support and row[\"org_id\"] != org_id:\n+        abort(404)\n+\n+    token = secrets.token_urlsafe(18)\n+    created = now_iso()\n+    db.execute(\n+        \"INSERT INTO shares (token, file_id, created_by, created_at) VALUES (?, ?, ?, ?)\",\n+        (token, row[\"id\"], g.identity.user_id, created),\n+    )\n+    return (\n+        jsonify(\n+            token=token,\n+            url=f\"/s/{token}\",\n+            file_id=row[\"id\"],\n+            created_at=created,\n+        ),\n+        201,\n+    )\n*** End Patch\nPATCH\n"]
[78.909516, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
