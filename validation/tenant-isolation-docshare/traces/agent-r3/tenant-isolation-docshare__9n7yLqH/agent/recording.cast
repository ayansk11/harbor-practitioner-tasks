[78.918674, "o", "> "]
[78.919292, "o", "+    # Only members and org_admins may create shares (support is explicitly denied).\r\n\u001b[?2004l\r"]
[78.919342, "o", "\u001b[?2004h"]
[78.919382, "o", "> "]
