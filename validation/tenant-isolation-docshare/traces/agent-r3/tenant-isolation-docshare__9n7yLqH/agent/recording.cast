[81.003236, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: docshare/routes/export.py\n@@\n-from ..auth import login_required\n+from ..auth import login_required, require_active_org\n@@\n @bp.post(\"/api/export\")\n @login_required\n def export():\n@@\n-    # A selection always comes from one folder view, so the first file tells us whose files these are.\n-    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\n-    if first is None:\n-        abort(404)\n-    if not g.identity.is_support and first[\"org_id\"] != g.identity.org_id:\n-        abort(404)\n+    # Determine the active organisation for regular users. Support staff have no active org.\n+    org_id = require_active_org()\n+\n+    # The first file gives us the organisation that the bulk request is expected to target.\n+    first = db.query_one(\"SELECT org_id FROM files WHERE id = ?\", (ids[0],))\n+    if first is None:\n+        abort(404)\n+    # Non‑support callers must have the active org matching the files' organisation.\n+    if not g.identity.is_support"]
[81.00327, "i", " and first[\"org_id\"] != org_id:\n+        abort(404)\n@@\n-    for file_id in ids:\n-        row = db.query_one(\"SELECT id, name, mime_type, size, content FROM files WHERE id = ?\", (file_id,))\n-        if row is None:\n-            abort(404)\n-        out.append({\"id\": row[\"id\"], \"name\": row[\"name\"], \"mime_type\": row[\"mime_type\"], \"size\": row[\"size\"],\n-                    \"content_b64\": base64.b64encode(bytes(row[\"content\"])).decode(\"ascii\")})\n+    for file_id in ids:\n+        # Retrieve the file together with its organisation to enforce per‑file access.\n+        row = db.query_one(\n+            \"SELECT id, name, mime_type, size, content, org_id FROM files WHERE id = ?\",\n+            (file_id,),\n+        )\n+        if row is None:\n+            abort(404)\n+        # Ensure the caller may read the file.\n+        if not g.identity.is_support and row[\"org_id\"] != org_id:\n+            abort(404)\n+        out.append(\n+            {\n+                \"id\": row[\"id\"],\n+                \"name\": row[\"name\"],\n+              "]
[81.003423, "i", "  \"mime_type\": row[\"mime_type\"],\n+                \"size\": row[\"size\"],\n+                \"content_b64\": base64.b64encode(bytes(row[\"content\"]))\n+                .decode(\"ascii\"),\n+            }\n+        )\n*** End Patch\nPATCH\n"]
