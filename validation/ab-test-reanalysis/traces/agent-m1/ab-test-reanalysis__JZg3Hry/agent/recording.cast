[153.006585, "o", "    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\r\n\u001b[?2004l\r"]
[153.006608, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.006647, "o", "\u001b[?2004h> "]
[153.006845, "o", "    A pageview is clicked if at least one module_click event with target starting with\r\n\u001b[?2004l\r"]
[153.006877, "o", "\u001b[?2004h> "]
[153.007089, "o", "    'item:' was logged on it (the user opened a related product's page from the module).\r\n\u001b[?2004l\r"]
[153.007118, "o", "\u001b[?2004h> "]
[153.007143, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.007242, "o", "    pageviews = pageviews.copy()\r\n\u001b[?2004l\r"]
[153.007272, "o", "\u001b[?2004h> "]
[153.007503, "o", "    pageviews[\"clicked\"] = pageviews[\"pageview_id\"].isin(clicked_pageview_ids).astype(\"int64\")\r\n\u001b[?2004l\r"]
[153.007534, "o", "\u001b[?2004h> "]
[153.007759, "o", "    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n\u001b[?2004l\r"]
[153.007788, "o", "\u001b[?2004h> "]
[153.007963, "o", "    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\r\n\u001b[?2004l\r"]
[153.007995, "o", "\u001b[?2004h> "]
[153.008131, "o", "    return per_user.fillna({\"clicks\": 0, \"views\": 0})\r\n\u001b[?2004l\r"]
[153.008162, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.008191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.008223, "o", "\u001b[?2004h> "]
[153.008311, "o", "def decide(srm_flag, ci_low):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.008443, "o", "    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n\u001b[?2004l\r"]
[153.008475, "o", "\u001b[?2004h> "]
[153.008509, "o", "    if srm_flag:\r\n\u001b[?2004l\r"]
[153.008538, "o", "\u001b[?2004h> "]
[153.008605, "o", "        return \"invalid\"\r\n\u001b[?2004l\r"]
[153.008636, "o", "\u001b[?2004h> "]
[153.008749, "o", "    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n\u001b[?2004l\r"]
[153.00878, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.008809, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.008838, "o", "\u001b[?2004h> "]
[153.008905, "o", "def build_readout(data_dir):\r\n\u001b[?2004l\r"]
[153.008934, "o", "\u001b[?2004h> "]
[153.009157, "o", "    # Section 3: the experiment is the users the assignment service randomized (method=hash).\r\n\u001b[?2004l\r"]
[153.009187, "o", "\u001b[?2004h> "]
[153.009413, "o", "    # Users whose variant was set by override (allowlist/dogfood) are not in the experiment.\r\n\u001b[?2004l\r"]
[153.009444, "o", "\u001b[?2004h> "]
[153.009551, "o", "    assignments = load_assignments(data_dir)\r\n\u001b[?2004l\r"]
[153.009582, "o", "\u001b[?2004h> "]
[153.009794, "o", "    assignments = assignments[assignments[\"method\"] == \"hash\"].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[153.009826, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.009858, "o", "\u001b[?2004h> "]
[153.010094, "o", "    # Section 3: exclude only client-based bot flags (ua_crawler), not behavioural rules.\r\n\u001b[?2004l\r"]
[153.010132, "o", "\u001b[?2004h> "]
[153.010326, "o", "    assignments = exclude_bots(assignments, load_bot_flags(data_dir))\r\n\u001b[?2004l\r"]
[153.010361, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.010412, "o", "\u001b[?2004h> "]
[153.01059, "o", "    # Section 3: pageviews at or after the user's assigned_at count.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.01076, "o", "    pageviews = load_pageviews(data_dir, assignments)\r\n\u001b[?2004l\r\u001b[?2004h"]
[153.010795, "o", "> \r\n\u001b[?2004l\r"]
[153.010834, "o", "\u001b[?2004h> "]
[153.011054, "o", "    # Section 4: a pageview is clicked when the user opened the page of at least one\r\n\u001b[?2004l\r"]
[153.011087, "o", "\u001b[?2004h> "]
[153.011287, "o", "    # related product from the module (target starts with 'item:').\r\n\u001b[?2004l\r"]
[153.011324, "o", "\u001b[?2004h> "]
[153.01155, "o", "    # nav:prev, nav:next, link:all do not open a product page and do not count.\r\n\u001b[?2004l\r\u001b[?2004h"]
[153.011582, "o", "> "]
[153.011717, "o", "    module_clicks = load_module_clicks(data_dir)\r\n\u001b[?2004l\r"]
[153.011753, "o", "\u001b[?2004h> "]
[153.011981, "o", "    item_clicks = module_clicks[module_clicks[\"target\"].str.startswith(\"item:\")]\r\n\u001b[?2004l\r"]
[153.012017, "o", "\u001b[?2004h> "]
[153.012181, "o", "    clicked_pageview_ids = set(item_clicks[\"pageview_id\"])\r\n\u001b[?2004l\r"]
[153.012214, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.012253, "o", "\u001b[?2004h> "]
[153.01248, "o", "    per_user = per_user_counts(assignments, pageviews, clicked_pageview_ids)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.012702, "o", "    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n\u001b[?2004l\r"]
[153.012738, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.012768, "o", "\u001b[?2004h> "]
[153.012921, "o", "    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n\u001b[?2004l\r"]
[153.012952, "o", "\u001b[?2004h> "]
[153.013136, "o", "    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[153.013173, "o", "\u001b[?2004h> "]
[153.013366, "o", "    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[153.013399, "o", "\u001b[?2004h> "]
[153.013566, "o", "    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n\u001b[?2004l\r"]
[153.013586, "o", "\u001b[?2004h> "]
[153.013773, "o", "    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n\u001b[?2004l\r"]
[153.013824, "o", "\u001b[?2004h> "]
[153.013947, "o", "    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n\u001b[?2004l\r"]
[153.013994, "o", "\u001b[?2004h> "]
[153.014089, "o", "    srm_flag = bool(srm_p < SRM_ALPHA)\r\n\u001b[?2004l\r"]
[153.014132, "o", "\u001b[?2004h> \r\n"]
[153.014166, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[153.014204, "o", "    notes = [\r\n\u001b[?2004l\r"]
[153.014241, "o", "\u001b[?2004h> "]
[153.014602, "o", "        \"Fixed: excluded override (dogfood) assignments per plan section 3 - only hash-randomized users are in the experiment.\",\r\n\u001b[?2004l\r"]
[153.014642, "o", "\u001b[?2004h> "]
[153.015056, "o", "        \"Fixed: bot exclusion now uses only client-based rule (ua_crawler) per plan section 3; velocity (behavioural) does not exclude users.\",\r\n\u001b[?2004l\r"]
[153.015094, "o", "\u001b[?2004h> "]
[153.015644, "o", "        \"Fixed: a pageview is clicked only if the user opened a product page from the module (target starts with 'item:'); nav arrows and 'See all' link do not count per plan section 4.\",\r\n\u001b[?2004l\r"]
[153.015695, "o", "\u001b[?2004h> "]
[153.015897, "o", "        \"With these fixes the SRM passes and the experiment is readable.\",\r\n\u001b[?2004l\r"]
[153.015947, "o", "\u001b[?2004h> "]
[153.015985, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.016021, "o", "\u001b[?2004h> "]
[153.016065, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[153.016105, "o", "> "]
[153.016161, "o", "        \"n_users\": n_users,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.016262, "o", "        \"pageviews\": views,\r\n\u001b[?2004l\r"]
[153.016308, "o", "\u001b[?2004h> "]
[153.016371, "o", "        \"clicks\": clicks,\r\n\u001b[?2004l\r"]
[153.016407, "o", "\u001b[?2004h> "]
[153.016454, "o", "        \"ctr\": ctr,\r\n\u001b[?2004l\r"]
[153.016487, "o", "\u001b[?2004h> "]
[153.016565, "o", "        \"diff\": float(diff),\r\n\u001b[?2004l\r"]
[153.016596, "o", "\u001b[?2004h> "]
[153.016741, "o", "        \"ci_95\": [float(ci_low), float(ci_high)],\r\n\u001b[?2004l\r"]
[153.016781, "o", "\u001b[?2004h> "]
[153.016862, "o", "        \"ci_method\": CI_METHOD,\r\n\u001b[?2004l\r"]
[153.016897, "o", "\u001b[?2004h> "]
[153.016962, "o", "        \"srm_p\": srm_p,\r\n\u001b[?2004l\r"]
[153.016995, "o", "\u001b[?2004h> "]
[153.017078, "o", "        \"srm_flag\": srm_flag,\r\n\u001b[?2004l\r"]
[153.017114, "o", "\u001b[?2004h> "]
[153.017245, "o", "        \"decision\": decide(srm_flag, ci_low),\r\n\u001b[?2004l\r"]
[153.017299, "o", "\u001b[?2004h> "]
[153.01735, "o", "        \"notes\": notes,\r\n\u001b[?2004l\r"]
[153.017384, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[153.017417, "o", "\u001b[?2004h"]
[153.017451, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.017485, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.01754, "o", "def main(argv=None):\r\n\u001b[?2004l\r"]
[153.017575, "o", "\u001b[?2004h> "]
[153.017776, "o", "    ap = argparse.ArgumentParser(description=\"A/B test CTR readout\")\r\n\u001b[?2004l\r"]
[153.017808, "o", "\u001b[?2004h> "]
[153.017931, "o", "    ap.add_argument(\"--data\", required=True,\r\n\u001b[?2004l\r"]
[153.017964, "o", "\u001b[?2004h> "]
[153.018272, "o", "                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n\u001b[?2004l\r"]
[153.01832, "o", "\u001b[?2004h> "]
[153.018561, "o", "    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n\u001b[?2004l\r"]
[153.018598, "o", "\u001b[?2004h> "]
[153.018677, "o", "    args = ap.parse_args(argv)\r\n\u001b[?2004l\r"]
[153.018709, "o", "\u001b[?2004h> "]
[153.018819, "o", "    readout = build_readout(args.data)\r\n\u001b[?2004l\r"]
[153.018852, "o", "\u001b[?2004h> "]
[153.018923, "o", "    out = Path(args.out)\r\n\u001b[?2004l\r"]
[153.018957, "o", "\u001b[?2004h> "]
[153.019099, "o", "    out.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[153.019133, "o", "\u001b[?2004h> "]
[153.019326, "o", "    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.019585, "o", "    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n\u001b[?2004l\r"]
[153.019624, "o", "\u001b[?2004h> "]
[153.019924, "o", "          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\u001b[?2004l\r"]
[153.019958, "o", "\u001b[?2004h> "]
[153.019987, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[153.020018, "o", "\u001b[?2004h> "]
[153.020091, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[153.020121, "o", "\u001b[?2004h> "]
[153.020151, "o", "    main()\r\n\u001b[?2004l\r"]
[153.02018, "o", "\u001b[?2004h> "]
[153.020211, "o", "EOF\r\n\u001b[?2004l\r"]
[153.022147, "o", "\u001b[?2004hroot@4a3d503a-5781-4d51-b0a8-fedbcc92141e:/app# "]
[153.521519, "i", "cd /app && python -m abtest.report --data /app/data --out /app/output/result.json\n"]
[153.521785, "o", "cd /app && python -m abtest.report --data /app/data --out /app/output/result.json\r\n\u001b[?2004l\r"]
[155.026457, "o", "wrote /app/output/result.json: decision=no_ship diff=+0.00096 ci=[-0.00432, +0.00624] srm_p=0.469\r\n"]
[155.106505, "o", "\u001b[?2004hroot@4a3d503a-5781-4d51-b0a8-fedbcc92141e:/app# "]
[192.229913, "i", "cat /app/output/result.json\n"]
[192.230053, "o", "cat /app/output/result.json\r\n\u001b[?2004l\r"]
[192.232082, "o", "{\r\n  \"n_users\": {\r\n    \"A\": 16570,\r\n    \"B\": 16702\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 165646,\r\n    \"B\": 167279\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 16436,\r\n    \"B\": 16759\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.09922364560568923,\r\n    \"B\": 0.10018591694115818\r\n  },\r\n  \"diff\": 0.0009622713354689449,\r\n  \"ci_95\": [\r\n    -0.004315790679054589,\r\n    0.006240333349992479\r\n  ],\r\n  \"ci_method\": \"delta method, users as the unit\",\r\n  \"srm_p\": 0.46927458833703506,\r\n  \"srm_flag\": false,\r\n  \"decision\": \"no_ship\",\r\n  \"notes\": [\r\n    \"Fixed: excluded override (dogfood) assignments per plan section 3 - only hash-randomized users are in the experiment.\",\r\n    \"Fixed: bot exclusion now uses only client-based rule (ua_crawler) per plan section 3; velocity (behavioural) does not exclude users.\",\r\n    \"Fixed: a pageview is clicked only if the user opened a product page from the module (target starts with 'item:'); nav arrows and 'See all' link do not count per plan section 4.\",\r\n    \"With these fixes the SRM passes and the experiment is readable."]
[192.232127, "o", "\"\r\n  ]\r\n}\r\n"]
[192.23237, "o", "\u001b[?2004hroot@4a3d503a-5781-4d51-b0a8-fedbcc92141e:/app# "]
[192.575917, "i", "cd /app && python3 -c \"\nimport pandas as pd\na = pd.read_csv('data/assignments.csv.gz', dtype=str).drop_duplicates()\nprint('total hash rows:', len(a))\nprint(a['method'].value_counts())\nprint(a[a['method']=='hash']['variant'].value_counts())\nb = pd.read_csv('data/bot_flags.csv.gz', dtype=str)\nua = set(b[b['rule']=='ua_crawler']['user_id'])\nvel = set(b[b['rule']=='velocity']['user_id'])\nprint('ua_crawler users:', len(ua), 'velocity users:', len(vel))\nh = a[a['method']=='hash']\nprint('hash after ua exclude A/B:')\nprint(h[~h['user_id'].isin(ua)]['variant'].value_counts())\n\"\n"]
[192.576098, "o", "cd /app && python3 -c \"\r\n\u001b[?2004l\r"]
[192.576114, "o", "\u001b[?2004h> "]
[192.576169, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[192.576194, "o", "\u001b[?2004h> "]
[192.576373, "o", "a = pd.read_csv('data/assignments.csv.gz', dtype=str).drop_duplicates()\r\n\u001b[?2004l\r"]
[192.576397, "o", "\u001b[?2004h> "]
[192.576474, "o", "print('total hash rows:', len(a))\r\n\u001b[?2004l\r"]
[192.576503, "o", "\u001b[?2004h> "]
[192.576585, "o", "print(a['method'].value_counts())\r\n\u001b[?2004l\r"]
[192.576607, "o", "\u001b[?2004h> "]
[192.576734, "o", "print(a[a['method']=='hash']['variant'].value_counts())\r\n\u001b[?2004l\r"]
[192.576757, "o", "\u001b[?2004h"]
[192.576777, "o", "> "]
[192.576889, "o", "b = pd.read_csv('data/bot_flags.csv.gz', dtype=str)\r\n\u001b[?2004l\r\u001b[?2004h"]
[192.57691, "o", "> "]
[192.577016, "o", "ua = set(b[b['rule']=='ua_crawler']['user_id'])\r\n\u001b[?2004l\r"]
[192.577036, "o", "\u001b[?2004h> "]
[192.577148, "o", "vel = set(b[b['rule']=='velocity']['user_id'])\r\n\u001b[?2004l\r"]
[192.577168, "o", "\u001b[?2004h"]
[192.577187, "o", "> "]
[192.577332, "o", "print('ua_crawler users:', len(ua), 'velocity users:', len(vel))\r\n\u001b[?2004l\r"]
[192.577341, "o", "\u001b[?2004h> "]
[192.57742, "o", "h = a[a['method']=='hash']\r\n\u001b[?2004l\r"]
[192.577444, "o", "\u001b[?2004h> "]
