[153.004439, "i", "cat > /app/abtest/report.py << 'EOF'\n\"\"\"Experiment readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots\nfrom .load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\n\nARMS = (\"A\", \"B\")\n\n\ndef per_user_counts(assignments, pageviews, clicked_pageview_ids):\n    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\n\n    A pageview is clicked if at least one module_click event with target starting with\n    'item:' was logged on it (the user opened a related product's page from the module).\n    \"\"\"\n    pageviews = pageviews.copy()\n    pageviews[\"clicked\"] = pageviews[\"pageview_id\"].isin(clicked_pageview_ids).astype(\"int64\")\n    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\n    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_i"]
[153.004591, "i", "d\")\n    return per_user.fillna({\"clicks\": 0, \"views\": 0})\n\n\ndef decide(srm_flag, ci_low):\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\n    if srm_flag:\n        return \"invalid\"\n    return \"ship\" if ci_low > 0 else \"no_ship\"\n\n\ndef build_readout(data_dir):\n    # Section 3: the experiment is the users the assignment service randomized (method=hash).\n    # Users whose variant was set by override (allowlist/dogfood) are not in the experiment.\n    assignments = load_assignments(data_dir)\n    assignments = assignments[assignments[\"method\"] == \"hash\"].reset_index(drop=True)\n\n    # Section 3: exclude only client-based bot flags (ua_crawler), not behavioural rules.\n    assignments = exclude_bots(assignments, load_bot_flags(data_dir))\n\n    # Section 3: pageviews at or after the user's assigned_at count.\n    pageviews = load_pageviews(data_dir, assignments)\n\n    # Section 4: a pageview is clicked when the user opened the page of at least one\n    # related product from the module (target starts with 'item:').\n    # n"]
[153.004641, "o", "cat > /app/abtest/report.py << 'EOF'\r\n\u001b[?2004l\r"]
[153.004677, "i", "av:prev, nav:next, link:all do not open a product page and do not count.\n    module_clicks = load_module_clicks(data_dir)\n    item_clicks = module_clicks[module_clicks[\"target\"].str.startswith(\"item:\")]\n    clicked_pageview_ids = set(item_clicks[\"pageview_id\"])\n\n    per_user = per_user_counts(assignments, pageviews, clicked_pageview_ids)\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\n\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\n    srm_flag = bool(srm_p < SRM_ALPHA)\n\n    notes = [\n        \"Fixed: excluded override (dogfood) assignments per plan section 3 - only hash-randomized users are in the experiment.\",\n        \"Fixed: bot exclusion now uses only client-based rule (ua_crawl"]
[153.004712, "o", "\u001b[?2004h"]
[153.004746, "i", "er) per plan section 3; velocity (behavioural) does not exclude users.\",\n        \"Fixed: a pageview is clicked only if the user opened a product page from the module (target starts with 'item:'); nav arrows and 'See all' link do not count per plan section 4.\",\n        \"With these fixes the SRM passes and the experiment is readable.\",\n    ]\n\n    return {\n        \"n_users\": n_users,\n        \"pageviews\": views,\n        \"clicks\": clicks,\n        \"ctr\": ctr,\n        \"diff\": float(diff),\n        \"ci_95\": [float(ci_low), float(ci_high)],\n        \"ci_method\": CI_METHOD,\n        \"srm_p\": srm_p,\n        \"srm_flag\": srm_flag,\n        \"decision\": decide(srm_flag, ci_low),\n        \"notes\": notes,\n    }\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=\"A/B test CTR readout\")\n    ap.add_argument(\"--data\", required=True,\n                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\""]
[153.004778, "o", "> "]
[153.004805, "i", ")\n    args = ap.parse_args(argv)\n    readout = build_readout(args.data)\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[153.00498, "o", "\"\"\"Experiment readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\n\u001b[?2004l\r"]
