[261.421753, "o", "rm -rf /tmp/copytest\r\n\u001b[?2004l\r"]
[261.427675, "o", "\u001b[?2004hroot@4a3d503a-5781-4d51-b0a8-fedbcc92141e:/tmp/copytest# "]
[261.805443, "i", "cat /app/output/result.json\n"]
[261.805701, "o", "cat /app/output/result.json\r\n\u001b[?2004l\r"]
[261.806966, "o", "{\r\n  \"n_users\": {\r\n    \"A\": 16570,\r\n    \"B\": 16702\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 165646,\r\n    \"B\": 167279\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 16436,\r\n    \"B\": 16759\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.09922364560568923,\r\n    \"B\": 0.10018591694115818\r\n  },\r\n  \"diff\": 0.0009622713354689449,\r\n  \"ci_95\": [\r\n    -0.004315790679054589,\r\n    0.006240333349992479\r\n  ],\r\n  \"ci_method\": \"delta method, users as the unit\",\r\n  \"srm_p\": 0.46927458833703506,\r\n  \"srm_flag\": false,\r\n  \"decision\": \"no_ship\",\r\n  \"notes\": [\r\n    \"Fixed: excluded override (dogfood) assignments per plan section 3 - only hash-randomized users are in the experiment.\",\r\n    \"Fixed: bot exclusion now uses only client-based rule (ua_crawler) per plan section 3; velocity (behavioural) does not exclude users.\",\r\n    \"Fixed: a pageview is clicked only if the user opened a product page from the module (target starts with 'item:'); nav arrows and 'See all' link do not count per plan section 4.\",\r\n    \"With these fixes the SRM passes and the experiment is readable."]
[261.806996, "o", "\"\r\n  ]\r\n}\r\n"]
