[192.978676, "o", "variant\r\nB    16702\r\nA    16570\r\nName: count, dtype: int64\r\n"]
[193.01552, "o", "\u001b[?2004hroot@4a3d503a-5781-4d51-b0a8-fedbcc92141e:/app# "]
[229.705845, "i", "cd /app && python3 -c \"\nimport pandas as pd\na = pd.read_csv('data/assignments.csv.gz', dtype=str).drop_duplicates()\na = a[a['method']=='hash']\nb = pd.read_csv('data/bot_flags.csv.gz', dtype=str)\nua = set(b[b['rule']=='ua_crawler']['user_id'])\na = a[~a['user_id'].isin(ua)]\na['assigned_at'] = pd.to_datetime(a['assigned_at'], utc=True, format='ISO8601')\npv = pd.read_csv('data/pageviews.csv.gz', dtype={'pageview_id':str,'user_id':str,'ts':str,'clicked':'int64'})\npv['ts'] = pd.to_datetime(pv['ts'], utc=True, format='ISO8601')\npv = pv.merge(a[['user_id','variant','assigned_at']], on='user_id', how='inner')\npv = pv[pv['ts'] >= pv['assigned_at']]\nmc = pd.read_csv('data/module_clicks.csv.gz', dtype=str)\nitem = set(mc[mc['target'].str.startswith('item:')]['pageview_id'])\npv['is_click'] = pv['pageview_id'].isin(item).astype(int)\ng = pv.groupby(['user_id','variant']).agg(clicks=('is_click','sum'), views=('is_click','size'))\nfor arm in ('A','B'):\n    s = g.xs(arm, level='variant')\n    print(arm, 'users', len(s), 'views', "]
[229.705884, "i", "int(s['views'].sum()), 'clicks', int(s['clicks'].sum()))\n\"\n"]
[229.706055, "o", "cd /app && python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.706141, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.706378, "o", "a = pd.read_csv('data/assignments.csv.gz', dtype=str).drop_duplicates()\r\n\u001b[?2004l\r"]
[229.706415, "o", "\u001b[?2004h> "]
[229.706482, "o", "a = a[a['method']=='hash']\r\n\u001b[?2004l\r"]
[229.706515, "o", "\u001b[?2004h> "]
[229.706664, "o", "b = pd.read_csv('data/bot_flags.csv.gz', dtype=str)\r\n\u001b[?2004l\r"]
[229.706699, "o", "\u001b[?2004h> "]
[229.70683, "o", "ua = set(b[b['rule']=='ua_crawler']['user_id'])\r\n\u001b[?2004l\r"]
[229.70687, "o", "\u001b[?2004h> "]
[229.706943, "o", "a = a[~a['user_id'].isin(ua)]\r\n\u001b[?2004l\r"]
[229.706976, "o", "\u001b[?2004h> "]
[229.707205, "o", "a['assigned_at'] = pd.to_datetime(a['assigned_at'], utc=True, format='ISO8601')\r\n\u001b[?2004l\r"]
[229.707239, "o", "\u001b[?2004h> "]
[229.70756, "o", "pv = pd.read_csv('data/pageviews.csv.gz', dtype={'pageview_id':str,'user_id':str,'ts':str,'clicked':'int64'})\r\n\u001b[?2004l\r"]
[229.707595, "o", "\u001b[?2004h> "]
[229.707771, "o", "pv['ts'] = pd.to_datetime(pv['ts'], utc=True, format='ISO8601')\r\n\u001b[?2004l\r"]
[229.707805, "o", "\u001b[?2004h> "]
[229.708033, "o", "pv = pv.merge(a[['user_id','variant','assigned_at']], on='user_id', how='inner')\r\n\u001b[?2004l\r"]
[229.708071, "o", "\u001b[?2004h> "]
[229.708173, "o", "pv = pv[pv['ts'] >= pv['assigned_at']]\r\n\u001b[?2004l\r"]
[229.70821, "o", "\u001b[?2004h> "]
[229.70837, "o", "mc = pd.read_csv('data/module_clicks.csv.gz', dtype=str)\r\n\u001b[?2004l\r"]
[229.708403, "o", "\u001b[?2004h> "]
[229.70859, "o", "item = set(mc[mc['target'].str.startswith('item:')]['pageview_id'])\r\n\u001b[?2004l\r"]
[229.708624, "o", "\u001b[?2004h> "]
[229.708787, "o", "pv['is_click'] = pv['pageview_id'].isin(item).astype(int)\r\n\u001b[?2004l\r"]
[229.708823, "o", "\u001b[?2004h> "]
[229.709093, "o", "g = pv.groupby(['user_id','variant']).agg(clicks=('is_click','sum'), views=('is_click','size'))\r\n\u001b[?2004l\r"]
[229.709132, "o", "\u001b[?2004h> "]
[229.709192, "o", "for arm in ('A','B'):\r\n\u001b[?2004l\r"]
[229.709229, "o", "\u001b[?2004h> "]
[229.709345, "o", "    s = g.xs(arm, level='variant')\r\n\u001b[?2004l\r"]
[229.709383, "o", "\u001b[?2004h> "]
[229.709671, "o", "    print(arm, 'users', len(s), 'views', int(s['views'].sum()), 'clicks', int(s['clicks'].sum()))\r\n\u001b[?2004l\r"]
[229.70969, "o", "\u001b[?2004h> "]
[229.70971, "o", "\"\r\n\u001b[?2004l\r"]
[230.534091, "o", "A users 14879 views 165646 clicks 16436\r\n"]
[230.534737, "o", "B users 14873 views 167279 clicks 16759\r\n"]
[230.585612, "o", "\u001b[?2004hroot@4a3d503a-5781-4d51-b0a8-fedbcc92141e:/app# "]
[237.550203, "i", "cd /app && cp -r /app /tmp/copytest 2>/dev/null; cd /tmp/copytest && python -m abtest.report --data /app/data --out /tmp/copytest/out.json && echo '--- relative out ---' && python -m abtest.report --data data --out output/result.json && cat output/result.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print('keys ok:', all(k in d for k in ['n_users','pageviews','clicks','ctr','diff','ci_95','srm_p','srm_flag','decision']))\"\n"]
[237.551314, "o", "cd /app && cp -r /app /tmp/copytest 2>/dev/null; cd /tmp/copytest && python -m abtest.report --data /app/data --out /tmp/copytest/out.json && echo '--- relative out ---' && python -m abtest.report --data data --out output/result.json && cat output/result.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print('keys ok:', all(k in d for k in ['n_users','pageviews','clicks','ctr','diff','ci_95','srm_p','srm_flag','decision']))\"\r\n\u001b[?2004l\r"]
