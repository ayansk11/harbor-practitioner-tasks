[152.626673, "i", "cat > /app/abtest/filters.py << 'EOF'\n\"\"\"Population filters for the readout.\"\"\"\n\n\ndef exclude_bots(assignments, bot_flags):\n    \"\"\"Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).\n\n    A user is excluded if the platform's bot screening flagged the user by a rule that\n    looks only at who the client is (its user agent, network or device): the `ua_crawler`\n    rule.  Behavioural rules (e.g. `velocity`, which looks at the user's own click events)\n    do not exclude the user from the experiment.\n    \"\"\"\n    flagged = set(bot_flags.loc[bot_flags[\"rule\"] == \"ua_crawler\", \"user_id\"])\n    return assignments[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\nEOF\n"]
[152.626866, "o", "cat > /app/abtest/filters.py << 'EOF'\r\n\u001b[?2004l\r"]
[152.626928, "o", "\u001b[?2004h> "]
[152.627035, "o", "\"\"\"Population filters for the readout.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.627072, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.627107, "o", "\u001b[?2004h> "]
[152.627216, "o", "def exclude_bots(assignments, bot_flags):\r\n\u001b[?2004l\r"]
[152.627244, "o", "\u001b[?2004h> "]
[152.627493, "o", "    \"\"\"Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.627533, "o", "> \r\n\u001b[?2004l\r"]
[152.627559, "o", "\u001b[?2004h> "]
[152.627757, "o", "    A user is excluded if the platform's bot screening flagged the user by a rule that\r\n\u001b[?2004l\r"]
[152.627787, "o", "\u001b[?2004h> "]
[152.627999, "o", "    looks only at who the client is (its user agent, network or device): the `ua_crawler`\r\n\u001b[?2004l\r"]
[152.62804, "o", "\u001b[?2004h> "]
