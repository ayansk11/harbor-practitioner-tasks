[192.577733, "o", "> \"\r\n\u001b[?2004l\r"]
[192.964107, "o", "total hash rows: 34100\r\n"]
[192.965932, "o", "method\r\nhash        34000\r\noverride      100\r\nName: count, dtype: int64\r\n"]
