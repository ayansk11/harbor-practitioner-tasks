     1	"""EXP-2291 readout pipeline: load the experiment export, apply the population rules, compute the CTR readout."""
===== abtest/filters.py =====
     1	"""Population filters for the readout."""
     2	
     3	
     4	def exclude_bots(assignments, bot_flags):
     5	    """Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).
     6	
     7	    Bot traffic is every user the platform's bot screening flagged (bot_flags.csv.gz): crawlers (rule ua_crawler)
     8	    and, since SEC-219, click-fraud bots on the related-items module (rule velocity).
     9	    """
    10	    flagged = set(bot_flags["user_id"])
    11	    return assignments[~assignments["user_id"].isin(flagged)].reset_index(drop=True)
===== abtest/load.py =====
     1	"""Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder."""
     2	from pathlib import Path
     3	
     4	import pandas as pd
     5	
     6	
     7	def _read(data_dir, name, dtype=str):
     8	    return pd.read_csv(Path(data_dir) / f"{name}.csv.gz", dtype=dtype)
     9	
    10	
    11	def _instants(col):
    12	    # The export mixes "Z" and "+hh:mm" / "-hh:mm" offsets. Parse to UTC: compare instants, never strings.
    13	    return pd.to_datetime(col, utc=True, format="ISO8601")
    14	
    15	
    16	def load_assignments(data_dir):
    17	    """One row per assigned user: user_id, variant ("A" or "B"), assigned_at (UTC), method."""
    18	    df = _read(data_dir, "assignments")
    19	    df = df.drop_duplicates()  # the assignment logger retries; an exact repeat of a row counts once
    20	    df["assigned_at"] = _instants(df["assigned_at"])
    21	    return df.reset_index(drop=True)
    22	
    23	
    24	def load_bot_flags(data_dir):
    25	    """One row per flag of the platform's bot screening: user_id, rule, flagged_at (UTC)."""
    26	    df = _read(data_dir, "bot_flags")
    27	    df["flagged_at"] = _instants(df["flagged_at"])
    28	    return df
    29	
    30	
    31	def load_pageviews(data_dir, assignments):
    32	    """Pageviews of the given assigned users, on or after the user's assignment time, with the variant attached."""
    33	    pv = _read(data_dir, "pageviews", dtype={"pageview_id": str, "user_id": str, "ts": str, "clicked": "int64"})
    34	    pv["ts"] = _instants(pv["ts"])
    35	    pv = pv.merge(assignments[["user_id", "variant", "assigned_at"]], on="user_id", how="inner")
    36	    pv = pv[pv["ts"] >= pv["assigned_at"]]  # exposure before assignment is not part of the experiment
    37	    return pv.reset_index(drop=True)
    38	
    39	
    40	def load_module_clicks(data_dir):
    41	    """Events of the related-items module: pageview_id, user_id, ts (UTC), target."""
    42	    df = _read(data_dir, "module_clicks")
    43	    df["ts"] = _instants(df["ts"])
    44	    return df
===== abtest/report.py =====
     1	"""EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>"""
     2	import argparse
     3	import json
     4	from pathlib import Path
     5	
     6	from .filters import exclude_bots
     7	from .load import load_assignments, load_bot_flags, load_pageviews
     8	from .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue
     9	
    10	ARMS = ("A", "B")
    11	
    12	
    13	def per_user_counts(assignments, pageviews):
    14	    """One row per counted user (users with no pageview included): user_id, variant, clicks, views.
    15	
    16	    A pageview's click is its `clicked` flag (the module click flag of the export).
    17	    """
    18	    g = pageviews.groupby("user_id").agg(clicks=("clicked", "sum"), views=("clicked", "size"))
    19	    per_user = assignments[["user_id", "variant"]].join(g, on="user_id")
    20	    return per_user.fillna({"clicks": 0, "views": 0})
    21	
    22	
    23	def decide(srm_flag, ci_low):
    24	    """EXPERIMENT.md section 7, in this order."""
    25	    if srm_flag:
    26	        return "invalid"
    27	    return "ship" if ci_low > 0 else "no_ship"
    28	
    29	
    30	def build_readout(data_dir):
    31	    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))
    32	    pageviews = load_pageviews(data_dir, assignments)
    33	    per_user = per_user_counts(assignments, pageviews)
    34	    arms = {arm: per_user[per_user["variant"] == arm] for arm in ARMS}
    35	
    36	    n_users = {arm: int(len(arms[arm])) for arm in ARMS}
    37	    views = {arm: int(arms[arm]["views"].sum()) for arm in ARMS}
    38	    clicks = {arm: int(arms[arm]["clicks"].sum()) for arm in ARMS}
    39	    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}
    40	    diff, (ci_low, ci_high) = diff_ci(arms["A"], arms["B"])
    41	    srm_p = srm_pvalue(n_users["A"], n_users["B"])
    42	    srm_flag = bool(srm_p < SRM_ALPHA)
    43	    return {
    44	        "experiment": "EXP-2291",
    45	        "n_users": n_users,
    46	        "pageviews": views,
    47	        "clicks": clicks,
    48	        "ctr": ctr,
    49	        "diff": float(diff),
    50	        "rel_lift": float(diff / ctr["A"]),
    51	        "ci_95": [float(ci_low), float(ci_high)],
    52	        "ci_method": CI_METHOD,
    53	        "srm_p": srm_p,
    54	        "srm_flag": srm_flag,
    55	        "decision": decide(srm_flag, ci_low),
    56	    }
    57	
    58	
    59	def main(argv=None):
    60	    ap = argparse.ArgumentParser(description="EXP-2291 CTR readout")
    61	    ap.add_argument("--data", required=True,
    62	                    help="export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)")
    63	    ap.add_argument("--out", required=True, help="path of the result.json to write")
    64	    args = ap.parse_args(argv)
    65	    readout = build_readout(args.data)
    66	    out = Path(args.out)
    67	    out.parent.mkdir(parents=True, exist_ok=True)
    68	    out.write_text(json.dumps(readout, indent=2) + "\n")
    69	    print(f"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} "
    70	          f"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}")
    71	
    72	
    73	if __name__ == "__main__":
    74	    main()
===== abtest/stats.py =====
     1	"""Statistics for the CTR readout (EXPERIMENT.md sections 5 and 6). The unit of randomization is the user."""
     2	import math
     3	
     4	import numpy as np
     5	from scipy.stats import chisquare, norm
     6	
     7	Z = float(norm.ppf(0.975))
     8	SRM_ALPHA = 0.001
     9	CI_METHOD = "delta method, users as the unit"
    10	
    11	
    12	def ratio_delta(clicks, views):
    13	    """CTR = sum(clicks) / sum(views) over users, and its delta-method variance.
    14	
    15	    clicks, views: one entry per counted user, users with zero pageviews included. Var = N/(N-1) * sum((c - r v)^2) /
    16	    (sum v)^2, the usual linearisation of a ratio of two user-level means.
    17	    """
    18	    c = np.asarray(clicks, dtype=float)
    19	    v = np.asarray(views, dtype=float)
    20	    n = len(c)
    21	    r = c.sum() / v.sum()
    22	    var = n / (n - 1) * float(np.sum((c - r * v) ** 2)) / float(v.sum()) ** 2
    23	    return float(r), var
    24	
    25	
    26	def diff_ci(arm_a, arm_b):
    27	    """CTR_B - CTR_A and its 95% CI; arm_a, arm_b: per-user frames with columns clicks, views."""
    28	    ra, va = ratio_delta(arm_a["clicks"], arm_a["views"])
    29	    rb, vb = ratio_delta(arm_b["clicks"], arm_b["views"])
    30	    diff = rb - ra
    31	    se = math.sqrt(va + vb)
    32	    return diff, (diff - Z * se, diff + Z * se)
    33	
    34	
    35	def srm_pvalue(n_a, n_b):
    36	    """Pearson chi-square goodness of fit of the user counts against 50/50 (1 df, no continuity correction)."""
    37	    return float(chisquare([n_a, n_b]).pvalue)
===== README.md =====
     1	# EXP-2291 readout
     2	
     3	Readout pipeline for experiment EXP-2291 ("related items v2" on product pages). The plan it must follow is
     4	`EXPERIMENT.md`.
     5	
     6	Run it from this folder:
     7	
     8	    python -m abtest.report --data data --out output/result.json
     9	
    10	Layout:
    11	
    12	| Path | What it is |
    13	|---|---|
    14	| `abtest/load.py` | reads the four export files, parses timestamps to UTC, drops repeated assignment rows and pre-assignment pageviews |
    15	| `abtest/filters.py` | the population filter: applies the platform's bot screening (`bot_flags.csv.gz`) to both arms |
    16	| `abtest/stats.py` | statistics for the readout: the delta-method interval and the SRM test |
    17	| `abtest/report.py` | the command: per-user clicks and pageviews, the readout, `result.json`; a click is a pageview's `clicked` value, the module click flag |
    18	| `data/` | the EXP-2291 export: `assignments.csv.gz`, `bot_flags.csv.gz`, `pageviews.csv.gz`, `module_clicks.csv.gz` |
    19	| `docs/` | the data platform's documentation of the export (`DATA_DICTIONARY.md`, `TRACKING.md`, `BOT_SCREENING.md`) and the launch record of EXP-2291 (`LAUNCH_EXP-2291.md`) |
    20	| `output/result.json` | the last readout |
    21	| `PM_NOTE.md` | the PM's note about this readout |
    22	
    23	Every experiment export from the data platform has the same four files and columns, so the same command is used for
    24	other experiments with `--data <their folder>`.
