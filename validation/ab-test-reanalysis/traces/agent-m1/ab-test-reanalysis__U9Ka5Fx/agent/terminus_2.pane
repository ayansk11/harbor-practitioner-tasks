cat > abtest/filters.py <<'PY'
"""Population filters for the readout."""


def exclude_bots(assignments, bot_flags):
    """Drop client-identified bot traffic before anything is counted (EXPERIMENT.md section 3).

    Only ``ua_crawler`` looks solely at the client (user agent or network). The ``velocity`` rule looks at
    behavior during the experiment, so by the plan it must not remove a user from either arm.
    """
    flagged = set(bot_flags.loc[bot_flags["rule"].eq("ua_crawler"), "user_id"])
    return assignments.loc[~assignments["user_id"].isin(flagged)].reset_index(drop=True)
PY

