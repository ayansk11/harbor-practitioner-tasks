[49.666259, "i", "python - <<'PY'\nimport pandas as pd\nfrom scipy.stats import chisquare\nD='data'\na=pd.read_csv(f'{D}/assignments.csv.gz',dtype=str)\nb=pd.read_csv(f'{D}/bot_flags.csv.gz',dtype=str)\np=pd.read_csv(f'{D}/pageviews.csv.gz',dtype={'pageview_id':str,'user_id':str,'clicked':'int64'})\nm=pd.read_csv(f'{D}/module_clicks.csv.gz',dtype=str)\nprint('raw unique users by method/variant:')\nprint(a.drop_duplicates().groupby(['method','variant']).user_id.nunique().unstack(fill_value=0))\nprint('bot users by rule/variant:')\nprint(b.drop_duplicates().merge(a.drop_duplicates(),on='user_id').groupby(['rule','variant']).user_id.nunique().unstack(fill_value=0))\nkeep=a.drop_duplicates().query(\"method == 'hash'\")\nkeep=keep[~keep.user_id.isin(b.loc[b.rule.eq('ua_crawler'),'user_id'])]\nprint('population A/B',keep.variant.value_counts().to_dict(),'total',len(keep),'srm p',chisquare(keep.variant.value_counts().reindex(['A','B']).to_numpy()).pvalue)\nats=pd.to_datetime(a.assigned_at,utc=True,format='ISO8601'); a['_at']=ats\npts=pd.to_datetime(p."]
[49.666351, "i", "ts,utc=True,format='ISO8601'); p['_at']=pts\nmts=pd.to_datetime(m.ts,utc=True,format='ISO8601'); m['_at']=mts\nx=p.merge(a[['user_id','variant','_at']],on='user_id').query('_at_y <= _at_x')\nvalid=set(x.pageview_id)\nq=m[m.target.str.startswith('item:') & m.pageview_id.isin(valid)]\nprint('counted pv',x.variant.value_counts().to_dict())\nprint('clicked pv',q.groupby('pageview_id').size().rename('n').reset_index().merge(x[['pageview_id','variant']],on='pageview_id').variant.value_counts().to_dict())\nprint('ts ranges assigned/pv/click',a._at.min(),a._at.max(),p._at.min(),p._at.max(),m._at.min(),m._at.max())\nprint('click before pv',sum(q.merge(p[['pageview_id','_at']],on='pageview_id').eval('_at_x < _at_y')))\nprint('qualifying target examples',m.loc[m.target.str.startswith('item:'),'target'].head().tolist())\nPY\n"]
