[290.184845, "o", "\r\n===== final sources =====\r\n"]
[290.184866, "o", "\u001b[?2004hroot@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[290.185121, "o", "for f in abtest/load.py abtest/filters.py abtest/report.py; do echo \"--- $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[290.185163, "o", "--- abtest/load.py\r\n"]
[290.186178, "o", "\"\"\"Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder.\r\n\r\nThe export contains dashboard and QA artifacts as well as the quantities needed by the analysis plan.  In\r\nparticular, ``pageviews.clicked`` is precomputed from every module click, and assignment rows with method\r\n``override`` were not set by the experiment's hash randomization.\r\n\"\"\"\r\nfrom pathlib import Path\r\n\r\nimport pandas as pd\r\n\r\n\r\ndef _read(data_dir, name, **kwargs):\r\n    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=str, **kwargs)\r\n\r\n\r\ndef _instants(col):\r\n    # Exports mix \"Z\" and numeric UTC offsets. Parse to UTC and compare instants, never strings.\r\n    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n\r\n\r\ndef load_assignments(data_dir):\r\n    \"\"\"One row per randomized user: user_id, variant, assigned_at (UTC), method.\r\n\r\n    Assignment-service retries can duplicate an assignment row exactly; such a row counts once. Rows whose\r\n    method is ``override`` were set manually"]
[290.186204, "o", " in the feature-flag console and are not part of the\r\n    randomization described by the plan.\r\n    \"\"\"\r\n    df = _read(data_dir, \"assignments\", usecols=[\"user_id\", \"variant\", \"assigned_at\", \"method\"])\r\n    df = df.drop_duplicates()\r\n    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\r\n    df = df.loc[df[\"method\"].eq(\"hash\")].copy()\r\n    return df.reset_index(drop=True)\r\n\r\n\r\ndef load_bot_flags(data_dir):\r\n    \"\"\"One row per bot-screening flag: user_id, rule, flagged_at (UTC).\"\"\"\r\n    df = _read(data_dir, \"bot_flags\", usecols=[\"user_id\", \"rule\", \"flagged_at\"])\r\n    df[\"flagged_at\"] = _instants(df[\"flagged_at\"])\r\n    return df\r\n\r\n\r\ndef load_pageviews(data_dir, assignments, module_clicks=None):\r\n    \"\"\"Counted pageviews for the supplied randomized users, with their variants.\r\n\r\n    A pageview is counted when its load instant is at or after that user's assignment instant. Click status\r\n    is derived from ``module_clicks`` rather than the dashboard's precomputed ``clicked`` field: only a\r\n    click on ``item:<pr"]
[290.186216, "o", "oduct_id>`` opens a related product page. Multiple qualifying clicks on the same\r\n    pageview still make that pageview one clicked pageview.\r\n    \"\"\"\r\n    pv = _read(data_dir, \"pageviews\", usecols=[\"pageview_id\", \"user_id\", \"ts\"])\r\n    pv[\"ts\"] = _instants(pv[\"ts\"])\r\n    pv = pv.merge(\r\n        assignments[[\"user_id\", \"variant\", \"assigned_at\"]],\r\n        on=\"user_id\",\r\n        how=\"inner\",\r\n    )\r\n    pv = pv.loc[pv[\"ts\"].ge(pv[\"assigned_at\"])].copy()\r\n\r\n    if module_clicks is None:\r\n        module_clicks = load_module_clicks(data_dir)\r\n    qualifying = module_clicks.loc[\r\n        module_clicks[\"target\"].fillna(\"\").str.startswith(\"item:\"), \"pageview_id\"\r\n    ].unique()\r\n    pv[\"clicked\"] = pv[\"pageview_id\"].isin(qualifying).astype(\"int64\")\r\n    return pv.reset_index(drop=True)\r\n\r\n\r\ndef load_module_clicks(data_dir):\r\n    \"\"\"Related-items module click events: pageview_id, user_id, ts (UTC), target.\"\"\"\r\n    df = _read(data_dir, \"module_clicks\", usecols=[\"pageview_id\", \"user_id\", \"ts\", \"target\"])\r\n    df[\"ts\"] "]
[290.186222, "o", "= _instants(df[\"ts\"])\r\n    return df.reset_index(drop=True)\r\n"]
[290.186344, "o", "--- abtest/filters.py\r\n"]
[290.187398, "o", "\"\"\"Population filters for the readout.\"\"\"\r\n\r\n\r\ndef exclude_bots(assignments, bot_flags):\r\n    \"\"\"Drop client-identified bot traffic before anything is counted (EXPERIMENT.md section 3).\r\n\r\n    Only ``ua_crawler`` looks solely at the client (user agent or network). The ``velocity`` rule looks at\r\n    behavior during the experiment, so by the plan it must not remove a user from either arm.\r\n    \"\"\"\r\n    flagged = set(bot_flags.loc[bot_flags[\"rule\"].eq(\"ua_crawler\"), \"user_id\"])\r\n    return assignments.loc[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\r\n"]
[290.18755, "o", "--- abtest/report.py\r\n"]
[290.188583, "o", "\"\"\"Experiment CTR readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\nimport argparse\r\nimport json\r\nfrom pathlib import Path\r\n\r\nfrom .filters import exclude_bots\r\nfrom .load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\r\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n\r\nARMS = (\"A\", \"B\")\r\n\r\n\r\ndef per_user_counts(assignments, pageviews):\r\n    \"\"\"One row per counted user (including users with no pageview): user_id, variant, clicks, views.\"\"\"\r\n    pv_counts = pageviews.groupby(\"user_id\", sort=False).agg(\r\n        clicks=(\"clicked\", \"sum\"),\r\n        views=(\"pageview_id\", \"size\"),\r\n    )\r\n    per_user = assignments[[\"user_id\", \"variant\"]].join(pv_counts, on=\"user_id\")\r\n    per_user[[\"clicks\", \"views\"]] = per_user[[\"clicks\", \"views\"]].fillna(0)\r\n    per_user[[\"clicks\", \"views\"]] = per_user[[\"clicks\", \"views\"]].astype(\"int64\")\r\n    return per_user\r\n\r\n\r\ndef decide(srm_flag, ci_low):\r\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n    if srm_flag:\r\n "]
[290.188612, "o", "       return \"invalid\"\r\n    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n\r\n\r\ndef build_readout(data_dir):\r\n    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\r\n    module_clicks = load_module_clicks(data_dir)\r\n    pageviews = load_pageviews(data_dir, assignments, module_clicks)\r\n    per_user = per_user_counts(assignments, pageviews)\r\n    arms = {arm: per_user.loc[per_user[\"variant\"].eq(arm)] for arm in ARMS}\r\n\r\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n    srm_flag = bool(srm_p < SRM_ALPHA)\r\n    return {\r\n        \"n_users\": n_users,\r\n        \"pageviews\": views,\r\n        \"clicks\": clicks,\r\n        \"ctr\": ctr,\r\n        \"diff\": float(diff),\r\n        \"rel_lift\": fl"]
[290.188628, "o", "oat(diff / ctr[\"A\"]),\r\n        \"ci_95\": [float(ci_low), float(ci_high)],\r\n        \"ci_method\": CI_METHOD,\r\n        \"srm_p\": srm_p,\r\n        \"srm_flag\": srm_flag,\r\n        \"decision\": decide(srm_flag, ci_low),\r\n        \"notes\": [\r\n            \"Only assignments set by the hash randomization (method='hash') are in the experiment; manual 'override' rows are excluded.\",\r\n            \"Only client-based bot screening (rule='ua_crawler') is used for bot exclusion; behavior-based velocity flags do not remove users.\",\r\n            \"A pageview is clicked only when a module click with target 'item:<product_id>' opens a related product; carousel navigation and 'See all' clicks are not counted.\",\r\n            \"Pageviews are compared as timestamp instants and counted at or after assignment.\",\r\n        ],\r\n    }\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser(description=\"Experiment CTR readout\")\r\n    ap.add_argument(\"--data\", required=True,\r\n                    help=\"export folder: assignments, bot_flags, pagevi"]
[290.188636, "o", "ews and module_clicks (.csv.gz)\")\r\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n    args = ap.parse_args(argv)\r\n    readout = build_readout(args.data)\r\n    out = Path(args.out)\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
