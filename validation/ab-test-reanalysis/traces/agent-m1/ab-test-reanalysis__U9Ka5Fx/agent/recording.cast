[347.121396, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('abtest/stats.py')\ns = p.read_text()\nold = '''    total_views = float(v.sum())\n    # The plan's linearisation is undefined for an arm with no counted pageviews. Such an arm has no\n    # measurable CTR; use zero variance so the report can still be generated and its decision can be read.\n    if total_views == 0:\n        return 0.0, 0.0\n'''\nnew = '''    total_views = float(v.sum())\n    # The plan's linearisation is undefined when there are fewer than two users or no counted pageviews.\n    # Treat such a degenerate arm as having no measurable uncertainty so the report can still be generated.\n    if len(c) < 2 or total_views == 0:\n        return 0.0, 0.0\n'''\nif old not in s:\n    raise SystemExit('expected stats.py block not found')\np.write_text(s.replace(old, new))\nPY\npython -m py_compile abtest/*.py\nrm -rf /tmp/abtest-portable/abtest && cp -R abtest /tmp/abtest-portable/\nchmod 777 /tmp/abtest-portable-run\nsu portablerun -c 'cd /tmp/abtest-portable && python -m abt"]
[347.121488, "i", "est.report --data input --out /tmp/abtest-portable-run/result.json'\ncat /tmp/abtest-portable-run/result.json\n"]
