[196.588923, "i", "cat > abtest/load.py <<'PY'\n\"\"\"Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder.\n\nThe export contains dashboard and QA artifacts as well as the quantities needed by the analysis plan.  In\nparticular, ``pageviews.clicked`` is precomputed from every module click, and assignment rows with method\n``override`` were not set by the experiment's hash randomization.\n\"\"\"\nfrom pathlib import Path\n\nimport pandas as pd\n\n\ndef _read(data_dir, name, **kwargs):\n    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=str, **kwargs)\n\n\ndef _instants(col):\n    # Exports mix \"Z\" and numeric UTC offsets. Parse to UTC and compare instants, never strings.\n    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\n\n\ndef load_assignments(data_dir):\n    \"\"\"One row per randomized user: user_id, variant, assigned_at (UTC), method.\n\n    Assignment-service retries can duplicate an assignment row exactly; such a row counts once. Rows whose\n    method is ``override`` were set manu"]
[196.589013, "i", "ally in the feature-flag console and are not part of the\n    randomization described by the plan.\n    \"\"\"\n    df = _read(data_dir, \"assignments\", usecols=[\"user_id\", \"variant\", \"assigned_at\", \"method\"])\n    df = df.drop_duplicates()\n    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\n    df = df.loc[df[\"method\"].eq(\"hash\")].copy()\n    return df.reset_index(drop=True)\n\n\ndef load_bot_flags(data_dir):\n    \"\"\"One row per bot-screening flag: user_id, rule, flagged_at (UTC).\"\"\"\n    df = _read(data_dir, \"bot_flags\", usecols=[\"user_id\", \"rule\", \"flagged_at\"])\n    df[\"flagged_at\"] = _instants(df[\"flagged_at\"])\n    return df\n\n\ndef load_pageviews(data_dir, assignments, module_clicks=None):\n    \"\"\"Counted pageviews for the supplied randomized users, with their variants.\n\n    A pageview is counted when its load instant is at or after that user's assignment instant. Click status\n    is derived from ``module_clicks`` rather than the dashboard's precomputed ``clicked`` field: only a\n    click on ``item:<product_id>`` opens "]
[196.58905, "i", "a related product page. Multiple qualifying clicks on the same\n    pageview still make that pageview one clicked pageview.\n    \"\"\"\n    pv = _read(data_dir, \"pageviews\", usecols=[\"pageview_id\", \"user_id\", \"ts\"])\n    pv[\"ts\"] = _instants(pv[\"ts\"])\n    pv = pv.merge(\n        assignments[[\"user_id\", \"variant\", \"assigned_at\"]],\n        on=\"user_id\",\n        how=\"inner\",\n    )\n    pv = pv.loc[pv[\"ts\"].ge(pv[\"assigned_at\"])].copy()\n\n    if module_clicks is None:\n        module_clicks = load_module_clicks(data_dir)\n    qualifying = module_clicks.loc[\n        module_clicks[\"target\"].fillna(\"\").str.startswith(\"item:\"), \"pageview_id\"\n    ].unique()\n    pv[\"clicked\"] = pv[\"pageview_id\"].isin(qualifying).astype(\"int64\")\n    return pv.reset_index(drop=True)\n\n\ndef load_module_clicks(data_dir):\n    \"\"\"Related-items module click events: pageview_id, user_id, ts (UTC), target.\"\"\"\n    df = _read(data_dir, \"module_clicks\", usecols=[\"pageview_id\", \"user_id\", \"ts\", \"target\"])\n    df[\"ts\"] = _instants(df[\"ts\"])\n    return df.reset_"]
[196.589073, "o", "cat > abtest/load.py <<'PY'\r\n\u001b[?2004l\r"]
[196.58909, "i", "index(drop=True)\nPY\n\ncat > abtest/filters.py <<'PY'\n\"\"\"Population filters for the readout.\"\"\"\n\n\ndef exclude_bots(assignments, bot_flags):\n    \"\"\"Drop client-identified bot traffic before anything is counted (EXPERIMENT.md section 3).\n\n    Only ``ua_crawler`` looks solely at the client (user agent or network). The ``velocity`` rule looks at\n    behavior during the experiment, so by the plan it must not remove a user from either arm.\n    \"\"\"\n    flagged = set(bot_flags.loc[bot_flags[\"rule\"].eq(\"ua_crawler\"), \"user_id\"])\n    return assignments.loc[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\nPY\n\ncat > abtest/report.py <<'PY'\n\"\"\"Experiment CTR readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots\nfrom .load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\n\nARMS = (\"A\", \"B\")\n\n\ndef per_user_counts(assignment"]
[196.58911, "i", "s, pageviews):\n    \"\"\"One row per counted user (including users with no pageview): user_id, variant, clicks, views.\"\"\"\n    pv_counts = pageviews.groupby(\"user_id\", sort=False).agg(\n        clicks=(\"clicked\", \"sum\"),\n        views=(\"pageview_id\", \"size\"),\n    )\n    per_user = assignments[[\"user_id\", \"variant\"]].join(pv_counts, on=\"user_id\")\n    per_user[[\"clicks\", \"views\"]] = per_user[[\"clicks\", \"views\"]].fillna(0)\n    per_user[[\"clicks\", \"views\"]] = per_user[[\"clicks\", \"views\"]].astype(\"int64\")\n    return per_user\n\n\ndef decide(srm_flag, ci_low):\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\n    if srm_flag:\n        return \"invalid\"\n    return \"ship\" if ci_low > 0 else \"no_ship\"\n\n\ndef build_readout(data_dir):\n    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\n    module_clicks = load_module_clicks(data_dir)\n    pageviews = load_pageviews(data_dir, assignments, module_clicks)\n    per_user = per_user_counts(assignments, pageviews)\n    arms = {arm: per_user.loc[per_user[\"vari"]
[196.589149, "o", "index(drop=True)\r\nPY\r\n\r\ncat > abtest/filters.py <<'PY'\r\n\"\"\"Population filters for the readout.\"\"\"\r\n\r\n\r\ndef exclude_bots(assignments, bot_flags):\r\n    \"\"\"Drop client-identified bot traffic before anything is counted (EXPERIMENT.md section 3).\r\n\r\n    Onl"]
[196.589167, "i", "ant\"].eq(arm)] for arm in ARMS}\n\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\n    srm_flag = bool(srm_p < SRM_ALPHA)\n    return {\n        \"n_users\": n_users,\n        \"pageviews\": views,\n        \"clicks\": clicks,\n        \"ctr\": ctr,\n        \"diff\": float(diff),\n        \"rel_lift\": float(diff / ctr[\"A\"]),\n        \"ci_95\": [float(ci_low), float(ci_high)],\n        \"ci_method\": CI_METHOD,\n        \"srm_p\": srm_p,\n        \"srm_flag\": srm_flag,\n        \"decision\": decide(srm_flag, ci_low),\n        \"notes\": [\n            \"Only assignments set by the hash randomization (method='hash') are in the experiment; manual 'override' rows are excluded.\",\n            \"Only client-based bot screening (rule='ua_crawler') is"]
[196.589186, "o", "y ``ua_crawler`` looks solely at the client (user agent or network). The ``velocity`` rule looks at\r\n    behavior duri"]
[196.589204, "i", " used for bot exclusion; behavior-based velocity flags do not remove users.\",\n            \"A pageview is clicked only when a module click with target 'item:<product_id>' opens a related product; carousel navigation and 'See all' clicks are not counted.\",\n            \"Pageviews are compared as timestamp instants and counted at or after assignment.\",\n        ],\n    }\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=\"Experiment CTR readout\")\n    ap.add_argument(\"--data\", required=True,\n                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\n    args = ap.parse_args(argv)\n    readout = build_readout(args.data)\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\n          f\"ci=[{readout['ci_95'][0]:+."]
[196.589222, "o", "ng the experiment, so by the plan it must not remove a user from either arm.\r\n    \"\"\"\r\n    flagged = set(bot_flags.loc[bot_flags[\"rule\"].eq(\"ua_crawl"]
[196.589239, "i", "5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\n\n\nif __name__ == \"__main__\":\n    main()\nPY\n\npython - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\ns = s.replace(\"a click is a pageview's `clicked` value, the module click flag\",\n              \"a click is a `module_click` event whose `target` is `item:<product_id>`; the dashboard's precomputed `clicked` field is not used\")\ns = s.replace(\"the population filter: applies the platform's bot screening (`bot_flags.csv.gz`) to both arms\",\n              \"the population filter: applies only client-based bot screening (`ua_crawler`) to both arms\")\np.write_text(s)\nPY\n\ncd /app && python -m abtest.report --data data --out output/result.json\n"]
[196.58926, "o", "er\"), \"user_id\"])\r\n    return assignments.loc[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\r\nPY\r\n\r\ncat > abtest/report.py <<'PY'\r\n\"\"\"Experiment CTR readout: python -m abtest.report --data <folder> --out <result.json>"]
[196.58928, "o", "\"\"\"\r\nimport argparse\r\nimport json\r\nfrom pathlib import Path\r\n\r\nfrom .filters import exclude_bots\r\nfr"]
[196.589299, "o", "om .load import load_assignments, load_bot_flags, load_module_clicks"]
[196.589319, "o", ", load_pageviews\r\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n\r\nARMS = (\"A\", \"B\")\r\n\r\n\r\ndef per_us"]
[196.589347, "o", "er_counts(assignments, pageviews):\r\n    \"\"\"One r\u001b[?2004h"]
[196.589373, "o", "> "]
[196.589751, "o", "\"\"\"Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder.\r\n\u001b[?2004l\r"]
[196.589795, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.58982, "o", "\u001b[?2004h> "]
[196.590148, "o", "The export contains dashboard and QA artifacts as well as the quantities needed by the analysis plan.  In\r\n\u001b[?2004l\r"]
[196.590186, "o", "\u001b[?2004h"]
[196.590207, "o", "> "]
[196.590516, "o", "particular, ``pageviews.clicked`` is precomputed from every module click, and assignment rows with method\r\n\u001b[?2004l\r"]
[196.590533, "o", "\u001b[?2004h> "]
[196.590753, "o", "``override`` were not set by the experiment's hash randomization.\r\n\u001b[?2004l\r"]
[196.590773, "o", "\u001b[?2004h> "]
[196.590793, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[196.590812, "o", "\u001b[?2004h> "]
[196.590897, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[196.590915, "o", "\u001b[?2004h"]
[196.590932, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[196.590952, "o", "> "]
[196.591012, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[196.591029, "o", "\u001b[?2004h> "]
[196.591049, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.591067, "o", "> \r\n\u001b[?2004l\r"]
[196.591085, "o", "\u001b[?2004h> "]
[196.591209, "o", "def _read(data_dir, name, **kwargs):\r\n\u001b[?2004l\r"]
[196.591229, "o", "\u001b[?2004h> "]
[196.591492, "o", "    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=str, **kwargs)\r\n\u001b[?2004l\r"]
[196.591515, "o", "\u001b[?2004h"]
[196.591533, "o", "> \r\n\u001b[?2004l\r"]
[196.59155, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.591568, "o", "\u001b[?2004h> "]
[196.591633, "o", "def _instants(col):\r\n\u001b[?2004l\r"]
[196.591654, "o", "\u001b[?2004h> "]
[196.591963, "o", "    # Exports mix \"Z\" and numeric UTC offsets. Parse to UTC and compare instants, never strings.\r\n\u001b[?2004l\r"]
[196.591989, "o", "\u001b[?2004h> "]
[196.592177, "o", "    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n\u001b[?2004l\r"]
[196.592196, "o", "\u001b[?2004h> "]
[196.592212, "o", "\r\n\u001b[?2004l\r"]
[196.592228, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.592245, "o", "\u001b[?2004h"]
[196.592263, "o", "> "]
[196.592361, "o", "def load_assignments(data_dir):\r\n\u001b[?2004l\r"]
[196.592386, "o", "\u001b[?2004h> "]
[196.592653, "o", "    \"\"\"One row per randomized user: user_id, variant, assigned_at (UTC), method.\r\n\u001b[?2004l\r"]
[196.592678, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.592698, "o", "\u001b[?2004h> "]
[196.593042, "o", "    Assignment-service retries can duplicate an assignment row exactly; such a row counts once. Rows whose\r\n\u001b[?2004l\r"]
[196.593063, "o", "\u001b[?2004h> "]
[196.593396, "o", "    method is ``override`` were set manually in the feature-flag console and are not part of the\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.593432, "o", "> "]
[196.593529, "o", "    randomization described by the plan.\r\n\u001b[?2004l\r"]
[196.593549, "o", "\u001b[?2004h> "]
[196.593582, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[196.593601, "o", "\u001b[?2004h> "]
[196.593913, "o", "    df = _read(data_dir, \"assignments\", usecols=[\"user_id\", \"variant\", \"assigned_at\", \"method\"])\r\n\u001b[?2004l\r"]
[196.593933, "o", "\u001b[?2004h> "]
[196.594032, "o", "    df = df.drop_duplicates()\r\n\u001b[?2004l\r"]
[196.594051, "o", "\u001b[?2004h> "]
[196.594224, "o", "    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\r\n\u001b[?2004l\r"]
[196.594246, "o", "\u001b[?2004h"]
[196.594266, "o", "> "]
[196.594414, "o", "    df = df.loc[df[\"method\"].eq(\"hash\")].copy()\r\n\u001b[?2004l\r"]
[196.594438, "o", "\u001b[?2004h"]
[196.594459, "o", "> "]
[196.594553, "o", "    return df.reset_index(drop=True)\r\n\u001b[?2004l\r"]
[196.594572, "o", "\u001b[?2004h> "]
[196.594591, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.594609, "o", "> \r\n\u001b[?2004l\r"]
[196.594629, "o", "\u001b[?2004h> "]
[196.594727, "o", "def load_bot_flags(data_dir):\r\n\u001b[?2004l\r"]
[196.594747, "o", "\u001b[?2004h> "]
[196.594988, "o", "    \"\"\"One row per bot-screening flag: user_id, rule, flagged_at (UTC).\"\"\"\r\n\u001b[?2004l\r"]
[196.595006, "o", "\u001b[?2004h> "]
[196.595268, "o", "    df = _read(data_dir, \"bot_flags\", usecols=[\"user_id\", \"rule\", \"flagged_at\"])\r\n\u001b[?2004l\r"]
[196.595286, "o", "\u001b[?2004h> "]
[196.59546, "o", "    df[\"flagged_at\"] = _instants(df[\"flagged_at\"])\r\n\u001b[?2004l\r"]
[196.595479, "o", "\u001b[?2004h> "]
[196.595532, "o", "    return df\r\n\u001b[?2004l\r"]
[196.595549, "o", "\u001b[?2004h"]
[196.595572, "o", "> \r\n\u001b[?2004l\r "]
[196.59559, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.595607, "o", "\u001b[?2004h> "]
[196.59587, "o", "def load_pageviews(data_dir, assignments, module_clicks=None):\r\n\u001b[?2004l\r"]
[196.595891, "o", "\u001b[?2004h> "]
[196.596219, "o", "    \"\"\"Counted pageviews for the supplied randomized users, with their variants.\r\n\u001b[?2004l\r"]
[196.596239, "o", "\u001b[?2004h> "]
[196.596258, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.596277, "o", "> "]
[196.596706, "o", "    A pageview is counted when its load instant is at or after that user's assignment instant. Click status\r\n\u001b[?2004l\r"]
[196.596725, "o", "\u001b[?2004h> "]
[196.59706, "o", "    is derived from ``module_clicks`` rather than the dashboard's precomputed ``clicked`` field: only a\r\n\u001b[?2004l\r"]
[196.59708, "o", "\u001b[?2004h"]
[196.5971, "o", "> "]
[196.597506, "o", "    click on ``item:<product_id>`` opens a related product page. Multiple qualifying clicks on the same\r\n\u001b[?2004l\r"]
[196.597527, "o", "\u001b[?2004h> "]
[196.597772, "o", "    pageview still make that pageview one clicked pageview.\r\n\u001b[?2004l\r"]
[196.597816, "o", "\u001b[?2004h> "]
[196.597839, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.597859, "o", "> "]
[196.598104, "o", "    pv = _read(data_dir, \"pageviews\", usecols=[\"pageview_id\", \"user_id\", \"ts\"])\r\n\u001b[?2004l\r"]
[196.598137, "o", "\u001b[?2004h"]
[196.598156, "o", "> "]
[196.598241, "o", "    pv[\"ts\"] = _instants(pv[\"ts\"])\r\n\u001b[?2004l\r"]
[196.598261, "o", "\u001b[?2004h> "]
[196.598339, "o", "    pv = pv.merge(\r\n\u001b[?2004l\r"]
[196.598358, "o", "\u001b[?2004h"]
[196.598376, "o", "> "]
[196.598615, "o", "        assignments[[\"user_id\", \"variant\", \"assigned_at\"]],\r\n\u001b[?2004l\r"]
[196.598646, "o", "\u001b[?2004h> "]
[196.598746, "o", "        on=\"user_id\",\r\n\u001b[?2004l\r"]
[196.598767, "o", "\u001b[?2004h"]
[196.598784, "o", "> "]
[196.598868, "o", "        how=\"inner\",\r\n\u001b[?2004l\r"]
[196.598891, "o", "\u001b[?2004h"]
[196.598909, "o", "> "]
[196.598931, "o", "    )\r\n\u001b[?2004l\r"]
[196.598952, "o", "\u001b[?2004h"]
[196.598968, "o", "> "]
[196.599192, "o", "    pv = pv.loc[pv[\"ts\"].ge(pv[\"assigned_at\"])].copy()\r\n\u001b[?2004l\r"]
[196.599215, "o", "\u001b[?2004h"]
[196.59923, "o", "> \r\n\u001b[?2004l\r"]
[196.599248, "o", "\u001b[?2004h"]
[196.599263, "o", "> "]
[196.599393, "o", "    if module_clicks is None:\r\n\u001b[?2004l\r"]
[196.599433, "o", "\u001b[?2004h> "]
[196.599644, "o", "        module_clicks = load_module_clicks(data_dir)\r\n\u001b[?2004l\r"]
[196.599668, "o", "\u001b[?2004h"]
[196.599687, "o", "> "]
[196.599818, "o", "    qualifying = module_clicks.loc[\r\n\u001b[?2004l\r"]
[196.599848, "o", "\u001b[?2004h> "]
[196.60019, "o", "        module_clicks[\"target\"].fillna(\"\").str.startswith(\"item:\"), \"pageview_id\"\r\n\u001b[?2004l\r"]
[196.600214, "o", "\u001b[?2004h"]
[196.600234, "o", "> "]
[196.600286, "o", "    ].unique()\r\n\u001b[?2004l\r"]
[196.600308, "o", "\u001b[?2004h"]
[196.600328, "o", "> "]
[196.600621, "o", "    pv[\"clicked\"] = pv[\"pageview_id\"].isin(qualifying).astype(\"int64\")\r\n\u001b[?2004l\r"]
[196.600644, "o", "\u001b[?2004h> "]
[196.600802, "o", "    return pv.reset_index(drop=True)\r\n\u001b[?2004l\r"]
[196.600826, "o", "\u001b[?2004h> "]
[196.600854, "o", "\r\n\u001b[?2004l\r"]
[196.600874, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.600893, "o", "\u001b[?2004h"]
[196.600911, "o", "> "]
[196.601041, "o", "def load_module_clicks(data_dir):\r\n\u001b[?2004l\r"]
[196.601058, "o", "\u001b[?2004h"]
[196.601079, "o", "> "]
[196.601426, "o", "    \"\"\"Related-items module click events: pageview_id, user_id, ts (UTC), target.\"\"\"\r\n\u001b[?2004l\r"]
[196.601463, "o", "\u001b[?2004h"]
[196.601482, "o", "> "]
[196.601832, "o", "    df = _read(data_dir, \"module_clicks\", usecols=[\"pageview_id\", \"user_id\", \"ts\", \"target\"])\r\n\u001b[?2004l\r"]
[196.601852, "o", "\u001b[?2004h> "]
[196.602006, "o", "    df[\"ts\"] = _instants(df[\"ts\"])\r\n\u001b[?2004l\r"]
[196.602026, "o", "\u001b[?2004h> "]
[196.602188, "o", "    return df.reset_index(drop=True)\r\n\u001b[?2004l\r"]
[196.602208, "o", "\u001b[?2004h> "]
[196.60223, "o", "PY\r\n\u001b[?2004l\r"]
[196.6038, "o", "\u001b[?2004h"]
[196.603825, "o", "root@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# \r\n\u001b[?2004l\r"]
[196.60385, "o", "\u001b[?2004h"]
[196.603868, "o", "root@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[196.603993, "o", "cat > abtest/filters.py <<'PY'\r\n\u001b[?2004l\r"]
[196.604024, "o", "\u001b[?2004h"]
[196.604042, "o", "> "]
[196.604213, "o", "\"\"\"Population filters for the readout.\"\"\"\r\n\u001b[?2004l\r"]
[196.604235, "o", "\u001b[?2004h"]
[196.604254, "o", "> \r\n\u001b[?2004l\r"]
[196.604275, "o", "\u001b[?2004h> "]
[196.604291, "o", "\r\n\u001b[?2004l\r"]
[196.604311, "o", "\u001b[?2004h"]
[196.604326, "o", "> "]
[196.604489, "o", "def exclude_bots(assignments, bot_flags):\r\n\u001b[?2004l\r"]
[196.604509, "o", "\u001b[?2004h"]
[196.604526, "o", "> "]
[196.604913, "o", "    \"\"\"Drop client-identified bot traffic before anything is counted (EXPERIMENT.md section 3).\r\n\u001b[?2004l\r"]
[196.60494, "o", "\u001b[?2004h"]
[196.604964, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[196.604983, "o", "> "]
[196.605425, "o", "    Only ``ua_crawler`` looks solely at the client (user agent or network). The ``velocity`` rule looks at\r\n\u001b[?2004l\r"]
[196.605444, "o", "\u001b[?2004h"]
[196.605461, "o", "> "]
[196.605839, "o", "    behavior during the experiment, so by the plan it must not remove a user from either arm.\r\n\u001b[?2004l\r"]
[196.605859, "o", "\u001b[?2004h> "]
[196.605889, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[196.605911, "o", "\u001b[?2004h> "]
[196.60617, "o", "    flagged = set(bot_flags.loc[bot_flags[\"rule\"].eq(\"ua_crawler\"), \"user_id\"])\r\n\u001b[?2004l\r"]
[196.606191, "o", "\u001b[?2004h> "]
[196.606498, "o", "    return assignments.loc[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[196.606522, "o", "\u001b[?2004h> PY"]
[196.60654, "o", "\r\n\u001b[?2004l\r"]
[196.607997, "o", "\u001b[?2004hroot@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[196.608005, "o", "\r\n\u001b[?2004l\r"]
[196.608034, "o", "\u001b[?2004hroot@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[196.608136, "o", "cat > abtest/report.py <<'PY'\r\n\u001b[?2004l\r"]
[196.608158, "o", "\u001b[?2004h"]
[196.608177, "o", "> "]
[196.608448, "o", "\"\"\"Experiment CTR readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\n\u001b[?2004l\r"]
[196.608466, "o", "\u001b[?2004h> "]
[196.608515, "o", "import argparse\r\n\u001b[?2004l\r"]
[196.608531, "o", "\u001b[?2004h> "]
[196.608572, "o", "import json\r\n\u001b[?2004l\r"]
[196.608587, "o", "\u001b[?2004h> "]
[196.60866, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[196.608675, "o", "\u001b[?2004h> "]
[196.608691, "o", "\r\n\u001b[?2004l\r"]
[196.608706, "o", "\u001b[?2004h> "]
[196.608795, "o", "from .filters import exclude_bots\r\n\u001b[?2004l\r"]
[196.608834, "o", "\u001b[?2004h> "]
[196.609043, "o", "from .load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\r\n\u001b[?2004l\r"]
[196.609071, "o", "\u001b[?2004h"]
[196.609089, "o", "> "]
[196.609221, "o", "from .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n\u001b[?2004l\r"]
[196.609252, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.609268, "o", "\u001b[?2004h"]
[196.609282, "o", "> "]
[196.609318, "o", "ARMS = (\"A\", \"B\")\r\n\u001b[?2004l\r"]
[196.609335, "o", "\u001b[?2004h"]
[196.609351, "o", "> \r\n\u001b[?2004l\r"]
[196.609366, "o", "\u001b[?2004h"]
[196.609388, "o", "> \r\n\u001b[?2004l\r"]
[196.609404, "o", "\u001b[?2004h> "]
[196.609516, "o", "def per_user_counts(assignments, pageviews):\r\n\u001b[?2004l\r"]
[196.609533, "o", "\u001b[?2004h> "]
[196.609806, "o", "    \"\"\"One row per counted user (including users with no pageview): user_id, variant, clicks, views.\"\"\"\r\n\u001b[?2004l\r"]
[196.609827, "o", "\u001b[?2004h> "]
[196.610019, "o", "    pv_counts = pageviews.groupby(\"user_id\", sort=False).agg(\r\n\u001b[?2004l\r"]
[196.610042, "o", "\u001b[?2004h"]
[196.610057, "o", "> "]
[196.610157, "o", "        clicks=(\"clicked\", \"sum\"),\r\n\u001b[?2004l\r"]
[196.610175, "o", "\u001b[?2004h"]
[196.610191, "o", "> "]
[196.610284, "o", "        views=(\"pageview_id\", \"size\"),\r\n\u001b[?2004l\r"]
[196.610303, "o", "\u001b[?2004h"]
[196.610318, "o", "> "]
[196.610334, "o", "    )\r\n\u001b[?2004l\r"]
[196.610349, "o", "\u001b[?2004h"]
[196.610365, "o", "> "]
[196.610567, "o", "    per_user = assignments[[\"user_id\", \"variant\"]].join(pv_counts, on=\"user_id\")\r\n\u001b[?2004l\r"]
[196.610586, "o", "\u001b[?2004h"]
[196.610601, "o", "> "]
[196.610788, "o", "    per_user[[\"clicks\", \"views\"]] = per_user[[\"clicks\", \"views\"]].fillna(0)\r\n\u001b[?2004l\r"]
[196.610804, "o", "\u001b[?2004h> "]
[196.611021, "o", "    per_user[[\"clicks\", \"views\"]] = per_user[[\"clicks\", \"views\"]].astype(\"int64\")\r\n\u001b[?2004l\r"]
[196.611038, "o", "\u001b[?2004h"]
[196.611052, "o", "> "]
[196.611099, "o", "    return per_user\r\n\u001b[?2004l\r"]
[196.611116, "o", "\u001b[?2004h"]
[196.611131, "o", "> \r\n\u001b[?2004l\r"]
[196.611151, "o", "\u001b[?2004h> "]
[196.611167, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.611252, "o", "def decide(srm_flag, ci_low):\r\n\u001b[?2004l\r"]
[196.611268, "o", "\u001b[?2004h> "]
[196.611416, "o", "    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n\u001b[?2004l\r"]
[196.611432, "o", "\u001b[?2004h"]
[196.611452, "o", "> "]
[196.611484, "o", "    if srm_flag:\r\n\u001b[?2004l\r"]
[196.6115, "o", "\u001b[?2004h"]
[196.611515, "o", "> "]
[196.611576, "o", "        return \"invalid\"\r\n\u001b[?2004l\r"]
[196.611597, "o", "\u001b[?2004h"]
[196.611611, "o", "> "]
[196.611725, "o", "    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n\u001b[?2004l\r"]
[196.611742, "o", "\u001b[?2004h> "]
[196.611758, "o", "\r\n\u001b[?2004l\r"]
[196.611772, "o", "\u001b[?2004h"]
[196.611789, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[196.611804, "o", "> "]
[196.611878, "o", "def build_readout(data_dir):\r\n\u001b[?2004l\r"]
[196.611893, "o", "\u001b[?2004h> "]
[196.612119, "o", "    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\r\n\u001b[?2004l\r"]
[196.612136, "o", "\u001b[?2004h> "]
[196.61227, "o", "    module_clicks = load_module_clicks(data_dir)\r\n\u001b[?2004l\r"]
[196.612289, "o", "\u001b[?2004h"]
[196.612311, "o", "> "]
[196.612477, "o", "    pageviews = load_pageviews(data_dir, assignments, module_clicks)\r\n\u001b[?2004l\r"]
[196.612496, "o", "\u001b[?2004h"]
[196.612513, "o", "> "]
[196.612645, "o", "    per_user = per_user_counts(assignments, pageviews)\r\n\u001b[?2004l\r"]
[196.612662, "o", "\u001b[?2004h> "]
[196.612864, "o", "    arms = {arm: per_user.loc[per_user[\"variant\"].eq(arm)] for arm in ARMS}\r\n\u001b[?2004l\r"]
[196.612881, "o", "\u001b[?2004h"]
[196.612897, "o", "> \r\n\u001b[?2004l\r"]
[196.612913, "o", "\u001b[?2004h> "]
[196.613059, "o", "    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n\u001b[?2004l\r"]
[196.613075, "o", "\u001b[?2004h> "]
[196.61325, "o", "    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[196.613267, "o", "\u001b[?2004h"]
[196.613283, "o", "> "]
[196.613455, "o", "    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[196.613471, "o", "\u001b[?2004h"]
[196.613487, "o", "> "]
[196.613641, "o", "    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n\u001b[?2004l\r"]
[196.613664, "o", "\u001b[?2004h> "]
[196.613845, "o", "    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n\u001b[?2004l\r"]
[196.613866, "o", "\u001b[?2004h"]
[196.613882, "o", "> "]
[196.614028, "o", "    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n\u001b[?2004l\r"]
[196.614049, "o", "\u001b[?2004h"]
[196.614065, "o", "> "]
[196.614166, "o", "    srm_flag = bool(srm_p < SRM_ALPHA)\r\n\u001b[?2004l\r"]
[196.614182, "o", "\u001b[?2004h> "]
[196.614224, "o", "    return {\r\n\u001b[?2004l\r"]
[196.614241, "o", "\u001b[?2004h> "]
[196.61432, "o", "        \"n_users\": n_users,\r\n\u001b[?2004l\r"]
[196.614337, "o", "\u001b[?2004h> "]
[196.614426, "o", "        \"pageviews\": views,\r\n\u001b[?2004l\r"]
[196.614444, "o", "\u001b[?2004h> "]
[196.614517, "o", "        \"clicks\": clicks,\r\n\u001b[?2004l\r"]
[196.614533, "o", "\u001b[?2004h> "]
[196.614593, "o", "        \"ctr\": ctr,\r\n\u001b[?2004l\r"]
[196.61461, "o", "\u001b[?2004h"]
[196.614626, "o", "> "]
[196.614698, "o", "        \"diff\": float(diff),\r\n\u001b[?2004l\r"]
[196.614717, "o", "\u001b[?2004h> "]
[196.614835, "o", "        \"rel_lift\": float(diff / ctr[\"A\"]),\r\n\u001b[?2004l\r"]
[196.614851, "o", "\u001b[?2004h> "]
[196.614988, "o", "        \"ci_95\": [float(ci_low), float(ci_high)],\r\n\u001b[?2004l\r"]
[196.615006, "o", "\u001b[?2004h"]
[196.615022, "o", "> "]
[196.615094, "o", "        \"ci_method\": CI_METHOD,\r\n\u001b[?2004l\r"]
[196.615112, "o", "\u001b[?2004h"]
[196.615129, "o", "> "]
[196.615181, "o", "        \"srm_p\": srm_p,\r\n\u001b[?2004l\r"]
[196.615198, "o", "\u001b[?2004h> "]
[196.615282, "o", "        \"srm_flag\": srm_flag,\r\n\u001b[?2004l\r"]
[196.615299, "o", "\u001b[?2004h> "]
[196.615442, "o", "        \"decision\": decide(srm_flag, ci_low),\r\n\u001b[?2004l\r"]
[196.615462, "o", "\u001b[?2004h> "]
[196.615527, "o", "        \"notes\": [\r\n\u001b[?2004l\r"]
[196.615545, "o", "\u001b[?2004h> "]
[196.61591, "o", "            \"Only assignments set by the hash randomization (method='hash') are in the experiment; manual 'override' rows are excluded.\",\r\n\u001b[?2004l\r"]
[196.615928, "o", "\u001b[?2004h> "]
[196.616304, "o", "            \"Only client-based bot screening (rule='ua_crawler') is used for bot exclusion; behavior-based velocity flags do not remove users.\",\r\n\u001b[?2004l\r"]
[196.616322, "o", "\u001b[?2004h> "]
[196.616784, "o", "            \"A pageview is clicked only when a module click with target 'item:<product_id>' opens a related product; carousel navigation and 'See all' clicks are not counted.\",\r\n\u001b[?2004l\r"]
[196.616803, "o", "\u001b[?2004h"]
[196.61682, "o", "> "]
[196.617057, "o", "            \"Pageviews are compared as timestamp instants and counted at or after assignment.\",\r\n\u001b[?2004l\r"]
[196.617074, "o", "\u001b[?2004h> "]
[196.61711, "o", "        ],\r\n\u001b[?2004l\r"]
[196.617132, "o", "\u001b[?2004h> "]
[196.617151, "o", "    }\r\n\u001b[?2004l\r"]
[196.617168, "o", "\u001b[?2004h> "]
[196.617183, "o", "\r\n\u001b[?2004l\r"]
[196.617199, "o", "\u001b[?2004h> "]
[196.617216, "o", "\r\n\u001b[?2004l\r"]
[196.617233, "o", "\u001b[?2004h> "]
[196.617286, "o", "def main(argv=None):\r\n\u001b[?2004l\r"]
[196.617304, "o", "\u001b[?2004h> "]
[196.617498, "o", "    ap = argparse.ArgumentParser(description=\"Experiment CTR readout\")\r\n\u001b[?2004l\r"]
[196.617515, "o", "\u001b[?2004h"]
[196.617532, "o", "> "]
[196.617637, "o", "    ap.add_argument(\"--data\", required=True,\r\n\u001b[?2004l\r"]
[196.617655, "o", "\u001b[?2004h> "]
[196.617928, "o", "                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n\u001b[?2004l\r"]
[196.617944, "o", "\u001b[?2004h> "]
[196.618166, "o", "    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n\u001b[?2004l\r"]
[196.618184, "o", "\u001b[?2004h> "]
[196.618271, "o", "    args = ap.parse_args(argv)\r\n\u001b[?2004l\r"]
[196.618287, "o", "\u001b[?2004h> "]
[196.618402, "o", "    readout = build_readout(args.data)\r\n\u001b[?2004l\r"]
[196.618425, "o", "\u001b[?2004h> "]
[196.618489, "o", "    out = Path(args.out)\r\n\u001b[?2004l\r"]
[196.618514, "o", "\u001b[?2004h> "]
[196.618641, "o", "    out.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[196.618659, "o", "\u001b[?2004h> "]
[196.618809, "o", "    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n\u001b[?2004l\r"]
[196.618831, "o", "\u001b[?2004h> "]
[196.619053, "o", "    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n\u001b[?2004l\r"]
[196.619074, "o", "\u001b[?2004h> "]
[196.619339, "o", "          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\u001b[?2004l\r"]
[196.619356, "o", "\u001b[?2004h"]
[196.619374, "o", "> \r\n\u001b[?2004l\r"]
[196.619389, "o", "\u001b[?2004h> "]
[196.619395, "o", "\r\n\u001b[?2004l\r"]
[196.619403, "o", "\u001b[?2004h"]
[196.61942, "o", "> "]
[196.619487, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[196.61951, "o", "\u001b[?2004h> "]
[196.619541, "o", "    main()\r\n\u001b[?2004l\r"]
[196.619558, "o", "\u001b[?2004h> "]
[196.619575, "o", "PY\r\n\u001b[?2004l\r"]
[196.620895, "o", "\u001b[?2004h"]
[196.620929, "o", "root@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# \r\n\u001b[?2004l\r"]
[196.620954, "o", "\u001b[?2004hroot@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[196.620984, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[196.621004, "o", "\u001b[?2004h"]
[196.621026, "o", "> "]
[196.621078, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[196.621095, "o", "\u001b[?2004h> "]
[196.621159, "o", "p = Path('README.md')\r\n\u001b[?2004l\r"]
[196.621176, "o", "\u001b[?2004h"]
[196.621194, "o", "> "]
[196.621231, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[196.621248, "o", "\u001b[?2004h> "]
[196.621465, "o", "s = s.replace(\"a click is a pageview's `clicked` value, the module click flag\",\r\n\u001b[?2004l\r"]
[196.621483, "o", "\u001b[?2004h> "]
[196.621859, "o", "              \"a click is a `module_click` event whose `target` is `item:<product_id>`; the dashboard's precomputed `clicked` field is not used\")\r\n\u001b[?2004l\r"]
[196.621877, "o", "\u001b[?2004h> "]
[196.622165, "o", "s = s.replace(\"the population filter: applies the platform's bot screening (`bot_flags.csv.gz`) to both arms\",\r\n\u001b[?2004l\r"]
[196.622183, "o", "\u001b[?2004h"]
[196.622204, "o", "> "]
[196.622475, "o", "              \"the population filter: applies only client-based bot screening (`ua_crawler`) to both arms\")\r\n\u001b[?2004l\r"]
[196.62251, "o", "\u001b[?2004h> "]
[196.622544, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[196.622565, "o", "\u001b[?2004h> "]
[196.622583, "o", "PY\r\n\u001b[?2004l\r"]
[196.642416, "o", "\u001b[?2004hroot@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# \r\n\u001b[?2004l\r"]
[196.642471, "o", "\u001b[?2004h"]
[196.642492, "o", "root@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[196.642641, "o", "cd /app && python -m abtest.report --data data --out output/result.json\r\n\u001b[?2004l\r"]
[198.16773, "o", "wrote output/result.json: decision=no_ship diff=+0.00096 ci=[-0.00432, +0.00624] srm_p=0.469\r\n"]
[198.259696, "o", "\u001b[?2004hroot@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[204.445222, "i", "cat output/result.json\n"]
[204.445369, "o", "cat output/result.json\r\n\u001b[?2004l\r"]
[204.446679, "o", "{\r\n  \"n_users\": {\r\n    \"A\": 16570,\r\n    \"B\": 16702\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 165646,\r\n    \"B\": 167279\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 16436,\r\n    \"B\": 16759\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.09922364560568923,\r\n    \"B\": 0.10018591694115818\r\n  },\r\n  \"diff\": 0.0009622713354689449,\r\n  \"rel_lift\": 0.00969800423674184,\r\n  \"ci_95\": [\r\n    -0.004315790679054589,\r\n    0.006240333349992479\r\n  ],\r\n  \"ci_method\": \"delta method, users as the unit\",\r\n  \"srm_p\": 0.46927458833703506,\r\n  \"srm_flag\": false,\r\n  \"decision\": \"no_ship\",\r\n  \"notes\": [\r\n    \"Only assignments set by the hash randomization (method='hash') are in the experiment; manual 'override' rows are excluded.\",\r\n    \"Only client-based bot screening (rule='ua_crawler') is used for bot exclusion; behavior-based velocity flags do not remove users.\",\r\n    \"A pageview is clicked only when a module click with target 'item:<product_id>' opens a related product; carousel navigation and 'See all' clicks are not counted.\",\r\n    \"Pageviews are compared as timestamp inst"]
[204.446719, "o", "ants and counted at or after assignment.\"\r\n  ]\r\n}\r\n"]
[204.446902, "o", "\u001b[?2004h"]
[204.446934, "o", "root@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[248.181313, "i", "python -m py_compile abtest/*.py && echo 'sources compile' && grep -RIn '/app/data\\|/app/output' abtest || true\n"]
[248.182097, "o", "python -m py_compile abtest/*.py && echo 'sources compile' && grep -RIn '/app/data\\|/app/output' abtest || true\r\n\u001b[?2004l\r"]
[248.212221, "o", "sources compile\r\n"]
[248.214273, "o", "\u001b[?2004hroot@90f86e45-3d88-49ef-8c13-8fb704bb5719:/app# "]
[248.565683, "i", "python - <<'PY'\nimport json\nimport numpy as np\nfrom abtest.filters import exclude_bots\nfrom abtest.load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\nfrom abtest.report import per_user_counts\nfrom abtest.stats import diff_ci\n\na = exclude_bots(load_assignments('data'), load_bot_flags('data'))\npv = load_pageviews('data', a, load_module_clicks('data'))\narms = {arm: per_user_counts(a, pv).query(\"variant == @arm\") for arm in ('A','B')}\ndiff, ci = diff_ci(arms['A'], arms['B'])\nr = json.load(open('output/result.json'))\nprint('independent delta:', repr(diff), repr(list(ci)))\nprint('matches output:', diff == r['diff'] and list(ci) == r['ci_95'])\n\n# Bootstrap check of the same user-level statistic. Fixed seed, percentile interval.\nrng = np.random.default_rng(2291)\ndiffs=[]\nfor arm in ('A','B'):\n    c=arms[arm]['clicks'].to_numpy(); v=arms[arm]['views'].to_numpy(); n=len(c)\n    sample=[]\n    for _ in range(2000):\n        idx=rng.integers(0,n,n)\n        sample.append(c[idx].sum()/v[idx].sum("]
[248.56578, "i", "))\n    diffs.append(sample)\nboot=np.array(diffs[1])-np.array(diffs[0])\nprint('bootstrap 95% percentile CI:', np.quantile(boot,[0.025,0.975]).tolist())\nPY\n"]
[248.565807, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[248.565862, "o", "\u001b[?2004h"]
[248.565891, "o", "> "]
[248.565923, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[248.565942, "o", "> "]
[248.565991, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[248.566042, "o", "\u001b[?2004h"]
[248.566062, "o", "> "]
[248.566121, "o", "from abtest.filters import exclude_bots\r\n\u001b[?2004l\r"]
[248.566141, "o", "\u001b[?2004h"]
[248.566162, "o", "> "]
[248.566422, "o", "from abtest.load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\r\n\u001b[?2004l\r"]
[248.566442, "o", "\u001b[?2004h"]
[248.566462, "o", "> "]
[248.566593, "o", "from abtest.report import per_user_counts\r\n\u001b[?2004l\r"]
[248.566625, "o", "\u001b[?2004h> "]
[248.566737, "o", "from abtest.stats import diff_ci\r\n\u001b[?2004l\r"]
[248.566759, "o", "\u001b[?2004h"]
[248.566781, "o", "> \r\n\u001b[?2004l\r"]
[248.566814, "o", "\u001b[?2004h> "]
[248.567036, "o", "a = exclude_bots(load_assignments('data'), load_bot_flags('data'))\r\n\u001b[?2004l\r"]
[248.567071, "o", "\u001b[?2004h"]
[248.567111, "o", "> "]
[248.567286, "o", "pv = load_pageviews('data', a, load_module_clicks('data'))\r\n\u001b[?2004l\r"]
[248.567312, "o", "\u001b[?2004h"]
[248.567353, "o", "> "]
[248.567607, "o", "arms = {arm: per_user_counts(a, pv).query(\"variant == @arm\") for arm in ('A','B')}\r\n\u001b[?2004l\r"]
[248.567632, "o", "\u001b[?2004h> "]
[248.56777, "o", "diff, ci = diff_ci(arms['A'], arms['B'])\r\n\u001b[?2004l\r"]
[248.567796, "o", "\u001b[?2004h"]
[248.567817, "o", "> "]
[248.567943, "o", "r = json.load(open('output/result.json'))\r\n\u001b[?2004l\r"]
[248.567962, "o", "\u001b[?2004h"]
[248.567981, "o", "> "]
[248.568157, "o", "print('independent delta:', repr(diff), repr(list(ci)))\r\n\u001b[?2004l\r"]
[248.568182, "o", "\u001b[?2004h> "]
[248.568429, "o", "print('matches output:', diff == r['diff'] and list(ci) == r['ci_95'])\r\n\u001b[?2004l\r"]
[248.568457, "o", "\u001b[?2004h"]
[248.568477, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[248.568496, "o", "> "]
[248.568786, "o", "# Bootstrap check of the same user-level statistic. Fixed seed, percentile interval.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[248.568892, "o", "rng = np.random.default_rng(2291)\r\n\u001b[?2004l\r"]
[248.568911, "o", "\u001b[?2004h> "]
[248.56895, "o", "diffs=[]\r\n\u001b[?2004l\r"]
[248.568971, "o", "\u001b[?2004h> "]
[248.569051, "o", "for arm in ('A','B'):\r\n\u001b[?2004l\r"]
[248.569072, "o", "\u001b[?2004h> "]
[248.569338, "o", "    c=arms[arm]['clicks'].to_numpy(); v=arms[arm]['views'].to_numpy(); n=len(c)\r\n\u001b[?2004l\r"]
[248.56936, "o", "\u001b[?2004h> "]
[248.569421, "o", "    sample=[]\r\n\u001b[?2004l\r"]
[248.569443, "o", "\u001b[?2004h> "]
[248.569536, "o", "    for _ in range(2000):\r\n\u001b[?2004l\r"]
[248.569559, "o", "\u001b[?2004h"]
