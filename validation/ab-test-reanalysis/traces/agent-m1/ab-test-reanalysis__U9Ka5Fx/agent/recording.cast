[412.232624, "i", "python - <<'PY'\nimport json, math\nimport scipy.stats as st\nr=json.load(open('output/result.json'))\na,b=r['n_users']['A'],r['n_users']['B']\nexpected_p=float(st.chisquare([a,b]).pvalue)\nassert r['srm_p'] == expected_p\nassert r['srm_flag'] == (expected_p < 0.001)\nassert r['decision'] == 'no_ship'\nassert all(isinstance(v,int) for v in r['n_users'].values())\nassert all(isinstance(v,int) for v in r['pageviews'].values())\nassert all(isinstance(v,int) for v in r['clicks'].values())\nassert isinstance(r['srm_flag'],bool) and isinstance(r['notes'],list)\nprint('real SRM and output schema checks passed')\nPY\npython - <<'PY'\nimport json\nr=json.load(open('/tmp/abtest-portable-run/result.json'))\nassert r['n_users'] == {'A':1,'B':2}, r['n_users']\nassert r['pageviews'] == {'A':1,'B':2}, r['pageviews']\nassert r['clicks'] == {'A':1,'B':1}, r['clicks']\nassert r['srm_flag'] is False and r['decision'] in {'ship','no_ship'}\nprint('synthetic definition and portability checks passed')\nPY\n"]
