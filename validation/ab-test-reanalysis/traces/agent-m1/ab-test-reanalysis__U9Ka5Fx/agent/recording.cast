[312.71066, "i", "python - <<'PY'\nfrom abtest.filters import exclude_bots\nfrom abtest.load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\nfrom abtest.report import per_user_counts\nfrom abtest.stats import ratio_delta\nD='/tmp/abtest-portable/input'\na=exclude_bots(load_assignments(D),load_bot_flags(D))\npv=load_pageviews(D,a,load_module_clicks(D))\nu=per_user_counts(a,pv)\nprint(a)\nprint(pv)\nprint(u)\nfor arm in ('A','B'):\n    x=u[u.variant.eq(arm)]\n    print(arm, x[['clicks','views']].to_dict('records'))\n    try: print('ratio_delta',ratio_delta(x.clicks,x.views))\n    except Exception as e: print('ratio_delta error',type(e).__name__,e)\nPY\n"]
