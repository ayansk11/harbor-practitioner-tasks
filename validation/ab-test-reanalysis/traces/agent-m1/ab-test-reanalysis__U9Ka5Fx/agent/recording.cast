[96.567029, "i", "python - <<'PY'\nimport pandas as pd\nfrom abtest.filters import exclude_bots\nfrom abtest.load import load_assignments,load_bot_flags,load_pageviews\nfrom abtest.report import per_user_counts\nA=exclude_bots(load_assignments('data'),load_bot_flags('data'))\nP=load_pageviews('data',A)\nU=per_user_counts(A,P)\nprint('assignments',len(A),A.variant.value_counts().to_dict())\nprint('pageviews',len(P),P.variant.value_counts().to_dict())\nprint('per-user users',U.variant.value_counts().to_dict())\nprint('per-user sums',U.groupby('variant')[['clicks','views']].sum().to_dict('index'))\nprint('pageview rows not represented',(~P.pageview_id.isin(P.pageview_id)).sum())\nprint('duplicate assignment rows remaining',A.user_id.duplicated().sum())\nPY\n"]
[96.567142, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[96.567327, "o", "\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.567368, "o", "from abtest.filters import exclude_bots\r\n\u001b[?2004l\r"]
[96.567405, "o", "\u001b[?2004h> "]
[96.567574, "o", "from abtest.load import load_assignments,load_bot_flags,load_pageviews\r\n\u001b[?2004l\r"]
[96.567598, "o", "\u001b[?2004h"]
[96.567619, "o", "> "]
[96.567701, "o", "from abtest.report import per_user_counts\r\n\u001b[?2004l\r"]
