[17.978992, "i", "for f in abtest/__init__.py abtest/filters.py abtest/load.py abtest/report.py abtest/stats.py README.md; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[17.97958, "o", "for f in abtest/__init__.py abtest/filters.py abtest/load.py abtest/report.py abtest/stats.py README.md; do echo \"===== $f =====\"; nl -ba \"$f\"; done"]
[17.979944, "o", "\r\n\u001b[?2004l\r===== abtest/__init__.py =====\r\n"]
[17.981108, "o", "     1\t"]
[17.981242, "o", "\"\"\"EXP-2291 readout pipeline: load the experiment export, apply the population rules, compute the CTR readout.\"\"\"\r\n"]
[17.981358, "o", "===== abtest/filters.py =====\r\n"]
[17.982266, "o", "     1\t\"\"\"Population filters for the readout.\"\"\"\r\n     2\t\r\n     3\t\r\n"]
[17.982362, "o", "     4\tdef exclude_bots(assignments, bot_flags):\r\n     5\t    \"\"\"Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).\r\n     6\t\r\n     7\t    Bot traffic is every user the platform's bot screening flagged (bot_flags.csv.gz): crawlers (rule ua_crawler)\r\n     8\t    and, since SEC-219, click-fraud bots on the related-items module (rule velocity).\r\n     9\t    \"\"\"\r\n    10\t    flagged = set(bot_flags[\"user_id\"])\r\n    11\t    return assignments[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\r\n"]
[17.983401, "o", "===== abtest/load.py =====\r\n"]
[17.983585, "o", "     1\t\"\"\"Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder.\"\"\"\r\n     2\tfrom pathlib import Path\r\n     3\t\r\n     4\timport pandas as pd\r\n     5\t\r\n     6\t\r\n     7\tdef _read(data_dir, name, dtype=str):\r\n     8\t    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=dtype)\r\n     9\t\r\n    10\t\r\n    11\tdef _instants(col):\r\n    12\t    # The export mixes \"Z\" and \"+hh:mm\" / \"-hh:mm\" offsets. Parse to UTC: compare instants, never strings.\r\n    13\t    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n    14\t\r\n    15\t\r\n    16\tdef load_assignments(data_dir):\r\n    17\t    \"\"\"One row per assigned user: user_id, variant (\"A\" or \"B\"), assigned_at (UTC), method.\"\"\"\r\n    18\t    df = _read(data_dir, \"assignments\")\r\n    19\t    df = df.drop_duplicates()  # the assignment logger retries; an exact repeat of a row counts once\r\n    20\t    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\r\n    21\t    return df.reset_index(drop=True)\r\n    22\t\r\n    23\t\r\n"]
[17.983735, "o", "    24\tdef load_bot_flags(data_dir):\r\n    25\t    \"\"\"One row per flag of the platform's bot screening: user_id, rule, flagged_at (UTC).\"\"\"\r\n    26\t    df = _read(data_dir, \"bot_flags\")\r\n    27\t    df[\"flagged_at\"] = _instants(df[\"flagged_at\"])\r\n    28\t    return df\r\n    29\t\r\n    30\t\r\n    31\tdef load_pageviews(data_dir, assignments):\r\n    32\t    \"\"\"Pageviews of the given assigned users, on or after the user's assignment time, with the variant attached.\"\"\"\r\n    33\t    pv = _read(data_dir, \"pageviews\", dtype={\"pageview_id\": str, \"user_id\": str, \"ts\": str, \"clicked\": \"int64\"})\r\n    34\t    pv[\"ts\"] = _instants(pv[\"ts\"])\r\n    35\t    pv = pv.merge(assignments[[\"user_id\", \"variant\", \"assigned_at\"]], on=\"user_id\", how=\"inner\")\r\n    36\t    pv = pv[pv[\"ts\"] >= pv[\"assigned_at\"]]  # exposure before assignment is not part of the experiment\r\n    37\t    return pv.reset_index(drop=True)\r\n    38\t\r\n    39\t\r\n    40\tdef load_module_clicks(data_dir):\r\n    41\t    \"\"\"Events of the related-items module: pageview_id, user_id, ts (UTC)"]
[17.98375, "o", ", target.\"\"\"\r\n    42\t    df = _read(data_dir, \"module_clicks\")\r\n    43\t    df[\"ts\"] = _instants(df[\"ts\"])\r\n    44\t    return df\r\n"]
[17.983894, "o", "===== abtest/report.py =====\r\n"]
[17.985283, "o", "     1\t\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\n     2\timport argparse\r\n     3\timport json\r\n     4\tfrom pathlib import Path\r\n     5\t\r\n     6\tfrom .filters import exclude_bots\r\n     7\tfrom .load import load_assignments, load_bot_flags, load_pageviews\r\n     8\tfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n     9\t\r\n    10\tARMS = (\"A\", \"B\")\r\n    11\t\r\n    12\t\r\n    13\tdef per_user_counts(assignments, pageviews):\r\n    14\t    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\r\n    15\t\r\n    16\t    A pageview's click is its `clicked` flag (the module click flag of the export).\r\n    17\t    \"\"\"\r\n    18\t    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n    19\t    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\r\n    20\t    return per_user.fillna({\"clicks\": 0, \"views\": 0})\r\n    21\t\r\n    22\t\r\n    23\tdef decide(srm_flag, ci_low):\r\n    24\t    \"\"\"EXPERIMENT.md"]
[17.985302, "o", " section 7, in this order.\"\"\"\r\n    25\t    if srm_flag:\r\n    26\t        return \"invalid\"\r\n    27\t    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n    28\t\r\n    29\t\r\n    30\tdef build_readout(data_dir):\r\n    31\t    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\r\n    32\t    pageviews = load_pageviews(data_dir, assignments)\r\n    33\t    per_user = per_user_counts(assignments, pageviews)\r\n    34\t    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n    35\t\r\n    36\t    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n    37\t    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n    38\t    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n    39\t    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n    40\t    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n    41\t    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n    42\t    srm_flag = bool(srm_p < SRM_ALPHA)\r\n    43\t    return {\r\n    44\t        \"experiment\": \"EXP-2291\",\r\n   "]
[17.985316, "o", " 45\t        \"n_users\": n_users,\r\n    46\t        \"pageviews\": views,\r\n    47\t        \"clicks\": clicks,\r\n    48\t        \"ctr\": ctr,\r\n    49\t        \"diff\": float(diff),\r\n    50\t        \"rel_lift\": float(diff / ctr[\"A\"]),\r\n    51\t        \"ci_95\": [float(ci_low), float(ci_high)],\r\n    52\t        \"ci_method\": CI_METHOD,\r\n    53\t        \"srm_p\": srm_p,\r\n    54\t        \"srm_flag\": srm_flag,\r\n    55\t        \"decision\": decide(srm_flag, ci_low),\r\n    56\t    }\r\n    57\t\r\n    58\t\r\n    59\tdef main(argv=None):\r\n    60\t    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n    61\t    ap.add_argument(\"--data\", required=True,\r\n    62\t                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n    63\t    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n    64\t    args = ap.parse_args(argv)\r\n    65\t    readout = build_readout(args.data)\r\n    66\t    out = Path(args.out)\r\n    67\t    out.parent.mkdir(parents=True, exist_ok=True)\r\n    68\t "]
[17.985327, "o", "   out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n    69\t    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n    70\t          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n    71\t\r\n    72\t\r\n    73\tif __name__ == \"__main__\":\r\n    74\t    main()\r\n===== abtest/stats.py =====\r\n"]
[17.987421, "o", "     1\t\"\"\"Statistics for the CTR readout (EXPERIMENT.md sections 5 and 6). The unit of randomization is the user.\"\"\"\r\n     2\timport math\r\n     3\t\r\n     4\timport numpy as np\r\n     5\tfrom scipy.stats import chisquare, norm\r\n     6\t\r\n     7\tZ = float(norm.ppf(0.975))\r\n     8\tSRM_ALPHA = 0.001\r\n     9\tCI_METHOD = \"delta method, users as the unit\"\r\n    10\t\r\n    11\t\r\n    12\tdef ratio_delta(clicks, views):\r\n    13\t    \"\"\"CTR = sum(clicks) / sum(views) over users, and its delta-method variance.\r\n    14\t\r\n    15\t    clicks, views: one entry per counted user, users with zero pageviews included. Var = N/(N-1) * sum((c - r v)^2) /\r\n    16\t    (sum v)^2, the usual linearisation of a ratio of two user-level means.\r\n    17\t    \"\"\"\r\n    18\t    c = np.asarray(clicks, dtype=float)\r\n    19\t    v = np.asarray(views, dtype=float)\r\n    20\t    n = len(c)\r\n    21\t    r = c.sum() / v.sum()\r\n    22\t    var = n / (n - 1) * float(np.sum((c - r * v) ** 2)) / float(v.sum()) ** 2\r\n    23\t    return float(r), var\r\n    24\t\r\n    25\t\r\n    26\td"]
[17.987441, "o", "ef diff_ci(arm_a, arm_b):\r\n    27\t    \"\"\"CTR_B - CTR_A and its 95% CI; arm_a, arm_b: per-user frames with columns clicks, views.\"\"\"\r\n    28\t    ra, va = ratio_delta(arm_a[\"clicks\"], arm_a[\"views\"])\r\n    29\t    rb, vb = ratio_delta(arm_b[\"clicks\"], arm_b[\"views\"])\r\n    30\t    diff = rb - ra\r\n    31\t    se = math.sqrt(va + vb)\r\n    32\t    return diff, (diff - Z * se, diff + Z * se)\r\n    33\t\r\n    34\t\r\n    35\tdef srm_pvalue(n_a, n_b):\r\n    36\t    \"\"\"Pearson chi-square goodness of fit of the user counts against 50/50 (1 df, no continuity correction).\"\"\"\r\n    37\t    return float(chisquare([n_a, n_b]).pvalue)\r\n"]
[17.987884, "o", "===== README.md ====="]
[17.988117, "o", "\r\n"]
[17.988955, "o", "     1\t# EXP-2291 readout\r\n     2\t\r\n     3\tReadout pipeline for experiment EXP-2291 (\"related items v2\" on product pages). The plan it must follow is\r\n     4\t`EXPERIMENT.md`.\r\n     5\t\r\n     6\tRun it from this folder:\r\n     7\t\r\n     8\t    python -m abtest.report --data data --out output/result.json\r\n     9\t"]
[17.989066, "o", "\r\n    10\tLayout:\r\n    11\t\r\n    12\t| Path | What it is |\r\n    13\t|---|---|\r\n    14\t| `abtest/load.py` | reads the four export files, parses timestamps to UTC, drops repeated assignment rows and pre-assignment pageviews |\r\n    15\t| `abtest/filters.py` | the population filter: applies the platform's bot screening (`bot_flags.csv.gz`) to both arms |\r\n    16\t| `abtest/stats.py` | statistics for the readout: the delta-method interval and the SRM test |\r\n    17\t| `abtest/report.py` | the command: per-user clicks and pageviews, the readout, `result.json`; a click is a pageview's `clicked` value, the module click flag |\r\n    18\t| `data/` | the EXP-2291 export: `assignments.csv.gz`, `bot_flags.csv.gz`, `pageviews.csv.gz`, `module_clicks.csv.gz` |\r\n    19\t| `docs/` | the data platform's documentation of the export (`DATA_DICTIONARY.md`, `TRACKING.md`, `BOT_SCREENING.md`) and the launch record of EXP-2291 (`LAUNCH_EXP-2291.md`) |\r\n    20\t| `output/result.json` | the last readout |\r\n    21\t| `PM_NOTE.md` | the PM's note a"]
[17.989087, "o", "bout this readout |\r\n    22\t\r\n    23\tEvery experiment export from the data platform has the same four files and columns, so the same command is used for\r\n    24\tother experiments with `--data <their folder>`.\r\n"]
