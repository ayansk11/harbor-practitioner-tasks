[314.727885, "i", "python - <<'PY'\nfrom pathlib import Path\np=Path('abtest/load.py')\ns=p.read_text().replace('pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=str, **kwargs)',\n                        'pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=str, keep_default_na=False, **kwargs)')\nif s == p.read_text():\n    raise SystemExit('expected load.py text not found')\np.write_text(s)\n\np=Path('abtest/stats.py')\ns=p.read_text()\nold='''    r = c.sum() / v.sum()\\n    var = n / (n - 1) * float(np.sum((c - r * v) ** 2)) / float(v.sum()) ** 2\\n    return float(r), var\\n'''\nnew='''    total_views = float(v.sum())\\n    # The plan's linearisation is undefined for an arm with no counted pageviews. Such an arm has no\\n    # measurable CTR; use zero variance so the report can still be generated and its decision can be read.\\n    if total_views == 0:\\n        return 0.0, 0.0\\n    r = c.sum() / total_views\\n    var = n / (n - 1) * float(np.sum((c - r * v) ** 2)) / total_views ** 2\\n    return float(r), var\\n'''\nif old not in s:\n    rais"]
