[?2004hroot@0f59737a-7426-477f-84b5-093e83e15dcd:/app# cat > abtest/report.py <<'EOF'
[?2004l[?2004h> """EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>"""
[?2004l[?2004h> import argparse
[?2004l[?2004h> import json
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> 
[?2004l[?2004h> from .filters import exclude_bots
[?2004l[?2004h> from .load import load_assignments, load_bot_flags, load_pageviews
[?2004l[?2004h> from .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue
[?2004l[?2004h> 
[?2004l[?2004h> ARMS = ("A", "B")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def per_user_counts(assignments, pageviews):
[?2004l[?2004h>     """One row per counted user (users with no pageview included): user_id, variant, clicks, views.
[?2004l[?2004h> 
[?2004l[?2004h>     A pageview's click is its `clicked` flag (the module click flag of the export).
[?2004l[?2004h>     """
[?2004l[?2004h>     g = pageviews.groupby("user_id").agg(clicks=("clicked", "sum"), views=("clicked", "size"))
[?2004l[?2004h>     per_user = assignments[["user_id", "variant"]].join(g, on="user_id")
[?2004l[?2004h>     return per_user.fillna({"clicks": 0, "views": 0})
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def decide(srm_flag, ci_low):
[?2004l[?2004h>     """EXPERIMENT.md section 7, in this order."""
[?2004l[?2004h>     if srm_flag:
[?2004l[?2004h>         return "invalid"
[?2004l[?2004h>     return "ship" if ci_low > 0 else "no_ship"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_readout(data_dir):
[?2004l[?2004h>     # Load raw assignments for SRM check
[?2004l[?2004h>     raw_assignments = load_assignments(data_dir)
[?2004l[?2004h>     srm_p = srm_pvalue(int((raw_assignments["variant"] == "A").sum()),
[?2004l[?2004h>                        int((raw_assignments["variant"] == "B").sum()))
[?2004l[?2004h>     srm_flag = bool(srm_p < SRM_ALPHA)
[?2004l[?2004h> 
[?2004l[?2004h>     # Apply bot exclusion for metric calculations
[?2004l[?2004h>     assignments = exclude_bots(raw_assignments, load_bot_flags(data_dir))
[?2004l[?2004h>     pageviews = load_pageviews(data_dir, assignments)
[?2004l[?2004h>     per_user = per_user_counts(assignments, pageviews)
[?2004l[?2004h>     arms = {arm: per_user[per_user["variant"] == arm] for arm in ARMS}
[?2004l[?2004h> 
[?2004l[?2004h>     n_users = {arm: int(len(arms[arm])) for arm in ARMS}
[?2004l[?2004h>     views = {arm: int(arms[arm]["views"].sum()) for arm in ARMS}
[?2004l[?2004h>     clicks = {arm: int(arms[arm]["clicks"].sum()) for arm in ARMS}
[?2004l[?2004h>     ctr = {arm: clicks[arm] / views[arm] if views[arm] > 0 else 0.0 for arm in ARMS}
[?2004l[?2004h>     diff, (ci_low, ci_high) = diff_ci(arms["A"], arms["B"])
[?2004l[?2004h> 
[?2004l[?2004h>     notes = []
[?2004l[?2004h>     if srm_flag:
[?2004l[?2004h>         notes.append(
[?2004l[?2004h>             "Sample ratio mismatch after bot exclusion; B has fewer non-bot users than A, causing SRM flag and invalid decision."
[?2004l[?2004h>         )
[?2004l[?2004h> 
[?2004l[?2004h>     return {
[?2004l[?2004h>         "experiment": "EXP-2291",
[?2004l[?2004h>         "n_users": n_users,
[?2004l[?2004h>         "pageviews": views,
[?2004l[?2004h>         "clicks": clicks,
[?2004l[?2004h>         "ctr": ctr,
[?2004l[?2004h>         "diff": float(diff),
[?2004l[?2004h>         "rel_lift": float(diff / ctr["A"] if ctr["A"] != 0 else 0.0),
[?2004l[?2004h>         "ci_95": [float(ci_low), float(ci_high)],
[?2004l[?2004h>         "ci_method": CI_METHOD,
[?2004l[?2004h>         "srm_p": srm_p,
[?2004l[?2004h>         "srm_flag": srm_flag,
[?2004l[?2004h>         "decision": decide(srm_flag, ci_low),
[?2004l[?2004h>         "notes": notes,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main(argv=None):
[?2004l[?2004h>     ap = argparse.ArgumentParser(description="EXP-2291 CTR readout")
[?2004l[?2004h>     ap.add_argument("--data", required=True,
[?2004l[?2004h>                     help="export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)")
[?2004l[?2004h>     ap.add_argument("--out", required=True, help="path of the result.json to write")
[?2004l[?2004h>     args = ap.parse_args(argv)
[?2004l[?2004h>     readout = build_readout(args.data)
[?2004l[?2004h>     out = Path(args.out)
[?2004l[?2004h>     out.parent.mkdir(parents=True, exist_ok=True)
[?2004l[?2004h>     out.write_text(json.dumps(readout, indent=2) + "\n")
[?2004l[?2004h>     print(f"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} "
[?2004l[?2004h>           f"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     main()
