[?2004l[?2004h>     pv["ts"] = _instants(pv["ts"])
[?2004l[?2004h>     pv = pv.merge(assignments[["user_id", "variant", "assigned_at"]], on="user_id", how="inner")
[?2004l[?2004h>     pv = pv[pv["ts"] >= pv["assigned_at"]]
[?2004l[?2004h>     return pv.reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_module_clicks(data_dir):
[?2004l[?2004h>     """Events of the related-items module: pageview_id, user_id, ts (UTC), target."""
[?2004l[?2004h>     df = _read(data_dir, "module_clicks")
[?2004l[?2004h>     df["ts"] = _instants(df["ts"]) 
[?2004l[?2004h>     return df
