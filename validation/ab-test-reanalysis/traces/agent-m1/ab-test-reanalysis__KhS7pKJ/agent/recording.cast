[104.667049, "o", "{\r\n  \"experiment\": \"EXP-2291\",\r\n  \"n_users\": {\r\n    \"A\": 16570,\r\n    \"B\": 15722\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 165646,\r\n    \"B\": 158616\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 16837,\r\n    \"B\": 16466\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.10164447073880443,\r\n    \"B\": 0.1038104604831795\r\n  },\r\n  \"diff\": 0.0021659897443750686,\r\n  \"rel_lift\": 0.021309469453985427,\r\n  \"ci_95\": [\r\n    -0.0033131556717745413,\r\n    0.007645135160524679\r\n  ],\r\n  \"ci_method\": \"delta method, users as the unit\",\r\n  \"srm_p\": 0.21294073078349562,\r\n  \"srm_flag\": false,\r\n  \"decision\": \"no_ship\",\r\n  \"notes\": []\r\n}\r\n"]
