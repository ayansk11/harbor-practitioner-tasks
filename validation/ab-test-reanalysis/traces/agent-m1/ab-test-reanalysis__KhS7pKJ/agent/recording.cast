[7.140681, "o", "sed -n '1,200p' PM_NOTE.md\r\n\u001b[?2004l\r"]
[7.142185, "o", "# Note from Priya (PM, product pages), Wednesday 2026-09-16\r\n\r\n**Subject:** EXP-2291 readout: please re-check before the launch on Monday\r\n\r\nThe readout in `output/result.json` came back \"invalid\": the sample ratio check failed, with 16,570 users in A and\r\n15,722 in B (about 5% fewer in B). That verdict does not match the dashboards:\r\n- the assignment dashboard shows 16,935 users in A and 17,165 in B: a clean 50/50 split (49.7% / 50.3%);\r\n- the team dashboard, which reads the same export with no filters (every pageview of every assigned user), shows\r\n  click-through of 11.03% in B against 9.82% in A: B is 12.3% higher.\r\n\r\n"]
[7.142237, "o", "Plan: turn B on for everyone on Monday 2026-09-21 if B really wins. Requests: check the analysis against the plan in\r\n`EXPERIMENT.md`, fix whatever is wrong, and put the corrected readout in `output/result.json`. The same pipeline will\r\nrun the next experiments, so the pipeline needs a proper fix, not just this one file.\r\n"]
[7.14243, "o", "\u001b[?2004hroot@0f59737a-7426-477f-84b5-093e83e15dcd:/app# "]
[7.510339, "i", "sed -n '1,200p' abtest/__init__.py\n"]
[7.510521, "o", "sed -n '1,200p' abtest/__init__.py\r\n\u001b[?2004l\r"]
[7.511986, "o", "\"\"\"EXP-2291 readout pipeline: load the experiment export, apply the population rules, compute the CTR readout.\"\"\"\r\n"]
[7.512208, "o", "\u001b[?2004hroot@0f59737a-7426-477f-84b5-093e83e15dcd:/app# "]
[7.915854, "i", "sed -n '1,200p' abtest/report.py\n"]
[7.916026, "o", "sed -n '1,200p' abtest/report.py\r\n\u001b[?2004l\r"]
[7.918373, "o", "\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\""]
[7.918699, "o", "\r\nimport argparse\r\nimport json\r\nfrom pathlib import Path\r\n\r\nfrom .filters import exclude_bots\r\nfrom .load import load_assignments, load_bot_flags, load_pageviews\r\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n\r\nARMS = (\"A\", \"B\")\r\n\r\n\r\ndef per_user_counts(assignments, pageviews):\r\n    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\r\n\r\n    A pageview's click is its `clicked` flag (the module click flag of the export).\r\n    \"\"\"\r\n    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\r\n    return per_user.fillna({\"clicks\": 0, \"views\": 0})\r\n\r\n\r\ndef decide(srm_flag, ci_low):\r\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n    if srm_flag:\r\n        return \"invalid\"\r\n    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n\r\n\r\ndef build_readout(data_dir):\r\n    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\r\n    page"]
[7.918819, "o", "views = load_pageviews(data_dir, assignments)\r\n    per_user = per_user_counts(assignments, pageviews)\r\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n\r\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n    srm_flag = bool(srm_p < SRM_ALPHA)\r\n    return {\r\n        \"experiment\": \"EXP-2291\",\r\n        \"n_users\": n_users,\r\n        \"pageviews\": views,\r\n        \"clicks\": clicks,\r\n        \"ctr\": ctr,\r\n        \"diff\": float(diff),\r\n        \"rel_lift\": float(diff / ctr[\"A\"]),\r\n        \"ci_95\": [float(ci_low), float(ci_high)],\r\n        \"ci_method\": CI_METHOD,\r\n        \"srm_p\": srm_p,\r\n        \"srm_flag\": srm_flag,\r\n        \"decision\": decide(srm_flag, ci_low),\r\n    }\r\n\r\n\r\ndef main(argv=N"]
[7.918963, "o", "one):\r\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n    ap.add_argument(\"--data\", required=True,\r\n                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n    args = ap.parse_args(argv)\r\n    readout = build_readout(args.data)\r\n    out = Path(args.out)\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n\u001b[?2004hroot@0f59737a-7426-477f-84b5-093e83e15dcd:/app# "]
