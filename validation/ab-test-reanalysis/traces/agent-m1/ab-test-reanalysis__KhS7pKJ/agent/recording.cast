[13.920234, "o", "\u001b[?2004l\r"]
[13.921499, "o", "\"\"\"Population filters for the readout.\"\"\"\r\n\r\n\r\ndef exclude_bots(assignments, bot_flags):\r\n    \"\"\"Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).\r\n\r\n    Bot traffic is every user the platform's bot screening flagged (bot_flags.csv.gz): crawlers (rule ua_crawler)\r\n    and, since SEC-219, click-fraud bots on the related-items module (rule velocity).\r\n"]
[13.921561, "o", "    \"\"\"\r\n    flagged = set(bot_flags[\"user_id\"])\r\n    return assignments[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\r\n"]
[13.921734, "o", "\u001b[?2004h"]
[13.921787, "o", "root@0f59737a-7426-477f-84b5-093e83e15dcd:/app# "]
[14.309246, "i", "sed -n '1,200p' abtest/load.py\n"]
[14.309685, "o", "sed -n '1,200p' abtest/load.py\r\n\u001b[?2004l\r"]
[14.310805, "o", "\"\"\"Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder.\"\"\"\r\nfrom pathlib import Path"]
[14.310822, "o", "\r\n\r\nimport pandas as pd\r\n"]
[14.310855, "o", "\r\n\r\ndef _read(data_dir, name, dtype=str):"]
[14.310915, "o", "\r\n    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=dtype)\r\n\r\n\r\ndef _instants(col):\r\n"]
[14.310946, "o", "    # The export mixes \"Z\" and \"+hh:mm\" / \"-hh:mm\" offsets. Parse to UTC: compare instants, never strings.\r\n    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n\r\n\r\ndef load_assignments(data_dir):\r\n    \"\"\"One row per assigned user: user_id, variant (\"A\" or \"B\"), assigned_at (UTC), method.\"\"\"\r\n    df = _read(data_dir, \"assignments\")\r\n    df = df.drop_duplicates()  # the assignment logger retries; an exact repeat of a row counts once\r\n"]
[14.310969, "o", "    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\r\n    return df.reset_index(drop=True)\r\n\r\n\r\ndef load_bot_flags(data_dir):\r\n    \"\"\"One row per flag of the platform's bot screening: user_id, rule, flagged_at (UTC).\"\"\""]
[14.310993, "o", "\r\n    df = _read(data_dir, \"bot_flags\")\r\n"]
[14.311098, "o", "    df[\"flagged_at\"] = _instants(df[\"flagged_at\"])\r\n    return df\r\n\r\n\r\ndef load_pageviews(data_dir, assignments):"]
[14.311116, "o", "\r\n    \"\"\"Pageviews of the given assigned users, on or after the user's assignment time, with the variant attached.\"\"\"\r\n    pv = _read(data_dir, \"pageviews\", dtype={\"pageview_id\": str, \"user_id\": str, \"ts\": str, \"clicked\": \"int64\"})\r\n    pv[\"ts\"] = _instants(pv[\"ts\"])\r\n    pv = pv.merge(assignments[[\"user_id\", \"variant\", \"assigned_at\"]], on=\"user_id\", how=\"inner\")\r\n    pv = pv[pv[\"ts\"] >= pv[\"assigned_at\"]]  # exposure before assignment is not part of the experiment\r\n    return pv.reset_index(drop=True)\r\n\r\n\r\ndef load_module_clicks(data_dir):\r\n    \"\"\"Events of the related-items module: pageview_id, user_id, ts (UTC), target.\"\"\"\r\n    df = _read(data_dir, \"module_clicks\")\r\n    df[\"ts\"] = _instants(df[\"ts\"])\r\n    return df"]
[14.311128, "o", "\r\n"]
[14.311357, "o", "\u001b[?2004h"]
[14.311391, "o", "root@0f59737a-7426-477f-84b5-093e83e15dcd:/app# "]
[14.696972, "i", "sed -n '1,200p' abtest/stats.py\n"]
[14.697175, "o", "sed -n '1,200p' abtest/stats.py\r\n"]
[14.697469, "o", "\u001b[?2004l\r"]
[14.698822, "o", "\"\"\"Statistics for the CTR readout (EXPERIMENT.md sections 5 and 6). The unit of randomization is the user.\"\"\"\r\nimport math\r\n\r\nimport numpy as np\r\nfrom scipy.stats import chisquare, norm\r\n\r\nZ = float(norm.ppf(0.975))\r\nSRM_ALPHA = 0.001\r\nCI_METHOD = \"delta method, users as the unit\"\r\n\r\n\r\ndef ratio_delta(clicks, views):"]
[14.698895, "o", "\r\n    \"\"\"CTR = sum(clicks) / sum(views) over users, and its delta-method variance.\r\n\r\n    clicks, views: one entry per counted user, users with zero pageviews included. Var = N/(N-1) * sum((c - r v)^2) /\r\n    (sum v)^2, the usual linearisation of a ratio of two user-level means.\r\n    \"\"\"\r\n    c = np.asarray(clicks, dtype=float)\r\n    v = np.asarray(views, dtype=float)\r\n    n = len(c)\r\n    r = c.sum() / v.sum()\r\n    var = n / (n - 1) * float(np.sum((c - r * v) ** 2)) / float(v.sum()) ** 2\r\n    return float(r), var\r\n\r\n\r\ndef diff_ci(arm_a, arm_b):\r\n    \"\"\"CTR_B - CTR_A and its 95% CI; arm_a, arm_b: per-user frames with columns clicks, views.\"\"\"\r\n    ra, va = ratio_delta(arm_a[\"clicks\"], arm_a[\"views\"])\r\n    rb, vb = ratio_delta(arm_b[\"clicks\"], arm_b[\"views\"])\r\n    diff = rb - ra\r\n    se = math.sqrt(va + vb)\r\n    return diff, (diff - Z * se, diff + Z * se)\r\n\r\n\r\ndef srm_pvalue(n_a, n_b):\r\n    \"\"\"Pearson chi-square goodness of fit of the user counts against 50/50 (1 df, no continuity correction).\"\"\"\r\n    return flo"]
[14.698928, "o", "at(chisquare([n_a, n_b]).pvalue)\r\n"]
[14.699104, "o", "\u001b[?2004h"]
[14.699146, "o", "root@0f59737a-7426-477f-84b5-093e83e15dcd:/app# "]
