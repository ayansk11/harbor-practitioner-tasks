[52.72018, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: abtest/load.py\n@@\n-def load_assignments(data_dir):\n-    \"\"\"One row per assigned user: user_id, variant (\"A\" or \"B\"), assigned_at (UTC), method.\"\"\"\n-    df = _read(data_dir, \"assignments\")\n-    df = df.drop_duplicates()  # the assignment logger retries; an exact repeat of a row counts once\n-    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\n-    return df.reset_index(drop=True)\n+def load_assignments(data_dir):\n+    \"\"\"Load assignments and ensure exactly one row per user.\n+\n+    The export may contain multiple rows for the same ``user_id`` because the\n+    assignment service retries.  The plan (section 2) states that *exact* repeat\n+    rows count once, but rows that differ only in ``assigned_at`` (e.g., a retry\n+    with a slightly later timestamp) should still be collapsed to a single\n+    assignment.  We therefore:\n+\n+    1. Parse ``assigned_at`` timestamps.\n+    2. Sort by ``assigned_at`` so the earliest assignment appears first.\n+    3. Drop duplicat"]
[52.72022, "i", "e ``user_id`` values, keeping the first (earliest) row.\n+    \"\"\"\n+    df = _read(data_dir, \"assignments\")\n+    # Convert timestamps to UTC instants before sorting/deduplication.\n+    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\n+    df = df.sort_values(\"assigned_at\")\n+    # Keep the earliest assignment per user.\n+    df = df.drop_duplicates(subset=[\"user_id\"], keep=\"first\")\n+    return df.reset_index(drop=True)\n*** End Patch\nPATCH\n"]
