[76.220357, "i", "python - <<'PY'\nimport pandas as pd, json, sys\nfrom pathlib import Path\n\ndef _read(data_dir, name, dtype=str):\n    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=dtype)\n\ndata_dir = 'data'\nassign = _read(data_dir, 'assignments')\nprint('total rows:', len(assign))\nprint('unique users:', assign['user_id'].nunique())\nprint('variant counts:', assign['variant'].value_counts())\n# detect users with multiple variants\nmulti = assign.groupby('user_id')['variant'].nunique()\nconflict = multi[multi>1]\nprint('users with >1 variant:', len(conflict))\nif not conflict.empty:\n    print(conflict.head())\nPY\n"]
