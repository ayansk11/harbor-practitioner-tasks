[64.978429, "i", "python - <<'PY'\nimport pandas as pd, numpy as np, math\nfrom scipy.stats import chisquare, norm\nfrom pathlib import Path\np=Path('data')\nread=lambda f: pd.read_csv(p/f, dtype=str)\na=read('assignments.csv.gz').drop_duplicates()\na['assigned_at']=pd.to_datetime(a.assigned_at,utc=True,format='ISO8601')\nb=read('bot_flags.csv.gz')\na=a[(a.method=='hash') & ~a.user_id.isin(b.loc[b.rule=='ua_crawler','user_id'])].copy()\npv=read('pageviews.csv.gz')\npv['ts']=pd.to_datetime(pv.ts,utc=True,format='ISO8601')\npv=pv.merge(a[['user_id','variant','assigned_at']],on='user_id',how='inner')\npv=pv[pv.ts>=pv.assigned_at].copy()\nmc=read('module_clicks.csv.gz')\nmc=mc[mc.target.str.startswith('item:')]\nvalid_pvs=set(pv.pageview_id)\nclicked_pvs=set(mc.pageview_id).intersection(valid_pvs)\npv['click']=pv.pageview_id.isin(clicked_pvs).astype('int64')\nprint('assignments kept',len(a),'by variant',a.variant.value_counts().to_dict())\nprint('bot users by rule',{r:b.loc[b.rule==r,'user_id'].nunique() for r in b.rule.unique()})\nprint('pre-filter p"]
[64.97855, "i", "ageviews',len(pv))\nres={}\nfor arm in ['A','B']:\n    x=pv[pv.variant==arm]\n    n=int(a.variant.eq(arm).sum())\n    views=int(len(x)); clicks=int(x['click'].sum())\n    r=clicks/views\n    c=x['click'].to_numpy(float); v=np.ones(len(x),float)\n    # Aggregate by user, then apply the documented ratio-delta formula.\n    agg=x.groupby('user_id')[['click']].sum().reindex(a.loc[a.variant==arm,'user_id'],fill_value=0)\n    cu=agg['click'].to_numpy(float); vu=x.groupby('user_id').size().reindex(agg.index).to_numpy(float)\n    var=len(cu)/(len(cu)-1)*np.sum((cu-r*vu)**2)/(vu.sum()**2)\n    res[arm]=(n,views,clicks,r,var)\n    print(arm,dict(n=n,views=views,clicks=clicks,ctr=r,se=math.sqrt(var)))\nd=res['B'][3]-res['A'][3]; se=math.sqrt(res['A'][4]+res['B'][4]); z=norm.ppf(.975)\nprint('diff',d,'ci',d-z*se,d+z*se)\nprint('srm',chisquare([res['A'][0],res['B'][0]]))\nPY\n"]
[64.978623, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
