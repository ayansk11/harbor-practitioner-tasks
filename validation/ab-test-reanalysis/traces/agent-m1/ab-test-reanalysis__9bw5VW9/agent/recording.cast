[9.38726, "o", "printf '\\n===== DATA FILES =====\\n'; ls -lh data; for f in data/*.csv.gz; do echo \"--- $f\"; gzip -cd \"$f\" | head -n 6; done\r\n\u001b[?2004l\r"]
