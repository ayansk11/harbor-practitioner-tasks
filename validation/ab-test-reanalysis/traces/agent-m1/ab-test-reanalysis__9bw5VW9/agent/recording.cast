[39.73958, "i", "python - <<'PY'\nimport pandas as pd\nfrom pathlib import Path\np=Path('data')\na=pd.read_csv(p/'assignments.csv.gz')\nb=pd.read_csv(p/'bot_flags.csv.gz')\npv=pd.read_csv(p/'pageviews.csv.gz')\nmc=pd.read_csv(p/'module_clicks.csv.gz')\nprint('assignment rows',len(a),'unique users',a.user_id.nunique(),'methods',a.method.value_counts().to_dict(),'variants by method',a.groupby(['method','variant']).size().to_dict())\nprint('exact duplicate assignment rows',a.duplicated().sum())\nprint('bot rows',len(b),'rules',b.rule.value_counts().to_dict(),'users by rule',{r:b.loc[b.rule==r,'user_id'].nunique() for r in b.rule.unique()})\nprint('targets',mc.target.str.split(':',n=1).str[0].value_counts().to_dict())\nprint('pv rows',len(pv),'unique pv',pv.pageview_id.nunique(),'users',pv.user_id.nunique())\nprint('mc pv ids',mc.pageview_id.nunique(),'user mismatches',(mc.merge(pv[['pageview_id','user_id']],on='pageview_id',suffixes=('','_pv')).user_id != mc.merge(pv[['pageview_id','user_id']],on='pageview_id',suffixes=('','_pv')).user_id_pv"]
[39.739712, "i", ").sum())\nPY\n"]
