[38.355623, "i", "echo '===== load.py ====='; cat abtest/load.py\n"]
[38.355803, "o", "echo '===== load.py ====='; cat abtest/load.py\r\n\u001b[?2004l\r"]
[38.355851, "o", "===== load.py =====\r\n"]
[38.356946, "o", "\"\"\"Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder.\"\"\"\r\nfrom pathlib import Path\r\n\r\nimport pandas as pd\r\n\r\n\r\ndef _read(data_dir, name, dtype=str):\r\n    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=dtype)\r\n\r\n\r\ndef _instants(col):\r\n    # The export mixes \"Z\" and \"+hh:mm\" / \"-hh:mm\" offsets. Parse to UTC: compare instants, never strings.\r\n    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n\r\n\r\ndef load_assignments(data_dir):\r\n    \"\"\"One row per assigned user: user_id, variant (\"A\" or \"B\"), assigned_at (UTC), method.\"\"\"\r\n    df = _read(data_dir, \"assignments\")\r\n    df = df.drop_duplicates()  # the assignment logger retries; an exact repeat of a row counts once\r\n    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\r\n    return df.reset_index(drop=True)\r\n\r\n\r\ndef load_bot_flags(data_dir):\r\n    \"\"\"One row per flag of the platform's bot screening: user_id, rule, flagged_at (UTC).\"\"\"\r\n    df = _read(data_dir, \"bot_flags\")\r\n    df[\"flagged_at\""]
[38.356996, "o", "] = _instants(df[\"flagged_at\"])\r\n    return df\r\n\r\n\r\ndef load_pageviews(data_dir, assignments):\r\n    \"\"\"Pageviews of the given assigned users, on or after the user's assignment time, with the variant attached.\"\"\"\r\n    pv = _read(data_dir, \"pageviews\", dtype={\"pageview_id\": str, \"user_id\": str, \"ts\": str, \"clicked\": \"int64\"})\r\n    pv[\"ts\"] = _instants(pv[\"ts\"])\r\n    pv = pv.merge(assignments[[\"user_id\", \"variant\", \"assigned_at\"]], on=\"user_id\", how=\"inner\")\r\n    pv = pv[pv[\"ts\"] >= pv[\"assigned_at\"]]  # exposure before assignment is not part of the experiment\r\n    return pv.reset_index(drop=True)\r\n\r\n\r\ndef load_module_clicks(data_dir):\r\n    \"\"\"Events of the related-items module: pageview_id, user_id, ts (UTC), target.\"\"\"\r\n    df = _read(data_dir, \"module_clicks\")\r\n    df[\"ts\"] = _instants(df[\"ts\"])\r\n    return df\r\n"]
[38.357082, "o", "\u001b[?2004hroot@5888fae4-a446-4c9f-a3ce-6022c28c8fd7:/app# "]
[38.920388, "i", "echo '===== filters.py ====='; cat abtest/filters.py\n"]
[38.920859, "o", "echo '===== filters.py ====='; cat abtest/filters.py\r\n\u001b[?2004l\r"]
[38.92094, "o", "===== filters.py =====\r\n"]
[38.922549, "o", "\"\"\"Population filters for the readout.\"\"\"\r\n\r\n\r\ndef exclude_bots(assignments, bot_flags):\r\n    \"\"\"Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).\r\n\r\n    Bot traffic is every user the platform's bot screening flagged (bot_flags.csv.gz): crawlers (rule ua_crawler)\r\n    and, since SEC-219, click-fraud bots on the related-items module (rule velocity).\r\n    \"\"\"\r\n    flagged = set(bot_flags[\"user_id\"])\r\n    return assignments[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\r\n"]
[38.922867, "o", "\u001b[?2004h"]
[38.922915, "o", "root@5888fae4-a446-4c9f-a3ce-6022c28c8fd7:/app# "]
[39.328589, "i", "echo '===== report.py ====='; cat abtest/report.py\n"]
[39.328971, "o", "echo '===== report.py ====='; cat abtest/report.py\r\n\u001b[?2004l\r"]
[39.32903, "o", "===== report.py =====\r\n"]
[39.330147, "o", "\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\nimport argparse\r\nimport json\r\nfrom pathlib import Path\r\n\r\nfrom .filters import exclude_bots\r\nfrom .load import load_assignments, load_bot_flags, load_pageviews\r\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n\r\nARMS = (\"A\", \"B\")\r\n\r\n\r\ndef per_user_counts(assignments, pageviews):\r\n    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\r\n\r\n    A pageview's click is its `clicked` flag (the module click flag of the export).\r\n    \"\"\"\r\n    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\r\n    return per_user.fillna({\"clicks\": 0, \"views\": 0})\r\n\r\n\r\ndef decide(srm_flag, ci_low):\r\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n    if srm_flag:\r\n        return \"invalid\"\r\n    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n\r\n\r\ndef build_readout(data_dir):\r\n    assignm"]
[39.330193, "o", "ents = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\r\n    pageviews = load_pageviews(data_dir, assignments)\r\n    per_user = per_user_counts(assignments, pageviews)\r\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n\r\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n    srm_flag = bool(srm_p < SRM_ALPHA)\r\n    return {\r\n        \"experiment\": \"EXP-2291\",\r\n        \"n_users\": n_users,\r\n        \"pageviews\": views,\r\n        \"clicks\": clicks,\r\n        \"ctr\": ctr,\r\n        \"diff\": float(diff),\r\n        \"rel_lift\": float(diff / ctr[\"A\"]),\r\n        \"ci_95\": [float(ci_low), float(ci_high)],\r\n        \"ci_method\": CI_METHOD,\r\n        \"srm_p\": srm_p,\r\n        \"srm_flag\": s"]
[39.330239, "o", "rm_flag,\r\n        \"decision\": decide(srm_flag, ci_low),\r\n    }\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n    ap.add_argument(\"--data\", required=True,\r\n                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n    args = ap.parse_args(argv)\r\n    readout = build_readout(args.data)\r\n    out = Path(args.out)\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
