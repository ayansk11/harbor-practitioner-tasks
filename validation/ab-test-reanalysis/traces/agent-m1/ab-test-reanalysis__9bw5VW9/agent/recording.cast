[64.978713, "o", "> "]
[64.978891, "o", "import pandas as pd, numpy as np, math\r\n\u001b[?2004l\r"]
[64.978966, "o", "\u001b[?2004h> "]
[64.979129, "o", "from scipy.stats import chisquare, norm\r\n\u001b[?2004l\r"]
[64.9792, "o", "\u001b[?2004h"]
[64.979241, "o", "> "]
[64.9793, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.979354, "o", "> "]
[64.979415, "o", "p=Path('data')\r\n\u001b[?2004l\r"]
[64.979445, "o", "\u001b[?2004h> "]
[64.979658, "o", "read=lambda f: pd.read_csv(p/f, dtype=str)\r\n\u001b[?2004l\r"]
[64.979696, "o", "\u001b[?2004h"]
[64.979724, "o", "> "]
[64.979919, "o", "a=read('assignments.csv.gz').drop_duplicates()\r\n\u001b[?2004l\r"]
[64.979946, "o", "\u001b[?2004h"]
[64.979974, "o", "> "]
[64.980301, "o", "a['assigned_at']=pd.to_datetime(a.assigned_at,utc=True,format='ISO8601')\r\n\u001b[?2004l\r"]
[64.980341, "o", "\u001b[?2004h"]
[64.980363, "o", "> "]
[64.980596, "o", "b=read('bot_flags.csv.gz')\r\n\u001b[?2004l\r"]
[64.980654, "o", "\u001b[?2004h"]
[64.980683, "o", "> "]
[64.981109, "o", "a=a[(a.method=='hash') & ~a.user_id.isin(b.loc[b.rule=='ua_crawler','user_id'])].copy()\r\n\u001b[?2004l\r"]
[64.981138, "o", "\u001b[?2004h"]
[64.981165, "o", "> "]
[64.981284, "o", "pv=read('pageviews.csv.gz')\r\n\u001b[?2004l\r"]
[64.981321, "o", "\u001b[?2004h"]
[64.981349, "o", "> "]
[64.981599, "o", "pv['ts']=pd.to_datetime(pv.ts,utc=True,format='ISO8601')\r\n\u001b[?2004l\r"]
[64.981626, "o", "\u001b[?2004h"]
[64.981661, "o", "> "]
[64.982004, "o", "pv=pv.merge(a[['user_id','variant','assigned_at']],on='user_id',how='inner')\r\n\u001b[?2004l\r"]
[64.98203, "o", "\u001b[?2004h"]
[64.982061, "o", "> "]
[64.982212, "o", "pv=pv[pv.ts>=pv.assigned_at].copy()\r\n\u001b[?2004l\r"]
[64.982248, "o", "\u001b[?2004h> "]
[64.982416, "o", "mc=read('module_clicks.csv.gz')\r\n\u001b[?2004l\r"]
[64.98246, "o", "\u001b[?2004h> "]
[64.982662, "o", "mc=mc[mc.target.str.startswith('item:')]\r\n\u001b[?2004l\r"]
[64.982693, "o", "\u001b[?2004h"]
[64.982715, "o", "> "]
[64.982845, "o", "valid_pvs=set(pv.pageview_id)\r\n\u001b[?2004l\r"]
[64.98288, "o", "\u001b[?2004h> "]
[64.983162, "o", "clicked_pvs=set(mc.pageview_id).intersection(valid_pvs)\r\n\u001b[?2004l\r"]
[64.983196, "o", "\u001b[?2004h> "]
[64.98349, "o", "pv['click']=pv.pageview_id.isin(clicked_pvs).astype('int64')\r\n\u001b[?2004l\r"]
[64.983522, "o", "\u001b[?2004h"]
[64.983553, "o", "> "]
[64.983918, "o", "print('assignments kept',len(a),'by variant',a.variant.value_counts().to_dict())\r\n\u001b[?2004l\r"]
[64.983949, "o", "\u001b[?2004h"]
[64.983977, "o", "> "]
[64.984401, "o", "print('bot users by rule',{r:b.loc[b.rule==r,'user_id'].nunique() for r in b.rule.unique()})\r\n\u001b[?2004l\r"]
[64.984455, "o", "\u001b[?2004h> "]
[64.98462, "o", "print('pre-filter pageviews',len(pv))\r\n\u001b[?2004l\r"]
[64.984687, "o", "\u001b[?2004h> "]
[64.984694, "o", "res={}\r\n\u001b[?2004l\r"]
[64.98474, "o", "\u001b[?2004h> "]
[64.984853, "o", "for arm in ['A','B']:\r\n\u001b[?2004l\r"]
[64.984871, "o", "\u001b[?2004h"]
[64.984941, "o", "> "]
[64.985014, "o", "    x=pv[pv.variant==arm]\r\n\u001b[?2004l\r"]
[64.985048, "o", "\u001b[?2004h"]
[64.985055, "o", "> "]
[64.98522, "o", "    n=int(a.variant.eq(arm).sum())\r\n\u001b[?2004l\r"]
[64.985251, "o", "\u001b[?2004h"]
[64.985279, "o", "> "]
[64.98551, "o", "    views=int(len(x)); clicks=int(x['click'].sum())\r\n\u001b[?2004l\r"]
[64.985545, "o", "\u001b[?2004h"]
[64.985573, "o", "> "]
[64.985637, "o", "    r=clicks/views\r\n\u001b[?2004l\r"]
[64.985708, "o", "\u001b[?2004h> "]
[64.985955, "o", "    c=x['click'].to_numpy(float); v=np.ones(len(x),float)\r\n\u001b[?2004l\r"]
[64.985988, "o", "\u001b[?2004h"]
[64.986017, "o", "> "]
[64.986341, "o", "    # Aggregate by user, then apply the documented ratio-delta formula.\r\n\u001b[?2004l\r"]
[64.986372, "o", "\u001b[?2004h"]
[64.9864, "o", "> "]
[64.986851, "o", "    agg=x.groupby('user_id')[['click']].sum().reindex(a.loc[a.variant==arm,'user_id'],fill_value=0)\r\n\u001b[?2004l\r"]
[64.986877, "o", "\u001b[?2004h"]
[64.986904, "o", "> "]
[64.987375, "o", "    cu=agg['click'].to_numpy(float); vu=x.groupby('user_id').size().reindex(agg.index).to_numpy(float)\r\n\u001b[?2004l\r"]
[64.987404, "o", "\u001b[?2004h"]
[64.987412, "o", "> "]
[64.987711, "o", "    var=len(cu)/(len(cu)-1)*np.sum((cu-r*vu)**2)/(vu.sum()**2)\r\n\u001b[?2004l\r"]
[64.987738, "o", "\u001b[?2004h"]
[64.987765, "o", "> "]
[64.98792, "o", "    res[arm]=(n,views,clicks,r,var)\r\n\u001b[?2004l\r"]
[64.987949, "o", "\u001b[?2004h"]
[64.987958, "o", "> "]
[64.988321, "o", "    print(arm,dict(n=n,views=views,clicks=clicks,ctr=r,se=math.sqrt(var)))\r\n\u001b[?2004l\r"]
[64.988351, "o", "\u001b[?2004h"]
[64.988378, "o", "> "]
[64.988749, "o", "d=res['B'][3]-res['A'][3]; se=math.sqrt(res['A'][4]+res['B'][4]); z=norm.ppf(.975)\r\n\u001b[?2004l\r"]
[64.988777, "o", "\u001b[?2004h"]
[64.988804, "o", "> "]
[64.988961, "o", "print('diff',d,'ci',d-z*se,d+z*se)\r\n\u001b[?2004l\r"]
[64.988993, "o", "\u001b[?2004h"]
[64.989, "o", "> "]
[64.989248, "o", "print('srm',chisquare([res['A'][0],res['B'][0]]))\r\n\u001b[?2004l\r"]
[64.989275, "o", "\u001b[?2004h"]
[64.989302, "o", "> "]
