[103.962162, "i", "python - <<'PY'\nimport pandas as pd, numpy as np, math\nfrom scipy.stats import norm\nfrom pathlib import Path\np=Path('data')\na=pd.read_csv(p/'assignments.csv.gz',dtype=str).drop_duplicates()\na['at']=pd.to_datetime(a.assigned_at,utc=True,format='ISO8601')\nb=pd.read_csv(p/'bot_flags.csv.gz',dtype=str)\na=a[(a.method=='hash') & ~a.user_id.isin(set(b.loc[b.rule=='ua_crawler','user_id']))].copy()\npv=pd.read_csv(p/'pageviews.csv.gz',dtype={'user_id':str})\npv['ts']=pd.to_datetime(pv.ts,utc=True,format='ISO8601')\npv=pv.merge(a[['user_id','variant','at']],on='user_id')\npv=pv[pv.ts>=pv.at]\nmc=pd.read_csv(p/'module_clicks.csv.gz',dtype=str)\nmc=mc[mc.target.str.startswith('item:')]\npv['click']=pv.pageview_id.isin(set(mc.pageview_id)).astype(float)\nprint('non-item targets',len(pd.read_csv(p/'module_clicks.csv.gz',dtype=str))-len(mc),'unmatched item click pageviews',len(set(mc.pageview_id)-set(pv.pageview_id)))\nfor arm in ['A','B']:\n    x=pv[pv.variant==arm]\n    u=x.groupby('user_id').agg(c=('click','sum'),v=('click','size')"]
[103.96227, "i", ")\n    # include zero-pageview users\n    u=pd.concat([u,pd.DataFrame({'c':0.0,'v':0.0},index=a.loc[a.variant==arm,'user_id'].difference(u.index))])\n    c=u.c.to_numpy(float); v=u.v.to_numpy(float); r=c.sum()/v.sum()\n    var=len(c)/(len(c)-1)*np.square(c-r*v).sum()/v.sum()**2\n    print(arm,len(c),r,var,math.sqrt(var),u[['c','v']].sum().to_dict())\nPY\n"]
