[184.093851, "i", "cat > abtest/filters.py <<'PY'\n\"\"\"Population filters for the experiment readout.\"\"\"\n\n\n# `method=hash` is the assignment service's randomization. Overrides are hand-set\n# feature-flag accounts (for example dogfood/QA), so they are not experiment users.\nRANDOMIZED_METHOD = \"hash\"\n\n# Only client-based screening identifies bot *clients*. The velocity rule looks at\n# activity, so removing users it flagged would condition the population on behavior.\nCLIENT_BOT_RULES = frozenset({\"ua_crawler\"})\n\n\ndef exclude_nonrandomized(assignments):\n    \"\"\"Keep users whose variant was set by the randomization service (EXPERIMENT.md 3).\"\"\"\n    randomized = assignments[assignments[\"method\"] == RANDOMIZED_METHOD]\n    return randomized.reset_index(drop=True)\n\n\ndef exclude_bots(assignments, bot_flags):\n    \"\"\"Drop users flagged by client-based bot rules, whenever the flag was raised.\"\"\"\n    if bot_flags.empty:\n        flagged = set()\n    else:\n        client_rules = bot_flags[\"rule\"].isin(CLIENT_BOT_RULES)\n        flagged = set(bot_fl"]
[184.093986, "i", "ags.loc[client_rules, \"user_id\"])\n    return assignments[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\nPY\n\ncat > abtest/report.py <<'PY'\n\"\"\"Experiment CTR readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots, exclude_nonrandomized\nfrom .load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\n\nARMS = (\"A\", \"B\")\n\n\ndef per_user_counts(assignments, pageviews, module_clicks):\n    \"\"\"One row per counted user, with their counted pageviews and product-open pageviews.\n\n    A plan-defined click opens a related product (`item:<product_id>`); module clicks\n    on carousel controls or `link:all` do not open a related product page. Aggregating\n    distinct clicked pageview IDs also makes two product opens from one pageview one click.\n    \"\"\"\n    product_clicks = module_clicks[\n        module_clicks[\"target\"].str.start"]
[184.094037, "i", "swith(\"item:\", na=False)\n    ]\n    clicked_pageviews = set(product_clicks[\"pageview_id\"])\n\n    counted = pageviews[[\"pageview_id\", \"user_id\"]].copy()\n    counted[\"clicked\"] = counted[\"pageview_id\"].isin(clicked_pageviews).astype(\"int64\")\n    grouped = counted.groupby(\"user_id\").agg(\n        clicks=(\"clicked\", \"sum\"),\n        views=(\"clicked\", \"size\"),\n    )\n\n    per_user = assignments[[\"user_id\", \"variant\"]].join(grouped, on=\"user_id\")\n    per_user = per_user.fillna({\"clicks\": 0, \"views\": 0})\n    per_user[\"clicks\"] = per_user[\"clicks\"].astype(\"int64\")\n    per_user[\"views\"] = per_user[\"views\"].astype(\"int64\")\n    return per_user\n\n\ndef decide(srm_flag, ci_low):\n    \"\"\"Apply the decision rules in EXPERIMENT.md section 7, in order.\"\"\"\n    if srm_flag:\n        return \"invalid\"\n    return \"ship\" if ci_low > 0 else \"no_ship\"\n\n\ndef _notes(n_users, diff, ci_low, ci_high, srm_p):\n    return [\n        \"The readout follows the agreed plan: hand-set override accounts are not experiment users, \"\n        \"and only client-ba"]
[184.09408, "i", "sed `ua_crawler` bot flags are excluded (velocity is behavior-based).\",\n        \"Clicks are related-product opens (`item:<id>` module events), not all related-module events \"\n        \"or the dashboard's precomputed clicked flag; carousel navigation and `link:all` are not counted.\",\n        f\"With the plan's population, the user counts are A={n_users['A']} and B={n_users['B']} \"\n        f\"(SRM p={srm_p:.6g}), so the earlier apparent sample-ratio mismatch came from the analysis, \"\n        \"not the assignment.\",\n        f\"The corrected B-vs-A CTR difference is {diff:+.6g} with a 95% CI of \"\n        f\"[{ci_low:+.6g}, {ci_high:+.6g}]; its lower bound is not above zero, so the decision is no_ship.\",\n    ]\n\n\ndef build_readout(data_dir):\n    assignments = load_assignments(data_dir)\n    assignments = exclude_bots(exclude_nonrandomized(assignments), load_bot_flags(data_dir))\n    pageviews = load_pageviews(data_dir, assignments)\n    module_clicks = load_module_clicks(data_dir)\n    per_user = per_user_counts(assignments,"]
[184.094118, "i", " pageviews, module_clicks)\n\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\n\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\n    srm_flag = bool(srm_p < SRM_ALPHA)\n    decision = decide(srm_flag, ci_low)\n\n    return {\n        \"n_users\": n_users,\n        \"pageviews\": views,\n        \"clicks\": clicks,\n        \"ctr\": ctr,\n        \"diff\": float(diff),\n        \"rel_lift\": float(diff / ctr[\"A\"]),\n        \"ci_95\": [float(ci_low), float(ci_high)],\n        \"ci_method\": CI_METHOD,\n        \"srm_p\": float(srm_p),\n        \"srm_flag\": srm_flag,\n        \"decision\": decision,\n        \"notes\": _notes(n_users, float(diff), float(ci_low), float(ci_high), float(srm_p)),\n    }\n\n\ndef main(argv=None):\n    "]
[184.094167, "i", "ap = argparse.ArgumentParser(description=\"CTR readout for the experiment export layout\")\n    ap.add_argument(\n        \"--data\", required=True,\n        help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\",\n    )\n    ap.add_argument(\"--out\", required=True, help=\"path of the result JSON to write\")\n    args = ap.parse_args(argv)\n\n    readout = build_readout(args.data)\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\n    print(\n        f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\n        f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] \"\n        f\"srm_p={readout['srm_p']:.3g}\"\n    )\n\n\nif __name__ == \"__main__\":\n    main()\nPY\npython -m compileall -q abtest\npython -m abtest.report --data data --out output/result.json\n"]
