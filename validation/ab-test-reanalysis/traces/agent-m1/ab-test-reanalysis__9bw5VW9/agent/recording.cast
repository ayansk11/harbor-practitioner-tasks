[16.38902, "i", "for f in docs/DATA_DICTIONARY.md docs/TRACKING.md docs/BOT_SCREENING.md docs/LAUNCH_EXP-2291.md; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[16.39007, "o", "for f in docs/DATA_DICTIONARY.md docs/TRACKING.md docs/BOT_SCREENING.md docs/LAUNCH_EXP-2291.md; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[16.390174, "o", "===== docs/DATA_DICTIONARY.md =====\r\n"]
[16.392147, "o", "     1\t# Experiment export: data dictionary\r\n     2\t\r\n     3\tData platform documentation. It applies to every experiment export of this layout.\r\n"]
[16.392161, "o", "     4\t\r\n"]
[16.392198, "o", "     5\tAn export is one folder with four gzip-compressed CSV files (UTF-8, comma-separated, one header row). It holds:\r\n     6\t- every assignment row the assignment service logged for the experiment;\r\n"]
[16.392248, "o", "     7\t- every flag the platform's bot screening raised on the experiment's assigned users, up to the time of the export;\r\n     8\t- each assigned user's product pageviews, from about three days before the user's `assigned_at` to the end of the\r\n     9\t  experiment (so pageviews before a user's assignment are included);\r\n    10\t- every module event logged on those pageviews, whatever its time (an event can come after the end of the\r\n    11\t  experiment when its pageview came just before it).\r\n    12\t\r\n    13\tTimestamps are ISO 8601, to the second, with a `Z` or a `+hh:mm` / `-hh:mm` offset. The offset varies from row to\r\n    14\trow, so the same instant can be written in different ways; compare instants, not text.\r\n    15\t\r\n    16\t## assignments.csv.gz\r\n    17\tOne row per assignment, as the assignment service logged it. The logger retries, so a row can appear more than once,\r\n    18\t"]
[16.392255, "o", "exactly repeated. A user never has two different rows.\r\n"]
[16.392301, "o", "    19\t\r\n    20\t| Column | Meaning |\r\n    21\t|---|---|\r\n    22\t| `user_id` | the user (text) |\r\n    23\t| `variant` | `A` or `B` |\r\n    24\t| `assigned_at` | when the user got the variant |\r\n    25\t| `method` | how the variant was set: `hash` = the variant from the hash (the randomization); `override` = set by hand in the feature-flag console's allowlist (dogfood and QA accounts), without the hash |\r\n"]
[16.392335, "o", "    26\t\r\n    27\t"]
[16.392342, "o", "## bot_flags.csv.gz\r\n    28\tOne row per flag raised by the platform's bot screening (`docs/BOT_SCREENING.md`). A user can have rows of both rules,\r\n    29\tand more than one row of the same rule.\r\n"]
[16.392375, "o", "    30\t\r\n    31\t| Column | Meaning |\r\n    32\t|---|---|\r\n    33\t| `user_id` | the flagged user |\r\n    34\t| `rule` | the screening rule that raised the flag: `ua_crawler` or `velocity` |"]
[16.392381, "o", "\r\n"]
[16.392424, "o", "    35\t| `flagged_at` | when the flag was raised (for each rule: `docs/BOT_SCREENING.md`) |\r\n    36\t\r\n    37\t## pageviews.csv.gz"]
[16.392458, "o", "\r\n    38\tOne row per product pageview, logged when the page has loaded. The assignment service assigns a user when the page\r\n    39\tis requested, so the pageview on which a user was assigned has no row if the user left before the page loaded: an\r\n    40\t"]
[16.39249, "o", "assigned user need not have a pageview at `assigned_at`, and can have no pageview row at all.\r\n    41\t\r\n    42\t| Column | Meaning |\r\n    43\t|---|---|\r\n    44\t| `pageview_id` | the pageview (text); unique per row |\r\n"]
[16.392499, "o", "    45\t| `user_id` | the user |\r\n    46\t| `ts` | when the page loaded |\r\n    47\t| `clicked` | 1 if at least one module_click event was logged on this pageview, else 0 (precomputed for dashboards) |\r\n    48\t\r\n"]
[16.392551, "o", "    49\t## module_clicks.csv.gz\r\n    50\tOne row per module_click event of the related-items module (`docs/TRACKING.md`). Times are to the second, so two\r\n    51\tclicks on the same element in the same second give two identical rows; each row is one event.\r\n    52\t\r\n    53\t| Column | Meaning |\r\n    54\t|---|---|\r\n"]
[16.392559, "o", "    55\t| `pageview_id` | the pageview the event was logged on (`pageviews.csv.gz`); the event belongs to that pageview's user |\r\n    56\t| `user_id` | the user |\r\n"]
[16.392598, "o", "    57\t| `ts` | when the click happened; at or after the pageview's `ts` |\r\n    58\t| `target` | the `data-target` value of the clicked element (`docs/TRACKING.md`) |\r\n"]
[16.392959, "o", "===== docs/TRACKING.md =====\r\n"]
[16.394501, "o", "     1\t# Tracking: the related-items module\r\n     2\t\r\n     3\tData platform documentation. It applies to every experiment export of this layout.\r\n"]
[16.394509, "o", "     4\t\r\n     5\t## module_click events\r\n     6\tThe related-items module on product pages logs one `module_click` event per click on any clickable element inside the\r\n"]
[16.394536, "o", "     7\tmodule. Each event records the pageview it happened on, the user, the time of the click and the clicked element's\r\n     8\t`data-target` value. Exports hold these events in `module_clicks.csv.gz`, and `pageviews.clicked` is derived from\r\n     9\tthem (`docs/DATA_DICTIONARY.md`).\r\n    10\t\r\n    11\t| `data-target` | Element | What a click on it does |\r\n    12\t|---|---|---|\r\n"]
[16.394571, "o", "    13\t| `item:<product_id>` | a product card | opens that product's page |\r\n    14\t| `nav:prev`, `nav:next` | the previous and next arrows of the v2 carousel | scroll the carousel; open nothing |\r\n    15\t| `link:all` | the \"See all\" link, in every module version from 2026-09-08 | opens the list page of all related items |\r\n    16\t\r\n    17\t## Module versions\r\n    18\t| Version | What the module shows |\r\n    19\t|---|---|\r\n    20"]
[16.39458, "o", "\t| v1 | the current module: a row of six product cards |\r\n    21\t| v2 | related items v2 (RI-311): a carousel of 12 product cards with previous and next arrows |\r\n    22\t\r\n"]
[16.394614, "o", "    23\tOther experiments test other layouts or rankings of the cards; v2 is the only version with arrows. Since 2026-09-08\r\n    24\tevery version also shows the \"See all\" link.\r\n    25\t\r\n    26\tThe module version is set per experiment arm: from a user's assignment on, every product pageview of the user shows\r\n    27\tthe version of the user's arm, as the experiment's launch record sets it (EXP-2291: v1 in A, v2 in B). Before the\r\n    28\tassignment, every user sees v1.\r\n    29\t\r\n    30\t## Changelog\r\n"]
[16.394644, "o", "    31\t- 2025-04-14: `module_click` events logged for every clickable element of the module.\r\n    32\t- 2026-09-01: v2 available to experiments, per arm (EXP-2291 shows it in arm B).\r\n    33\t- 2026-09-08: \"See all\" link (`link:all`) added to every module version (RI-318).\r\n"]
[16.394914, "o", "===== docs/BOT_SCREENING.md =====\r\n"]
[16.396459, "o", "     1\t# Bot screening\r\n     2\t\r\n     3\tData platform documentation. It applies to every experiment export of this layout.\r\n     4\t\r\n     5\tThe platform screens traffic for bots with two rules. Every flag is one row of `bot_flags.csv.gz` (`user_id`, `rule`,\r\n     6\t`flagged_at`). A user can be flagged by both rules.\r\n     7\t\r\n     8\t| Rule | In use since | What it looks at | When it runs | `flagged_at` |\r\n     9\t|---|---|---|---|---|\r\n    10\t| `ua_crawler` | 2024-03 | the client: a crawler user agent, or an IP address in a data-centre range | on the client's first request to the platform (any page; it need not be a product pageview of the export) | the time of that first request; one row per flagged user |\r\n    11\t| `velocity` | 2026-08-28 (SEC-219) | the user's `module_click` events (`docs/TRACKING.md`): 8 or more events, of any target, within 60 seconds | nightly at 02:00 UTC, over the module_click events of the previous UTC day | the time of the run (02:00:00 UTC); one row per user and day on which the rul"]
[16.396467, "o", "e fired |\r\n    12\t\r\n    13\t`velocity` was added against click fraud on the related-items module (scripts that click product cards in bursts).\r\n"]
[16.396509, "o", "    14\tIts threshold was set on July 2026 related-items traffic, in which no human reached it.\r\n"]
[16.396749, "o", "===== docs/LAUNCH_EXP-2291.md =====\r\n"]
[16.398159, "o", "     1\t# Launch record: EXP-2291 \"related items v2\"\r\n     2\t\r\n     3\t| Field | Value |\r\n     4\t|---|---|\r\n     5\t| Experiment | EXP-2291, related items v2 (RI-311) |\r\n     6\t| Owner | product pages team |\r\n     7\t| Unit | user |\r\n     8\t| Allocation | 50/50, by the assignment service's hash of the salt and the user id |\r\n     9\t| Salt | `exp-2291-related-items-v2` |\r\n    10\t| Arms | A: module v1 (control); B: module v2, the carousel (`docs/TRACKING.md`) |\r\n    11\t| Assignment | at the user's first eligible product pageview (`EXPERIMENT.md` section 2) |\r\n    12\t| Start | 2026-09-01 00:00Z |\r\n    13\t| End | 2026-09-15 00:00Z |\r\n    14\t| Analysis plan | `EXPERIMENT.md`, agreed 2026-08-25 |\r\n    15\t| Export | taken 2026-09-15 06:00Z, after the nightly bot screening run of 02:00Z |\r\n    16\t\r\n"]
[16.398195, "o", "    17\t## Log\r\n    18\t- 2026-08-25: analysis plan agreed.\r\n    19\t- 2026-09-01 00:00Z: started; the assignment service randomizes users 50/50.\r\n    20\t- 2026-09-03: dogfood: the 100 accounts of the product pages team added to the allowlist of variant B in the\r\n    21\t  feature-flag console (RI-322), so that the team can use v2 on the live site.\r\n    22\t"]
[16.398224, "o", "- 2026-09-15 00:00Z: ended; export taken at 06:00Z.\r\n"]
[16.398631, "o", "\u001b[?2004hroot@5888fae4-a446-4c9f-a3ce-6022c28c8fd7:/app# "]
[16.780628, "i", "for f in abtest/__init__.py abtest/load.py abtest/filters.py abtest/report.py abtest/stats.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[16.781722, "o", "for f in abtest/__init__.py abtest/load.py abtest/filters.py abtest/report.py abtest/stats.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[16.781808, "o", "===== abtest/__init__.py =====\r\n"]
[16.783714, "o", "     1\t\"\"\"EXP-2291 readout pipeline: load the experiment export, apply the population rules, compute the CTR readout.\"\"\"\r\n"]
[16.784076, "o", "===== abtest/load.py =====\r\n"]
[16.785615, "o", "     1\t\"\"\"Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder.\"\"\"\r\n     2\tfrom pathlib import Path\r\n     3\t\r\n     4\timport pandas as pd\r\n     5\t\r\n     6\t\r\n     7\tdef _read(data_dir, name, dtype=str):\r\n     8\t    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=dtype)\r\n     9\t\r\n    10\t\r\n    11\tdef _instants(col):\r\n    12\t    # The export mixes \"Z\" and \"+hh:mm\" / \"-hh:mm\" offsets. Parse to UTC: compare instants, never strings.\r\n    13\t    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n    14\t\r\n    15\t\r\n    16\tdef load_assignments(data_dir):\r\n    17\t    \"\"\"One row per assigned user: user_id, variant (\"A\" or \"B\"), assigned_at (UTC), method.\"\"\"\r\n"]
[16.785673, "o", "    18\t    df = _read(data_dir, \"assignments\")\r\n    19\t    df = df.drop_duplicates()  # the assignment logger retries; an exact repeat of a row counts once\r\n    20\t    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\r\n    21\t    return df.reset_index(drop=True)\r\n    22\t\r\n    23\t\r\n    24\tdef load_bot_flags(data_dir):\r\n    25\t    \"\"\"One row per flag of the platform's bot screening: user_id, rule, flagged_at (UTC).\"\"\"\r\n    26"]
[16.785739, "o", "\t    df = _read(data_dir, \"bot_flags\")\r\n    27\t    df[\"flagged_at\"] = _instants(df[\"flagged_at\"])\r\n    28\t    return df\r\n    29\t\r\n    30\t\r\n    31\tdef load_pageviews(data_dir, assignments):\r\n    32\t    \"\"\"Pageviews of the given assigned users, on or after the user's assignment time, with the variant attached.\"\"\"\r\n    33\t    pv = _read(data_dir, \"pageviews\", dtype={\"pageview_id\": str, \"user_id\": str, \"ts\": str, \"clicked\": \"int64\"})\r\n    34\t    pv[\"ts\"] = _instants(pv[\"ts\"])\r\n    35\t    pv = pv.merge(assignments[[\"user_id\", \"variant\", \"assigned_at\"]], on=\"user_id\", how=\"inner\")\r\n    36\t"]
[16.785778, "o", "    pv = pv[pv[\"ts\"] >= pv[\"assigned_at\"]]  # exposure before assignment is not part of the experiment\r\n    37\t    return pv.reset_index(drop=True)\r\n    38\t\r\n    39\t\r\n    40\tdef load_module_clicks(data_dir):\r\n    41\t    \"\"\"Events of the related-items module: pageview_id, user_id, ts (UTC), target.\"\"\"\r\n    42\t    df = _read(data_dir, \"module_clicks\")\r\n    43\t    df[\"ts\"] = _instants(df[\"ts\"])\r\n    44\t    return df\r\n"]
[16.786022, "o", "===== abtest/filters.py =====\r\n"]
[16.78782, "o", "     1\t\"\"\"Population filters for the readout.\"\"\"\r\n     2\t\r\n     3\t\r\n     4\tdef exclude_bots(assignments, bot_flags):\r\n"]
[16.787868, "o", "     5\t    \"\"\"Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).\r\n     6\t\r\n     7\t    Bot traffic is every user the platform's bot screening flagged (bot_flags.csv.gz): crawlers (rule ua_crawler)\r\n     8\t    and, since SEC-219, click-fraud bots on the related-items module (rule velocity).\r\n     9\t    \"\"\"\r\n"]
[16.787905, "o", "    10\t    flagged = set(bot_flags[\"user_id\"])\r\n    11\t    return assignments[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\r\n"]
[16.788174, "o", "===== abtest/report.py =====\r\n"]
[16.789635, "o", "     1\t\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\n     2\timport argparse\r\n     3\timport json\r\n     4\tfrom pathlib import Path\r\n     5\t\r\n     6\tfrom .filters import exclude_bots\r\n     7\tfrom .load import load_assignments, load_bot_flags, load_pageviews\r\n     8\tfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n     9\t\r\n    10\tARMS = (\"A\", \"B\")\r\n    11\t\r\n    12\t\r\n    13\tdef per_user_counts(assignments, pageviews):\r\n    14\t    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\r\n    15\t\r\n    16\t    A pageview's click is its `clicked` flag (the module click flag of the export).\r\n"]
[16.789675, "o", "    17\t    \"\"\"\r\n    18\t    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n    19\t    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\r\n    20\t    return per_user.fillna({\"clicks\": 0, \"views\": 0})\r\n    21\t\r\n"]
[16.789709, "o", "    22\t\r\n    23\tdef decide(srm_flag, ci_low):\r\n    24\t    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n    25\t    if srm_flag:\r\n    26\t        return \"invalid\"\r\n    27\t    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n    28\t\r\n    29\t\r\n"]
[16.789777, "o", "    30\tdef build_readout(data_dir):\r\n    31\t    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\r\n    32\t    pageviews = load_pageviews(data_dir, assignments)\r\n    33\t    per_user = per_user_counts(assignments, pageviews)\r\n    34\t    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n    35\t\r\n    36\t    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n    37\t    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n    38\t    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n    39\t    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n    40\t    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n    41\t    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n    42\t    srm_flag = bool(srm_p < SRM_ALPHA)\r\n    43\t    return {\r\n    44\t        \"experiment\": \"EXP-2291\",\r\n    45\t        \"n_users\": n_users,\r\n    46\t        \"pageviews\": views,\r\n    47\t        \"clicks\": clicks,\r\n"]
[16.789825, "o", "    48\t        \"ctr\": ctr,\r\n    49\t        \"diff\": float(diff),\r\n    50\t        \"rel_lift\": float(diff / ctr[\"A\"]),\r\n    51\t        \"ci_95\": [float(ci_low), float(ci_high)],\r\n    52\t        \"ci_method\": CI_METHOD,\r\n    53\t        \"srm_p\": srm_p,\r\n"]
[16.789851, "o", "    54\t        \"srm_flag\": srm_flag,\r\n    55\t        \"decision\": decide(srm_flag, ci_low),\r\n    56\t    }\r\n    57\t\r\n    58\t\r\n    59\tdef main(argv=None):\r\n    60\t    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n    61\t    ap.add_argument(\"--data\", required=True,\r\n    62\t                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n    63\t    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n    64\t    args = ap.parse_args(argv)\r\n"]
[16.789868, "o", "    65\t    readout = build_readout(args.data)\r\n    66\t    out = Path(args.out)\r\n    67\t    out.parent.mkdir(parents=True, exist_ok=True)\r\n    68\t    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n    69\t    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n"]
[16.790022, "o", "    70\t          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n    71\t\r\n    72\t\r\n    73\tif __name__ == \"__main__\":\r\n    74\t    main()\r\n"]
[16.790171, "o", "===== abtest/stats.py =====\r\n"]
[16.791638, "o", "     1\t\"\"\"Statistics for the CTR readout (EXPERIMENT.md sections 5 and 6). The unit of randomization is the user.\"\"\"\r\n     2\timport math\r\n     3\t\r\n     4\timport numpy as np\r\n     5\t"]
[16.791687, "o", "from scipy.stats import chisquare, norm\r\n     6\t\r\n     7\tZ = float(norm.ppf(0.975))\r\n     8\tSRM_ALPHA = 0.001\r\n"]
[16.791734, "o", "     9\tCI_METHOD = \"delta method, users as the unit\"\r\n    10\t\r\n    11\t\r\n    12\tdef ratio_delta(clicks, views):\r\n    13\t    \"\"\"CTR = sum(clicks) / sum(views) over users, and its delta-method variance.\r\n    14\t\r\n    15\t    clicks, views: one entry per counted user, users with zero pageviews included. Var = N/(N-1) * sum((c - r v)^2) /\r\n    16\t    (sum v)^2, the usual linearisation of a ratio of two user-level means.\r\n    17\t    \"\"\"\r\n    18\t    c = np.asarray(clicks, dtype=float)\r\n    19\t    v = np.asarray(views, dtype=float)\r\n    20\t    n = len(c)\r\n    21\t    r = c.sum() / v.sum()\r\n    22\t    var = n / (n - 1) * float(np.sum((c - r * v) ** 2)) / float(v.sum()) ** 2\r\n"]
[16.79179, "o", "    23\t    return float(r), var\r\n    24\t\r\n    25\t\r\n    26\tdef diff_ci(arm_a, arm_b):\r\n    27\t    \"\"\"CTR_B - CTR_A and its 95% CI; arm_a, arm_b: per-user frames with columns clicks, views.\"\"\"\r\n    28\t    ra, va = ratio_delta(arm_a[\"clicks\"], arm_a[\"views\"])\r\n    29\t    rb, vb = ratio_delta(arm_b[\"clicks\"], arm_b[\"views\"])\r\n    30\t    diff = rb - ra\r\n    31\t    se = math.sqrt(va + vb)\r\n    32\t    return diff, (diff - Z * se, diff + Z * se)\r\n    33\t\r\n    34\t\r\n    35\tdef srm_pvalue(n_a, n_b):\r\n    36\t    \"\"\"Pearson chi-square goodness of fit of the user counts against 50/50 (1 df, no continuity correction).\"\"\"\r\n"]
[16.79184, "o", "    37\t    return float(chisquare([n_a, n_b]).pvalue)\r\n"]
