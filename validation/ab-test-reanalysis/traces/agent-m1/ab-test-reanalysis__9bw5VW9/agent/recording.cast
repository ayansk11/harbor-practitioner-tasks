[184.12983, "o", "\u001b[?2004h"]
[184.129869, "o", "> "]
[184.13032, "o", "        f\"The corrected B-vs-A CTR difference is {diff:+.6g} with a 95% CI of \"\r\n\u001b[?2004l\r"]
[184.13036, "o", "\u001b[?2004h"]
[184.130398, "o", "> "]
[184.130997, "o", "        f\"[{ci_low:+.6g}, {ci_high:+.6g}]; its lower bound is not above zero, so the decision is no_ship.\",\r\n\u001b[?2004l\r"]
[184.131041, "o", "\u001b[?2004h"]
[184.131078, "o", "> "]
[184.131118, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.131157, "o", "> \r\n\u001b[?2004l\r"]
[184.131198, "o", "\u001b[?2004h> "]
[184.131244, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.131284, "o", "> "]
[184.131429, "o", "def build_readout(data_dir):\r\n\u001b[?2004l\r"]
[184.131466, "o", "\u001b[?2004h"]
[184.131512, "o", "> "]
[184.13175, "o", "    assignments = load_assignments(data_dir)\r\n\u001b[?2004l\r"]
[184.131791, "o", "\u001b[?2004h"]
[184.131831, "o", "> "]
[184.132384, "o", "    assignments = exclude_bots(exclude_nonrandomized(assignments), load_bot_flags(data_dir))\r\n\u001b[?2004l\r"]
[184.132425, "o", "\u001b[?2004h"]
[184.132465, "o", "> "]
[184.132748, "o", "    pageviews = load_pageviews(data_dir, assignments)\r\n\u001b[?2004l\r"]
[184.132786, "o", "\u001b[?2004h> "]
[184.133086, "o", "    module_clicks = load_module_clicks(data_dir)\r\n\u001b[?2004l\r"]
[184.133131, "o", "\u001b[?2004h> "]
[184.133675, "o", "    per_user = per_user_counts(assignments, pageviews, module_clicks)\r\n\u001b[?2004l\r"]
[184.133726, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.133768, "o", "\u001b[?2004h"]
[184.133806, "o", "> "]
[184.134198, "o", "    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n\u001b[?2004l\r"]
[184.134235, "o", "\u001b[?2004h> "]
[184.134598, "o", "    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n\u001b[?2004l\r"]
[184.134642, "o", "\u001b[?2004h> "]
[184.135036, "o", "    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[184.135078, "o", "\u001b[?2004h"]
[184.135116, "o", "> "]
[184.135489, "o", "    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[184.135532, "o", "\u001b[?2004h"]
[184.135571, "o", "> "]
[184.135879, "o", "    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n\u001b[?2004l\r"]
[184.13592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.135969, "o", "\u001b[?2004h> "]
[184.13634, "o", "    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n\u001b[?2004l\r"]
[184.136392, "o", "\u001b[?2004h> "]
[184.136697, "o", "    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n\u001b[?2004l\r"]
[184.136736, "o", "\u001b[?2004h> "]
[184.136977, "o", "    srm_flag = bool(srm_p < SRM_ALPHA)\r\n\u001b[?2004l\r"]
[184.137017, "o", "\u001b[?2004h> "]
[184.137262, "o", "    decision = decide(srm_flag, ci_low)\r\n\u001b[?2004l\r"]
[184.137302, "o", "\u001b[?2004h> "]
[184.13736, "o", "\r\n\u001b[?2004l\r"]
[184.137396, "o", "\u001b[?2004h> "]
[184.137462, "o", "    return {\r\n\u001b[?2004l\r"]
[184.137498, "o", "\u001b[?2004h> "]
[184.137677, "o", "        \"n_users\": n_users,\r\n\u001b[?2004l\r"]
[184.137714, "o", "\u001b[?2004h> "]
[184.137896, "o", "        \"pageviews\": views,\r\n\u001b[?2004l\r"]
[184.137936, "o", "\u001b[?2004h> "]
[184.138099, "o", "        \"clicks\": clicks,\r\n\u001b[?2004l\r"]
[184.138139, "o", "\u001b[?2004h> "]
[184.138279, "o", "        \"ctr\": ctr,\r\n\u001b[?2004l\r"]
[184.13833, "o", "\u001b[?2004h"]
[184.138372, "o", "> "]
[184.138544, "o", "        \"diff\": float(diff),\r\n\u001b[?2004l\r"]
[184.138584, "o", "\u001b[?2004h> "]
[184.138859, "o", "        \"rel_lift\": float(diff / ctr[\"A\"]),\r\n\u001b[?2004l\r"]
[184.138896, "o", "\u001b[?2004h"]
[184.138942, "o", "> "]
[184.139218, "o", "        \"ci_95\": [float(ci_low), float(ci_high)],\r\n\u001b[?2004l\r"]
[184.139267, "o", "\u001b[?2004h> "]
[184.139473, "o", "        \"ci_method\": CI_METHOD,\r\n\u001b[?2004l\r"]
[184.139511, "o", "\u001b[?2004h"]
[184.139552, "o", "> "]
[184.139703, "o", "        \"srm_p\": float(srm_p),\r\n\u001b[?2004l\r"]
[184.139729, "o", "\u001b[?2004h"]
[184.139844, "o", "> "]
[184.139934, "o", "        \"srm_flag\": srm_flag,\r\n\u001b[?2004l\r"]
[184.139985, "o", "\u001b[?2004h"]
[184.140028, "o", "> "]
[184.140165, "o", "        \"decision\": decision,\r\n\u001b[?2004l\r"]
[184.140218, "o", "\u001b[?2004h"]
[184.140258, "o", "> "]
[184.140767, "o", "        \"notes\": _notes(n_users, float(diff), float(ci_low), float(ci_high), float(srm_p)),\r\n\u001b[?2004l\r"]
[184.140809, "o", "\u001b[?2004h> "]
[184.140857, "o", "    }\r\n\u001b[?2004l\r"]
[184.140899, "o", "\u001b[?2004h"]
[184.140941, "o", "> \r\n\u001b[?2004l\r"]
[184.140979, "o", "\u001b[?2004h> "]
[184.141019, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.141159, "o", "def main(argv=None):\r\n\u001b[?2004l\r"]
[184.141195, "o", "\u001b[?2004h> "]
[184.141765, "o", "    ap = argparse.ArgumentParser(description=\"CTR readout for the experiment export layout\")\r\n\u001b[?2004l\r"]
[184.141816, "o", "\u001b[?2004h> "]
[184.14195, "o", "    ap.add_argument(\r\n\u001b[?2004l\r"]
[184.141987, "o", "\u001b[?2004h"]
[184.142027, "o", "> "]
[184.142207, "o", "        \"--data\", required=True,\r\n\u001b[?2004l\r"]
[184.142245, "o", "\u001b[?2004h"]
[184.142286, "o", "> "]
[184.142824, "o", "        help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\",\r\n\u001b[?2004l\r"]
[184.142863, "o", "\u001b[?2004h"]
[184.142901, "o", ">     )\r\n"]
[184.142942, "o", "\u001b[?2004l\r\u001b[?2004h"]
[184.142988, "o", "> "]
[184.143473, "o", "    ap.add_argument(\"--out\", required=True, help=\"path of the result JSON to write\")\r\n\u001b[?2004l\r"]
[184.143513, "o", "\u001b[?2004h> "]
[184.143717, "o", "    args = ap.parse_args(argv)\r\n\u001b[?2004l\r"]
[184.143759, "o", "\u001b[?2004h"]
[184.143799, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.143838, "o", "> "]
[184.144058, "o", "    readout = build_readout(args.data)\r\n\u001b[?2004l\r"]
[184.144099, "o", "\u001b[?2004h> "]
[184.144262, "o", "    out = Path(args.out)\r\n\u001b[?2004l\r"]
[184.144314, "o", "\u001b[?2004h"]
[184.144359, "o", "> "]
[184.144635, "o", "    out.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[184.144673, "o", "\u001b[?2004h"]
[184.144714, "o", "> "]
[184.14503, "o", "    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n\u001b[?2004l\r"]
[184.145075, "o", "\u001b[?2004h> "]
[184.14516, "o", "    print(\r\n\u001b[?2004l\r"]
[184.1452, "o", "\u001b[?2004h> "]
[184.145711, "o", "        f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n\u001b[?2004l\r"]
[184.145752, "o", "\u001b[?2004h"]
[184.145792, "o", "> "]
[184.146183, "o", "        f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] \"\r\n\u001b[?2004l\r"]
[184.146224, "o", "\u001b[?2004h> "]
[184.146481, "o", "        f\"srm_p={readout['srm_p']:.3g}\"\r\n\u001b[?2004l\r"]
[184.146521, "o", "\u001b[?2004h"]
[184.146567, "o", "> "]
[184.146602, "o", "    )\r\n\u001b[?2004l\r"]
[184.146641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.146682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.146721, "o", "\u001b[?2004h> "]
[184.1469, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[184.146938, "o", "\u001b[?2004h> "]
[184.147023, "o", "    main()\r\n\u001b[?2004l\r"]
[184.147063, "o", "\u001b[?2004h> "]
[184.147103, "o", "PY\r\n\u001b[?2004l\r"]
[184.149472, "o", "\u001b[?2004h"]
[184.149517, "o", "root@5888fae4-a446-4c9f-a3ce-6022c28c8fd7:/app# "]
[184.149692, "o", "python -m compileall -q abtest\r\n\u001b[?2004l\r"]
[184.179864, "o", "\u001b[?2004hroot@5888fae4-a446-4c9f-a3ce-6022c28c8fd7:/app# "]
[184.180291, "o", "python -m abtest.report --data data --out output/result.json\r\n\u001b[?2004l\r"]
[185.691825, "o", "wrote output/result.json: decision=no_ship diff=+0.00096 ci=[-0.00432, +0.00624] srm_p=0.469\r\n"]
[185.763175, "o", "\u001b[?2004hroot@5888fae4-a446-4c9f-a3ce-6022c28c8fd7:/app# "]
[247.283289, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('abtest/report.py')\ns = p.read_text()\ns = s.replace(\n    'def _notes(n_users, diff, ci_low, ci_high, srm_p):',\n    'def _notes(n_users, diff, ci_low, ci_high, srm_p, decision):',\n)\ns = s.replace(\n    'f\"With the plan\\'s population, the user counts are A={n_users[\\'A\\']} and B={n_users[\\'B\\']} \"\\n'\n    '        f\"(SRM p={srm_p:.6g}), so the earlier apparent sample-ratio mismatch came from the analysis, \"\\n'\n    '        \"not the assignment.\",',\n    'f\"With the plan\\'s population, the user counts are A={n_users[\\'A\\']} and B={n_users[\\'B\\']} \"\\n'\n    '        f\"(SRM p={srm_p:.6g}).\",',\n)\ns = s.replace(\n    'f\"[{ci_low:+.6g}, {ci_high:+.6g}]; its lower bound is not above zero, so the decision is no_ship.\",',\n    'f\"[{ci_low:+.6g}, {ci_high:+.6g}]; the plan\\'s decision rule gives {decision}.\",',\n)\ns = s.replace(\n    '_notes(n_users, float(diff), float(ci_low), float(ci_high), float(srm_p)),',\n    '_notes(n_users, float(diff), float(ci_low), float(ci_high), float(s"]
[247.283369, "i", "rm_p), decision),',\n)\np.write_text(s)\nPY\ncat > README.md <<'MD'\n# Experiment CTR readout\n\nReadout pipeline for experiment exports of the documented four-file layout. The agreed analysis plan is\n`EXPERIMENT.md`.\n\nRun from this top-level folder:\n\n    python -m abtest.report --data <export-folder> --out <result.json>\n\n| Path | What it is |\n|---|---|\n| `abtest/load.py` | reads exports, parses mixed-offset timestamps as UTC instants, deduplicates exact assignment rows, and keeps pageviews at or after assignment |\n| `abtest/filters.py` | keeps hash-randomized users and excludes users flagged by client-based bot rules |\n| `abtest/report.py` | derives product-open clicks from `module_clicks`, aggregates by user, and writes the JSON readout |\n| `abtest/stats.py` | user-level delta-method CTR interval and the planned SRM test |\n| `docs/` | authoritative data-platform documentation and the launch record |\n| `output/result.json` | last generated readout |\nMD\npython -m compileall -q abtest\npython -m abtest.report --data d"]
[247.28355, "i", "ata --out output/result.json\ncat output/result.json\n"]
