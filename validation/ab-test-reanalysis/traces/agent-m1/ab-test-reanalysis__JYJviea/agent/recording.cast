[116.217112, "o", "python -m abtest.report --data data --out output/result.json\r\n\u001b[?2004l\r"]
[117.717283, "o", "wrote output/result.json: decision=invalid diff=+0.00217 ci=[-0.00331, +0.00765] srm_p=2.37e-06\r\n"]
