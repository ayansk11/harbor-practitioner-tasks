[119.224549, "i", "cat output/result.json\n"]
[119.224683, "o", "cat output/result.json\r\n"]
[119.224712, "o", "\u001b[?2004l\r"]
[119.225749, "o", "{\r\n  \"experiment\": \"EXP-2291\",\r\n  \"n_users\": {\r\n    \"A\": 16570,\r\n    \"B\": 15722\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 165646,\r\n    \"B\": 158616\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 16837,\r\n    \"B\": 16466\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.10164447073880443,\r\n    \"B\": 0.1038104604831795\r\n  },\r\n  \"diff\": 0.0021659897443750686,\r\n  \"rel_lift\": 0.021309469453985427,\r\n  \"ci_95\": [\r\n    -0.0033131556717745413,\r\n    0.007645135160524679\r\n  ],\r\n  \"ci_method\": \"delta method, users as the unit\",\r\n  \"srm_p\": 2.370270355747152e-06,\r\n  \"srm_flag\": true,\r\n  \"decision\": \"invalid\"\r\n}\r\n"]
[119.225957, "o", "\u001b[?2004h"]
