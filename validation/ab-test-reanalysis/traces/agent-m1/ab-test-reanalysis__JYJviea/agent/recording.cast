[91.793455, "o", "\u001b[?2004l\r"]
[91.794698, "o", "{\r\n  \"experiment\": \"EXP-2291\",\r\n  \"n_users\": {\r\n    \"A\": 16570,\r\n    \"B\": 15722\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 165646,\r\n    \"B\": 158616\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 16837,\r\n    \"B\": 16466\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.10164447073880443,\r\n    \"B\": 0.1038104604831795\r\n  },\r\n  \"diff\": 0.0021659897443750686,\r\n  \"rel_lift\": 0.021309469453985427,\r\n  \"ci_95\": [\r\n    -0.0033131556717745413,\r\n    0.007645135160524679\r\n  ],\r\n  \"ci_method\": \"delta method, users as the unit\",\r\n  \"srm_p\": 2.370270355747152e-06,\r\n  \"srm_flag\": true,\r\n  \"decision\": \"invalid\"\r\n}\r\n"]
[91.794883, "o", "\u001b[?2004hroot@a90d859a-bc6c-4445-bef8-63451247f349:/app# "]
[100.6648, "i", "sed -n '1,200p' abtest/report.py\n"]
[100.664936, "o", "sed -n '1,200p' abtest/report.py\r\n\u001b[?2004l\r"]
[100.666649, "o", "\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\nimport argparse\r\nimport json\r\nfrom pathlib import Path\r\n\r\nfrom .filters import exclude_bots\r\nfrom .load import load_assignments, load_bot_flags, load_pageviews\r\n"]
[100.666693, "o", "from .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n\r\nARMS = (\"A\", \"B\")\r\n\r\n\r\ndef per_user_counts(assignments, pageviews):\r\n    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\r\n\r\n    A pageview's click is its `clicked` flag (the module click flag of the export).\r\n    \"\"\"\r\n"]
[100.666729, "o", "    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\r\n    return per_user.fillna({\"clicks\": 0, \"views\": 0})\r\n\r\n\r\ndef decide(srm_flag, ci_low):\r\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n    if srm_flag:\r\n        return \"invalid\"\r\n    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n\r\n\r\ndef build_readout(data_dir):\r\n    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\r\n    pageviews = load_pageviews(data_dir, assignments)\r\n    per_user = per_user_counts(assignments, pageviews)\r\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n\r\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n    "]
[100.666755, "o", "srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n    srm_flag = bool(srm_p < SRM_ALPHA)\r\n    return {\r\n        \"experiment\": \"EXP-2291\",\r\n        \"n_users\": n_users,\r\n        \"pageviews\": views,\r\n        \"clicks\": clicks,\r\n        \"ctr\": ctr,\r\n        \"diff\": float(diff),\r\n        \"rel_lift\": float(diff / ctr[\"A\"]),\r\n        \"ci_95\": [float(ci_low), float(ci_high)],\r\n        \"ci_method\": CI_METHOD,\r\n        \"srm_p\": srm_p,\r\n        \"srm_flag\": srm_flag,\r\n        \"decision\": decide(srm_flag, ci_low),\r\n    }\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n    ap.add_argument(\"--data\", required=True,\r\n"]
[100.666778, "o", "                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n    args = ap.parse_args(argv)\r\n    readout = build_readout(args.data)\r\n    out = Path(args.out)\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\r\n\r\n"]
[100.666798, "o", "if __name__ == \"__main__\":\r\n    main()\r\n"]
[100.667024, "o", "\u001b[?2004h"]
[100.667048, "o", "root@a90d859a-bc6c-4445-bef8-63451247f349:/app# "]
[115.73075, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: abtest/report.py\n@@\n-def build_readout(data_dir):\n-    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\n-    pageviews = load_pageviews(data_dir, assignments)\n-    per_user = per_user_counts(assignments, pageviews)\n-    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\n-\n-    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\n-    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\n-    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\n-    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\n-    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\n-    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\n-    srm_flag = bool(srm_p < SRM_ALPHA)\n-    return {\n-        \"experiment\": \"EXP-2291\",\n-        \"n_users\": n_users,\n-        \"pageviews\": views,\n-        \"clicks\": clicks,\n-        \"ctr\": ctr,\n-        \"diff\": float(diff),\n-        \"rel_lift\": float(diff / ctr[\"A\"]),\n-        \"ci_9"]
[115.73085, "i", "5\": [float(ci_low), float(ci_high)],\n-        \"ci_method\": CI_METHOD,\n-        \"srm_p\": srm_p,\n-        \"srm_flag\": srm_flag,\n-        \"decision\": decide(srm_flag, ci_low),\n-    }\n+def build_readout(data_dir):\n+    \"\"\"Construct the experiment readout according to EXPERIMENT.md.\n+\n+    The original implementation performed the Sample Ratio Mismatch (SRM) check **after**\n+    excluding bot traffic.  The experiment plan requires the SRM test to be applied to the raw\n+    randomization counts *before* any post‑assignment exclusions, because SRM is a diagnostic of\n+    the assignment service itself.  Bots may be unevenly distributed between arms and must not\n+    influence the SRM decision.\n+\n+    This function now:\n+    1. Loads the raw assignments.\n+    2. Computes the SRM p‑value using the raw variant counts.\n+    3. Applies bot exclusion for all downstream metrics (n_users, pageviews, clicks, CTR, CI).\n+    4. Returns the readout JSON structure.\n+    \"\"\"\n+\n+    # Step 1: raw assignments (no filtering) – "]
[115.730877, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[115.730902, "i", "needed for SRM.\n+    raw_assignments = load_assignments(data_dir)\n+    raw_counts = {arm: int((raw_assignments[\"variant\"] == arm).sum()) for arm in ARMS}\n+    srm_p = srm_pvalue(raw_counts[\"A\"], raw_counts[\"B\"])\n+    srm_flag = bool(srm_p < SRM_ALPHA)\n+\n+    # Step 2: apply bot exclusion for the metric calculations.\n+    assignments = exclude_bots(raw_assignments, load_bot_flags(data_dir))\n+    pageviews = load_pageviews(data_dir, assignments)\n+    per_user = per_user_counts(assignments, pageviews)\n+    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\n+\n+    # Metric calculations on the filtered data.\n+    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\n+    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\n+    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\n+    # Guard against division by zero – if an arm has zero pageviews, its CTR is defined as 0.\n+    ctr = {arm: (clicks[arm] / views[arm] if views[arm] != 0 else 0.0) for arm in ARMS}\n+    diff, (ci_low,"]
[115.730925, "o", "needed for SRM.\r\n+"]
