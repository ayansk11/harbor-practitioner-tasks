[134.373563, "o", "\u001b[?2004h"]
[134.373583, "o", "> "]
[134.373852, "o", "                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n\u001b[?2004l\r"]
