[13.345391, "o", "\u001b[?2004l\r"]
[13.347019, "o", "# Note from Priya (PM, product pages), Wednesday 2026-09-16\r\n\r\n**Subject:** EXP-2291 readout: please re-check before the launch on Monday\r\n\r\nThe readout in `output/result.json` came back \"invalid\": the sample ratio check failed, with 16,570 users in A and\r\n15,722 in B (about 5% fewer in B). That verdict does not match the dashboards:\r\n- the assignment dashboard shows 16,935 users in A and 17,165 in B: a clean 50/50 split (49.7% / 50.3%);\r\n"]
[13.347075, "o", "- the team dashboard, which reads the same export with no filters (every pageview of every assigned user), shows\r\n  click-through of 11.03% in B against 9.82% in A: B is 12.3% higher.\r\n\r\nPlan: turn B on for everyone on Monday 2026-09-21 if B really wins. Requests: check the analysis against the plan in\r\n`EXPERIMENT.md`, fix whatever is wrong, and put the corrected readout in `output/result.json`. The same pipeline will\r\nrun the next experiments, so the pipeline needs a proper fix, not just this one file.\r\n"]
[13.347298, "o", "\u001b[?2004h"]
[13.347327, "o", "root@a90d859a-bc6c-4445-bef8-63451247f349:/app# "]
[21.612926, "i", "sed -n '1,200p' abtest/load.py\n"]
[21.613062, "o", "sed -n '1,200p' abtest/load.py\r\n"]
[21.613107, "o", "\u001b[?2004l\r"]
[21.614726, "o", "\"\"\"Read one experiment export: assignments, bot_flags, pageviews and module_clicks (.csv.gz) in one folder.\"\"\"\r\nfrom pathlib import Path\r\n\r\nimport pandas as pd\r\n\r\n\r\ndef _read(data_dir, name, dtype=str):\r\n    return pd.read_csv(Path(data_dir) / f\"{name}.csv.gz\", dtype=dtype)\r\n\r\n"]
[21.61483, "o", "\r\ndef _instants(col):\r\n    # The export mixes \"Z\" and \"+hh:mm\" / \"-hh:mm\" offsets. Parse to UTC: compare instants, never strings.\r\n    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n\r\n\r\ndef load_assignments(data_dir):\r\n    \"\"\"One row per assigned user: user_id, variant (\"A\" or \"B\"), assigned_at (UTC), method.\"\"\"\r\n    df = _read(data_dir, \"assignments\")\r\n    df = df.drop_duplicates()  # the assignment logger retries; an exact repeat of a row counts once\r\n    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\r\n    return df.reset_index(drop=True)\r\n\r\n\r\ndef load_bot_flags(data_dir):\r\n    \"\"\"One row per flag of the platform's bot screening: user_id, rule, flagged_at (UTC).\"\"\"\r\n    df = _read(data_dir, \"bot_flags\")\r\n    df[\"flagged_at\"] = _instants(df[\"flagged_at\"])\r\n    return df\r\n\r\n"]
[21.614857, "o", "\r\ndef load_pageviews(data_dir, assignments):\r\n    \"\"\"Pageviews of the given assigned users, on or after the user's assignment time, with the variant attached.\"\"\"\r\n    pv = _read(data_dir, \"pageviews\", dtype={\"pageview_id\": str, \"user_id\": str, \"ts\": str, \"clicked\": \"int64\"})\r\n    pv[\"ts\"] = _instants(pv[\"ts\"])\r\n    pv = pv.merge(assignments[[\"user_id\", \"variant\", \"assigned_at\"]], on=\"user_id\", how=\"inner\")\r\n    pv = pv[pv[\"ts\"] >= pv[\"assigned_at\"]]  # exposure before assignment is not part of the experiment\r\n    return pv.reset_index(drop=True)\r\n\r\n\r\ndef load_module_clicks(data_dir):\r\n    \"\"\"Events of the related-items module: pageview_id, user_id, ts (UTC), target.\"\"\"\r\n    df = _read(data_dir, \"module_clicks\")\r\n    df[\"ts\"] = _instants(df[\"ts\"])\r\n    return df\r\n"]
[21.615037, "o", "\u001b[?2004h"]
[21.615074, "o", "root@a90d859a-bc6c-4445-bef8-63451247f349:/app# "]
[21.995769, "i", "sed -n '1,200p' abtest/filters.py\n"]
[21.995894, "o", "sed -n '1,200p' abtest/filters.py\r\n"]
[21.996002, "o", "\u001b[?2004l\r"]
[21.9974, "o", "\"\"\"Population filters for the readout.\"\"\"\r\n\r\n\r\ndef exclude_bots(assignments, bot_flags):\r\n    \"\"\"Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).\r\n"]
[21.997435, "o", "\r\n    Bot traffic is every user the platform's bot screening flagged (bot_flags.csv.gz): crawlers (rule ua_crawler)\r\n    and, since SEC-219, click-fraud bots on the related-items module (rule velocity).\r\n    \"\"\"\r\n    flagged = set(bot_flags[\"user_id\"])\r\n    return assignments[~assignments[\"user_id\"].isin(flagged)].reset_index(drop=True)\r\n"]
[21.997638, "o", "\u001b[?2004h"]
[21.997674, "o", "root@a90d859a-bc6c-4445-bef8-63451247f349:/app# "]
[22.379454, "i", "sed -n '1,200p' abtest/stats.py\n"]
[22.379584, "o", "sed -n '1,200p' abtest/stats.py\r\n"]
[22.379613, "o", "\u001b[?2004l\r"]
[22.381301, "o", "\"\"\"Statistics for the CTR readout (EXPERIMENT.md sections 5 and 6). The unit of randomization is the user.\"\"\"\r\nimport math\r\n\r\nimport numpy as np\r\nfrom scipy.stats import chisquare, norm\r\n\r\nZ = float(norm.ppf(0.975))\r\nSRM_ALPHA = 0.001\r\nCI_METHOD = \"delta method, users as the unit\"\r\n\r\n\r\ndef ratio_delta(clicks, views):\r\n    \"\"\"CTR = sum(clicks) / sum(views) over users, and its delta-method variance.\r\n\r\n    clicks, views: one entry per counted user, users with zero pageviews included. Var = N/(N-1) * sum((c - r v)^2) /\r\n    (sum v)^2, the usual linearisation of a ratio of two user-level means.\r\n    \"\"\"\r\n"]
[22.381336, "o", "    c = np.asarray(clicks, dtype=float)\r\n    v = np.asarray(views, dtype=float)\r\n    n = len(c)\r\n    r = c.sum() / v.sum()\r\n    var = n / (n - 1) * float(np.sum((c - r * v) ** 2)) / float(v.sum()) ** 2\r\n    return float(r), var\r\n\r\n\r\ndef diff_ci(arm_a, arm_b):\r\n    \"\"\"CTR_B - CTR_A and its 95% CI; arm_a, arm_b: per-user frames with columns clicks, views.\"\"\"\r\n    ra, va = ratio_delta(arm_a[\"clicks\"], arm_a[\"views\"])\r\n"]
[22.381373, "o", "    rb, vb = ratio_delta(arm_b[\"clicks\"], arm_b[\"views\"])\r\n    diff = rb - ra\r\n    se = math.sqrt(va + vb)\r\n    return diff, (diff - Z * se, diff + Z * se)\r\n\r\n\r\ndef srm_pvalue(n_a, n_b):\r\n    \"\"\"Pearson chi-square goodness of fit of the user counts against 50/50 (1 df, no continuity correction).\"\"\"\r\n    return float(chisquare([n_a, n_b]).pvalue)\r\n"]
[22.381572, "o", "\u001b[?2004h"]
[22.381593, "o", "root@a90d859a-bc6c-4445-bef8-63451247f349:/app# "]
[22.772719, "i", "sed -n '1,200p' abtest/report.py\n"]
[22.772848, "o", "sed -n '1,200p' abtest/report.py\r\n"]
[22.772869, "o", "\u001b[?2004l\r"]
[22.774075, "o", "\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\nimport argparse\r\nimport json\r\nfrom pathlib import Path"]
[22.774305, "o", "\r\n\r\nfrom .filters import exclude_bots\r\nfrom .load import load_assignments, load_bot_flags, load_pageviews\r\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n\r\nARMS = (\"A\", \"B\")\r\n\r\n\r\ndef per_user_counts(assignments, pageviews):\r\n    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\r\n\r\n    A pageview's click is its `clicked` flag (the module click flag of the export).\r\n    \"\"\"\r\n    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\r\n    return per_user.fillna({\"clicks\": 0, \"views\": 0})\r\n\r\n\r\ndef decide(srm_flag, ci_low):\r\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n    if srm_flag:\r\n        return \"invalid\"\r\n    return \"ship\" if ci_low > 0 else \"no_ship\"\r\n\r\n\r\ndef build_readout(data_dir):\r\n    assignments = exclude_bots(load_assignments(data_dir), load_bot_flags(data_dir))\r\n    pageviews = load_pageviews(data_dir, assignments)\r\n    per_u"]
[22.774321, "o", "ser = per_user_counts(assignments, pageviews)\r\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n\r\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n    srm_flag = bool(srm_p < SRM_ALPHA)\r\n    return {\r\n        \"experiment\": \"EXP-2291\",\r\n        \"n_users\": n_users,\r\n        \"pageviews\": views,\r\n        \"clicks\": clicks,\r\n        \"ctr\": ctr,\r\n        \"diff\": float(diff),\r\n        \"rel_lift\": float(diff / ctr[\"A\"]),\r\n        \"ci_95\": [float(ci_low), float(ci_high)],\r\n        \"ci_method\": CI_METHOD,\r\n        \"srm_p\": srm_p,\r\n        \"srm_flag\": srm_flag,\r\n        \"decision\": decide(srm_flag, ci_low),\r\n    }\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser(description=\"EXP"]
[22.77433, "o", "-2291 CTR readout\")\r\n    ap.add_argument(\"--data\", required=True,\r\n                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n    args = ap.parse_args(argv)\r\n    readout = build_readout(args.data)\r\n    out = Path(args.out)\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
