[134.363531, "i", "cat > abtest/report.py <<'EOF'\n\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots\nfrom .load import load_assignments, load_bot_flags, load_pageviews\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\n\nARMS = (\"A\", \"B\")\n\n\ndef per_user_counts(assignments, pageviews):\n    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\n\n    A pageview's click is its `clicked` flag (the module click flag of the export).\n    \"\"\"\n    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\n    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\n    return per_user.fillna({\"clicks\": 0, \"views\": 0})\n\n\ndef decide(srm_flag, ci_low):\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\n    if srm_flag:\n        return \"invalid\"\n    return \"ship\" if ci_low > 0 else \"no_ship\"\n\n\ndef build_readout(data_dir):\n    \"\"\"Con"]
[134.363641, "i", "struct the experiment readout according to EXPERIMENT.md.\n\n    The SRM check must be performed on the raw assignment counts before any bot\n    exclusion, because SRM diagnoses assignment imbalance, not downstream filtering.\n    \"\"\"\n    # Raw assignments for SRM\n    raw_assignments = load_assignments(data_dir)\n    raw_counts = {arm: int((raw_assignments[\"variant\"] == arm).sum()) for arm in ARMS}\n    srm_p = srm_pvalue(raw_counts[\"A\"], raw_counts[\"B\"])\n    srm_flag = bool(srm_p < SRM_ALPHA)\n\n    # Apply bot exclusion for metric calculations\n    assignments = exclude_bots(raw_assignments, load_bot_flags(data_dir))\n    pageviews = load_pageviews(data_dir, assignments)\n    per_user = per_user_counts(assignments, pageviews)\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\n\n    # Metrics on filtered data\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\n    "]
[134.363683, "i", "ctr = {arm: (clicks[arm] / views[arm] if views[arm] != 0 else 0.0) for arm in ARMS}\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\n\n    return {\n        \"experiment\": \"EXP-2291\",\n        \"n_users\": n_users,\n        \"pageviews\": views,\n        \"clicks\": clicks,\n        \"ctr\": ctr,\n        \"diff\": float(diff),\n        \"rel_lift\": (float(diff / ctr[\"A\"]) if ctr[\"A\"] != 0 else None),\n        \"ci_95\": [float(ci_low), float(ci_high)],\n        \"ci_method\": CI_METHOD,\n        \"srm_p\": srm_p,\n        \"srm_flag\": srm_flag,\n        \"decision\": decide(srm_flag, ci_low),\n    }\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\n    ap.add_argument(\"--data\", required=True,\n                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\n    args = ap.parse_args(argv)\n    readout = build_readout(args.data)\n    out = Path(args.out)\n    out.parent.mkd"]
[134.363714, "o", "cat > abtest/report.py <<'EOF'\r\n\u001b[?2004l\r"]
[134.36374, "i", "ir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[134.363771, "o", "ctr = {arm: (clicks[arm] / views[arm] if views[arm] != 0 else 0.0) for arm in ARMS}\r\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n\r\n    return {\r\n        \"experiment\": \"EXP-2291\",\r\n        \"n_users\": n_users,\r\n        \"pageviews\": views,\r\n        \"clicks\": cli"]
[134.3638, "o", "cks,\r\n        \"ctr\": ctr,\r\n        \"diff\": float(diff),\r\n        \"rel_lift\": (float(diff / ctr[\"A\"]) if ctr[\"A\"] != 0 else None),\r\n        \"ci_95\": [float(ci_low), float(ci_high)],"]
[134.36383, "o", "\r\n        \"ci_method\": CI_METHOD,\r\n        "]
[134.363858, "o", "\"srm_p\": srm_p,\r\n        \"srm_flag\": srm_flag,\r\n        \"decision\": decide(srm_flag, ci_low),\r\n    }\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.Argumen"]
[134.363886, "o", "tParser(description=\"EXP-2291 CTR readout\")\r\n    ap.add_argument(\"--data\", required=True,\r\n       "]
[134.36391, "o", "             help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.js"]
[134.36394, "o", "on to write\")\r\n    args = ap.parse_args(argv)\r\n    readout = build_readout(args.data)\r\n    out = Path(args.out)\r\n    out.parent.mkd"]
[134.363955, "o", "ir(parents=True, exist_ok=True)\r\n    out.write_text(json.dumps(rea"]
[134.363985, "o", "dout, indent=2) + \"\\n\")\r\n    print(f\"wrote {out}: decision={readout"]
[134.364012, "o", "['decision']} diff={readout['diff']:+.5f} \"\r\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n   "]
[134.364038, "o", " main()\r\nEOF\r\n\u001b[?2004h> "]
