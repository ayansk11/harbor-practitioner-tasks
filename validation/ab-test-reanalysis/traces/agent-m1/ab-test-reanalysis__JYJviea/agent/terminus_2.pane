[?2004l[?2004h> +def build_readout(data_dir):
[?2004l[?2004h> +    """Construct the experiment readout according to EXPERIMENT.md.
[?2004l[?2004h> +
[?2004l[?2004h> +    The original implementation performed the Sample Ratio Mismatch (SRM) check **after**
[?2004l[?2004h> +    excluding bot traffic.  The experiment plan requires the SRM test to be applied to the raw
[?2004l[?2004h> +    randomization counts *before* any post‑assignment exclusions, because SRM is a diagnostic of
[?2004l[?2004h> +    the assignment service itself.  Bots may be unevenly distributed between arms and must not
[?2004l[?2004h> +    influence the SRM decision.
[?2004l[?2004h> +
[?2004l[?2004h> +    This function now:
[?2004l[?2004h> +    1. Loads the raw assignments.
[?2004l[?2004h> +    2. Computes the SRM p‑value using the raw variant counts.
[?2004l[?2004h> +    3. Applies bot exclusion for all downstream metrics (n_users, pageviews, clicks, CTR, CI).
[?2004l[?2004h> +    4. Returns the readout JSON structure.
[?2004l[?2004h> +    """
[?2004l[?2004h> +
[?2004l[?2004h> +    # Step 1: raw assignments (no filtering) – needed for SRM.
[?2004l[?2004h> +    raw_assignments = load_assignments(data_dir)
[?2004l[?2004h> +    raw_counts = {arm: int((raw_assignments["variant"] == arm).sum()) for arm in ARMS}
[?2004l[?2004h> +    srm_p = srm_pvalue(raw_counts["A"], raw_counts["B"])
[?2004l[?2004h> +    srm_flag = bool(srm_p < SRM_ALPHA)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Step 2: apply bot exclusion for the metric calculations.
[?2004l[?2004h> +    assignments = exclude_bots(raw_assignments, load_bot_flags(data_dir))
[?2004l[?2004h> +    pageviews = load_pageviews(data_dir, assignments)
[?2004l[?2004h> +    per_user = per_user_counts(assignments, pageviews)
[?2004l[?2004h> +    arms = {arm: per_user[per_user["variant"] == arm] for arm in ARMS}
[?2004l[?2004h> +
[?2004l[?2004h> +    # Metric calculations on the filtered data.
[?2004l[?2004h> +    n_users = {arm: int(len(arms[arm])) for arm in ARMS}
[?2004l[?2004h> +    views = {arm: int(arms[arm]["views"].sum()) for arm in ARMS}
[?2004l[?2004h> +    clicks = {arm: int(arms[arm]["clicks"].sum()) for arm in ARMS}
[?2004l[?2004h> +    # Guard against division by zero – if an arm has zero pageviews, its CTR is defined as 0.
[?2004l[?2004h> +    ctr = {arm: (clicks[arm] / views[arm] if views[arm] != 0 else 0.0) for arm in ARMS}
[?2004l[?2004h> +    diff, (ci_low, ci_high) = diff_ci(arms["A"], arms["B"])
[?2004l[?2004h> +
[?2004l[?2004h> +    return {
[?2004l[?2004h> +        "experiment": "EXP-2291",
[?2004l[?2004h> +        "n_users": n_users,
[?2004l[?2004h> +        "pageviews": views,
[?2004l[?2004h> +        "clicks": clicks,
[?2004l[?2004h> +        "ctr": ctr,
[?2004l[?2004h> +        "diff": float(diff),
[?2004l[?2004h> +        "rel_lift": (float(diff / ctr["A"]) if ctr["A"] != 0 else None),
[?2004l[?2004h> +        "ci_95": [float(ci_low), float(ci_high)],
[?2004l[?2004h> +        "ci_method": CI_METHOD,
[?2004l[?2004h> +        "srm_p": srm_p,
[?2004l[?2004h> +        "srm_flag": srm_flag,
[?2004l[?2004h> +        "decision": decide(srm_flag, ci_low),
[?2004l[?2004h> +    }
