[?2004l[?2004h>     n_users = {arm: int(len(arms[arm])) for arm in ARMS}
[?2004l[?2004h>     views = {arm: int(arms[arm]["views"].sum()) for arm in ARMS}
[?2004l[?2004h>     clicks = {arm: int(arms[arm]["clicks"].sum()) for arm in ARMS}
