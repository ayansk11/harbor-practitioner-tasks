[?2004l[?2004h> """Population filters for the readout."""
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def exclude_bots(assignments, bot_flags):
[?2004l[?2004h>     """Drop bot traffic from both arms, before anything is counted (EXPERIMENT.md section 3).
[?2004l[?2004h> 
[?2004l[?2004h>     Bot traffic is every user the platform's bot screening flagged by a rule that looks only at
[?2004l[?2004h>     who the client is (rule ua_crawler). Rules that look at user behavior (rule velocity)
[?2004l[?2004h>     should not be used for exclusion.
[?2004l[?2004h>     """
[?2004l[?2004h>     flagged = set(bot_flags[bot_flags["rule"] == "ua_crawler"]["user_id"])
[?2004l[?2004h>     return assignments[~assignments["user_id"].isin(flagged)].reset_index(drop=True)
