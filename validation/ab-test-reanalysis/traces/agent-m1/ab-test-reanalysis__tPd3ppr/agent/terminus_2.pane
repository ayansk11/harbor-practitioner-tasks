[?2004l[?2004h> 
[?2004l[?2004h> ARMS = ("A", "B")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def per_user_counts(assignments, pageviews, clicked_pv_ids):
[?2004l[?2004h>     """One row per counted user (users with no pageview included): user_id, variant, clicks, views.
[?2004l[?2004h> 
[?2004l[?2004h>     A pageview is clicked if its pageview_id is in clicked_pv_ids.
[?2004l[?2004h>     """
[?2004l[?2004h>     pageviews = pageviews.copy()
[?2004l[?2004h>     pageviews["is_clicked"] = pageviews["pageview_id"].isin(clicked_pv_ids)
[?2004l[?2004h>     g = pageviews.groupby("user_id").agg(clicks=("is_clicked", "sum"), views=("is_clicked", "size"))
[?2004l[?2004h>     per_user = assignments[["user_id", "variant"]].join(g, on="user_id")
