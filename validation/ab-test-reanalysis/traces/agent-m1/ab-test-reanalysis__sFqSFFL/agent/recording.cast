[326.956312, "i", "cd /app && python3 -c \"\nimport numpy as np, math\nfrom abtest.stats import ratio_delta\n# manual cross-check of delta method on small synthetic data\nc=np.array([1.0,2,0,3]); v=np.array([10.0,20,15,5])\nr,vv=ratio_delta(c,v)\nn=len(c); R=c.sum()/v.sum()\nresid=c-R*v\nprint('r',r,'var',vv)\nprint('manual', (1/(v.mean())**2)*np.var(resid,ddof=1)/n)\n\"\n"]
