[243.634835, "i", "cat > /app/abtest/report.py << 'EOF'\n\"\"\"Readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots\nfrom .load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\n\nARMS = (\"A\", \"B\")\n\n\ndef per_user_counts(assignments, pageviews):\n    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\n\n    A pageview is clicked when the user opened the page of at least one related product from\n    the module on it (a module_click event whose data-target is a product, i.e. starts with 'item:').\n    \"\"\"\n    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\n    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\n    return per_user.fillna({\"clicks\": 0, \"views\": 0})\n\n\ndef decide(srm_flag, ci_low):\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\n  "]
[243.634866, "i", "  if srm_flag:\n        return \"invalid\"\n    return \"ship\" if ci_low > 0 else \"no_ship\"\n\n\ndef build_readout(data_dir):\n    assignments = load_assignments(data_dir)\n    # The experiment is the users the assignment service randomized (method='hash'). A user whose\n    # variant was set by hand (method='override', e.g. dogfood/QA allowlist) is not in the experiment.\n    assignments = assignments[assignments[\"method\"] == \"hash\"].reset_index(drop=True)\n    # Bot exclusion: drop only users flagged by a rule that looks at who the client is\n    # (ua_crawler), never users excluded for what they did during the experiment (velocity).\n    assignments = exclude_bots(assignments, load_bot_flags(data_dir))\n    pageviews = load_pageviews(data_dir, assignments)\n\n    # A pageview is clicked when the user opened at least one related product page from the module:\n    # a module_click event with data-target 'item:<product_id>'. Carousel arrows (nav:*) and the\n    # 'See all' link (link:all) do not open a product page and are not c"]
[243.634878, "i", "licks for this metric.\n    clicks_df = load_module_clicks(data_dir)\n    clicked_pv_ids = set(clicks_df.loc[clicks_df[\"target\"].str.startswith(\"item:\"), \"pageview_id\"])\n    pageviews = pageviews.copy()\n    pageviews[\"clicked\"] = pageviews[\"pageview_id\"].isin(clicked_pv_ids).astype(int)\n\n    per_user = per_user_counts(assignments, pageviews)\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\n\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\n    srm_flag = bool(srm_p < SRM_ALPHA)\n\n    notes = [\n        f\"Counted {n_users['A']} A and {n_users['B']} B users (method='hash', ua_crawler bots excluded); \"\n        f\"SRM chi-square p={srm_p:.4g}, no sample ratio mismatch.\"\n        f\" CTR A={ctr['A"]
[243.634908, "i", "']:.4%}, B={ctr['B']:.4%}, diff={diff:+.5f}; 95% CI [{ci_low:+.5f}, {ci_high:+.5f}] \"\n        f\"crosses zero, so the module does not show a clear change in click-through.\",\n        \"Three earlier bugs were fixed. (1) Bot exclusion now drops only users flagged by ua_crawler, \"\n        \"the rule that looks at who the client is; users flagged by 'velocity' were wrongly removed even \"\n        \"though that rule reacts to what a user did, not to the client, so they are kept. \"\n        \"(2) Users whose variant was set by hand (method='override', the dogfood/QA allowlist) are not part \"\n        \"of the randomized experiment and are excluded, so only the hash-randomized 50/50 split is read. \"\n        \"(3) A 'click' is a pageview from which the user opened a related product page \"\n        \"(module_click target 'item:<product_id>'); carousel arrows (nav:prev/nav:next) and the 'See all' \"\n        \"link (link:all) do not open a product page and are not counted, so the precomputed dashboard 'clicked' \"\n        \"column was "]
[243.634915, "i", "replaced by recomputing from module_clicks.\",\n    ]\n\n    return {\n        \"experiment\": \"EXP-2291\",\n        \"n_users\": n_users,\n        \"pageviews\": views,\n        \"clicks\": clicks,\n        \"ctr\": ctr,\n        \"diff\": float(diff),\n        \"rel_lift\": float(diff / ctr[\"A\"]) if ctr[\"A\"] != 0 else 0.0,\n        \"ci_95\": [float(ci_low), float(ci_high)],\n        \"ci_method\": CI_METHOD,\n        \"srm_p\": srm_p,\n        \"srm_flag\": srm_flag,\n        \"decision\": decide(srm_flag, ci_low),\n        \"notes\": notes,\n    }\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\n    ap.add_argument(\"--data\", required=True,\n                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\n    args = ap.parse_args(argv)\n    readout = build_readout(args.data)\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(readout, "]
[243.634923, "i", "indent=2) + \"\\n\")\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[243.635239, "o", "cat > /app/abtest/report.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.635402, "o", "\"\"\"Readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\n\u001b[?2004l\r"]
[243.63546, "o", "\u001b[?2004h> "]
[243.635511, "o", "import argparse\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.635561, "o", "> "]
[243.63562, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.635682, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[243.635721, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.635729, "o", "\u001b[?2004h> "]
[243.635867, "o", "from .filters import exclude_bots\r\n\u001b[?2004l\r"]
[243.635909, "o", "\u001b[?2004h> "]
[243.636235, "o", "from .load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\r\n\u001b[?2004l\r"]
[243.636255, "o", "\u001b[?2004h"]
[243.636262, "o", "> "]
[243.636503, "o", "from .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\r\n\u001b[?2004l\r"]
[243.636536, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.636543, "o", "\u001b[?2004h"]
[243.636551, "o", "> "]
[243.636634, "o", "ARMS = (\"A\", \"B\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.636646, "o", "> \r\n\u001b[?2004l\r"]
[243.636672, "o", "\u001b[?2004h> "]
[243.636701, "o", "\r\n\u001b[?2004l\r"]
[243.636715, "o", "\u001b[?2004h> "]
[243.636998, "o", "def per_user_counts(assignments, pageviews):\r\n"]
[243.63703, "o", "\u001b[?2004l\r"]
[243.637042, "o", "\u001b[?2004h> "]
[243.637632, "o", "    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\r\n"]
[243.637663, "o", "\u001b[?2004l\r"]
[243.637675, "o", "\u001b[?2004h> "]
[243.637682, "o", "\r\n"]
[243.63769, "o", "\u001b[?2004l\r"]
[243.637726, "o", "\u001b[?2004h> "]
[243.638123, "o", "    A pageview is clicked when the user opened the page of at least one related product from\r\n"]
[243.638147, "o", "\u001b[?2004l\r"]
[243.638159, "o", "\u001b[?2004h> "]
[243.640872, "o", "    the module on it (a module_click event whose data-target is a product, i.e. starts with 'item:').\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n\u001b[?2004l\r\u001b[?2004h>     per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\r\n\u001b[?2004l\r\u001b[?2004h>     return per_user.fillna({\"clicks\": 0, \"views\": 0})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def decide(srm_flag, ci_low):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if srm_flag:\r\n\u001b[?2004l\r\u001b[?2004h>         return \"invalid\"\r\n\u001b[?2004l\r\u001b[?2004h>     return \"ship\" if ci_low > 0 else \"no_ship\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def build_readout(data_dir):\r\n\u001b[?2004l\r\u001b[?2004h>     assignments = load_assignments(data_dir)\r\n\u001b[?2004l\r\u001b[?2004h>     # The experiment is the users the assignment service randomized (method='hash'). A user whose\r\n\u001b[?2004l\r\u001b[?2004h>     # v"]
[243.640975, "o", "ariant was set by hand (method='override', e.g. dogfood/QA allowlist) is not in the experiment.\r\n\u001b[?2004l\r\u001b[?2004h>     assignments = assignments[assignments[\"method\"] == \"hash\"].reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.641048, "o", "    # Bot exclusion: drop only users flagged by a rule that looks at who the client is\r\n\u001b[?2004l\r"]
[243.641058, "o", "\u001b[?2004h"]
[243.641091, "o", "> "]
[243.641305, "o", "    # (ua_crawler), never users excluded for what they did during the experiment (velocity).\r\n\u001b[?2004l\r"]
[243.641335, "o", "\u001b[?2004h> "]
[243.641508, "o", "    assignments = exclude_bots(assignments, load_bot_flags(data_dir))\r\n\u001b[?2004l\r"]
[243.641537, "o", "\u001b[?2004h> "]
[243.641668, "o", "    pageviews = load_pageviews(data_dir, assignments)\r\n\u001b[?2004l\r"]
[243.64169, "o", "\u001b[?2004h> "]
[243.641702, "o", "\r\n\u001b[?2004l\r"]
[243.64171, "o", "\u001b[?2004h"]
[243.64175, "o", "> "]
[243.641977, "o", "    # A pageview is clicked when the user opened at least one related product page from the module:\r\n\u001b[?2004l\r"]
[243.642006, "o", "\u001b[?2004h"]
[243.642017, "o", "> "]
[243.642242, "o", "    # a module_click event with data-target 'item:<product_id>'. Carousel arrows (nav:*) and the\r\n\u001b[?2004l\r"]
[243.642269, "o", "\u001b[?2004h"]
[243.642281, "o", "> "]
[243.642503, "o", "    # 'See all' link (link:all) do not open a product page and are not clicks for this metric.\r\n\u001b[?2004l\r"]
[243.642519, "o", "\u001b[?2004h"]
[243.642531, "o", "> "]
[243.642641, "o", "    clicks_df = load_module_clicks(data_dir)\r\n\u001b[?2004l\r"]
[243.642668, "o", "\u001b[?2004h"]
[243.642679, "o", "> "]
[243.642923, "o", "    clicked_pv_ids = set(clicks_df.loc[clicks_df[\"target\"].str.startswith(\"item:\"), \"pageview_id\"])\r\n\u001b[?2004l\r"]
[243.642952, "o", "\u001b[?2004h"]
[243.642964, "o", "> "]
[243.643026, "o", "    pageviews = pageviews.copy()\r\n\u001b[?2004l\r"]
[243.64305, "o", "\u001b[?2004h"]
[243.643061, "o", "> "]
[243.643263, "o", "    pageviews[\"clicked\"] = pageviews[\"pageview_id\"].isin(clicked_pv_ids).astype(int)\r\n\u001b[?2004l\r"]
[243.64329, "o", "\u001b[?2004h> "]
[243.643301, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.643327, "o", "> "]
[243.643449, "o", "    per_user = per_user_counts(assignments, pageviews)\r\n\u001b[?2004l\r"]
[243.643475, "o", "\u001b[?2004h> "]
[243.643651, "o", "    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\r\n\u001b[?2004l\r"]
[243.643667, "o", "\u001b[?2004h"]
[243.643678, "o", "> \r\n\u001b[?2004l\r"]
[243.643686, "o", "\u001b[?2004h"]
[243.643716, "o", "> "]
[243.643842, "o", "    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\r\n\u001b[?2004l\r"]
[243.643867, "o", "\u001b[?2004h> "]
[243.64404, "o", "    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[243.644062, "o", "\u001b[?2004h"]
[243.644074, "o", "> "]
[243.644228, "o", "    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[243.644254, "o", "\u001b[?2004h> "]
[243.644397, "o", "    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n\u001b[?2004l\r"]
[243.644423, "o", "\u001b[?2004h> "]
[243.644571, "o", "    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n\u001b[?2004l\r"]
[243.644597, "o", "\u001b[?2004h> "]
[243.644723, "o", "    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n\u001b[?2004l\r"]
[243.644745, "o", "\u001b[?2004h"]
[243.644799, "o", "> "]
[243.64485, "o", "    srm_flag = bool(srm_p < SRM_ALPHA)\r\n\u001b[?2004l\r"]
[243.644876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.644909, "o", "\u001b[?2004h"]
[243.645928, "o", ">     notes = [\r\n\u001b[?2004l\r\u001b[?2004h>         f\"Counted {n_users['A']} A and {n_users['B']} B users (method='hash', ua_crawler bots excluded); \"\r\n\u001b[?2004l\r\u001b[?2004h>         f\"SRM chi-square p={srm_p:.4g}, no sample ratio mismatch.\"\r\n\u001b[?2004l\r\u001b[?2004h>         f\" CTR A={ctr['A']:.4%}, B={ctr['B']:.4%}, diff={diff:+.5f}; 95% CI [{ci_low:+.5f}, {ci_high:+.5f}] \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.645975, "o", "        f\"crosses zero, so the module does not show a clear change in click-through.\",\r\n\u001b[?2004l\r"]
[243.645987, "o", "\u001b[?2004h"]
[243.646009, "o", "> "]
[243.646266, "o", "        \"Three earlier bugs were fixed. (1) Bot exclusion now drops only users flagged by ua_crawler, \"\r\n\u001b[?2004l\r"]
[243.646321, "o", "\u001b[?2004h> "]
[243.646556, "o", "        \"the rule that looks at who the client is; users flagged by 'velocity' were wrongly removed even \"\r\n\u001b[?2004l\r"]
[243.646565, "o", "\u001b[?2004h"]
[243.646572, "o", "> "]
[243.64681, "o", "        \"though that rule reacts to what a user did, not to the client, so they are kept. \"\r\n\u001b[?2004l\r"]
[243.646819, "o", "\u001b[?2004h"]
[243.646827, "o", "> "]
[243.647115, "o", "        \"(2) Users whose variant was set by hand (method='override', the dogfood/QA allowlist) are not part \"\r\n\u001b[?2004l\r"]
[243.647136, "o", "\u001b[?2004h"]
[243.647147, "o", "> "]
[243.647408, "o", "        \"of the randomized experiment and are excluded, so only the hash-randomized 50/50 split is read. \"\r\n\u001b[?2004l\r"]
[243.647434, "o", "\u001b[?2004h"]
[243.647447, "o", "> "]
[243.647656, "o", "        \"(3) A 'click' is a pageview from which the user opened a related product page \"\r\n\u001b[?2004l\r"]
[243.647675, "o", "\u001b[?2004h"]
[243.647686, "o", "> "]
[243.647962, "o", "        \"(module_click target 'item:<product_id>'); carousel arrows (nav:prev/nav:next) and the 'See all' \"\r\n\u001b[?2004l\r"]
[243.647991, "o", "\u001b[?2004h"]
[243.648002, "o", "> "]
[243.648267, "o", "        \"link (link:all) do not open a product page and are not counted, so the precomputed dashboard 'clicked' \"\r\n\u001b[?2004l\r"]
[243.648293, "o", "\u001b[?2004h> "]
[243.648462, "o", "        \"column was replaced by recomputing from module_clicks.\",\r\n\u001b[?2004l\r"]
[243.648489, "o", "\u001b[?2004h> "]
[243.648524, "o", "    ]\r\n\u001b[?2004l\r"]
[243.648566, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.648577, "o", "\u001b[?2004h> "]
[243.648602, "o", "    return {\r\n\u001b[?2004l\r"]
[243.648659, "o", "\u001b[?2004h> "]
[243.648705, "o", "        \"experiment\": \"EXP-2291\",\r\n\u001b[?2004l\r"]
[243.648726, "o", "\u001b[?2004h> "]
[243.648796, "o", "        \"n_users\": n_users,\r\n\u001b[?2004l\r"]
[243.648807, "o", "\u001b[?2004h"]
[243.648815, "o", "> "]
[243.6489, "o", "        \"pageviews\": views,\r\n\u001b[?2004l\r"]
[243.648937, "o", "\u001b[?2004h> "]
[243.648996, "o", "        \"clicks\": clicks,\r\n\u001b[?2004l\r"]
[243.649027, "o", "\u001b[?2004h"]
[243.649036, "o", "> "]
[243.649098, "o", "        \"ctr\": ctr,\r\n\u001b[?2004l\r"]
[243.649134, "o", "\u001b[?2004h> "]
[243.649197, "o", "        \"diff\": float(diff),\r\n\u001b[?2004l\r"]
[243.649226, "o", "\u001b[?2004h> "]
[243.649395, "o", "        \"rel_lift\": float(diff / ctr[\"A\"]) if ctr[\"A\"] != 0 else 0.0,\r\n\u001b[?2004l\r"]
[243.649409, "o", "\u001b[?2004h"]
[243.649417, "o", "> "]
[243.649546, "o", "        \"ci_95\": [float(ci_low), float(ci_high)],\r\n\u001b[?2004l\r"]
[243.649556, "o", "\u001b[?2004h"]
[243.649564, "o", "> "]
[243.64965, "o", "        \"ci_method\": CI_METHOD,\r\n\u001b[?2004l\r"]
[243.64966, "o", "\u001b[?2004h"]
[243.649668, "o", "> "]
[243.649738, "o", "        \"srm_p\": srm_p,\r\n\u001b[?2004l\r"]
[243.649748, "o", "\u001b[?2004h"]
[243.649755, "o", "> "]
[243.649831, "o", "        \"srm_flag\": srm_flag,\r\n\u001b[?2004l\r"]
[243.649849, "o", "\u001b[?2004h> "]
[243.649992, "o", "        \"decision\": decide(srm_flag, ci_low),\r\n\u001b[?2004l\r"]
[243.650003, "o", "\u001b[?2004h"]
[243.65001, "o", "> "]
[243.650074, "o", "        \"notes\": notes,\r\n\u001b[?2004l\r"]
[243.650083, "o", "\u001b[?2004h"]
[243.650138, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.650148, "o", "\u001b[?2004h"]
[243.650156, "o", "> \r\n\u001b[?2004l\r"]
[243.650223, "o", "\u001b[?2004h> "]
[243.650234, "o", "def main(argv=None):\r\n\u001b[?2004l\r"]
[243.650257, "o", "\u001b[?2004h> "]
[243.650432, "o", "    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n\u001b[?2004l\r"]
[243.65045, "o", "\u001b[?2004h> "]
[243.65076, "o", "    ap.add_argument(\"--data\", required=True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.65086, "o", "                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n\u001b[?2004l\r"]
[243.650872, "o", "\u001b[?2004h"]
[243.650879, "o", "> "]
[243.651119, "o", "    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.651131, "o", "> "]
[243.65121, "o", "    args = ap.parse_args(argv)\r\n\u001b[?2004l\r"]
[243.65124, "o", "\u001b[?2004h> "]
[243.651335, "o", "    readout = build_readout(args.data)\r\n\u001b[?2004l\r"]
[243.651356, "o", "\u001b[?2004h> "]
[243.651421, "o", "    out = Path(args.out)\r\n\u001b[?2004l\r"]
[243.651431, "o", "\u001b[?2004h"]
[243.651464, "o", "> "]
[243.651569, "o", "    out.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[243.651598, "o", "\u001b[?2004h> "]
[243.651747, "o", "    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n\u001b[?2004l\r"]
[243.651763, "o", "\u001b[?2004h"]
[243.651829, "o", "> "]
[243.651998, "o", "    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n\u001b[?2004l\r"]
[243.652081, "o", "\u001b[?2004h> "]
[243.652437, "o", "          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.652491, "o", ">     main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.652504, "o", "> "]
[243.652512, "o", "EOF\r\n\u001b[?2004l\r"]
