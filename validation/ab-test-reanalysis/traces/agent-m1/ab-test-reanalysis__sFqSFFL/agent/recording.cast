[97.082819, "i", "cat > /app/abtest/report.py << 'EOF'\n\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots\nfrom .load import load_assignments, load_bot_flags, load_module_clicks, load_pageviews\nfrom .stats import CI_METHOD, SRM_ALPHA, diff_ci, srm_pvalue\n\nARMS = (\"A\", \"B\")\n\n\ndef per_user_counts(assignments, pageviews):\n    \"\"\"One row per counted user (users with no pageview included): user_id, variant, clicks, views.\n\n    A pageview is clicked when the user opened the page of at least one related product from\n    the module on it (a module_click event with target starting with 'item:').\n    \"\"\"\n    g = pageviews.groupby(\"user_id\").agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\n    per_user = assignments[[\"user_id\", \"variant\"]].join(g, on=\"user_id\")\n    return per_user.fillna({\"clicks\": 0, \"views\": 0})\n\n\ndef decide(srm_flag, ci_low):\n    \"\"\"EXPERIMENT.md section 7, in this order.\"\"\"\n    if srm_flag:"]
[97.082937, "i", "\n        return \"invalid\"\n    return \"ship\" if ci_low > 0 else \"no_ship\"\n\n\ndef build_readout(data_dir):\n    assignments = load_assignments(data_dir)\n    # The experiment is the users the assignment service randomized (method='hash').\n    # Users whose variant was set by hand (method='override') are not in the experiment.\n    assignments = assignments[assignments[\"method\"] == \"hash\"].reset_index(drop=True)\n    assignments = exclude_bots(assignments, load_bot_flags(data_dir))\n    pageviews = load_pageviews(data_dir, assignments)\n\n    # A pageview is clicked when the user opened the page of at least one related product\n    # from the module on it: a module_click event with data-target starting with 'item:'.\n    clicks_df = load_module_clicks(data_dir)\n    clicked_pv_ids = set(clicks_df.loc[clicks_df[\"target\"].str.startswith(\"item:\"), \"pageview_id\"])\n    pageviews = pageviews.copy()\n    pageviews[\"clicked\"] = pageviews[\"pageview_id\"].isin(clicked_pv_ids).astype(int)\n\n    per_user = per_user_counts(assignments, pa"]
[97.082983, "i", "geviews)\n    arms = {arm: per_user[per_user[\"variant\"] == arm] for arm in ARMS}\n\n    n_users = {arm: int(len(arms[arm])) for arm in ARMS}\n    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\n    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\n    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\n    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\n    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\n    srm_flag = bool(srm_p < SRM_ALPHA)\n    return {\n        \"experiment\": \"EXP-2291\",\n        \"n_users\": n_users,\n        \"pageviews\": views,\n        \"clicks\": clicks,\n        \"ctr\": ctr,\n        \"diff\": float(diff),\n        \"rel_lift\": float(diff / ctr[\"A\"]) if ctr[\"A\"] != 0 else 0.0,\n        \"ci_95\": [float(ci_low), float(ci_high)],\n        \"ci_method\": CI_METHOD,\n        \"srm_p\": srm_p,\n        \"srm_flag\": srm_flag,\n        \"decision\": decide(srm_flag, ci_low),\n    }\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\n    ap.add_argumen"]
[97.083009, "i", "t(\"--data\", required=True,\n                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\n    args = ap.parse_args(argv)\n    readout = build_readout(args.data)\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\n          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
