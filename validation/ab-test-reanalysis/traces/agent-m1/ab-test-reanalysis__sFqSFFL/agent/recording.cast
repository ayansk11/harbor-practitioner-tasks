[97.091147, "o", "    views = {arm: int(arms[arm][\"views\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[97.09119, "o", "\u001b[?2004h> "]
[97.091386, "o", "    clicks = {arm: int(arms[arm][\"clicks\"].sum()) for arm in ARMS}\r\n\u001b[?2004l\r"]
[97.091401, "o", "\u001b[?2004h> "]
[97.09159, "o", "    ctr = {arm: clicks[arm] / views[arm] for arm in ARMS}\r\n\u001b[?2004l\r"]
[97.09163, "o", "\u001b[?2004h"]
[97.091657, "o", "> "]
[97.091804, "o", "    diff, (ci_low, ci_high) = diff_ci(arms[\"A\"], arms[\"B\"])\r\n\u001b[?2004l\r"]
[97.091832, "o", "\u001b[?2004h"]
[97.091843, "o", "> "]
[97.091998, "o", "    srm_p = srm_pvalue(n_users[\"A\"], n_users[\"B\"])\r\n\u001b[?2004l\r"]
[97.092018, "o", "\u001b[?2004h> "]
[97.092147, "o", "    srm_flag = bool(srm_p < SRM_ALPHA)\r\n\u001b[?2004l\r"]
[97.092179, "o", "\u001b[?2004h"]
[97.092222, "o", "> "]
[97.092246, "o", "    return {\r\n\u001b[?2004l\r"]
[97.092268, "o", "\u001b[?2004h> "]
[97.092354, "o", "        \"experiment\": \"EXP-2291\",\r\n\u001b[?2004l\r"]
[97.09238, "o", "\u001b[?2004h> "]
[97.09247, "o", "        \"n_users\": n_users,\r\n\u001b[?2004l\r"]
[97.092486, "o", "\u001b[?2004h> "]
[97.092577, "o", "        \"pageviews\": views,\r\n"]
[97.092588, "o", "\u001b[?2004l\r"]
[97.092618, "o", "\u001b[?2004h> "]
[97.092695, "o", "        \"clicks\": clicks,\r\n\u001b[?2004l\r"]
[97.092726, "o", "\u001b[?2004h> "]
[97.092787, "o", "        \"ctr\": ctr,\r\n\u001b[?2004l\r"]
[97.092828, "o", "\u001b[?2004h> "]
[97.092915, "o", "        \"diff\": float(diff),\r\n\u001b[?2004l\r"]
[97.09294, "o", "\u001b[?2004h"]
[97.093447, "o", ">         \"rel_lift\": float(diff / ctr[\"A\"]) if ctr[\"A\"] != 0 else 0.0,\r\n\u001b[?2004l\r\u001b[?2004h>         \"ci_95\": [float(ci_low), float(ci_high)],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.093474, "o", "        \"ci_method\": CI_METHOD,\r\n\u001b[?2004l\r"]
[97.093485, "o", "\u001b[?2004h"]
[97.093547, "o", "> "]
[97.09358, "o", "        \"srm_p\": srm_p,\r\n\u001b[?2004l\r"]
[97.093614, "o", "\u001b[?2004h> "]
[97.093704, "o", "        \"srm_flag\": srm_flag,\r\n\u001b[?2004l\r"]
[97.093743, "o", "\u001b[?2004h> "]
[97.093874, "o", "        \"decision\": decide(srm_flag, ci_low),\r\n\u001b[?2004l\r"]
[97.09392, "o", "\u001b[?2004h> "]
[97.093932, "o", "    }"]
[97.093987, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.09401, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.094039, "o", "\u001b[?2004h> "]
[97.0941, "o", "def main(argv=None):\r\n\u001b[?2004l\r"]
[97.094143, "o", "\u001b[?2004h> "]
[97.094341, "o", "    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n\u001b[?2004l\r"]
[97.094378, "o", "\u001b[?2004h> "]
[97.094507, "o", "    ap.add_argument(\"--data\", required=True,\r\n\u001b[?2004l\r"]
[97.094537, "o", "\u001b[?2004h> "]
[97.094869, "o", "                    help=\"export folder: assignments, bot_flags, pageviews and module_clicks (.csv.gz)\")\r\n\u001b[?2004l\r"]
[97.094883, "o", "\u001b[?2004h"]
[97.094895, "o", "> "]
[97.095168, "o", "    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n\u001b[?2004l\r"]
[97.095206, "o", "\u001b[?2004h"]
[97.095229, "o", "> "]
[97.095939, "o", "    args = ap.parse_args(argv)\r\n\u001b[?2004l\r\u001b[?2004h>     readout = build_readout(args.data)\r\n\u001b[?2004l\r\u001b[?2004h>     out = Path(args.out)\r\n\u001b[?2004l\r\u001b[?2004h>     out.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>     out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n\u001b[?2004l\r"]
[97.095954, "o", "\u001b[?2004h> "]
[97.096216, "o", "    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} \"\r\n\u001b[?2004l\r"]
[97.096251, "o", "\u001b[?2004h> "]
[97.096551, "o", "          f\"ci=[{readout['ci_95'][0]:+.5f}, {readout['ci_95'][1]:+.5f}] srm_p={readout['srm_p']:.3g}\")\r\n\u001b[?2004l\r"]
[97.096564, "o", "\u001b[?2004h"]
[97.096573, "o", "> \r\n\u001b[?2004l\r"]
[97.097003, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.097044, "o", "\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[97.099928, "o", "\u001b[?2004hroot@47a5409d-3b7f-4859-aafa-80cf71d1d559:/app# "]
[97.77408, "i", "cd /app && python -m abtest.report --data data --out output/result.json\n"]
[97.774782, "o", "cd /app && python -m abtest.report --data data --out output/result.json\r\n\u001b[?2004l\r"]
[99.482819, "o", "wrote output/result.json: decision=no_ship diff=+0.00096 ci=[-0.00432, +0.00624] srm_p=0.469\r\n"]
[99.564052, "o", "\u001b[?2004hroot@47a5409d-3b7f-4859-aafa-80cf71d1d559:/app# "]
