[?2004l[?2004h>     var_b = pb * (1 - pb) / views_b if views_b else 0.0
[?2004l[?2004h>     se = math.sqrt(var_a + var_b)
[?2004l[?2004h>     z = norm.ppf(1 - alpha / 2)
[?2004l[?2004h>     ci_low = diff - z * se
[?2004l[?2004h>     ci_high = diff + z * se
[?2004l[?2004h>     return DiffTestResult(diff=diff, ci_low=ci_low, ci_high=ci_high, se=se)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def srm_chi2_test(n_users_a: int, n_users_b: int) -> Tuple[float, bool]:
[?2004l[?2004h>     """Compute SRM chi‑square p‑value and flag.
[?2004l[?2004h> 
[?2004l[?2004h>     No continuity correction; flag is true when p < 0.001.
[?2004l[?2004h>     """
[?2004l[?2004h>     total = n_users_a + n_users_b
[?2004l[?2004h>     if total == 0:
[?2004l[?2004h>         return 1.0, False
[?2004l[?2004h>     expected = total / 2.0
[?2004l[?2004h>     chi_sq = ((n_users_a - expected) ** 2 + (n_users_b - expected) ** 2) / expected
[?2004l[?2004h>     p = chi2.sf(chi_sq, df=1)
[?2004l[?2004h>     flag = p < 0.001
[?2004l[?2004h>     return p, flag
