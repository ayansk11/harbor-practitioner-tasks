[?2004l[?2004h> -    se = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)
[?2004l[?2004h> -    crit = norm.ppf(1 - alpha / 2)
[?2004l[?2004h> -    diff = pb - pa
[?2004l[?2004h> -    return ZTest(diff, diff - crit * se, diff + crit * se, z, p_value)
[?2004l[?2004h> +"""Statistical utilities for the AB‑test readout.
[?2004l[?2004h> +
[?2004l[?2004h> +The original implementation performed a pooled two‑proportion z‑test, which
[?2004l[?2004h> +treated each pageview as an independent trial. The analysis plan requires a
[?2004l[?2004h> +method that respects the fact that **users** are randomized. The delta method
[?2004l[?2004h> +applied to each arm’s click‑through‑rate (CTR) – treating the two arms as
[?2004l[?2004h> +independent – satisfies this requirement and is straightforward to implement.
[?2004l[?2004h> +
[?2004l[?2004h> +In addition, the plan mandates a sample‑ratio‑mismatch (SRM) chi‑square test.
[?2004l[?2004h> +Both utilities are provided below.
[?2004l[?2004h> +"""
[?2004l[?2004h> +
[?2004l[?2004h> +import math
[?2004l[?2004h> +from dataclasses import dataclass
[?2004l[?2004h> +from typing import Tuple
[?2004l[?2004h> +
[?2004l[?2004h> +from scipy.stats import norm, chi2
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +@dataclass
[?2004l[?2004h> +class DiffTestResult:
[?2004l[?2004h> +    """Result of the delta‑method comparison of two CTRs.
[?2004l[?2004h> +
[?2004l[?2004h> +    Attributes
[?2004l[?2004h> +    ----------
[?2004l[?2004h> +    diff: float
[?2004l[?2004h> +        ``CTR_B - CTR_A``.
[?2004l[?2004h> +    ci_low: float
[?2004l[?2004h> +        Lower bound of the two‑sided 95 % confidence interval.
[?2004l[?2004h> +    ci_high: float
[?2004l[?2004h> +        Upper bound of the 95 % confidence interval.
[?2004l[?2004h> +    se: float
[?2004l[?2004h> +        Standard error of the difference (used for diagnostics).
[?2004l[?2004h> +    """
[?2004l[?2004h> +
[?2004l[?2004h> +    diff: float
[?2004l[?2004h> +    ci_low: float
[?2004l[?2004h> +    ci_high: float
[?2004l[?2004h> +    se: float
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def delta_method_ctr_diff(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> DiffTestResult:
[?2004l[?2004h> +    """Compute the CTR difference and a delta‑method 95 % CI.
[?2004l[?2004h> +
[?2004l[?2004h> +    The variance of a ratio ``p = C / V`` (with ``C`` clicks and ``V`` views)
[?2004l[?2004h> +    under the assumption that clicks are binomial conditional on the total
[?2004l[?2004h> +    number of views is ``p(1‑p) / V``. Treating the two arms as independent, the
[?2004l[?2004h> +    variance of the difference is the sum of the arm variances.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    # Proportions
[?2004l[?2004h> +    pa = clicks_a / views_a if views_a else 0.0
[?2004l[?2004h> +    pb = clicks_b / views_b if views_b else 0.0
[?2004l[?2004h> +    diff = pb - pa
[?2004l[?2004h> +
[?2004l[?2004h> +    # Independent variances (delta method)
[?2004l[?2004h> +    var_a = pa * (1 - pa) / views_a if views_a else 0.0
[?2004l[?2004h> +    var_b = pb * (1 - pb) / views_b if views_b else 0.0
[?2004l[?2004h> +    se = math.sqrt(var_a + var_b)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Two‑sided critical value
[?2004l[?2004h> +    z = norm.ppf(1 - alpha / 2)
[?2004l[?2004h> +    ci_low = diff - z * se
[?2004l[?2004h> +    ci_high = diff + z * se
[?2004l[?2004h> +    return DiffTestResult(diff=diff, ci_low=ci_low, ci_high=ci_high, se=se)
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def srm_chi2_test(n_users_a: int, n_users_b: int) -> Tuple[float, bool]:
[?2004l[?2004h> +    """Return the SRM p‑value and a flag indicating a problematic split.
[?2004l[?2004h> +
[?2004l[?2004h> +    The null hypothesis is a 50/50 split. No continuity correction is applied,
[?2004l[?2004h> +    matching the specification in ``EXPERIMENT.md``.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    total = n_users_a + n_users_b
[?2004l[?2004h> +    if total == 0:
[?2004l[?2004h> +        return 1.0, False
[?2004l[?2004h> +    expected = total / 2.0
[?2004l[?2004h> +    chi_sq = ( (n_users_a - expected) ** 2 + (n_users_b - expected) ** 2 ) / expected
[?2004l[?2004h> +    p = chi2.sf(chi_sq, df=1)
[?2004l[?2004h> +    flag = p < 0.001
[?2004l[?2004h> +    return p, flag
[?2004l[?2004h> *** End Patch
[?2004l[?2004h> PATCH
