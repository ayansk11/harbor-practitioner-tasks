[?2004h> """Statistical utilities for the AB‑test readout.
[?2004l[?2004h> 
[?2004l[?2004h> The delta‑method is used for the CTR difference confidence interval, and a chi‑square
[?2004l[?2004h> test is used for the sample‑ratio‑mismatch (SRM) check, as required by EXPERIMENT.md.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import math
[?2004l[?2004h> from dataclasses import dataclass
[?2004l[?2004h> from typing import Tuple
[?2004l[?2004h> 
[?2004l[?2004h> from scipy.stats import norm, chi2
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass
[?2004l[?2004h> class DiffTestResult:
[?2004l[?2004h>     """Result of the delta‑method comparison of two CTRs.
[?2004l[?2004h> 
[?2004l[?2004h>     Attributes
[?2004l[?2004h>     ----------
[?2004l[?2004h>     diff: float
[?2004l[?2004h>         CTR_B - CTR_A.
[?2004l[?2004h>     ci_low: float
[?2004l[?2004h>         Lower bound of the two‑sided 95 % confidence interval.
[?2004l[?2004h>     ci_high: float
[?2004l[?2004h>         Upper bound of the 95 % confidence interval.
[?2004l[?2004h>     se: float
[?2004l[?2004h>         Standard error of the difference.
[?2004l[?2004h>     """
[?2004l[?2004h> 
[?2004l[?2004h>     diff: float
[?2004l[?2004h>     ci_low: float
[?2004l[?2004h>     ci_high: float
[?2004l[?2004h>     se: float
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def delta_method_ctr_diff(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> DiffTestResult:
[?2004l[?2004h>     """Compute CTR difference and 95 % CI using the delta method.
[?2004l[?2004h> 
[?2004l[?2004h>     Variance of a proportion p = C/V (binomial) is p(1‑p)/V. Assuming independence
[?2004l[?2004h>     between arms, the variance of the difference is the sum of the arm variances.
[?2004l[?2004h>     """
[?2004l[?2004h>     pa = clicks_a / views_a if views_a else 0.0
