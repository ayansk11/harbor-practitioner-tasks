[?2004l[?2004h>     ctr = {
[?2004l[?2004h>         arm: float(clicks[arm] / views[arm]) if views[arm] else 0.0
[?2004l[?2004h>         for arm in ("A", "B")
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     # Delta‑method confidence interval for diff
[?2004l[?2004h>     test = delta_method_ctr_diff(int(clicks["A"]), int(views["A"]), int(clicks["B"]), int(views["B"]))
[?2004l[?2004h> 
[?2004l[?2004h>     # SRM test
[?2004l[?2004h>     srm_p, srm_flag = srm_chi2_test(int(n_users["A"]), int(n_users["B"]))
