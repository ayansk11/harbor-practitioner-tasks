[?2004l[?2004h>     elif test.ci_low > 0:
[?2004l[?2004h>         decision = "ship"
[?2004l[?2004h>     else:
[?2004l[?2004h>         decision = "no_ship"
[?2004l[?2004h> 
[?2004l[?2004h>     return {
[?2004l[?2004h>         "n_users": {arm: int(n_users[arm]) for arm in ("A", "B")},
[?2004l[?2004h>         "pageviews": {arm: int(views[arm]) for arm in ("A", "B")},
[?2004l[?2004h>         "clicks": {arm: int(clicks[arm]) for arm in ("A", "B")},
[?2004l[?2004h>         "ctr": ctr,
[?2004l[?2004h>         "diff": float(test.diff),
[?2004l[?2004h>         "ci_95": [float(test.ci_low), float(test.ci_high)],
[?2004l[?2004h>         "srm_p": float(srm_p),
[?2004l[?2004h>         "srm_flag": bool(srm_flag),
[?2004l[?2004h>         "decision": decision,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main(argv=None):
[?2004l[?2004h>     ap = argparse.ArgumentParser(description="EXP-2291 CTR readout")
[?2004l[?2004h>     ap.add_argument("--data", required=True, help="folder with assignments.csv, users.csv, pageviews.csv")
[?2004l[?2004h>     ap.add_argument("--out", required=True, help="path of the result.json to write")
