[?2004lageview as an independent trial. The analysis plan requires a
+method that respects the fact that **users** are randomized. The delta method
+applied to each arm’s click‑through‑rate (CTR) – treating the two arms as
+independent – satisfies this requirement and is straightforward to implement.
+
+In addition, the plan mandates a sample‑ratio‑mismatch (SRM) chi‑square test.
+Both utilities are provided below.
+"""
+
+import math
+from dataclasses import dataclass
+from typing import Tuple
+
+from scipy.stats import norm, chi2
+
+
+@dataclass
+class DiffTestResult:
+    """Result of the delta‑method comparison of two CTRs.
+
+    Attributes
+    ----------
+    diff: float
+        ``CTR_B - CTR_A``.
+    ci_low: float
+        Lower bound of the two‑sided 95 % confidence interval.
+    ci_high: float
+        Upper bound of the 95 % confidence interval.
+    se: float
+        Standard error of the difference (used for diagnostics).
+    """
+
+    diff: float
+    ci_low: float
+    ci_high: float
+    se: float
+
+
+def delta_method_ctr_diff(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> DiffTestResult:
+    """Compute the CTR difference and a delta‑method 95 % CI.
+
+    The variance of a ratio ``p = C / V`` (with ``C`` clicks and ``V`` views)
+    under the assumption that clicks are binomial conditional on the total
+    number of views is ``p(1‑p) / V``. Treating the two arms as independent, the
+    variance of the difference is the sum of the arm variances.
+    """
+    # Proportions
+    pa = clicks_a / views_a if views_a else 0.0
+    pb = clicks_b / views_b if views_b else 0.0
+    diff = pb - pa
+
+    # Independent variances (delta method)
+    var_a = pa * (1 - pa) / views_a if views_a else 0.0
+    var_b = pb * (1 - pb) / views_b if views_b else 0.0
+    se = math.sqrt(var_a + var_b)
+
+    # Two‑sided critical value
+    z = norm.ppf(1 - alpha / 2)
+    ci_low = diff - z * se
+    ci_high = diff + z * se
+    return DiffTestResult(diff=diff, ci_low=ci_low, ci_high=ci_high, se=se)
+
+
+def srm_chi2_test(n_users_a: int, n_users_b: int) -> Tuple[float, bool]:
+    """Return the SRM p‑value and a flag indicating a problematic split.
+
+    The null hypothesis is a 50/50 split. No continuity correction is applied,
+    matching the specification in ``EXPERIMENT.md``.
+    """
+    total = n_users_a + n_users_b
+    if total == 0:
+        return 1.0, False
+    expected = total / 2.0
+    chi_sq = ( (n_users_a - expected) ** 2 + (n_users_b - expected) ** 2 ) / expected
+    p = chi2.sf(chi_sq, df=1)
+    flag = p < 0.001
+    return p, flag
