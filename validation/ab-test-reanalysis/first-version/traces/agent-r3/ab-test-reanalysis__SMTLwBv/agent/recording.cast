[46.086997, "o", "\u001b[?2004h> "]
[46.087323, "o", "+        Standard error of the difference (used for diagnostics).\r\n\u001b[?2004l\r"]
[46.087375, "o", "\u001b[?2004h"]
[46.087416, "o", "> +    \"\"\"\r\n\u001b[?2004l\r"]
[46.087449, "o", "\u001b[?2004h"]
[46.087475, "o", "> +\r\n\u001b[?2004l\r"]
[46.087501, "o", "\u001b[?2004h> "]
[46.087568, "o", "+    diff: float\r\n\u001b[?2004l\r"]
[46.087584, "o", "\u001b[?2004h"]
[46.087596, "o", "> "]
[46.08768, "o", "+    ci_low: float\r\n\u001b[?2004l\r"]
[46.087698, "o", "\u001b[?2004h"]
[46.087708, "o", "> "]
[46.087803, "o", "+    ci_high: float\r\n\u001b[?2004l\r"]
[46.087858, "o", "\u001b[?2004h> "]
[46.087894, "o", "+    se: float\r\n\u001b[?2004l\r"]
[46.087945, "o", "\u001b[?2004h> "]
[46.087973, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[46.088009, "o", "\u001b[?2004h> "]
[46.088475, "o", "+def delta_method_ctr_diff(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> DiffTestResult:\r\n\u001b[?2004l\r"]
[46.088495, "o", "\u001b[?2004h"]
[46.088506, "o", "> "]
[46.088789, "o", "+    \"\"\"Compute the CTR difference and a delta‑method 95 % CI.\r\n\u001b[?2004l\r"]
[46.088828, "o", "\u001b[?2004h"]
[46.088895, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.088918, "o", "> "]
[46.089219, "o", "+    The variance of a ratio ``p = C / V`` (with ``C`` clicks and ``V`` views)\r\n\u001b[?2004l\r"]
[46.089257, "o", "\u001b[?2004h> "]
[46.089527, "o", "+    under the assumption that clicks are binomial conditional on the total\r\n\u001b[?2004l\r"]
[46.089543, "o", "\u001b[?2004h"]
[46.089585, "o", "> "]
[46.089868, "o", "+    number of views is ``p(1‑p) / V``. Treating the two arms as independent, the\r\n\u001b[?2004l\r"]
[46.089885, "o", "\u001b[?2004h"]
[46.089894, "o", "> "]
[46.090181, "o", "+    variance of the difference is the sum of the arm variances.\r\n\u001b[?2004l\r"]
[46.090246, "o", "\u001b[?2004h"]
[46.090262, "o", "> +    \"\"\""]
[46.090272, "o", "\r\n\u001b[?2004l\r"]
[46.090315, "o", "\u001b[?2004h> "]
[46.090392, "o", "+    # Proportions\r\n\u001b[?2004l\r"]
[46.090411, "o", "\u001b[?2004h"]
[46.091128, "o", "> +    pa = clicks_a / views_a if views_a else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> +    pb = clicks_b / views_b if views_b else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> +    diff = pb - pa\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.091228, "o", "+    # Independent variances (delta method)\r\n\u001b[?2004l\r"]
[46.091279, "o", "\u001b[?2004h> "]
[46.091461, "o", "+    var_a = pa * (1 - pa) / views_a if views_a else 0.0\r\n\u001b[?2004l\r"]
[46.091532, "o", "\u001b[?2004h> "]
[46.091709, "o", "+    var_b = pb * (1 - pb) / views_b if views_b else 0.0\r\n\u001b[?2004l\r"]
[46.091751, "o", "\u001b[?2004h"]
[46.091793, "o", "> "]
[46.091908, "o", "+    se = math.sqrt(var_a + var_b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.091935, "o", "> "]
[46.091984, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.092138, "o", "+    # Two‑sided critical value\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.092187, "o", "> "]
[46.092285, "o", "+    z = norm.ppf(1 - alpha / 2)\r\n\u001b[?2004l\r"]
[46.09232, "o", "\u001b[?2004h"]
[46.09236, "o", "> "]
[46.092439, "o", "+    ci_low = diff - z * se\r\n\u001b[?2004l\r"]
[46.092473, "o", "\u001b[?2004h"]
[46.092504, "o", "> "]
[46.092603, "o", "+    ci_high = diff + z * se\r\n\u001b[?2004l\r"]
[46.092646, "o", "\u001b[?2004h> "]
[46.092923, "o", "+    return DiffTestResult(diff=diff, ci_low=ci_low, ci_high=ci_high, se=se)\r\n\u001b[?2004l\r"]
[46.092985, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[46.093029, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[46.093074, "o", "\u001b[?2004h> "]
[46.093385, "o", "+def srm_chi2_test(n_users_a: int, n_users_b: int) -> Tuple[float, bool]:\r\n\u001b[?2004l\r"]
[46.093446, "o", "\u001b[?2004h> "]
[46.093709, "o", "+    \"\"\"Return the SRM p‑value and a flag indicating a problematic split.\r\n\u001b[?2004l\r"]
[46.093747, "o", "\u001b[?2004h> "]
[46.093782, "o", "+\r\n\u001b[?2004l\r"]
[46.093814, "o", "\u001b[?2004h> "]
[46.094099, "o", "+    The null hypothesis is a 50/50 split. No continuity correction is applied,\r\n\u001b[?2004l\r"]
[46.09416, "o", "\u001b[?2004h"]
[46.094204, "o", "> "]
[46.094391, "o", "+    matching the specification in ``EXPERIMENT.md``.\r\n\u001b[?2004l\r"]
[46.094493, "o", "\u001b[?2004h> +    \"\"\"\r\n\u001b[?2004l\r"]
[46.094586, "o", "\u001b[?2004h> "]
[46.094692, "o", "+    total = n_users_a + n_users_b\r\n\u001b[?2004l\r"]
[46.094742, "o", "\u001b[?2004h> "]
[46.094848, "o", "+    if total == 0:\r\n\u001b[?2004l\r"]
[46.094862, "o", "\u001b[?2004h"]
[46.094872, "o", "> "]
[46.095057, "o", "+        return 1.0, False\r\n\u001b[?2004l\r"]
[46.095145, "o", "\u001b[?2004h> "]
[46.095201, "o", "+    expected = total / 2.0\r\n\u001b[?2004l\r"]
[46.095348, "o", "\u001b[?2004h> "]
[46.095587, "o", "+    chi_sq = ( (n_users_a - expected) ** 2 + (n_users_b - expected) ** 2 ) / expected\r\n\u001b[?2004l\r"]
[46.09564, "o", "\u001b[?2004h> "]
[46.095773, "o", "+    p = chi2.sf(chi_sq, df=1)\r\n\u001b[?2004l\r"]
[46.095826, "o", "\u001b[?2004h> "]
[46.095932, "o", "+    flag = p < 0.001\r\n\u001b[?2004l\r"]
[46.095962, "o", "\u001b[?2004h"]
[46.096, "o", "> "]
[46.096115, "o", "+    return p, flag\r\n\u001b[?2004l\r"]
[46.096131, "o", "\u001b[?2004h> "]
[46.09623, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[46.096298, "o", "\u001b[?2004h> "]
[46.096354, "o", "PATCH\r\n\u001b[?2004l\r"]
[46.096703, "o", "bash: apply_patch: command not found\r\n"]
[46.096946, "o", "\u001b[?2004h"]
[46.096997, "o", "root@fb8edb8a-40d5-4698-bc0a-fbf56d73f7e6:/app# "]
[47.070163, "i", "apply_patch <<'PATCH'\n*** Begin Patch: /app/abtest/report.py\n@@\n-from .stats import ctr_ztest\n+from .stats import delta_method_ctr_diff, srm_chi2_test\n@@\n-    test = ctr_ztest(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\n-    ctr = {arm: float(clicks[arm] / views[arm]) for arm in (\"A\", \"B\")}\n-\n-    decision = \"ship\" if (test.p_value < 0.05 and test.diff > 0) else \"no_ship\"\n-    return {\n-        \"experiment\": \"EXP-2291\",\n-        \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\n-        \"pageviews\": {arm: int(views[arm]) for arm in (\"A\", \"B\")},\n-        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\n-        \"ctr\": ctr,\n-        \"diff\": float(test.diff),\n-        \"rel_lift\": float(test.diff / ctr[\"A\"]),\n-        \"ci_95\": [float(test.ci_low), float(test.ci_high)],\n-        \"p_value\": float(test.p_value),\n-        \"decision\": decision,\n-    }\n+    # Compute CTR per arm\n+    ctr = {arm: float(clicks[arm] / views[arm]) if views[arm] else 0.0 for arm in (\"A\", \"B\")}\n+\n+ "]
[47.071614, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r\u001b[?2004h> *** Begin Patch: /app/abtest/report.py"]
[47.071686, "i", "   # Delta‑method confidence interval for the difference\n+    test = delta_method_ctr_diff(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\n+\n+    # Sample‑ratio‑mismatch test\n+    srm_p, srm_flag = srm_chi2_test(int(n_users[\"A\"]), int(n_users[\"B\"]))\n+\n+    # Decision rule from the plan (section 7)\n+    if srm_flag:\n+        decision = \"invalid\"\n+    elif test.ci_low > 0:\n+        decision = \"ship\"\n+    else:\n+        decision = \"no_ship\"\n+\n+    return {\n+        \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\n+        \"pageviews\": {arm: int(views[arm]) for arm in (\"A\", \"B\")},\n+        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\n+        \"ctr\": ctr,\n+        \"diff\": float(test.diff),\n+        \"ci_95\": [float(test.ci_low), float(test.ci_high)],\n+        \"srm_p\": float(srm_p),\n+        \"srm_flag\": bool(srm_flag),\n+        \"decision\": decision,\n+    }\n*** End Patch\nPATCH\n"]
