[47.079699, "o", "\u001b[?2004h"]
[47.079709, "o", "> "]
[47.080206, "o", "+    test = delta_method_ctr_diff(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\r\n\u001b[?2004l\r"]
[47.080274, "o", "\u001b[?2004h> "]
