[66.216236, "i", "cat > /app/abtest/filters.py <<'EOF'\n\"\"\"Population filters for the readout.\"\"\"\n\n\ndef exclude_bots(assignments, users):\n    \"\"\"Drop users flagged as bots from **both** arms.\n\n    The analysis plan requires that any user with ``is_bot == 1`` be excluded\n    regardless of the assigned variant.\n    \"\"\"\n    # Identify bot user_ids\n    flagged = set(users.loc[users[\"is_bot\"] == 1, \"user_id\"])\n    # Keep rows where the user_id is not a bot\n    keep = ~assignments[\"user_id\"].isin(flagged)\n    return assignments[keep].reset_index(drop=True)\nEOF\n"]
[66.216519, "o", "cat > /app/abtest/filters.py <<'EOF'\r\n\u001b[?2004l\r"]
[66.216983, "o", "\u001b[?2004h> \"\"\"Population filters for the readout.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.219201, "o", "def exclude_bots(assignments, users):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Drop users flagged as bots from **both** arms.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     The analysis plan requires that any user with ``is_bot == 1`` be excluded\r\n\u001b[?2004l\r\u001b[?2004h>     regardless of the assigned variant.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     # Identify bot user_ids\r\n\u001b[?2004l\r\u001b[?2004h>     flagged = set(users.loc[users[\"is_bot\"] == 1, \"user_id\"])\r\n\u001b[?2004l\r\u001b[?2004h>     # Keep rows where the user_id is not a bot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.219351, "o", "    keep = ~assignments[\"user_id\"].isin(flagged)\r\n\u001b[?2004l\r"]
[66.219386, "o", "\u001b[?2004h"]
[66.219401, "o", "> "]
[66.219762, "o", "    return assignments[keep].reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.219854, "o", "EOF\r\n\u001b[?2004l\r"]
[66.221629, "o", "\u001b[?2004h"]
[66.221738, "o", "root@fb8edb8a-40d5-4698-bc0a-fbf56d73f7e6:/app# "]
[66.873775, "i", "cat > /app/abtest/stats.py <<'EOF'\n\"\"\"Statistical utilities for the AB‑test readout.\n\nThe delta‑method is used for the CTR difference confidence interval, and a chi‑square\ntest is used for the sample‑ratio‑mismatch (SRM) check, as required by EXPERIMENT.md.\n\"\"\"\n\nimport math\nfrom dataclasses import dataclass\nfrom typing import Tuple\n\nfrom scipy.stats import norm, chi2\n\n\n@dataclass\nclass DiffTestResult:\n    \"\"\"Result of the delta‑method comparison of two CTRs.\n\n    Attributes\n    ----------\n    diff: float\n        CTR_B - CTR_A.\n    ci_low: float\n        Lower bound of the two‑sided 95 % confidence interval.\n    ci_high: float\n        Upper bound of the 95 % confidence interval.\n    se: float\n        Standard error of the difference.\n    \"\"\"\n\n    diff: float\n    ci_low: float\n    ci_high: float\n    se: float\n\n\ndef delta_method_ctr_diff(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> DiffTestResult:\n    \"\"\"Compute CTR difference and 95 % CI using the delta me"]
[66.874137, "i", "thod.\n\n    Variance of a proportion p = C/V (binomial) is p(1‑p)/V. Assuming independence\n    between arms, the variance of the difference is the sum of the arm variances.\n    \"\"\"\n    pa = clicks_a / views_a if views_a else 0.0\n    pb = clicks_b / views_b if views_b else 0.0\n    diff = pb - pa\n    var_a = pa * (1 - pa) / views_a if views_a else 0.0\n    var_b = pb * (1 - pb) / views_b if views_b else 0.0\n    se = math.sqrt(var_a + var_b)\n    z = norm.ppf(1 - alpha / 2)\n    ci_low = diff - z * se\n    ci_high = diff + z * se\n    return DiffTestResult(diff=diff, ci_low=ci_low, ci_high=ci_high, se=se)\n\n\ndef srm_chi2_test(n_users_a: int, n_users_b: int) -> Tuple[float, bool]:\n    \"\"\"Compute SRM chi‑square p‑value and flag.\n\n    No continuity correction; flag is true when p < 0.001.\n    \"\"\"\n    total = n_users_a + n_users_b\n    if total == 0:\n        return 1.0, False\n    expected = total / 2.0\n    chi_sq = ((n_users_a - expected) ** 2 + (n_users_b - expected) ** 2) / expected\n    p = chi2.sf(chi_sq, df=1)\n   "]
[66.874162, "o", "cat > /app/abtest/stats.py <<'EOF'\r\n\u001b[?2004l\r"]
[66.874171, "i", " flag = p < 0.001\n    return p, flag\nEOF\n"]
[66.87431, "o", " flag = p < 0.001\r\n    return p, flag\r\nEOF\r\n"]
