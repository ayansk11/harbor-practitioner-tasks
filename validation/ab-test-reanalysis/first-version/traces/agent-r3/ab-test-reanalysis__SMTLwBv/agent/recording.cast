[18.900036, "o", "\u001b[?2004l\r"]
[18.901629, "o", "\"\"\"Read the experiment export: assignments.csv, users.csv and pageviews.csv in one folder.\"\"\"\r\nfrom pathlib import Path\r\n\r\nimport pandas as pd\r\n\r\n\r\ndef _instants(col):\r\n    # The export mixes \"Z\" and \"+hh:mm\" / \"-hh:mm\" offsets. Parse to UTC so we compare instants, never strings.\r\n    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n\r\n\r\ndef load_assignments(data_dir):\r\n    \"\"\"One row per assigned user: user_id, variant (\"A\" or \"B\"), assigned_at (UTC).\"\"\"\r\n    df = pd.read_csv(Path(data_dir) / \"assignments.csv\", dtype=str)\r\n    df = df.drop_duplicates()  # the assignment logger retries; an exact repeat of a row counts once\r\n    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\r\n    return df.reset_index(drop=True)\r\n\r\n\r\ndef load_users(data_dir):\r\n    \"\"\"user_id, is_bot (1 = flagged by the bot-detection job).\"\"\"\r\n    df = pd.read_csv(Path(data_dir) / \"users.csv\", dtype={\"user_id\": str, \"is_bot\": \"int64\"})\r\n    return df\r\n\r\n\r\ndef load_pageviews(data_dir, assignments):\r\n    \"\"\"Pageviews of the given assigned"]
[18.901887, "o", " users, on or after their assignment time, with the user's variant attached.\"\"\"\r\n    pv = pd.read_csv(Path(data_dir) / \"pageviews.csv\", dtype={\"user_id\": str, \"ts\": str, \"clicked\": \"int64\"})\r\n    pv[\"ts\"] = _instants(pv[\"ts\"])\r\n    pv = pv.merge(assignments[[\"user_id\", \"variant\", \"assigned_at\"]], on=\"user_id\", how=\"inner\")\r\n    pv = pv[pv[\"ts\"] >= pv[\"assigned_at\"]]  # exposure before assignment is not part of the experiment\r\n    return pv.reset_index(drop=True)\r\n"]
[18.902039, "o", "\u001b[?2004h"]
[18.902138, "o", "root@fb8edb8a-40d5-4698-bc0a-fbf56d73f7e6:/app# "]
[19.609245, "i", "sed -n '1,200p' /app/abtest/filters.py\n"]
[19.609591, "o", "sed -n '1,200p' /app/abtest/filters.py"]
[19.61014, "o", "\r\n\u001b[?2004l\r"]
[19.612229, "o", "\"\"\"Population filters for the readout.\"\"\"\r\n\r\n\r\ndef exclude_bots(assignments, users):\r\n    \"\"\"Drop users flagged as bots (EXPERIMENT.md, Population).\"\"\"\r\n    flagged = set(users.loc[users[\"is_bot\"] == 1, \"user_id\"])\r\n    # INC-4471: the crawler spike came in with the new B module's tracking, so the bot filter targets B traffic.\r\n    in_b = assignments[\"variant\"] == \"B\"\r\n    keep = ~(in_b & assignments[\"user_id\"].isin(flagged))\r\n    return assignments[keep].reset_index(drop=True)\r\n"]
[19.612396, "o", "\u001b[?2004hroot@fb8edb8a-40d5-4698-bc0a-fbf56d73f7e6:/app# "]
[20.142179, "i", "sed -n '1,200p' /app/abtest/stats.py\n"]
[20.147135, "o", "sed -n '1,200p' /app/abtest/stats.py\r\n\u001b[?2004l\r"]
[20.152121, "o", "\"\"\"Significance test for the CTR readout.\"\"\"\r\nimport math\r\nfrom dataclasses import dataclass\r\n\r\nfrom scipy.stats import norm\r\n\r\n\r\n@dataclass\r\nclass ZTest:\r\n"]
[20.152305, "o", "    diff: float\r\n    ci_low: float\r\n    ci_high: float\r\n    z: float\r\n    p_value: float\r\n\r\n\r\ndef ctr_ztest(clicks_a, views_a, clicks_b, views_b, alpha=0.05):\r\n    \"\"\"Two-proportion z-test of CTR B vs A, with each pageview as a trial.\"\"\"\r\n    pa = clicks_a / views_a\r\n    pb = clicks_b / views_b\r\n    pooled = (clicks_a + clicks_b) / (views_a + views_b)\r\n    se_pooled = math.sqrt(pooled * (1 - pooled) * (1 / views_a + 1 / views_b))\r\n    z = (pb - pa) / se_pooled\r\n    p_value = 2 * norm.sf(abs(z))\r\n    se = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)\r\n    crit = norm.ppf(1 - alpha / 2)\r\n    diff = pb - pa\r\n    return ZTest(diff, diff - crit * se, diff + crit * se, z, p_value)\r\n"]
[20.152537, "o", "\u001b[?2004hroot@fb8edb8a-40d5-4698-bc0a-fbf56d73f7e6:/app# "]
[20.787054, "i", "sed -n '1,200p' /app/abtest/report.py\n"]
[20.787614, "o", "sed -n '1,200p' /app/abtest/report.py"]
[20.787719, "o", "\r\n"]
[20.787812, "o", "\u001b[?2004l\r"]
[20.790059, "o", "\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\nimport argparse\r\nimport json\r\nfrom pathlib import Path\r\n\r\nfrom .filters import exclude_bots\r\nfrom .load import load_assignments, load_pageviews, load_users\r\nfrom .stats import ctr_ztest\r\n\r\n\r\ndef build_readout(data_dir):\r\n    assignments = load_assignments(data_dir)\r\n    users = load_users(data_dir)\r\n    assignments = exclude_bots(assignments, users)\r\n    pageviews = load_pageviews(data_dir, assignments)\r\n\r\n    n_users = assignments.groupby(\"variant\")[\"user_id\"].nunique()\r\n    views = pageviews.groupby(\"variant\").size()\r\n    clicks = pageviews.groupby(\"variant\")[\"clicked\"].sum()\r\n"]
[20.790216, "o", "    test = ctr_ztest(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\r\n    ctr = {arm: float(clicks[arm] / views[arm]) for arm in (\"A\", \"B\")}\r\n\r\n    decision = \"ship\" if (test.p_value < 0.05 and test.diff > 0) else \"no_ship\"\r\n    return {\r\n        \"experiment\": \"EXP-2291\",\r\n        \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\r\n        \"pageviews\": {arm: int(views[arm]) for arm in (\"A\", \"B\")},\r\n        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\r\n        \"ctr\": ctr,\r\n"]
[20.79024, "o", "        \"diff\": float(test.diff),\r\n        \"rel_lift\": float(test.diff / ctr[\"A\"]),\r\n        \"ci_95\": [float(test.ci_low), float(test.ci_high)],\r\n        \"p_value\": float(test.p_value),\r\n        \"decision\": decision,\r\n    }\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n    ap.add_argument(\"--data\", required=True, help=\"folder with assignments.csv, users.csv, pageviews.csv\")\r\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n    args = ap.parse_args(argv)\r\n    readout = build_readout(args.data)\r\n    out = Path(args.out)\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} p={readout['p_value']:.2g}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[20.79053, "o", "\u001b[?2004h"]
[20.790663, "o", "root@fb8edb8a-40d5-4698-bc0a-fbf56d73f7e6:/app# "]
[45.074018, "i", "apply_patch <<'PATCH'\n*** Begin Patch: /app/abtest/filters.py\n@@\n-def exclude_bots(assignments, users):\n-    \"\"\"Drop users flagged as bots (EXPERIMENT.md, Population).\"\"\"\n-    flagged = set(users.loc[users[\"is_bot\"] == 1, \"user_id\"])\n-    # INC-4471: the crawler spike came in with the new B module's tracking, so the bot filter targets B traffic.\n-    in_b = assignments[\"variant\"] == \"B\"\n-    keep = ~(in_b & assignments[\"user_id\"].isin(flagged))\n-    return assignments[keep].reset_index(drop=True)\n+def exclude_bots(assignments, users):\n+    \"\"\"Drop users flagged as bots from **both** arms.\n+\n+    The original implementation only excluded bots in arm B, which violates the\n+    population definition in ``EXPERIMENT.md`` where bots are excluded from the\n+    analysis entirely. The fix is straightforward: identify all user_ids with\n+    ``is_bot == 1`` and remove any assignment rows that reference those users,\n+    regardless of the variant.\n+    \"\"\"\n+    # Identify bot user_ids\n+    flagged = set(users.loc[users["]
[45.074166, "i", "\"is_bot\"] == 1, \"user_id\"])\n+    # Keep rows where the user_id is not a bot\n+    keep = ~assignments[\"user_id\"].isin(flagged)\n+    return assignments[keep].reset_index(drop=True)\n*** End Patch\nPATCH\n"]
