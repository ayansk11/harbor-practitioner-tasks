[67.45366, "o", "    # SRM test\r\n"]
[67.453687, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.454042, "o", "    srm_p, srm_flag = srm_chi2_test(int(n_users[\"A\"]), int(n_users[\"B\"]))\r\n\u001b[?2004l\r"]
[67.454111, "o", "\u001b[?2004h"]
[67.4542, "o", "> \r\n\u001b[?2004l\r"]
[67.454254, "o", "\u001b[?2004h> "]
[67.454377, "o", "    # Decision rule (section 7 of the plan)\r\n\u001b[?2004l\r"]
[67.454415, "o", "\u001b[?2004h"]
[67.454462, "o", "> "]
[67.454521, "o", "    if srm_flag:\r\n\u001b[?2004l\r"]
[67.454556, "o", "\u001b[?2004h"]
[67.454623, "o", "> "]
[67.45471, "o", "        decision = \"invalid\"\r\n\u001b[?2004l\r"]
[67.454758, "o", "\u001b[?2004h> "]
[67.454896, "o", "    elif test.ci_low > 0:\r\n"]
[67.454925, "o", "\u001b[?2004l\r"]
[67.454941, "o", "\u001b[?2004h"]
[67.454978, "o", "> "]
[67.455072, "o", "        decision = \"ship\"\r\n\u001b[?2004l\r"]
[67.455154, "o", "\u001b[?2004h> "]
[67.455228, "o", "    else:\r\n\u001b[?2004l\r"]
[67.45615, "o", "\u001b[?2004h>         decision = \"no_ship\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h>         \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.457343, "o", "        \"pageviews\": {arm: int(views[arm]) for arm in (\"A\", \"B\")},\r\n\u001b[?2004l\r"]
[67.457459, "o", "\u001b[?2004h> "]
[67.457719, "o", "        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\r\n\u001b[?2004l\r"]
[67.457759, "o", "\u001b[?2004h> "]
[67.457865, "o", "        \"ctr\": ctr,\r\n\u001b[?2004l\r"]
[67.457899, "o", "\u001b[?2004h"]
[67.457939, "o", "> "]
[67.458104, "o", "        \"diff\": float(test.diff),\r\n\u001b[?2004l\r"]
[67.458143, "o", "\u001b[?2004h"]
[67.458169, "o", "> "]
[67.458473, "o", "        \"ci_95\": [float(test.ci_low), float(test.ci_high)],\r\n"]
[67.458528, "o", "\u001b[?2004l\r"]
[67.458545, "o", "\u001b[?2004h> "]
[67.458681, "o", "        \"srm_p\": float(srm_p),\r\n\u001b[?2004l\r"]
[67.458721, "o", "\u001b[?2004h> "]
[67.458907, "o", "        \"srm_flag\": bool(srm_flag),\r\n\u001b[?2004l\r"]
[67.458961, "o", "\u001b[?2004h> "]
[67.459136, "o", "        \"decision\": decision,\r\n\u001b[?2004l\r"]
[67.459157, "o", "\u001b[?2004h"]
[67.459167, "o", "> "]
[67.459212, "o", "    }\r\n\u001b[?2004l\r"]
[67.45926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.460127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main(argv=None):\r\n\u001b[?2004l\r\u001b[?2004h>     ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.460452, "o", "    ap.add_argument(\"--data\", required=True, help=\"folder with assignments.csv, users.csv, pageviews.csv\")\r\n\u001b[?2004l\r"]
[67.460504, "o", "\u001b[?2004h"]
[67.460541, "o", "> "]
[67.460927, "o", "    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\r\n\u001b[?2004l\r"]
[67.46096, "o", "\u001b[?2004h"]
[67.460973, "o", "> "]
[67.461138, "o", "    args = ap.parse_args(argv)\r\n\u001b[?2004l\r"]
[67.461195, "o", "\u001b[?2004h"]
[67.462052, "o", ">     readout = build_readout(args.data)\r\n\u001b[?2004l\r\u001b[?2004h>     out = Path(args.out)\r\n\u001b[?2004l\r\u001b[?2004h>     out.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.462192, "o", "    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\r\n"]
[67.463122, "o", "\u001b[?2004l\r"]
[67.463146, "o", "\u001b[?2004h>     print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
[67.463202, "o", "\u001b[?2004l\r"]
[67.464913, "o", "\u001b[?2004h"]
[67.464982, "o", "root@fb8edb8a-40d5-4698-bc0a-fbf56d73f7e6:/app# "]
[67.992637, "i", "python -m abtest.report --data data --out output/result.json\n"]
[67.993048, "o", "python -m abtest.report --data data --out output/result.json"]
[67.993143, "o", "\r\n\u001b[?2004l\r"]
[70.093613, "o", "wrote output/result.json: decision=no_ship diff=-0.00040\r\n"]
[70.184119, "i", "cat /app/output/result.json\n"]
[70.18426, "o", "cat /app/output/result.json\r\n"]
[70.233513, "o", "\u001b[?2004hroot@fb8edb8a-40d5-4698-bc0a-fbf56d73f7e6:/app# "]
[70.233636, "o", "cat /app/output/result.json\r\n\u001b[?2004l\r"]
[70.235196, "o", "{\r\n  \"n_users\": {\r\n    \"A\": 19612,\r\n    \"B\": 19518\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 189582,\r\n    \"B\": 186115\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 15041,\r\n    \"B\": 14691\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.07933770083657732,\r\n    \"B\": 0.07893506702845016\r\n  },\r\n  \"diff\": -0.0004026338081271619,\r\n  \"ci_95\": [\r\n    -0.0021291024453417994,\r\n    0.0013238348290874756\r\n  ],\r\n  \"srm_p\": 0.6346471582944933,\r\n  \"srm_flag\": false,\r\n  \"decision\": \"no_ship\"\r\n}\r\n"]
