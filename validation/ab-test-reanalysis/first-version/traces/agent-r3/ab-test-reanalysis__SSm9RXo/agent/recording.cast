[58.767284, "i", "cat > abtest/stats.py <<'EOF'\n\"\"\"Significance test for the CTR readout.\"\"\"\nimport math\nfrom dataclasses import dataclass\nfrom typing import Tuple\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import chi2, norm\n\n\n@dataclass\nclass ZTest:\n    diff: float\n    ci_low: float\n    ci_high: float\n    z: float\n    p_value: float\n\n\ndef ctr_ztest(clicks_a, views_a, clicks_b, views_b, alpha=0.05):\n    \"\"\"Two‑proportion z‑test of CTR B vs A, with each pageview as a trial.\n    This function is retained for backward compatibility but is NOT used in the\n    official readout because it treats pageviews as independent.\n    \"\"\"\n    pa = clicks_a / views_a\n    pb = clicks_b / views_b\n    pooled = (clicks_a + clicks_b) / (views_a + views_b)\n    se_pooled = math.sqrt(pooled * (1 - pooled) * (1 / views_a + 1 / views_b))\n    z = (pb - pa) / se_pooled\n    p_value = 2 * norm.sf(abs(z))\n    se = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)\n    crit = norm.ppf(1 - alpha / 2)\n    diff = pb - pa\n    return ZT"]
[58.767416, "i", "est(diff, diff - crit * se, diff + crit * se, z, p_value)\n\n\ndef _user_aggregates(pageviews: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Return a DataFrame with columns: variant, user_id, clicks, views.\n    Each row aggregates a single user's pageviews within an arm.\n    \"\"\"\n    agg = (\n        pageviews.groupby([\"variant\", \"user_id\"])\n        .agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\n        .reset_index()\n    )\n    return agg\n\n\ndef bootstrap_ci(pageviews: pd.DataFrame, n_resamples: int = 2000, alpha: float = 0.05) -> Tuple[float, float, float]:\n    \"\"\"User‑level bootstrap for the difference in CTR between B and A.\n\n    Parameters\n    ----------\n    pageviews: pd.DataFrame\n        The filtered pageviews with columns `variant`, `user_id`, `clicked`.\n    n_resamples: int\n        Number of bootstrap resamples (default 2000).\n    alpha: float\n        Significance level for the confidence interval (default 0.05 for 95% CI).\n\n    Returns\n    -------\n    diff: float\n        Observed difference (CTR_B - "]
[58.767456, "i", "CTR_A).\n    ci_low: float\n        Lower bound of the percentile CI.\n    ci_high: float\n        Upper bound of the percentile CI.\n    \"\"\"\n    agg = _user_aggregates(pageviews)\n    # Separate arms\n    arm_a = agg[agg[\"variant\"] == \"A\"]\n    arm_b = agg[agg[\"variant\"] == \"B\"]\n    # Observed CTRs and diff\n    clicks_a = arm_a[\"clicks\"].sum()\n    views_a = arm_a[\"views\"].sum()\n    clicks_b = arm_b[\"clicks\"].sum()\n    views_b = arm_b[\"views\"].sum()\n    ctr_a = clicks_a / views_a if views_a > 0 else 0.0\n    ctr_b = clicks_b / views_b if views_b > 0 else 0.0\n    diff_obs = ctr_b - ctr_a\n\n    # Prepare arrays for fast resampling\n    a_clicks = arm_a[\"clicks\"].values\n    a_views = arm_a[\"views\"].values\n    b_clicks = arm_b[\"clicks\"].values\n    b_views = arm_b[\"views\"].values\n    n_a = len(a_clicks)\n    n_b = len(b_clicks)\n\n    diffs = np.empty(n_resamples)\n    rng = np.random.default_rng()\n    for i in range(n_resamples):\n        # Sample users with replacement within each arm\n        idx_a = rng.integers(0, n_a, n_a)\n "]
[58.767663, "o", "cat > abtest/stats.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.767675, "i", "       idx_b = rng.integers(0, n_b, n_b)\n        samp_clicks_a = a_clicks[idx_a].sum()\n        samp_views_a = a_views[idx_a].sum()\n        samp_clicks_b = b_clicks[idx_b].sum()\n        samp_views_b = b_views[idx_b].sum()\n        ctr_a_boot = samp_clicks_a / samp_views_a if samp_views_a > 0 else 0.0\n        ctr_b_boot = samp_clicks_b / samp_views_b if samp_views_b > 0 else 0.0\n        diffs[i] = ctr_b_boot - ctr_a_boot\n\n    lower = np.percentile(diffs, 100 * alpha / 2)\n    upper = np.percentile(diffs, 100 * (1 - alpha / 2))\n    return diff_obs, lower, upper\n\n\ndef srm_chi2_pvalue(n_users: dict) -> Tuple[float, bool]:\n    \"\"\"Compute Pearson chi‑square p‑value for sample‑ratio mismatch.\n    Returns (p_value, flag) where flag is True if p < 0.001.\n    \"\"\"\n    total = n_users.get(\"A\", 0) + n_users.get(\"B\", 0)\n    expected = total / 2.0\n    chi_sq = ((n_users.get(\"A\", 0) - expected) ** 2 + (n_users.get(\"B\", 0) - expected) ** 2) / expected\n    p = chi2.sf(chi_sq, df=1)\n    flag = p < 0.001\n    return p, flag\nEO"]
[58.767733, "i", "F\n"]
[58.767746, "o", "\"\"\"Significance test for the CTR readout.\"\"\"\r\n\u001b[?2004l\r"]
[58.767781, "o", "\u001b[?2004h"]
[58.767802, "o", "> "]
[58.76788, "o", "import math\r\n\u001b[?2004l\r"]
[58.767932, "o", "\u001b[?2004h> "]
[58.768275, "o", "from dataclasses import dataclass\r\n\u001b[?2004l\r\u001b[?2004h> from typing import Tuple\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.768392, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[58.76845, "o", "\u001b[?2004h> "]
[58.768602, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.769374, "o", "from scipy.stats import chi2, norm\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @dataclass\r\n\u001b[?2004l\r\u001b[?2004h> class ZTest:\r\n\u001b[?2004l\r\u001b[?2004h>     diff: float\r\n\u001b[?2004l\r\u001b[?2004h>     ci_low: float\r\n\u001b[?2004l\r\u001b[?2004h>     ci_high: float\r\n\u001b[?2004l\r\u001b[?2004h>     z: float\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.769424, "o", "    p_value: float\r\n\u001b[?2004l\r"]
[58.769464, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.769545, "o", "\u001b[?2004h"]
[58.769601, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.769803, "o", "def ctr_ztest(clicks_a, views_a, clicks_b, views_b, alpha=0.05):\r\n\u001b[?2004l\r"]
[58.769846, "o", "\u001b[?2004h> "]
[58.770231, "o", "    \"\"\"Two‑proportion z‑test of CTR B vs A, with each pageview as a trial.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.770491, "o", "    This function is retained for backward compatibility but is NOT used in the\r\n\u001b[?2004l\r"]
[58.771053, "o", "\u001b[?2004h>     official readout because it treats pageviews as independent.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     pa = clicks_a / views_a\r\n\u001b[?2004l\r"]
[58.771089, "o", "\u001b[?2004h> "]
[58.771217, "o", "    pb = clicks_b / views_b\r\n\u001b[?2004l\r"]
[58.771268, "o", "\u001b[?2004h> "]
[58.771487, "o", "    pooled = (clicks_a + clicks_b) / (views_a + views_b)\r\n"]
[58.771519, "o", "\u001b[?2004l\r"]
[58.771533, "o", "\u001b[?2004h> "]
[58.77186, "o", "    se_pooled = math.sqrt(pooled * (1 - pooled) * (1 / views_a + 1 / views_b))\r\n\u001b[?2004l\r"]
[58.771934, "o", "\u001b[?2004h> "]
[58.772037, "o", "    z = (pb - pa) / se_pooled\r\n"]
[58.772052, "o", "\u001b[?2004l\r"]
[58.772061, "o", "\u001b[?2004h"]
[58.772078, "o", "> "]
[58.772243, "o", "    p_value = 2 * norm.sf(abs(z))\r\n\u001b[?2004l\r"]
[58.77229, "o", "\u001b[?2004h> "]
[58.772557, "o", "    se = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)\r\n\u001b[?2004l\r"]
[58.772606, "o", "\u001b[?2004h> "]
[58.772732, "o", "    crit = norm.ppf(1 - alpha / 2)\r\n\u001b[?2004l\r"]
[58.772772, "o", "\u001b[?2004h> "]
[58.772858, "o", "    diff = pb - pa\r\n\u001b[?2004l\r"]
[58.772882, "o", "\u001b[?2004h"]
[58.772891, "o", "> "]
[58.773162, "o", "    return ZTest(diff, diff - crit * se, diff + crit * se, z, p_value)\r\n\u001b[?2004l\r"]
[58.773204, "o", "\u001b[?2004h"]
[58.773217, "o", "> \r\n\u001b[?2004l\r"]
[58.773258, "o", "\u001b[?2004h"]
[58.773271, "o", "> \r\n\u001b[?2004l\r"]
[58.773293, "o", "\u001b[?2004h"]
[58.773324, "o", "> "]
[58.773563, "o", "def _user_aggregates(pageviews: pd.DataFrame) -> pd.DataFrame:\r\n\u001b[?2004l\r"]
[58.773578, "o", "\u001b[?2004h"]
[58.773594, "o", "> "]
[58.773851, "o", "    \"\"\"Return a DataFrame with columns: variant, user_id, clicks, views.\r\n\u001b[?2004l\r"]
[58.773904, "o", "\u001b[?2004h> "]
[58.774158, "o", "    Each row aggregates a single user's pageviews within an arm.\r\n\u001b[?2004l\r"]
[58.774202, "o", "\u001b[?2004h> "]
[58.774241, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[58.774276, "o", "\u001b[?2004h"]
[58.77431, "o", "> "]
[58.775383, "o", "    agg = (\r\n\u001b[?2004l\r"]
[58.775431, "o", "\u001b[?2004h> "]
[58.775592, "o", "        pageviews.groupby([\"variant\", \"user_id\"])\r\n\u001b[?2004l\r"]
[58.775614, "o", "\u001b[?2004h"]
[58.77563, "o", "> "]
[58.775875, "o", "        .agg(clicks=(\"clicked\", \"sum\"), views=(\"clicked\", \"size\"))\r\n\u001b[?2004l\r"]
[58.775895, "o", "\u001b[?2004h"]
[58.775913, "o", "> "]
[58.775992, "o", "        .reset_index()\r\n\u001b[?2004l\r"]
[58.776015, "o", "\u001b[?2004h"]
[58.776035, "o", "> "]
[58.776053, "o", "    )\r\n\u001b[?2004l\r"]
[58.776078, "o", "\u001b[?2004h"]
[58.77609, "o", "> "]
[58.776144, "o", "    return agg\r\n\u001b[?2004l\r"]
[58.776168, "o", "\u001b[?2004h"]
[58.776187, "o", "> \r\n\u001b[?2004l\r"]
[58.77621, "o", "\u001b[?2004h"]
[58.776223, "o", "> \r\n\u001b[?2004l\r"]
[58.776242, "o", "\u001b[?2004h"]
[58.776257, "o", "> "]
[58.776732, "o", "def bootstrap_ci(pageviews: pd.DataFrame, n_resamples: int = 2000, alpha: float = 0.05) -> Tuple[float, float, float]:\r\n\u001b[?2004l\r"]
[58.776747, "o", "\u001b[?2004h"]
[58.776807, "o", "> "]
[58.777032, "o", "    \"\"\"User‑level bootstrap for the difference in CTR between B and A.\r\n\u001b[?2004l\r"]
[58.77707, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.777125, "o", "\u001b[?2004h> "]
[58.777177, "o", "    Parameters\r\n\u001b[?2004l\r"]
[58.777211, "o", "\u001b[?2004h> "]
[58.777262, "o", "    ----------\r\n\u001b[?2004l\r"]
[58.777293, "o", "\u001b[?2004h> "]
[58.777397, "o", "    pageviews: pd.DataFrame\r\n\u001b[?2004l\r"]
[58.777431, "o", "\u001b[?2004h> "]
[58.777709, "o", "        The filtered pageviews with columns `variant`, `user_id`, `clicked`.\r\n\u001b[?2004l\r"]
[58.777743, "o", "\u001b[?2004h"]
[58.777764, "o", "> "]
[58.777822, "o", "    n_resamples: int\r\n\u001b[?2004l\r"]
[58.777864, "o", "\u001b[?2004h> "]
[58.778055, "o", "        Number of bootstrap resamples (default 2000).\r\n\u001b[?2004l\r"]
[58.778081, "o", "\u001b[?2004h"]
[58.778122, "o", "> "]
[58.778187, "o", "    alpha: float\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.778199, "o", "> "]
[58.778492, "o", "        Significance level for the confidence interval (default 0.05 for 95% CI).\r\n\u001b[?2004l\r"]
[58.778533, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.778563, "o", "\u001b[?2004h> "]
[58.778617, "o", "    Returns\r\n\u001b[?2004l\r"]
[58.778657, "o", "\u001b[?2004h> "]
[58.778705, "o", "    -------\r\n\u001b[?2004l\r"]
[58.778737, "o", "\u001b[?2004h> "]
[58.778796, "o", "    diff: float\r\n\u001b[?2004l\r"]
[58.778822, "o", "\u001b[?2004h"]
[58.778857, "o", "> "]
[58.778997, "o", "        Observed difference (CTR_B - CTR_A).\r\n\u001b[?2004l\r"]
[58.779043, "o", "\u001b[?2004h> "]
[58.779094, "o", "    ci_low: float\r\n\u001b[?2004l\r"]
[58.779137, "o", "\u001b[?2004h> "]
[58.779478, "o", "        Lower bound of the percentile CI.\r\n\u001b[?2004l\r"]
[58.779503, "o", "\u001b[?2004h"]
[58.779541, "o", "> "]
[58.779591, "o", "    ci_high: float\r\n\u001b[?2004l\r"]
[58.77962, "o", "\u001b[?2004h"]
[58.77964, "o", "> "]
[58.779783, "o", "        Upper bound of the percentile CI.\r\n"]
[58.779807, "o", "\u001b[?2004l\r"]
[58.779829, "o", "\u001b[?2004h> "]
[58.779853, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[58.779882, "o", "\u001b[?2004h"]
[58.779902, "o", "> "]
[58.780024, "o", "    agg = _user_aggregates(pageviews)\r\n\u001b[?2004l\r"]
[58.78005, "o", "\u001b[?2004h"]
[58.78007, "o", "> "]
[58.780137, "o", "    # Separate arms\r\n\u001b[?2004l\r"]
[58.780163, "o", "\u001b[?2004h"]
[58.780187, "o", "> "]
[58.780315, "o", "    arm_a = agg[agg[\"variant\"] == \"A\"]\r\n\u001b[?2004l\r"]
[58.780384, "o", "\u001b[?2004h> "]
[58.780497, "o", "    arm_b = agg[agg[\"variant\"] == \"B\"]\r\n\u001b[?2004l\r"]
[58.780522, "o", "\u001b[?2004h"]
[58.780551, "o", "> "]
[58.780638, "o", "    # Observed CTRs and diff\r\n\u001b[?2004l\r"]
[58.780663, "o", "\u001b[?2004h"]
[58.780675, "o", "> "]
[58.780805, "o", "    clicks_a = arm_a[\"clicks\"].sum()\r\n\u001b[?2004l\r"]
[58.780847, "o", "\u001b[?2004h> "]
[58.780972, "o", "    views_a = arm_a[\"views\"].sum()\r\n\u001b[?2004l\r"]
[58.780998, "o", "\u001b[?2004h"]
[58.781034, "o", "> "]
[58.781149, "o", "    clicks_b = arm_b[\"clicks\"].sum()\r\n\u001b[?2004l\r"]
[58.781173, "o", "\u001b[?2004h"]
[58.781199, "o", "> "]
[58.781313, "o", "    views_b = arm_b[\"views\"].sum()\r\n\u001b[?2004l\r"]
[58.781377, "o", "\u001b[?2004h> "]
[58.781561, "o", "    ctr_a = clicks_a / views_a if views_a > 0 else 0.0\r\n\u001b[?2004l\r"]
[58.781592, "o", "\u001b[?2004h"]
[58.781612, "o", "> "]
[58.781792, "o", "    ctr_b = clicks_b / views_b if views_b > 0 else 0.0\r\n\u001b[?2004l\r"]
[58.78182, "o", "\u001b[?2004h"]
[58.781838, "o", "> "]
[58.781934, "o", "    diff_obs = ctr_b - ctr_a\r\n\u001b[?2004l\r"]
[58.781966, "o", "\u001b[?2004h"]
[58.781996, "o", "> \r\n\u001b[?2004l\r"]
[58.782015, "o", "\u001b[?2004h"]
[58.782041, "o", "> "]
[58.782162, "o", "    # Prepare arrays for fast resampling\r\n\u001b[?2004l\r"]
[58.782187, "o", "\u001b[?2004h"]
[58.782209, "o", "> "]
[58.782372, "o", "    a_clicks = arm_a[\"clicks\"].values\r\n\u001b[?2004l\r"]
[58.7824, "o", "\u001b[?2004h> "]
[58.782531, "o", "    a_views = arm_a[\"views\"].values\r\n\u001b[?2004l\r"]
[58.782561, "o", "\u001b[?2004h"]
[58.782601, "o", "> "]
[58.782722, "o", "    b_clicks = arm_b[\"clicks\"].values\r\n\u001b[?2004l\r"]
[58.782748, "o", "\u001b[?2004h"]
[58.782774, "o", "> "]
[58.782898, "o", "    b_views = arm_b[\"views\"].values\r\n\u001b[?2004l\r"]
[58.782923, "o", "\u001b[?2004h"]
[58.782937, "o", "> "]
[58.783039, "o", "    n_a = len(a_clicks)\r\n\u001b[?2004l\r"]
[58.783083, "o", "\u001b[?2004h> "]
[58.783176, "o", "    n_b = len(b_clicks)\r\n"]
[58.783208, "o", "\u001b[?2004l\r"]
[58.783221, "o", "\u001b[?2004h> "]
[58.783229, "o", "\r\n\u001b[?2004l\r"]
[58.783271, "o", "\u001b[?2004h> "]
[58.783422, "o", "    diffs = np.empty(n_resamples)\r\n\u001b[?2004l\r"]
[58.78345, "o", "\u001b[?2004h"]
[58.78349, "o", "> "]
[58.78362, "o", "    rng = np.random.default_rng()\r\n\u001b[?2004l\r"]
[58.783641, "o", "\u001b[?2004h"]
[58.783653, "o", "> "]
[58.783804, "o", "    for i in range(n_resamples):\r\n\u001b[?2004l\r"]
[58.783924, "o", "\u001b[?2004h"]
[58.783962, "o", "> "]
[58.784091, "o", "        # Sample users with replacement within each arm\r\n\u001b[?2004l\r"]
[58.784124, "o", "\u001b[?2004h> "]
[58.784319, "o", "        idx_a = rng.integers(0, n_a, n_a)\r\n\u001b[?2004l\r"]
[58.784401, "o", "\u001b[?2004h> "]
[58.784548, "o", "        idx_b = rng.integers(0, n_b, n_b)\r\n\u001b[?2004l\r"]
[58.784585, "o", "\u001b[?2004h> "]
[58.784793, "o", "        samp_clicks_a = a_clicks[idx_a].sum()\r\n\u001b[?2004l\r"]
[58.784833, "o", "\u001b[?2004h> "]
[58.785032, "o", "        samp_views_a = a_views[idx_a].sum()\r\n\u001b[?2004l\r"]
[58.785067, "o", "\u001b[?2004h"]
[58.785111, "o", "> "]
[58.785275, "o", "        samp_clicks_b = b_clicks[idx_b].sum()\r\n\u001b[?2004l\r"]
[58.785318, "o", "\u001b[?2004h> "]
[58.785524, "o", "        samp_views_b = b_views[idx_b].sum()\r\n\u001b[?2004l\r"]
[58.785562, "o", "\u001b[?2004h> "]
[58.785917, "o", "        ctr_a_boot = samp_clicks_a / samp_views_a if samp_views_a > 0 else 0.0\r\n\u001b[?2004l\r"]
[58.785957, "o", "\u001b[?2004h> "]
[58.786311, "o", "        ctr_b_boot = samp_clicks_b / samp_views_b if samp_views_b > 0 else 0.0\r\n\u001b[?2004l\r"]
[58.78637, "o", "\u001b[?2004h"]
[58.786405, "o", "> "]
[58.78658, "o", "        diffs[i] = ctr_b_boot - ctr_a_boot\r\n\u001b[?2004l\r"]
[58.786629, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.786676, "o", "\u001b[?2004h> "]
[58.786895, "o", "    lower = np.percentile(diffs, 100 * alpha / 2)\r\n\u001b[?2004l\r"]
[58.78696, "o", "\u001b[?2004h"]
[58.786973, "o", "> "]
[58.787187, "o", "    upper = np.percentile(diffs, 100 * (1 - alpha / 2))\r\n\u001b[?2004l\r"]
[58.787215, "o", "\u001b[?2004h"]
[58.787256, "o", "> "]
[58.787394, "o", "    return diff_obs, lower, upper\r\n\u001b[?2004l\r"]
[58.787422, "o", "\u001b[?2004h"]
[58.787436, "o", "> \r\n\u001b[?2004l\r"]
[58.787476, "o", "\u001b[?2004h"]
[58.787499, "o", "> \r\n\u001b[?2004l\r"]
[58.78752, "o", "\u001b[?2004h> "]
[58.787748, "o", "def srm_chi2_pvalue(n_users: dict) -> Tuple[float, bool]:\r\n\u001b[?2004l\r"]
[58.78777, "o", "\u001b[?2004h"]
[58.78779, "o", "> "]
[58.788069, "o", "    \"\"\"Compute Pearson chi‑square p‑value for sample‑ratio mismatch.\r\n\u001b[?2004l\r"]
[58.788094, "o", "\u001b[?2004h"]
[58.788111, "o", "> "]
[58.788339, "o", "    Returns (p_value, flag) where flag is True if p < 0.001.\r\n\u001b[?2004l\r"]
[58.788385, "o", "\u001b[?2004h> "]
[58.78842, "o", "    \"\"\"\r\n"]
[58.788443, "o", "\u001b[?2004l\r"]
[58.788465, "o", "\u001b[?2004h> "]
[58.788652, "o", "    total = n_users.get(\"A\", 0) + n_users.get(\"B\", 0)\r\n"]
[58.788693, "o", "\u001b[?2004l\r"]
[58.788711, "o", "\u001b[?2004h> "]
[58.788794, "o", "    expected = total / 2.0\r\n\u001b[?2004l\r"]
[58.788819, "o", "\u001b[?2004h"]
[58.78884, "o", "> "]
[58.789211, "o", "    chi_sq = ((n_users.get(\"A\", 0) - expected) ** 2 + (n_users.get(\"B\", 0) - expected) ** 2) / expected\r\n\u001b[?2004l\r"]
[58.789235, "o", "\u001b[?2004h"]
[58.789255, "o", "> "]
[58.789374, "o", "    p = chi2.sf(chi_sq, df=1)\r\n"]
[58.789409, "o", "\u001b[?2004l\r"]
[58.789418, "o", "\u001b[?2004h> "]
[58.789493, "o", "    flag = p < 0.001\r\n\u001b[?2004l\r"]
[58.789521, "o", "\u001b[?2004h"]
[58.78955, "o", "> "]
[58.789605, "o", "    return p, flag\r\n\u001b[?2004l\r"]
[58.789626, "o", "\u001b[?2004h"]
[58.78965, "o", "> "]
[58.789675, "o", "EOF\r\n\u001b[?2004l\r"]
[58.791359, "o", "\u001b[?2004h"]
[58.791412, "o", "root@106c0d2d-f536-4079-bb24-94492e630f2f:/app# "]
[59.781456, "i", "cat > abtest/report.py <<'EOF'\n\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots\nfrom .load import load_assignments, load_pageviews, load_users\nfrom .stats import bootstrap_ci, srm_chi2_pvalue\n\n\ndef build_readout(data_dir):\n    # Load and clean data\n    assignments = load_assignments(data_dir)\n    users = load_users(data_dir)\n    assignments = exclude_bots(assignments, users)\n    pageviews = load_pageviews(data_dir, assignments)\n\n    # Basic aggregates\n    n_users = assignments.groupby(\"variant\")[\"user_id\"].nunique()\n    pageviews_counts = pageviews.groupby(\"variant\").size()\n    clicks_counts = pageviews.groupby(\"variant\")[\"clicked\"].sum()\n\n    # CTR per arm\n    ctr = {\n        arm: float(clicks_counts[arm] / pageviews_counts[arm]) if pageviews_counts[arm] > 0 else 0.0\n        for arm in (\"A\", \"B\")\n    }\n\n    # User‑level bootstrap CI for diff\n    diff_obs, ci_low, ci_high = bootstrap_ci"]
[59.781575, "i", "(pageviews)\n\n    # SRM test\n    srm_p, srm_flag = srm_chi2_pvalue({\"A\": int(n_users.get(\"A\", 0)), \"B\": int(n_users.get(\"B\", 0))})\n\n    # Decision logic per plan\n    if srm_flag:\n        decision = \"invalid\"\n    elif ci_low > 0:\n        decision = \"ship\"\n    else:\n        decision = \"no_ship\"\n\n    # Assemble readout (required keys plus optional extras)\n    readout = {\n        \"n_users\": {arm: int(n_users.get(arm, 0)) for arm in (\"A\", \"B\")},\n        \"pageviews\": {arm: int(pageviews_counts.get(arm, 0)) for arm in (\"A\", \"B\")},\n        \"clicks\": {arm: int(clicks_counts.get(arm, 0)) for arm in (\"A\", \"B\")},\n        \"ctr\": ctr,\n        \"diff\": float(diff_obs),\n        \"ci_95\": [float(ci_low), float(ci_high)],\n        \"srm_p\": float(srm_p),\n        \"srm_flag\": bool(srm_flag),\n        \"decision\": decision,\n    }\n    return readout\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\n    ap.add_argument(\"--data\", required=True, help=\"folder with assignments.csv, users.csv, pageview"]
[59.781594, "i", "s.csv\")\n    ap.add_argument(\"--out\", required=True, help=\"path of the result.json to write\")\n    args = ap.parse_args(argv)\n    readout = build_readout(args.data)\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} srm_flag={readout['srm_flag']}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[59.781692, "o", "cat > abtest/report.py <<'EOF'\r\n"]
