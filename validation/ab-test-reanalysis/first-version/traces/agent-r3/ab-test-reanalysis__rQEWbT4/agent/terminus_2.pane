[?2004l[?2004h> """Population filters for the readout.
[?2004l[?2004h> 
[?2004l[?2004h> According to EXPERIMENT.md, bots must be excluded from **both** arms before any
[?2004l[?2004h> counts are performed. The original implementation mistakenly filtered bots
[?2004l[?2004h> only from variant B. This function follows the plan precisely: any user with
[?2004l[?2004h> ``is_bot == 1`` is removed, regardless of their assigned variant.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> def exclude_bots(assignments, users):
[?2004l[?2004h>     """Drop users flagged as bots (EXPERIMENT.md, Population).
[?2004l[?2004h> 
[?2004l[?2004h>     Parameters
[?2004l[?2004h>     ----------
[?2004l[?2004h>     assignments: pd.DataFrame
[?2004l[?2004h>         Columns ``user_id`` and ``variant`` (A/B).
[?2004l[?2004h>     users: pd.DataFrame
[?2004l[?2004h>         Columns ``user_id`` and ``is_bot`` (0/1).
[?2004l[?2004h> 
[?2004l[?2004h>     Returns
[?2004l[?2004h>     -------
[?2004l[?2004h>     pd.DataFrame
[?2004l[?2004h>         ``assignments`` with all rows where the corresponding user is a bot
[?2004l[?2004h>         removed.
[?2004l[?2004h>     """
[?2004l[?2004h>     flagged = set(users.loc[users["is_bot"] == 1, "user_id"])
[?2004l[?2004h>     keep = ~assignments["user_id"].isin(flagged)
[?2004l[?2004h>     return assignments[keep].reset_index(drop=True)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@78079220-c0ce-4ac0-aca0-f5e4cd836950:/app# cat > abtest/load.py <<'EOF'
[?2004l[?2004h> """Read the experiment export: assignments.csv, users.csv and pageviews.csv in one folder."""
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _instants(col):
[?2004l[?2004h>     """Parse ISO‑8601 timestamps (with ``Z`` or offset) to UTC.
[?2004l[?2004h>     Pandas can infer ISO‑8601 format; we only need ``utc=True`` to get a
[?2004l[?2004h>     timezone‑aware ``datetime64[ns, UTC]`` value for correct comparisons.
[?2004l[?2004h>     """
[?2004l[?2004h>     return pd.to_datetime(col, utc=True)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_assignments(data_dir):
[?2004l[?2004h>     df = pd.read_csv(Path(data_dir) / "assignments.csv", dtype=str)
[?2004l[?2004h>     df = df.drop_duplicates()
[?2004l[?2004h>     df["assigned_at"] = _instants(df["assigned_at"])
[?2004l[?2004h>     return df.reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_users(data_dir):
[?2004l[?2004h>     return pd.read_csv(Path(data_dir) / "users.csv", dtype={"user_id": str, "is_bot": "int64"})
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_pageviews(data_dir, assignments):
[?2004l[?2004h>     pv = pd.read_csv(Path(data_dir) / "pageviews.csv", dtype={"user_id": str, "ts": str, "clicked": "int64"})
[?2004l[?2004h>     pv["ts"] = _instants(pv["ts"])
[?2004l[?2004h>     pv = pv.merge(assignments[["user_id", "variant", "assigned_at"]], on="user_id", how="inner")
[?2004l[?2004h>     pv = pv[pv["ts"] >= pv["assigned_at"]]
[?2004l[?2004h>     return pv.reset_index(drop=True)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@78079220-c0ce-4ac0-aca0-f5e4cd836950:/app# cat > abtest/stats.py <<'EOF'
[?2004l[?2004h> """Statistical calculations for the CTR readout.
[?2004l[?2004h> 
[?2004l[?2004h> The analysis plan (section 5) requires the *delta method* for the difference of two
[?2004l[?2004h> ratios of sums, treating the two arms as independent. The original code used a
[?2004l[?2004h> pooled two‑proportion z‑test, which is not acceptable because it treats each
[?2004l[?2004h> pageview as independent.
[?2004l[?2004h> """
[?2004l[?2004h> import math
[?2004l[?2004h> from dataclasses import dataclass
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass
[?2004l[?2004h> class ZTest:
[?2004l[?2004h>     diff: float
[?2004l[?2004h>     ci_low: float
[?2004l[?2004h>     ci_high: float
[?2004l[?2004h>     z: float
[?2004l[?2004h>     p_value: float
[?2004l[?2004h> 
[?2004l[?2004h> def ctr_delta_test(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> ZTest:
[?2004l[?2004h>     """Delta‑method two‑proportion test for CTR difference.
[?2004l[?2004h>     Returns a ZTest object with point estimate, confidence interval, Wald
[?2004l[?2004h>     statistic and two‑sided p‑value.
[?2004l[?2004h>     """
[?2004l[?2004h>     if views_a == 0 or views_b == 0:
[?2004l[?2004h>         raise ValueError("Each arm must have at least one pageview.")
[?2004l[?2004h>     pa = clicks_a / views_a
[?2004l[?2004h>     pb = clicks_b / views_b
[?2004l[?2004h>     diff = pb - pa
[?2004l[?2004h>     se = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)
[?2004l[?2004h>     z = diff / se if se != 0 else 0.0
[?2004l[?2004h>     p_value = 2 * norm.sf(abs(z))
[?2004l[?2004h>     crit = norm.ppf(1 - alpha / 2)
[?2004l[?2004h>     ci_low = diff - crit * se
[?2004l[?2004h>     ci_high = diff + crit * se
[?2004l[?2004h>     return ZTest(diff=diff, ci_low=ci_low, ci_high=ci_high, z=z, p_value=p_value)
[?2004l[?2004h> EOF
