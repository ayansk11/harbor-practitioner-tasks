+def ctr_delta_test(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> ZTest:
+    """Delta‑method two‑proportion test for CTR difference.
+
+    Parameters
+    ----------
+    clicks_a, views_a, clicks_b, views_b : int
+        Aggregated click and view counts for arms A and B.
+    alpha : float, optional
+        Significance level for the confidence interval (default 0.05 for 95 %).
+
+    Returns
+    -------
+    ZTest
+        Contains the point estimate, confidence interval, Wald statistic and
+        two‑sided p‑value.
+    """
+    # Guard against division by zero – if an arm has zero pageviews the CTR is
+    # undefined; the plan guarantees at least one view per arm in realistic
+    # experiments, but we protect the function nevertheless.
+    if views_a == 0 or views_b == 0:
+        raise ValueError("Each arm must have at least one pageview.")
+
+    pa = clicks_a / views_a
+    pb = clicks_b / views_b
+    diff = pb - pa
+
+    # Delta‑method standard error treating arms as independent.
+    se = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)
+    # Wald statistic for the null hypothesis diff == 0.
+    z = diff / se if se != 0 else 0.0
+    p_value = 2 * norm.sf(abs(z))
+
+    # Two‑sided (1‑alpha) confidence interval.
+    crit = norm.ppf(1 - alpha / 2)
+    ci_low = diff - crit * se
+    ci_high = diff + crit * se
+    return ZTest(diff=diff, ci_low=ci_low, ci_high=ci_high, z=z, p_value=p_value)
+
*** End Patch
