[39.577832, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: abtest/load.py\n@@\n-def _instants(col):\n-    # The export mixes \"Z\" and \"+hh:mm\" / \"-hh:mm\" offsets. Parse to UTC so we compare instants, never strings.\n-    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\n+def _instants(col):\n+    \"\"\"Parse ISO‑8601 timestamps (with ``Z`` or offset) to UTC.\n+\n+    The original code passed ``format=\"ISO8601\"`` to ``pd.to_datetime`` which is\n+    not a valid strftime pattern and raises a ``ValueError``. Pandas can infer\n+    ISO‑8601 formats automatically; we only need to set ``utc=True`` so the\n+    resulting ``datetime64[ns, UTC]`` objects are comparable across rows.\n+    \"\"\"\n+    return pd.to_datetime(col, utc=True)\n*** End Patch\nPATCH\n"]
[39.578015, "o", "apply_patch <<'PATCH'"]
