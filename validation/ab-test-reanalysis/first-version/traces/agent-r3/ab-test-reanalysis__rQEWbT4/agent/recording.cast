[38.951645, "o", "> *** Add File: abtest/filters.py\r\n\u001b[?2004l\r\u001b[?2004h> +\"\"\"Population filters for the readout.\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +According to EXPERIMENT.md, bots must be excluded from **both** arms before any\r\n\u001b[?2004l\r\u001b[?2004h> +counts are performed. The original implementation mistakenly filtered bots\r\n\u001b[?2004l\r\u001b[?2004h> +only from variant B (a leftover from INC‑4471). The function below follows the\r\n\u001b[?2004l\r\u001b[?2004h> +plan precisely: any user with ``is_bot == 1`` is removed, regardless of their\r\n\u001b[?2004l\r\u001b[?2004h> +assigned variant.\r\n\u001b[?2004l\r\u001b[?2004h> +\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +def exclude_bots(assignments, users):\r\n\u001b[?2004l\r\u001b[?2004h> +    \"\"\"Drop users flagged as bots (EXPERIMENT.md, Population).\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +    Parameters\r\n\u001b[?2004l\r\u001b[?2004h> "]
