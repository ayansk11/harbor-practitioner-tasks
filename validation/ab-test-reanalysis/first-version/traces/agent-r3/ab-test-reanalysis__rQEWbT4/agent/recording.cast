[41.082163, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: abtest/stats.py\n+\"\"\"Statistical calculations for the CTR readout.\n+\n+The analysis plan (section 5) requires the *delta method* for the difference of\n+two ratios of sums, treating the two arms as independent. The original code\n+implemented a pooled two‑proportion z‑test, which is inappropriate because it\n+assumes independence of individual pageviews and uses a pooled variance for\n+the hypothesis test.\n+\n+This module provides ``ctr_delta_test`` that returns a ``ZTest`` dataclass\n+containing:\n+\n+* ``diff`` – ``CTR_B - CTR_A``\n+* ``ci_low`` / ``ci_high`` – 95 % confidence interval using the delta‑method\n+  standard error\n+* ``z`` – Wald statistic ``diff / se``\n+* ``p_value`` – two‑sided p‑value from the Normal distribution\n+\n+The function matches the signature used by ``abtest.report`` (clicks and\n+pageviews for each arm) so the report code can be updated to call it directly.\n+\"\"\"\n+\n+import math\n+from dataclasses import dataclass\n+from typi"]
[41.08236, "i", "ng import Tuple\n+\n+from scipy.stats import norm\n+\n+\n+@dataclass\n+class ZTest:\n+    diff: float\n+    ci_low: float\n+    ci_high: float\n+    z: float\n+    p_value: float\n+\n+\n+def ctr_delta_test(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> ZTest:\n+    \"\"\"Delta‑method two‑proportion test for CTR difference.\n+\n+    Parameters\n+    ----------\n+    clicks_a, views_a, clicks_b, views_b : int\n+        Aggregated click and view counts for arms A and B.\n+    alpha : float, optional\n+        Significance level for the confidence interval (default 0.05 for 95 %).\n+\n+    Returns\n+    -------\n+    ZTest\n+        Contains the point estimate, confidence interval, Wald statistic and\n+        two‑sided p‑value.\n+    \"\"\"\n+    # Guard against division by zero – if an arm has zero pageviews the CTR is\n+    # undefined; the plan guarantees at least one view per arm in realistic\n+    # experiments, but we protect the function nevertheless.\n+    if views_a == 0 or views_b == 0:\n+      "]
[41.082421, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[41.082497, "i", "  raise ValueError(\"Each arm must have at least one pageview.\")\n+\n+    pa = clicks_a / views_a\n+    pb = clicks_b / views_b\n+    diff = pb - pa\n+\n+    # Delta‑method standard error treating arms as independent.\n+    se = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)\n+    # Wald statistic for the null hypothesis diff == 0.\n+    z = diff / se if se != 0 else 0.0\n+    p_value = 2 * norm.sf(abs(z))\n+\n+    # Two‑sided (1‑alpha) confidence interval.\n+    crit = norm.ppf(1 - alpha / 2)\n+    ci_low = diff - crit * se\n+    ci_high = diff + crit * se\n+    return ZTest(diff=diff, ci_low=ci_low, ci_high=ci_high, z=z, p_value=p_value)\n+\n*** End Patch\nPATCH\n"]
[41.082554, "o", "ng import Tuple\r\n+\r\n+from scipy.stats import norm\r\n+\r\n+\r\n+@dataclass\r\n+class ZTest:\r\n+    diff: float\r\n+    ci_low: float\r\n+    ci_high: float\r\n+    z: float\r\n+    p_value: float\r\n+\r\n+\r\n+def ctr_delta_test(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> ZTest:\r\n+    \"\"\"Delta‑method two‑proportion test for CTR difference.\r\n+\r\n+    Parameters\r\n+    ----------\r\n+    clicks_a, views_a, clicks_b, views_b : int\r\n+        Aggregated click and view counts for arms A and B.\r\n+    alpha : float, optional\r\n+        Significance level for the confidence interval (default 0.05 for 95 %).\r\n+\r\n+    Returns\r\n+    -------\r\n+    ZTest\r\n+        Contains the point estimate, confidence interval, Wald statistic"]
[41.082585, "o", " and\r\n+        two‑sided p‑value.\r\n+    \"\"\"\r\n+    # Guard against division b"]
[41.082633, "o", "y zero – if an arm has zero pageviews the CTR is\r\n+    # undefined; the plan guarantees at least one view per arm in realistic\r\n+    # experiments, but we protect the function nevertheless.\r\n+    if views_a == 0 or views_b == 0:\r\n+      "]
[41.082675, "o", "  raise ValueError(\"Each arm must have at least one pageview.\")\r\n+\r\n+    pa = clicks_a / views_a\r\n"]
[41.082702, "o", "+    pb = clicks_b / views_b\r\n+    diff = pb - pa\r\n+\r\n+    # Delta‑method standard error treating arms as independent.\r\n+    se = math.sqrt(pa * (1 - pa) / views_a + pb "]
[41.082736, "o", "* (1 - pb) / views_b)\r\n+    # Wald statistic for the null hypothesis diff == 0.\r\n+    z = diff / se if se != 0 else 0.0\r\n+    p_value = 2 * norm.sf(abs(z))\r\n+\r\n+    # Two‑side"]
[41.082797, "o", "d (1‑alpha) confidence interval.\r\n+    crit = norm.ppf(1 - alpha / 2)\r\n+    ci_low = diff - crit * se\r\n+    ci_high = diff + crit * se\r\n+    return ZTest(diff=diff, ci_low=ci_low, ci_high=ci_high, z=z, p_value=p_value)\r\n+\r\n*** End Patch\r\nPATCH"]
