[41.866088, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: abtest/report.py\n@@\n-from .stats import ctr_ztest\n+from .stats import ctr_delta_test\n@@\n-    test = ctr_ztest(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\n+    # Perform the delta‑method test required by the analysis plan.\n+    test = ctr_delta_test(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\n@@\n-    decision = \"ship\" if (test.p_value < 0.05 and test.diff > 0) else \"no_ship\"\n-    return {\n-        \"experiment\": \"EXP-2291\",\n-        \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\n-        \"pageviews\": {arm: int(views[arm]) for arm in (\"A\", \"B\")},\n-        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\n-        \"ctr\": ctr,\n-        \"diff\": float(test.diff),\n-        \"rel_lift\": float(test.diff / ctr[\"A\"]),\n-        \"ci_95\": [float(test.ci_low), float(test.ci_high)],\n-        \"p_value\": float(test.p_value),\n-        \"decision\": decision,\n-    }\n+    # ----------------------------------"]
[41.866659, "i", "-----------------------------------\n+    # SRM (Sample Ratio Mismatch) check – section 6 of the plan\n+    # ---------------------------------------------------------------------\n+    total_assigned = n_users.sum()\n+    expected = total_assigned / 2.0\n+    # chi‑square statistic with 1 degree of freedom\n+    chi2 = ((n_users[\"A\"] - expected) ** 2 + (n_users[\"B\"] - expected) ** 2) / expected\n+    from scipy.stats import chi2 as chi2_dist\n+    srm_p = float(chi2_dist.sf(chi2, df=1))\n+    srm_flag = srm_p < 0.001\n+\n+    # ---------------------------------------------------------------------\n+    # Decision rule – section 7 of the plan\n+    # ---------------------------------------------------------------------\n+    if srm_flag:\n+        decision = \"invalid\"\n+    elif test.ci_low > 0:\n+        decision = \"ship\"\n+    else:\n+        decision = \"no_ship\"\n+\n+    return {\n+        \"experiment\": \"EXP-2291\",\n+        \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\n+        \"pageviews\": {arm: int(views[ar"]
[41.866682, "i", "m]) for arm in (\"A\", \"B\")},\n+        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\n+        \"ctr\": ctr,\n+        \"diff\": float(test.diff),\n+        \"ci_95\": [float(test.ci_low), float(test.ci_high)],\n+        \"srm_p\": srm_p,\n+        \"srm_flag\": srm_flag,\n+        \"decision\": decision,\n+    }\n*** End Patch\nPATCH\n"]
