[86.100806, "i", "cat > abtest/report.py <<'EOF'\n\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots\nfrom .load import load_assignments, load_pageviews, load_users\nfrom .stats import ctr_delta_test\n\n\ndef build_readout(data_dir):\n    assignments = load_assignments(data_dir)\n    users = load_users(data_dir)\n    assignments = exclude_bots(assignments, users)\n    pageviews = load_pageviews(data_dir, assignments)\n\n    n_users = assignments.groupby(\"variant\")[\"user_id\"].nunique()\n    views = pageviews.groupby(\"variant\").size()\n    clicks = pageviews.groupby(\"variant\")[\"clicked\"].sum()\n\n    # Delta‑method CTR test (section 5)\n    test = ctr_delta_test(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\n    ctr = {arm: float(clicks[arm] / views[arm]) for arm in (\"A\", \"B\")}\n\n    # SRM check (section 6)\n    total_assigned = n_users.sum()\n    expected = total_assigned / 2.0\n    chi2 = ((n_users[\""]
[86.100955, "i", "A\"] - expected) ** 2 + (n_users[\"B\"] - expected) ** 2) / expected\n    from scipy.stats import chi2 as chi2_dist\n    srm_p = float(chi2_dist.sf(chi2, df=1))\n    srm_flag = srm_p < 0.001\n\n    # Decision rule (section 7)\n    if srm_flag:\n        decision = \"invalid\"\n    elif test.ci_low > 0:\n        decision = \"ship\"\n    else:\n        decision = \"no_ship\"\n\n    # Assemble output (section 9). Extra keys are allowed, but we keep to the spec.\n    return {\n        \"experiment\": \"EXP-2291\",\n        \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\n        \"pageviews\": {arm: int(views[arm]) for arm in (\"A\", \"B\")},\n        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\n        \"ctr\": ctr,\n        \"diff\": float(test.diff),\n        \"ci_95\": [float(test.ci_low), float(test.ci_high)],\n        \"srm_p\": srm_p,\n        \"srm_flag\": srm_flag,\n        \"decision\": decision,\n    }\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\n    parser.add_argument(\"--data\", "]
[86.100976, "i", "required=True, help=\"Folder with assignments.csv, users.csv, pageviews.csv\")\n    parser.add_argument(\"--out\", required=True, help=\"Path for the result JSON file\")\n    args = parser.parse_args(argv)\n\n    result = build_readout(args.data)\n    out_path = Path(args.out)\n    out_path.parent.mkdir(parents=True, exist_ok=True)\n    out_path.write_text(json.dumps(result, indent=2) + \"\\n\")\n    # Safe printing – no assumption that a p_value key exists.\n    print(f\"wrote {out_path}: decision={result['decision']} diff={result['diff']:+.5f}\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
