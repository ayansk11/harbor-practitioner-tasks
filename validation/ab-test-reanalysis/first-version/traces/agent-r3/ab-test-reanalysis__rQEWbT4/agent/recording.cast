[38.947525, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: abtest/filters.py\n+\"\"\"Population filters for the readout.\n+\n+According to EXPERIMENT.md, bots must be excluded from **both** arms before any\n+counts are performed. The original implementation mistakenly filtered bots\n+only from variant B (a leftover from INC‑4471). The function below follows the\n+plan precisely: any user with ``is_bot == 1`` is removed, regardless of their\n+assigned variant.\n+\"\"\"\n+\n+\n+def exclude_bots(assignments, users):\n+    \"\"\"Drop users flagged as bots (EXPERIMENT.md, Population).\n+\n+    Parameters\n+    ----------\n+    assignments: pd.DataFrame\n+        Columns ``user_id`` and ``variant`` (A/B) as loaded by ``load_assignments``.\n+    users: pd.DataFrame\n+        Columns ``user_id`` and ``is_bot`` (0/1).\n+\n+    Returns\n+    -------\n+    pd.DataFrame\n+        ``assignments`` with all rows where the corresponding user is a bot\n+        removed.\n+    \"\"\"\n+    # Identify all bot user_ids.\n+    flagged = set(users.loc[users[\"is_bot\"] == 1, \""]
[38.947572, "i", "user_id\"])\n+    # Keep only assignments whose user_id is not in the flagged set.\n+    keep = ~assignments[\"user_id\"].isin(flagged)\n+    return assignments[keep].reset_index(drop=True)\n+\n*** End Patch\nPATCH\n"]
[38.948658, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[38.94869, "o", "\u001b[?2004h> "]
