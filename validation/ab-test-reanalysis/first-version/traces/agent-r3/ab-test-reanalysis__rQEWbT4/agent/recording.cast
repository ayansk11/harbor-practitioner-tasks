[44.891138, "o", "\u001b[?2004hroot@78079220-c0ce-4ac0-aca0-f5e4cd836950:/app# cat output/result.json\r\n\u001b[?2004l\r"]
[44.89239, "o", "{\r\n  \"experiment\": \"EXP-2291\",\r\n  \"n_users\": {\r\n    \"A\": 20042,\r\n    \"B\": 19518\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 198876,\r\n    \"B\": 186115\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 15079,\r\n    \"B\": 14691\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.075821114664414,\r\n    \"B\": 0.07893506702845016\r\n  },\r\n  \"diff\": 0.0031139523640361516,\r\n  \"rel_lift\": 0.04106972546919913,\r\n  \"ci_95\": [\r\n    0.0014245322454811047,\r\n    0.004803372482591198\r\n  ],\r\n  \"p_value\": 0.000300617019442246,\r\n  \"decision\": \"ship\"\r\n}\r\n"]
