[62.692467, "i", "cat > abtest/stats.py <<'EOF'\n\"\"\"Statistical calculations for the CTR readout.\n\nThe analysis plan (section 5) requires the *delta method* for the difference of two\nratios of sums, treating the two arms as independent. The original code used a\npooled two‑proportion z‑test, which is not acceptable because it treats each\npageview as independent.\n\"\"\"\nimport math\nfrom dataclasses import dataclass\nfrom scipy.stats import norm\n\n@dataclass\nclass ZTest:\n    diff: float\n    ci_low: float\n    ci_high: float\n    z: float\n    p_value: float\n\ndef ctr_delta_test(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> ZTest:\n    \"\"\"Delta‑method two‑proportion test for CTR difference.\n    Returns a ZTest object with point estimate, confidence interval, Wald\n    statistic and two‑sided p‑value.\n    \"\"\"\n    if views_a == 0 or views_b == 0:\n        raise ValueError(\"Each arm must have at least one pageview.\")\n    pa = clicks_a / views_a\n    pb = clicks_b / views_b\n    diff = pb - pa\n    se"]
[62.69273, "i", " = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)\n    z = diff / se if se != 0 else 0.0\n    p_value = 2 * norm.sf(abs(z))\n    crit = norm.ppf(1 - alpha / 2)\n    ci_low = diff - crit * se\n    ci_high = diff + crit * se\n    return ZTest(diff=diff, ci_low=ci_low, ci_high=ci_high, z=z, p_value=p_value)\nEOF\n"]
[62.692794, "o", "cat > abtest/stats.py <<'EOF'"]
[62.692838, "o", "\r\n"]
[62.69288, "o", "\u001b[?2004l\r"]
[62.692995, "o", "\u001b[?2004h> "]
[62.693362, "o", "\"\"\"Statistical calculations for the CTR readout."]
[62.693665, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.693797, "o", "> \r\n"]
[62.693981, "o", "\u001b[?2004l\r\u001b[?2004h"]
[62.694028, "o", "> "]
[62.69477, "o", "The analysis plan (section 5) requires the *delta method* for the difference of two\r\n\u001b[?2004l\r"]
[62.694827, "o", "\u001b[?2004h"]
[62.694913, "o", "> "]
[62.695344, "o", "ratios of sums, treating the two arms as independent. The original code used a\r\n\u001b[?2004l\r"]
[62.695383, "o", "\u001b[?2004h"]
[62.695413, "o", "> "]
[62.69582, "o", "pooled two‑proportion z‑test, which is not acceptable because it treats each\r\n\u001b[?2004l\r"]
[62.695883, "o", "\u001b[?2004h> "]
[62.695993, "o", "pageview as independent.\r\n\u001b[?2004l\r"]
[62.696045, "o", "\u001b[?2004h> "]
[62.696059, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[62.69611, "o", "\u001b[?2004h> "]
[62.696282, "o", "import math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.696399, "o", "from dataclasses import dataclass\r\n\u001b[?2004l\r"]
[62.69648, "o", "\u001b[?2004h> "]
[62.696612, "o", "from scipy.stats import norm\r\n\u001b[?2004l\r"]
[62.696674, "o", "\u001b[?2004h> \r\n"]
[62.696687, "o", "\u001b[?2004l\r"]
[62.696752, "o", "\u001b[?2004h> "]
[62.6968, "o", "@dataclass\r\n\u001b[?2004l\r"]
[62.696813, "o", "\u001b[?2004h"]
[62.696849, "o", "> "]
[62.696908, "o", "class ZTest:\r\n\u001b[?2004l\r"]
[62.696937, "o", "\u001b[?2004h"]
[62.696948, "o", "> "]
[62.698467, "o", "    diff: float\r\n\u001b[?2004l\r\u001b[?2004h>     ci_low: float\r\n\u001b[?2004l\r\u001b[?2004h>     ci_high: float\r\n\u001b[?2004l\r\u001b[?2004h>     z: float\r\n\u001b[?2004l\r\u001b[?2004h>     p_value: float\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def ctr_delta_test(clicks_a: int, views_a: int, clicks_b: int, views_b: int, alpha: float = 0.05) -> ZTest:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.699105, "o", "    \"\"\"Delta‑method two‑proportion test for CTR difference.\r\n\u001b[?2004l\r\u001b[?2004h>     Returns a ZTest object with point estimate, confidence interval, Wald\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.699495, "o", "    statistic and two‑sided p‑value.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.70049, "o", "    if views_a == 0 or views_b == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ValueError(\"Each arm must have at least one pageview.\")\r\n\u001b[?2004l\r\u001b[?2004h>     pa = clicks_a / views_a\r\n\u001b[?2004l\r\u001b[?2004h>     pb = clicks_b / views_b\r\n\u001b[?2004l\r"]
[62.70056, "o", "\u001b[?2004h> "]
[62.700672, "o", "    diff = pb - pa\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.700723, "o", "> "]
[62.701037, "o", "    se = math.sqrt(pa * (1 - pa) / views_a + pb * (1 - pb) / views_b)\r\n\u001b[?2004l\r"]
[62.70109, "o", "\u001b[?2004h> "]
[62.701261, "o", "    z = diff / se if se != 0 else 0.0\r\n\u001b[?2004l\r"]
[62.701306, "o", "\u001b[?2004h"]
[62.701344, "o", "> "]
[62.701486, "o", "    p_value = 2 * norm.sf(abs(z))\r\n\u001b[?2004l\r"]
[62.701534, "o", "\u001b[?2004h> "]
[62.701704, "o", "    crit = norm.ppf(1 - alpha / 2)\r\n\u001b[?2004l\r"]
[62.701751, "o", "\u001b[?2004h"]
[62.701773, "o", "> "]
[62.701911, "o", "    ci_low = diff - crit * se\r\n\u001b[?2004l\r"]
[62.701957, "o", "\u001b[?2004h"]
[62.701972, "o", "> "]
[62.702115, "o", "    ci_high = diff + crit * se\r\n\u001b[?2004l\r"]
[62.702168, "o", "\u001b[?2004h> "]
[62.702577, "o", "    return ZTest(diff=diff, ci_low=ci_low, ci_high=ci_high, z=z, p_value=p_value)\r\n\u001b[?2004l\r"]
[62.702652, "o", "\u001b[?2004h> "]
[62.702695, "o", "EOF\r\n\u001b[?2004l\r"]
[62.704347, "o", "\u001b[?2004h"]
[62.704412, "o", "root@78079220-c0ce-4ac0-aca0-f5e4cd836950:/app# "]
[63.34256, "i", "cat > abtest/report.py <<'EOF'\n\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom .filters import exclude_bots\nfrom .load import load_assignments, load_pageviews, load_users\nfrom .stats import ctr_delta_test\n\n\ndef build_readout(data_dir):\n    assignments = load_assignments(data_dir)\n    users = load_users(data_dir)\n    assignments = exclude_bots(assignments, users)\n    pageviews = load_pageviews(data_dir, assignments)\n\n    n_users = assignments.groupby(\"variant\")[\"user_id\"].nunique()\n    views = pageviews.groupby(\"variant\").size()\n    clicks = pageviews.groupby(\"variant\")[\"clicked\"].sum()\n\n    # Delta‑method test (section 5)\n    test = ctr_delta_test(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\n    ctr = {arm: float(clicks[arm] / views[arm]) for arm in (\"A\", \"B\")}\n\n    # SRM check (section 6)\n    total_assigned = n_users.sum()\n    expected = total_assigned / 2.0\n    chi2 = ((n_users[\"A\"] "]
[63.342872, "o", "cat > abtest/report.py <<'EOF'\r\n\u001b[?2004l\r"]
[63.342895, "i", "- expected) ** 2 + (n_users[\"B\"] - expected) ** 2) / expected\n    from scipy.stats import chi2 as chi2_dist\n    srm_p = float(chi2_dist.sf(chi2, df=1))\n    srm_flag = srm_p < 0.001\n\n    # Decision rule (section 7)\n    if srm_flag:\n        decision = \"invalid\"\n    elif test.ci_low > 0:\n        decision = \"ship\"\n    else:\n        decision = \"no_ship\"\n\n    return {\n        \"experiment\": \"EXP-2291\",\n        \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\n        \"pageviews\": {arm: int(views[arm]) for arm in (\"A\", \"B\")},\n        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\n        \"ctr\": ctr,\n        \"diff\": float(test.diff),\n        \"ci_95\": [float(test.ci_low), float(test.ci_high)],\n        \"srm_p\": srm_p,\n        \"srm_flag\": srm_flag,\n        \"decision\": decision,\n    }\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\n    ap.add_argument(\"--data\", required=True, help=\"folder with assignments.csv, users.csv, pageviews.csv\")\n    ap.add_argument(\""]
[63.342908, "o", "\u001b[?2004h"]
[63.342919, "i", "--out\", required=True, help=\"path of the result.json to write\")\n    args = ap.parse_args(argv)\n    readout = build_readout(args.data)\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(readout, indent=2) + \"\\n\")\n    print(f\"wrote {out}: decision={readout['decision']} diff={readout['diff']:+.5f} p={readout.get('p_value','NA'):.2g}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[63.342994, "o", "> "]
[63.343413, "o", "\"\"\"EXP-2291 readout: python -m abtest.report --data <folder> --out <result.json>\"\"\"\r\n"]
