[61.894207, "i", "cat > abtest/load.py <<'EOF'\n\"\"\"Read the experiment export: assignments.csv, users.csv and pageviews.csv in one folder.\"\"\"\nfrom pathlib import Path\nimport pandas as pd\n\n\ndef _instants(col):\n    \"\"\"Parse ISO‑8601 timestamps (with ``Z`` or offset) to UTC.\n    Pandas can infer ISO‑8601 format; we only need ``utc=True`` to get a\n    timezone‑aware ``datetime64[ns, UTC]`` value for correct comparisons.\n    \"\"\"\n    return pd.to_datetime(col, utc=True)\n\n\ndef load_assignments(data_dir):\n    df = pd.read_csv(Path(data_dir) / \"assignments.csv\", dtype=str)\n    df = df.drop_duplicates()\n    df[\"assigned_at\"] = _instants(df[\"assigned_at\"])\n    return df.reset_index(drop=True)\n\n\ndef load_users(data_dir):\n    return pd.read_csv(Path(data_dir) / \"users.csv\", dtype={\"user_id\": str, \"is_bot\": \"int64\"})\n\n\ndef load_pageviews(data_dir, assignments):\n    pv = pd.read_csv(Path(data_dir) / \"pageviews.csv\", dtype={\"user_id\": str, \"ts\": str, \"clicked\": \"int64\"})\n    pv[\"ts\"] = _instants(pv[\"ts\"])\n    pv = pv.merge(assignments[[\""]
[61.894349, "i", "user_id\", \"variant\", \"assigned_at\"]], on=\"user_id\", how=\"inner\")\n    pv = pv[pv[\"ts\"] >= pv[\"assigned_at\"]]\n    return pv.reset_index(drop=True)\nEOF\n"]
