[39.57998, "o", "> @@\r\n\u001b[?2004l\r\u001b[?2004h> -def _instants(col):\r\n\u001b[?2004l\r\u001b[?2004h> -    # The export mixes \"Z\" and \"+hh:mm\" / \"-hh:mm\" offsets. Parse to UTC so we compare instants, never strings.\r\n\u001b[?2004l\r\u001b[?2004h> -    return pd.to_datetime(col, utc=True, format=\"ISO8601\")\r\n\u001b[?2004l\r\u001b[?2004h> +def _instants(col):\r\n\u001b[?2004l\r\u001b[?2004h> +    \"\"\"Parse ISO‑8601 timestamps (with ``Z`` or offset) to UTC.\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.580222, "o", "+    The original code passed ``format=\"ISO8601\"`` to ``pd.to_datetime`` which is\r\n\u001b[?2004l\r"]
[39.580241, "o", "\u001b[?2004h"]
[39.580251, "o", "> "]
[39.580935, "o", "+    not a valid strftime pattern and raises a ``ValueError``. Pandas can infer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.58111, "o", "+    ISO‑8601 formats automatically; we only need to set ``utc=True`` so the\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.581392, "o", "+    resulting ``datetime64[ns, UTC]`` objects are comparable across rows.\r\n\u001b[?2004l\r\u001b[?2004h> +    \"\"\""]
