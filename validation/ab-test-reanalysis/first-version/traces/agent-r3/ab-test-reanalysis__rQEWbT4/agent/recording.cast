[86.10473, "o", "    views = pageviews.groupby(\"variant\").size()\r\n"]
[86.104744, "o", "\u001b[?2004l\r"]
[86.10502, "o", "\u001b[?2004h> "]
[86.105174, "o", "    clicks = pageviews.groupby(\"variant\")[\"clicked\"].sum()\r\n\u001b[?2004l\r"]
[86.105266, "o", "\u001b[?2004h"]
[86.105364, "o", "> \r\n\u001b[?2004l\r"]
[86.10538, "o", "\u001b[?2004h> "]
[86.105535, "o", "    # Delta‑method CTR test (section 5)\r\n"]
[86.105578, "o", "\u001b[?2004l\r"]
[86.105658, "o", "\u001b[?2004h> "]
[86.106027, "o", "    test = ctr_delta_test(int(clicks[\"A\"]), int(views[\"A\"]), int(clicks[\"B\"]), int(views[\"B\"]))\r\n\u001b[?2004l\r"]
[86.106104, "o", "\u001b[?2004h> "]
[86.106389, "o", "    ctr = {arm: float(clicks[arm] / views[arm]) for arm in (\"A\", \"B\")}\r\n\u001b[?2004l\r"]
[86.106486, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.106555, "o", "\u001b[?2004h> "]
[86.106619, "o", "    # SRM check (section 6)\r\n\u001b[?2004l\r"]
[86.106659, "o", "\u001b[?2004h> "]
[86.106812, "o", "    total_assigned = n_users.sum()\r\n\u001b[?2004l\r"]
[86.106866, "o", "\u001b[?2004h> "]
[86.107039, "o", "    expected = total_assigned / 2.0\r\n\u001b[?2004l\r"]
[86.107096, "o", "\u001b[?2004h> "]
[86.107499, "o", "    chi2 = ((n_users[\"A\"] - expected) ** 2 + (n_users[\"B\"] - expected) ** 2) / expected\r\n\u001b[?2004l\r"]
[86.107524, "o", "\u001b[?2004h> "]
[86.107751, "o", "    from scipy.stats import chi2 as chi2_dist\r\n\u001b[?2004l\r"]
[86.107849, "o", "\u001b[?2004h> "]
[86.108004, "o", "    srm_p = float(chi2_dist.sf(chi2, df=1))\r\n\u001b[?2004l\r"]
[86.108072, "o", "\u001b[?2004h> "]
[86.108587, "o", "    srm_flag = srm_p < 0.001\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Decision rule (section 7)\r\n\u001b[?2004l\r\u001b[?2004h>     if srm_flag:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.108677, "o", "        decision = \"invalid\"\r\n\u001b[?2004l\r"]
[86.108715, "o", "\u001b[?2004h> "]
[86.108822, "o", "    elif test.ci_low > 0:\r\n"]
[86.109951, "o", "\u001b[?2004l\r"]
[86.109974, "o", "\u001b[?2004h>         decision = \"ship\"\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         decision = \"no_ship\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Assemble output (section 9). Extra keys are allowed, but we keep to the spec.\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.11005, "o", "        \"experiment\": \"EXP-2291\",\r\n\u001b[?2004l\r"]
[86.110099, "o", "\u001b[?2004h> "]
[86.110324, "o", "        \"n_users\": {arm: int(n_users[arm]) for arm in (\"A\", \"B\")},\r\n"]
[86.110336, "o", "\u001b[?2004l\r"]
[86.11044, "o", "\u001b[?2004h"]
[86.110462, "o", "> "]
[86.110662, "o", "        \"pageviews\": {arm: int(views[arm]) for arm in (\"A\", \"B\")},\r\n\u001b[?2004l\r"]
[86.111952, "o", "\u001b[?2004h> "]
[86.112012, "o", "        \"clicks\": {arm: int(clicks[arm]) for arm in (\"A\", \"B\")},\r\n\u001b[?2004l\r\u001b[?2004h>         \"ctr\": ctr,\r\n\u001b[?2004l\r\u001b[?2004h>         \"diff\": float(test.diff),\r\n\u001b[?2004l\r\u001b[?2004h>         \"ci_95\": [float(test.ci_low), float(test.ci_high)],\r\n\u001b[?2004l\r\u001b[?2004h>         \"srm_p\": srm_p,\r\n\u001b[?2004l\r\u001b[?2004h>         \"srm_flag\": srm_flag,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.112134, "o", "        \"decision\": decision,\r\n\u001b[?2004l\r"]
[86.112166, "o", "\u001b[?2004h> "]
[86.112226, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.112238, "o", "> \r\n\u001b[?2004l\r"]
[86.112267, "o", "\u001b[?2004h> "]
[86.112485, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def main(argv=None):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.114671, "o", "    parser = argparse.ArgumentParser(description=\"EXP-2291 CTR readout\")\r\n\u001b[?2004l\r\u001b[?2004h>     parser.add_argument(\"--data\", required=True, help=\"Folder with assignments.csv, users.csv, pageviews.csv\")\r\n\u001b[?2004l\r\u001b[?2004h>     parser.add_argument(\"--out\", required=True, help=\"Path for the result JSON file\")\r\n\u001b[?2004l\r\u001b[?2004h>     args = parser.parse_args(argv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     result = build_readout(args.data)\r\n\u001b[?2004l\r\u001b[?2004h>     out_path = Path(args.out)\r\n\u001b[?2004l\r\u001b[?2004h>     out_path.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.115505, "o", "    out_path.write_text(json.dumps(result, indent=2) + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     # Safe printing – no assumption that a p_value key exists.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.115666, "o", "    print(f\"wrote {out_path}: decision={result['decision']} diff={result['diff']:+.5f}\")\r\n\u001b[?2004l\r"]
[86.115725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.115786, "o", "> "]
[86.115881, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[86.115903, "o", "\u001b[?2004h"]
[86.115938, "o", "> "]
[86.116036, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.116132, "o", "EOF\r\n\u001b[?2004l\r"]
[86.118304, "o", "\u001b[?2004hroot@78079220-c0ce-4ac0-aca0-f5e4cd836950:/app# "]
[86.970553, "i", "python -m abtest.report --data data --out output/result.json\n"]
[86.971105, "o", "python -m abtest.report --data data --out output/result.json\r\n"]
[86.97117, "o", "\u001b[?2004l\r"]
[88.780424, "o", "wrote output/result.json: decision=no_ship diff=-0.00040\r\n"]
[88.905555, "o", "\u001b[?2004hroot@78079220-c0ce-4ac0-aca0-f5e4cd836950:/app# "]
[89.080085, "i", "cat output/result.json\n"]
[89.080229, "o", "cat output/result.json\r\n\u001b[?2004l\r"]
[89.084774, "o", "{\r\n  \"experiment\": \"EXP-2291\",\r\n  \"n_users\": {\r\n    \"A\": 19612,\r\n    \"B\": 19518\r\n  },\r\n  \"pageviews\": {\r\n    \"A\": 189582,\r\n    \"B\": 186115\r\n  },\r\n  \"clicks\": {\r\n    \"A\": 15041,\r\n    \"B\": 14691\r\n  },\r\n  \"ctr\": {\r\n    \"A\": 0.07933770083657732,\r\n    \"B\": 0.07893506702845016\r\n  },\r\n  \"diff\": -0.0004026338081271619,\r\n  \"ci_95\": [\r\n    -0.0021291024453417994,\r\n    0.0013238348290874756\r\n  ],\r\n  \"srm_p\": 0.6346471582944933,\r\n  \"srm_flag\": false,\r\n  \"decision\": \"no_ship\"\r\n}\r\n"]
[89.084825, "o", "\u001b[?2004h"]
[89.085109, "o", "root@78079220-c0ce-4ac0-aca0-f5e4cd836950:/app# "]
