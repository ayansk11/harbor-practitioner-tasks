[30.550811, "o", "+    # Equation 47 from FAO‑56: u2 = uz * 4.87 / ln(67.8 * z_w - 5.42)\r\n\u001b[?2004l\r"]
[30.550843, "o", "\u001b[?2004h> "]
[30.551035, "o", "+    # `station.wind_height_m` is guaranteed to be present (1‑20 m).\r\n\u001b[?2004l\r"]
[30.551068, "o", "\u001b[?2004h> "]
[30.551163, "o", "+    uz = raw[\"wind_ms\"].astype(float)\r\n\u001b[?2004l\r"]
[30.551188, "o", "\u001b[?2004h"]
[30.551212, "o", "> "]
[30.551299, "o", "+    z_w = float(station.wind_height_m)\r\n\u001b[?2004l\r"]
[30.551331, "o", "\u001b[?2004h"]
[30.551356, "o", "> "]
[30.551502, "o", "+    # Guard against division by zero or invalid log argument.\r\n\u001b[?2004l\r"]
[30.551525, "o", "\u001b[?2004h"]
[30.551551, "o", "> "]
[30.551581, "o", "+    if z_w <= 0:\r\n\u001b[?2004l\r"]
[30.551603, "o", "\u001b[?2004h"]
[30.55163, "o", "> "]
[30.551838, "o", "+        raise ValueError(f\"{station.station_id}: invalid wind sensor height {z_w}\")\r\n\u001b[?2004l\r"]
[30.55187, "o", "\u001b[?2004h> "]
[30.551998, "o", "+    u2 = uz * 4.87 / np.log(67.8 * z_w - 5.42)\r\n\u001b[?2004l\r"]
[30.552034, "o", "\u001b[?2004h> "]
[30.552086, "o", "+    df[\"u2\"] = u2\r\n\u001b[?2004l\r"]
[30.552113, "o", "\u001b[?2004h"]
[30.552138, "o", "> +\r\n\u001b[?2004l\r"]
[30.552162, "o", "\u001b[?2004h> "]
[30.552328, "o", "+    # Convert solar radiation to MJ m‑2 day‑1 if necessary.\r\n\u001b[?2004l\r"]
[30.552353, "o", "\u001b[?2004h"]
[30.552371, "o", "> "]
[30.552476, "o", "+    rs_raw = raw[\"solar_rad\"].astype(float)\r\n\u001b[?2004l\r"]
[30.552502, "o", "\u001b[?2004h> "]
[30.552745, "o", "+    # The register specifies the units; accept \"MJ/m2/day\" (or similar) as already in MJ.\r\n\u001b[?2004l\r"]
[30.552769, "o", "\u001b[?2004h"]
[30.552798, "o", "> "]
[30.55297, "o", "+    rad_units = getattr(station, \"radiation_units\", \"MJ/m2/day\").lower()\r\n\u001b[?2004l\r"]
[30.552999, "o", "\u001b[?2004h"]
[30.553014, "o", "> "]
[30.553173, "o", "+    if rad_units in [\"w/m2\", \"w/m^2\", \"w/m2/day\", \"w/m^2/day\"]:\r\n\u001b[?2004l\r"]
[30.553198, "o", "\u001b[?2004h"]
[30.553213, "o", "> "]
[30.553419, "o", "+        # Convert from W m‑2 (mean daily irradiance) to MJ m‑2 day‑1.\r\n\u001b[?2004l\r"]
[30.553442, "o", "\u001b[?2004h"]
[30.553457, "o", "> "]
[30.553547, "o", "+        df[\"rs\"] = rs_raw * 0.0864\r\n\u001b[?2004l\r"]
[30.553571, "o", "\u001b[?2004h"]
[30.553596, "o", "> "]
[30.553626, "o", "+    else:\r\n\u001b[?2004l\r"]
[30.553667, "o", "\u001b[?2004h> "]
[30.553822, "o", "+        # Assume the value is already in MJ m‑2 day‑1.\r\n\u001b[?2004l\r"]
[30.553847, "o", "\u001b[?2004h"]
[30.553875, "o", "> "]
[30.553932, "o", "+        df[\"rs\"] = rs_raw\r\n\u001b[?2004l\r"]
[30.553956, "o", "\u001b[?2004h"]
[30.553989, "o", "> "]
[30.554016, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[30.55404, "o", "\u001b[?2004h> "]
[30.554065, "o", "PATCH\r\n\u001b[?2004l\r"]
[30.554484, "o", "bash: apply_patch: command not found\r\n"]
