[95.187093, "o", "\u001b[?2004h"]
[95.187108, "o", "> "]
[95.187332, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
