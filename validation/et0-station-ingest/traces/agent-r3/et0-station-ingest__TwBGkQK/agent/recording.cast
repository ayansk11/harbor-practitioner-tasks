[49.22784, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: et0/ingest.py\n@@\n-\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\n-import os\n-\n-import pandas as pd\n-\n-from . import fao56\n+\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files may contain wind speed measured at a height other than 2 m and solar radiation in\n+W m⁻².  This module converts them to the standard units required by the FAO‑56 algorithm.\n+\"\"\"\n+import os\n+\n+import numpy as np\n+import pandas as pd\n+\n+from . import fao56\n@@\n-    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\n-    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\n+    # Convert wind speed to the standard 2 m height (FAO‑56 Eq. 47)\n+    raw_wind = raw[\"wind_ms\"].astype(float)\n+    if getattr(station, \"wind_height_m\", 2.0) != 2.0:\n+        z = station.wind_height_m\n+        if (67.8 * z - 5.42) <= 0:\n+         "]
[49.227877, "i", "   raise ValueError(f\"Invalid wind sensor height {z} for station {station.station_id}\")\n+        factor = 4.87 / np.log(67.8 * z - 5.42)\n+        u2 = raw_wind * factor\n+    else:\n+        u2 = raw_wind\n+\n+    # Convert radiation units when necessary (W/m2 -> MJ/m2/day)\n+    raw_rs = raw[\"solar_rad\"].astype(float)\n+    if getattr(station, \"radiation_units\", \"MJ/m2/day\") == \"W/m2\":\n+        rs = raw_rs * 0.0864\n+    else:\n+        rs = raw_rs\n+\n+    df[\"u2\"] = u2            # m/s at 2 m\n+    df[\"rs\"] = rs            # MJ m⁻² day⁻¹\n*** End Patch\nPATCH"]
