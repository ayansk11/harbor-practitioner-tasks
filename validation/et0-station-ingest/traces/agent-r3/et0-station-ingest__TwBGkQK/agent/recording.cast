[113.145735, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[113.145761, "o", "\u001b[?2004h> "]
[113.146, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[113.146024, "o", "\u001b[?2004h"]
[113.146042, "o", "> +\r\n\u001b[?2004l\r"]
[113.146062, "o", "\u001b[?2004h"]
[113.14608, "o", "> +\r\n\u001b[?2004l\r"]
[113.146098, "o", "\u001b[?2004h"]
[113.146113, "o", "> "]
[113.146209, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[113.146231, "o", "\u001b[?2004h"]
[113.146253, "o", "> "]
[113.146457, "o", "+    \"\"\"Load a station's raw CSV and return a DataFrame with standardized columns.\r\n\u001b[?2004l\r"]
[113.146476, "o", "\u001b[?2004h"]
[113.146498, "o", "> "]
[113.14652, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.146543, "o", "> "]
[113.146735, "o", "+    Returned columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[113.146771, "o", "\u001b[?2004h> "]
[113.146795, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[113.146814, "o", "\u001b[?2004h"]
[113.146832, "o", "> "]
[113.146998, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[113.14702, "o", "\u001b[?2004h"]
[113.147039, "o", "> "]
[113.147108, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[113.147127, "o", "\u001b[?2004h"]
[113.147145, "o", "> "]
[113.147162, "o", "+\r\n\u001b[?2004l\r"]
[113.14718, "o", "\u001b[?2004h> "]
[113.147311, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[113.147328, "o", "\u001b[?2004h"]
[113.147344, "o", "> "]
[113.147589, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[113.147611, "o", "\u001b[?2004h"]
[113.147633, "o", "> +\r\n\u001b[?2004l\r"]
[113.147659, "o", "\u001b[?2004h> "]
[113.147918, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[113.147937, "o", "\u001b[?2004h"]
[113.147954, "o", "> "]
[113.148002, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[113.148024, "o", "\u001b[?2004h"]
[113.148041, "o", "> "]
[113.1482, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[113.148217, "o", "\u001b[?2004h"]
[113.148238, "o", "> "]
[113.148253, "o", "+\r\n\u001b[?2004l\r"]
[113.148276, "o", "\u001b[?2004h> "]
[113.14843, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[113.148453, "o", "\u001b[?2004h"]
[113.148472, "o", "> "]
[113.148531, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[113.148553, "o", "\u001b[?2004h> "]
[113.148679, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[113.148703, "o", "\u001b[?2004h"]
[113.148724, "o", "> "]
[113.148839, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[113.148859, "o", "\u001b[?2004h"]
[113.148875, "o", "> "]
[113.148999, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[113.149016, "o", "\u001b[?2004h"]
[113.149037, "o", "> "]
[113.149155, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[113.149178, "o", "\u001b[?2004h> "]
[113.149303, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[113.149323, "o", "\u001b[?2004h"]
[113.149338, "o", "> "]
[113.149356, "o", "+    })\r\n\u001b[?2004l\r"]
[113.149374, "o", "\u001b[?2004h"]
[113.149393, "o", "> "]
[113.149408, "o", "+\r\n\u001b[?2004l\r"]
[113.149431, "o", "\u001b[?2004h> "]
[113.14965, "o", "+    # ---- Actual vapour pressure ------------------------------------------------\r\n\u001b[?2004l\r"]
[113.149673, "o", "\u001b[?2004h"]
[113.149688, "o", "> "]
[113.149792, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[113.149814, "o", "\u001b[?2004h> "]
[113.150046, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[113.150066, "o", "\u001b[?2004h"]
[113.150085, "o", "> "]
[113.150109, "o", "+    else:\r\n\u001b[?2004l\r"]
[113.150127, "o", "\u001b[?2004h"]
[113.150145, "o", "> "]
[113.150283, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[113.150304, "o", "\u001b[?2004h"]
[113.150322, "o", "> "]
[113.150412, "o", "+            df[\"tmax\"], df[\"tmin\"],\r\n\u001b[?2004l\r"]
[113.15043, "o", "\u001b[?2004h"]
[113.150448, "o", "> "]
[113.150568, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[113.150589, "o", "\u001b[?2004h> "]
[113.15074, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[113.150766, "o", "\u001b[?2004h> "]
[113.150798, "o", "+        )\r\n\u001b[?2004l\r"]
[113.150819, "o", "\u001b[?2004h"]
[113.150841, "o", "> +\r\n\u001b[?2004l\r"]
[113.150861, "o", "\u001b[?2004h"]
[113.150883, "o", "> "]
[113.151104, "o", "+    # ---- Wind speed conversion to 2 m height (FAO‑56 Eq. 47) --------------------\r\n\u001b[?2004l\r"]
[113.151124, "o", "\u001b[?2004h"]
[113.151138, "o", "> "]
[113.151257, "o", "+    raw_wind = raw[\"wind_ms\"].astype(float)\r\n\u001b[?2004l\r"]
[113.151275, "o", "\u001b[?2004h"]
[113.151294, "o", "> "]
[113.151433, "o", "+    if getattr(station, \"wind_height_m\", 2.0) != 2.0:\r\n\u001b[?2004l\r"]
[113.151456, "o", "\u001b[?2004h> "]
[113.151555, "o", "+        z = station.wind_height_m\r\n\u001b[?2004l\r"]
[113.151576, "o", "\u001b[?2004h"]
[113.151594, "o", "> "]
[113.151688, "o", "+        if (67.8 * z - 5.42) <= 0:\r\n\u001b[?2004l\r"]
[113.151712, "o", "\u001b[?2004h"]
[113.151731, "o", "> "]
[113.151976, "o", "+            raise ValueError(f\"Invalid wind sensor height {z} for station {station.station_id}\")\r\n\u001b[?2004l\r"]
[113.151998, "o", "\u001b[?2004h"]
[113.152017, "o", "> "]
[113.15214, "o", "+        factor = 4.87 / np.log(67.8 * z - 5.42)\r\n\u001b[?2004l\r"]
[113.152162, "o", "\u001b[?2004h> "]
[113.152254, "o", "+        u2 = raw_wind * factor\r\n\u001b[?2004l\r"]
[113.152275, "o", "\u001b[?2004h"]
[113.152291, "o", "> "]
[113.152318, "o", "+    else:\r\n\u001b[?2004l\r"]
[113.152344, "o", "\u001b[?2004h"]
[113.152361, "o", "> "]
[113.152416, "o", "+        u2 = raw_wind\r\n\u001b[?2004l\r"]
[113.152436, "o", "\u001b[?2004h"]
[113.152458, "o", "> "]
[113.152475, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.152493, "o", "> "]
[113.152712, "o", "+    # ---- Solar radiation conversion --------------------------------------------\r\n\u001b[?2004l\r"]
[113.152734, "o", "\u001b[?2004h"]
[113.152748, "o", "> "]
[113.152864, "o", "+    raw_rs = raw[\"solar_rad\"].astype(float)\r\n\u001b[?2004l\r"]
[113.152885, "o", "\u001b[?2004h"]
[113.152903, "o", "> "]
[113.153073, "o", "+    if getattr(station, \"radiation_units\", \"MJ/m2/day\") == \"W/m2\":\r\n\u001b[?2004l\r"]
[113.153095, "o", "\u001b[?2004h"]
[113.15311, "o", "> "]
[113.153464, "o", "+        # Convert W m⁻² to MJ m⁻² day⁻¹: 1 W = 1 J s⁻¹, 86400 s day⁻¹, 1 MJ = 10⁶ J\r\n\u001b[?2004l\r"]
[113.153491, "o", "\u001b[?2004h> "]
[113.153571, "o", "+        rs = raw_rs * 0.0864\r\n\u001b[?2004l\r"]
[113.15359, "o", "\u001b[?2004h"]
[113.153608, "o", "> "]
[113.153646, "o", "+    else:\r\n\u001b[?2004l\r"]
[113.153667, "o", "\u001b[?2004h> "]
[113.153734, "o", "+        rs = raw_rs\r\n\u001b[?2004l\r"]
[113.15376, "o", "\u001b[?2004h> "]
[113.153781, "o", "+\r\n\u001b[?2004l\r"]
[113.1538, "o", "\u001b[?2004h> "]
[113.153855, "o", "+    df[\"u2\"] = u2\r\n\u001b[?2004l\r"]
[113.153877, "o", "\u001b[?2004h"]
[113.153895, "o", "> "]
[113.153942, "o", "+    df[\"rs\"] = rs\r\n\u001b[?2004l\r"]
[113.15396, "o", "\u001b[?2004h"]
[113.153977, "o", "> "]
[113.154021, "o", "+    return df\r\n\u001b[?2004l\r"]
[113.154042, "o", "\u001b[?2004h"]
[113.154058, "o", "> +\r\n\u001b[?2004l\r"]
[113.154075, "o", "\u001b[?2004h"]
[113.154091, "o", "> "]
[113.154129, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[113.154152, "o", "\u001b[?2004h> "]
[113.15417, "o", "EOF\r\n\u001b[?2004l\r"]
