[78.115735, "o", "its\", \"MJ/m2/day\") == \"W/m2\":\r\n+        # Convert W m⁻² to MJ m⁻² day⁻¹: 1 W = 1 J s⁻¹, 86400 s day⁻¹, 1 MJ"]
[78.115767, "o", " = 10⁶ J\r\n+        rs = raw_rs * 0.0864\r\n+    else:\r\n+        rs = raw_rs\r\n+\r\n+    df[\"u2\"] = u2\r\n+    df[\"rs\"]"]
[78.115791, "o", " = rs\r\n+    return df\r\n+\r\n*** End Patch\r\nEOF\r\n\u001b[?2004h> "]
