[18.619331, "o", "# Station register for the irrigation-advice ET0 run (see /app/docs/METHOD.md for every field).\r\nstations:\r\n  - id: VNT\r\n    name: Valle Norte\r\n    latitude: 38.42\r\n    longitude: -3.71\r\n    elevation_m: 85\r\n    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: rh_minmax\r\n"]
[18.619385, "o", "    network: valley-agromet\r\n  - id: PAL\r\n    name: Paso Alto\r\n    latitude: \"36.95N\"\r\n    longitude: -3.02\r\n    elevation_m: 1840\r\n    wind_height_m: 10.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: rh_minmax\r\n    network: highland-synop\r\n  - id: CDB\r\n    name: Costa del Bajo\r\n    latitude: \"34.92S\"\r\n    longitude: 138.6\r\n    elevation_m: 48\r\n    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: dewpoint\r\n    network: southern-coast\r\n  - id: LGN\r\n"]
[18.619419, "o", "    name: Laguna Grande\r\n    latitude: -31.85\r\n    longitude: 116.02\r\n    elevation_m: 420\r\n    wind_height_m: 3.0\r\n    radiation_units: \"W/m2\"\r\n    humidity: rh_minmax\r\n    network: southern-coast\r\n  - id: RSD\r\n    name: Ribera Seca\r\n    latitude: \"41.73N\"\r\n    longitude: -1.02\r\n    elevation_m: 230\r\n    wind_height_m: 2.0\r\n    radiation_units: \"W/m2\"\r\n    humidity: dewpoint\r\n"]
[18.619438, "o", "    network: highland-synop\r\n  - id: MRS\r\n    name: Marisma\r\n"]
[18.619452, "o", "    latitude: 35.1\r\n    longitude: -6.15\r\n    elevation_m: 12\r\n    wind_height_m: 3.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: rh_minmax\r\n    network: valley-agromet\r\n  - id: HLT"]
[18.61948, "o", "\r\n    name: Altiplano Sur\r\n    latitude: \"33.40S\"\r\n    longitude: -70.55\r\n    elevation_m: 610\r\n    wind_height_m: 10.0\r\n    radiation_units: \"W/m2\"\r\n    humidity: dewpoint\r\n    network: highland-synop\r\n  - id: ARN\r\n    name: Arenales\r\n    latitude: 40.05\r\n"]
[18.6195, "o", "    longitude: -4.4\r\n    elevation_m: 690\r\n"]
[18.619521, "o", "    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: dewpoint\r\n    network: valley-agromet\r\n"]
[18.619734, "o", "\u001b[?2004hroot@3aa2b692-c514-41ad-a921-1fef92e5c19e:/app# "]
