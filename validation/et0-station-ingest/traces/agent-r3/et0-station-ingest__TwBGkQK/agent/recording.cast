[130.299231, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and convert it to the standard inputs required by ``fao56.et0_daily``.\n+\n+The raw CSV files may contain:\n+* Wind speed measured at a height other than 2 m (``wind_ms`` column).\n+* Solar radiation expressed in Watts per square metre (``solar_rad`` column).\n+\n+FAO‑56 requires wind speed at 2 m (``u2``) in m s⁻¹ and radiation in MJ m⁻² day⁻¹ (``rs``). This module performs those conversions before returning a DataFrame.\n+\"\"\"\n+\n+import os\n+\n+import numpy as np\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Load a station's raw CSV and return a DataFrame with standardized columns.\n+\n+    Returned columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\n+    \"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+"]
[130.299326, "i", "    raw = pd.read_csv(path)\n+\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+        \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype(float),\n+    })\n+\n+    # ---- Actual vapour pressure ------------------------------------------------\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"], df[\"tmin\"],\n+            raw[\"rh_max"]
[130.29936, "i", "_pct\"].astype(float),\n+            raw[\"rh_min_pct\"].astype(float),\n+        )\n+\n+    # ---- Wind speed conversion to 2 m height (FAO‑56 Eq. 47) --------------------\n+    raw_wind = raw[\"wind_ms\"].astype(float)\n+    if getattr(station, \"wind_height_m\", 2.0) != 2.0:\n+        z = station.wind_height_m\n+        if (67.8 * z - 5.42) <= 0:\n+            raise ValueError(f\"Invalid wind sensor height {z} for station {station.station_id}\")\n+        factor = 4.87 / np.log(67.8 * z - 5.42)\n+        u2 = raw_wind * factor\n+    else:\n+        u2 = raw_wind\n+\n+    # ---- Solar radiation conversion --------------------------------------------\n+    raw_rs = raw[\"solar_rad\"].astype(float)\n+    if getattr(station, \"radiation_units\", \"MJ/m2/day\") == \"W/m2\":\n+        rs = raw_rs * 0.0864\n+    else:\n+        rs = raw_rs\n+\n+    df[\"u2\"] = u2\n+    df[\"rs\"] = rs\n+    return df\n+\n*** End Patch\nEOF\n"]
[130.299376, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[130.299428, "o", "\u001b[?2004h"]
[130.299459, "o", "> "]
[130.299731, "o", "\"\"\"Read one station's raw daily file and convert it to the standard inputs required by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[130.299765, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[130.299797, "o", "\u001b[?2004h> "]
[130.299875, "o", "+The raw CSV files may contain:\r\n\u001b[?2004l\r"]
[130.299919, "o", "\u001b[?2004h"]
[130.299951, "o", "> "]
[130.300113, "o", "+* Wind speed measured at a height other than 2 m (``wind_ms`` column).\r\n\u001b[?2004l\r"]
[130.300137, "o", "\u001b[?2004h> "]
[130.300349, "o", "+* Solar radiation expressed in Watts per square metre (``solar_rad`` column).\r\n\u001b[?2004l\r"]
[130.30039, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[130.300411, "o", "\u001b[?2004h"]
[130.300438, "o", "> "]
[130.300887, "o", "+FAO‑56 requires wind speed at 2 m (``u2``) in m s⁻¹ and radiation in MJ m⁻² day⁻¹ (``rs``). This module performs those conversions before returning a DataFrame.\r\n\u001b[?2004l\r"]
[130.300907, "o", "\u001b[?2004h> "]
[130.300932, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[130.300953, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[130.300973, "o", "\u001b[?2004h"]
[130.300993, "o", "> "]
[130.301014, "o", "+import os\r\n\u001b[?2004l\r"]
[130.301033, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[130.301053, "o", "\u001b[?2004h"]
[130.301071, "o", "> "]
[130.301106, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[130.301123, "o", "\u001b[?2004h"]
[130.301143, "o", "> "]
[130.301182, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[130.3012, "o", "\u001b[?2004h"]
[130.301219, "o", "> +\r\n\u001b[?2004l\r"]
[130.30124, "o", "\u001b[?2004h> "]
[130.301288, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[130.301309, "o", "\u001b[?2004h> "]
[130.301328, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.301347, "o", "> "]
[130.301524, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[130.301548, "o", "\u001b[?2004h"]
[130.301567, "o", "> "]
[130.301775, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[130.301794, "o", "\u001b[?2004h"]
[130.301812, "o", "> +\r\n\u001b[?2004l\r"]
[130.301831, "o", "\u001b[?2004h> "]
[130.30185, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.301869, "o", "> "]
[130.301954, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[130.301974, "o", "\u001b[?2004h"]
[130.301992, "o", "> "]
[130.302193, "o", "+    \"\"\"Load a station's raw CSV and return a DataFrame with standardized columns.\r\n\u001b[?2004l\r"]
[130.302213, "o", "\u001b[?2004h"]
[130.302231, "o", "> +\r\n\u001b[?2004l\r"]
[130.302249, "o", "\u001b[?2004h> "]
[130.302433, "o", "+    Returned columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[130.302453, "o", "\u001b[?2004h"]
[130.302471, "o", "> "]
[130.302487, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[130.302506, "o", "\u001b[?2004h> "]
[130.302679, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[130.302696, "o", "\u001b[?2004h"]
[130.302715, "o", "> "]
[130.302772, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[130.302791, "o", "\u001b[?2004h"]
[130.302811, "o", "> +\r\n\u001b[?2004l\r"]
[130.302829, "o", "\u001b[?2004h> "]
[130.302956, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[130.302975, "o", "\u001b[?2004h> "]
[130.303223, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[130.303242, "o", "\u001b[?2004h"]
[130.303261, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.303279, "o", "> "]
[130.303532, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[130.303554, "o", "\u001b[?2004h> "]
[130.303596, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[130.303618, "o", "\u001b[?2004h> "]
[130.30379, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[130.30381, "o", "\u001b[?2004h"]
[130.303831, "o", "> +\r\n"]
[130.303851, "o", "\u001b[?2004l\r\u001b[?2004h"]
[130.303873, "o", "> "]
[130.304014, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[130.304032, "o", "\u001b[?2004h"]
[130.304051, "o", "> "]
[130.304104, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[130.304123, "o", "\u001b[?2004h"]
[130.304141, "o", "> "]
[130.304245, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[130.304265, "o", "\u001b[?2004h"]
[130.304285, "o", "> "]
[130.3044, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[130.304417, "o", "\u001b[?2004h"]
[130.304437, "o", "> "]
[130.304547, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[130.304566, "o", "\u001b[?2004h"]
[130.304585, "o", "> "]
[130.304707, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[130.304725, "o", "\u001b[?2004h"]
[130.304745, "o", "> "]
[130.304845, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[130.304864, "o", "\u001b[?2004h"]
[130.304881, "o", "> "]
[130.304904, "o", "+    })\r\n\u001b[?2004l\r"]
[130.304924, "o", "\u001b[?2004h"]
[130.304942, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.30496, "o", "> "]
[130.305174, "o", "+    # ---- Actual vapour pressure ------------------------------------------------\r\n\u001b[?2004l\r"]
[130.305198, "o", "\u001b[?2004h"]
[130.305218, "o", "> "]
[130.305303, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[130.305321, "o", "\u001b[?2004h"]
[130.305339, "o", "> "]
[130.30555, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[130.305571, "o", "\u001b[?2004h> "]
[130.305603, "o", "+    else:\r\n\u001b[?2004l\r"]
[130.305622, "o", "\u001b[?2004h"]
[130.305651, "o", "> "]
[130.305774, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[130.305798, "o", "\u001b[?2004h> "]
[130.305892, "o", "+            df[\"tmax\"], df[\"tmin\"],\r\n\u001b[?2004l\r"]
[130.305912, "o", "\u001b[?2004h"]
[130.30593, "o", "> "]
[130.306042, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[130.306065, "o", "\u001b[?2004h> "]
[130.306182, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[130.306203, "o", "\u001b[?2004h"]
[130.30622, "o", "> "]
[130.306245, "o", "+        )\r\n\u001b[?2004l\r"]
[130.306262, "o", "\u001b[?2004h"]
[130.30628, "o", "> +\r\n"]
[130.306298, "o", "\u001b[?2004l\r\u001b[?2004h"]
[130.306316, "o", "> "]
[130.30654, "o", "+    # ---- Wind speed conversion to 2 m height (FAO‑56 Eq. 47) --------------------\r\n\u001b[?2004l\r"]
[130.306559, "o", "\u001b[?2004h"]
[130.306578, "o", "> "]
[130.306693, "o", "+    raw_wind = raw[\"wind_ms\"].astype(float)\r\n\u001b[?2004l\r"]
[130.306722, "o", "\u001b[?2004h> "]
[130.306858, "o", "+    if getattr(station, \"wind_height_m\", 2.0) != 2.0:\r\n\u001b[?2004l\r"]
[130.306877, "o", "\u001b[?2004h"]
[130.306895, "o", "> "]
[130.30698, "o", "+        z = station.wind_height_m\r\n\u001b[?2004l\r"]
[130.307001, "o", "\u001b[?2004h> "]
[130.307096, "o", "+        if (67.8 * z - 5.42) <= 0:\r\n\u001b[?2004l\r"]
[130.307115, "o", "\u001b[?2004h"]
[130.307134, "o", "> "]
[130.307379, "o", "+            raise ValueError(f\"Invalid wind sensor height {z} for station {station.station_id}\")\r\n\u001b[?2004l\r"]
[130.3074, "o", "\u001b[?2004h> "]
[130.307532, "o", "+        factor = 4.87 / np.log(67.8 * z - 5.42)\r\n\u001b[?2004l\r"]
[130.307554, "o", "\u001b[?2004h"]
[130.307572, "o", "> "]
[130.307645, "o", "+        u2 = raw_wind * factor\r\n\u001b[?2004l\r"]
[130.307662, "o", "\u001b[?2004h"]
[130.30768, "o", "> "]
[130.307705, "o", "+    else:\r\n\u001b[?2004l\r"]
[130.307718, "o", "\u001b[?2004h"]
[130.307736, "o", "> "]
[130.307792, "o", "+        u2 = raw_wind\r\n\u001b[?2004l\r"]
[130.307811, "o", "\u001b[?2004h> "]
[130.30783, "o", "+\r\n\u001b[?2004l\r"]
[130.307848, "o", "\u001b[?2004h> "]
[130.308096, "o", "+    # ---- Solar radiation conversion --------------------------------------------\r\n\u001b[?2004l\r"]
[130.308141, "o", "\u001b[?2004h> "]
[130.308239, "o", "+    raw_rs = raw[\"solar_rad\"].astype(float)\r\n\u001b[?2004l\r"]
[130.308251, "o", "\u001b[?2004h> "]
[130.308441, "o", "+    if getattr(station, \"radiation_units\", \"MJ/m2/day\") == \"W/m2\":\r\n\u001b[?2004l\r"]
[130.308476, "o", "\u001b[?2004h> "]
[130.308562, "o", "+        rs = raw_rs * 0.0864\r\n\u001b[?2004l\r"]
[130.308588, "o", "\u001b[?2004h"]
[130.308605, "o", "> "]
[130.308628, "o", "+    else:\r\n\u001b[?2004l\r"]
[130.308656, "o", "\u001b[?2004h"]
[130.308686, "o", "> "]
[130.308743, "o", "+        rs = raw_rs\r\n\u001b[?2004l\r"]
[130.308769, "o", "\u001b[?2004h"]
[130.30878, "o", "> +\r\n\u001b[?2004l\r"]
[130.308812, "o", "\u001b[?2004h> "]
[130.308877, "o", "+    df[\"u2\"] = u2\r\n\u001b[?2004l\r"]
[130.3089, "o", "\u001b[?2004h> "]
[130.308965, "o", "+    df[\"rs\"] = rs\r\n\u001b[?2004l\r"]
[130.30899, "o", "\u001b[?2004h"]
[130.30901, "o", "> "]
[130.309043, "o", "+    return df\r\n\u001b[?2004l\r"]
[130.309071, "o", "\u001b[?2004h"]
[130.309093, "o", "> +\r\n\u001b[?2004l\r"]
[130.309112, "o", "\u001b[?2004h> "]
[130.30916, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[130.309181, "o", "\u001b[?2004h"]
[130.309192, "o", "> "]
[130.309218, "o", "EOF\r\n\u001b[?2004l\r"]
[130.310827, "o", "\u001b[?2004h"]
[130.310864, "o", "root@3aa2b692-c514-41ad-a921-1fef92e5c19e:/app# "]
