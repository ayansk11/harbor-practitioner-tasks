[?2004l[?2004h> +        )
[?2004l[?2004h> +
[?2004l[?2004h> +    # Wind speed conversion to 2 m height
[?2004l[?2004h> +    df["u2"] = _wind_to_2m(raw["wind_ms"].astype(float), station.wind_height_m)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Solar radiation conversion based on the unit declared in the station register
[?2004l[?2004h> +    df["rs"] = _convert_radiation(raw["solar_rad"].astype(float), station.radiation_units)
[?2004l[?2004h> +    return df
