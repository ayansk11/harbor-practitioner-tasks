[?2004l[?2004h> # load station metadata for PAL
[?2004l[?2004h> stations = meta.load_stations('config/stations.yaml')
[?2004l[?2004h> pal = next(s for s in stations if s.station_id == 'PAL')
[?2004l[?2004h> # load raw first row
[?2004l[?2004h> raw = pd.read_csv('data/raw/PAL.csv').iloc[0]
[?2004l[?2004h> # compute ea using rh_minmax
[?2004l[?2004h> ea = fao56.actual_vapour_pressure_rh(raw['tmax_c'], raw['tmin_c'], raw['rh_max_pct'], raw['rh_min_pct'])
[?2004l[?2004h> # wind conversion
[?2004l[?2004h> u2 = (4.87 / np.log(67.8 * pal.wind_height_m - 5.42)) * raw['wind_ms']
[?2004l[?2004h> # radiation conversion (units MJ already)
[?2004l[?2004h> rs = raw['solar_rad']
[?2004l[?2004h> # day of year
[?2004l[?2004h> date = pd.to_datetime(raw['date'])
[?2004l[?2004h> doy = date.dayofyear
[?2004l[?2004h> et0 = fao56.et0_daily(raw['tmax_c'], raw['tmin_c'], u2, rs, ea, doy, pal.latitude, pal.elevation_m)
