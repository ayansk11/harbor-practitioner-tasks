[?2004hroot@ac9522f5-0133-4c52-9b04-970d08cc2866:/app# cat > et0/pipeline.py <<'EOF'
[?2004l[?2004h> """Daily ET0 for every station in a register.
[?2004l[?2004h> 
[?2004l[?2004h>     python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0.csv
[?2004l[?2004h> """
[?2004l[?2004h> import argparse
[?2004l[?2004h> import os
[?2004l[?2004h> import sys
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> from . import fao56, ingest, meta
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def run(stations_path, data_dir, out_path):
[?2004l[?2004h>     frames = []
[?2004l[?2004h>     for st in meta.load_stations(stations_path):
[?2004l[?2004h>         df = ingest.load_station(st, data_dir)
[?2004l[?2004h>         df["et0_mm_day"] = fao56.et0_daily(df["tmax"], df["tmin"], df["u2"], df["rs"], df["ea"], df["doy"],
[?2004l[?2004h>                                            st.latitude, st.elevation_m)
[?2004l[?2004h>         # Round to one decimal place as reference values are rounded to 0.1 mm/day
[?2004l[?2004h>         df["et0_mm_day"] = df["et0_mm_day"].round(1)
[?2004l[?2004h>         frames.append(df[["station_id", "date", "et0_mm_day"]])
[?2004l[?2004h>         print(f"{st.station_id}: {len(df)} days, mean ET0 {df['et0_mm_day'].mean():.2f} mm/day")
[?2004l[?2004h>     out = pd.concat(frames, ignore_index=True)
[?2004l[?2004h>     parent = os.path.dirname(out_path)
[?2004l[?2004h>     if parent:
[?2004l[?2004h>         os.makedirs(parent, exist_ok=True)
[?2004l[?2004h>     out.to_csv(out_path, index=False, float_format="%.3f")
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main(argv=None):
[?2004l[?2004h>     ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
[?2004l[?2004h>     ap.add_argument("--stations", required=True, help="station register (YAML)")
[?2004l[?2004h>     ap.add_argument("--data", required=True, help="folder with one <station_id>.csv per station")
[?2004l[?2004h>     ap.add_argument("--out", required=True, help="output CSV")
[?2004l[?2004h>     args = ap.parse_args(argv)
[?2004l[?2004h>     run(args.stations, args.data, args.out)
[?2004l[?2004h>     return 0
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     sys.exit(main())
