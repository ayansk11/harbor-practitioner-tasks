[?2004l[?2004h> +
[?2004l[?2004h> +   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.
[?2004l[?2004h> +
[?2004l[?2004h> +2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is
[?2004l[?2004h> +   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).
[?2004l[?2004h> +
[?2004l[?2004h> +These conversions are applied after the raw CSV is read and before the DataFrame is returned.
[?2004l[?2004h> +"""
[?2004l[?2004h> +
[?2004l[?2004h> +import os
[?2004l[?2004h> +import numpy as np
[?2004l[?2004h> +import pandas as pd
[?2004l[?2004h> +
[?2004l[?2004h> +from . import fao56
[?2004l[?2004h> +
[?2004l[?2004h> +BASE_COLUMNS = ["date", "tmax_c", "tmin_c", "wind_ms", "solar_rad"]
[?2004l[?2004h> +HUMIDITY_COLUMNS = {"rh_minmax": ["rh_max_pct", "rh_min_pct"], "dewpoint": ["tdew_c"]}
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def _wind_to_2m(wind, height_m):
[?2004l[?2004h> +    """Convert wind speed measured at ``height_m`` to the standard 2 m height.
[?2004l[?2004h> +
[?2004l[?2004h> +    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    wind = np.asarray(wind, float)
[?2004l[?2004h> +    height = np.asarray(height_m, float)
[?2004l[?2004h> +    factor = 4.87 / np.log(67.8 * height - 5.42)
[?2004l[?2004h> +    return wind * factor
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def _convert_radiation(rs, units):
[?2004l[?2004h> +    """Convert solar radiation to MJ m⁻² day⁻¹.
[?2004l[?2004h> +
[?2004l[?2004h> +    ``units`` is the string from the station register (e.g. "MJ/m2/day" or "W/m2").
[?2004l[?2004h> +    If the units contain the letter "w" we assume Watts per square metre and convert using
[?2004l[?2004h> +    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).
[?2004l[?2004h> +    """
[?2004l[?2004h> +    rs = np.asarray(rs, float)
[?2004l[?2004h> +    low = units.lower()
[?2004l[?2004h> +    if "w" in low:
[?2004l[?2004h> +        return rs * 86400.0 / 1e6
[?2004l[?2004h> +    return rs
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def load_station(station, data_dir):
[?2004l[?2004h> +    """Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units)."""
[?2004l[?2004h> +    path = os.path.join(data_dir, f"{station.station_id}.csv")
[?2004l[?2004h> +    raw = pd.read_csv(path)
[?2004l[?2004h> +    if station.humidity not in HUMIDITY_COLUMNS:
[?2004l[?2004h> +        raise ValueError(f"{station.station_id}: unknown humidity type {station.humidity!r}")
[?2004l[?2004h> +    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]
[?2004l[?2004h> +    if missing:
[?2004l[?2004h> +        raise ValueError(f"{path}: missing columns {missing}")
[?2004l[?2004h> +
[?2004l[?2004h> +    dates = pd.to_datetime(raw["date"], format="%Y-%m-%d")
[?2004l[?2004h> +    df = pd.DataFrame({
[?2004l[?2004h> +        "station_id": station.station_id,
[?2004l[?2004h> +        "date": dates.dt.strftime("%Y-%m-%d"),
[?2004l[?2004h> +        "doy": dates.dt.dayofyear.astype(int),
[?2004l[?2004h> +        "tmax": raw["tmax_c"].astype(float),
[?2004l[?2004h> +        "tmin": raw["tmin_c"].astype(float),
[?2004l[?2004h> +    })
[?2004l[?2004h> +
[?2004l[?2004h> +    # Vapour pressure (ea)
[?2004l[?2004h> +    if station.humidity == "dewpoint":
[?2004l[?2004h> +        df["ea"] = fao56.actual_vapour_pressure_dewpoint(raw["tdew_c"].astype(float))
[?2004l[?2004h> +    else:
[?2004l[?2004h> +        df["ea"] = fao56.actual_vapour_pressure_rh(
[?2004l[?2004h> +            df["tmax"], df["tmin"], raw["rh_max_pct"].astype(float), raw["rh_min_pct"].astype(float)
[?2004l[?2004h> +        )
[?2004l[?2004h> +
[?2004l[?2004h> +    # Wind speed conversion to 2 m height
[?2004l[?2004h> +    df["u2"] = _wind_to_2m(raw["wind_ms"].astype(float), station.wind_height_m)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Solar radiation conversion based on the unit declared in the station register
[?2004l[?2004h> +    df["rs"] = _convert_radiation(raw["solar_rad"].astype(float), station.radiation_units)
[?2004l[?2004h> +    return df
[?2004l[?2004h> +
[?2004l[?2004h> +EOF
[?2004l[?2004h> python -m et0.selfcheck
[?2004l[?2004h> cd /app && python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0_fixed.csv
[?2004l[?2004h> head -n 5 output/et0_fixed.csv
