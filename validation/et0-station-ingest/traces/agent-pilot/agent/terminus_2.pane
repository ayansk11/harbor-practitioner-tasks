[?2004l[?2004h> +        df["ea"] = fao56.actual_vapour_pressure_dewpoint(raw["tdew_c"].astype(float))
[?2004l[?2004h> +    else:
[?2004l[?2004h> +        df["ea"] = fao56.actual_vapour_pressure_rh(
[?2004l[?2004h> +            df["tmax"], df["tmin"], raw["rh_max_pct"].astype(float), raw["rh_min_pct"].astype(float)
[?2004l[?2004h> +        )
