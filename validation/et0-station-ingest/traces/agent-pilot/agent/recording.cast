[429.500402, "o", "import os\r\n\u001b[?2004l\r"]
[429.500411, "o", "\u001b[?2004h"]
[429.500432, "o", "> "]
[429.500489, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[429.500501, "o", "\u001b[?2004h"]
[429.500546, "o", "> "]
[429.500581, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[429.500623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.500633, "o", "\u001b[?2004h> "]
[429.500705, "o", "from . import fao56\r\n\u001b[?2004l\r"]
[429.500747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.500757, "o", "\u001b[?2004h> "]
[429.500978, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[429.501024, "o", "\u001b[?2004h> "]
[429.501287, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[429.501337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.501346, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.501385, "o", "\u001b[?2004h> "]
[429.501489, "o", "def _wind_to_2m(wind, height_m):\r\n\u001b[?2004l\r"]
[429.501532, "o", "\u001b[?2004h> "]
[429.501738, "o", "    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n\u001b[?2004l\r"]
[429.501781, "o", "\u001b[?2004h> "]
[429.501791, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.502042, "o", "    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n\u001b[?2004l\r"]
[429.502085, "o", "\u001b[?2004h> "]
[429.502094, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[429.502136, "o", "\u001b[?2004h> "]
[429.502205, "o", "    wind = np.asarray(wind, float)\r\n\u001b[?2004l\r"]
[429.502215, "o", "\u001b[?2004h"]
[429.50226, "o", "> "]
[429.502335, "o", "    height = np.asarray(height_m, float)\r\n\u001b[?2004l\r"]
[429.502373, "o", "\u001b[?2004h> "]
[429.502484, "o", "    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n\u001b[?2004l\r"]
[429.502524, "o", "\u001b[?2004h> "]
[429.502576, "o", "    return wind * factor\r\n\u001b[?2004l\r"]
[429.502616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.502625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.502669, "o", "\u001b[?2004h> "]
[429.502742, "o", "def _convert_radiation(rs, units):\r\n\u001b[?2004l\r"]
[429.502785, "o", "\u001b[?2004h> "]
[429.502918, "o", "    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[429.502957, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.502969, "o", "\u001b[?2004h> "]
[429.50319, "o", "    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n\u001b[?2004l\r"]
[429.503199, "o", "\u001b[?2004h"]
[429.503244, "o", "> "]
[429.503447, "o", "    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n\u001b[?2004l\r"]
[429.503487, "o", "\u001b[?2004h> "]
[429.503729, "o", "    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\r\n\u001b[?2004l\r"]
[429.503739, "o", "\u001b[?2004h"]
[429.503785, "o", "> "]
[429.503794, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.503879, "o", "    rs = np.asarray(rs, float)\r\n\u001b[?2004l\r"]
[429.503918, "o", "\u001b[?2004h> "]
[429.503974, "o", "    low = units.lower()\r\n\u001b[?2004l\r"]
[429.503983, "o", "\u001b[?2004h"]
[429.504025, "o", "> "]
[429.504062, "o", "    if \"w\" in low:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.504158, "o", "        return rs * 86400.0 / 1e6\r\n\u001b[?2004l\r"]
[429.504198, "o", "\u001b[?2004h> "]
[429.504229, "o", "    return rs\r\n\u001b[?2004l\r"]
[429.50426, "o", "\u001b[?2004h> "]
[429.504268, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.504306, "o", "\u001b[?2004h> "]
[429.50439, "o", "def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[429.504429, "o", "\u001b[?2004h> "]
[429.504694, "o", "    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[429.504736, "o", "\u001b[?2004h"]
[429.504744, "o", "> "]
[429.50488, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[429.504923, "o", "\u001b[?2004h> "]
[429.504982, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[429.505007, "o", "\u001b[?2004h"]
[429.505037, "o", "> "]
[429.505131, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[429.505172, "o", "\u001b[?2004h> "]
[429.505394, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[429.505434, "o", "\u001b[?2004h> "]
[429.505675, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[429.505716, "o", "\u001b[?2004h> "]
[429.50575, "o", "    if missing:\r\n\u001b[?2004l\r\u001b[?2004h"]
[429.505759, "o", "> "]
[429.505925, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[429.505972, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.50598, "o", "\u001b[?2004h> "]
[429.506134, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[429.506175, "o", "\u001b[?2004h> "]
[429.506221, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[429.506259, "o", "\u001b[?2004h> "]
[429.506352, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[429.506392, "o", "\u001b[?2004h> "]
[429.506496, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[429.506536, "o", "\u001b[?2004h> "]
[429.506642, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[429.506682, "o", "\u001b[?2004h> "]
[429.506781, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[429.506823, "o", "\u001b[?2004h> "]
[429.506921, "o", "        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[429.506958, "o", "\u001b[?2004h> "]
[429.507026, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.507086, "o", "    # Vapour pressure (ea)\r\n\u001b[?2004l\r"]
[429.507126, "o", "\u001b[?2004h> "]
[429.50721, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[429.50725, "o", "\u001b[?2004h> "]
[429.507454, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[429.507495, "o", "\u001b[?2004h> "]
[429.507504, "o", "    else:\r\n\u001b[?2004l\r"]
[429.507543, "o", "\u001b[?2004h> "]
[429.507662, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[429.507701, "o", "\u001b[?2004h> "]
[429.507946, "o", "            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[429.508003, "o", "\u001b[?2004h> "]
[429.508013, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[429.508057, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.508166, "o", "    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[429.508205, "o", "\u001b[?2004h> "]
[429.508395, "o", "    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[429.508436, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.508444, "o", "\u001b[?2004h> "]
[429.508659, "o", "    # Solar radiation conversion based on the unit declared in the station register\r\n\u001b[?2004l\r"]
[429.5087, "o", "\u001b[?2004h> "]
[429.508924, "o", "    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[429.508971, "o", "\u001b[?2004h> "]
[429.509011, "o", "    return df\r\n\u001b[?2004l\r\u001b[?2004h"]
[429.509018, "o", "> \r\n\u001b[?2004l\r"]
[429.509063, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[429.511713, "o", "\u001b[?2004h"]
[429.511722, "o", "root@ac9522f5-0133-4c52-9b04-970d08cc2866:/app# "]
