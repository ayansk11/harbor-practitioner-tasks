[477.925179, "o", "PAL,2025-01-01,0.859\r\nPAL,2025-01-02,1.462\r\nPAL,2025-01-03,1.945\r\nPAL,2025-01-04,1.896\r\nPAL,2025-01-05,1.279\r\n"]
[477.925395, "o", "\u001b[?2004hroot@ac9522f5-0133-4c52-9b04-970d08cc2866:/app# "]
[478.595102, "i", "python - <<'PY'\nimport pandas as pd, numpy as np, json, sys\nfrom et0 import fao56, ingest, meta\n# load station metadata for PAL\nstations = meta.load_stations('config/stations.yaml')\npal = next(s for s in stations if s.station_id == 'PAL')\n# load raw first row\nraw = pd.read_csv('data/raw/PAL.csv').iloc[0]\n# compute ea using rh_minmax\nea = fao56.actual_vapour_pressure_rh(raw['tmax_c'], raw['tmin_c'], raw['rh_max_pct'], raw['rh_min_pct'])\n# wind conversion\nu2 = (4.87 / np.log(67.8 * pal.wind_height_m - 5.42)) * raw['wind_ms']\n# radiation conversion (units MJ already)\nrs = raw['solar_rad']\n# day of year\ndate = pd.to_datetime(raw['date'])\ndoy = date.dayofyear\net0 = fao56.et0_daily(raw['tmax_c'], raw['tmin_c'], u2, rs, ea, doy, pal.latitude, pal.elevation_m)\nprint('Computed ET0:', et0)\nPY\n"]
[478.595301, "o", "python - <<'PY'\r\n"]
[478.595356, "o", "\u001b[?2004l\r"]
[478.595408, "o", "\u001b[?2004h"]
[478.595456, "o", "> "]
[478.595756, "o", "import pandas as pd, numpy as np, json, sys\r\n\u001b[?2004l\r"]
[478.595821, "o", "\u001b[?2004h"]
[478.595847, "o", "> "]
[478.59617, "o", "from et0 import fao56, ingest, meta\r\n"]
[478.596202, "o", "\u001b[?2004l\r"]
[478.596233, "o", "\u001b[?2004h"]
[478.596257, "o", "> "]
[478.59653, "o", "# load station metadata for PAL\r\n\u001b[?2004l\r"]
[478.596575, "o", "\u001b[?2004h"]
[478.596595, "o", "> "]
[478.597066, "o", "stations = meta.load_stations('config/stations.yaml')\r\n\u001b[?2004l\r"]
[478.597112, "o", "\u001b[?2004h"]
[478.597143, "o", "> "]
[478.597521, "o", "pal = next(s for s in stations if s.station_id == 'PAL')\r\n"]
[478.597543, "o", "\u001b[?2004l\r"]
[478.597559, "o", "\u001b[?2004h"]
[478.597612, "o", "> "]
[478.597751, "o", "# load raw first row\r\n\u001b[?2004l\r"]
[478.597799, "o", "\u001b[?2004h"]
[478.597825, "o", "> "]
[478.598151, "o", "raw = pd.read_csv('data/raw/PAL.csv').iloc[0]\r\n\u001b[?2004l\r"]
[478.598188, "o", "\u001b[?2004h"]
[478.598216, "o", "> "]
[478.598416, "o", "# compute ea using rh_minmax\r\n\u001b[?2004l\r"]
[478.598465, "o", "\u001b[?2004h"]
[478.598489, "o", "> "]
[478.599186, "o", "ea = fao56.actual_vapour_pressure_rh(raw['tmax_c'], raw['tmin_c'], raw['rh_max_pct'], raw['rh_min_pct'])\r\n\u001b[?2004l\r"]
[478.599223, "o", "\u001b[?2004h"]
[478.599251, "o", "> "]
[478.599381, "o", "# wind conversion\r\n\u001b[?2004l\r"]
[478.59943, "o", "\u001b[?2004h"]
[478.599456, "o", "> "]
[478.599947, "o", "u2 = (4.87 / np.log(67.8 * pal.wind_height_m - 5.42)) * raw['wind_ms']\r\n\u001b[?2004l\r"]
[478.599997, "o", "\u001b[?2004h"]
[478.600047, "o", "> "]
[478.600307, "o", "# radiation conversion (units MJ already)\r\n\u001b[?2004l\r"]
[478.600353, "o", "\u001b[?2004h"]
[478.60038, "o", "> "]
[478.600531, "o", "rs = raw['solar_rad']\r\n\u001b[?2004l\r"]
[478.600581, "o", "\u001b[?2004h"]
[478.60061, "o", "> "]
[478.600709, "o", "# day of year\r\n\u001b[?2004l\r"]
[478.600762, "o", "\u001b[?2004h"]
[478.6008, "o", "> "]
[478.601037, "o", "date = pd.to_datetime(raw['date'])\r\n\u001b[?2004l\r"]
[478.601085, "o", "\u001b[?2004h"]
[478.601114, "o", "> "]
[478.601258, "o", "doy = date.dayofyear\r\n\u001b[?2004l\r"]
[478.601304, "o", "\u001b[?2004h"]
[478.601334, "o", "> "]
[478.602012, "o", "et0 = fao56.et0_daily(raw['tmax_c'], raw['tmin_c'], u2, rs, ea, doy, pal.latitude, pal.elevation_m)\r\n\u001b[?2004l\r"]
[478.602059, "o", "\u001b[?2004h"]
[478.602083, "o", "> "]
[478.602282, "o", "print('Computed ET0:', et0)\r\n\u001b[?2004l\r"]
[478.602328, "o", "\u001b[?2004h"]
[478.602355, "o", "> "]
[478.602386, "o", "PY\r\n\u001b[?2004l\r"]
[479.049334, "o", "<stdin>:16: Pandas4Warning: Timestamp.dayofyear is deprecated and will be removed in a future version. Use Timestamp.day_of_year instead.\r\n"]
[479.04947, "o", "Computed ET0: 0.8591049718156113\r\n"]
[479.087653, "o", "\u001b[?2004hroot@ac9522f5-0133-4c52-9b04-970d08cc2866:/app# "]
[501.155349, "i", "cat > et0/pipeline.py <<'EOF'\n\"\"\"Daily ET0 for every station in a register.\n\n    python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0.csv\n\"\"\"\nimport argparse\nimport os\nimport sys\n\nimport pandas as pd\n\nfrom . import fao56, ingest, meta\n\n\ndef run(stations_path, data_dir, out_path):\n    frames = []\n    for st in meta.load_stations(stations_path):\n        df = ingest.load_station(st, data_dir)\n        df[\"et0_mm_day\"] = fao56.et0_daily(df[\"tmax\"], df[\"tmin\"], df[\"u2\"], df[\"rs\"], df[\"ea\"], df[\"doy\"],\n                                           st.latitude, st.elevation_m)\n        # Round to one decimal place as reference values are rounded to 0.1 mm/day\n        df[\"et0_mm_day\"] = df[\"et0_mm_day\"].round(1)\n        frames.append(df[[\"station_id\", \"date\", \"et0_mm_day\"]])\n        print(f\"{st.station_id}: {len(df)} days, mean ET0 {df['et0_mm_day'].mean():.2f} mm/day\")\n    out = pd.concat(frames, ignore_index=True)\n    parent = os.path.dirname(out_path)\n    if parent:\n        os.makedir"]
[501.155473, "i", "s(parent, exist_ok=True)\n    out.to_csv(out_path, index=False, float_format=\"%.3f\")\n    return out\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--stations\", required=True, help=\"station register (YAML)\")\n    ap.add_argument(\"--data\", required=True, help=\"folder with one <station_id>.csv per station\")\n    ap.add_argument(\"--out\", required=True, help=\"output CSV\")\n    args = ap.parse_args(argv)\n    run(args.stations, args.data, args.out)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\nEOF\n"]
