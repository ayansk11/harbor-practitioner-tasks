[130.037477, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\n+before the data can be fed to the FAO‑56 equations:\n+\n+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\n+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\n+   (FAO‑56 Eq. 47):\n+\n+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\n+\n+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\n+\n+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\n+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\n+\n+These conversions are applied after the raw CSV is read and befo"]
[130.037674, "i", "re the DataFrame is returned.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _wind_to_2m(wind, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\n+\n+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\n+    \"\"\"\n+    wind = np.asarray(wind, float)\n+    height = np.asarray(height_m, float)\n+    factor = 4.87 / np.log(67.8 * height - 5.42)\n+    return wind * factor\n+\n+\n+def _convert_radiation(rs, units):\n+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\n+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\n+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be M"]
[130.037742, "i", "J).\n+    \"\"\"\n+    rs = np.asarray(rs, float)\n+    low = units.lower()\n+    if \"w\" in low:\n+        return rs * 86400.0 / 1e6\n+    return rs\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+        \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype("]
[130.037796, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[130.037844, "i", "float),\n+    })\n+\n+    # Vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion based on the unit declared in the station register\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+    return df\n+\n+EOF\n"]
[130.037914, "o", "\u001b[?2004h"]
[130.037957, "o", "> "]
[130.038659, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[130.038705, "o", "\u001b[?2004h"]
[130.038749, "o", "> +\r\n\u001b[?2004l\r"]
[130.038798, "o", "\u001b[?2004h> "]
[130.03963, "o", "+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\r\n\u001b[?2004l\r"]
[130.039674, "o", "\u001b[?2004h"]
[130.039713, "o", "> "]
[130.040156, "o", "+before the data can be fed to the FAO‑56 equations:\r\n\u001b[?2004l\r"]
[130.0402, "o", "\u001b[?2004h"]
[130.040236, "o", "> +\r\n\u001b[?2004l\r"]
[130.040293, "o", "\u001b[?2004h"]
[130.040329, "o", "> "]
[130.04123, "o", "+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\r\n\u001b[?2004l\r"]
[130.041273, "o", "\u001b[?2004h"]
[130.041309, "o", "> "]
[130.042208, "o", "+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\r\n\u001b[?2004l\r"]
[130.04225, "o", "\u001b[?2004h"]
[130.042286, "o", "> "]
[130.042472, "o", "+   (FAO‑56 Eq. 47):\r\n\u001b[?2004l\r"]
[130.042516, "o", "\u001b[?2004h"]
[130.042552, "o", "> +\r\n\u001b[?2004l\r"]
[130.042604, "o", "\u001b[?2004h"]
[130.04264, "o", "> "]
[130.042999, "o", "+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\r\n\u001b[?2004l\r"]
[130.043044, "o", "\u001b[?2004h"]
[130.043081, "o", "> +\r\n\u001b[?2004l\r"]
[130.043132, "o", "\u001b[?2004h"]
[130.043169, "o", "> "]
[130.043851, "o", "+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n\u001b[?2004l\r"]
[130.043892, "o", "\u001b[?2004h"]
[130.04393, "o", "> +\r\n\u001b[?2004l\r"]
[130.043988, "o", "\u001b[?2004h"]
[130.044026, "o", "> "]
[130.045022, "o", "+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\r\n\u001b[?2004l\r"]
[130.045068, "o", "\u001b[?2004h"]
[130.045105, "o", "> "]
[130.046005, "o", "+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\r\n\u001b[?2004l\r"]
[130.04605, "o", "\u001b[?2004h"]
[130.046087, "o", "> +\r\n\u001b[?2004l\r"]
[130.046139, "o", "\u001b[?2004h"]
[130.046175, "o", "> "]
[130.046896, "o", "+These conversions are applied after the raw CSV is read and before the DataFrame is returned.\r\n\u001b[?2004l\r"]
[130.046954, "o", "\u001b[?2004h"]
[130.047009, "o", "> "]
[130.047046, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[130.047082, "o", "\u001b[?2004h"]
[130.047121, "o", "> +\r\n\u001b[?2004l\r"]
[130.047168, "o", "\u001b[?2004h"]
[130.047203, "o", "> "]
[130.047281, "o", "+import os\r\n\u001b[?2004l\r"]
[130.047324, "o", "\u001b[?2004h"]
[130.047361, "o", "> "]
[130.047507, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[130.04755, "o", "\u001b[?2004h"]
[130.047587, "o", "> "]
[130.04774, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[130.047782, "o", "\u001b[?2004h"]
[130.047817, "o", "> +\r\n"]
[130.047853, "o", "\u001b[?2004l\r"]
[130.047895, "o", "\u001b[?2004h> "]
[130.04808, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[130.048133, "o", "\u001b[?2004h"]
[130.048177, "o", "> +\r\n\u001b[?2004l\r"]
[130.048221, "o", "\u001b[?2004h"]
[130.048257, "o", "> "]
[130.048772, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[130.048816, "o", "\u001b[?2004h"]
[130.048852, "o", "> "]
[130.049528, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[130.049574, "o", "\u001b[?2004h"]
[130.049613, "o", "> +\r\n"]
[130.049651, "o", "\u001b[?2004l\r\u001b[?2004h"]
[130.049687, "o", "> "]
[130.049726, "o", "+\r\n\u001b[?2004l\r"]
[130.049771, "o", "\u001b[?2004h"]
[130.049812, "o", "> "]
[130.050074, "o", "+def _wind_to_2m(wind, height_m):\r\n\u001b[?2004l\r"]
[130.050119, "o", "\u001b[?2004h"]
[130.050169, "o", "> "]
[130.050812, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n\u001b[?2004l\r"]
[130.050884, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[130.050934, "o", "\u001b[?2004h> "]
[130.051669, "o", "+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n\u001b[?2004l\r"]
[130.051713, "o", "\u001b[?2004h> "]
[130.051805, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[130.051859, "o", "\u001b[?2004h> "]
[130.052166, "o", "+    wind = np.asarray(wind, float)\r\n\u001b[?2004l\r"]
[130.05222, "o", "\u001b[?2004h> "]
[130.052555, "o", "+    height = np.asarray(height_m, float)\r\n\u001b[?2004l\r"]
[130.052614, "o", "\u001b[?2004h> "]
[130.053035, "o", "+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n\u001b[?2004l\r"]
[130.053083, "o", "\u001b[?2004h"]
[130.053131, "o", "> "]
[130.053308, "o", "+    return wind * factor\r\n\u001b[?2004l\r"]
[130.053354, "o", "\u001b[?2004h"]
[130.0534, "o", "> +\r\n\u001b[?2004l\r"]
[130.053447, "o", "\u001b[?2004h"]
[130.05349, "o", "> +\r\n\u001b[?2004l\r"]
[130.053546, "o", "\u001b[?2004h> "]
[130.053872, "o", "+def _convert_radiation(rs, units):\r\n\u001b[?2004l\r"]
[130.053942, "o", "\u001b[?2004h> "]
[130.054418, "o", "+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[130.054481, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[130.054523, "o", "\u001b[?2004h"]
[130.054566, "o", "> "]
[130.055245, "o", "+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n\u001b[?2004l\r"]
[130.055298, "o", "\u001b[?2004h> "]
[130.056022, "o", "+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n\u001b[?2004l\r"]
[130.056081, "o", "\u001b[?2004h> "]
[130.056854, "o", "+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\r\n\u001b[?2004l\r"]
[130.056898, "o", "\u001b[?2004h"]
[130.056959, "o", "> "]
[130.057016, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[130.057059, "o", "\u001b[?2004h"]
[130.057102, "o", "> "]
[130.057326, "o", "+    rs = np.asarray(rs, float)\r\n\u001b[?2004l\r"]
[130.057375, "o", "\u001b[?2004h"]
[130.057417, "o", "> "]
[130.057592, "o", "+    low = units.lower()\r\n\u001b[?2004l\r"]
[130.057642, "o", "\u001b[?2004h"]
[130.057687, "o", "> "]
[130.057818, "o", "+    if \"w\" in low:\r\n\u001b[?2004l\r"]
[130.057867, "o", "\u001b[?2004h"]
[130.057916, "o", "> "]
[130.058176, "o", "+        return rs * 86400.0 / 1e6\r\n\u001b[?2004l\r"]
[130.058215, "o", "\u001b[?2004h"]
[130.058263, "o", "> "]
[130.058373, "o", "+    return rs\r\n\u001b[?2004l\r"]
[130.058412, "o", "\u001b[?2004h"]
[130.058458, "o", "> +\r\n\u001b[?2004l\r"]
[130.05851, "o", "\u001b[?2004h> "]
[130.05855, "o", "+\r\n\u001b[?2004l\r"]
[130.058593, "o", "\u001b[?2004h"]
[130.05864, "o", "> "]
[130.058901, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[130.058946, "o", "\u001b[?2004h"]
[130.058996, "o", "> "]
[130.059875, "o", "+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[130.05993, "o", "\u001b[?2004h> "]
[130.060455, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[130.060501, "o", "\u001b[?2004h"]
[130.06054, "o", "> "]
[130.060761, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[130.060805, "o", "\u001b[?2004h"]
[130.060846, "o", "> "]
[130.061253, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[130.061301, "o", "\u001b[?2004h"]
[130.061379, "o", "> "]
[130.062135, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[130.06219, "o", "\u001b[?2004h"]
[130.062235, "o", "> "]
[130.06286, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n"]
[130.062901, "o", "\u001b[?2004l\r"]
[130.062942, "o", "\u001b[?2004h> "]
[130.063071, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[130.063219, "o", "\u001b[?2004h> "]
[130.063532, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[130.063575, "o", "\u001b[?2004h> "]
[130.063615, "o", "+\r\n"]
[130.063655, "o", "\u001b[?2004l\r\u001b[?2004h"]
[130.063695, "o", "> "]
[130.064065, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[130.064118, "o", "\u001b[?2004h> "]
[130.064287, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[130.064338, "o", "\u001b[?2004h> "]
[130.06462, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[130.064672, "o", "\u001b[?2004h> "]
[130.064993, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[130.065039, "o", "\u001b[?2004h"]
[130.06508, "o", "> "]
[130.065368, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[130.065416, "o", "\u001b[?2004h"]
[130.065457, "o", "> "]
[130.065718, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[130.065771, "o", "\u001b[?2004h> "]
[130.066092, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[130.066137, "o", "\u001b[?2004h> "]
[130.066205, "o", "+    })\r\n\u001b[?2004l\r"]
[130.066244, "o", "\u001b[?2004h> "]
[130.066281, "o", "+\r\n\u001b[?2004l\r"]
[130.066317, "o", "\u001b[?2004h> "]
[130.066514, "o", "+    # Vapour pressure (ea)\r\n\u001b[?2004l\r"]
[130.06655, "o", "\u001b[?2004h"]
[130.066587, "o", "> "]
[130.066828, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[130.066867, "o", "\u001b[?2004h"]
[130.066906, "o", "> "]
[130.067461, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[130.067501, "o", "\u001b[?2004h> "]
[130.06759, "o", "+    else:\r\n\u001b[?2004l\r"]
[130.067626, "o", "\u001b[?2004h"]
[130.067662, "o", "> "]
[130.067991, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[130.068039, "o", "\u001b[?2004h"]
[130.068075, "o", "> "]
[130.06871, "o", "+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[130.068757, "o", "\u001b[?2004h> "]
[130.068836, "o", "+        )\r\n\u001b[?2004l\r"]
[130.068874, "o", "\u001b[?2004h"]
[130.068913, "o", "> +\r\n\u001b[?2004l\r"]
[130.068949, "o", "\u001b[?2004h"]
[130.06901, "o", "> "]
[130.069273, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[130.069317, "o", "\u001b[?2004h"]
[130.069355, "o", "> "]
[130.069854, "o", "+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[130.069897, "o", "\u001b[?2004h> "]
[130.069935, "o", "+\r\n\u001b[?2004l\r"]
[130.070074, "o", "\u001b[?2004h> "]
[130.070541, "o", "+    # Solar radiation conversion based on the unit declared in the station register\r\n\u001b[?2004l\r"]
[130.070579, "o", "\u001b[?2004h"]
[130.070616, "o", "> "]
[130.071242, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[130.071279, "o", "\u001b[?2004h> "]
[130.071397, "o", "+    return df\r\n\u001b[?2004l\r"]
[130.071443, "o", "\u001b[?2004h"]
[130.071482, "o", "> +\r\n\u001b[?2004l\r"]
[130.071517, "o", "\u001b[?2004h"]
[130.071555, "o", "> "]
[130.071591, "o", "+EOF\r\n\u001b[?2004l\r"]
[130.071627, "o", "\u001b[?2004h> "]
[130.781051, "i", "python -m et0.selfcheck\n"]
[130.781211, "o", "python -m et0.selfcheck\r\n\u001b[?2004l\r"]
[130.781279, "o", "\u001b[?2004h> "]
