[317.819362, "o", "\u001b[?2004h> "]
[317.819404, "o", "+\r\n\u001b[?2004l\r"]
[317.819449, "o", "\u001b[?2004h> "]
[317.820021, "o", "+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n\u001b[?2004l\r"]
[317.820065, "o", "\u001b[?2004h"]
[317.820102, "o", "> "]
