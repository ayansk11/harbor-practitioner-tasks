[327.535629, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[344.802754, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\n+before the data can be fed to the FAO‑56 equations:\n+\n+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\n+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\n+   (FAO‑56 Eq. 47):\n+\n+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\n+\n+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\n+\n+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\n+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\n+\n+These conversions are applied after the raw CSV is read and befo"]
[344.802865, "i", "re the DataFrame is returned.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _wind_to_2m(wind, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\n+\n+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\n+    \"\"\"\n+    wind = np.asarray(wind, float)\n+    height = np.asarray(height_m, float)\n+    factor = 4.87 / np.log(67.8 * height - 5.42)\n+    return wind * factor\n+\n+\n+def _convert_radiation(rs, units):\n+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\n+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\n+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be M"]
[344.802881, "i", "J).\n+    \"\"\"\n+    rs = np.asarray(rs, float)\n+    low = units.lower()\n+    if \"w\" in low:\n+        return rs * 86400.0 / 1e6\n+    return rs\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+        \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype("]
[344.802899, "i", "float),\n+    })\n+\n+    # Vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion based on the unit declared in the station register\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+    return df\n+\n+EOF"]
[344.8032, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\rre the DataFrame is returned.\r\n+\"\"\"\r\n+\r\n+import os\r\n+import numpy as np\r\n+import pandas as pd\r\n+\r\n+from . import fao56\r\n+\r\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n+\r\n+\r\n+def _wind_to_2m(wind, height_m):\r\n+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n+\r\n+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n+    \"\"\"\r\n+    wind = np.asarray(wind, float)\r\n+    height = np.asarray(height_m, float)\r\n+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n+    return wind * factor\r\n+\r\n+\r\n+def _convert_radiation(rs, units):\r\n+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n+\r\n+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n+    ``MJ = W * 86400 / 1e6``."]
[344.803223, "o", " Otherwise the value is returned unchanged (assumed to already be MJ).\r\n+    \"\"\"\r\n+    rs = np.asarray(rs, float)\r\n+    low = units.lower()\r\n+    if \"w\" in low:\r\n+        return rs * 86400.0 / 1e6\r\n+    return rs\r\n+\r\n+\r\n+def load_station(station, data_dir):\r\n+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n+    path = os.pat"]
[344.803231, "o", "h.join(data_dir, f\"{station.station_id}.csv\")\r\n+    raw = pd"]
[344.803238, "o", ".read_csv(path)\r\n+    if station.humidity not i"]
[344.803246, "o", "n HUMIDITY_COLUMNS:\r\n+        raise ValueError(f\"{s"]
[344.803255, "o", "tation.station_id}"]
[344.803352, "o", ": unknown humidity type {station.humidity!r}\")\r\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n+    if missing:\r\n+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n+\r\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n+    df = pd.DataFrame({\r\n+        \"station_id\": station.station_id,\r\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n+        \"doy\": dates.dt.dayofyear.astype(int),\r\n+        \"tmax\": raw[\"tmax_c\"].astyp"]
[344.803385, "o", "e(float),\r\n+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n+    })\r\n+\r\n+    # Vapour pressure (ea)\r\n+"]
[344.8034, "o", "    if station.humidity == \"dewpoint\":"]
[344.803411, "o", "\r\n+        df[\"ea\"] = f"]
[344.80342, "o", "ao56.actual_vapour_pressu"]
[344.803429, "o", "re_dewpoint(raw[\"tde"]
[344.803439, "o", "w_c\"].astype(float))\r\n+    else:\r\n+ "]
[344.803447, "o", "      "]
[344.803507, "o", " df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n+        )\r\n+\r\n+    # Wind speed conversion t"]
[344.803534, "o", "o 2 m height\r\n+    df[\"u2"]
[344.803555, "o", "\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n+\r\n"]
[344.803574, "o", "+    # Solar radiation conversion based on the unit dec"]
[344.803592, "o", "lared in the station register\r\n+    df["]
[344.803612, "o", "\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n+    return df"]
[344.803624, "o", "\r\n+\r\n+EOF"]
[344.803683, "o", "\u001b[?2004h> "]
[344.804159, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.804417, "o", "+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\r\n\u001b[?2004l\r"]
[344.804514, "o", "\u001b[?2004h> "]
[344.804589, "o", "+before the data can be fed to the FAO‑56 equations:\r\n\u001b[?2004l\r"]
[344.80462, "o", "\u001b[?2004h"]
[344.80465, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.80468, "o", "> "]
[344.804947, "o", "+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\r\n\u001b[?2004l\r"]
[344.804991, "o", "\u001b[?2004h"]
[344.805022, "o", "> "]
[344.805286, "o", "+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\r\n\u001b[?2004l\r"]
[344.80532, "o", "\u001b[?2004h> "]
[344.805384, "o", "+   (FAO‑56 Eq. 47):\r\n\u001b[?2004l\r"]
[344.805413, "o", "\u001b[?2004h"]
[344.805444, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.805474, "o", "> "]
[344.805569, "o", "+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\r\n\u001b[?2004l\r"]
[344.805595, "o", "\u001b[?2004h"]
[344.805624, "o", "> +\r\n\u001b[?2004l\r"]
[344.805653, "o", "\u001b[?2004h> "]
[344.805856, "o", "+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n\u001b[?2004l\r"]
[344.805882, "o", "\u001b[?2004h"]
[344.80591, "o", "> +\r\n\u001b[?2004l\r"]
[344.805939, "o", "\u001b[?2004h> "]
[344.806267, "o", "+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\r\n\u001b[?2004l\r"]
[344.806295, "o", "\u001b[?2004h"]
[344.806324, "o", "> "]
[344.806607, "o", "+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\r\n\u001b[?2004l\r"]
[344.806635, "o", "\u001b[?2004h"]
[344.806664, "o", "> +\r\n\u001b[?2004l\r"]
[344.806693, "o", "\u001b[?2004h> "]
[344.806911, "o", "+These conversions are applied after the raw CSV is read and before the DataFrame is returned.\r\n\u001b[?2004l\r"]
[344.806943, "o", "\u001b[?2004h> "]
[344.806982, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[344.807012, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[344.807042, "o", "\u001b[?2004h> "]
[344.80707, "o", "+import os\r\n\u001b[?2004l\r"]
[344.807098, "o", "\u001b[?2004h> "]
[344.807131, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[344.807159, "o", "\u001b[?2004h"]
[344.807187, "o", "> "]
[344.807217, "o", "+import pandas as pd\r\n"]
[344.807245, "o", "\u001b[?2004l\r"]
[344.807274, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[344.807302, "o", "\u001b[?2004h> "]
[344.807337, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[344.807366, "o", "\u001b[?2004h"]
[344.807395, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.807422, "o", "> "]
[344.807583, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[344.807618, "o", "\u001b[?2004h> "]
[344.807847, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[344.807873, "o", "\u001b[?2004h"]
[344.807905, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.807934, "o", "> +\r\n\u001b[?2004l\r"]
[344.807967, "o", "\u001b[?2004h> "]
[344.80803, "o", "+def _wind_to_2m(wind, height_m):\r\n\u001b[?2004l\r"]
[344.808056, "o", "\u001b[?2004h"]
[344.808073, "o", "> "]
[344.808267, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n\u001b[?2004l\r"]
[344.808294, "o", "\u001b[?2004h"]
[344.808324, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.808352, "o", "> "]
[344.80857, "o", "+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n\u001b[?2004l\r"]
[344.8086, "o", "\u001b[?2004h"]
[344.80863, "o", "> "]
[344.80866, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.808688, "o", "> "]
[344.808745, "o", "+    wind = np.asarray(wind, float)\r\n\u001b[?2004l\r"]
[344.80877, "o", "\u001b[?2004h"]
[344.808801, "o", "> "]
[344.808882, "o", "+    height = np.asarray(height_m, float)\r\n\u001b[?2004l\r"]
[344.808912, "o", "\u001b[?2004h"]
[344.80894, "o", "> "]
[344.809044, "o", "+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n\u001b[?2004l\r"]
[344.809075, "o", "\u001b[?2004h"]
[344.809103, "o", "> "]
[344.809137, "o", "+    return wind * factor\r\n\u001b[?2004l\r"]
[344.809164, "o", "\u001b[?2004h"]
[344.809192, "o", "> +\r\n\u001b[?2004l\r"]
[344.809222, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[344.809254, "o", "\u001b[?2004h> "]
[344.809329, "o", "+def _convert_radiation(rs, units):\r\n\u001b[?2004l\r"]
[344.809361, "o", "\u001b[?2004h> "]
[344.809514, "o", "+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[344.809543, "o", "\u001b[?2004h"]
[344.809572, "o", "> +\r\n\u001b[?2004l\r"]
[344.809601, "o", "\u001b[?2004h> "]
[344.809798, "o", "+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n\u001b[?2004l\r"]
[344.809824, "o", "\u001b[?2004h"]
[344.809852, "o", "> "]
[344.810066, "o", "+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n\u001b[?2004l\r"]
[344.810095, "o", "\u001b[?2004h"]
[344.810124, "o", "> "]
[344.810355, "o", "+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\r\n\u001b[?2004l\r"]
[344.810389, "o", "\u001b[?2004h> "]
[344.810422, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[344.810451, "o", "\u001b[?2004h> "]
[344.810527, "o", "+    rs = np.asarray(rs, float)\r\n\u001b[?2004l\r"]
[344.810559, "o", "\u001b[?2004h> "]
[344.810622, "o", "+    low = units.lower()\r\n\u001b[?2004l\r"]
[344.810649, "o", "\u001b[?2004h"]
[344.810678, "o", "> "]
[344.810713, "o", "+    if \"w\" in low:\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.810742, "o", "> "]
[344.81082, "o", "+        return rs * 86400.0 / 1e6\r\n\u001b[?2004l\r"]
[344.810851, "o", "\u001b[?2004h> "]
[344.810893, "o", "+    return rs\r\n\u001b[?2004l\r"]
[344.810921, "o", "\u001b[?2004h"]
[344.810951, "o", "> +\r\n\u001b[?2004l\r"]
[344.810984, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[344.811015, "o", "\u001b[?2004h> "]
[344.811093, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[344.811128, "o", "\u001b[?2004h> "]
[344.811404, "o", "+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[344.811442, "o", "\u001b[?2004h> "]
[344.811597, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[344.811626, "o", "\u001b[?2004h"]
[344.811655, "o", "> "]
[344.811704, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[344.811733, "o", "\u001b[?2004h"]
[344.811762, "o", "> "]
[344.811862, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[344.811892, "o", "\u001b[?2004h"]
[344.81192, "o", "> "]
[344.812143, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[344.812173, "o", "\u001b[?2004h"]
[344.812205, "o", "> "]
[344.812435, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[344.812472, "o", "\u001b[?2004h> "]
[344.812512, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[344.812542, "o", "\u001b[?2004h"]
[344.812571, "o", "> "]
[344.812711, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[344.812743, "o", "\u001b[?2004h"]
[344.812773, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.812802, "o", "> "]
[344.812928, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[344.812957, "o", "\u001b[?2004h> "]
[344.813046, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[344.813091, "o", "\u001b[?2004h"]
[344.813123, "o", "> "]
[344.813198, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[344.813229, "o", "\u001b[?2004h"]
[344.813254, "o", "> "]
[344.813358, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[344.813399, "o", "\u001b[?2004h"]
[344.813424, "o", "> "]
[344.813536, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[344.813555, "o", "\u001b[?2004h> "]
[344.813699, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[344.813731, "o", "\u001b[?2004h> "]
[344.813859, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[344.81389, "o", "\u001b[?2004h> "]
[344.813917, "o", "+    })\r\n\u001b[?2004l\r"]
[344.813942, "o", "\u001b[?2004h"]
[344.813975, "o", "> +"]
[344.813997, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.814096, "o", "+    # Vapour pressure (ea)\r\n\u001b[?2004l\r"]
[344.814118, "o", "\u001b[?2004h"]
