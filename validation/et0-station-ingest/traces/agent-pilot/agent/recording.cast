[77.77548, "o", "\u001b[?2004h> "]
[77.775633, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[77.775677, "o", "\u001b[?2004h> "]
[77.775848, "o", "+import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.775907, "o", "> +\r\n\u001b[?2004l\r"]
[77.775959, "o", "\u001b[?2004h> "]
[77.776108, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[77.776157, "o", "\u001b[?2004h> "]
[77.776214, "o", "+\r\n\u001b[?2004l\r"]
[77.776269, "o", "\u001b[?2004h> "]
[77.776686, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[77.776729, "o", "\u001b[?2004h> "]
[77.777333, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[77.777368, "o", "\u001b[?2004h> "]
[77.777446, "o", "+\r\n"]
