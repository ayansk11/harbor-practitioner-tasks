[191.601399, "o", "\u001b[?2004h"]
[191.601429, "o", "> "]
[206.443505, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\n+before the data can be fed to the FAO‑56 equations:\n+\n+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\n+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\n+   (FAO‑56 Eq. 47):\n+\n+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\n+\n+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\n+\n+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\n+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\n+\n+These conversions are applied after the raw CSV is read and befo"]
[206.443536, "i", "re the DataFrame is returned.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _wind_to_2m(wind, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\n+\n+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\n+    \"\"\"\n+    wind = np.asarray(wind, float)\n+    height = np.asarray(height_m, float)\n+    factor = 4.87 / np.log(67.8 * height - 5.42)\n+    return wind * factor\n+\n+\n+def _convert_radiation(rs, units):\n+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\n+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\n+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be M"]
[206.443548, "i", "J).\n+    \"\"\"\n+    rs = np.asarray(rs, float)\n+    low = units.lower()\n+    if \"w\" in low:\n+        return rs * 86400.0 / 1e6\n+    return rs\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+        \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype("]
[206.443679, "i", "float),\n+    })\n+\n+    # Vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion based on the unit declared in the station register\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+    return df\n+\n+EOF\n"]
[206.443836, "o", "cat > et0/ingest.py <<'EOF'\r\n"]
[206.443849, "o", "\u001b[?2004l\r"]
[206.443915, "o", "\u001b[?2004h"]
[206.444206, "o", "> "]
[206.444768, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n"]
[206.444778, "o", "\u001b[?2004l\r"]
[206.444843, "o", "\u001b[?2004h> "]
[206.444886, "o", "+\r\n\u001b[?2004l\r"]
[206.444924, "o", "\u001b[?2004h"]
[206.444971, "o", "> "]
[206.445697, "o", "+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\r\n\u001b[?2004l\r"]
[206.445742, "o", "\u001b[?2004h"]
[206.445771, "o", "> "]
[206.446164, "o", "+before the data can be fed to the FAO‑56 equations:\r\n\u001b[?2004l\r"]
[206.446208, "o", "\u001b[?2004h"]
[206.446244, "o", "> "]
[206.446276, "o", "+\r\n\u001b[?2004l\r"]
[206.446318, "o", "\u001b[?2004h"]
[206.446346, "o", "> "]
[206.447128, "o", "+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\r\n\u001b[?2004l\r"]
[206.447178, "o", "\u001b[?2004h"]
[206.447217, "o", "> "]
[206.447992, "o", "+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\r\n\u001b[?2004l\r"]
[206.448057, "o", "\u001b[?2004h> "]
[206.448251, "o", "+   (FAO‑56 Eq. 47):\r\n\u001b[?2004l\r"]
[206.448311, "o", "\u001b[?2004h"]
[206.448363, "o", "> "]
[206.448416, "o", "+\r\n\u001b[?2004l\r"]
[206.448459, "o", "\u001b[?2004h> "]
[206.448772, "o", "+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\r\n\u001b[?2004l\r"]
[206.448818, "o", "\u001b[?2004h"]
[206.448861, "o", "> +\r\n\u001b[?2004l\r"]
[206.448913, "o", "\u001b[?2004h"]
[206.448959, "o", "> "]
[206.44954, "o", "+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n\u001b[?2004l\r"]
[206.449588, "o", "\u001b[?2004h"]
[206.449626, "o", "> "]
[206.449669, "o", "+\r\n\u001b[?2004l\r"]
[206.449707, "o", "\u001b[?2004h"]
[206.449752, "o", "> "]
[206.45059, "o", "+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\r\n\u001b[?2004l\r"]
[206.450635, "o", "\u001b[?2004h"]
[206.450674, "o", "> "]
[206.451458, "o", "+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\r\n\u001b[?2004l\r"]
[206.451506, "o", "\u001b[?2004h"]
[206.451551, "o", "> "]
[206.4516, "o", "+\r\n\u001b[?2004l\r"]
[206.451646, "o", "\u001b[?2004h> "]
[206.452281, "o", "+These conversions are applied after the raw CSV is read and before the DataFrame is returned.\r\n\u001b[?2004l\r"]
[206.452326, "o", "\u001b[?2004h"]
[206.452366, "o", "> "]
[206.452406, "o", "+\"\"\""]
[206.452454, "o", "\r\n\u001b[?2004l\r"]
[206.452497, "o", "\u001b[?2004h> "]
[206.452543, "o", "+\r\n\u001b[?2004l\r"]
[206.452584, "o", "\u001b[?2004h> "]
[206.452677, "o", "+import os\r\n\u001b[?2004l\r"]
[206.452722, "o", "\u001b[?2004h"]
[206.452764, "o", "> "]
[206.452908, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[206.452954, "o", "\u001b[?2004h"]
[206.453001, "o", "> "]
[206.453168, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[206.453207, "o", "\u001b[?2004h"]
[206.453231, "o", "> "]
[206.453342, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.453494, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[206.453542, "o", "\u001b[?2004h"]
[206.453592, "o", "> +\r\n\u001b[?2004l\r"]
[206.453631, "o", "\u001b[?2004h"]
[206.453678, "o", "> "]
[206.454133, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n"]
[206.454143, "o", "\u001b[?2004l\r"]
[206.454177, "o", "\u001b[?2004h"]
[206.454212, "o", "> "]
[206.4548, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[206.454844, "o", "\u001b[?2004h"]
[206.454886, "o", "> "]
[206.454895, "o", "+\r\n"]
[206.454938, "o", "\u001b[?2004l\r"]
[206.454946, "o", "\u001b[?2004h"]
[206.454998, "o", "> "]
[206.455011, "o", "+\r\n\u001b[?2004l\r"]
[206.455053, "o", "\u001b[?2004h"]
[206.455082, "o", "> "]
[206.455334, "o", "+def _wind_to_2m(wind, height_m):\r\n"]
[206.455344, "o", "\u001b[?2004l\r"]
[206.45538, "o", "\u001b[?2004h"]
[206.455412, "o", "> "]
[206.455964, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n"]
[206.455974, "o", "\u001b[?2004l\r"]
[206.456045, "o", "\u001b[?2004h> "]
[206.456086, "o", "+\r\n\u001b[?2004l\r"]
[206.456121, "o", "\u001b[?2004h"]
[206.456155, "o", "> "]
[206.456752, "o", "+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n"]
[206.456759, "o", "\u001b[?2004l\r"]
[206.456814, "o", "\u001b[?2004h"]
[206.456849, "o", "> "]
[206.456913, "o", "+    \"\"\"\r\n"]
[206.456921, "o", "\u001b[?2004l\r"]
[206.456993, "o", "\u001b[?2004h"]
[206.457034, "o", "> "]
[206.457268, "o", "+    wind = np.asarray(wind, float)\r\n\u001b[?2004l\r"]
[206.457312, "o", "\u001b[?2004h"]
[206.457352, "o", "> "]
[206.457633, "o", "+    height = np.asarray(height_m, float)\r\n\u001b[?2004l\r"]
[206.457674, "o", "\u001b[?2004h"]
[206.457703, "o", "> "]
[206.458045, "o", "+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n\u001b[?2004l\r"]
[206.458085, "o", "\u001b[?2004h"]
[206.458117, "o", "> "]
[206.458304, "o", "+    return wind * factor\r\n\u001b[?2004l\r"]
[206.458341, "o", "\u001b[?2004h"]
[206.458385, "o", "> +\r\n\u001b[?2004l\r"]
[206.458431, "o", "\u001b[?2004h"]
[206.458461, "o", "> "]
[206.458484, "o", "+\r\n\u001b[?2004l\r"]
[206.458583, "o", "\u001b[?2004h> "]
[206.458795, "o", "+def _convert_radiation(rs, units):\r\n\u001b[?2004l\r"]
[206.458841, "o", "\u001b[?2004h"]
[206.45889, "o", "> "]
[206.459275, "o", "+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[206.459321, "o", "\u001b[?2004h"]
[206.459362, "o", "> "]
[206.459404, "o", "+\r\n\u001b[?2004l\r"]
[206.459447, "o", "\u001b[?2004h> "]
[206.460018, "o", "+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n\u001b[?2004l\r"]
[206.460075, "o", "\u001b[?2004h> "]
[206.460684, "o", "+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n\u001b[?2004l\r"]
[206.460727, "o", "\u001b[?2004h"]
[206.460784, "o", "> "]
[206.461429, "o", "+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\r\n\u001b[?2004l\r"]
[206.461473, "o", "\u001b[?2004h"]
[206.461524, "o", "> "]
[206.46157, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[206.461615, "o", "\u001b[?2004h"]
[206.461657, "o", "> "]
[206.46187, "o", "+    rs = np.asarray(rs, float)\r\n\u001b[?2004l\r"]
[206.461912, "o", "\u001b[?2004h"]
[206.461956, "o", "> "]
[206.462132, "o", "+    low = units.lower()\r\n\u001b[?2004l\r"]
[206.462177, "o", "\u001b[?2004h"]
[206.46222, "o", "> "]
[206.462356, "o", "+    if \"w\" in low:\r\n\u001b[?2004l\r"]
[206.462399, "o", "\u001b[?2004h"]
[206.462446, "o", "> "]
[206.462679, "o", "+        return rs * 86400.0 / 1e6\r\n\u001b[?2004l\r"]
[206.462719, "o", "\u001b[?2004h"]
[206.462778, "o", "> "]
[206.462868, "o", "+    return rs\r\n\u001b[?2004l\r"]
[206.462911, "o", "\u001b[?2004h"]
[206.462979, "o", "> "]
[206.46303, "o", "+\r\n\u001b[?2004l\r"]
[206.463079, "o", "\u001b[?2004h> "]
[206.463105, "o", "+\r\n\u001b[?2004l\r"]
[206.463215, "o", "\u001b[?2004h"]
[206.463449, "o", "> "]
[206.463511, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r\u001b[?2004h"]
[206.463566, "o", "> "]
[206.464287, "o", "+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[206.464347, "o", "\u001b[?2004h"]
[206.464433, "o", "> "]
[206.464891, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[206.46494, "o", "\u001b[?2004h"]
[206.46498, "o", "> "]
[206.46522, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[206.465302, "o", "\u001b[?2004h> "]
[206.465708, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[206.465764, "o", "\u001b[?2004h"]
[206.465845, "o", "> "]
[206.466452, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[206.466506, "o", "\u001b[?2004h"]
[206.466545, "o", "> "]
[206.467236, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[206.467298, "o", "\u001b[?2004h> "]
[206.467436, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[206.467496, "o", "\u001b[?2004h> "]
[206.467937, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[206.467993, "o", "\u001b[?2004h"]
[206.468038, "o", "> "]
[206.468081, "o", "+\r\n\u001b[?2004l\r"]
[206.468127, "o", "\u001b[?2004h"]
[206.468179, "o", "> "]
[206.468544, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[206.468593, "o", "\u001b[?2004h"]
[206.46864, "o", "> "]
[206.46881, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[206.468851, "o", "\u001b[?2004h"]
[206.468906, "o", "> "]
[206.469193, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[206.469253, "o", "\u001b[?2004h> "]
[206.469586, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n"]
[206.469628, "o", "\u001b[?2004l\r"]
[206.469669, "o", "\u001b[?2004h> "]
[206.470007, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[206.470061, "o", "\u001b[?2004h"]
[206.470098, "o", "> "]
[206.470402, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[206.47046, "o", "\u001b[?2004h"]
[206.470502, "o", "> "]
[206.470793, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[206.470848, "o", "\u001b[?2004h"]
[206.470888, "o", "> "]
[206.470936, "o", "+    })\r\n\u001b[?2004l\r"]
[206.470996, "o", "\u001b[?2004h"]
[206.471054, "o", "> +\r\n\u001b[?2004l\r"]
[206.471104, "o", "\u001b[?2004h"]
[206.471154, "o", "> "]
[206.471325, "o", "+    # Vapour pressure (ea)\r\n\u001b[?2004l\r"]
[206.47137, "o", "\u001b[?2004h"]
[206.471414, "o", "> "]
[206.471681, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[206.471724, "o", "\u001b[?2004h"]
[206.471764, "o", "> "]
[206.472346, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[206.472393, "o", "\u001b[?2004h"]
[206.472432, "o", "> "]
[206.472514, "o", "+    else:\r\n\u001b[?2004l\r"]
[206.472558, "o", "\u001b[?2004h"]
[206.4726, "o", "> "]
[206.472951, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[206.473016, "o", "\u001b[?2004h> "]
[206.4737, "o", "+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[206.473758, "o", "\u001b[?2004h"]
[206.47381, "o", "> "]
[206.473862, "o", "+        )\r\n\u001b[?2004l\r"]
[206.473907, "o", "\u001b[?2004h"]
[206.47395, "o", "> "]
[206.473998, "o", "+\r\n\u001b[?2004l\r"]
[206.474037, "o", "\u001b[?2004h"]
[206.474087, "o", "> "]
[206.474361, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[206.474407, "o", "\u001b[?2004h"]
[206.474451, "o", "> "]
[206.474996, "o", "+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[206.475059, "o", "\u001b[?2004h"]
[206.475103, "o", "> +\r\n\u001b[?2004l\r"]
[206.475153, "o", "\u001b[?2004h"]
[206.475204, "o", "> "]
[206.475742, "o", "+    # Solar radiation conversion based on the unit declared in the station register\r\n\u001b[?2004l\r"]
[206.475798, "o", "\u001b[?2004h"]
[206.475851, "o", "> "]
[206.476486, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[206.476536, "o", "\u001b[?2004h"]
[206.476577, "o", "> "]
[206.476689, "o", "+    return df\r\n\u001b[?2004l\r"]
[206.476747, "o", "\u001b[?2004h> "]
[206.476789, "o", "+\r\n"]
[206.476826, "o", "\u001b[?2004l\r"]
[206.476883, "o", "\u001b[?2004h> "]
[206.476936, "o", "+EOF\r\n\u001b[?2004l\r"]
[206.476996, "o", "\u001b[?2004h> "]
[207.194359, "i", "python -m et0.selfcheck\n"]
[207.194626, "o", "python -m et0.selfcheck\r\n\u001b[?2004l\r"]
[207.194712, "o", "\u001b[?2004h"]
[207.194759, "o", "> "]
[210.191645, "i", "cd /app && python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0_fixed.csv\n"]
[210.192558, "o", "cd /app && python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0_fixed.csv\r\n\u001b[?2004l\r"]
[210.19263, "o", "\u001b[?2004h> "]
[216.180014, "i", "head -n 5 output/et0_fixed.csv\n"]
[216.180338, "o", "head -n 5 output/et0_fixed.csv\r\n\u001b[?2004l\r"]
[216.180415, "o", "\u001b[?2004h"]
[216.180474, "o", "> "]
[234.912708, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\n+before the data can be fed to the FAO‑56 equations:\n+\n+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\n+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\n+   (FAO‑56 Eq. 47):\n+\n+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\n+\n+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\n+\n+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\n+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\n+\n+These conversions are applied after the raw CSV is read and befo"]
[234.91287, "i", "re the DataFrame is returned.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _wind_to_2m(wind, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\n+\n+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\n+    \"\"\"\n+    wind = np.asarray(wind, float)\n+    height = np.asarray(height_m, float)\n+    factor = 4.87 / np.log(67.8 * height - 5.42)\n+    return wind * factor\n+\n+\n+def _convert_radiation(rs, units):\n+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\n+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\n+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be M"]
[234.912923, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[234.913003, "i", "J).\n+    \"\"\"\n+    rs = np.asarray(rs, float)\n+    low = units.lower()\n+    if \"w\" in low:\n+        return rs * 86400.0 / 1e6\n+    return rs\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+        \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype("]
[234.91305, "o", "\u001b[?2004h> "]
[234.91309, "i", "float),\n+    })\n+\n+    # Vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion based on the unit declared in the station register\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+    return df\n+\n+EOF\n"]
[234.91334, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[234.913395, "o", "\u001b[?2004h"]
[234.913447, "o", "> "]
[234.913494, "o", "+\r\n\u001b[?2004l\r"]
[234.913551, "o", "\u001b[?2004h> "]
[234.914282, "o", "+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\r\n\u001b[?2004l\r"]
[234.914379, "o", "\u001b[?2004h> "]
[234.914714, "o", "+before the data can be fed to the FAO‑56 equations:\r\n\u001b[?2004l\r"]
[234.914763, "o", "\u001b[?2004h"]
[234.914782, "o", "> "]
[234.914889, "o", "+\r\n\u001b[?2004l\r"]
[234.914944, "o", "\u001b[?2004h> "]
[234.915637, "o", "+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\r\n\u001b[?2004l\r"]
[234.915707, "o", "\u001b[?2004h> "]
[234.916466, "o", "+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\r\n\u001b[?2004l\r"]
[234.916543, "o", "\u001b[?2004h> "]
[234.916697, "o", "+   (FAO‑56 Eq. 47):\r\n\u001b[?2004l\r"]
[234.916759, "o", "\u001b[?2004h> +\r\n"]
[234.916814, "o", "\u001b[?2004l\r"]
[234.916852, "o", "\u001b[?2004h> "]
[234.917148, "o", "+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\r\n\u001b[?2004l\r"]
[234.917209, "o", "\u001b[?2004h"]
[234.917246, "o", "> "]
[234.917285, "o", "+\r\n\u001b[?2004l\r"]
[234.917318, "o", "\u001b[?2004h> "]
[234.917872, "o", "+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n\u001b[?2004l\r"]
[234.917921, "o", "\u001b[?2004h> "]
[234.917953, "o", "+\r\n\u001b[?2004l\r"]
[234.918, "o", "\u001b[?2004h> "]
[234.918845, "o", "+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\r\n\u001b[?2004l\r"]
[234.918894, "o", "\u001b[?2004h"]
[234.918927, "o", "> "]
[234.919699, "o", "+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\r\n\u001b[?2004l\r"]
[234.919749, "o", "\u001b[?2004h> "]
[234.919782, "o", "+\r\n\u001b[?2004l\r"]
[234.919829, "o", "\u001b[?2004h> "]
[234.920506, "o", "+These conversions are applied after the raw CSV is read and before the DataFrame is returned.\r\n"]
[234.920547, "o", "\u001b[?2004l\r"]
[234.920564, "o", "\u001b[?2004h> "]
[234.920605, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[234.920657, "o", "\u001b[?2004h"]
[234.920674, "o", "> "]
[234.920703, "o", "+\r\n\u001b[?2004l\r"]
[234.920805, "o", "\u001b[?2004h> "]
[234.920883, "o", "+import os\r\n\u001b[?2004l\r"]
[234.920935, "o", "\u001b[?2004h"]
[234.920977, "o", "> "]
[234.921148, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[234.921177, "o", "\u001b[?2004h"]
[234.921248, "o", "> "]
[234.921369, "o", "+import pandas as pd\r\n"]
[234.921406, "o", "\u001b[?2004l\r"]
[234.921434, "o", "\u001b[?2004h"]
[234.921455, "o", "> "]
[234.921493, "o", "+\r\n\u001b[?2004l\r"]
[234.921536, "o", "\u001b[?2004h"]
[234.921562, "o", "> "]
[234.921792, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[234.92183, "o", "\u001b[?2004h> "]
[234.921873, "o", "+\r\n\u001b[?2004l\r"]
[234.921926, "o", "\u001b[?2004h"]
[234.921943, "o", "> "]
[234.922495, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[234.922546, "o", "\u001b[?2004h"]
[234.922593, "o", "> "]
[234.923153, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[234.923208, "o", "\u001b[?2004h"]
[234.92325, "o", "> "]
[234.923273, "o", "+\r\n\u001b[?2004l\r"]
[234.923315, "o", "\u001b[?2004h> "]
[234.923407, "o", "+\r\n\u001b[?2004l\r"]
[234.923454, "o", "\u001b[?2004h> "]
[234.923652, "o", "+def _wind_to_2m(wind, height_m):\r\n\u001b[?2004l\r"]
[234.923701, "o", "\u001b[?2004h"]
[234.923747, "o", "> "]
[234.924284, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n\u001b[?2004l\r"]
[234.924348, "o", "\u001b[?2004h> "]
[234.924392, "o", "+\r\n"]
[234.924435, "o", "\u001b[?2004l\r\u001b[?2004h"]
[234.924477, "o", "> "]
[234.925084, "o", "+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n\u001b[?2004l\r"]
[234.925135, "o", "\u001b[?2004h"]
[234.925178, "o", "> "]
[234.925234, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[234.925285, "o", "\u001b[?2004h"]
[234.92533, "o", "> "]
[234.925556, "o", "+    wind = np.asarray(wind, float)\r\n\u001b[?2004l\r"]
[234.925607, "o", "\u001b[?2004h"]
[234.925652, "o", "> "]
[234.925916, "o", "+    height = np.asarray(height_m, float)\r\n\u001b[?2004l\r"]
[234.925974, "o", "\u001b[?2004h"]
[234.926018, "o", "> "]
[234.926338, "o", "+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n\u001b[?2004l\r"]
[234.926393, "o", "\u001b[?2004h"]
[234.926439, "o", "> "]
[234.926611, "o", "+    return wind * factor\r\n\u001b[?2004l\r"]
[234.92666, "o", "\u001b[?2004h"]
[234.926703, "o", "> "]
[234.926749, "o", "+\r\n\u001b[?2004l\r"]
[234.926785, "o", "\u001b[?2004h> "]
[234.92683, "o", "+\r\n\u001b[?2004l\r"]
[234.926874, "o", "\u001b[?2004h"]
[234.926916, "o", "> "]
[234.927139, "o", "+def _convert_radiation(rs, units):\r\n\u001b[?2004l\r"]
[234.927187, "o", "\u001b[?2004h"]
[234.927232, "o", "> "]
[234.927615, "o", "+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[234.92767, "o", "\u001b[?2004h> "]
[234.927719, "o", "+\r\n"]
[234.92774, "o", "\u001b[?2004l\r\u001b[?2004h"]
[234.9278, "o", "> "]
[234.928364, "o", "+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n\u001b[?2004l\r"]
[234.928415, "o", "\u001b[?2004h"]
[234.928461, "o", "> "]
[234.929089, "o", "+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n\u001b[?2004l\r"]
[234.929136, "o", "\u001b[?2004h"]
[234.92918, "o", "> "]
[234.929826, "o", "+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\r\n\u001b[?2004l\r"]
[234.929876, "o", "\u001b[?2004h"]
[234.929919, "o", "> "]
[234.929986, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[234.930056, "o", "\u001b[?2004h"]
[234.930102, "o", "> "]
[234.930289, "o", "+    rs = np.asarray(rs, float)\r\n\u001b[?2004l\r"]
[234.930336, "o", "\u001b[?2004h"]
[234.930378, "o", "> "]
[234.930535, "o", "+    low = units.lower()\r\n"]
[234.930564, "o", "\u001b[?2004l\r"]
[234.930599, "o", "\u001b[?2004h"]
[234.930623, "o", "> "]
[234.930763, "o", "+    if \"w\" in low:\r\n\u001b[?2004l\r"]
[234.930812, "o", "\u001b[?2004h"]
[234.930836, "o", "> "]
[234.931085, "o", "+        return rs * 86400.0 / 1e6\r\n\u001b[?2004l\r"]
[234.931133, "o", "\u001b[?2004h"]
[234.931161, "o", "> "]
[234.931271, "o", "+    return rs\r\n\u001b[?2004l\r"]
[234.931318, "o", "\u001b[?2004h"]
[234.931352, "o", "> "]
[234.931377, "o", "+"]
[234.931405, "o", "\r\n\u001b[?2004l\r"]
[234.931447, "o", "\u001b[?2004h"]
[234.931473, "o", "> +"]
[234.9315, "o", "\r\n\u001b[?2004l\r"]
[234.931535, "o", "\u001b[?2004h"]
[234.93156, "o", "> "]
[234.931815, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[234.931861, "o", "\u001b[?2004h"]
[234.931891, "o", "> "]
[234.932619, "o", "+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[234.93269, "o", "\u001b[?2004h> "]
[234.933124, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[234.933191, "o", "\u001b[?2004h> "]
[234.933395, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[234.933471, "o", "\u001b[?2004h"]
[234.933515, "o", "> "]
[234.933832, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[234.933882, "o", "\u001b[?2004h"]
[234.933929, "o", "> "]
[234.934544, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[234.934598, "o", "\u001b[?2004h"]
[234.93464, "o", "> "]
[234.93533, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[234.93539, "o", "\u001b[?2004h> "]
[234.935516, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[234.935567, "o", "\u001b[?2004h"]
[234.935609, "o", "> "]
[234.936025, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[234.936092, "o", "\u001b[?2004h> "]
[234.936136, "o", "+\r\n"]
[234.936178, "o", "\u001b[?2004l\r\u001b[?2004h"]
[234.936222, "o", "> "]
[234.936596, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[234.936646, "o", "\u001b[?2004h"]
[234.936688, "o", "> "]
[234.936846, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[234.936897, "o", "\u001b[?2004h"]
[234.93694, "o", "> "]
[234.937224, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[234.937274, "o", "\u001b[?2004h"]
[234.937318, "o", "> "]
[234.937623, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[234.937675, "o", "\u001b[?2004h"]
[234.937716, "o", "> "]
[234.938029, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[234.938078, "o", "\u001b[?2004h"]
[234.938123, "o", "> "]
[234.938418, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[234.938465, "o", "\u001b[?2004h"]
[234.938508, "o", "> "]
[234.938798, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[234.93885, "o", "\u001b[?2004h"]
[234.938892, "o", "> "]
[234.938942, "o", "+    })\r\n\u001b[?2004l\r"]
[234.939, "o", "\u001b[?2004h"]
[234.93902, "o", "> "]
[234.939078, "o", "+\r\n\u001b[?2004l\r"]
[234.939122, "o", "\u001b[?2004h"]
[234.939165, "o", "> "]
[234.939319, "o", "+    # Vapour pressure (ea)\r\n\u001b[?2004l\r"]
[234.939369, "o", "\u001b[?2004h"]
[234.939414, "o", "> "]
[234.939667, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[234.939715, "o", "\u001b[?2004h"]
[234.939757, "o", "> "]
[234.940324, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[234.940372, "o", "\u001b[?2004h"]
[234.940416, "o", "> "]
[234.940484, "o", "+    else:\r\n\u001b[?2004l\r"]
[234.94054, "o", "\u001b[?2004h"]
[234.94058, "o", "> "]
[234.940929, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[234.940988, "o", "\u001b[?2004h"]
[234.941035, "o", "> "]
[234.941673, "o", "+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[234.941723, "o", "\u001b[?2004h"]
[234.941766, "o", "> "]
[234.941834, "o", "+        )\r\n\u001b[?2004l\r"]
[234.941885, "o", "\u001b[?2004h"]
[234.941925, "o", "> "]
[234.941989, "o", "+\r\n\u001b[?2004l\r"]
[234.942032, "o", "\u001b[?2004h> "]
[234.942315, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[234.942365, "o", "\u001b[?2004h"]
[234.942407, "o", "> "]
[234.942919, "o", "+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[234.942979, "o", "\u001b[?2004h"]
[234.943022, "o", "> "]
[234.943068, "o", "+\r\n\u001b[?2004l\r"]
[234.943109, "o", "\u001b[?2004h> "]
[234.943652, "o", "+    # Solar radiation conversion based on the unit declared in the station register\r\n\u001b[?2004l\r"]
[234.943702, "o", "\u001b[?2004h"]
[234.943745, "o", "> "]
[234.944358, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[234.944408, "o", "\u001b[?2004h"]
[234.944467, "o", "> "]
[234.944554, "o", "+    return df\r\n\u001b[?2004l\r"]
[234.944603, "o", "\u001b[?2004h"]
[234.944645, "o", "> "]
[234.94469, "o", "+\r\n\u001b[?2004l\r"]
[234.944734, "o", "\u001b[?2004h> "]
[234.944779, "o", "+EOF"]
[234.944823, "o", "\r\n\u001b[?2004l\r"]
[234.944875, "o", "\u001b[?2004h> "]
[235.658149, "i", "python -m et0.selfcheck\n"]
[235.65835, "o", "python -m et0.selfcheck\r\n\u001b[?2004l\r"]
[235.658454, "o", "\u001b[?2004h> "]
[238.699295, "i", "cd /app && python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0_fixed.csv\n"]
[238.700299, "o", "cd /app && python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0_fixed.csv\r\n\u001b[?2004l\r"]
