[413.715122, "o", "     1\t\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n     2\t+\r\n     3\t+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\r\n     4\t+before the data can be fed to the FAO‑56 equations:\r\n     5\t+\r\n     6\t+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\r\n     7\t+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\r\n     8\t+   (FAO‑56 Eq. 47):\r\n     9\t+\r\n    10\t+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\r\n    11\t+\r\n    12\t"]
[413.715185, "o", "+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n    13\t+\r\n    14\t+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\r\n    15\t+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\r\n    16\t+\r\n    17\t+These conversions are applied after the raw CSV is read and before the DataFrame is returned.\r\n    18\t+\"\"\"\r\n    19\t+\r\n    20\t+import os\r\n    21\t+import numpy as np\r\n    22\t+import pandas as pd\r\n"]
[413.715251, "o", "    23\t+\r\n    24\t+from . import fao56\r\n    25\t+\r\n    26\t+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n    27\t+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n    28\t+\r\n    29\t+\r\n    30\t+def _wind_to_2m(wind, height_m):\r\n    31\t+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n    32\t+\r\n    33\t+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n    34\t+    \"\"\"\r\n    35\t+    wind = np.asarray(wind, float)\r\n    36\t+    height = np.asarray(height_m, float)\r\n    37\t+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n    38\t+    return wind * factor\r\n    39\t+\r\n    40\t+\r\n    41\t+def _convert_radiation(rs, units):\r\n    42\t+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n    43\t+\r\n    44\t+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n    45\t+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n  "]
[413.71532, "o", "  46\t+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\r\n    47\t+    \"\"\"\r\n    48\t+    rs = np.asarray(rs, float)\r\n    49\t+    low = units.lower()\r\n    50\t+    if \"w\" in low:\r\n    51\t+        return rs * 86400.0 / 1e6\r\n    52\t+    return rs\r\n    53\t+\r\n    54\t+\r\n    55\t+def load_station(station, data_dir):\r\n    56\t+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n    57\t+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    58\t+    raw = pd.read_csv(path)\r\n    59\t+    if station.humidity not in HUMIDITY_COLUMNS:\r\n    60\t+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    61\t+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    62\t+    if missing:\r\n    63\t+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n    64\t+\r\n    65\t+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m"]
[413.715383, "o", "-%d\")\r\n    66\t+    df = pd.DataFrame({\r\n    67\t+        \"station_id\": station.station_id,\r\n    68\t+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n    69\t+        \"doy\": dates.dt.dayofyear.astype(int),\r\n    70\t+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n    71\t+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    72\t+    })\r\n    73\t+\r\n    74\t+    # Vapour pressure (ea)\r\n    75\t+    if station.humidity == \"dewpoint\":\r\n    76\t+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    77\t+    else:\r\n    78\t+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n    79\t+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n    80\t+        )\r\n    81\t+\r\n    82\t+    # Wind speed conversion to 2 m height\r\n    83\t+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n    84\t+\r\n    85\t+    # Solar radiation conversion based on the unit declared in the station register\r\n    86\t+    df[\"rs\"] = _convert_radiation(ra"]
[413.715443, "o", "w[\"solar_rad\"].astype(float), station.radiation_units)\r\n    87\t+    return df\r\n    88\t+\r\n    89\t+EOF\r\n    90\tpython -m et0.selfcheck\r\n    91\tcd /app && python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0_fixed.csv\r\n    92\thead -n 5 output/et0_fixed.csv\r\n    93\tcat > et0/ingest.py <<'EOF'\r\n    94\t\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n    95\t+\r\n    96\t+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\r\n    97\t+before the data can be fed to the FAO‑56 equations:\r\n    98\t+\r\n    99\t+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\r\n   100\t+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\r\n   101\t+   (FAO‑56 Eq. 47):\r\n   102\t+\r\n   103\t+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\r\n   104\t+\r\n   105\t+   where ``"]
[413.715491, "o", "u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n   106\t+\r\n   107\t+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\r\n   108\t+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\r\n   109\t+\r\n   110\t+These conversions are applied after the raw CSV is read and before the DataFrame is returned.\r\n   111\t+\"\"\"\r\n   112\t+\r\n   113\t+import os\r\n   114\t+import numpy as np\r\n   115\t+import pandas as pd\r\n   116\t+\r\n   117\t+from . import fao56\r\n   118\t+\r\n   119\t+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n   120\t+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n"]
[413.7158, "o", "\u001b[?2004hroot@ac9522f5-0133-4c52-9b04-970d08cc2866:/app# "]
[429.496678, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n\nThe raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\nbefore the data can be fed to the FAO‑56 equations:\n\n1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\n   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\n   (FAO‑56 Eq. 47):\n\n   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\n\n   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\n\n2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\n   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\n\nThese conversions are applied after the raw CSV is read and before the DataFrame"]
[429.496778, "i", " is returned.\n\"\"\"\n\nimport os\nimport numpy as np\nimport pandas as pd\n\nfrom . import fao56\n\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n\n\ndef _wind_to_2m(wind, height_m):\n    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\n\n    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\n    \"\"\"\n    wind = np.asarray(wind, float)\n    height = np.asarray(height_m, float)\n    factor = 4.87 / np.log(67.8 * height - 5.42)\n    return wind * factor\n\n\ndef _convert_radiation(rs, units):\n    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\n\n    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\n    If the units contain the letter \"w\" we assume Watts per square metre and convert using\n    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\n    \"\"\"\n    rs = np.asarray(rs, float)\n  "]
[429.496821, "i", "  low = units.lower()\n    if \"w\" in low:\n        return rs * 86400.0 / 1e6\n    return rs\n\n\ndef load_station(station, data_dir):\n    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n    raw = pd.read_csv(path)\n    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n    if missing:\n        raise ValueError(f\"{path}: missing columns {missing}\")\n\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n    df = pd.DataFrame({\n        \"station_id\": station.station_id,\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n        \"doy\": dates.dt.dayofyear.astype(int),\n        \"tmax\": raw[\"tmax_c\"].astype(float),\n        \"tmin\": raw[\"tmin_c\"].astype(float),\n    })\n\n    # Vapour pressure (ea)\n    if station.humidity == "]
[429.496849, "i", "\"dewpoint\":\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n    else:\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\n        )\n\n    # Wind speed conversion to 2 m height\n    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n\n    # Solar radiation conversion based on the unit declared in the station register\n    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n    return df\n\nEOF\n"]
