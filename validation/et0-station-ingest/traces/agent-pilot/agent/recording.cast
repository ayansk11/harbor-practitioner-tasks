[156.92281, "o", "ion register\r\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n+    return df\r\n"]
[156.922842, "o", "+\r\n+EOF\r\n\u001b[?2004h> "]
[156.92322, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[156.923255, "o", "\u001b[?2004h> "]
[156.92329, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.923322, "o", "> "]
[156.923593, "o", "+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\r\n\u001b[?2004l\r"]
[156.923626, "o", "\u001b[?2004h> "]
[156.923761, "o", "+before the data can be fed to the FAO‑56 equations:\r\n\u001b[?2004l\r"]
[156.923808, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.923841, "o", "\u001b[?2004h> "]
[156.924132, "o", "+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\r\n\u001b[?2004l\r"]
[156.924169, "o", "\u001b[?2004h> "]
[156.924458, "o", "+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\r\n\u001b[?2004l\r"]
[156.924491, "o", "\u001b[?2004h> "]
[156.924548, "o", "+   (FAO‑56 Eq. 47):\r\n\u001b[?2004l\r"]
[156.924581, "o", "\u001b[?2004h> "]
[156.924617, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.924727, "o", "+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\r\n\u001b[?2004l\r"]
[156.924751, "o", "\u001b[?2004h> "]
[156.924797, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.925023, "o", "+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n\u001b[?2004l\r"]
[156.925057, "o", "\u001b[?2004h> "]
[156.92509, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.925411, "o", "+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\r\n\u001b[?2004l\r"]
[156.925446, "o", "\u001b[?2004h> "]
[156.925747, "o", "+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\r\n\u001b[?2004l\r"]
[156.925784, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.925817, "o", "\u001b[?2004h> "]
[156.926063, "o", "+These conversions are applied after the raw CSV is read and before the DataFrame is returned.\r\n\u001b[?2004l\r"]
[156.926102, "o", "\u001b[?2004h> "]
[156.926137, "o", "+\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.92617, "o", "> "]
[156.926203, "o", "+import os\r\n\u001b[?2004l\r"]
[156.926224, "o", "\u001b[?2004h> "]
[156.926284, "o", "+import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.92634, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[156.926375, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.926408, "o", "\u001b[?2004h> "]
[156.926446, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[156.926477, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.926509, "o", "\u001b[?2004h> "]
[156.926677, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[156.926721, "o", "\u001b[?2004h> "]
[156.92693, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[156.926977, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.92701, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.927042, "o", "> "]
[156.927104, "o", "+def _wind_to_2m(wind, height_m):\r\n\u001b[?2004l\r"]
[156.92714, "o", "\u001b[?2004h> "]
[156.927339, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n\u001b[?2004l\r"]
[156.927381, "o", "\u001b[?2004h> "]
[156.927413, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.927631, "o", "+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n\u001b[?2004l\r"]
[156.927674, "o", "\u001b[?2004h> "]
[156.927707, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.927805, "o", "+    wind = np.asarray(wind, float)\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.92784, "o", "> "]
[156.927936, "o", "+    height = np.asarray(height_m, float)\r\n\u001b[?2004l\r"]
[156.927978, "o", "\u001b[?2004h> "]
[156.928097, "o", "+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n\u001b[?2004l\r"]
[156.928124, "o", "\u001b[?2004h> "]
[156.928187, "o", "+    return wind * factor\r\n\u001b[?2004l\r"]
[156.92821, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.928241, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.928263, "o", "\u001b[?2004h> "]
[156.928361, "o", "+def _convert_radiation(rs, units):\r\n\u001b[?2004l\r"]
[156.928385, "o", "\u001b[?2004h> "]
[156.928538, "o", "+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[156.928556, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.928588, "o", "\u001b[?2004h> "]
[156.928808, "o", "+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n\u001b[?2004l\r"]
[156.928843, "o", "\u001b[?2004h> "]
[156.929079, "o", "+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.929113, "o", "> "]
[156.929363, "o", "+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\r\n\u001b[?2004l\r"]
[156.929385, "o", "\u001b[?2004h> "]
[156.929406, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[156.929427, "o", "\u001b[?2004h> "]
[156.929513, "o", "+    rs = np.asarray(rs, float)\r\n\u001b[?2004l\r"]
[156.929542, "o", "\u001b[?2004h> "]
[156.929603, "o", "+    low = units.lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.929621, "o", "> "]
[156.929675, "o", "+    if \"w\" in low:\r\n\u001b[?2004l\r"]
[156.929701, "o", "\u001b[?2004h> "]
[156.92979, "o", "+        return rs * 86400.0 / 1e6\r\n\u001b[?2004l\r"]
[156.929809, "o", "\u001b[?2004h> "]
[156.929861, "o", "+    return rs\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.929885, "o", "> +\r\n\u001b[?2004l\r"]
[156.929909, "o", "\u001b[?2004h> "]
[156.929934, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.930045, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[156.93008, "o", "\u001b[?2004h> "]
[156.930357, "o", "+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[156.930382, "o", "\u001b[?2004h> "]
[156.930543, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[156.930573, "o", "\u001b[?2004h> "]
[156.930642, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[156.930676, "o", "\u001b[?2004h> "]
[156.930795, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[156.93082, "o", "\u001b[?2004h> "]
[156.931073, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[156.931103, "o", "\u001b[?2004h> "]
[156.931356, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[156.931386, "o", "\u001b[?2004h> "]
[156.931422, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[156.931447, "o", "\u001b[?2004h> "]
[156.931608, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[156.931634, "o", "\u001b[?2004h> "]
[156.931656, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.93182, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[156.931854, "o", "\u001b[?2004h> "]
[156.931922, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[156.931956, "o", "\u001b[?2004h> "]
[156.932069, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[156.932093, "o", "\u001b[?2004h> "]
[156.932216, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[156.93224, "o", "\u001b[?2004h> "]
[156.932364, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[156.932399, "o", "\u001b[?2004h> "]
[156.932508, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[156.932526, "o", "\u001b[?2004h> "]
[156.932649, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[156.932673, "o", "\u001b[?2004h> "]
[156.932695, "o", "+    })\r\n\u001b[?2004l\r"]
[156.932721, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.932746, "o", "\u001b[?2004h> "]
[156.932821, "o", "+    # Vapour pressure (ea)\r\n\u001b[?2004l\r"]
[156.932845, "o", "\u001b[?2004h> "]
[156.93295, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[156.932986, "o", "\u001b[?2004h> "]
[156.933208, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[156.933235, "o", "\u001b[?2004h> "]
[156.933255, "o", "+    else:\r\n\u001b[?2004l\r"]
[156.933285, "o", "\u001b[?2004h> "]
[156.933433, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[156.933457, "o", "\u001b[?2004h> "]
[156.933717, "o", "+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[156.933747, "o", "\u001b[?2004h> "]
[156.93377, "o", "+        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.933794, "o", "> +\r\n\u001b[?2004l\r"]
[156.933816, "o", "\u001b[?2004h> "]
[156.933935, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[156.933978, "o", "\u001b[?2004h> "]
[156.93418, "o", "+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[156.934214, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[156.93424, "o", "\u001b[?2004h> "]
[156.934455, "o", "+    # Solar radiation conversion based on the unit declared in the station register\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.934481, "o", "> "]
[156.934724, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.934752, "o", "> "]
[156.934793, "o", "+    return df\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.934819, "o", "> +\r\n\u001b[?2004l\r"]
[156.934844, "o", "\u001b[?2004h> +EOF\r\n\u001b[?2004l\r"]
[156.934869, "o", "\u001b[?2004h> "]
[157.539763, "i", "python -m et0.selfcheck\n"]
[157.539903, "o", "python -m et0.selfcheck\r\n\u001b[?2004l\r"]
[157.539946, "o", "\u001b[?2004h> "]
[160.660105, "i", "cd /app && python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0_fixed.csv\n"]
[160.660484, "o", "cd /app && python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0_fixed.csv\r\n\u001b[?2004l\r"]
[160.660552, "o", "\u001b[?2004h> "]
[165.560213, "i", "head -n 5 output/et0_fixed.csv\n"]
[165.560564, "o", "head -n 5 output/et0_fixed.csv\r\n\u001b[?2004l\r"]
[165.56064, "o", "\u001b[?2004h"]
[165.560689, "o", "> "]
[181.848327, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\n+before the data can be fed to the FAO‑56 equations:\n+\n+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\n+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\n+   (FAO‑56 Eq. 47):\n+\n+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\n+\n+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\n+\n+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\n+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\n+\n+These conversions are applied after the raw CSV is read and befo"]
[181.848362, "i", "re the DataFrame is returned.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _wind_to_2m(wind, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\n+\n+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\n+    \"\"\"\n+    wind = np.asarray(wind, float)\n+    height = np.asarray(height_m, float)\n+    factor = 4.87 / np.log(67.8 * height - 5.42)\n+    return wind * factor\n+\n+\n+def _convert_radiation(rs, units):\n+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\n+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\n+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be M"]
[181.848492, "i", "J).\n+    \"\"\"\n+    rs = np.asarray(rs, float)\n+    low = units.lower()\n+    if \"w\" in low:\n+        return rs * 86400.0 / 1e6\n+    return rs\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+        \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype("]
[181.848506, "i", "float),\n+    })\n+\n+    # Vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion based on the unit declared in the station register\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+    return df\n+\n+EOF\n"]
[181.848662, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[181.848728, "o", "\u001b[?2004h"]
[181.84878, "o", "> "]
[181.849483, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[181.849519, "o", "\u001b[?2004h"]
[181.849541, "o", "> "]
[181.849557, "o", "+\r\n\u001b[?2004l\r"]
[181.849594, "o", "\u001b[?2004h"]
[181.849611, "o", "> "]
[181.850337, "o", "+The raw files contain measurements in the units described in ``docs/METHOD.md``. Two conversions are required\r\n\u001b[?2004l\r"]
[181.850372, "o", "\u001b[?2004h"]
[181.850391, "o", "> "]
[181.850749, "o", "+before the data can be fed to the FAO‑56 equations:\r\n\u001b[?2004l\r"]
[181.850786, "o", "\u001b[?2004h"]
[181.850805, "o", "> "]
[181.850822, "o", "+\r\n\u001b[?2004l\r"]
[181.850858, "o", "\u001b[?2004h"]
[181.850878, "o", "> "]
[181.851645, "o", "+1. **Wind speed** – stations report mean wind speed at the height of their anemometer (``station.wind_height_m``).\r\n\u001b[?2004l\r"]
[181.851705, "o", "\u001b[?2004h"]
[181.851723, "o", "> "]
[181.852492, "o", "+   The FAO‑56 model expects wind speed at 2 m above the ground. The conversion uses the logarithmic wind profile\r\n\u001b[?2004l\r"]
[181.852524, "o", "\u001b[?2004h"]
[181.852541, "o", "> "]
[181.852709, "o", "+   (FAO‑56 Eq. 47):\r\n\u001b[?2004l\r"]
[181.852746, "o", "\u001b[?2004h"]
[181.852764, "o", "> "]
[181.852784, "o", "+\r\n\u001b[?2004l\r"]
[181.852817, "o", "\u001b[?2004h"]
[181.852836, "o", "> "]
[181.853151, "o", "+   ``u2 = u * (4.87 / log(67.8 * z - 5.42))``\r\n\u001b[?2004l\r"]
[181.853189, "o", "\u001b[?2004h"]
[181.853206, "o", "> "]
[181.853225, "o", "+\r\n\u001b[?2004l\r"]
[181.853261, "o", "\u001b[?2004h"]
[181.853278, "o", "> "]
[181.853849, "o", "+   where ``u`` is the measured wind speed and ``z`` is the anemometer height in metres.\r\n\u001b[?2004l\r"]
[181.853889, "o", "\u001b[?2004h"]
[181.853913, "o", "> "]
[181.85393, "o", "+\r\n\u001b[?2004l\r"]
[181.853977, "o", "\u001b[?2004h"]
[181.854, "o", "> "]
[181.854829, "o", "+2. **Solar radiation** – raw radiation can be in MJ m⁻² day⁻¹ (already suitable) or in W m⁻². When the unit is\r\n\u001b[?2004l\r"]
[181.854861, "o", "\u001b[?2004h"]
[181.854881, "o", "> "]
[181.855649, "o", "+   ``W/m2`` we convert to MJ m⁻² day⁻¹ using ``MJ = W * 86400 / 1e6`` (seconds per day, 10⁶ J per MJ).\r\n\u001b[?2004l\r"]
[181.855685, "o", "\u001b[?2004h"]
[181.855704, "o", "> "]
[181.855728, "o", "+\r\n\u001b[?2004l\r"]
[181.855757, "o", "\u001b[?2004h"]
[181.855778, "o", "> "]
[181.856396, "o", "+These conversions are applied after the raw CSV is read and before the DataFrame is returned.\r\n\u001b[?2004l\r"]
[181.85643, "o", "\u001b[?2004h"]
[181.856451, "o", "> "]
[181.856486, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[181.856524, "o", "\u001b[?2004h"]
[181.856544, "o", "> "]
[181.856563, "o", "+\r\n\u001b[?2004l\r"]
[181.856598, "o", "\u001b[?2004h"]
[181.856616, "o", "> "]
[181.856689, "o", "+import os\r\n\u001b[?2004l\r"]
[181.856727, "o", "\u001b[?2004h"]
[181.85675, "o", "> "]
[181.85689, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[181.856928, "o", "\u001b[?2004h"]
[181.856949, "o", "> "]
[181.857105, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[181.857141, "o", "\u001b[?2004h"]
[181.857163, "o", "> "]
[181.85718, "o", "+\r\n\u001b[?2004l\r"]
[181.857213, "o", "\u001b[?2004h"]
[181.857233, "o", "> "]
[181.857373, "o", "+from . import fao56\r\n"]
[181.857387, "o", "\u001b[?2004l\r"]
[181.857413, "o", "\u001b[?2004h"]
[181.857432, "o", "> "]
[181.857448, "o", "+\r\n"]
[181.857461, "o", "\u001b[?2004l\r"]
[181.857487, "o", "\u001b[?2004h"]
[181.857507, "o", "> "]
[181.857985, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[181.858023, "o", "\u001b[?2004h"]
[181.858043, "o", "> "]
[181.858607, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[181.858648, "o", "\u001b[?2004h"]
[181.858667, "o", "> "]
[181.858683, "o", "+\r\n\u001b[?2004l\r"]
[181.858721, "o", "\u001b[?2004h"]
[181.858742, "o", "> "]
[181.858757, "o", "+\r\n\u001b[?2004l\r"]
[181.858794, "o", "\u001b[?2004h"]
[181.858814, "o", "> "]
[181.859046, "o", "+def _wind_to_2m(wind, height_m):\r\n\u001b[?2004l\r"]
[181.859092, "o", "\u001b[?2004h"]
[181.859112, "o", "> "]
[181.859634, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n\u001b[?2004l\r"]
[181.859675, "o", "\u001b[?2004h"]
[181.859695, "o", "> "]
[181.859714, "o", "+\r\n\u001b[?2004l\r"]
[181.859749, "o", "\u001b[?2004h"]
[181.859769, "o", "> "]
[181.860373, "o", "+    Implements FAO‑56 Eq. 47. ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n\u001b[?2004l\r"]
[181.860408, "o", "\u001b[?2004h"]
[181.860428, "o", "> "]
[181.860487, "o", "+    \"\"\"\r\n"]
[181.860501, "o", "\u001b[?2004l\r"]
[181.860525, "o", "\u001b[?2004h"]
[181.860544, "o", "> "]
[181.860776, "o", "+    wind = np.asarray(wind, float)\r\n"]
[181.86079, "o", "\u001b[?2004l\r"]
[181.860816, "o", "\u001b[?2004h"]
[181.860836, "o", "> "]
[181.861114, "o", "+    height = np.asarray(height_m, float)\r\n"]
[181.861132, "o", "\u001b[?2004l\r"]
[181.861159, "o", "\u001b[?2004h"]
[181.861179, "o", "> "]
[181.861502, "o", "+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n\u001b[?2004l\r"]
[181.861537, "o", "\u001b[?2004h"]
[181.861557, "o", "> "]
[181.861723, "o", "+    return wind * factor\r\n"]
[181.861737, "o", "\u001b[?2004l\r"]
[181.861763, "o", "\u001b[?2004h"]
[181.861782, "o", "> "]
[181.861798, "o", "+\r\n"]
[181.861811, "o", "\u001b[?2004l\r"]
[181.861839, "o", "\u001b[?2004h"]
[181.861858, "o", "> "]
[181.861875, "o", "+\r\n"]
[181.861889, "o", "\u001b[?2004l\r"]
[181.861916, "o", "\u001b[?2004h"]
[181.861936, "o", "> "]
[181.862177, "o", "+def _convert_radiation(rs, units):\r\n"]
[181.862194, "o", "\u001b[?2004l\r"]
[181.862219, "o", "\u001b[?2004h"]
[181.862239, "o", "> "]
[181.862622, "o", "+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n"]
[181.862639, "o", "\u001b[?2004l\r"]
[181.862664, "o", "\u001b[?2004h"]
[181.862684, "o", "> "]
[181.8627, "o", "+\r\n"]
[181.862714, "o", "\u001b[?2004l\r"]
[181.862738, "o", "\u001b[?2004h"]
[181.86278, "o", "> "]
[181.86331, "o", "+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n"]
[181.863333, "o", "\u001b[?2004l\r"]
[181.863355, "o", "\u001b[?2004h"]
[181.863375, "o", "> "]
[181.863971, "o", "+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n"]
[181.863991, "o", "\u001b[?2004l\r"]
[181.864014, "o", "\u001b[?2004h"]
[181.864048, "o", "> "]
[181.864677, "o", "+    ``MJ = W * 86400 / 1e6``. Otherwise the value is returned unchanged (assumed to already be MJ).\r\n\u001b[?2004l\r"]
[181.864716, "o", "\u001b[?2004h"]
[181.864735, "o", "> "]
[181.864797, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[181.864835, "o", "\u001b[?2004h"]
[181.864854, "o", "> "]
[181.865075, "o", "+    rs = np.asarray(rs, float)\r\n\u001b[?2004l\r"]
[181.865112, "o", "\u001b[?2004h"]
[181.865131, "o", "> "]
[181.865293, "o", "+    low = units.lower()\r\n"]
[181.865316, "o", "\u001b[?2004l\r"]
[181.865339, "o", "\u001b[?2004h"]
[181.865362, "o", "> "]
[181.865481, "o", "+    if \"w\" in low:\r\n"]
[181.865502, "o", "\u001b[?2004l\r"]
[181.86552, "o", "\u001b[?2004h"]
[181.865541, "o", "> "]
[181.865767, "o", "+        return rs * 86400.0 / 1e6\r\n\u001b[?2004l\r"]
[181.865803, "o", "\u001b[?2004h"]
[181.865825, "o", "> "]
[181.865923, "o", "+    return rs\r\n"]
[181.865939, "o", "\u001b[?2004l\r"]
[181.865969, "o", "\u001b[?2004h"]
[181.865994, "o", "> "]
[181.86601, "o", "+\r\n\u001b[?2004l\r"]
[181.866044, "o", "\u001b[?2004h"]
[181.866063, "o", "> "]
[181.866082, "o", "+\r\n\u001b[?2004l\r"]
[181.866121, "o", "\u001b[?2004h"]
[181.866145, "o", "> "]
[181.866382, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[181.866424, "o", "\u001b[?2004h"]
[181.86644, "o", "> "]
[181.867158, "o", "+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[181.867201, "o", "\u001b[?2004h"]
[181.867218, "o", "> "]
[181.867629, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[181.867674, "o", "\u001b[?2004h"]
[181.867695, "o", "> "]
[181.867881, "o", "+    raw = pd.read_csv(path)\r\n"]
[181.867897, "o", "\u001b[?2004l\r"]
[181.86792, "o", "\u001b[?2004h"]
[181.867942, "o", "> "]
[181.868272, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[181.868375, "o", "\u001b[?2004h> "]
[181.868946, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[181.868988, "o", "\u001b[?2004h"]
[181.869033, "o", "> "]
[181.869658, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[181.869714, "o", "\u001b[?2004h> "]
[181.869821, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[181.869857, "o", "\u001b[?2004h"]
[181.869897, "o", "> "]
[181.870298, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[181.870336, "o", "\u001b[?2004h"]
[181.870378, "o", "> +\r\n\u001b[?2004l\r"]
[181.870422, "o", "\u001b[?2004h> "]
[181.870809, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[181.870844, "o", "\u001b[?2004h"]
[181.870883, "o", "> "]
[181.871039, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[181.871079, "o", "\u001b[?2004h> "]
[181.871373, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[181.871433, "o", "\u001b[?2004h"]
[181.871475, "o", "> "]
[181.871733, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[181.871768, "o", "\u001b[?2004h"]
[181.871807, "o", "> "]
[181.872109, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[181.872148, "o", "\u001b[?2004h"]
[181.872185, "o", "> "]
[181.872464, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[181.872517, "o", "\u001b[?2004h> "]
[181.872811, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[181.872854, "o", "\u001b[?2004h"]
[181.872898, "o", "> "]
[181.872936, "o", "+    })\r\n\u001b[?2004l\r"]
[181.872985, "o", "\u001b[?2004h> "]
[181.873019, "o", "+\r\n\u001b[?2004l\r"]
[181.873055, "o", "\u001b[?2004h> "]
[181.873246, "o", "+    # Vapour pressure (ea)\r\n\u001b[?2004l\r"]
[181.873285, "o", "\u001b[?2004h"]
[181.873327, "o", "> "]
[181.873565, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[181.873619, "o", "\u001b[?2004h"]
[181.873663, "o", "> "]
[181.874228, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[181.874279, "o", "\u001b[?2004h"]
[181.874324, "o", "> "]
[181.87438, "o", "+    else:\r\n\u001b[?2004l\r"]
[181.874418, "o", "\u001b[?2004h"]
[181.874452, "o", "> "]
[181.874805, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[181.874859, "o", "\u001b[?2004h"]
[181.8749, "o", "> "]
[181.87559, "o", "+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[181.875648, "o", "\u001b[?2004h"]
[181.8757, "o", "> "]
[181.875747, "o", "+        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[181.875788, "o", "> "]
[181.875837, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[181.87588, "o", "> "]
[181.876178, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[181.876223, "o", "\u001b[?2004h"]
[181.876248, "o", "> "]
[181.876757, "o", "+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[181.876803, "o", "\u001b[?2004h> "]
[181.876848, "o", "+\r\n\u001b[?2004l\r"]
[181.876879, "o", "\u001b[?2004h> "]
[181.877454, "o", "+    # Solar radiation conversion based on the unit declared in the station register\r\n\u001b[?2004l\r"]
[181.877518, "o", "\u001b[?2004h> "]
[181.878144, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[181.878207, "o", "\u001b[?2004h"]
[181.878268, "o", "> "]
[181.87834, "o", "+    return df\r\n\u001b[?2004l\r"]
[181.878396, "o", "\u001b[?2004h"]
[181.878436, "o", "> +\r\n"]
[181.878464, "o", "\u001b[?2004l\r"]
[181.878515, "o", "\u001b[?2004h"]
[181.878556, "o", "> "]
[181.878597, "o", "+EOF\r\n\u001b[?2004l\r"]
[181.878634, "o", "\u001b[?2004h"]
[181.878665, "o", "> "]
