[344.814815, "o", "> "]
[344.815024, "o", "+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[344.815057, "o", "\u001b[?2004h"]
[344.815072, "o", "> +        )\r\n"]
[344.81508, "o", "\u001b[?2004l\r"]
[344.815148, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
