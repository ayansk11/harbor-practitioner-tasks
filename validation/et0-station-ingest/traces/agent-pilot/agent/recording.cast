[290.628518, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[290.62858, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.62859, "o", "> "]
