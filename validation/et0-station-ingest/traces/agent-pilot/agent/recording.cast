[77.777558, "o", "\u001b[?2004h> "]
[77.777763, "o", "+def _wind_to_2m(wind, height_m):\r\n\u001b[?2004l\r"]
[77.777796, "o", "\u001b[?2004h"]
[77.777812, "o", "> "]
[77.778363, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the standard 2 m height.\r\n\u001b[?2004l\r"]
[77.778395, "o", "\u001b[?2004h"]
[77.778414, "o", "> "]
[77.77843, "o", "+\r\n\u001b[?2004l\r"]
[77.778475, "o", "\u001b[?2004h> "]
[77.779111, "o", "+    Implements FAO‑56 Eq. 47.  ``wind`` and ``height_m`` may be scalars or NumPy arrays.\r\n\u001b[?2004l\r"]
[77.779156, "o", "\u001b[?2004h> "]
[77.779236, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[77.779267, "o", "\u001b[?2004h"]
[77.779283, "o", "> "]
[77.779524, "o", "+    wind = np.asarray(wind, float)\r\n\u001b[?2004l\r"]
[77.779561, "o", "\u001b[?2004h"]
[77.779578, "o", "> "]
[77.779858, "o", "+    height = np.asarray(height_m, float)\r\n\u001b[?2004l\r"]
[77.779898, "o", "\u001b[?2004h"]
[77.779914, "o", "> "]
[77.780641, "o", "+    # Protect against division by zero or negative heights – such cases should never occur in valid data.\r\n\u001b[?2004l\r"]
[77.812708, "o", "\u001b[?2004h> +    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n\u001b[?2004l\r\u001b[?2004h> +    return wind * factor\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +def _convert_radiation(rs, units):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.813013, "o", "+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.813075, "o", "> "]
[77.813293, "o", "+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.813346, "o", "> "]
[77.813836, "o", "+    If the units contain the letter \"W\" we assume Watts per square metre and convert using\r\n\u001b[?2004l\r"]
[77.813885, "o", "\u001b[?2004h> "]
[77.814521, "o", "+    ``MJ = W * 86400 / 1e6``.  Otherwise the value is returned unchanged (assumed to already be MJ).\r\n\u001b[?2004l\r"]
[77.814569, "o", "\u001b[?2004h"]
[77.814622, "o", "> +    \"\"\"\r\n\u001b[?2004l\r"]
[77.814677, "o", "\u001b[?2004h> "]
[77.814784, "o", "+    rs = np.asarray(rs, float)\r\n\u001b[?2004l\r"]
[77.81483, "o", "\u001b[?2004h> "]
[77.81493, "o", "+    low = units.lower()\r\n\u001b[?2004l\r"]
[77.814982, "o", "\u001b[?2004h> "]
[77.815071, "o", "+    if \"w\" in low:\r\n\u001b[?2004l\r"]
[77.815116, "o", "\u001b[?2004h> "]
[77.81544, "o", "+        # Convert W m⁻² to MJ m⁻² day⁻¹\r\n\u001b[?2004l\r"]
[77.815498, "o", "\u001b[?2004h> "]
[77.815719, "o", "+        return rs * 86400.0 / 1e6\r\n\u001b[?2004l\r"]
[77.815762, "o", "\u001b[?2004h> "]
[77.816068, "o", "+    # Assume MJ m⁻² day⁻¹ already\r\n\u001b[?2004l\r"]
[77.816122, "o", "\u001b[?2004h> "]
[77.816222, "o", "+    return rs\r\n\u001b[?2004l\r"]
[77.816284, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[77.816337, "o", "\u001b[?2004h"]
[77.816401, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.816452, "o", "> "]
[77.816559, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[77.816602, "o", "\u001b[?2004h> "]
[77.817225, "o", "+    \"\"\"Return a DataFrame with columns ``station_id, date, doy, tmax, tmin, ea, u2, rs`` (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[77.817286, "o", "\u001b[?2004h> "]
[77.817687, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[77.817748, "o", "\u001b[?2004h> "]
[77.817894, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[77.817936, "o", "\u001b[?2004h> "]
[77.818172, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[77.81822, "o", "\u001b[?2004h> "]
[77.818713, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[77.818755, "o", "\u001b[?2004h> "]
[77.819409, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[77.81947, "o", "\u001b[?2004h> "]
[77.819561, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[77.819606, "o", "\u001b[?2004h> "]
[77.819873, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[77.819917, "o", "\u001b[?2004h> "]
[77.81998, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.820307, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[77.820356, "o", "\u001b[?2004h> "]
[77.820515, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[77.820563, "o", "\u001b[?2004h> "]
[77.820839, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[77.820886, "o", "\u001b[?2004h> "]
[77.82119, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[77.821229, "o", "\u001b[?2004h"]
[77.821283, "o", "> "]
[77.821453, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[77.821497, "o", "\u001b[?2004h> "]
[77.821692, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[77.821737, "o", "\u001b[?2004h"]
[77.821789, "o", "> "]
[77.822041, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[77.822091, "o", "\u001b[?2004h> "]
[77.82216, "o", "+    })\r\n\u001b[?2004l\r"]
[77.822205, "o", "\u001b[?2004h> "]
[77.822254, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.822445, "o", "+    # Vapour pressure (ea)\r\n\u001b[?2004l\r"]
[77.822491, "o", "\u001b[?2004h"]
[77.822542, "o", "> "]
[77.822742, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[77.82278, "o", "\u001b[?2004h> "]
[77.823176, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[77.823215, "o", "\u001b[?2004h"]
[77.823258, "o", "> +    else:\r\n\u001b[?2004l\r"]
[77.823304, "o", "\u001b[?2004h> "]
[77.823636, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[77.823676, "o", "\u001b[?2004h> "]
[77.824324, "o", "+            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[77.824367, "o", "\u001b[?2004h> "]
[77.824443, "o", "+        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.824483, "o", "> "]
[77.824528, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.824723, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[77.824761, "o", "\u001b[?2004h"]
[77.824809, "o", "> "]
[77.825262, "o", "+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[77.825308, "o", "\u001b[?2004h> "]
[77.825352, "o", "+\r\n\u001b[?2004l\r"]
[77.8254, "o", "\u001b[?2004h> "]
[77.825894, "o", "+    # Solar radiation conversion based on the unit declared in the station register\r\n\u001b[?2004l\r"]
[77.825944, "o", "\u001b[?2004h> "]
[77.826391, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[77.826447, "o", "\u001b[?2004h> "]
[77.826545, "o", "+    return df\r\n\u001b[?2004l\r"]
[77.826582, "o", "\u001b[?2004h> "]
[77.826682, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[77.826724, "o", "\u001b[?2004h> "]
[77.826782, "o", "PATCH\r\n\u001b[?2004l\r"]
[77.827723, "o", "bash: apply_patch: command not found\r\n"]
