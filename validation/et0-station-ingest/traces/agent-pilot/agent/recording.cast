[103.025331, "o", "ea\"] = fao56.actual_vapour_pressure_rh(\r\n+  "]
[103.025358, "o", "          df[\"tmax\"], df[\"tmin\"], raw[\"rh"]
[103.02538, "o", "_max_pct\"].astype(floa"]
[103.025402, "o", "t), raw[\"rh_min_pct\"].astype(float)\r\n+        )\r\n+\r\n+    # Wind speed"]
[103.025424, "o", " conversion to 2 m height\r\n+    df[\"u2\"] = _wind_to_2m(raw[\"wind_ms\""]
[103.025438, "o", "].astype(float), station.wind_height_m)\r\n+\r\n+   "]
[103.025469, "o", " # Solar radiation conversion base"]
