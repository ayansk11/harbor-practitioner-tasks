[156.921887, "o", "asarray(height_m, float)\r\n+    factor = 4.87 / np.log(67.8 * height - 5.42)\r\n+    return wind * factor\r\n+\r\n+\r\n+def _convert_radiation("]
[156.921983, "o", "rs, units):\r\n+    \"\"\"Convert solar radiation to MJ m⁻² day⁻¹.\r\n+\r\n+    ``units`` is the string from the station register (e.g. \"MJ/m2/day\" or \"W/m2\").\r\n+    If the units contain the letter \"w\" we assume Watts per square metre and convert using\r\n+    ``MJ = W * 86400 / 1e6``. Otherwise the value "]
[156.922031, "o", "is returned unchanged (assumed to already be MJ).\r\n+    \"\"\"\r\n+    rs = np"]
