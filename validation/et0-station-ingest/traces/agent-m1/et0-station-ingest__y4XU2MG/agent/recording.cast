[224.357901, "i", "python - <<'PY'\nimport pandas as pd\nout = pd.read_csv('/app/output/et0.csv')\nref = pd.read_csv('/app/reference/metservice_et0_2025.csv').rename(columns={'et0_mm_day': 'reference'})\nassert list(out.columns) == ['station_id', 'date', 'et0_mm_day']\nassert len(out) == 8 * 365\nassert out[['station_id', 'date']].duplicated().sum() == 0\nassert not out.isna().any().any()\nx = out.merge(ref, on=['station_id', 'date'], how='inner', validate='one_to_one')\nx['difference'] = x['et0_mm_day'] - x['reference']\nsummary = x.groupby('station_id')['difference'].agg(['count', 'mean', 'min', 'max'])\nprint(summary.to_string())\nfor station_id, values in x.groupby('station_id')['difference']:\n    print(f'{station_id}: max absolute rounded-reference difference {values.abs().max():.3f} mm/day')\nprint('output rows:', len(out), '; output range:', out['et0_mm_day'].min(), 'to', out['et0_mm_day'].max(), 'mm/day')\nPY\nrm -rf /tmp/et0-portable /app/__pycache__ /app/et0/__pycache__\n"]
