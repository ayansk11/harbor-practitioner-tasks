[116.659722, "o", "\u001b[?2004l\r\u001b[?2004h"]
[116.659743, "o", "> "]
[116.659906, "o", "replacement = needle + '''def wind_speed_2m(uz, sensor_height):\r\n\u001b[?2004l\r"]
[116.65993, "o", "\u001b[?2004h"]
[116.659949, "o", "> "]
[116.660166, "o", "    \"\"\"Eq. 47: wind speed at 2 m from a measurement at sensor_height above ground.\"\"\"\r\n\u001b[?2004l\r"]
[116.660187, "o", "\u001b[?2004h"]
[116.660202, "o", "> "]
[116.660338, "o", "    sensor_height = np.asarray(sensor_height, float)\r\n\u001b[?2004l\r"]
[116.660356, "o", "\u001b[?2004h"]
[116.660372, "o", "> "]
[116.660466, "o", "    if np.any(sensor_height <= 0.0):\r\n\u001b[?2004l\r"]
[116.660485, "o", "\u001b[?2004h"]
[116.660501, "o", "> "]
[116.660664, "o", "        raise ValueError(\"wind sensor height must be positive\")\r\n\u001b[?2004l\r"]
[116.660692, "o", "\u001b[?2004h> "]
[116.660897, "o", "    return np.asarray(uz, float) * 4.87 / np.log(67.8 * sensor_height - 5.42)\r\n\u001b[?2004l\r"]
[116.660919, "o", "\u001b[?2004h"]
[116.660936, "o", "> "]
[116.660952, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
