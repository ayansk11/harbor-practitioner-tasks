[80.399553, "o", "\u001b[?2004l\r"]
[80.401013, "o", "    91\t    tmean = (tmax + tmin) / 2.0\r\n    92\t    delta = vapour_pressure_slope(tmean)\r\n    93\t    gamma = psychrometric_constant(atmospheric_pressure(elevation))\r\n    94\t    es = (saturation_vapour_pressure(tmax) + saturation_vapour_pressure(tmin)) / 2.0"]
[80.401042, "o", "\r\n    95\t    ra, _ = extraterrestrial_radiation(latitude, doy)\r\n    96\t    rso = clear_sky_radiation(ra, elevation)\r\n"]
[80.401067, "o", "    97\t    rns = (1.0 - ALBEDO) * rs\r\n    98\t    rnl = net_longwave_radiation(tmax, tmin, ea, rs, rso)\r\n    99\t    rn = rns - rnl\r\n   100\t    g = 0.0\r\n   101\t    num = 0.408 * delta * (rn - g) + gamma * (900.0 / (tmean + 273.0)) * u2 * (es - ea)\r\n   102\t    den = delta + gamma * (1.0 + 0.34 * u2)\r\n   103\t    return num / den\r\n"]
[80.401272, "o", "\u001b[?2004h"]
[80.401292, "o", "root@95685272-3c41-4761-b59a-814390f96fd6:/app# "]
[87.620669, "i", "nl -ba et0/fao56.py | sed -n '1,66p'\n"]
[87.620834, "o", "nl -ba et0/fao56.py | sed -n '1,66p'\r\n\u001b[?2004l\r"]
[87.622477, "o", "     1\t\"\"\"FAO-56 Penman-Monteith reference evapotranspiration, daily time step.\r\n     2\t\r\n     3\tImplements the daily procedure of FAO Irrigation and Drainage Paper 56 (Allen et al., 1998), chapters 3 and 4, as\r\n     4\twritten up in /app/docs/METHOD.md. Every function works on numpy arrays (one element per day).\r\n     5\t\r\n     6\tInputs expected by et0_daily (already in standard form):\r\n"]
[87.622524, "o", "     7\t    tmax, tmin   daily maximum and minimum air temperature [deg C]\r\n     8\t    u2           mean daily wind speed at 2 m above ground [m/s]\r\n     9\t    rs           incoming solar radiation [MJ m-2 day-1]\r\n    10\t    ea           actual vapour pressure [kPa] (see actual_vapour_pressure_*)\r\n    11\t    doy          day of the year, 1 = 1 January\r\n    12\t    latitude     decimal degrees, north positive, south negative\r\n    13\t    elevation    metres above sea level\r\n    14\t\"\"\"\r\n    15\timport numpy as np\r\n"]
[87.62256, "o", "    16\t\r\n    17\tSOLAR_CONSTANT = 0.0820        # MJ m-2 min-1\r\n    18\tSTEFAN_BOLTZMANN = 4.903e-9    # MJ K-4 m-2 day-1\r\n    19\tALBEDO = 0.23                  # hypothetical grass reference\r\n    20\t\r\n    21\t\r\n    22\tdef atmospheric_pressure(elevation):\r\n    23\t    \"\"\"Eq. 7, kPa.\"\"\"\r\n    24\t    return 101.3 * ((293.0 - 0.0065 * np.asarray(elevation, float)) / 293.0) ** 5.26\r\n    25\t\r\n    26\t\r\n    27\tdef psychrometric_constant(pressure):\r\n    28\t    \"\"\"Eq. 8, kPa/degC.\"\"\"\r\n    29\t    return 0.665e-3 * pressure\r\n    30\t\r\n    31\t\r\n"]
[87.622593, "o", "    32\tdef saturation_vapour_pressure(t):\r\n    33\t    \"\"\"Eq. 11, kPa.\"\"\"\r\n    34\t    t = np.asarray(t, float)\r\n    35\t    return 0.6108 * np.exp(17.27 * t / (t + 237.3))\r\n    36\t\r\n    37\t\r\n    38\tdef vapour_pressure_slope(t):\r\n    39\t    \"\"\"Eq. 13, kPa/degC.\"\"\"\r\n    40\t    t = np.asarray(t, float)\r\n    41\t    return 4098.0 * saturation_vapour_pressure(t) / (t + 237.3) ** 2\r\n    42\t\r\n    43\t\r\n    44\tdef actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min):\r\n    45\t    \"\"\"Eq. 17, kPa, from daily maximum and minimum relative humidity [%].\"\"\"\r\n    46\t    return (saturation_vapour_pressure(tmin) * np.asarray(rh_max, float) / 100.0\r\n    47\t            + saturation_vapour_pressure(tmax) * np.asarray(rh_min, float) / 100.0) / 2.0\r\n    48\t\r\n    49\t\r\n    50\tdef actual_vapour_pressure_dewpoint(tdew):\r\n    51\t    \"\"\"Eq. 14, kPa, from the daily mean dewpoint temperature [degC].\"\"\"\r\n    52\t    return saturation_vapour_pressure(tdew)\r\n"]
[87.622617, "o", "    53\t\r\n    54\t\r\n"]
[87.62264, "o", "    55\tdef extraterrestrial_radiation(latitude, doy):\r\n    56\t    \"\"\"Eqs. 21-25: Ra [MJ m-2 day-1] and the sunset hour angle ws [rad].\"\"\"\r\n    57\t    phi = np.deg2rad(np.asarray(latitude, float))\r\n    58\t    doy = np.asarray(doy, float)\r\n    59\t    dr = 1.0 + 0.033 * np.cos(2.0 * np.pi * doy / 365.0)\r\n    60\t    decl = 0.409 * np.sin(2.0 * np.pi * doy / 365.0 - 1.39)\r\n    61\t    ws = np.arccos(np.clip(-np.tan(phi) * np.tan(decl), -1.0, 1.0))\r\n    62\t    ra = (24.0 * 60.0 / np.pi) * SOLAR_CONSTANT * dr * (\r\n    63\t        ws * np.sin(phi) * np.sin(decl) + np.cos(phi) * np.cos(decl) * np.sin(ws))\r\n    64\t    return ra, ws\r\n    65\t\r\n    66\t\r\n"]
[87.622896, "o", "\u001b[?2004h"]
[87.622947, "o", "root@95685272-3c41-4761-b59a-814390f96fd6:/app# "]
[116.650699, "i", "cat > et0/meta.py <<'PY'\n\"\"\"Station register: read a station YAML file into Station records.\"\"\"\nimport re\nfrom dataclasses import dataclass\n\nimport yaml\n\n\n@dataclass(frozen=True)\nclass Station:\n    station_id: str\n    name: str\n    latitude: float          # decimal degrees, north positive\n    longitude: float\n    elevation_m: float\n    wind_height_m: float\n    radiation_units: str\n    humidity: str\n    network: str\n\n\n_DECIMAL = r\"[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)\"\n_UNSIGNED = r\"(?:\\d+(?:\\.\\d*)?|\\.\\d+)\"\n\n\ndef parse_latitude(value):\n    \"\"\"Return signed decimal degrees from a number or an unsigned N/S-suffixed string.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n\n    text = str(value).strip()\n    if re.fullmatch(_DECIMAL, text):\n        return float(text)\n\n    match = re.fullmatch(rf\"{_UNSIGNED}\\s*([NS])\", text, flags=re.IGNORECASE)\n    if not match:\n        raise ValueError(f\"invalid latitude {value!r}; expected decimal degrees or '<degrees>N'/'<degrees>S'\")\n    degrees = float(text[:-1]."]
[116.650796, "i", "strip())\n    return -degrees if match.group(1).upper() == \"S\" else degrees\n\n\ndef load_stations(path):\n    with open(path, encoding=\"utf-8\") as f:\n        doc = yaml.safe_load(f)\n    stations = []\n    for rec in doc[\"stations\"]:\n        stations.append(Station(\n            station_id=str(rec[\"id\"]),\n            name=str(rec.get(\"name\", \"\")),\n            latitude=parse_latitude(rec[\"latitude\"]),\n            longitude=float(rec[\"longitude\"]),\n            elevation_m=float(rec[\"elevation_m\"]),\n            wind_height_m=float(rec[\"wind_height_m\"]),\n            radiation_units=str(rec[\"radiation_units\"]),\n            humidity=str(rec[\"humidity\"]),\n            network=str(rec.get(\"network\", \"\")),\n        ))\n    return stations\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('et0/fao56.py')\ns = p.read_text()\nneedle = '''def daylight_hours(ws):\n    \"\"\"Eq. 34, hours.\"\"\"\n    return 24.0 / np.pi * ws\n\n\n'''\nreplacement = needle + '''def wind_speed_2m(uz, sensor_height):\n    \"\"\"Eq. 47: wind speed at 2 m from a measure"]
[116.650821, "i", "ment at sensor_height above ground.\"\"\"\n    sensor_height = np.asarray(sensor_height, float)\n    if np.any(sensor_height <= 0.0):\n        raise ValueError(\"wind sensor height must be positive\")\n    return np.asarray(uz, float) * 4.87 / np.log(67.8 * sensor_height - 5.42)\n\n\n'''\nif needle not in s:\n    raise SystemExit('insertion point not found')\np.write_text(s.replace(needle, replacement, 1))\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('et0/ingest.py')\ns = p.read_text()\ns = s.replace('''BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n''', '''BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\nRADIATION_FACTORS = {\"MJ/m2/day\": 1.0, \"W/m2\": 0.0864}\n''')\ns = s.replace('''    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station."]
[116.650842, "o", "cat > et0/meta.py <<'PY'\r\n\u001b[?2004l\r"]
