[116.659395, "o", "needle = '''def daylight_hours(ws):\r\n\u001b[?2004l\r"]
[116.659413, "o", "\u001b[?2004h"]
[116.659435, "o", "> "]
[116.659494, "o", "    \"\"\"Eq. 34, hours.\"\"\"\r\n\u001b[?2004l\r"]
[116.659511, "o", "\u001b[?2004h"]
[116.659527, "o", "> "]
[116.659603, "o", "    return 24.0 / np.pi * ws\r\n\u001b[?2004l\r"]
[116.65962, "o", "\u001b[?2004h"]
