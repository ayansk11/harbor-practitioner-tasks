[261.938583, "i", "python - <<'PY'\nimport pandas as pd\nfrom pathlib import Path\nassert not list(Path('/app/et0').rglob('*.pyc'))\nout = pd.read_csv('/app/output/et0.csv')\nref = pd.read_csv('/app/reference/metservice_et0_2025.csv').rename(columns={'et0_mm_day': 'reference'})\nassert list(out.columns) == ['station_id', 'date', 'et0_mm_day']\nassert len(out) == 8 * 365 and not out.duplicated(['station_id', 'date']).any() and not out.isna().any().any()\nx = out.merge(ref, on=['station_id', 'date'], validate='one_to_one')\nx['difference'] = x['et0_mm_day'] - x['reference']\nfor station_id, values in x.groupby('station_id')['difference']:\n    print(f'{station_id}: {len(values)} days, max absolute difference {values.abs().max():.3f} mm/day')\nprint('schema and 2920-row coverage: OK')\nPY\nrm -rf /app/__pycache__ /app/et0/__pycache__\n"]
