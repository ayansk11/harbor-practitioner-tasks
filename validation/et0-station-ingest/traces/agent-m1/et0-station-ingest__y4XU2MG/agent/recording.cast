[44.746397, "i", "python - <<'PY'\nimport pandas as pd\nfrom et0 import meta\nfor s in meta.load_stations('config/stations.yaml'):\n    print(s.station_id, 'lat=', s.latitude, 'z=', s.elevation_m, 'zw=', s.wind_height_m, 'rad=', s.radiation_units, 'humidity=', s.humidity)\ncur = pd.read_csv('output/et0.csv', parse_dates=['date'])\nref = pd.read_csv('reference/metservice_et0_2025.csv', parse_dates=['date'])\nx = cur.merge(ref, on=['station_id','date'], how='inner', suffixes==('', '_ref') if False else ('','_ref'))\nx['diff'] = x['et0_mm_day'] - x['et0_ref_mm_day']\nprint('\\nReference comparison (current - published):')\nprint(x.groupby('station_id')['diff'].agg(['count','mean','min','max']).to_string())\nprint('\\nDaily comparison:')\nprint(x[['station_id','date','et0_mm_day','et0_ref_mm_day','diff']].head(20).to_string(index=False))\nPY\n"]
