[8.068234, "o", "26,2.0\r\nCDB,2025-05-27,2.8\r\nCDB,2025-05-28,2.4\r\nCDB,2025-05-29,2.9\r\nCDB,2025-05-30,3.1\r\nCDB,2025-05-31,1.6\r\nCDB,2025-06-01,1.7\r\nCDB,2025-06-02,1.9\r\nCDB,2025-06-03,2.2\r\nCDB,2025-06-04,2.6\r\nCDB,2025-06-05,2.8\r\nCDB,2025-06-06,2.0\r\nCDB,2025-06-07,1.8\r\nCDB,2025-06-08,2.2\r\nCDB,2025-06-09,2.5\r\nCDB,2025-06-10,2.5\r\nCDB,2025-06-11,1.7\r\nCDB,2025-06-12,2.4\r\nCDB,2025-06-13,1.7\r\nCDB,2025-06-14,1.5\r\nCDB,2025-06-15,1.8\r\nCDB,2025-06-16,1.9\r\nCDB,2025-06-17,2.0\r\nCDB,2025-06-18,3.4\r\nCDB,2025-06-19,2.8\r\nCDB,2025-06-20,1.4\r\nCDB,2025-06-21,1.9\r\nCDB,2025-06-22,1.8\r\nCDB,2025-06-23,2.0\r\nCDB,2025-06-24,1.7\r\nCDB,2025-06-25,1.6\r\nCDB,2025-06-26,1.8\r\nCDB,2025-06-27,1.6\r\nCDB,2025-06-28,2.3\r\nCDB,2025-06-29,1.4\r\nCDB,2025-06-30,2.1\r\nCDB,2025-07-01,1.7\r\nCDB,2025-07-02,1.8\r\nCDB,2025-07-03,1.6\r\nCDB,2025-07-04,1.9\r\nCDB,2025-07-05,1.9\r\nCDB,2025-07-06,1.8\r\nCDB,2025-07-07,1.9\r\nCDB,2025-07-08,1.5\r\nCDB,2025-07-09,1.3\r\nCDB,2025-07-10,2.1\r\nCDB,2025-07-11,1.6\r\nCDB,2025-07-12,1.6\r\nCDB,2025-07-13,2.0\r\nCDB,2025-07-14,2.3\r\nCDB,2025-07-15,3.1\r\nCDB,2025-07-16,1"]
