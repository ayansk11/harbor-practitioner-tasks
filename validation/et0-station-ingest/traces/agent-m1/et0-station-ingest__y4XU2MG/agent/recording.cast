[179.659855, "i", "printf '%s\\n' '--- meta.py ---'; sed -n '1,220p' et0/meta.py; printf '%s\\n' '--- ingest.py ---'; sed -n '1,220p' et0/ingest.py; printf '%s\\n' '--- wind function ---'; grep -A10 -B2 'def wind_speed_2m' et0/fao56.py\n"]
[179.660479, "o", "printf '%s\\n' '--- meta.py ---'; sed -n '1,220p' et0/meta.py; printf '%s\\n' '--- ingest.py ---'; sed -n '1,220p' et0/ingest.py; printf '%s\\n' '--- wind function ---'; grep -A10 -B2 'def wind_speed_2m' et0/fao56.py\r\n"]
[179.660513, "o", "\u001b[?2004l\r"]
[179.660535, "o", "--- meta.py ---\r\n"]
[179.661782, "o", "\"\"\"Station register: read a station YAML file into Station records.\"\"\"\r\nimport re\r\nfrom dataclasses import dataclass\r\n\r\nimport yaml\r\n\r\n\r\n@dataclass(frozen=True)\r\n"]
[179.661809, "o", "class Station:\r\n    station_id: str\r\n    name: str\r\n    latitude: float          # decimal degrees, north positive\r\n    longitude: float\r\n    elevation_m: float\r\n    wind_height_m: float\r\n"]
[179.661833, "o", "    radiation_units: str\r\n    humidity: str\r\n    network: str\r\n\r\n\r\n_DECIMAL = r\"[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)\"\r\n_UNSIGNED = r\"(?:\\d+(?:\\.\\d*)?|\\.\\d+)\"\r\n\r\n\r\ndef parse_latitude(value):\r\n    \"\"\"Return signed decimal degrees from a number or an unsigned N/S-suffixed string.\"\"\"\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = str(value).strip()\r\n    if re.fullmatch(_DECIMAL, text):\r\n        return float(text)\r\n"]
[179.661855, "o", "\r\n    match = re.fullmatch(rf\"{_UNSIGNED}\\s*([NS])\", text, flags=re.IGNORECASE)\r\n    if not match:\r\n        raise ValueError(f\"invalid latitude {value!r}; expected decimal degrees or '<degrees>N'/'<degrees>S'\")\r\n    degrees = float(text[:-1].strip())\r\n    return -degrees if match.group(1).upper() == \"S\" else degrees\r\n\r\n\r\ndef load_stations(path):\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        doc = yaml.safe_load(f)\r\n    stations = []"]
[179.661875, "o", "\r\n    for rec in doc[\"stations\"]:\r\n        stations.append(Station(\r\n            station_id=str(rec[\"id\"]),\r\n            name=str(rec.get(\"name\", \"\")),\r\n            latitude=parse_latitude(rec[\"latitude\"]),\r\n            longitude=float(rec[\"longitude\"]),\r\n            elevation_m=float(rec[\"elevation_m\"]),\r\n            wind_height_m=float(rec[\"wind_height_m\"]),\r\n            radiation_units=str(rec[\"radiation_units\"]),\r\n            humidity=str(rec[\"humidity\"]),\r\n            network=str(rec.get(\"network\", \"\")),\r\n"]
[179.661895, "o", "        ))\r\n    return stations\r\n"]
[179.662087, "o", "--- ingest.py ---\r\n"]
[179.663498, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\nimport os\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n"]
[179.663518, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\nRADIATION_FACTORS = {\"MJ/m2/day\": 1.0, \"W/m2\": 0.0864}\r\n\r\n"]
[179.66354, "o", "\r\ndef load_station(station, data_dir):\r\n    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    raw = pd.read_csv(path)\r\n    if station.humidity not in HUMIDITY_COLUMNS:\r\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    if station.radiation_units not in RADIATION_FACTORS:\r\n        raise ValueError(f\"{station.station_id}: unknown radiation unit {station.radiation_units!r}\")\r\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    if missing:\r\n"]
[179.663562, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\r\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    df = pd.DataFrame({\r\n"]
[179.663594, "o", "        \"station_id\": station.station_id,\r\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n        \"doy\": dates.dt.dayofyear.astype(int),\r\n        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    })\r\n    if station.humidity == \"dewpoint\":\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    else:\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n                                                   raw[\"rh_min_pct\"].astype(float))\r\n    df[\"u2\"] = fao56.wind_speed_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n    df[\"rs\"] = raw[\"solar_rad\"].astype(float) * RADIATION_FACTORS[station.radiation_units]\r\n    return df\r\n"]
[179.663757, "o", "--- wind function ---\r\n"]
[179.664959, "o", "\r\n\r\ndef wind_speed_2m(uz, sensor_height):\r\n    \"\"\"Eq. 47: wind speed at 2 m from a measurement at sensor_height above ground.\"\"\"\r\n    sensor_height = np.asarray(sensor_height, float)\r\n    if np.any(sensor_height <= 0.0):\r\n"]
[179.664977, "o", "        raise ValueError(\"wind sensor height must be positive\")\r\n    return np.asarray(uz, float) * 4.87 / np.log(67.8 * sensor_height - 5.42)\r\n\r\n\r\ndef clear_sky_radiation(ra, elevation):\r\n"]
[179.664997, "o", "    \"\"\"Eq. 37, MJ m-2 day-1.\"\"\"\r\n    return (0.75 + 2e-5 * np.asarray(elevation, float)) * ra\r\n"]
[179.665166, "o", "\u001b[?2004h"]
[179.665188, "o", "root@95685272-3c41-4761-b59a-814390f96fd6:/app# "]
