[80.084501, "o", "     9\t    rs           incoming solar radiation [MJ m-2 day-1]\r\n    10\t    ea           actual vapour pressure [kPa] (see actual_vapour_pressure_*)\r\n    11\t    doy          day of the year, 1 = 1 January\r\n    12\t    latitude     decimal degrees, north positive, south negative\r\n    13\t    elevation    metres above sea level\r\n"]
[80.084527, "o", "    14\t\"\"\"\r\n    15\timport numpy as np\r\n    16\t\r\n    17\tSOLAR_CONSTANT = 0.0820        # MJ m-2 min-1\r\n    18\tSTEFAN_BOLTZMANN = 4.903e-9    # MJ K-4 m-2 day-1\r\n    19\tALBEDO = 0.23                  # hypothetical grass reference\r\n    20\t\r\n    21\t\r\n    22\tdef atmospheric_pressure(elevation):\r\n    23\t    \"\"\"Eq. 7, kPa.\"\"\"\r\n    24\t    return 101.3 * ((293.0 - 0.0065 * np.asarray(elevation, float)) / 293.0) ** 5.26\r\n    25\t\r\n    26\t\r\n    27\tdef psychrometric_constant(pressure):\r\n    28\t    \"\"\"Eq. 8, kPa/degC.\"\"\"\r\n    29\t    return 0.665e-3 * pressure\r\n    30\t\r\n    31\t\r\n    32"]
[80.084548, "o", "\tdef saturation_vapour_pressure(t):\r\n    33\t    \"\"\"Eq. 11, kPa.\"\"\"\r\n    34\t    t = np.asarray(t, float)\r\n    35\t    return 0.6108 * np.exp(17.27 * t / (t + 237.3))\r\n    36\t\r\n    37\t\r\n    38\tdef vapour_pressure_slope(t):\r\n    39\t    \"\"\"Eq. 13, kPa/degC.\"\"\"\r\n    40"]
[80.084578, "o", "\t    t = np.asarray(t, float)\r\n    41\t    return 4098.0 * saturation_vapour_pressure(t) / (t + 237.3) ** 2\r\n    42\t\r\n    43\t\r\n    44\tdef actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min):\r\n    45\t    \"\"\"Eq. 17, kPa, from daily maximum and minimum relative humidity [%].\"\"\"\r\n    46\t    return (saturation_vapour_pressure(tmin) * np.asarray(rh_max, float) / 100.0\r\n    47\t            + saturation_vapour_pressure(tmax) * np.asarray(rh_min, float) / 100.0) / 2.0\r\n    48\t\r\n"]
[80.084597, "o", "    49\t\r\n    50\tdef actual_vapour_pressure_dewpoint(tdew):\r\n    51\t    \"\"\"Eq. 14, kPa, from the daily mean dewpoint temperature [degC].\"\"\"\r\n    52\t    return saturation_vapour_pressure(tdew)\r\n    53\t\r\n    54"]
[80.084623, "o", "\t\r\n    55\tdef extraterrestrial_radiation(latitude, doy):\r\n    56\t    \"\"\"Eqs. 21-25: Ra [MJ m-2 day-1] and the sunset hour angle ws [rad].\"\"\"\r\n    57\t    phi = np.deg2rad(np.asarray(latitude, float))\r\n    58\t    doy = np.asarray(doy, float)\r\n    59\t    dr = 1.0 + 0.033 * np.cos(2.0 * np.pi * doy / 365.0)\r\n    60\t    decl = 0.409 * np.sin(2.0 * np.pi * doy / 365.0 - 1.39)\r\n"]
[80.084638, "o", "    61\t    ws = np.arccos(np.clip(-np.tan(phi) * np.tan(decl), -1.0, 1.0))\r\n    62\t    ra = (24.0 * 60.0 / np.pi) * SOLAR_CONSTANT * dr * (\r\n    63\t"]
[80.084656, "o", "        ws * np.sin(phi) * np.sin(decl) + np.cos(phi) * np.cos(decl) * np.sin(ws))\r\n    64\t    return ra, ws\r\n    65\t\r\n    66\t\r\n    67\tdef daylight_hours(ws):\r\n    68\t    \"\"\"Eq. 34, hours.\"\"\"\r\n    69\t    return 24.0 / np.pi * ws\r\n    70\t\r\n"]
[80.084674, "o", "    71\t\r\n    72\tdef clear_sky_radiation(ra, elevation):\r\n    73\t    \"\"\"Eq. 37, MJ m-2 day-1.\"\"\"\r\n    74\t    return (0.75 + 2e-5 * np.asarray(elevation, float)) * ra\r\n    75\t\r\n    76\t\r\n    77\tdef net_longwave_radiation(tmax, tmin, ea, rs, rso):\r\n"]
[80.084696, "o", "    78\t    \"\"\"Eq. 39, MJ m-2 day-1. Rs/Rso is limited to 1.0.\"\"\"\r\n    79\t    rel = np.minimum(np.asarray(rs, float) / rso, 1.0)\r\n    80\t    tk4 = ((np.asarray(tmax, float) + 273.16) ** 4 + (np.asarray(tmin, float) + 273.16) ** 4) / 2.0\r\n    81\t    return STEFAN_BOLTZMANN * tk4 * (0.34 - 0.14 * np.sqrt(ea)) * (1.35 * rel - 0.35)\r\n    82\t\r\n    83\t\r\n    84"]
