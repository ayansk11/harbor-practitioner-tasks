[179.981713, "i", "oup /tmp/et0-portable && su -s /bin/sh nobody -c 'cd /tmp/et0-portable && python -m et0.pipeline --stations test-stations.yaml --data data --out output/test.csv' && printf '\\n--- portable output ---\\n' && cat /tmp/et0-portable/output/test.csv\n"]
