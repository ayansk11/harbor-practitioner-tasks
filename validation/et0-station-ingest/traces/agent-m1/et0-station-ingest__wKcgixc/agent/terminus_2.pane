[?2004l[?2004h> +    factor = 4.87 / np.log(67.8 * height_m - 5.42)
[?2004l[?2004h> +    return wind_speed * factor
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def _convert_radiation(radiation, units):
[?2004l[?2004h> +    """Convert raw solar radiation to MJ m⁻² day⁻¹.
[?2004l[?2004h> +
[?2004l[?2004h> +    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be
[?2004l[?2004h> +    ``"MJ/m2/day"`` or ``"W/m2"`` (the latter includes possible variations like ``"W/m^2"``).
[?2004l[?2004h> +    """
[?2004l[?2004h> +    if units.lower().startswith("w"):
[?2004l[?2004h> +        return radiation * 0.0864
[?2004l[?2004h> +    return radiation
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def load_station(station, data_dir):
[?2004l[?2004h> +    """Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.
[?2004l[?2004h> +
[?2004l[?2004h> +    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    path = os.path.join(data_dir, f"{station.station_id}.csv")
[?2004l[?2004h> +    raw = pd.read_csv(path)
[?2004l[?2004h> +
[?2004l[?2004h> +    if station.humidity not in HUMIDITY_COLUMNS:
[?2004l[?2004h> +        raise ValueError(f"{station.station_id}: unknown humidity type {station.humidity!r}")
[?2004l[?2004h> +
[?2004l[?2004h> +    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]
[?2004l[?2004h> +    if missing:
