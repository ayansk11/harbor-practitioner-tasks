[?2004l[?2004h> +    """
[?2004l[?2004h> +    if units.lower().startswith("w"):
[?2004l[?2004h> +        return radiation * 0.0864
[?2004l[?2004h> +    return radiation
[?2004l[?2004h> +
[?2004l[?2004h> +
