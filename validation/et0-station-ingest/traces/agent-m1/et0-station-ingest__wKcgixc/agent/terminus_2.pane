[?2004l[?2004h> +
[?2004l[?2004h> +These conversions make the pipeline robust for *any* station register that follows the formats described in the
[?2004l[?2004h> +method document.
[?2004l[?2004h> +"""
[?2004l[?2004h> +
[?2004l[?2004h> +import os
[?2004l[?2004h> +import numpy as np
[?2004l[?2004h> +
[?2004l[?2004h> +import pandas as pd
[?2004l[?2004h> +
[?2004l[?2004h> +from . import fao56
[?2004l[?2004h> +
[?2004l[?2004h> +BASE_COLUMNS = ["date", "tmax_c", "tmin_c", "wind_ms", "solar_rad"]
[?2004l[?2004h> +HUMIDITY_COLUMNS = {"rh_minmax": ["rh_max_pct", "rh_min_pct"], "dewpoint": ["tdew_c"]}
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def _convert_wind_to_2m(wind_speed, height_m):
[?2004l[?2004h> +    """Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.
[?2004l[?2004h> +
[?2004l[?2004h> +    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    if height_m == 2.0:
[?2004l[?2004h> +        return wind_speed
[?2004l[?2004h> +    factor = 4.87 / np.log(67.8 * height_m - 5.42)
[?2004l[?2004h> +    return wind_speed * factor
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def _convert_radiation(radiation, units):
[?2004l[?2004h> +    """Convert raw solar radiation to MJ m⁻² day⁻¹.
[?2004l[?2004h> +
[?2004l[?2004h> +    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be
[?2004l[?2004h> +    ``"MJ/m2/day"`` or ``"W/m2"`` (the latter includes possible variations like ``"W/m^2"``).
[?2004l[?2004h> +    """
[?2004l[?2004h> +    if units.lower().startswith("w"):
[?2004l[?2004h> +        return radiation * 0.0864
[?2004l[?2004h> +    return radiation
[?2004l[?2004h> +
[?2004l[?2004h> +
[?2004l[?2004h> +def load_station(station, data_dir):
[?2004l[?2004h> +    """Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.
[?2004l[?2004h> +
[?2004l[?2004h> +    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.
[?2004l[?2004h> +    """
[?2004l[?2004h> +    path = os.path.join(data_dir, f"{station.station_id}.csv")
[?2004l[?2004h> +    raw = pd.read_csv(path)
[?2004l[?2004h> +
[?2004l[?2004h> +    if station.humidity not in HUMIDITY_COLUMNS:
[?2004l[?2004h> +        raise ValueError(f"{station.station_id}: unknown humidity type {station.humidity!r}")
[?2004l[?2004h> +
[?2004l[?2004h> +    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]
[?2004l[?2004h> +    if missing:
[?2004l[?2004h> +        raise ValueError(f"{path}: missing columns {missing}")
[?2004l[?2004h> +
[?2004l[?2004h> +    dates = pd.to_datetime(raw["date"], format="%Y-%m-%d")
[?2004l[?2004h> +    df = pd.DataFrame({
[?2004l[?2004h> +        "station_id": station.station_id,
[?2004l[?2004h> +        "date": dates.dt.strftime("%Y-%m-%d"),
[?2004l[?2004h> +        "doy": dates.dt.dayofyear.astype(int),
[?2004l[?2004h> +        "tmax": raw["tmax_c"].astype(float),
[?2004l[?2004h> +        "tmin": raw["tmin_c"].astype(float),
[?2004l[?2004h> +    })
[?2004l[?2004h> +
[?2004l[?2004h> +    # Actual vapour pressure (ea)
[?2004l[?2004h> +    if station.humidity == "dewpoint":
[?2004l[?2004h> +        df["ea"] = fao56.actual_vapour_pressure_dewpoint(raw["tdew_c"].astype(float))
[?2004l[?2004h> +    else:
[?2004l[?2004h> +        df["ea"] = fao56.actual_vapour_pressure_rh(
[?2004l[?2004h> +            df["tmax"],
[?2004l[?2004h> +            df["tmin"],
[?2004l[?2004h> +            raw["rh_max_pct"].astype(float),
[?2004l[?2004h> +            raw["rh_min_pct"].astype(float),
[?2004l[?2004h> +        )
[?2004l[?2004h> +
[?2004l[?2004h> +    # Wind speed conversion to 2 m height
[?2004l[?2004h> +    df["u2"] = _convert_wind_to_2m(raw["wind_ms"].astype(float), station.wind_height_m)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Solar radiation conversion to MJ m⁻² day⁻¹
[?2004l[?2004h> +    df["rs"] = _convert_radiation(raw["solar_rad"].astype(float), station.radiation_units)
[?2004l[?2004h> +
[?2004l[?2004h> +    return df
[?2004l[?2004h> +
[?2004l[?2004h> +EOF
[?2004l[?2004h> python - <<'PY'
[?2004l[?2004h> import subprocess, sys
[?2004l[?2004h> cmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']
[?2004l[?2004h> proc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)
[?2004l[?2004h> print('STDOUT:')
