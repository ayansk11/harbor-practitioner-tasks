[?2004l[?2004h> +        )
[?2004l[?2004h> +
[?2004l[?2004h> +    # Wind speed conversion to 2 m height
[?2004l[?2004h> +    df["u2"] = _convert_wind_to_2m(raw["wind_ms"].astype(float), station.wind_height_m)
[?2004l[?2004h> +
[?2004l[?2004h> +    # Solar radiation conversion to MJ m⁻² day‑1
[?2004l[?2004h> +    df["rs"] = _convert_radiation(raw["solar_rad"].astype(float), station.radiation_units)
[?2004l[?2004h> +
[?2004l[?2004h> +    return df
[?2004l[?2004h> +
[?2004l[?2004h> +EOF
[?2004l[?2004h> python - <<'PY'
[?2004l[?2004h> import subprocess, sys
[?2004l[?2004h> cmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']
[?2004l[?2004h> proc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)
[?2004l[?2004h> print('STDOUT:')
[?2004l[?2004h> print(proc.stdout)
[?2004l[?2004h> print('STDERR:', file=sys.stderr)
[?2004l[?2004h> print(proc.stderr, file=sys.stderr)
[?2004l[?2004h> print('Return code:', proc.returncode)
