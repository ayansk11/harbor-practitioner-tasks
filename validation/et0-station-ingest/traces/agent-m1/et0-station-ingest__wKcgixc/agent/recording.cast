[85.303494, "o", "rror(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n+\r\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.hu"]
[85.303516, "o", "midity] if c not in raw.columns]\r\n+    if missing:\r\n+        raise ValueError(f\"{path}: missing columns {missin"]
[85.303538, "o", "g}\")\r\n+\r\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\""]
[85.303561, "o", ")\r\n+    df = pd.DataFrame({\r\n+        \"station_id\": station.station_id,\r\n+        \"date\": dates.dt.strftime("]
[85.303579, "o", "\"%Y-%m-%d\"),\r\n+   "]
[85.303623, "o", "     \"doy\": dates.dt.dayofyea"]
[85.303651, "o", "r.astype(int),\r\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n+    })\r\n+\r\n+    # Actual vapour pressure (ea)\r\n+    if station.humidity == \"dewpoint\":\r\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"]"]
[85.30368, "o", ".astype(float))\r\n+    else:\r\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n+        "]
[85.303702, "o", "    df[\"tmax\"],\r\n+            df[\"tmin\"],\r\n+            raw[\"rh_max_pct\"].astype(float),\r\n+            raw[\""]
[85.303722, "o", "rh_min_pct\"].astype(float),\r\n+        )\r\n+\r\n+    # Wind speed conversion to 2 m height\r\n+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n+\r\n+    # Solar radiation conversion"]
[85.303744, "o", " to MJ m⁻² day⁻¹\r\n+    "]
[85.303762, "o", "df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n+\r\n+    return df\r\n+\r\n+EOF\r\n"]
[85.303785, "o", "\u001b[?2004h> "]
[85.30408, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[85.304108, "o", "\u001b[?2004h> "]
[85.304128, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.304434, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.304462, "o", "> "]
[85.30466, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[85.304698, "o", "\u001b[?2004h> "]
[85.304719, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.304837, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[85.304861, "o", "\u001b[?2004h"]
[85.304884, "o", "> "]
[85.30517, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.305192, "o", "> "]
[85.305259, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[85.305282, "o", "\u001b[?2004h"]
[85.305305, "o", "> "]
[85.305586, "o", "+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[85.305607, "o", "\u001b[?2004h> "]
[85.305809, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[85.305836, "o", "\u001b[?2004h"]
[85.305854, "o", "> "]
[85.305871, "o", "+\r\n\u001b[?2004l\r"]
[85.305891, "o", "\u001b[?2004h> "]
[85.306009, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\r\n\u001b[?2004l\r"]
[85.306031, "o", "\u001b[?2004h"]
[85.30605, "o", "> +\r\n\u001b[?2004l\r"]
[85.306072, "o", "\u001b[?2004h"]
[85.306094, "o", "> "]
[85.306222, "o", "+  where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[85.306243, "o", "\u001b[?2004h"]
[85.306259, "o", "> "]
[85.306592, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\r\n\u001b[?2004l\r"]
[85.306614, "o", "\u001b[?2004h> "]
[85.307002, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
[85.307026, "o", "\u001b[?2004h> "]
[85.307045, "o", "+\r\n\u001b[?2004l\r"]
[85.307068, "o", "\u001b[?2004h"]
[85.30709, "o", "> "]
[85.30737, "o", "+These conversions make the pipeline robust for *any* station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[85.307397, "o", "\u001b[?2004h> "]
[85.30745, "o", "+method document.\r\n\u001b[?2004l\r"]
[85.307472, "o", "\u001b[?2004h> "]
[85.307493, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[85.307509, "o", "\u001b[?2004h"]
[85.30753, "o", "> +\r\n\u001b[?2004l\r"]
[85.307548, "o", "\u001b[?2004h"]
[85.30757, "o", "> "]
[85.307595, "o", "+import os\r\n\u001b[?2004l\r"]
[85.307611, "o", "\u001b[?2004h"]
[85.307634, "o", "> "]
[85.307686, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[85.307702, "o", "\u001b[?2004h"]
[85.307723, "o", "> "]
[85.307744, "o", "+\r\n\u001b[?2004l\r"]
[85.307764, "o", "\u001b[?2004h> "]
[85.307812, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[85.307829, "o", "\u001b[?2004h"]
[85.307847, "o", "> "]
[85.307864, "o", "+\r\n\u001b[?2004l\r"]
[85.307887, "o", "\u001b[?2004h> "]
[85.307941, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[85.307963, "o", "\u001b[?2004h> "]
[85.307987, "o", "+\r\n\u001b[?2004l\r"]
[85.308008, "o", "\u001b[?2004h> "]
[85.3082, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[85.308221, "o", "\u001b[?2004h"]
[85.308237, "o", "> "]
[85.308462, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[85.308485, "o", "\u001b[?2004h> "]
[85.308507, "o", "+\r\n\u001b[?2004l\r"]
[85.308529, "o", "\u001b[?2004h> "]
[85.30855, "o", "+\r\n\u001b[?2004l\r"]
[85.30857, "o", "\u001b[?2004h> "]
[85.30869, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[85.308711, "o", "\u001b[?2004h"]
[85.308733, "o", "> "]
[85.308949, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[85.308965, "o", "\u001b[?2004h"]
[85.308987, "o", "> +\r\n\u001b[?2004l\r"]
[85.309012, "o", "\u001b[?2004h"]
[85.309034, "o", "> "]
[85.309289, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[85.309311, "o", "\u001b[?2004h> "]
[85.309343, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[85.309365, "o", "\u001b[?2004h> "]
[85.309442, "o", "+    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[85.30946, "o", "\u001b[?2004h"]
[85.309482, "o", "> "]
[85.309545, "o", "+        return wind_speed\r\n\u001b[?2004l\r"]
[85.309562, "o", "\u001b[?2004h"]
[85.309588, "o", "> "]
[85.309716, "o", "+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[85.309738, "o", "\u001b[?2004h> "]
[85.309829, "o", "+    return wind_speed * factor\r\n\u001b[?2004l\r"]
[85.309846, "o", "\u001b[?2004h"]
[85.309867, "o", "> +"]
[85.30989, "o", "\r\n\u001b[?2004l\r"]
[85.309908, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[85.309926, "o", "\u001b[?2004h"]
[85.309943, "o", "> "]
[85.31005, "o", "+def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[85.310072, "o", "\u001b[?2004h"]
[85.31009, "o", "> "]
[85.310254, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[85.310275, "o", "\u001b[?2004h> "]
[85.310293, "o", "+\r\n\u001b[?2004l\r"]
[85.310316, "o", "\u001b[?2004h"]
[85.310336, "o", "> "]
[85.310618, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[85.310651, "o", "\u001b[?2004h> "]
[85.310937, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[85.310959, "o", "\u001b[?2004h"]
[85.310979, "o", "> "]
[85.311013, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.311054, "o", "> "]
[85.31114, "o", "+    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[85.31117, "o", "\u001b[?2004h"]
[85.311189, "o", "> "]
[85.311263, "o", "+        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[85.311294, "o", "\u001b[?2004h> "]
[85.311344, "o", "+    return radiation\r\n\u001b[?2004l\r"]
[85.311366, "o", "\u001b[?2004h> +\r\n"]
[85.311384, "o", "\u001b[?2004l\r"]
[85.311407, "o", "\u001b[?2004h> "]
[85.311428, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.311448, "o", "> "]
[85.311522, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[85.311542, "o", "\u001b[?2004h> "]
[85.311787, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[85.311807, "o", "\u001b[?2004h> "]
[85.311825, "o", "+\r\n\u001b[?2004l\r"]
[85.311849, "o", "\u001b[?2004h> "]
[85.312005, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[85.312033, "o", "\u001b[?2004h> "]
[85.312061, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[85.312079, "o", "\u001b[?2004h"]
[85.312098, "o", "> "]
[85.312273, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[85.312297, "o", "\u001b[?2004h> "]
[85.312378, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[85.312395, "o", "\u001b[?2004h"]
[85.312414, "o", "> +\r\n"]
[85.312431, "o", "\u001b[?2004l\r\u001b[?2004h"]
[85.31245, "o", "> "]
[85.312573, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[85.31259, "o", "\u001b[?2004h"]
[85.312608, "o", "> "]
[85.312848, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[85.312866, "o", "\u001b[?2004h"]
[85.312893, "o", "> "]
[85.312924, "o", "+\r\n\u001b[?2004l\r"]
[85.312942, "o", "\u001b[?2004h> "]
[85.313204, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[85.313224, "o", "\u001b[?2004h"]
[85.313241, "o", "> "]
[85.313284, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[85.313308, "o", "\u001b[?2004h"]
[85.313325, "o", "> "]
[85.313518, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[85.313545, "o", "\u001b[?2004h> "]
[85.313566, "o", "+\r\n\u001b[?2004l\r"]
[85.313583, "o", "\u001b[?2004h> "]
[85.313747, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[85.313769, "o", "\u001b[?2004h"]
[85.313783, "o", "> "]
[85.313837, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[85.31386, "o", "\u001b[?2004h> "]
[85.313973, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[85.313994, "o", "\u001b[?2004h"]
[85.314008, "o", "> "]
[85.314119, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[85.31414, "o", "\u001b[?2004h> "]
[85.314273, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[85.314293, "o", "\u001b[?2004h"]
[85.314308, "o", "> "]
[85.314412, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[85.314428, "o", "\u001b[?2004h"]
[85.314438, "o", "> "]
[85.314553, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[85.31457, "o", "\u001b[?2004h"]
[85.314585, "o", "> "]
[85.314602, "o", "+    })\r\n\u001b[?2004l\r"]
[85.314627, "o", "\u001b[?2004h"]
[85.314647, "o", "> +\r\n\u001b[?2004l\r"]
[85.314664, "o", "\u001b[?2004h> "]
[85.31474, "o", "+    # Actual vapour pressure (ea)\r\n\u001b[?2004l\r"]
[85.314759, "o", "\u001b[?2004h> "]
[85.314884, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[85.314907, "o", "\u001b[?2004h> "]
[85.315156, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[85.315186, "o", "\u001b[?2004h> "]
[85.315218, "o", "+    else:\r\n\u001b[?2004l\r"]
[85.315237, "o", "\u001b[?2004h"]
[85.315254, "o", "> "]
[85.315407, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[85.315431, "o", "\u001b[?2004h> "]
[85.315503, "o", "+            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[85.315532, "o", "\u001b[?2004h"]
[85.315556, "o", "> "]
[85.315603, "o", "+            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[85.315626, "o", "\u001b[?2004h> "]
[85.315753, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[85.315769, "o", "\u001b[?2004h"]
[85.315789, "o", "> "]
[85.315907, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[85.315926, "o", "\u001b[?2004h"]
[85.315947, "o", "> "]
[85.315973, "o", "+        )\r\n\u001b[?2004l\r"]
[85.315994, "o", "\u001b[?2004h"]
[85.316018, "o", "> +\r\n\u001b[?2004l\r"]
[85.316041, "o", "\u001b[?2004h> "]
[85.316164, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[85.316183, "o", "\u001b[?2004h"]
[85.3162, "o", "> "]
[85.316441, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[85.316481, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[85.316509, "o", "\u001b[?2004h> "]
[85.316674, "o", "+    # Solar radiation conversion to MJ m⁻² day⁻¹\r\n\u001b[?2004l\r"]
[85.316697, "o", "\u001b[?2004h> "]
[85.316949, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n"]
[85.31698, "o", "\u001b[?2004l\r"]
[85.317006, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[85.317029, "o", "\u001b[?2004h> "]
[85.317048, "o", "+    return df\r\n\u001b[?2004l\r"]
[85.317065, "o", "\u001b[?2004h"]
[85.317081, "o", "> +\r\n"]
[85.317098, "o", "\u001b[?2004l\r\u001b[?2004h"]
[85.317119, "o", "> "]
[85.317135, "o", "+EOF\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.317171, "o", "> "]
[86.302725, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
[86.302838, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[86.302894, "o", "\u001b[?2004h> "]
[86.302948, "o", "import subprocess, sys\r\n\u001b[?2004l\r"]
[86.302972, "o", "\u001b[?2004h"]
[86.302994, "o", "> "]
[86.303404, "o", "cmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\r\n\u001b[?2004l\r"]
[86.30344, "o", "\u001b[?2004h> "]
[86.303652, "o", "proc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\r\n\u001b[?2004l\r"]
[86.303691, "o", "\u001b[?2004h> "]
[86.303725, "o", "print('STDOUT:')\r\n\u001b[?2004l\r"]
[86.303754, "o", "\u001b[?2004h> "]
[86.303829, "o", "print(proc.stdout)\r\n\u001b[?2004l\r"]
[86.303856, "o", "\u001b[?2004h> "]
[86.303967, "o", "print('STDERR:', file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.303992, "o", "\u001b[?2004h> "]
[86.304114, "o", "print(proc.stderr, file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.30414, "o", "\u001b[?2004h> "]
[86.30425, "o", "print('Return code:', proc.returncode)\r\n\u001b[?2004l\r"]
[86.304274, "o", "\u001b[?2004h> "]
[86.304294, "o", "PY\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.304315, "o", "> "]
[91.312104, "i", "head -n 10 output/et0.csv\n"]
[91.312241, "o", "head -n 10 output/et0.csv\r\n\u001b[?2004l\r"]
[91.312277, "o", "\u001b[?2004h"]
