[428.63449, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[428.634512, "o", "\u001b[?2004h"]
[428.634534, "o", "> "]
[428.634642, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[428.634663, "o", "\u001b[?2004h"]
[428.634686, "o", "> "]
[428.634905, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[428.634927, "o", "\u001b[?2004h"]
[428.634948, "o", "> "]
[428.635202, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
