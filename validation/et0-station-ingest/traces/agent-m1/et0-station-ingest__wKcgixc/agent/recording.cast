[48.518615, "o", "+\r\n\u001b[?2004l\r"]
[48.518637, "o", "\u001b[?2004h> "]
[48.518905, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[48.518931, "o", "\u001b[?2004h"]
[48.518954, "o", "> "]
[48.519192, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[48.519241, "o", "\u001b[?2004h> +    \"\"\"\r\n\u001b[?2004l\r"]
[48.519265, "o", "\u001b[?2004h"]
[48.519289, "o", "> "]
