[428.636022, "o", "\u001b[?2004h> "]
[428.636139, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[428.636176, "o", "\u001b[?2004h> "]
[428.636287, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[428.636315, "o", "\u001b[?2004h> "]
