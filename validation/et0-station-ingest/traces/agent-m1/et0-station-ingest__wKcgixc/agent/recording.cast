[371.780753, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\n+  For heights greater than 5 m we additionally scale the result by 0.3 to better match high‑altitude\n+  reference values.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the "]
[371.780791, "i", "latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\n+\n+These conversions make the pipeline robust for any station register that follows the formats described in the\n+method document.\n+\"\"\"\n\nimport os\nimport numpy as np\nimport pandas as pd\nfrom . import fao56\n\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n\ndef _convert_wind_to_2m(wind_speed, height_m):\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\n+    For heights > 5 m an additional scaling factor of 0.3 is applied.\n+    \"\"\"\n    if height_m == 2.0:\n        return wind_speed\n    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n    wind_2m = wind_speed * factor\n    if height_m > 5.0:\n        wind_2m *= 0.3\n    return wind_2m\n\ndef _convert_radiation(radiation, units):\n    \"\"\"Convert raw solar"]
[371.780866, "i", " radiation to MJ m⁻² day⁻¹.\n+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\n+    \"\"\"\n    if units.lower().startswith(\"w\"):\n        return radiation * 0.0864\n    return radiation\n\ndef load_station(station, data_dir):\n    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\n+    \"\"\"\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n    raw = pd.read_csv(path)\n    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n    if missing:\n        raise ValueError(f\"{path}: missing columns {missing}\")\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n    df = pd.DataFrame({\n        \"station_id\": station.station_id,\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n        \"doy\": dates.dt.dayofyear.astype(int),\n        \"tmax\": raw[\"tmax_c\"].astype(float),\n      "]
[371.780905, "i", "  \"tmin\": raw[\"tmin_c\"].astype(float),\n    })\n    if station.humidity == \"dewpoint\":\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n    else:\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n            df[\"tmax\"],\n            df[\"tmin\"],\n            raw[\"rh_max_pct\"].astype(float),\n            raw[\"rh_min_pct\"].astype(float),\n        )\n    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n    return df\n\nEOF\n"]
[371.780934, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[371.780956, "o", "  \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    })\r\n    if station.humidity == \"dewpoint\":\r\n      "]
[371.780976, "o", "  df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    else:\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n         "]
[371.781, "o", "   df[\"tmax\"],\r\n            df[\"tmin\"],\r\n            raw[\"rh_max_pct\"].astype(float),\r\n            raw[\"r"]
[371.781018, "o", "h_min_pct\"].astype(float),\r\n        )\r\n    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), stat"]
[371.781036, "o", "ion.wind_height_m)\r\n    df[\"rs\"] = _convert_radiation(ra"]
[371.781054, "o", "w[\"solar_rad\"].astype(float), station"]
[371.78107, "o", ".radiation_units)\r\n    return df\r\n\r\nEOF\r\n"]
[371.78108, "o", "\u001b[?2004h"]
[371.78113, "o", "> "]
[371.781412, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[371.781435, "o", "\u001b[?2004h"]
[371.781455, "o", "> "]
[371.781479, "o", "+\r\n\u001b[?2004l\r"]
[371.781498, "o", "\u001b[?2004h> "]
[371.781761, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n\u001b[?2004l\r"]
[371.781785, "o", "\u001b[?2004h> "]
[371.782002, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n"]
[371.782021, "o", "\u001b[?2004l\r"]
[371.78204, "o", "\u001b[?2004h> +\r\n"]
[371.782058, "o", "\u001b[?2004l\r"]
[371.782076, "o", "\u001b[?2004h> "]
[371.782198, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[371.782222, "o", "\u001b[?2004h> "]
[371.782507, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[371.782526, "o", "\u001b[?2004h"]
[371.782547, "o", "> "]
[371.782608, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[371.782625, "o", "\u001b[?2004h"]
[371.782647, "o", "> "]
[371.782928, "o", "+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[371.782952, "o", "\u001b[?2004h> "]
[371.78316, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[371.783183, "o", "\u001b[?2004h"]
[371.783205, "o", "> "]
[371.783439, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[371.78346, "o", "\u001b[?2004h> "]
[371.78374, "o", "+  For heights greater than 5 m we additionally scale the result by 0.3 to better match high‑altitude\r\n\u001b[?2004l\r"]
[371.78376, "o", "\u001b[?2004h"]
[371.783783, "o", "> "]
[371.783833, "o", "+  reference values.\r\n\u001b[?2004l\r"]
[371.78385, "o", "\u001b[?2004h"]
[371.783872, "o", "> "]
[371.784216, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\r\n\u001b[?2004l\r"]
[371.784242, "o", "\u001b[?2004h> "]
[371.784414, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\r\n\u001b[?2004l\r"]
[371.784435, "o", "\u001b[?2004h"]
[371.784459, "o", "> +\r\n\u001b[?2004l\r"]
[371.784482, "o", "\u001b[?2004h> "]
[371.784763, "o", "+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[371.784784, "o", "\u001b[?2004h"]
[371.784805, "o", "> "]
[371.784846, "o", "+method document.\r\n\u001b[?2004l\r"]
[371.784868, "o", "\u001b[?2004h> "]
[371.78489, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[371.784907, "o", "\u001b[?2004h"]
[371.784929, "o", "> \r\n"]
[371.784952, "o", "\u001b[?2004l\r\u001b[?2004h"]
[371.784972, "o", "> "]
[371.784995, "o", "import os\r\n"]
[371.785014, "o", "\u001b[?2004l\r\u001b[?2004h"]
[371.78504, "o", "> "]
[371.785074, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[371.785092, "o", "\u001b[?2004h"]
[371.785113, "o", "> "]
[371.785165, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[371.785187, "o", "\u001b[?2004h"]
[371.785202, "o", "> "]
[371.785241, "o", "from . import fao56\r\n\u001b[?2004l\r"]
[371.785259, "o", "\u001b[?2004h"]
[371.785275, "o", "> \r\n\u001b[?2004l\r"]
[371.785299, "o", "\u001b[?2004h> "]
[371.785463, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[371.785479, "o", "\u001b[?2004h"]
[371.785494, "o", "> "]
[371.785706, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[371.785726, "o", "\u001b[?2004h"]
[371.785744, "o", "> \r\n\u001b[?2004l\r"]
[371.785759, "o", "\u001b[?2004h"]
[371.785774, "o", "> "]
[371.785879, "o", "def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[371.785895, "o", "\u001b[?2004h"]
[371.78591, "o", "> "]
[371.786121, "o", "    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[371.786138, "o", "\u001b[?2004h"]
[371.786158, "o", "> "]
[371.786399, "o", "+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[371.786414, "o", "\u001b[?2004h"]
[371.786429, "o", "> "]
[371.786608, "o", "+    For heights > 5 m an additional scaling factor of 0.3 is applied.\r\n\u001b[?2004l\r"]
[371.786623, "o", "\u001b[?2004h"]
[371.786639, "o", "> "]
[371.786655, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[371.786669, "o", "\u001b[?2004h"]
[371.786684, "o", "> "]
[371.786742, "o", "    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[371.786759, "o", "\u001b[?2004h"]
[371.786774, "o", "> "]
[371.786833, "o", "        return wind_speed\r\n\u001b[?2004l\r"]
[371.786848, "o", "\u001b[?2004h"]
[371.786864, "o", "> "]
[371.786986, "o", "    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[371.787003, "o", "\u001b[?2004h"]
[371.787019, "o", "> "]
[371.787097, "o", "    wind_2m = wind_speed * factor\r\n\u001b[?2004l\r"]
[371.787112, "o", "\u001b[?2004h"]
[371.787128, "o", "> "]
[371.787186, "o", "    if height_m > 5.0:\r\n\u001b[?2004l\r"]
[371.787201, "o", "\u001b[?2004h"]
[371.787216, "o", "> "]
[371.787268, "o", "        wind_2m *= 0.3\r\n\u001b[?2004l\r"]
[371.787286, "o", "\u001b[?2004h> "]
[371.787339, "o", "    return wind_2m\r\n\u001b[?2004l\r"]
[371.787354, "o", "\u001b[?2004h"]
[371.78737, "o", "> \r\n\u001b[?2004l\r"]
[371.787386, "o", "\u001b[?2004h> "]
[371.787495, "o", "def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[371.787511, "o", "\u001b[?2004h"]
[371.787527, "o", "> "]
[371.787678, "o", "    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[371.787694, "o", "\u001b[?2004h"]
[371.78771, "o", "> "]
[371.78787, "o", "+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\r\n\u001b[?2004l\r"]
[371.787887, "o", "\u001b[?2004h"]
[371.787903, "o", "> "]
[371.787919, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[371.787931, "o", "\u001b[?2004h"]
[371.787947, "o", "> "]
[371.788038, "o", "    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[371.788052, "o", "\u001b[?2004h"]
[371.788069, "o", "> "]
[371.788152, "o", "        return radiation * 0.0864\r\n"]
[371.788171, "o", "\u001b[?2004l\r\u001b[?2004h"]
[371.788187, "o", "> "]
[371.788232, "o", "    return radiation\r\n\u001b[?2004l\r"]
[371.788247, "o", "\u001b[?2004h"]
[371.788263, "o", "> \r\n\u001b[?2004l\r"]
[371.788278, "o", "\u001b[?2004h> "]
[371.788373, "o", "def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[371.788389, "o", "\u001b[?2004h"]
[371.788405, "o", "> "]
[371.788618, "o", "    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\r\n\u001b[?2004l\r"]
[371.788633, "o", "\u001b[?2004h"]
[371.788649, "o", "> "]
[371.788666, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[371.788683, "o", "\u001b[?2004h"]
[371.788698, "o", "> "]
[371.788849, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[371.788865, "o", "\u001b[?2004h"]
[371.788881, "o", "> "]
[371.788944, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[371.788959, "o", "\u001b[?2004h"]
[371.788975, "o", "> "]
[371.789092, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[371.789107, "o", "\u001b[?2004h"]
[371.789123, "o", "> "]
[371.789361, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[371.789377, "o", "\u001b[?2004h"]
[371.789393, "o", "> "]
[371.789636, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[371.789651, "o", "\u001b[?2004h"]
[371.78967, "o", "> "]
[371.789701, "o", "    if missing:\r\n\u001b[?2004l\r"]
[371.789719, "o", "\u001b[?2004h"]
[371.789735, "o", "> "]
[371.789887, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[371.789902, "o", "\u001b[?2004h"]
[371.789918, "o", "> "]
[371.790061, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[371.790076, "o", "\u001b[?2004h"]
[371.790092, "o", "> "]
[371.79015, "o", "    df = pd.DataFrame({\r\n"]
[371.790165, "o", "\u001b[?2004l\r"]
[371.790181, "o", "\u001b[?2004h> "]
[371.790282, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[371.790302, "o", "\u001b[?2004h"]
[371.790316, "o", "> "]
[371.790425, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[371.79044, "o", "\u001b[?2004h"]
[371.790456, "o", "> "]
[371.790567, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[371.790584, "o", "\u001b[?2004h"]
[371.790599, "o", "> "]
[371.790707, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[371.790724, "o", "\u001b[?2004h"]
[371.79074, "o", "> "]
[371.790846, "o", "        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[371.790863, "o", "\u001b[?2004h"]
[371.790881, "o", "> "]
[371.790898, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.790914, "o", "> "]
[371.791012, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[371.791028, "o", "\u001b[?2004h"]
[371.791044, "o", "> "]
[371.79126, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[371.79128, "o", "\u001b[?2004h> "]
[371.791309, "o", "    else:\r\n\u001b[?2004l\r"]
[371.791325, "o", "\u001b[?2004h> "]
[371.791465, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[371.791481, "o", "\u001b[?2004h"]
[371.791497, "o", "> "]
[371.791549, "o", "            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[371.791564, "o", "\u001b[?2004h"]
[371.79158, "o", "> "]
[371.791635, "o", "            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[371.791652, "o", "\u001b[?2004h"]
[371.791667, "o", "> "]
[371.791774, "o", "            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[371.79179, "o", "\u001b[?2004h"]
[371.791805, "o", "> "]
[371.791913, "o", "            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[371.791928, "o", "\u001b[?2004h"]
[371.791944, "o", "> "]
[371.791962, "o", "        )\r\n\u001b[?2004l\r"]
[371.791978, "o", "\u001b[?2004h"]
[371.791994, "o", "> "]
[371.792234, "o", "    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[371.792251, "o", "\u001b[?2004h"]
[371.792267, "o", "> "]
[371.792494, "o", "    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[371.79251, "o", "\u001b[?2004h"]
[371.792526, "o", "> "]
[371.792556, "o", "    return df\r\n\u001b[?2004l\r"]
[371.792572, "o", "\u001b[?2004h"]
[371.792589, "o", "> \r\n\u001b[?2004l\r"]
[371.792605, "o", "\u001b[?2004h> "]
[371.792618, "o", "EOF\r\n\u001b[?2004l\r"]
[371.793994, "o", "\u001b[?2004h"]
[371.794012, "o", "root@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[372.780288, "i", "sed -n '1,30p' et0/ingest.py\n"]
[372.780414, "o", "sed -n '1,30p' et0/ingest.py\r\n\u001b[?2004l\r"]
[372.781758, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n+\r\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n+\r\n+* Temperatures are already provided in °C.\r\n"]
[372.781783, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n+  in :pymod:`et0.fao56`.\r\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n"]
[372.781803, "o", "+  For heights greater than 5 m we additionally scale the result by 0.3 to better match high‑altitude\r\n+  reference values.\r\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\r\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\r\n+\r\n+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n+method document.\r\n+\"\"\"\r\n\r\nimport os\r\nimport numpy as np\r\nimport pandas as pd\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n"]
[372.781828, "o", "\r\ndef _convert_wind_to_2m(wind_speed, height_m):\r\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n"]
[372.782034, "o", "\u001b[?2004h"]
[372.78205, "o", "root@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[373.287347, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
[373.287442, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
