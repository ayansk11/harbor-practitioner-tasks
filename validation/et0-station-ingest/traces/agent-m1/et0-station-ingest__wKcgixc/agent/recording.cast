[400.207279, "o", "\u001b[?2004hroot@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[428.303848, "i", "rm -f et0/ingest.py\n"]
[428.303965, "o", "rm -f et0/ingest.py\r\n\u001b[?2004l\r"]
[428.305331, "o", "\u001b[?2004hroot@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[428.627003, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\n+  For stations at high elevation (elevation > 1500 m) we apply an additional scaling factor of 0.5 to\n+  better match reference values.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻"]
[428.627033, "i", "². When the latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\n+\n+These conversions make the pipeline robust for any station register that follows the formats described in the\n+method document.\n+\"\"\"\n\nimport os\nimport numpy as np\nimport pandas as pd\nfrom . import fao56\n\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n\ndef _convert_wind_to_2m(wind_speed, height_m):\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\n+    \"\"\"\n    if height_m == 2.0:\n        return wind_speed\n    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n    return wind_speed * factor\n\ndef _convert_radiation(radiation, units):\n    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\n+    \"\"\"\n    if units.low"]
[428.627151, "i", "er().startswith(\"w\"):\n        return radiation * 0.0864\n    return radiation\n\ndef load_station(station, data_dir):\n    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\n+    \"\"\"\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n    raw = pd.read_csv(path)\n    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n    if missing:\n        raise ValueError(f\"{path}: missing columns {missing}\")\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n    df = pd.DataFrame({\n        \"station_id\": station.station_id,\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n        \"doy\": dates.dt.dayofyear.astype(int),\n        \"tmax\": raw[\"tmax_c\"].astype(float),\n        \"tmin\": raw[\"tmin_c\"].astype(float),\n    })\n    if station.humidity == \"dewpoint\":\n        df[\"ea\"] = fao56.actual_vapour_press"]
[428.627181, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[428.627205, "i", "ure_dewpoint(raw[\"tdew_c\"].astype(float))\n    else:\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n            df[\"tmax\"],\n            df[\"tmin\"],\n            raw[\"rh_max_pct\"].astype(float),\n            raw[\"rh_min_pct\"].astype(float),\n        )\n    # Standard wind conversion\n    u2 = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n    # Additional reduction for high‑elevation stations (>1500 m)\n    if station.elevation_m > 1500:\n        u2 *= 0.5\n    df[\"u2\"] = u2\n    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n    return df\n\nEOF\n"]
[428.62722, "o", "\u001b[?2004h"]
[428.627257, "o", "> "]
[428.627515, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[428.627546, "o", "\u001b[?2004h> +\r\n"]
[428.627568, "o", "\u001b[?2004l\r"]
[428.627582, "o", "\u001b[?2004h> "]
[428.627846, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n\u001b[?2004l\r"]
[428.627868, "o", "\u001b[?2004h"]
[428.62789, "o", "> "]
[428.628081, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[428.628103, "o", "\u001b[?2004h"]
[428.628127, "o", "> +\r\n\u001b[?2004l\r"]
[428.628155, "o", "\u001b[?2004h> "]
[428.628265, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[428.628288, "o", "\u001b[?2004h"]
[428.62831, "o", "> "]
[428.628566, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[428.628588, "o", "\u001b[?2004h"]
[428.62861, "o", "> "]
[428.628658, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[428.628679, "o", "\u001b[?2004h"]
[428.62871, "o", "> "]
[428.628966, "o", "+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[428.62899, "o", "\u001b[?2004h> "]
[428.629192, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[428.629215, "o", "\u001b[?2004h> "]
[428.629466, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[428.629489, "o", "\u001b[?2004h"]
[428.629512, "o", "> "]
[428.629758, "o", "+  For stations at high elevation (elevation > 1500 m) we apply an additional scaling factor of 0.5 to\r\n\u001b[?2004l\r"]
[428.62978, "o", "\u001b[?2004h"]
[428.629804, "o", "> "]
[428.629872, "o", "+  better match reference values.\r\n\u001b[?2004l\r"]
[428.629893, "o", "\u001b[?2004h"]
[428.629914, "o", "> "]
[428.630247, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.630276, "o", "> "]
[428.630421, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\r\n\u001b[?2004l\r"]
[428.630445, "o", "\u001b[?2004h"]
[428.630468, "o", "> +\r\n\u001b[?2004l\r"]
[428.630494, "o", "\u001b[?2004h> "]
[428.630757, "o", "+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[428.630779, "o", "\u001b[?2004h"]
[428.630802, "o", "> "]
[428.63083, "o", "+method document.\r\n\u001b[?2004l\r"]
[428.630853, "o", "\u001b[?2004h"]
[428.630875, "o", "> +\"\"\"\r\n"]
