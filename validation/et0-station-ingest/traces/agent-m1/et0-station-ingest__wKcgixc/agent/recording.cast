[451.177689, "o", "\u001b[?2004h> "]
[451.177793, "o", "    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[451.177812, "o", "\u001b[?2004h> "]
[451.177905, "o", "        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[451.177922, "o", "\u001b[?2004h> "]
[451.177984, "o", "    return radiation\r\n\u001b[?2004l\r"]
[451.178002, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.178024, "o", "\u001b[?2004h> "]
[451.178132, "o", "def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[451.178158, "o", "\u001b[?2004h> "]
[451.178384, "o", "    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\r\n\u001b[?2004l\r"]
[451.178427, "o", "\u001b[?2004h"]
[451.178449, "o", "> +    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.178619, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[451.178638, "o", "\u001b[?2004h> "]
[451.178714, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[451.178733, "o", "\u001b[?2004h"]
[451.178751, "o", "> "]
[451.178872, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[451.17889, "o", "\u001b[?2004h> "]
[451.179137, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[451.179167, "o", "\u001b[?2004h> "]
[451.17943, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.179452, "o", "> "]
[451.179487, "o", "    if missing:\r\n\u001b[?2004l\r"]
[451.179507, "o", "\u001b[?2004h> "]
[451.179676, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[451.179692, "o", "\u001b[?2004h> "]
[451.179848, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[451.17987, "o", "\u001b[?2004h> "]
[451.179929, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[451.179948, "o", "\u001b[?2004h> "]
[451.180062, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[451.180104, "o", "\u001b[?2004h"]
[451.180124, "o", "> "]
[451.180221, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[451.180245, "o", "\u001b[?2004h> "]
[451.180361, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[451.180383, "o", "\u001b[?2004h> "]
[451.180499, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[451.180522, "o", "\u001b[?2004h> "]
