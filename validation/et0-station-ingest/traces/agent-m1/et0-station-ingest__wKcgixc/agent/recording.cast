[169.471779, "o", "\u001b[?2004h"]
[169.471797, "o", "> "]
[169.471815, "o", "+\r\n\u001b[?2004l\r"]
[169.471839, "o", "\u001b[?2004h> "]
[169.471854, "o", "+\r\n\u001b[?2004l\r"]
[169.471871, "o", "\u001b[?2004h> "]
