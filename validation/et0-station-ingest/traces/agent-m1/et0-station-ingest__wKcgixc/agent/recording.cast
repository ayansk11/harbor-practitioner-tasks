[451.176094, "o", "\u001b[?2004h> "]
[451.176327, "o", "    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[451.176342, "o", "\u001b[?2004h"]
[451.176358, "o", "> "]
[451.176599, "o", "+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[451.17661, "o", "\u001b[?2004h"]
[451.176665, "o", "> +    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.176693, "o", "> "]
