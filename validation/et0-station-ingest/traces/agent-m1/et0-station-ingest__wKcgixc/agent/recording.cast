[250.769833, "o", "> "]
[250.769895, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[250.769913, "o", "\u001b[?2004h"]
[250.769929, "o", "> "]
[250.770216, "o", "+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[250.770232, "o", "\u001b[?2004h"]
[250.770248, "o", "> "]
[250.770434, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[250.770452, "o", "\u001b[?2004h"]
[250.770467, "o", "> +\r\n\u001b[?2004l\r"]
