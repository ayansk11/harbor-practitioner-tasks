[269.851134, "o", "\u001b[?2004l\r\u001b[?2004h"]
[269.851155, "o", "> "]
[269.851323, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[269.851342, "o", "\u001b[?2004h"]
