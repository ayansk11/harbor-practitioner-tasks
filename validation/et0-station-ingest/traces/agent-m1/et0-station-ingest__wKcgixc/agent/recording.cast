[451.177139, "o", "> "]
[451.177247, "o", "def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[451.177266, "o", "\u001b[?2004h> "]
[451.177428, "o", "    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[451.177448, "o", "\u001b[?2004h> "]
[451.177622, "o", "+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\r\n\u001b[?2004l\r"]
[451.177641, "o", "\u001b[?2004h> "]
