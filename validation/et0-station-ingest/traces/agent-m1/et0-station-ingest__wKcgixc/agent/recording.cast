[209.957916, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.95793, "o", "> "]
[209.9581, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[209.958118, "o", "\u001b[?2004h"]
[209.958134, "o", "> "]
[209.958358, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[209.958381, "o", "\u001b[?2004h"]
[209.958395, "o", "> +\r\n\u001b[?2004l\r"]
[209.958412, "o", "\u001b[?2004h"]
[209.958426, "o", "> +\r\n\u001b[?2004l\r"]
[209.958443, "o", "\u001b[?2004h"]
[209.958458, "o", "> "]
[209.958567, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[209.958583, "o", "\u001b[?2004h"]
[209.958597, "o", "> "]
[209.958812, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[209.958827, "o", "\u001b[?2004h"]
[209.958841, "o", "> "]
[209.958857, "o", "+\r\n\u001b[?2004l\r"]
[209.958871, "o", "\u001b[?2004h> "]
[209.959123, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[209.95914, "o", "\u001b[?2004h"]
[209.959157, "o", "> "]
[209.959177, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[209.959194, "o", "\u001b[?2004h"]
[209.959209, "o", "> "]
[209.959265, "o", "+    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[209.959281, "o", "\u001b[?2004h"]
[209.959296, "o", "> "]
[209.95936, "o", "+        return wind_speed\r\n\u001b[?2004l\r"]
[209.959377, "o", "\u001b[?2004h"]
[209.959392, "o", "> "]
[209.959518, "o", "+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[209.959538, "o", "\u001b[?2004h"]
[209.959552, "o", "> "]
[209.959627, "o", "+    return wind_speed * factor\r\n\u001b[?2004l\r"]
[209.959644, "o", "\u001b[?2004h"]
[209.959661, "o", "> "]
[209.959678, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.959693, "o", "> +\r\n\u001b[?2004l\r"]
[209.959712, "o", "\u001b[?2004h> "]
[209.959823, "o", "+def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[209.959841, "o", "\u001b[?2004h"]
[209.959858, "o", "> "]
[209.960011, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[209.960028, "o", "\u001b[?2004h"]
[209.960043, "o", "> "]
[209.960059, "o", "+\r\n\u001b[?2004l\r"]
[209.960072, "o", "\u001b[?2004h> "]
[209.960347, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[209.96037, "o", "\u001b[?2004h> "]
[209.960611, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[209.960628, "o", "\u001b[?2004h"]
[209.960642, "o", "> "]
[209.960661, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[209.960678, "o", "\u001b[?2004h"]
[209.960692, "o", "> "]
[209.960785, "o", "+    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[209.960803, "o", "\u001b[?2004h"]
[209.960816, "o", "> "]
[209.960901, "o", "+        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[209.960918, "o", "\u001b[?2004h"]
[209.960933, "o", "> "]
[209.960983, "o", "+    return radiation\r\n\u001b[?2004l\r"]
[209.961001, "o", "\u001b[?2004h"]
[209.961015, "o", "> "]
[209.96103, "o", "+\r\n\u001b[?2004l\r"]
[209.961051, "o", "\u001b[?2004h> "]
[209.961065, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.961079, "o", "> "]
[209.961175, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[209.961192, "o", "\u001b[?2004h"]
[209.961213, "o", "> "]
[209.961443, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[209.961457, "o", "\u001b[?2004h"]
[209.961473, "o", "> "]
[209.961488, "o", "+\r\n\u001b[?2004l\r"]
[209.961505, "o", "\u001b[?2004h> "]
[209.961664, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[209.961683, "o", "\u001b[?2004h"]
[209.961697, "o", "> "]
[209.961714, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[209.961731, "o", "\u001b[?2004h"]
[209.961747, "o", "> "]
[209.961902, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[209.961923, "o", "\u001b[?2004h"]
[209.961937, "o", "> "]
[209.962005, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[209.962023, "o", "\u001b[?2004h"]
[209.962038, "o", "> +\r\n"]
[209.962052, "o", "\u001b[?2004l\r"]
[209.962066, "o", "\u001b[?2004h> "]
[209.962197, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[209.962219, "o", "\u001b[?2004h"]
[209.962234, "o", "> "]
[209.962462, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[209.962479, "o", "\u001b[?2004h"]
[209.962494, "o", "> +\r\n"]
[209.962508, "o", "\u001b[?2004l\r"]
[209.962522, "o", "\u001b[?2004h> "]
[209.962777, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[209.962794, "o", "\u001b[?2004h"]
[209.962809, "o", "> "]
[209.962845, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[209.962862, "o", "\u001b[?2004h"]
[209.962877, "o", "> "]
[209.963034, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[209.963051, "o", "\u001b[?2004h"]
[209.963067, "o", "> "]
[209.963082, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.963096, "o", "> "]
[209.963249, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[209.963275, "o", "\u001b[?2004h> "]
[209.963337, "o", "+    df = pd.DataFrame({\r\n"]
[209.963353, "o", "\u001b[?2004l\r"]
[209.963367, "o", "\u001b[?2004h> "]
[209.963477, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[209.963495, "o", "\u001b[?2004h"]
[209.96351, "o", "> "]
[209.963626, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[209.963641, "o", "\u001b[?2004h"]
[209.963655, "o", "> "]
[209.963774, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[209.96379, "o", "\u001b[?2004h"]
[209.963806, "o", "> "]
[209.963917, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[209.963932, "o", "\u001b[?2004h"]
[209.963946, "o", "> "]
[209.96406, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[209.964075, "o", "\u001b[?2004h"]
[209.964091, "o", "> "]
[209.964109, "o", "+    })\r\n\u001b[?2004l\r"]
[209.964126, "o", "\u001b[?2004h"]
[209.964147, "o", "> "]
[209.964168, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.964184, "o", "> "]
[209.964257, "o", "+    # Actual vapour pressure (ea)\r\n\u001b[?2004l\r"]
[209.964274, "o", "\u001b[?2004h"]
[209.964289, "o", "> "]
[209.964386, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[209.964402, "o", "\u001b[?2004h"]
[209.964417, "o", "> "]
[209.964632, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[209.964651, "o", "\u001b[?2004h"]
[209.964667, "o", "> "]
[209.96469, "o", "+    else:\r\n\u001b[?2004l\r"]
[209.964705, "o", "\u001b[?2004h"]
[209.96472, "o", "> "]
[209.964848, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n"]
[209.964865, "o", "\u001b[?2004l\r"]
[209.96488, "o", "\u001b[?2004h"]
[209.964896, "o", "> "]
[209.964941, "o", "+            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[209.964958, "o", "\u001b[?2004h"]
[209.964972, "o", "> "]
[209.96503, "o", "+            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[209.965049, "o", "\u001b[?2004h"]
[209.965065, "o", "> "]
[209.96518, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[209.965202, "o", "\u001b[?2004h"]
[209.965218, "o", "> "]
[209.965321, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[209.965338, "o", "\u001b[?2004h"]
[209.965352, "o", "> "]
[209.965377, "o", "+        )\r\n\u001b[?2004l\r"]
[209.965396, "o", "\u001b[?2004h"]
[209.96541, "o", "> +\r\n\u001b[?2004l\r"]
[209.965432, "o", "\u001b[?2004h"]
[209.965447, "o", "> "]
[209.965547, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[209.965564, "o", "\u001b[?2004h"]
[209.96559, "o", "> "]
[209.965798, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[209.965815, "o", "\u001b[?2004h"]
[209.965832, "o", "> "]
[209.965849, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.965865, "o", "> "]
[209.966008, "o", "+    # Solar radiation conversion to MJ m⁻² day‑1\r\n"]
[209.966024, "o", "\u001b[?2004l\r"]
[209.966042, "o", "\u001b[?2004h"]
[209.966057, "o", "> "]
[209.966292, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[209.966319, "o", "\u001b[?2004h"]
[209.966339, "o", "> "]
[209.966354, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.966368, "o", "> "]
[209.966425, "o", "+    return df\r\n\u001b[?2004l\r"]
[209.966445, "o", "\u001b[?2004h"]
[209.966459, "o", "> "]
[209.966473, "o", "+\r\n\u001b[?2004l\r"]
[209.966488, "o", "\u001b[?2004h"]
[209.966502, "o", "> "]
[209.966526, "o", "+EOF\r\n\u001b[?2004l\r"]
[209.966543, "o", "\u001b[?2004h"]
[209.966557, "o", "> "]
[210.957373, "i", "sed -n '1,20p' et0/ingest.py\n"]
[210.957535, "o", "sed -n '1,20p' et0/ingest.py\r\n\u001b[?2004l\r"]
[210.957582, "o", "\u001b[?2004h"]
