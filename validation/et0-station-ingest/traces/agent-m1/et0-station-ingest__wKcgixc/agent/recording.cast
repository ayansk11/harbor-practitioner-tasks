[150.532347, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\n+\n+  where ``z`` is the measurement height in metres.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day ="]
[150.532444, "i", " 86 400 J m⁻² = 0.0864 MJ m⁻²).\n+\n+These conversions make the pipeline robust for *any* station register that follows the formats described in the\n+method document.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _convert_wind_to_2m(wind_speed, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+\n+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\n+    \"\"\"\n+    if height_m == 2.0:\n+        return wind_speed\n+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n+    return wind_speed * factor\n+\n+\n+def _convert_radiation(radiation, units):\n+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may"]
[150.53247, "i", " be\n+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\n+    \"\"\"\n+    if units.lower().startswith(\"w\"):\n+        return radiation * 0.0864\n+    return radiation\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\n+\n+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\n+    \"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+   "]
[150.532492, "i", "     \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype(float),\n+    })\n+\n+    # Actual vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"],\n+            df[\"tmin\"],\n+            raw[\"rh_max_pct\"].astype(float),\n+            raw[\"rh_min_pct\"].astype(float),\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion to MJ m⁻² day‑1\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+\n+    return df\n+\n+EOF\n"]
[150.532511, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[150.532549, "o", "\u001b[?2004h"]
[150.532571, "o", "> "]
[150.532889, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[150.532913, "o", "\u001b[?2004h"]
[150.532931, "o", "> +\r\n\u001b[?2004l\r"]
[150.532953, "o", "\u001b[?2004h"]
[150.532963, "o", "> "]
[150.533245, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\r\n\u001b[?2004l\r"]
[150.533273, "o", "\u001b[?2004h> "]
[150.533484, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[150.533501, "o", "\u001b[?2004h"]
[150.53352, "o", "> "]
[150.533536, "o", "+\r\n\u001b[?2004l\r"]
[150.533552, "o", "\u001b[?2004h> "]
[150.533671, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[150.533689, "o", "\u001b[?2004h"]
[150.533705, "o", "> "]
[150.533984, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[150.534003, "o", "\u001b[?2004h"]
[150.534018, "o", "> "]
[150.534088, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[150.534121, "o", "\u001b[?2004h"]
[150.534136, "o", "> "]
[150.534437, "o", "+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[150.534457, "o", "\u001b[?2004h"]
[150.534477, "o", "> "]
[150.534665, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[150.534683, "o", "\u001b[?2004h"]
[150.534699, "o", "> "]
[150.534716, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[150.534732, "o", "> "]
[150.534854, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\r\n\u001b[?2004l\r"]
[150.53487, "o", "\u001b[?2004h"]
[150.534887, "o", "> "]
[150.534903, "o", "+\r\n\u001b[?2004l\r"]
[150.53492, "o", "\u001b[?2004h> "]
[150.535058, "o", "+  where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[150.535075, "o", "\u001b[?2004h"]
[150.53509, "o", "> "]
[150.535432, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\r\n\u001b[?2004l\r"]
[150.535456, "o", "\u001b[?2004h> "]
[150.535843, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
[150.53586, "o", "\u001b[?2004h"]
[150.535881, "o", "> "]
[150.535898, "o", "+\r\n\u001b[?2004l\r"]
[150.535913, "o", "\u001b[?2004h> "]
[150.536211, "o", "+These conversions make the pipeline robust for *any* station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[150.536234, "o", "\u001b[?2004h"]
[150.536244, "o", "> "]
[150.536295, "o", "+method document.\r\n\u001b[?2004l\r"]
[150.536312, "o", "\u001b[?2004h> "]
[150.536336, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[150.536355, "o", "\u001b[?2004h"]
[150.536374, "o", "> "]
[150.536387, "o", "+\r\n\u001b[?2004l\r"]
[150.536402, "o", "\u001b[?2004h"]
[150.53642, "o", "> "]
[150.536441, "o", "+import os\r\n\u001b[?2004l\r"]
[150.53646, "o", "\u001b[?2004h"]
[150.536484, "o", "> "]
[150.53653, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[150.536546, "o", "\u001b[?2004h"]
[150.536562, "o", "> "]
[150.536582, "o", "+\r\n\u001b[?2004l\r"]
[150.536597, "o", "\u001b[?2004h> "]
[150.536656, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[150.536674, "o", "\u001b[?2004h"]
[150.536689, "o", "> "]
[150.536704, "o", "+\r\n\u001b[?2004l\r"]
[150.536719, "o", "\u001b[?2004h"]
[150.536733, "o", "> "]
[150.536786, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[150.536804, "o", "\u001b[?2004h"]
[150.536821, "o", "> +\r\n"]
[150.536837, "o", "\u001b[?2004l\r"]
[150.536853, "o", "\u001b[?2004h> "]
[150.537035, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[150.537052, "o", "\u001b[?2004h"]
[150.537071, "o", "> "]
[150.537308, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[150.537328, "o", "\u001b[?2004h"]
[150.537346, "o", "> +\r\n"]
[150.537361, "o", "\u001b[?2004l\r"]
[150.537376, "o", "\u001b[?2004h"]
[150.537391, "o", "> +\r\n\u001b[?2004l\r"]
[150.537407, "o", "\u001b[?2004h"]
[150.537429, "o", "> "]
[150.537546, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[150.537563, "o", "\u001b[?2004h"]
[150.537578, "o", "> "]
[150.537806, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[150.537821, "o", "\u001b[?2004h"]
[150.537843, "o", "> "]
[150.537857, "o", "+\r\n\u001b[?2004l\r"]
[150.537874, "o", "\u001b[?2004h> "]
[150.53813, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[150.538153, "o", "\u001b[?2004h"]
[150.538175, "o", "> "]
[150.538192, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[150.538212, "o", "\u001b[?2004h"]
[150.538228, "o", "> "]
[150.538295, "o", "+    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[150.538313, "o", "\u001b[?2004h"]
[150.538329, "o", "> "]
[150.538402, "o", "+        return wind_speed\r\n\u001b[?2004l\r"]
[150.538419, "o", "\u001b[?2004h"]
[150.538433, "o", "> "]
[150.538574, "o", "+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[150.538592, "o", "\u001b[?2004h"]
[150.538608, "o", "> "]
[150.538693, "o", "+    return wind_speed * factor\r\n\u001b[?2004l\r"]
[150.53871, "o", "\u001b[?2004h"]
[150.538726, "o", "> "]
[150.53874, "o", "+\r\n\u001b[?2004l\r"]
[150.538756, "o", "\u001b[?2004h"]
[150.538773, "o", "> +\r\n\u001b[?2004l\r"]
[150.538792, "o", "\u001b[?2004h"]
[150.538805, "o", "> "]
[150.538913, "o", "+def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[150.538931, "o", "\u001b[?2004h"]
[150.538946, "o", "> "]
[150.539111, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[150.539129, "o", "\u001b[?2004h"]
[150.539156, "o", "> "]
[150.539178, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[150.539199, "o", "> "]
[150.53946, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[150.539476, "o", "\u001b[?2004h"]
[150.539491, "o", "> "]
[150.53974, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[150.539764, "o", "\u001b[?2004h"]
[150.539771, "o", "> "]
[150.539793, "o", "+    \"\"\"\r\n"]
[150.539809, "o", "\u001b[?2004l\r"]
[150.539824, "o", "\u001b[?2004h"]
[150.539837, "o", "> "]
[150.539934, "o", "+    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[150.539951, "o", "\u001b[?2004h"]
[150.539968, "o", "> "]
[150.540057, "o", "+        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[150.540075, "o", "\u001b[?2004h"]
[150.540091, "o", "> "]
[150.540149, "o", "+    return radiation\r\n\u001b[?2004l\r"]
[150.540168, "o", "\u001b[?2004h"]
[150.540189, "o", "> +\r\n\u001b[?2004l\r"]
[150.540208, "o", "\u001b[?2004h> "]
[150.540226, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[150.540242, "o", "> "]
[150.54034, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[150.540359, "o", "\u001b[?2004h"]
[150.540376, "o", "> "]
[150.540609, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[150.540629, "o", "\u001b[?2004h"]
[150.540656, "o", "> +\r\n\u001b[?2004l\r"]
[150.540696, "o", "\u001b[?2004h> "]
[150.540842, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[150.540874, "o", "\u001b[?2004h> "]
[150.540897, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[150.540914, "o", "\u001b[?2004h"]
[150.540933, "o", "> "]
[150.541088, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[150.541117, "o", "\u001b[?2004h"]
[150.541131, "o", "> "]
[150.541209, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[150.541237, "o", "\u001b[?2004h"]
[150.541259, "o", "> "]
[150.541273, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[150.541289, "o", "> "]
[150.54141, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[150.541429, "o", "\u001b[?2004h"]
[150.541445, "o", "> "]
[150.541682, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[150.541699, "o", "\u001b[?2004h"]
[150.541722, "o", "> +\r\n\u001b[?2004l\r"]
[150.541738, "o", "\u001b[?2004h"]
[150.541754, "o", "> "]
[150.542001, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[150.542017, "o", "\u001b[?2004h"]
[150.542034, "o", "> "]
[150.542071, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[150.542092, "o", "\u001b[?2004h"]
[150.542108, "o", "> "]
[150.542271, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[150.542289, "o", "\u001b[?2004h"]
[150.542306, "o", "> +\r\n\u001b[?2004l\r"]
[150.54232, "o", "\u001b[?2004h"]
[150.542335, "o", "> "]
[150.542484, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[150.542502, "o", "\u001b[?2004h"]
[150.542518, "o", "> "]
[150.542573, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[150.54259, "o", "\u001b[?2004h"]
[150.542612, "o", "> "]
[150.542708, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[150.542725, "o", "\u001b[?2004h"]
[150.542743, "o", "> "]
[150.542856, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[150.542873, "o", "\u001b[?2004h"]
[150.542889, "o", "> "]
[150.543005, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[150.543022, "o", "\u001b[?2004h"]
[150.543046, "o", "> "]
[150.54315, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[150.543169, "o", "\u001b[?2004h"]
[150.543185, "o", "> "]
[150.543296, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[150.543313, "o", "\u001b[?2004h"]
[150.543332, "o", "> "]
[150.54335, "o", "+    })\r\n\u001b[?2004l\r"]
[150.543368, "o", "\u001b[?2004h"]
[150.543384, "o", "> +\r\n\u001b[?2004l\r"]
[150.543395, "o", "\u001b[?2004h"]
[150.543414, "o", "> "]
[150.543495, "o", "+    # Actual vapour pressure (ea)\r\n\u001b[?2004l\r"]
[150.543514, "o", "\u001b[?2004h"]
[150.54353, "o", "> "]
[150.543626, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[150.543645, "o", "\u001b[?2004h"]
[150.543661, "o", "> "]
[150.543872, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[150.543891, "o", "\u001b[?2004h"]
[150.543907, "o", "> "]
[150.543928, "o", "+    else:\r\n\u001b[?2004l\r"]
[150.543945, "o", "\u001b[?2004h"]
[150.54396, "o", "> "]
[150.54409, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[150.544108, "o", "\u001b[?2004h"]
[150.544124, "o", "> "]
[150.544186, "o", "+            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[150.544205, "o", "\u001b[?2004h"]
[150.54422, "o", "> "]
[150.544276, "o", "+            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[150.544294, "o", "\u001b[?2004h"]
[150.54431, "o", "> "]
[150.544421, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[150.544441, "o", "\u001b[?2004h"]
[150.544457, "o", "> "]
[150.544565, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[150.544582, "o", "\u001b[?2004h"]
[150.544599, "o", "> "]
[150.544622, "o", "+        )\r\n\u001b[?2004l\r"]
[150.544639, "o", "\u001b[?2004h"]
[150.544656, "o", "> +\r\n\u001b[?2004l\r"]
[150.544672, "o", "\u001b[?2004h"]
[150.544688, "o", "> "]
[150.544799, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[150.544816, "o", "\u001b[?2004h"]
[150.544833, "o", "> "]
[150.545056, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[150.545075, "o", "\u001b[?2004h"]
[150.545094, "o", "> +\r\n"]
[150.54511, "o", "\u001b[?2004l\r\u001b[?2004h"]
[150.545126, "o", "> "]
[150.545287, "o", "+    # Solar radiation conversion to MJ m⁻² day‑1\r\n\u001b[?2004l\r"]
[150.545305, "o", "\u001b[?2004h"]
[150.54532, "o", "> "]
[150.545557, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[150.545575, "o", "\u001b[?2004h"]
[150.545593, "o", "> +\r\n\u001b[?2004l\r"]
[150.545604, "o", "\u001b[?2004h"]
[150.545622, "o", "> "]
[150.545657, "o", "+    return df\r\n\u001b[?2004l\r"]
[150.545677, "o", "\u001b[?2004h"]
[150.545694, "o", "> +\r\n"]
[150.545711, "o", "\u001b[?2004l\r\u001b[?2004h"]
[150.545727, "o", "> +EOF\r\n"]
[150.545742, "o", "\u001b[?2004l\r"]
[150.545764, "o", "\u001b[?2004h> "]
[151.535626, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
[151.535716, "o", "python - <<'PY'\r\n"]
