[48.510838, "o", "tation_id}: unknown humidity type {station.humidity!r}\")\r\n+\r\n+    missing = [c for c in BASE_CO"]
[48.510877, "o", "LUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n+    if missing:\r\n+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n+\r\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-"]
[48.510916, "o", "%m-%d\")\r\n+    df = pd.DataFrame({\r\n+        \"station_id\": station.station_id,\r\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n+        \"doy\": dates.dt.dayofyear.astype(int),\r\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n+        \"tmin\": raw[\"tmin"]
[48.510945, "o", "_c\"].astype(float),\r\n+    })\r\n+\r\n+    # Actual vapour pressure (ea)\r\n+    if station.humidity == \"dewpoint\":\r\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"td"]
[48.510969, "o", "ew_c\"].astype(float))\r\n+    else:\r\n+        df[\"ea\"] = fao56.actual_vapour"]
[48.510996, "o", "_pressure_rh(\r\n+            df[\"tmax\"],\r\n+            df[\"tmin\"],\r\n+       "]
[48.511019, "o", "     raw[\"rh_max_pct\"].astype(float),\r\n+            raw[\"rh_min_pct\"].astype(float),\r\n+        )\r\n+\r\n+    # Wind speed conversion to 2 m height\r\n+    df[\"u2\"] = _convert_w"]
