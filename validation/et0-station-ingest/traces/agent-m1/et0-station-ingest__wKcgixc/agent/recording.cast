[451.17547, "o", "\r\n\u001b[?2004l\r"]
[451.175486, "o", "\u001b[?2004h> "]
[451.17566, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[451.175677, "o", "\u001b[?2004h> "]
[451.175906, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
