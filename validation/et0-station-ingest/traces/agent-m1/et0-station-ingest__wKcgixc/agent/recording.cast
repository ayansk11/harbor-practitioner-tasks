[428.63392, "o", "\u001b[?2004h"]
[428.633942, "o", "> "]
[428.634156, "o", "    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\r\n\u001b[?2004l\r"]
[428.634177, "o", "\u001b[?2004h"]
