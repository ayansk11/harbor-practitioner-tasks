[48.516936, "o", "+\r\n\u001b[?2004l\r"]
[48.516947, "o", "\u001b[?2004h> "]
[48.517077, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[48.5171, "o", "\u001b[?2004h"]
[48.517125, "o", "> "]
[48.517334, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[48.517359, "o", "\u001b[?2004h"]
[48.517383, "o", "> +\r\n\u001b[?2004l\r"]
[48.517397, "o", "\u001b[?2004h> "]
[48.517651, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[48.517661, "o", "\u001b[?2004h"]
