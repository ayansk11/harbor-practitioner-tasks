[131.746995, "o", "\u001b[?2004h> "]
[131.747122, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[131.747138, "o", "\u001b[?2004h"]
[131.747155, "o", "> "]
[131.747369, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[131.747384, "o", "\u001b[?2004h"]
[131.7474, "o", "> +\r\n\u001b[?2004l\r"]
[131.747416, "o", "\u001b[?2004h"]
[131.747432, "o", "> "]
[131.74768, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[131.747696, "o", "\u001b[?2004h"]
[131.74771, "o", "> "]
