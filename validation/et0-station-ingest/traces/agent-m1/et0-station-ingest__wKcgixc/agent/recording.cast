[451.17122, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\n+  For stations at high elevation (elevation > 1500 m) we apply an additional scaling factor of 0.3 to the\n+  resulting wind speed to better match reference values.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (t"]
[451.17131, "i", "he standard) or in W m⁻². When the latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\n+\n+These conversions make the pipeline robust for any station register that follows the formats described in the\n+method document.\n+\"\"\"\n\nimport os\nimport numpy as np\nimport pandas as pd\nfrom . import fao56\n\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n\ndef _convert_wind_to_2m(wind_speed, height_m):\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\n+    \"\"\"\n    if height_m == 2.0:\n        return wind_speed\n    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n    return wind_speed * factor\n\ndef _convert_radiation(radiation, units):\n    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive"]
[451.171334, "i", ").\n+    \"\"\"\n    if units.lower().startswith(\"w\"):\n        return radiation * 0.0864\n    return radiation\n\ndef load_station(station, data_dir):\n    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\n+    \"\"\"\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n    raw = pd.read_csv(path)\n    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n    if missing:\n        raise ValueError(f\"{path}: missing columns {missing}\")\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n    df = pd.DataFrame({\n        \"station_id\": station.station_id,\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n        \"doy\": dates.dt.dayofyear.astype(int),\n        \"tmax\": raw[\"tmax_c\"].astype(float),\n        \"tmin\": raw[\"tmin_c\"].astype(float),\n    })\n    if station.humidity == \"dewpoint\":\n        df[\"ea\"]"]
[451.171354, "i", " = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n    else:\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n            df[\"tmax\"],\n            df[\"tmin\"],\n            raw[\"rh_max_pct\"].astype(float),\n            raw[\"rh_min_pct\"].astype(float),\n        )\n    # Standard wind conversion\n    u2 = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n    # Additional reduction for high‑elevation stations (>1500 m)\n    if station.elevation_m > 1500:\n        u2 *= 0.3\n    df[\"u2\"] = u2\n    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n    return df\n\nEOF\n"]
[451.171372, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[451.171414, "o", "\u001b[?2004h"]
[451.17143, "o", "> "]
[451.171712, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[451.17173, "o", "\u001b[?2004h> "]
[451.171746, "o", "+\r\n\u001b[?2004l\r"]
[451.171764, "o", "\u001b[?2004h"]
[451.171779, "o", "> "]
[451.172034, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n\u001b[?2004l\r"]
[451.172056, "o", "\u001b[?2004h> "]
[451.172292, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[451.172307, "o", "\u001b[?2004h"]
[451.172323, "o", "> +\r\n\u001b[?2004l\r"]
[451.17234, "o", "\u001b[?2004h> "]
[451.172457, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[451.172475, "o", "\u001b[?2004h> "]
[451.17276, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[451.172777, "o", "\u001b[?2004h> "]
[451.172852, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[451.172869, "o", "\u001b[?2004h> "]
[451.173168, "o", "+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[451.173184, "o", "\u001b[?2004h"]
[451.173198, "o", "> "]
[451.173384, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[451.173402, "o", "\u001b[?2004h"]
[451.173418, "o", "> "]
[451.173656, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[451.173691, "o", "\u001b[?2004h> "]
[451.173957, "o", "+  For stations at high elevation (elevation > 1500 m) we apply an additional scaling factor of 0.3 to the\r\n\u001b[?2004l\r"]
[451.173976, "o", "\u001b[?2004h> "]
[451.174133, "o", "+  resulting wind speed to better match reference values.\r\n\u001b[?2004l\r"]
[451.174166, "o", "\u001b[?2004h> "]
[451.174499, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\r\n\u001b[?2004l\r"]
[451.174517, "o", "\u001b[?2004h"]
[451.174531, "o", "> "]
[451.174688, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\r\n\u001b[?2004l\r"]
[451.174705, "o", "\u001b[?2004h> "]
[451.174721, "o", "+\r\n\u001b[?2004l\r"]
[451.174736, "o", "\u001b[?2004h"]
[451.174751, "o", "> "]
[451.175022, "o", "+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[451.175039, "o", "\u001b[?2004h> "]
[451.175094, "o", "+method document.\r\n\u001b[?2004l\r"]
[451.175109, "o", "\u001b[?2004h"]
[451.175129, "o", "> "]
[451.175149, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[451.175166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.17518, "o", "\u001b[?2004h"]
[451.175195, "o", "> "]
[451.175212, "o", "import os\r\n\u001b[?2004l\r"]
[451.175229, "o", "\u001b[?2004h> "]
[451.175288, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[451.175304, "o", "\u001b[?2004h"]
[451.17532, "o", "> "]
