[392.413763, "o", "root@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[392.740391, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\n+\n+These conversions make the pipeline robust "]
[392.740422, "i", "for any station register that follows the formats described in the\n+method document.\n+\"\"\"\n\nimport os\nimport numpy as np\nimport pandas as pd\nfrom . import fao56\n\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n\ndef _convert_wind_to_2m(wind_speed, height_m):\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\n+    \"\"\"\n    if height_m == 2.0:\n        return wind_speed\n    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n    return wind_speed * factor\n\ndef _convert_radiation(radiation, units):\n    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\n+    \"\"\"\n    if units.lower().startswith(\"w\"):\n        return radiation * 0.0864\n    return radiation\n\ndef load_station(station, data_dir):\n    \"\"\"Return a DataFram"]
[392.740532, "i", "e with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\n+    \"\"\"\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n    raw = pd.read_csv(path)\n    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n    if missing:\n        raise ValueError(f\"{path}: missing columns {missing}\")\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n    df = pd.DataFrame({\n        \"station_id\": station.station_id,\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n        \"doy\": dates.dt.dayofyear.astype(int),\n        \"tmax\": raw[\"tmax_c\"].astype(float),\n        \"tmin\": raw[\"tmin_c\"].astype(float),\n    })\n    if station.humidity == \"dewpoint\":\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n    else:\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n            df[\"tmax\"],\n           "]
[392.740569, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[392.740596, "i", " df[\"tmin\"],\n            raw[\"rh_max_pct\"].astype(float),\n            raw[\"rh_min_pct\"].astype(float),\n        )\n    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n    return df\n\nEOF\n"]
[392.740633, "o", "\u001b[?2004h> "]
[392.740864, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[392.740896, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[392.740928, "o", "\u001b[?2004h"]
[392.740958, "o", "> "]
[392.741216, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n\u001b[?2004l\r"]
[392.741245, "o", "\u001b[?2004h"]
[392.741273, "o", "> "]
[392.741449, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[392.741473, "o", "\u001b[?2004h"]
[392.741498, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.741524, "o", "> "]
[392.741619, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[392.741642, "o", "\u001b[?2004h"]
[392.741667, "o", "> "]
[392.74192, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[392.741946, "o", "\u001b[?2004h"]
[392.741972, "o", "> "]
[392.742012, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[392.742035, "o", "\u001b[?2004h"]
[392.742047, "o", "> "]
[392.742332, "o", "+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[392.742356, "o", "\u001b[?2004h"]
[392.742382, "o", "> "]
[392.742552, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[392.742576, "o", "\u001b[?2004h"]
[392.742598, "o", "> "]
[392.742818, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[392.742842, "o", "\u001b[?2004h"]
[392.742867, "o", "> "]
[392.743183, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\r\n\u001b[?2004l\r"]
[392.743214, "o", "\u001b[?2004h> "]
[392.743373, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\r\n\u001b[?2004l\r"]
[392.743401, "o", "\u001b[?2004h> "]
[392.743427, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.743712, "o", "+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[392.743738, "o", "\u001b[?2004h> "]
[392.743783, "o", "+method document.\r\n\u001b[?2004l\r"]
[392.743807, "o", "\u001b[?2004h> "]
[392.743833, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[392.743858, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[392.743884, "o", "\u001b[?2004h> "]
[392.74391, "o", "import os\r\n\u001b[?2004l\r"]
[392.743935, "o", "\u001b[?2004h> "]
[392.743971, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[392.743997, "o", "\u001b[?2004h> "]
[392.744062, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[392.744127, "o", "\u001b[?2004h"]
[392.74416, "o", "> from . import fao56\r\n\u001b[?2004l\r"]
[392.744201, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[392.744222, "o", "\u001b[?2004h"]
[392.74424, "o", "> "]
[392.744395, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[392.744412, "o", "\u001b[?2004h"]
[392.744429, "o", "> "]
[392.744642, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[392.74466, "o", "\u001b[?2004h"]
[392.74468, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[392.744699, "o", "> "]
[392.74481, "o", "def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[392.744828, "o", "\u001b[?2004h> "]
[392.745052, "o", "    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[392.745069, "o", "\u001b[?2004h"]
[392.745086, "o", "> "]
[392.745338, "o", "+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[392.745356, "o", "\u001b[?2004h"]
[392.745374, "o", "> "]
[392.745393, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[392.745412, "o", "\u001b[?2004h> "]
[392.745476, "o", "    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[392.745493, "o", "\u001b[?2004h"]
[392.745511, "o", "> "]
[392.745568, "o", "        return wind_speed\r\n\u001b[?2004l\r"]
[392.745585, "o", "\u001b[?2004h"]
[392.745603, "o", "> "]
[392.745723, "o", "    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[392.74574, "o", "\u001b[?2004h"]
[392.745757, "o", "> "]
[392.745827, "o", "    return wind_speed * factor\r\n\u001b[?2004l\r"]
[392.745845, "o", "\u001b[?2004h"]
[392.745863, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[392.745881, "o", "> "]
[392.745985, "o", "def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[392.746004, "o", "\u001b[?2004h> "]
[392.746175, "o", "    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[392.746192, "o", "\u001b[?2004h"]
[392.74621, "o", "> "]
[392.746368, "o", "+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\r\n\u001b[?2004l\r"]
[392.746385, "o", "\u001b[?2004h"]
[392.746403, "o", "> "]
[392.746421, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[392.746443, "o", "\u001b[?2004h> "]
[392.746537, "o", "    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[392.746556, "o", "\u001b[?2004h"]
[392.746579, "o", "> "]
[392.746651, "o", "        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[392.746668, "o", "\u001b[?2004h> "]
[392.746728, "o", "    return radiation\r\n\u001b[?2004l\r"]
[392.746745, "o", "\u001b[?2004h"]
[392.746763, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[392.746782, "o", "> "]
[392.746873, "o", "def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[392.746892, "o", "\u001b[?2004h"]
[392.746909, "o", "> "]
[392.747118, "o", "    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\r\n\u001b[?2004l\r"]
[392.747136, "o", "\u001b[?2004h> "]
[392.747172, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[392.74719, "o", "\u001b[?2004h"]
[392.747208, "o", "> "]
[392.747363, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[392.747387, "o", "\u001b[?2004h> "]
[392.747451, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[392.74747, "o", "\u001b[?2004h> "]
[392.747599, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[392.747618, "o", "\u001b[?2004h> "]
[392.747862, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[392.747882, "o", "\u001b[?2004h> "]
[392.748146, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[392.748164, "o", "\u001b[?2004h> "]
[392.748212, "o", "    if missing:\r\n\u001b[?2004l\r"]
[392.748229, "o", "\u001b[?2004h> "]
[392.748397, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[392.748416, "o", "\u001b[?2004h> "]
[392.748573, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[392.748591, "o", "\u001b[?2004h> "]
[392.748658, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[392.748675, "o", "\u001b[?2004h> "]
[392.74879, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[392.748808, "o", "\u001b[?2004h> "]
[392.748934, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[392.748953, "o", "\u001b[?2004h> "]
[392.749079, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[392.749097, "o", "\u001b[?2004h> "]
[392.749223, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[392.749243, "o", "\u001b[?2004h> "]
[392.749362, "o", "        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[392.749381, "o", "\u001b[?2004h"]
[392.749399, "o", ">     })\r\n"]
[392.749416, "o", "\u001b[?2004l\r\u001b[?2004h"]
[392.749434, "o", "> "]
[392.749528, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[392.749546, "o", "\u001b[?2004h> "]
[392.749772, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[392.749792, "o", "\u001b[?2004h> "]
[392.749826, "o", "    else:\r\n\u001b[?2004l\r"]
[392.749845, "o", "\u001b[?2004h> "]
[392.749983, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[392.750002, "o", "\u001b[?2004h> "]
[392.750072, "o", "            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[392.75009, "o", "\u001b[?2004h> "]
[392.750166, "o", "            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[392.750184, "o", "\u001b[?2004h"]
[392.750201, "o", "> "]
[392.750301, "o", "            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[392.750319, "o", "\u001b[?2004h> "]
[392.750439, "o", "            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[392.750458, "o", "\u001b[?2004h> "]
[392.750492, "o", "        )\r\n\u001b[?2004l\r"]
[392.75051, "o", "\u001b[?2004h> "]
[392.750741, "o", "    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[392.75076, "o", "\u001b[?2004h> "]
[392.751006, "o", "    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[392.751025, "o", "\u001b[?2004h> "]
[392.751068, "o", "    return df\r\n\u001b[?2004l\r"]
[392.751087, "o", "\u001b[?2004h> "]
[392.751104, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.751122, "o", "> "]
[392.75114, "o", "EOF\r\n\u001b[?2004l\r"]
[392.752485, "o", "\u001b[?2004hroot@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[393.732006, "i", "sed -n '1,30p' et0/ingest.py\n"]
[393.73216, "o", "sed -n '1,30p' et0/ingest.py\r\n\u001b[?2004l\r"]
[393.733562, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n+\r\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n+\r\n+* Temperatures are already provided in °C.\r\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n+  in :pymod:`et0.fao56`.\r\n"]
[393.733592, "o", "+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\r\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\r\n+\r\n+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n"]
[393.733614, "o", "+method document.\r\n+\"\"\"\r\n\r\nimport os\r\nimport numpy as np\r\nimport pandas as pd\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\r\ndef _convert_wind_to_2m(wind_speed, height_m):\r\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\r\n+    \"\"\"\r\n"]
[393.73385, "o", "\u001b[?2004hroot@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[394.234985, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
[394.235095, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[394.23514, "o", "\u001b[?2004h"]
[394.235179, "o", "> "]
[394.235222, "o", "import subprocess, sys\r\n\u001b[?2004l\r"]
[394.235245, "o", "\u001b[?2004h"]
[394.235263, "o", "> "]
[394.235577, "o", "cmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\r\n\u001b[?2004l\r"]
[394.235597, "o", "\u001b[?2004h> "]
[394.235786, "o", "proc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\r\n\u001b[?2004l\r"]
[394.235805, "o", "\u001b[?2004h> "]
[394.23586, "o", "print('STDOUT:')\r\n\u001b[?2004l\r"]
[394.235882, "o", "\u001b[?2004h> "]
[394.235942, "o", "print(proc.stdout)\r\n\u001b[?2004l\r"]
[394.235961, "o", "\u001b[?2004h> "]
[394.236061, "o", "print('STDERR:', file=sys.stderr)\r\n\u001b[?2004l\r"]
[394.236079, "o", "\u001b[?2004h> "]
[394.236203, "o", "print(proc.stderr, file=sys.stderr)\r\n\u001b[?2004l\r"]
[394.236227, "o", "\u001b[?2004h> "]
[394.236331, "o", "print('Return code:', proc.returncode)\r\n\u001b[?2004l\r"]
[394.23635, "o", "\u001b[?2004h> "]
[394.236368, "o", "PY\r\n\u001b[?2004l\r"]
[394.89055, "o", "STDOUT:\r\nVNT: 365 days, mean ET0 3.55 mm/day\r\nPAL: 365 days, mean ET0 2.88 mm/day\r\nCDB: 365 days, mean ET0 3.60 mm/day\r\nLGN: 365 days, mean ET0 4.23 mm/day\r\nRSD: 365 days, mean ET0 3.70 mm/day\r\nMRS: 365 days, mean ET0 4.01 mm/day\r\nHLT: 365 days, mean ET0 3.75 mm/day\r\nARN: 365 days, mean ET0 3.21 mm/day\r\n\r\nSTDERR:\r\n\r\nReturn code: 0\r\n"]
[394.894167, "o", "\u001b[?2004h"]
[394.894182, "o", "root@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
