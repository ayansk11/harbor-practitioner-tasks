[48.520104, "o", "\u001b[?2004h> "]
[48.520272, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[48.520293, "o", "\u001b[?2004h"]
[48.520314, "o", "> "]
[48.520337, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[48.520358, "o", "\u001b[?2004h> "]
[48.520516, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[48.520539, "o", "\u001b[?2004h> "]
[48.520622, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[48.520644, "o", "\u001b[?2004h> "]
[48.520665, "o", "+\r\n\u001b[?2004l\r"]
[48.520686, "o", "\u001b[?2004h> "]
[48.520813, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[48.520835, "o", "\u001b[?2004h> "]
[48.521085, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[48.521108, "o", "\u001b[?2004h"]
[48.521132, "o", "> +\r\n\u001b[?2004l\r"]
[48.521158, "o", "\u001b[?2004h> "]
[48.52141, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[48.521432, "o", "\u001b[?2004h> "]
[48.521483, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[48.521507, "o", "\u001b[?2004h> "]
[48.521675, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[48.521699, "o", "\u001b[?2004h> "]
[48.521721, "o", "+\r\n\u001b[?2004l\r"]
[48.521743, "o", "\u001b[?2004h> "]
[48.521891, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[48.521919, "o", "\u001b[?2004h"]
[48.521943, "o", "> "]
[48.521987, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[48.522011, "o", "\u001b[?2004h"]
[48.522032, "o", "> "]
[48.522127, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[48.522165, "o", "\u001b[?2004h> "]
[48.522284, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[48.522312, "o", "\u001b[?2004h> "]
[48.522435, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[48.522463, "o", "\u001b[?2004h> "]
[48.522584, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[48.522609, "o", "\u001b[?2004h"]
[48.522634, "o", "> "]
[48.522737, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[48.52277, "o", "\u001b[?2004h> "]
[48.522796, "o", "+    })\r\n\u001b[?2004l\r"]
[48.52282, "o", "\u001b[?2004h"]
[48.522844, "o", "> +\r\n\u001b[?2004l\r"]
[48.522867, "o", "\u001b[?2004h> "]
[48.522948, "o", "+    # Actual vapour pressure (ea)\r\n\u001b[?2004l\r"]
[48.522977, "o", "\u001b[?2004h> "]
[48.523082, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[48.523112, "o", "\u001b[?2004h> "]
[48.523343, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[48.523369, "o", "\u001b[?2004h> "]
[48.523405, "o", "+    else:\r\n\u001b[?2004l\r"]
[48.523429, "o", "\u001b[?2004h> "]
[48.523571, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[48.523595, "o", "\u001b[?2004h> "]
[48.523667, "o", "+            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[48.523692, "o", "\u001b[?2004h> "]
[48.523766, "o", "+            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[48.523789, "o", "\u001b[?2004h> "]
[48.523916, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[48.523944, "o", "\u001b[?2004h> "]
[48.524066, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[48.524093, "o", "\u001b[?2004h> "]
[48.524126, "o", "+        )\r\n\u001b[?2004l\r"]
[48.524156, "o", "\u001b[?2004h"]
[48.52418, "o", "> +\r\n\u001b[?2004l\r"]
[48.524205, "o", "\u001b[?2004h> "]
[48.524343, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[48.524366, "o", "\u001b[?2004h> "]
[48.524571, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[48.5246, "o", "\u001b[?2004h> +\r\n"]
[48.524623, "o", "\u001b[?2004l\r"]
[48.524653, "o", "\u001b[?2004h> "]
[48.524792, "o", "+    # Solar radiation conversion to MJ m⁻² day⁻¹\r\n\u001b[?2004l\r"]
[48.524818, "o", "\u001b[?2004h"]
[48.524843, "o", "> "]
[48.525069, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[48.525096, "o", "\u001b[?2004h> +\r\n"]
[48.525121, "o", "\u001b[?2004l\r"]
[48.52517, "o", "\u001b[?2004h> "]
[48.525196, "o", "+    return df\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.525222, "o", "> +\r\n"]
[48.525247, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[48.525285, "o", "*** End Patch\r\n\u001b[?2004l\r"]
