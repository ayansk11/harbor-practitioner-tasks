[169.469486, "o", "> "]
[169.469506, "o", "+import os\r\n\u001b[?2004l\r"]
[169.469528, "o", "\u001b[?2004h> "]
[169.46959, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[169.469611, "o", "\u001b[?2004h> "]
