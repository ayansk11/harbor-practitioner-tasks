[67.191294, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\n+\n+  where ``z`` is the measurement height in metres.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day ="]
[67.191382, "i", " 86 400 J m⁻² = 0.0864 MJ m⁻²).\n+\n+These conversions make the pipeline robust for *any* station register that follows the formats described in the\n+method document.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _convert_wind_to_2m(wind_speed, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+\n+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\n+    \"\"\"\n+    if height_m == 2.0:\n+        return wind_speed\n+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n+    return wind_speed * factor\n+\n+\n+def _convert_radiation(radiation, units):\n+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may"]
[67.191413, "i", " be\n+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\n+    \"\"\"\n+    if units.lower().startswith(\"w\"):\n+        return radiation * 0.0864\n+    return radiation\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\n+\n+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\n+    \"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+   "]
[67.191433, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[67.19145, "i", "     \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype(float),\n+    })\n+\n+    # Actual vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"],\n+            df[\"tmin\"],\n+            raw[\"rh_max_pct\"].astype(float),\n+            raw[\"rh_min_pct\"].astype(float),\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion to MJ m⁻² day⁻¹\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+\n+    return df\n+\n+EOF\n"]
[67.191478, "o", "     \"doy\": dates.dt.dayofyear.astype(int),\r\n+        \"tma"]
[67.191496, "o", "x\": raw[\"tmax_c\"].astype(float),\r\n+        \"tmin\": raw[\"tmin_c\"].astyp"]
[67.191511, "o", "e(float),\r\n+    })\r\n+\r\n+    # Actual vapour pressure (ea)\r\n+    if station.humidity == \"dewpoint\":\r\n+        df[\"ea\"] ="]
[67.191526, "o", " fao56.actual_vapour_pressur"]
[67.191542, "o", "e_dewpoint(raw[\"tdew_c\"].astype(float))\r\n+    else:\r\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n+            df[\"tmax\"],\r\n+ "]
[67.191558, "o", "           df[\"tmin\"],\r\n+            raw[\"rh_max_pct\"].astype(float),\r\n+            raw"]
[67.191574, "o", "[\"rh_min_pct\"].astype(float),\r\n+        )\r\n+\r\n+    # "]
[67.191591, "o", "Wind speed conversion to 2 m height\r\n+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n+\r\n+    # "]
[67.191607, "o", "Solar radiation conversion to MJ m⁻² day⁻¹\r\n+  "]
[67.191622, "o", "  df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n+\r\n+    return df\r\n+\r\n+EOF\r\n"]
[67.191638, "o", "\u001b[?2004h> "]
[67.191917, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[67.191936, "o", "\u001b[?2004h"]
[67.191952, "o", "> +\r\n"]
[67.191968, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.192267, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\r\n\u001b[?2004l\r"]
[67.192289, "o", "\u001b[?2004h"]
[67.192308, "o", "> "]
[67.192505, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[67.192528, "o", "\u001b[?2004h> +\r\n"]
[67.192552, "o", "\u001b[?2004l\r"]
[67.192575, "o", "\u001b[?2004h> "]
[67.192676, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[67.192695, "o", "\u001b[?2004h"]
[67.192711, "o", "> "]
[67.192977, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[67.192995, "o", "\u001b[?2004h"]
[67.193013, "o", "> "]
[67.193069, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[67.193086, "o", "\u001b[?2004h> "]
[67.193388, "o", "+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[67.19341, "o", "\u001b[?2004h> "]
[67.193604, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[67.193624, "o", "\u001b[?2004h"]
[67.193643, "o", "> +\r\n"]
[67.193661, "o", "\u001b[?2004l\r\u001b[?2004h"]
[67.193679, "o", "> "]
[67.19378, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\r\n\u001b[?2004l\r"]
[67.193798, "o", "\u001b[?2004h> "]
[67.193819, "o", "+\r\n"]
[67.193836, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.193967, "o", "+  where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[67.193985, "o", "\u001b[?2004h"]
[67.194006, "o", "> "]
[67.194331, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\r\n\u001b[?2004l\r"]
[67.194351, "o", "\u001b[?2004h"]
[67.194368, "o", "> "]
[67.194732, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
[67.194751, "o", "\u001b[?2004h"]
[67.194769, "o", "> +\r\n"]
[67.194791, "o", "\u001b[?2004l\r\u001b[?2004h"]
[67.194812, "o", "> "]
[67.195075, "o", "+These conversions make the pipeline robust for *any* station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[67.195092, "o", "\u001b[?2004h"]
[67.195114, "o", "> "]
[67.195156, "o", "+method document.\r\n\u001b[?2004l\r"]
[67.195177, "o", "\u001b[?2004h"]
[67.195195, "o", "> +\"\"\"\r\n"]
[67.195217, "o", "\u001b[?2004l\r\u001b[?2004h"]
[67.195238, "o", "> +\r\n\u001b[?2004l\r"]
[67.19526, "o", "\u001b[?2004h> "]
[67.195276, "o", "+import os\r\n\u001b[?2004l\r"]
[67.195298, "o", "\u001b[?2004h"]
[67.195315, "o", "> "]
[67.195351, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[67.195367, "o", "\u001b[?2004h> "]
[67.19539, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.195406, "o", "> "]
[67.195457, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[67.195474, "o", "\u001b[?2004h> "]
[67.195496, "o", "+\r\n"]
[67.195518, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.195566, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[67.195585, "o", "\u001b[?2004h> "]
[67.195607, "o", "+\r\n\u001b[?2004l\r"]
[67.195627, "o", "\u001b[?2004h"]
[67.195644, "o", "> "]
[67.195809, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[67.195826, "o", "\u001b[?2004h"]
[67.195843, "o", "> "]
[67.196051, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[67.196069, "o", "\u001b[?2004h> "]
[67.196093, "o", "+\r\n"]
[67.196112, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.19613, "o", "+\r\n\u001b[?2004l\r"]
[67.196158, "o", "\u001b[?2004h> "]
[67.196267, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[67.196285, "o", "\u001b[?2004h"]
[67.196306, "o", "> "]
[67.196514, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[67.196531, "o", "\u001b[?2004h"]
[67.196554, "o", "> +\r\n\u001b[?2004l\r"]
[67.196575, "o", "\u001b[?2004h> "]
[67.196825, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[67.196841, "o", "\u001b[?2004h"]
[67.196858, "o", "> "]
[67.196877, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[67.196898, "o", "\u001b[?2004h> "]
[67.196966, "o", "+    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[67.196984, "o", "\u001b[?2004h"]
[67.197005, "o", "> "]
[67.197064, "o", "+        return wind_speed\r\n\u001b[?2004l\r"]
[67.197081, "o", "\u001b[?2004h"]
[67.197102, "o", "> "]
[67.19723, "o", "+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[67.197255, "o", "\u001b[?2004h> "]
[67.197342, "o", "+    return wind_speed * factor\r\n\u001b[?2004l\r"]
[67.197359, "o", "\u001b[?2004h"]
[67.19738, "o", "> +\r\n"]
[67.197401, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.197422, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.197442, "o", "> "]
[67.197535, "o", "+def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[67.197551, "o", "\u001b[?2004h"]
[67.197569, "o", "> "]
[67.197726, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[67.197743, "o", "\u001b[?2004h"]
[67.197765, "o", "> +\r\n"]
[67.197786, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.198054, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[67.198071, "o", "\u001b[?2004h"]
[67.198088, "o", "> "]
[67.198332, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[67.198354, "o", "\u001b[?2004h> "]
[67.19838, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[67.198397, "o", "\u001b[?2004h"]
[67.198418, "o", "> "]
[67.198508, "o", "+    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[67.198525, "o", "\u001b[?2004h> "]
[67.198622, "o", "+        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[67.198639, "o", "\u001b[?2004h"]
[67.19866, "o", "> "]
[67.198707, "o", "+    return radiation\r\n\u001b[?2004l\r"]
[67.198724, "o", "\u001b[?2004h"]
[67.198746, "o", "> +\r\n"]
[67.198768, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.19879, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.198889, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[67.198906, "o", "\u001b[?2004h"]
[67.198927, "o", "> "]
[67.199183, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.199202, "o", "+\r\n"]
[67.19921, "o", "\u001b[?2004l\r\u001b[?2004h"]
[67.199232, "o", "> "]
[67.199388, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[67.199404, "o", "\u001b[?2004h"]
[67.199422, "o", "> "]
[67.19944, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[67.199462, "o", "\u001b[?2004h> "]
[67.19963, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[67.199647, "o", "\u001b[?2004h"]
[67.199669, "o", "> "]
[67.199729, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[67.199747, "o", "\u001b[?2004h"]
[67.199768, "o", "> +"]
[67.199785, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.199806, "o", "> "]
[67.199916, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[67.199934, "o", "\u001b[?2004h"]
[67.199955, "o", "> "]
[67.200195, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[67.200221, "o", "\u001b[?2004h> "]
[67.200243, "o", "+\r\n\u001b[?2004l\r"]
[67.20026, "o", "\u001b[?2004h> "]
[67.200511, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[67.200528, "o", "\u001b[?2004h"]
[67.20055, "o", "> "]
[67.200582, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[67.200598, "o", "\u001b[?2004h"]
[67.200615, "o", "> "]
[67.200773, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[67.200794, "o", "\u001b[?2004h> "]
[67.20081, "o", "+\r\n\u001b[?2004l\r"]
[67.200832, "o", "\u001b[?2004h> "]
[67.20098, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[67.200996, "o", "\u001b[?2004h"]
[67.201014, "o", "> "]
[67.201072, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[67.20109, "o", "\u001b[?2004h> "]
[67.201215, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[67.201234, "o", "\u001b[?2004h"]
[67.201257, "o", "> "]
[67.201368, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[67.201386, "o", "\u001b[?2004h> "]
[67.201516, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[67.201533, "o", "\u001b[?2004h"]
[67.201554, "o", "> "]
[67.201663, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[67.201679, "o", "\u001b[?2004h"]
[67.201701, "o", "> "]
[67.201805, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[67.201822, "o", "\u001b[?2004h"]
[67.201838, "o", "> "]
[67.201862, "o", "+    })\r\n\u001b[?2004l\r"]
[67.201881, "o", "\u001b[?2004h"]
[67.201903, "o", "> +\r\n\u001b[?2004l\r"]
[67.201924, "o", "\u001b[?2004h> "]
[67.202, "o", "+    # Actual vapour pressure (ea)\r\n\u001b[?2004l\r"]
[67.202018, "o", "\u001b[?2004h"]
[67.202039, "o", "> "]
[67.202131, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[67.202152, "o", "\u001b[?2004h"]
[67.202171, "o", "> "]
[67.202381, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[67.2024, "o", "\u001b[?2004h"]
[67.202421, "o", "> "]
[67.202442, "o", "+    else:\r\n\u001b[?2004l\r"]
[67.202463, "o", "\u001b[?2004h> "]
[67.2026, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[67.202617, "o", "\u001b[?2004h"]
[67.202638, "o", "> "]
[67.202693, "o", "+            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[67.202711, "o", "\u001b[?2004h> "]
[67.202782, "o", "+            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[67.202801, "o", "\u001b[?2004h"]
[67.202821, "o", "> "]
[67.202928, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[67.202945, "o", "\u001b[?2004h> "]
[67.20307, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[67.203088, "o", "\u001b[?2004h"]
[67.203104, "o", "> "]
[67.203128, "o", "+        )\r\n\u001b[?2004l\r"]
[67.203152, "o", "\u001b[?2004h> "]
[67.203172, "o", "+\r\n\u001b[?2004l\r"]
[67.203194, "o", "\u001b[?2004h> "]
[67.203303, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[67.203321, "o", "\u001b[?2004h"]
[67.203342, "o", "> "]
[67.203556, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[67.203576, "o", "\u001b[?2004h"]
[67.203598, "o", "> +"]
[67.203615, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.203632, "o", "> "]
[67.203773, "o", "+    # Solar radiation conversion to MJ m⁻² day⁻¹\r\n\u001b[?2004l\r"]
[67.203791, "o", "\u001b[?2004h"]
[67.203813, "o", "> "]
[67.204043, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[67.20406, "o", "\u001b[?2004h> "]
[67.204081, "o", "+\r\n\u001b[?2004l\r"]
[67.204102, "o", "\u001b[?2004h"]
[67.204122, "o", "> "]
[67.204149, "o", "+    return df\r\n\u001b[?2004l\r"]
[67.204167, "o", "\u001b[?2004h"]
[67.204191, "o", "> +\r\n\u001b[?2004l\r"]
[67.204212, "o", "\u001b[?2004h> "]
[67.204233, "o", "+EOF\r\n\u001b[?2004l\r"]
[67.204249, "o", "\u001b[?2004h> "]
[68.176709, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
