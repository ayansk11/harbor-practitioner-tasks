[169.473617, "o", "\u001b[?2004h> "]
[169.473643, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.473669, "o", "> "]
[169.47378, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[169.473812, "o", "\u001b[?2004h> "]
[169.474154, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[169.47419, "o", "\u001b[?2004h> +\r\n"]
[169.474213, "o", "\u001b[?2004l\r"]
[169.474224, "o", "\u001b[?2004h> "]
[169.474456, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[169.47449, "o", "\u001b[?2004h> "]
