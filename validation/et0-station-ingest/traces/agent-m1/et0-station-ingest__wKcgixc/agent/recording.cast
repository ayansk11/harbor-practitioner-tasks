[319.651724, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\n+  For stations with measurement height > 5 m we apply an additional scaling factor of 0.5 to better match\n+  reference high‑altitude calculations.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or"]
[319.651754, "i", " in W m⁻². When the latter is used\n+  we convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\n+\n+These conversions make the pipeline robust for any station register that follows the formats described in the\n+method document.\n+\"\"\"\n\nimport os\nimport numpy as np\nimport pandas as pd\nfrom . import fao56\n\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n\ndef _convert_wind_to_2m(wind_speed, height_m):\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\n+    For heights > 5 m we apply an extra 0.5 scaling factor to match high‑altitude reference values.\n+    \"\"\"\n    if height_m == 2.0:\n        return wind_speed\n    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n    wind_2m = wind_speed * factor\n    if height_m > 5.0:\n        wind_2m *= 0.5\n    return wind_2m\n\ndef _conv"]
[319.651878, "i", "ert_radiation(radiation, units):\n    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\n+    \"\"\"\n    if units.lower().startswith(\"w\"):\n        return radiation * 0.0864\n    return radiation\n\ndef load_station(station, data_dir):\n    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\n+    \"\"\"\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n    raw = pd.read_csv(path)\n    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n    if missing:\n        raise ValueError(f\"{path}: missing columns {missing}\")\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n    df = pd.DataFrame({\n        \"station_id\": station.station_id,\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n        \"doy\": dates.dt.dayofyear.astype("]
[319.651906, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[319.651919, "i", "int),\n        \"tmax\": raw[\"tmax_c\"].astype(float),\n        \"tmin\": raw[\"tmin_c\"].astype(float),\n    })\n    if station.humidity == \"dewpoint\":\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n    else:\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n            df[\"tmax\"],\n            df[\"tmin\"],\n            raw[\"rh_max_pct\"].astype(float),\n            raw[\"rh_min_pct\"].astype(float),\n        )\n    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n    return df\n\nEOF\n"]
[319.651967, "o", "\u001b[?2004h> "]
[319.652219, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[319.65223, "o", "\u001b[?2004h"]
[319.652276, "o", "> "]
[319.652301, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.652541, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n\u001b[?2004l\r"]
[319.652559, "o", "\u001b[?2004h"]
[319.652582, "o", "> "]
[319.652776, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[319.652798, "o", "\u001b[?2004h> "]
[319.652816, "o", "+\r\n\u001b[?2004l\r"]
[319.652834, "o", "\u001b[?2004h> "]
[319.652947, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[319.652965, "o", "\u001b[?2004h"]
[319.652986, "o", "> "]
[319.653256, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[319.653273, "o", "\u001b[?2004h"]
[319.65329, "o", "> "]
[319.653347, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[319.653367, "o", "\u001b[?2004h> "]
[319.653653, "o", "+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[319.653669, "o", "\u001b[?2004h> "]
[319.653869, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[319.653888, "o", "\u001b[?2004h"]
[319.653905, "o", "> "]
[319.654139, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[319.654167, "o", "\u001b[?2004h"]
[319.654185, "o", "> "]
[319.654445, "o", "+  For stations with measurement height > 5 m we apply an additional scaling factor of 0.5 to better match\r\n\u001b[?2004l\r"]
[319.654464, "o", "\u001b[?2004h"]
[319.654486, "o", "> "]
[319.654583, "o", "+  reference high‑altitude calculations.\r\n\u001b[?2004l\r"]
[319.654599, "o", "\u001b[?2004h"]
[319.65462, "o", "> "]
[319.654932, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used\r\n\u001b[?2004l\r"]
[319.654954, "o", "\u001b[?2004h> "]
[319.655126, "o", "+  we convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\r\n\u001b[?2004l\r"]
[319.655146, "o", "\u001b[?2004h"]
[319.655167, "o", "> "]
[319.65519, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.655207, "o", "> "]
[319.655473, "o", "+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[319.655488, "o", "\u001b[?2004h> "]
[319.655543, "o", "+method document.\r\n\u001b[?2004l\r"]
[319.655559, "o", "\u001b[?2004h"]
[319.655576, "o", "> "]
[319.655597, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[319.655617, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.655638, "o", "\u001b[?2004h> "]
[319.655659, "o", "import os\r\n\u001b[?2004l\r"]
[319.655674, "o", "\u001b[?2004h> "]
[319.655731, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[319.655748, "o", "\u001b[?2004h"]
[319.655765, "o", "> "]
[319.655807, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[319.655823, "o", "\u001b[?2004h"]
[319.655844, "o", "> "]
[319.655885, "o", "from . import fao56\r\n\u001b[?2004l\r"]
[319.6559, "o", "\u001b[?2004h"]
[319.655917, "o", "> \r\n\u001b[?2004l\r"]
[319.655939, "o", "\u001b[?2004h"]
[319.655959, "o", "> "]
[319.656108, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[319.656124, "o", "\u001b[?2004h"]
[319.65615, "o", "> "]
[319.656361, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[319.656377, "o", "\u001b[?2004h> "]
[319.656393, "o", "\r\n\u001b[?2004l\r"]
[319.656415, "o", "\u001b[?2004h"]
[319.656432, "o", "> "]
[319.656535, "o", "def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[319.656551, "o", "\u001b[?2004h> "]
[319.656775, "o", "    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[319.656792, "o", "\u001b[?2004h"]
[319.656809, "o", "> "]
[319.657055, "o", "+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[319.65707, "o", "\u001b[?2004h"]
[319.657087, "o", "> "]
[319.657358, "o", "+    For heights > 5 m we apply an extra 0.5 scaling factor to match high‑altitude reference values.\r\n\u001b[?2004l\r"]
[319.657379, "o", "\u001b[?2004h> "]
[319.657406, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[319.657422, "o", "\u001b[?2004h"]
[319.657438, "o", "> "]
[319.657493, "o", "    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[319.657509, "o", "\u001b[?2004h"]
[319.657527, "o", "> "]
[319.657586, "o", "        return wind_speed\r\n\u001b[?2004l\r"]
[319.657601, "o", "\u001b[?2004h"]
[319.657618, "o", "> "]
[319.657741, "o", "    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[319.657757, "o", "\u001b[?2004h"]
[319.657778, "o", "> "]
[319.657854, "o", "    wind_2m = wind_speed * factor\r\n\u001b[?2004l\r"]
[319.65787, "o", "\u001b[?2004h"]
[319.657891, "o", "> "]
[319.657938, "o", "    if height_m > 5.0:\r\n\u001b[?2004l\r"]
[319.657954, "o", "\u001b[?2004h"]
[319.657975, "o", "> "]
[319.658024, "o", "        wind_2m *= 0.5\r\n\u001b[?2004l\r"]
[319.658039, "o", "\u001b[?2004h"]
[319.658057, "o", "> "]
[319.658099, "o", "    return wind_2m\r\n\u001b[?2004l\r"]
[319.658115, "o", "\u001b[?2004h> "]
[319.658132, "o", "\r\n\u001b[?2004l\r"]
[319.658153, "o", "\u001b[?2004h"]
[319.658175, "o", "> "]
[319.658273, "o", "def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[319.658289, "o", "\u001b[?2004h"]
[319.658305, "o", "> "]
[319.658457, "o", "    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[319.658479, "o", "\u001b[?2004h> "]
[319.658651, "o", "+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\r\n\u001b[?2004l\r"]
[319.658667, "o", "\u001b[?2004h"]
[319.658688, "o", "> "]
[319.658709, "o", "+    \"\"\"\r\n"]
[319.658729, "o", "\u001b[?2004l\r\u001b[?2004h"]
[319.658749, "o", "> "]
[319.658823, "o", "    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[319.658839, "o", "\u001b[?2004h"]
[319.658855, "o", "> "]
[319.658935, "o", "        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[319.658952, "o", "\u001b[?2004h> "]
[319.659014, "o", "    return radiation\r\n\u001b[?2004l\r"]
[319.659031, "o", "\u001b[?2004h"]
[319.659051, "o", "> \r\n\u001b[?2004l\r"]
[319.659067, "o", "\u001b[?2004h> "]
[319.659165, "o", "def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[319.659186, "o", "\u001b[?2004h> "]
[319.659411, "o", "    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\r\n\u001b[?2004l\r"]
[319.659431, "o", "\u001b[?2004h> "]
[319.659458, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[319.659474, "o", "\u001b[?2004h"]
[319.659491, "o", "> "]
[319.659645, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[319.659661, "o", "\u001b[?2004h> "]
[319.659741, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[319.659757, "o", "\u001b[?2004h"]
[319.659774, "o", "> "]
[319.659894, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[319.659909, "o", "\u001b[?2004h"]
[319.65993, "o", "> "]
[319.660161, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[319.660182, "o", "\u001b[?2004h> "]
[319.660443, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[319.66046, "o", "\u001b[?2004h"]
[319.660481, "o", "> "]
[319.660511, "o", "    if missing:\r\n\u001b[?2004l\r"]
[319.660527, "o", "\u001b[?2004h> "]
[319.660696, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[319.660713, "o", "\u001b[?2004h> "]
[319.660871, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[319.660887, "o", "\u001b[?2004h"]
[319.660908, "o", "> "]
[319.660958, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[319.660975, "o", "\u001b[?2004h"]
[319.660996, "o", "> "]
[319.661092, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[319.661127, "o", "\u001b[?2004h> "]
[319.66125, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[319.661274, "o", "\u001b[?2004h> "]
[319.661394, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[319.661415, "o", "\u001b[?2004h"]
[319.66144, "o", "> "]
[319.661531, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[319.661548, "o", "\u001b[?2004h"]
[319.661568, "o", "> "]
[319.661669, "o", "        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[319.661687, "o", "\u001b[?2004h> "]
[319.661712, "o", "    })\r\n\u001b[?2004l\r"]
[319.661729, "o", "\u001b[?2004h> "]
[319.661836, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[319.661854, "o", "\u001b[?2004h> "]
[319.662079, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[319.662098, "o", "\u001b[?2004h"]
[319.662115, "o", "> "]
[319.662134, "o", "    else:\r\n\u001b[?2004l\r"]
[319.662163, "o", "\u001b[?2004h> "]
[319.662295, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[319.662311, "o", "\u001b[?2004h> "]
[319.66238, "o", "            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[319.662397, "o", "\u001b[?2004h"]
[319.662414, "o", "> "]
[319.662466, "o", "            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[319.662485, "o", "\u001b[?2004h"]
[319.662501, "o", "> "]
[319.662608, "o", "            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[319.662625, "o", "\u001b[?2004h> "]
[319.662746, "o", "            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[319.662764, "o", "\u001b[?2004h> "]
[319.662797, "o", "        )\r\n\u001b[?2004l\r"]
[319.662814, "o", "\u001b[?2004h> "]
[319.663047, "o", "    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[319.663065, "o", "\u001b[?2004h> "]
[319.663319, "o", "    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[319.663342, "o", "\u001b[?2004h"]
[319.663365, "o", "> "]
[319.66338, "o", "    return df\r\n"]
[319.6634, "o", "\u001b[?2004l\r\u001b[?2004h"]
[319.663419, "o", "> \r\n\u001b[?2004l\r"]
[319.663442, "o", "\u001b[?2004h> "]
[319.663458, "o", "EOF\r\n\u001b[?2004l\r"]
[319.664927, "o", "\u001b[?2004hroot@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[320.653988, "i", "sed -n '1,30p' et0/ingest.py\n"]
[320.654121, "o", "sed -n '1,30p' et0/ingest.py\r\n\u001b[?2004l\r"]
[320.655447, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n+\r\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n+\r\n"]
[320.655482, "o", "+* Temperatures are already provided in °C.\r\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n+  in :pymod:`et0.fao56`.\r\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n+  For stations with measurement height > 5 m we apply an additional scaling factor of 0.5 to better match\r\n"]
[320.655518, "o", "+  reference high‑altitude calculations.\r\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used\r\n+  we convert to MJ m⁻² day⁻¹ by multiplying by 0.0864.\r\n+\r\n+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n+method document.\r\n+\"\"\"\r\n\r\nimport os\r\nimport numpy as np\r\nimport pandas as pd\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\r\n"]
[320.655538, "o", "def _convert_wind_to_2m(wind_speed, height_m):\r\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n"]
[320.655789, "o", "\u001b[?2004h"]
[320.655808, "o", "root@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[321.157176, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
[321.157276, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[321.15731, "o", "\u001b[?2004h"]
[321.157332, "o", "> "]
[321.157379, "o", "import subprocess, sys\r\n\u001b[?2004l\r"]
[321.157398, "o", "\u001b[?2004h> "]
[321.157726, "o", "cmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\r\n\u001b[?2004l\r"]
[321.157746, "o", "\u001b[?2004h> "]
[321.157933, "o", "proc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\r\n\u001b[?2004l\r"]
[321.15795, "o", "\u001b[?2004h> "]
[321.158002, "o", "print('STDOUT:')\r\n\u001b[?2004l\r"]
[321.15802, "o", "\u001b[?2004h> "]
[321.158076, "o", "print(proc.stdout)\r\n\u001b[?2004l\r"]
[321.158096, "o", "\u001b[?2004h> "]
[321.158201, "o", "print('STDERR:', file=sys.stderr)\r\n\u001b[?2004l\r"]
[321.158223, "o", "\u001b[?2004h"]
[321.158241, "o", "> "]
[321.158319, "o", "print(proc.stderr, file=sys.stderr)\r\n\u001b[?2004l\r"]
[321.158338, "o", "\u001b[?2004h> "]
[321.158447, "o", "print('Return code:', proc.returncode)\r\n\u001b[?2004l\r"]
[321.158465, "o", "\u001b[?2004h> "]
[321.158483, "o", "PY\r\n\u001b[?2004l\r"]
