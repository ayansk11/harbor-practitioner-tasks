[131.74791, "o", "+        return wind_speed\r\n\u001b[?2004l\r"]
[131.747946, "o", "\u001b[?2004h> "]
[131.748073, "o", "+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[131.74809, "o", "\u001b[?2004h"]
[131.748124, "o", "> "]
[131.748188, "o", "+    return wind_speed * factor\r\n\u001b[?2004l\r"]
[131.748211, "o", "\u001b[?2004h> "]
[131.74823, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.748248, "o", "> +\r\n\u001b[?2004l\r"]
[131.748268, "o", "\u001b[?2004h> "]
[131.74838, "o", "+def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[131.748396, "o", "\u001b[?2004h"]
[131.748415, "o", "> "]
[131.748565, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[131.748583, "o", "\u001b[?2004h"]
[131.748601, "o", "> +\r\n\u001b[?2004l\r"]
[131.748619, "o", "\u001b[?2004h> "]
[131.748889, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[131.748907, "o", "\u001b[?2004h"]
[131.748925, "o", "> "]
[131.749159, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[131.749177, "o", "\u001b[?2004h"]
[131.749195, "o", "> "]
[131.749212, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[131.749231, "o", "\u001b[?2004h> "]
[131.749331, "o", "+    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[131.749349, "o", "\u001b[?2004h"]
[131.749375, "o", "> "]
[131.749446, "o", "+        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[131.749463, "o", "\u001b[?2004h"]
[131.749481, "o", "> "]
[131.749526, "o", "+    return radiation\r\n\u001b[?2004l\r"]
[131.749545, "o", "\u001b[?2004h"]
[131.749562, "o", "> +\r\n\u001b[?2004l\r"]
[131.74958, "o", "\u001b[?2004h> "]
[131.749598, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.749616, "o", "> "]
[131.749707, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[131.749725, "o", "\u001b[?2004h"]
[131.749743, "o", "> "]
[131.749973, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[131.749992, "o", "\u001b[?2004h"]
[131.75001, "o", "> +\r\n\u001b[?2004l\r"]
[131.750029, "o", "\u001b[?2004h> "]
[131.750206, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[131.750225, "o", "\u001b[?2004h> "]
[131.750253, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[131.75027, "o", "\u001b[?2004h"]
[131.750288, "o", "> "]
[131.750439, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[131.750456, "o", "\u001b[?2004h"]
[131.750474, "o", "> "]
[131.750538, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[131.750556, "o", "\u001b[?2004h"]
[131.750574, "o", "> +\r\n\u001b[?2004l\r"]
[131.750592, "o", "\u001b[?2004h> "]
[131.750719, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[131.750736, "o", "\u001b[?2004h"]
[131.750753, "o", "> "]
[131.750984, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[131.751002, "o", "\u001b[?2004h"]
[131.751019, "o", "> +\r\n\u001b[?2004l\r"]
[131.751037, "o", "\u001b[?2004h> "]
[131.751304, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[131.75132, "o", "\u001b[?2004h"]
[131.751338, "o", "> "]
[131.751371, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[131.751388, "o", "\u001b[?2004h"]
[131.751407, "o", "> "]
[131.751559, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[131.751576, "o", "\u001b[?2004h"]
[131.751595, "o", "> +\r\n\u001b[?2004l\r"]
[131.751612, "o", "\u001b[?2004h> "]
[131.751766, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[131.751784, "o", "\u001b[?2004h"]
[131.751802, "o", "> "]
[131.751854, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[131.751872, "o", "\u001b[?2004h"]
[131.751889, "o", "> "]
[131.751988, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[131.752006, "o", "\u001b[?2004h"]
[131.752023, "o", "> "]
[131.752135, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[131.752169, "o", "\u001b[?2004h"]
[131.752189, "o", "> "]
[131.752311, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[131.752329, "o", "\u001b[?2004h"]
[131.752347, "o", "> "]
[131.752454, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[131.752471, "o", "\u001b[?2004h"]
[131.752489, "o", "> "]
[131.752595, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[131.752613, "o", "\u001b[?2004h"]
[131.752631, "o", "> "]
[131.752649, "o", "+    })\r\n\u001b[?2004l\r"]
[131.752668, "o", "\u001b[?2004h> +\r\n"]
[131.752686, "o", "\u001b[?2004l\r\u001b[?2004h"]
[131.752704, "o", "> "]
[131.752785, "o", "+    # Actual vapour pressure (ea)\r\n\u001b[?2004l\r"]
[131.752808, "o", "\u001b[?2004h"]
[131.752825, "o", "> "]
[131.752917, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[131.752936, "o", "\u001b[?2004h"]
[131.752954, "o", "> "]
[131.753169, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[131.753186, "o", "\u001b[?2004h"]
[131.753205, "o", "> "]
[131.753223, "o", "+    else:\r\n\u001b[?2004l\r"]
[131.753241, "o", "\u001b[?2004h> "]
[131.753379, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[131.753396, "o", "\u001b[?2004h"]
[131.753414, "o", "> "]
[131.753467, "o", "+            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[131.753484, "o", "\u001b[?2004h"]
[131.753502, "o", "> "]
[131.753555, "o", "+            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[131.753573, "o", "\u001b[?2004h"]
[131.75359, "o", "> "]
[131.753696, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[131.753714, "o", "\u001b[?2004h"]
[131.753732, "o", "> "]
[131.753838, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[131.753856, "o", "\u001b[?2004h"]
[131.753874, "o", "> "]
[131.753893, "o", "+        )\r\n\u001b[?2004l\r"]
[131.753911, "o", "\u001b[?2004h> "]
[131.753929, "o", "+\r\n\u001b[?2004l\r"]
[131.753947, "o", "\u001b[?2004h> "]
[131.75406, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[131.754078, "o", "\u001b[?2004h"]
[131.754096, "o", "> "]
[131.754317, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[131.754339, "o", "\u001b[?2004h> "]
[131.754358, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.754377, "o", "> "]
[131.754524, "o", "+    # Solar radiation conversion to MJ m⁻² day‑1\r\n\u001b[?2004l\r"]
[131.754544, "o", "\u001b[?2004h"]
[131.754562, "o", "> "]
[131.754793, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[131.754812, "o", "\u001b[?2004h"]
[131.75483, "o", "> +\r\n\u001b[?2004l\r"]
[131.754847, "o", "\u001b[?2004h"]
[131.754865, "o", "> "]
[131.754898, "o", "+    return df\r\n\u001b[?2004l\r"]
[131.754918, "o", "\u001b[?2004h"]
[131.754936, "o", "> +\r\n\u001b[?2004l\r"]
[131.754953, "o", "\u001b[?2004h"]
[131.754977, "o", "> +EOF\r\n\u001b[?2004l\r"]
[131.754996, "o", "\u001b[?2004h"]
[131.755014, "o", "> "]
[132.730886, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
