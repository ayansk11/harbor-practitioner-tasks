[169.479751, "o", "\u001b[?2004h> "]
[169.480068, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[169.480091, "o", "\u001b[?2004h"]
[169.480118, "o", "> +\r\n\u001b[?2004l\r"]
[169.480138, "o", "\u001b[?2004h"]
[169.480162, "o", "> "]
[169.480376, "o", "+    # Solar radiation conversion to MJ m⁻² day‑1\r\n\u001b[?2004l\r"]
