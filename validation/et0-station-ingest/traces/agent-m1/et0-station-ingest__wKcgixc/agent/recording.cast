[229.27608, "i", "cat <<'EOF' > et0/ingest.py\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\n+\n+  where ``z`` is the measurement height in metres.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day ="]
[229.276204, "i", " 86 400 J m⁻² = 0.0864 MJ m⁻²).\n+\n+These conversions make the pipeline robust for *any* station register that follows the formats described in the\n+method document.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _convert_wind_to_2m(wind_speed, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+\n+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\n+    \"\"\"\n+    if height_m == 2.0:\n+        return wind_speed\n+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n+    return wind_speed * factor\n+\n+\n+def _convert_radiation(radiation, units):\n+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may"]
[229.276238, "o", "cat <<'EOF' > et0/ingest.py\r\n\u001b[?2004l\r"]
[229.276264, "i", " be\n+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\n+    \"\"\"\n+    if units.lower().startswith(\"w\"):\n+        return radiation * 0.0864\n+    return radiation\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\n+\n+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\n+    \"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+   "]
[229.276289, "o", "\u001b[?2004h> "]
[229.276313, "i", "     \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype(float),\n+    })\n+\n+    # Actual vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"],\n+            df[\"tmin\"],\n+            raw[\"rh_max_pct\"].astype(float),\n+            raw[\"rh_min_pct\"].astype(float),\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion to MJ m⁻² day‑1\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+\n+    return df\n+\n+EOF\n"]
[229.276609, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[229.276645, "o", "\u001b[?2004h> "]
[229.276673, "o", "+\r\n\u001b[?2004l\r"]
[229.276696, "o", "\u001b[?2004h> "]
[229.277034, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\r\n\u001b[?2004l\r"]
[229.277061, "o", "\u001b[?2004h"]
[229.277085, "o", "> "]
[229.277312, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[229.277336, "o", "\u001b[?2004h> "]
[229.277359, "o", "+\r\n\u001b[?2004l\r"]
[229.277381, "o", "\u001b[?2004h> "]
[229.277485, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[229.277513, "o", "\u001b[?2004h> "]
[229.277787, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[229.27781, "o", "\u001b[?2004h> "]
[229.27788, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[229.277904, "o", "\u001b[?2004h> "]
[229.278209, "o", "+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[229.278234, "o", "\u001b[?2004h"]
[229.278259, "o", "> "]
[229.278437, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[229.278462, "o", "\u001b[?2004h> "]
[229.278488, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[229.278511, "o", "> "]
[229.278618, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\r\n\u001b[?2004l\r"]
[229.278643, "o", "\u001b[?2004h> "]
[229.278666, "o", "+\r\n\u001b[?2004l\r"]
[229.278689, "o", "\u001b[?2004h> "]
[229.278808, "o", "+  where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[229.278832, "o", "\u001b[?2004h> "]
[229.279181, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\r\n\u001b[?2004l\r"]
[229.279205, "o", "\u001b[?2004h"]
[229.279231, "o", "> "]
[229.27958, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
[229.279608, "o", "\u001b[?2004h> "]
[229.279629, "o", "+\r\n\u001b[?2004l\r"]
[229.27965, "o", "\u001b[?2004h> "]
[229.279927, "o", "+These conversions make the pipeline robust for *any* station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[229.279941, "o", "\u001b[?2004h"]
[229.279955, "o", "> "]
[229.279998, "o", "+method document.\r\n\u001b[?2004l\r"]
[229.280021, "o", "\u001b[?2004h> "]
[229.280045, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[229.280067, "o", "\u001b[?2004h> "]
[229.280089, "o", "+\r\n\u001b[?2004l\r"]
[229.280111, "o", "\u001b[?2004h> "]
[229.280125, "o", "+import os\r\n\u001b[?2004l\r"]
[229.280159, "o", "\u001b[?2004h> "]
[229.280206, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[229.280247, "o", "\u001b[?2004h"]
[229.280284, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.280319, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[229.280337, "o", "\u001b[?2004h> "]
[229.280354, "o", "+\r\n\u001b[?2004l\r"]
[229.28037, "o", "\u001b[?2004h> "]
[229.280431, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[229.280449, "o", "\u001b[?2004h"]
[229.280464, "o", "> +\r\n\u001b[?2004l\r"]
[229.280482, "o", "\u001b[?2004h> "]
[229.280665, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[229.280684, "o", "\u001b[?2004h> "]
[229.280915, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[229.280935, "o", "\u001b[?2004h"]
[229.28095, "o", "> +\r\n\u001b[?2004l\r"]
[229.280967, "o", "\u001b[?2004h> "]
[229.280988, "o", "+\r\n\u001b[?2004l\r"]
[229.281003, "o", "\u001b[?2004h> "]
[229.281127, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[229.281151, "o", "\u001b[?2004h> "]
[229.281378, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[229.281396, "o", "\u001b[?2004h"]
[229.281412, "o", "> +\r\n"]
[229.281428, "o", "\u001b[?2004l\r\u001b[?2004h"]
[229.281442, "o", "> "]
[229.281692, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[229.281709, "o", "\u001b[?2004h"]
[229.281724, "o", "> "]
[229.281743, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[229.281761, "o", "\u001b[?2004h"]
[229.281777, "o", "> "]
[229.281835, "o", "+    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[229.281855, "o", "\u001b[?2004h"]
[229.281869, "o", "> "]
[229.281932, "o", "+        return wind_speed\r\n\u001b[?2004l\r"]
[229.28195, "o", "\u001b[?2004h"]
[229.281965, "o", "> "]
[229.282092, "o", "+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[229.282111, "o", "\u001b[?2004h"]
[229.282128, "o", "> "]
[229.282209, "o", "+    return wind_speed * factor\r\n\u001b[?2004l\r"]
[229.282228, "o", "\u001b[?2004h> "]
[229.282244, "o", "+\r\n\u001b[?2004l\r"]
[229.28226, "o", "\u001b[?2004h"]
[229.282276, "o", "> +\r\n\u001b[?2004l\r"]
[229.282291, "o", "\u001b[?2004h"]
[229.282306, "o", "> "]
[229.282408, "o", "+def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[229.282426, "o", "\u001b[?2004h"]
[229.282441, "o", "> "]
[229.282599, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[229.282617, "o", "\u001b[?2004h"]
[229.282633, "o", "> +\r\n\u001b[?2004l\r"]
[229.282649, "o", "\u001b[?2004h> "]
[229.282928, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[229.282949, "o", "\u001b[?2004h"]
[229.282964, "o", "> "]
[229.283208, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[229.283226, "o", "\u001b[?2004h"]
[229.283241, "o", "> "]
[229.283258, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[229.283277, "o", "\u001b[?2004h> "]
[229.283385, "o", "+    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[229.283405, "o", "\u001b[?2004h"]
[229.283419, "o", "> "]
[229.283502, "o", "+        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[229.28352, "o", "\u001b[?2004h"]
[229.283538, "o", "> "]
[229.283586, "o", "+    return radiation\r\n\u001b[?2004l\r"]
[229.283604, "o", "\u001b[?2004h"]
[229.283618, "o", "> +\r\n"]
[229.283634, "o", "\u001b[?2004l\r\u001b[?2004h"]
[229.283649, "o", "> +\r\n"]
[229.283663, "o", "\u001b[?2004l\r"]
[229.283678, "o", "\u001b[?2004h> "]
[229.283773, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[229.283792, "o", "\u001b[?2004h> "]
[229.284043, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[229.284061, "o", "\u001b[?2004h"]
[229.284077, "o", "> +\r\n\u001b[?2004l\r"]
[229.284094, "o", "\u001b[?2004h> "]
[229.284271, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[229.284288, "o", "\u001b[?2004h"]
[229.284304, "o", "> "]
[229.284322, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[229.28434, "o", "\u001b[?2004h"]
[229.284353, "o", "> "]
[229.284512, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[229.284529, "o", "\u001b[?2004h> "]
[229.284611, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[229.284631, "o", "\u001b[?2004h> "]
[229.284651, "o", "+\r\n\u001b[?2004l\r"]
[229.284669, "o", "\u001b[?2004h> "]
[229.284799, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[229.284818, "o", "\u001b[?2004h> "]
[229.285067, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[229.285086, "o", "\u001b[?2004h> "]
[229.285104, "o", "+\r\n\u001b[?2004l\r"]
[229.285122, "o", "\u001b[?2004h> "]
[229.285436, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[229.285455, "o", "\u001b[?2004h"]
[229.285473, "o", "> "]
[229.285506, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[229.285527, "o", "\u001b[?2004h> "]
[229.285694, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[229.285712, "o", "\u001b[?2004h"]
[229.285728, "o", "> +\r\n"]
[229.285742, "o", "\u001b[?2004l\r"]
[229.285757, "o", "\u001b[?2004h> "]
[229.285908, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[229.285928, "o", "\u001b[?2004h> "]
[229.285999, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[229.286018, "o", "\u001b[?2004h> "]
[229.286137, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[229.286178, "o", "\u001b[?2004h> "]
[229.286294, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[229.286312, "o", "\u001b[?2004h"]
[229.286328, "o", "> "]
[229.286444, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[229.286462, "o", "\u001b[?2004h"]
[229.286477, "o", "> "]
[229.286588, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[229.286606, "o", "\u001b[?2004h"]
[229.286619, "o", "> "]
[229.286741, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[229.286758, "o", "\u001b[?2004h"]
[229.286772, "o", "> "]
[229.286789, "o", "+    })\r\n\u001b[?2004l\r"]
[229.286808, "o", "\u001b[?2004h"]
[229.286824, "o", "> +\r\n\u001b[?2004l\r"]
[229.286841, "o", "\u001b[?2004h> "]
[229.286938, "o", "+    # Actual vapour pressure (ea)\r\n\u001b[?2004l\r"]
[229.286958, "o", "\u001b[?2004h> "]
[229.287067, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[229.287086, "o", "\u001b[?2004h"]
[229.2871, "o", "> "]
[229.287324, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[229.287339, "o", "\u001b[?2004h> "]
[229.287376, "o", "+    else:\r\n\u001b[?2004l\r"]
[229.287395, "o", "\u001b[?2004h> "]
[229.287537, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[229.287559, "o", "\u001b[?2004h> "]
[229.287632, "o", "+            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[229.28765, "o", "\u001b[?2004h"]
[229.287664, "o", "> "]
[229.287723, "o", "+            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[229.287741, "o", "\u001b[?2004h> "]
[229.287868, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[229.287884, "o", "\u001b[?2004h> "]
[229.28801, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[229.288028, "o", "\u001b[?2004h> "]
[229.288064, "o", "+        )\r\n\u001b[?2004l\r"]
[229.288082, "o", "\u001b[?2004h> "]
[229.288099, "o", "+\r\n\u001b[?2004l\r"]
[229.288117, "o", "\u001b[?2004h> "]
[229.288245, "o", "+    # Wind speed conversion to 2 m height\r\n\u001b[?2004l\r"]
[229.288264, "o", "\u001b[?2004h> "]
[229.288497, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[229.288517, "o", "\u001b[?2004h> "]
[229.288532, "o", "+\r\n"]
[229.288547, "o", "\u001b[?2004l\r"]
[229.288561, "o", "\u001b[?2004h> "]
[229.288712, "o", "+    # Solar radiation conversion to MJ m⁻² day‑1\r\n\u001b[?2004l\r"]
[229.288729, "o", "\u001b[?2004h"]
[229.288746, "o", "> "]
[229.28898, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[229.288999, "o", "\u001b[?2004h"]
[229.289013, "o", "> +\r\n"]
[229.289031, "o", "\u001b[?2004l\r\u001b[?2004h"]
[229.289051, "o", "> "]
[229.289079, "o", "+    return df\r\n\u001b[?2004l\r"]
[229.289099, "o", "\u001b[?2004h"]
[229.289114, "o", "> +\r\n"]
[229.28913, "o", "\u001b[?2004l\r\u001b[?2004h"]
[229.289148, "o", "> "]
[229.289164, "o", "+EOF\r\n\u001b[?2004l\r"]
[229.289185, "o", "\u001b[?2004h"]
[229.289199, "o", "> "]
[230.272896, "i", "sed -n '1,20p' et0/ingest.py\n"]
[230.273027, "o", "sed -n '1,20p' et0/ingest.py\r\n\u001b[?2004l\r"]
[230.273067, "o", "\u001b[?2004h"]
[230.273093, "o", "> "]
[230.770565, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
[230.770674, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[230.770715, "o", "\u001b[?2004h"]
[230.770738, "o", "> "]
[230.770788, "o", "import subprocess, sys\r\n\u001b[?2004l\r"]
[230.770822, "o", "\u001b[?2004h> "]
[230.771138, "o", "cmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\r\n\u001b[?2004l\r"]
[230.77118, "o", "\u001b[?2004h> "]
[230.771369, "o", "proc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\r\n\u001b[?2004l\r"]
[230.771403, "o", "\u001b[?2004h> "]
[230.771441, "o", "print('STDOUT:')\r\n\u001b[?2004l\r"]
[230.77146, "o", "\u001b[?2004h"]
[230.771477, "o", "> "]
[230.771523, "o", "print(proc.stdout)\r\n\u001b[?2004l\r"]
[230.771542, "o", "\u001b[?2004h> "]
[230.771641, "o", "print('STDERR:', file=sys.stderr)\r\n\u001b[?2004l\r"]
[230.77166, "o", "\u001b[?2004h"]
[230.771676, "o", "> "]
[230.771769, "o", "print(proc.stderr, file=sys.stderr)\r\n\u001b[?2004l\r"]
[230.771787, "o", "\u001b[?2004h"]
[230.771804, "o", "> "]
