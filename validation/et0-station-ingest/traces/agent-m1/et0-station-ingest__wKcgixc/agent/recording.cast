[48.511059, "o", ")\r\n+\r\n+    # Solar radiation conversion to MJ m⁻² day⁻¹\r\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n+\r\n+    return df\r\n+\r\n*** "]
[48.511086, "o", "End Patch\r\nPATCH\r\n"]
