[428.633219, "o", "\u001b[?2004h"]
[428.633244, "o", "> "]
[428.633387, "o", "+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\r\n\u001b[?2004l\r"]
