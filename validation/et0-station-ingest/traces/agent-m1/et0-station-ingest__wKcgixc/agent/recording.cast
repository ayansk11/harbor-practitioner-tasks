[451.176843, "o", "\u001b[?2004h> "]
[451.17698, "o", "    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[451.177, "o", "\u001b[?2004h> "]
[451.177083, "o", "    return wind_speed * factor\r\n\u001b[?2004l\r"]
[451.1771, "o", "\u001b[?2004h> "]
