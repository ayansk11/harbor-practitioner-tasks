[428.635265, "o", "    if missing:\r\n\u001b[?2004l\r"]
[428.635293, "o", "\u001b[?2004h> "]
[428.635451, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[428.635474, "o", "\u001b[?2004h"]
[428.635496, "o", "> "]
[428.635627, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[428.635649, "o", "\u001b[?2004h"]
[428.635671, "o", "> "]
[428.635713, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[428.635734, "o", "\u001b[?2004h"]
[428.635758, "o", "> "]
[428.635845, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[428.635867, "o", "\u001b[?2004h"]
[428.635889, "o", "> "]
