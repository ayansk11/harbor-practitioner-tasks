[169.471997, "o", "\u001b[?2004h"]
[169.472016, "o", "> "]
[169.472207, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[169.472221, "o", "\u001b[?2004h"]
[169.472229, "o", "> "]
