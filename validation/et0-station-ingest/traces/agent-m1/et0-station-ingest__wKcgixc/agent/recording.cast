[169.474967, "o", "+\r\n\u001b[?2004l\r"]
[169.474998, "o", "\u001b[?2004h> "]
[169.475162, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
