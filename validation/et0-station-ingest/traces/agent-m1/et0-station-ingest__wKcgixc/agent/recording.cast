[250.44447, "i", "rm -f et0/ingest.py\n"]
[250.444575, "o", "rm -f et0/ingest.py\r\n\u001b[?2004l\r"]
[250.444619, "o", "\u001b[?2004h> "]
[250.768076, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\n+\n+  where ``z`` is the measurement height in metres.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day ="]
[250.768176, "i", " 86 400 J m⁻² = 0.0864 MJ m⁻²).\n+\n+These conversions make the pipeline robust for *any* station register that follows the formats described in the\n+method document.\n+\"\"\"\n+\n+import os\n+import numpy as np\n+\n+import pandas as pd\n+\n+from . import fao56\n+\n+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\n+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n+\n+\n+def _convert_wind_to_2m(wind_speed, height_m):\n+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+\n+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\n+    \"\"\"\n+    if height_m == 2.0:\n+        return wind_speed\n+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n+    return wind_speed * factor\n+\n+\n+def _convert_radiation(radiation, units):\n+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+\n+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may"]
[250.76821, "i", " be\n+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\n+    \"\"\"\n+    if units.lower().startswith(\"w\"):\n+        return radiation * 0.0864\n+    return radiation\n+\n+\n+def load_station(station, data_dir):\n+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\n+\n+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\n+    \"\"\"\n+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n+    raw = pd.read_csv(path)\n+\n+    if station.humidity not in HUMIDITY_COLUMNS:\n+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n+\n+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n+    if missing:\n+        raise ValueError(f\"{path}: missing columns {missing}\")\n+\n+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n+    df = pd.DataFrame({\n+        \"station_id\": station.station_id,\n+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n+   "]
[250.768231, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[250.76825, "i", "     \"doy\": dates.dt.dayofyear.astype(int),\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\n+        \"tmin\": raw[\"tmin_c\"].astype(float),\n+    })\n+\n+    # Actual vapour pressure (ea)\n+    if station.humidity == \"dewpoint\":\n+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n+    else:\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n+            df[\"tmax\"],\n+            df[\"tmin\"],\n+            raw[\"rh_max_pct\"].astype(float),\n+            raw[\"rh_min_pct\"].astype(float),\n+        )\n+\n+    # Wind speed conversion to 2 m height\n+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n+\n+    # Solar radiation conversion to MJ m⁻² day‑1\n+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n+\n+    return df\n+\n+EOF\n"]
[250.768299, "o", "     \"doy\": dates.dt.dayofyear.astype(int),\r\n+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n+    })\r\n+\r\n+    # Actual vapour pressure ("]
[250.768315, "o", "ea)\r\n+    if station.humidity == \"dewpoint\":\r\n+        df[\"ea\"] ="]
[250.768367, "o", " fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n+    else:\r\n+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n+            df[\"tmax\"],\r\n+            df[\"tmin\"],\r\n+            raw[\"rh_max_pct\"].astype(float),\r\n+            raw"]
[250.768397, "o", "[\"rh_min_pct\"].astype(float),\r\n+        )\r\n+\r\n+    # Wind speed conversion to 2 m height\r\n+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n+\r\n+    # "]
[250.76842, "o", "Solar radiation conversion to MJ m⁻² day‑1\r\n+   "]
[250.76844, "o", " df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n+\r\n+    return df\r\n+\r\n+EOF\r\n"]
[250.768456, "o", "\u001b[?2004h> "]
[250.768737, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
