[102.432968, "o", "\u001b[?2004h"]
[102.432985, "o", "> "]
[102.433393, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\r\n\u001b[?2004l\r"]
[102.433413, "o", "\u001b[?2004h"]
[102.43343, "o", "> "]
