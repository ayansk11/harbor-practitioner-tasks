[290.538522, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n\u001b[?2004l\r"]
[290.538542, "o", "\u001b[?2004h"]
[290.538565, "o", "> "]
[290.538805, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[290.538821, "o", "\u001b[?2004h> "]
[290.538842, "o", "+\r\n\u001b[?2004l\r"]
[290.538864, "o", "\u001b[?2004h"]
[290.538886, "o", "> "]
[290.539018, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[290.539039, "o", "\u001b[?2004h"]
[290.539057, "o", "> "]
[290.539404, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[290.539429, "o", "\u001b[?2004h"]
[290.539446, "o", "> "]
[290.539511, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[290.53953, "o", "\u001b[?2004h"]
[290.539552, "o", "> "]
[290.539879, "o", "+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[290.539898, "o", "\u001b[?2004h"]
[290.539917, "o", "> "]
[290.540139, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[290.540177, "o", "\u001b[?2004h> "]
[290.540473, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[290.54049, "o", "\u001b[?2004h"]
[290.540507, "o", "> "]
[290.540888, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used\r\n\u001b[?2004l\r"]
[290.540907, "o", "\u001b[?2004h"]
[290.540929, "o", "> "]
[290.541391, "o", "+  we convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
[290.541418, "o", "\u001b[?2004h"]
[290.541436, "o", "> "]
[290.541459, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.541477, "o", "> "]
[290.541803, "o", "+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[290.541821, "o", "\u001b[?2004h"]
[290.541838, "o", "> "]
[290.541888, "o", "+method document.\r\n\u001b[?2004l\r"]
[290.541909, "o", "\u001b[?2004h"]
[290.541929, "o", "> "]
[290.54195, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[290.541971, "o", "\u001b[?2004h> "]
[290.541993, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.542013, "o", "> "]
[290.542031, "o", "import os\r\n\u001b[?2004l\r"]
[290.542052, "o", "\u001b[?2004h"]
[290.542073, "o", "> "]
[290.542109, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[290.542128, "o", "\u001b[?2004h"]
[290.542154, "o", "> "]
[290.542206, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[290.542226, "o", "\u001b[?2004h"]
[290.542247, "o", "> "]
[290.542298, "o", "from . import fao56\r\n\u001b[?2004l\r"]
[290.542315, "o", "\u001b[?2004h"]
[290.542333, "o", "> \r\n\u001b[?2004l\r"]
[290.542355, "o", "\u001b[?2004h"]
[290.542376, "o", "> "]
[290.542562, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[290.542583, "o", "\u001b[?2004h"]
[290.542603, "o", "> "]
[290.54286, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[290.542881, "o", "\u001b[?2004h"]
[290.542901, "o", "> \r\n\u001b[?2004l\r"]
[290.542922, "o", "\u001b[?2004h> "]
[290.543061, "o", "def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[290.543081, "o", "\u001b[?2004h"]
[290.543101, "o", "> "]
[290.543355, "o", "    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[290.543374, "o", "\u001b[?2004h"]
[290.543396, "o", "> "]
[290.543703, "o", "+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[290.543724, "o", "\u001b[?2004h"]
[290.543742, "o", "> "]
[290.543766, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[290.543785, "o", "\u001b[?2004h"]
[290.543806, "o", "> "]
[290.543876, "o", "    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[290.543892, "o", "\u001b[?2004h"]
[290.543911, "o", "> "]
[290.543985, "o", "        return wind_speed\r\n\u001b[?2004l\r"]
[290.544004, "o", "\u001b[?2004h"]
[290.544025, "o", "> "]
[290.544184, "o", "    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[290.544201, "o", "\u001b[?2004h"]
[290.544218, "o", "> "]
[290.544306, "o", "    return wind_speed * factor\r\n\u001b[?2004l\r"]
[290.544325, "o", "\u001b[?2004h"]
[290.544346, "o", "> \r\n\u001b[?2004l\r"]
[290.544366, "o", "\u001b[?2004h> "]
[290.544491, "o", "def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[290.54451, "o", "\u001b[?2004h"]
[290.544531, "o", "> "]
[290.544713, "o", "    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[290.544732, "o", "\u001b[?2004h"]
[290.544754, "o", "> "]
[290.544947, "o", "+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\r\n\u001b[?2004l\r"]
[290.544964, "o", "\u001b[?2004h"]
[290.544986, "o", "> "]
[290.545004, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[290.545023, "o", "\u001b[?2004h"]
[290.545045, "o", "> "]
[290.545158, "o", "    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[290.545175, "o", "\u001b[?2004h> "]
[290.545288, "o", "        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[290.545307, "o", "\u001b[?2004h"]
[290.545329, "o", "> "]
[290.545384, "o", "    return radiation\r\n\u001b[?2004l\r"]
[290.5454, "o", "\u001b[?2004h"]
[290.545422, "o", "> \r\n\u001b[?2004l\r"]
[290.545443, "o", "\u001b[?2004h"]
[290.545463, "o", "> "]
[290.545553, "o", "def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[290.545573, "o", "\u001b[?2004h"]
[290.545593, "o", "> "]
[290.54585, "o", "    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\r\n\u001b[?2004l\r"]
[290.54587, "o", "\u001b[?2004h"]
[290.545887, "o", "> "]
[290.545907, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[290.545926, "o", "\u001b[?2004h"]
[290.545946, "o", "> "]
[290.546131, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[290.546153, "o", "\u001b[?2004h"]
[290.546175, "o", "> "]
[290.54625, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[290.546268, "o", "\u001b[?2004h"]
[290.546289, "o", "> "]
[290.54643, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[290.54645, "o", "\u001b[?2004h> "]
[290.546746, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[290.546763, "o", "\u001b[?2004h"]
[290.546785, "o", "> "]
[290.547088, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[290.547104, "o", "\u001b[?2004h> "]
[290.547172, "o", "    if missing:\r\n\u001b[?2004l\r"]
[290.547193, "o", "\u001b[?2004h> "]
[290.547395, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[290.547415, "o", "\u001b[?2004h"]
[290.547438, "o", "> "]
[290.547601, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[290.547619, "o", "\u001b[?2004h"]
[290.547641, "o", "> "]
[290.547706, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[290.547725, "o", "\u001b[?2004h"]
[290.547741, "o", "> "]
[290.547866, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[290.547885, "o", "\u001b[?2004h"]
[290.547906, "o", "> "]
[290.548043, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[290.54806, "o", "\u001b[?2004h"]
[290.548067, "o", "> "]
[290.548276, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.548413, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[290.548434, "o", "\u001b[?2004h"]
[290.548454, "o", "> "]
[290.548581, "o", "        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[290.548605, "o", "\u001b[?2004h"]
[290.548623, "o", "> "]
[290.548642, "o", "    })\r\n\u001b[?2004l\r"]
[290.548661, "o", "\u001b[?2004h> "]
[290.548782, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[290.548803, "o", "\u001b[?2004h"]
[290.548822, "o", "> "]
[290.549073, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[290.549097, "o", "\u001b[?2004h"]
[290.549117, "o", "> "]
[290.549137, "o", "    else:\r\n\u001b[?2004l\r"]
[290.549166, "o", "\u001b[?2004h> "]
[290.549332, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[290.549351, "o", "\u001b[?2004h"]
[290.54937, "o", "> "]
[290.549436, "o", "            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[290.549458, "o", "\u001b[?2004h"]
[290.549476, "o", "> "]
[290.549542, "o", "            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[290.54956, "o", "\u001b[?2004h> "]
[290.549707, "o", "            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[290.549729, "o", "\u001b[?2004h"]
[290.549748, "o", "> "]
[290.549876, "o", "            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[290.549898, "o", "\u001b[?2004h> "]
[290.549936, "o", "        )\r\n\u001b[?2004l\r"]
[290.549958, "o", "\u001b[?2004h"]
[290.549976, "o", "> "]
[290.550246, "o", "    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[290.550263, "o", "\u001b[?2004h"]
[290.550281, "o", "> "]
[290.550557, "o", "    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[290.550578, "o", "\u001b[?2004h"]
[290.550597, "o", "> "]
[290.550631, "o", "    return df\r\n\u001b[?2004l\r"]
[290.550653, "o", "\u001b[?2004h"]
[290.550672, "o", "> \r\n\u001b[?2004l\r"]
[290.550691, "o", "\u001b[?2004h> "]
[290.55071, "o", "EOF\r\n\u001b[?2004l\r"]
[290.552214, "o", "\u001b[?2004h"]
[290.552235, "o", "root@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[291.52519, "i", "sed -n '1,20p' et0/ingest.py\n"]
[291.525385, "o", "sed -n '1,20p' et0/ingest.py\r\n\u001b[?2004l\r"]
[291.526928, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n+\r\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n+\r\n+* Temperatures are already provided in °C.\r\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n+  in :pymod:`et0.fao56`.\r\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used\r\n+  we convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0"]
[291.527001, "o", ".0864 MJ m⁻²).\r\n+\r\n+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n+method document.\r\n+\"\"\"\r\n\r\nimport os\r\nimport numpy as np\r\n"]
[291.527165, "o", "\u001b[?2004hroot@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[292.030073, "i", "python - <<'PY'\nimport subprocess, sys\ncmd = ['python', '-m', 'et0.pipeline', '--stations', 'config/stations.yaml', '--data', 'data/raw', '--out', 'output/et0.csv']\nproc = subprocess.run(cmd, cwd='/app', capture_output=True, text=True)\nprint('STDOUT:')\nprint(proc.stdout)\nprint('STDERR:', file=sys.stderr)\nprint(proc.stderr, file=sys.stderr)\nprint('Return code:', proc.returncode)\nPY\n"]
[292.030204, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[292.030263, "o", "\u001b[?2004h> "]
