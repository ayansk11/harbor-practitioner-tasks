[292.031657, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[292.636948, "o", "STDOUT:\r\nVNT: 365 days, mean ET0 3.55 mm/day\r\nPAL: 365 days, mean ET0 2.88 mm/day\r\nCDB: 365 days, mean ET0 3.60 mm/day\r\nLGN: 365 days, mean ET0 4.23 mm/day\r\nRSD: 365 days, mean ET0 3.70 mm/day\r\nMRS: 365 days, mean ET0 4.01 mm/day\r\nHLT: 365 days, mean ET0 3.75 mm/day\r\nARN: 365 days, mean ET0 3.21 mm/day\r\n\r\nSTDERR:\r\n\r\nReturn code: 0\r\n"]
