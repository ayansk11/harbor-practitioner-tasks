[48.516858, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[48.516886, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
