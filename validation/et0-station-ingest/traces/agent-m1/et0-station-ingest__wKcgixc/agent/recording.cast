[269.853186, "o", "\u001b[?2004h"]
[269.853201, "o", "> "]
[269.853373, "o", "+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\"\"\"\r\n\u001b[?2004l\r"]
[269.853393, "o", "\u001b[?2004h"]
[269.853407, "o", "> "]
[269.853498, "o", "    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[269.853516, "o", "\u001b[?2004h"]
[269.85353, "o", "> "]
