[190.824204, "o", "\u001b[?2004l\r"]
[190.824223, "o", "\u001b[?2004h> "]
[190.824346, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n"]
[190.824361, "o", "\u001b[?2004l\r"]
[190.824381, "o", "\u001b[?2004h> "]
[190.824598, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[190.824621, "o", "\u001b[?2004h"]
[190.82464, "o", "> +\r\n\u001b[?2004l\r"]
[190.824659, "o", "\u001b[?2004h> "]
[190.824916, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n"]
[190.824932, "o", "\u001b[?2004l\r"]
[190.824951, "o", "\u001b[?2004h> "]
[190.824976, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[190.824996, "o", "\u001b[?2004h"]
[190.825014, "o", "> "]
[190.825071, "o", "+    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[190.825089, "o", "\u001b[?2004h"]
[190.825109, "o", "> "]
[190.825171, "o", "+        return wind_speed\r\n\u001b[?2004l\r"]
[190.825191, "o", "\u001b[?2004h"]
[190.825212, "o", "> "]
[190.825334, "o", "+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[190.825353, "o", "\u001b[?2004h"]
[190.825371, "o", "> "]
[190.825445, "o", "+    return wind_speed * factor\r\n\u001b[?2004l\r"]
[190.825464, "o", "\u001b[?2004h"]
[190.825482, "o", "> +\r\n\u001b[?2004l\r"]
[190.8255, "o", "\u001b[?2004h> "]
[190.825517, "o", "+\r\n\u001b[?2004l\r"]
[190.825534, "o", "\u001b[?2004h> "]
[190.825646, "o", "+def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[190.825665, "o", "\u001b[?2004h"]
[190.825682, "o", "> "]
[190.825838, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[190.825857, "o", "\u001b[?2004h"]
[190.825875, "o", "> +\r\n\u001b[?2004l\r"]
[190.825893, "o", "\u001b[?2004h"]
[190.82591, "o", "> "]
[190.826179, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[190.826198, "o", "\u001b[?2004h"]
[190.826215, "o", "> "]
[190.826449, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[190.826468, "o", "\u001b[?2004h"]
[190.826485, "o", "> "]
[190.826509, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[190.826527, "o", "\u001b[?2004h> "]
[190.826627, "o", "+    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[190.826648, "o", "\u001b[?2004h"]
[190.826665, "o", "> "]
[190.826746, "o", "+        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[190.826765, "o", "\u001b[?2004h"]
[190.826782, "o", "> "]
[190.826828, "o", "+    return radiation\r\n\u001b[?2004l\r"]
[190.826846, "o", "\u001b[?2004h"]
[190.826863, "o", "> +\r\n\u001b[?2004l\r"]
[190.826881, "o", "\u001b[?2004h> "]
[190.8269, "o", "+\r\n\u001b[?2004l\r"]
[190.826918, "o", "\u001b[?2004h> "]
[190.827018, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[190.827039, "o", "\u001b[?2004h"]
[190.827056, "o", "> "]
[190.827295, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[190.827319, "o", "\u001b[?2004h"]
[190.827337, "o", "> +\r\n\u001b[?2004l\r"]
[190.827354, "o", "\u001b[?2004h> "]
[190.827518, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[190.827539, "o", "\u001b[?2004h"]
[190.827556, "o", "> "]
[190.827578, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[190.827596, "o", "\u001b[?2004h> "]
[190.827759, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[190.827778, "o", "\u001b[?2004h"]
[190.827795, "o", "> "]
[190.82786, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[190.827878, "o", "\u001b[?2004h"]
