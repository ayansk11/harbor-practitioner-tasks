[11.955013, "o", "station_id,date,et0_mm_day\r\nPAL,2025-01-01,0.9\r\nPAL,2025-01-02,1.5\r\nPAL,2025-01-03,1.9\r\nPAL,2025-01-04,1.9\r\nPAL,2025-01-05,1.3\r\nPAL,2025-01-06,1.0\r\nPAL,2025-01-07,1.2\r\nPAL,2025-01-08,1.3\r\nPAL,2025-01-09,1.2\r\nPAL,2025-01-10,1.0\r\nPAL,2025-01-11,1.4\r\nPAL,2025-01-12,1.0\r\nPAL,2025-01-13,1.2\r\nPAL,2025-01-14,1.4\r\nPAL,2025-01-15,1.3\r\n"]
