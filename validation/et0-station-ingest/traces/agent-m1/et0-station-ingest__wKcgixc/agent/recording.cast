[451.180658, "o", "\u001b[?2004h> "]
[451.18068, "o", "    })\r\n\u001b[?2004l\r"]
[451.1807, "o", "\u001b[?2004h> "]
[451.180811, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[451.180831, "o", "\u001b[?2004h> "]
[451.181055, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r\u001b[?2004h"]
