[48.519649, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[48.519672, "o", "\u001b[?2004h> "]
[48.519764, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[48.519789, "o", "\u001b[?2004h"]
[48.51982, "o", "> "]
[48.520036, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[48.52006, "o", "\u001b[?2004h"]
