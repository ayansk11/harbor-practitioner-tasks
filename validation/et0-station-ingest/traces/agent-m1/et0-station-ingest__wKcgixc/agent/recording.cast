[346.63457, "o", "\u001b[?2004hroot@5a3b740a-ad1e-476c-8b83-da7653996c89:/app# "]
[346.959214, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\n+\n+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\n+measurements into the *standard* units expected by the FAO‑56 implementation:\n+\n+* Temperatures are already provided in °C.\n+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\n+  in :pymod:`et0.fao56`.\n+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\n+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\n+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\n+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\n+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400"]
[346.959322, "i", " J m⁻² = 0.0864 MJ m⁻²).\n+\n+These conversions make the pipeline robust for any station register that follows the formats described in the\n+method document.\n+\"\"\"\n\nimport os\nimport numpy as np\nimport pandas as pd\nfrom . import fao56\n\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n\ndef _convert_wind_to_2m(wind_speed, height_m):\n    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\n+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\n+    \"\"\"\n    if height_m == 2.0:\n        return wind_speed\n    factor = 4.87 / np.log(67.8 * height_m - 5.42)\n    return wind_speed * factor\n\ndef _convert_radiation(radiation, units):\n    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\n+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\n+    \"\"\"\n    if units.lower().startswith(\"w\"):\n        return radiation * 0.0864"]
[346.959369, "i", "\n    return radiation\n\ndef load_station(station, data_dir):\n    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\n+    \"\"\"\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n    raw = pd.read_csv(path)\n    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n    if missing:\n        raise ValueError(f\"{path}: missing columns {missing}\")\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n    df = pd.DataFrame({\n        \"station_id\": station.station_id,\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n        \"doy\": dates.dt.dayofyear.astype(int),\n        \"tmax\": raw[\"tmax_c\"].astype(float),\n        \"tmin\": raw[\"tmin_c\"].astype(float),\n    })\n    if station.humidity == \"dewpoint\":\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n    else:\n   "]
[346.959386, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[346.959423, "i", "     df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n            df[\"tmax\"],\n            df[\"tmin\"],\n            raw[\"rh_max_pct\"].astype(float),\n            raw[\"rh_min_pct\"].astype(float),\n        )\n    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\n    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\n    return df\n\nEOF\n"]
[346.959457, "o", "\r\n    return radiation\r\n\r\ndef load_station(station, data_dir):\r\n    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\r\n+    \"\"\"\r\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    raw = pd.read_csv(path)\r\n    if station.humidity not in HUMIDITY_COLUMNS:\r\n        raise ValueError(f\"{stat"]
[346.959488, "o", "ion.station_id}: unknown humidity type {station.humidity!r}\")\r\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n "]
[346.959523, "o", "   if missing:\r\n        raise ValueError(f\"{path}: missing columns {missing}\")\r\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    df = pd.DataFrame({\r\n        \"station_id\": station.station_id,\r\n        \""]
[346.959553, "o", "date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n        \"doy\": dates.dt.dayofyear.astype(int),\r\n        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n   "]
[346.959585, "o", "     \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    })\r\n    if station.humidity == \"dewpoint\":\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    els"]
[346.959615, "o", "e:\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n            df[\"tmax\"],\r\n "]
[346.959644, "o", "           df[\"tmin\"],\r\n            raw[\"rh_max_pct\"].astype(float),\r\n            raw[\"rh_min_pct\"].astype(float),\r\n        )\r\n    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms"]
[346.959659, "o", "\"].astype(float), station.wind_height_m)\r\n    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n    return df\r\n"]
[346.959675, "o", "\r\nEOF\r\n"]
[346.959711, "o", "\u001b[?2004h> "]
[346.96005, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[346.96009, "o", "\u001b[?2004h"]
[346.96012, "o", "> +\r\n"]
[346.960167, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[346.960429, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``. This module converts those raw\r\n\u001b[?2004l\r"]
[346.960453, "o", "\u001b[?2004h"]
[346.96048, "o", "> "]
[346.960663, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[346.96069, "o", "\u001b[?2004h> +\r\n"]
[346.960719, "o", "\u001b[?2004l\r"]
[346.960743, "o", "\u001b[?2004h> "]
[346.960834, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[346.96086, "o", "\u001b[?2004h> "]
[346.961131, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[346.961163, "o", "\u001b[?2004h"]
[346.961187, "o", "> "]
[346.961231, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[346.961253, "o", "\u001b[?2004h"]
[346.96128, "o", "> "]
[346.961537, "o", "+* Wind speed may be measured at an anemometer height other than 2 m. When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[346.961558, "o", "\u001b[?2004h"]
[346.961573, "o", "> "]
[346.961759, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[346.961791, "o", "\u001b[?2004h> "]
[346.962077, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))`` where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[346.962104, "o", "\u001b[?2004h> "]
[346.962503, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻². When the latter is used we\r\n\u001b[?2004l\r"]
[346.962532, "o", "\u001b[?2004h> "]
[346.962993, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
[346.963019, "o", "\u001b[?2004h> "]
[346.963042, "o", "+\r\n\u001b[?2004l\r"]
[346.96307, "o", "\u001b[?2004h> "]
[346.963423, "o", "+These conversions make the pipeline robust for any station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[346.963454, "o", "\u001b[?2004h> "]
[346.963498, "o", "+method document.\r\n\u001b[?2004l\r"]
[346.963521, "o", "\u001b[?2004h"]
[346.963543, "o", "> +\"\"\"\r\n\u001b[?2004l\r"]
[346.963566, "o", "\u001b[?2004h> "]
[346.963597, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.963621, "o", "import os\r\n\u001b[?2004l\r"]
[346.963646, "o", "\u001b[?2004h> "]
[346.963682, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[346.963708, "o", "\u001b[?2004h"]
[346.963732, "o", "> "]
[346.963757, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[346.963784, "o", "\u001b[?2004h"]
[346.963808, "o", "> "]
[346.963832, "o", "from . import fao56\r\n\u001b[?2004l\r"]
[346.963855, "o", "\u001b[?2004h"]
[346.963879, "o", "> \r\n\u001b[?2004l\r"]
[346.963904, "o", "\u001b[?2004h> "]
[346.964061, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[346.96409, "o", "\u001b[?2004h"]
[346.964103, "o", "> "]
[346.96432, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[346.964345, "o", "\u001b[?2004h"]
[346.964378, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[346.964401, "o", "> "]
[346.964488, "o", "def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[346.964517, "o", "\u001b[?2004h"]
[346.964541, "o", "> "]
[346.964751, "o", "    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[346.964776, "o", "\u001b[?2004h> "]
[346.965098, "o", "+    The FAO‑56 adjustment (Eq. 47) is used. If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[346.965136, "o", "\u001b[?2004h> "]
[346.965168, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[346.965195, "o", "\u001b[?2004h> "]
[346.965253, "o", "    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[346.965285, "o", "\u001b[?2004h> "]
[346.965363, "o", "        return wind_speed\r\n\u001b[?2004l\r"]
[346.965394, "o", "\u001b[?2004h> "]
[346.965542, "o", "    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[346.965573, "o", "\u001b[?2004h"]
[346.965596, "o", "> "]
[346.965645, "o", "    return wind_speed * factor\r\n\u001b[?2004l\r"]
[346.965676, "o", "\u001b[?2004h"]
[346.965699, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.9658, "o", "def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[346.965814, "o", "\u001b[?2004h"]
[346.965842, "o", "> "]
[346.965981, "o", "    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[346.966003, "o", "\u001b[?2004h"]
[346.96603, "o", "> "]
[346.966186, "o", "+    ``units`` may be \"MJ/m2/day\" or \"W/m2\" (case‑insensitive).\r\n\u001b[?2004l\r"]
[346.966211, "o", "\u001b[?2004h"]
[346.966245, "o", "> "]
[346.966268, "o", "+    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.966377, "o", "    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[346.966401, "o", "\u001b[?2004h> "]
[346.966514, "o", "        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[346.966539, "o", "\u001b[?2004h> "]
[346.966605, "o", "    return radiation\r\n\u001b[?2004l\r"]
[346.966634, "o", "\u001b[?2004h"]
[346.966657, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.966748, "o", "def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[346.966768, "o", "\u001b[?2004h"]
[346.966799, "o", "> "]
[346.966994, "o", "    \"\"\"Return a DataFrame with columns: station_id, date, doy, tmax, tmin, ea, u2, rs.\r\n\u001b[?2004l\r"]
[346.967008, "o", "\u001b[?2004h"]
[346.967041, "o", "> +    \"\"\"\r\n\u001b[?2004l\r"]
[346.967062, "o", "\u001b[?2004h"]
[346.967088, "o", "> "]
[346.967233, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[346.967243, "o", "\u001b[?2004h"]
[346.967273, "o", "> "]
[346.967325, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[346.967354, "o", "\u001b[?2004h> "]
[346.967482, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[346.967505, "o", "\u001b[?2004h"]
[346.967536, "o", "> "]
[346.967754, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[346.967786, "o", "\u001b[?2004h> "]
[346.968096, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[346.968128, "o", "\u001b[?2004h> "]
[346.968183, "o", "    if missing:\r\n\u001b[?2004l\r"]
[346.968209, "o", "\u001b[?2004h> "]
[346.968408, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[346.96844, "o", "\u001b[?2004h> "]
[346.968622, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[346.968649, "o", "\u001b[?2004h> "]
[346.968726, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[346.968748, "o", "\u001b[?2004h"]
[346.968781, "o", "> "]
[346.968887, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[346.968911, "o", "\u001b[?2004h> "]
[346.969056, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[346.969088, "o", "\u001b[?2004h> "]
[346.969234, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[346.969265, "o", "\u001b[?2004h> "]
[346.969398, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[346.969423, "o", "\u001b[?2004h> "]
[346.969569, "o", "        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[346.969596, "o", "\u001b[?2004h> "]
[346.96962, "o", "    })\r\n\u001b[?2004l\r"]
[346.969653, "o", "\u001b[?2004h> "]
[346.969774, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[346.969803, "o", "\u001b[?2004h> "]
[346.970077, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[346.970107, "o", "\u001b[?2004h> "]
[346.970147, "o", "    else:\r\n\u001b[?2004l\r"]
[346.970176, "o", "\u001b[?2004h> "]
[346.970326, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[346.970355, "o", "\u001b[?2004h"]
[346.970376, "o", "> "]
[346.970431, "o", "            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[346.970462, "o", "\u001b[?2004h> "]
[346.970535, "o", "            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[346.97056, "o", "\u001b[?2004h> "]
[346.970705, "o", "            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[346.970735, "o", "\u001b[?2004h> "]
[346.970871, "o", "            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[346.9709, "o", "\u001b[?2004h"]
[346.970923, "o", "> "]
[346.97099, "o", "        )\r\n\u001b[?2004l\r"]
[346.971014, "o", "\u001b[?2004h> "]
[346.971247, "o", "    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[346.971277, "o", "\u001b[?2004h> "]
[346.971575, "o", "    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[346.971601, "o", "\u001b[?2004h> "]
[346.971649, "o", "    return df\r\n\u001b[?2004l\r"]
[346.971682, "o", "\u001b[?2004h> "]
[346.971705, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.971728, "o", "> "]
