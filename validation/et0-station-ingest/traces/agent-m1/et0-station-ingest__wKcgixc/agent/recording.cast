[250.770674, "o", "\u001b[?2004h> "]
[250.770807, "o", "+  where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[250.770825, "o", "\u001b[?2004h"]
[250.770839, "o", "> "]
[250.771169, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\r\n\u001b[?2004l\r"]
[250.771188, "o", "\u001b[?2004h"]
[250.771204, "o", "> "]
[250.771573, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
