[32.757526, "o", "-        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[32.757568, "o", "\u001b[?2004h> "]
[32.757967, "o", "-    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[32.758005, "o", "\u001b[?2004h> "]
[32.758049, "o", "-    if missing:\r\n\u001b[?2004l\r"]
[32.758072, "o", "\u001b[?2004h"]
[32.758094, "o", "> "]
[32.758342, "o", "-        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[32.758394, "o", "\u001b[?2004h> -\r\n\u001b[?2004l\r"]
[32.758425, "o", "\u001b[?2004h> "]
[32.758652, "o", "-    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[32.758684, "o", "\u001b[?2004h> "]
[32.758783, "o", "-    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[32.758809, "o", "\u001b[?2004h> "]
[32.758947, "o", "-        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[32.758975, "o", "\u001b[?2004h> "]
[32.759174, "o", "-        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[32.759207, "o", "\u001b[?2004h> "]
[32.759398, "o", "-        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[32.759435, "o", "\u001b[?2004h> "]
[32.759614, "o", "-        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[32.759649, "o", "\u001b[?2004h> "]
[32.759833, "o", "-        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[32.75987, "o", "\u001b[?2004h> "]
[32.759891, "o", "-    })\r\n\u001b[?2004l\r"]
[32.759914, "o", "\u001b[?2004h> "]
[32.760081, "o", "-    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[32.760113, "o", "\u001b[?2004h> "]
[32.760468, "o", "-        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[32.76051, "o", "\u001b[?2004h> "]
[32.760542, "o", "-    else:\r\n\u001b[?2004l\r"]
[32.760561, "o", "\u001b[?2004h> "]
[32.761013, "o", "-        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[32.761041, "o", "\u001b[?2004h> "]
[32.76138, "o", "-                                                   raw[\"rh_min_pct\"].astype(float))\r\n\u001b[?2004l\r"]
[32.761403, "o", "\u001b[?2004h> "]
[32.76168, "o", "-    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\r\n\u001b[?2004l\r"]
[32.761699, "o", "\u001b[?2004h> "]
[32.761986, "o", "-    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\r\n\u001b[?2004l\r"]
[32.762005, "o", "\u001b[?2004h"]
[32.762021, "o", "> "]
[32.762076, "o", "-    return df\r\n\u001b[?2004l\r"]
[32.762094, "o", "\u001b[?2004h"]
[32.76211, "o", "> "]
[32.762556, "o", "+\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by ``fao56.et0_daily``.\r\n\u001b[?2004l\r"]
[32.762575, "o", "\u001b[?2004h"]
[32.762591, "o", "> "]
[32.762606, "o", "+\r\n\u001b[?2004l\r"]
[32.762621, "o", "\u001b[?2004h> "]
[32.762971, "o", "+The raw files use the column names described in ``/app/docs/METHOD.md``.  This module converts those raw\r\n\u001b[?2004l\r"]
[32.762989, "o", "\u001b[?2004h> "]
[32.763219, "o", "+measurements into the *standard* units expected by the FAO‑56 implementation:\r\n\u001b[?2004l\r"]
[32.763236, "o", "\u001b[?2004h"]
[32.763251, "o", "> +\r\n\u001b[?2004l\r"]
[32.763266, "o", "\u001b[?2004h"]
[32.763282, "o", "> "]
[32.763387, "o", "+* Temperatures are already provided in °C.\r\n\u001b[?2004l\r"]
[32.763404, "o", "\u001b[?2004h"]
[32.763419, "o", "> "]
[32.763693, "o", "+* Relative humidity or dew‑point is converted to actual vapour pressure (kPa) using the helper functions\r\n\u001b[?2004l\r"]
[32.763723, "o", "\u001b[?2004h> "]
[32.763785, "o", "+  in :pymod:`et0.fao56`.\r\n\u001b[?2004l\r"]
[32.763803, "o", "\u001b[?2004h"]
[32.763819, "o", "> "]
[32.7641, "o", "+* Wind speed may be measured at an anemometer height other than 2 m.  When ``station.wind_height_m`` differs\r\n\u001b[?2004l\r"]
[32.764117, "o", "\u001b[?2004h> "]
[32.764324, "o", "+  from 2 m, the FAO‑56 wind‑speed adjustment (Eq. 47) is applied:\r\n\u001b[?2004l\r"]
[32.764343, "o", "\u001b[?2004h> "]
[32.764358, "o", "+\r\n"]
[32.764374, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[32.764498, "o", "+  ``u2 = u_z * (4.87 / log(67.8*z - 5.42))``\r\n\u001b[?2004l\r"]
[32.764515, "o", "\u001b[?2004h"]
[32.764531, "o", "> +"]
[32.764547, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.764562, "o", "> "]
[32.764692, "o", "+  where ``z`` is the measurement height in metres.\r\n\u001b[?2004l\r"]
[32.76471, "o", "\u001b[?2004h> "]
[32.765052, "o", "+* Solar radiation can be supplied either in MJ m⁻² day⁻¹ (the standard) or in W m⁻².  When the latter is used we\r\n\u001b[?2004l\r"]
[32.765069, "o", "\u001b[?2004h"]
[32.765084, "o", "> "]
[32.76547, "o", "+  convert to MJ m⁻² day⁻¹ by multiplying by 0.0864 (1 W m⁻² sustained for a day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
[32.765487, "o", "\u001b[?2004h"]
[32.765509, "o", "> +\r\n\u001b[?2004l\r"]
[32.765529, "o", "\u001b[?2004h> "]
[32.765811, "o", "+These conversions make the pipeline robust for *any* station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[32.765832, "o", "\u001b[?2004h> "]
[32.765886, "o", "+method document.\r\n\u001b[?2004l\r"]
[32.765903, "o", "\u001b[?2004h> "]
[32.765925, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[32.765942, "o", "\u001b[?2004h"]
[32.765956, "o", "> +\r\n"]
[32.765972, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.765987, "o", "> "]
[32.766012, "o", "+import os\r\n\u001b[?2004l\r"]
[32.766032, "o", "\u001b[?2004h"]
[32.766047, "o", "> "]
[32.766092, "o", "+import numpy as np\r\n\u001b[?2004l\r"]
[32.76611, "o", "\u001b[?2004h> "]
[32.766125, "o", "+\r\n\u001b[?2004l\r"]
[32.766147, "o", "\u001b[?2004h> "]
[32.766213, "o", "+import pandas as pd\r\n\u001b[?2004l\r"]
[32.766233, "o", "\u001b[?2004h> "]
[32.766252, "o", "+\r\n\u001b[?2004l\r"]
[32.766268, "o", "\u001b[?2004h> "]
[32.766327, "o", "+from . import fao56\r\n\u001b[?2004l\r"]
[32.766342, "o", "\u001b[?2004h> "]
[32.766359, "o", "+\r\n\u001b[?2004l\r"]
[32.766374, "o", "\u001b[?2004h"]
[32.766389, "o", "> "]
[32.766557, "o", "+BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[32.766574, "o", "\u001b[?2004h"]
[32.76659, "o", "> "]
[32.766809, "o", "+HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[32.766827, "o", "\u001b[?2004h"]
[32.766847, "o", "> +\r\n\u001b[?2004l\r"]
[32.766864, "o", "\u001b[?2004h> "]
[32.766879, "o", "+\r\n"]
[32.766894, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.76691, "o", "> "]
[32.767027, "o", "+def _convert_wind_to_2m(wind_speed, height_m):\r\n\u001b[?2004l\r"]
[32.767044, "o", "\u001b[?2004h> "]
[32.767282, "o", "+    \"\"\"Convert wind speed measured at ``height_m`` to the equivalent speed at 2 m.\r\n\u001b[?2004l\r"]
[32.767295, "o", "\u001b[?2004h"]
[32.76731, "o", "> +\r\n\u001b[?2004l\r"]
[32.767325, "o", "\u001b[?2004h"]
[32.767339, "o", "> "]
[32.767587, "o", "+    The FAO‑56 adjustment (Eq. 47) is used.  If ``height_m`` is already 2 m the factor is 1.\r\n\u001b[?2004l\r"]
[32.767605, "o", "\u001b[?2004h"]
[32.76762, "o", "> "]
[32.767639, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[32.767657, "o", "\u001b[?2004h> "]
[32.76773, "o", "+    if height_m == 2.0:\r\n\u001b[?2004l\r"]
[32.767749, "o", "\u001b[?2004h"]
[32.767764, "o", "> "]
[32.767834, "o", "+        return wind_speed\r\n\u001b[?2004l\r"]
[32.76785, "o", "\u001b[?2004h"]
[32.767865, "o", "> "]
[32.768138, "o", "+    # Avoid division by zero or log of non‑positive numbers – the formula is only valid for heights > 0.\r\n\u001b[?2004l\r"]
[32.768165, "o", "\u001b[?2004h> "]
[32.768299, "o", "+    factor = 4.87 / np.log(67.8 * height_m - 5.42)\r\n\u001b[?2004l\r"]
[32.768317, "o", "\u001b[?2004h> "]
[32.768407, "o", "+    return wind_speed * factor\r\n\u001b[?2004l\r"]
[32.768424, "o", "\u001b[?2004h"]
[32.768439, "o", "> +\r\n"]
[32.768455, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.768471, "o", "> +\r\n\u001b[?2004l\r"]
[32.768488, "o", "\u001b[?2004h> "]
[32.768606, "o", "+def _convert_radiation(radiation, units):\r\n\u001b[?2004l\r"]
[32.768624, "o", "\u001b[?2004h"]
[32.768639, "o", "> "]
[32.768798, "o", "+    \"\"\"Convert raw solar radiation to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[32.768814, "o", "\u001b[?2004h> "]
[32.76883, "o", "+\r\n\u001b[?2004l\r"]
[32.768843, "o", "\u001b[?2004h"]
[32.768858, "o", "> "]
[32.769125, "o", "+    ``units`` is the string from the station register.  Accepted values are case‑insensitive and may be\r\n\u001b[?2004l\r"]
[32.76915, "o", "\u001b[?2004h"]
[32.769165, "o", "> "]
[32.7694, "o", "+    ``\"MJ/m2/day\"`` or ``\"W/m2\"`` (the latter includes possible variations like ``\"W/m^2\"``).\r\n\u001b[?2004l\r"]
[32.76942, "o", "\u001b[?2004h> "]
[32.769451, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[32.769468, "o", "\u001b[?2004h"]
[32.769483, "o", "> "]
[32.76958, "o", "+    if units.lower().startswith(\"w\"):\r\n\u001b[?2004l\r"]
[32.769598, "o", "\u001b[?2004h"]
[32.769613, "o", "> "]
[32.769896, "o", "+        # Convert from W m⁻² to MJ m⁻² day⁻¹ (1 W m⁻² = 0.0864 MJ m⁻² day⁻¹)\r\n\u001b[?2004l\r"]
[32.769913, "o", "\u001b[?2004h"]
[32.769929, "o", "> "]
[32.770013, "o", "+        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[32.770034, "o", "\u001b[?2004h"]
[32.770049, "o", "> "]
[32.770209, "o", "+    # Assume the value is already in MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[32.770229, "o", "\u001b[?2004h> "]
[32.770293, "o", "+    return radiation\r\n\u001b[?2004l\r"]
[32.770311, "o", "\u001b[?2004h> "]
[32.770329, "o", "+\r\n\u001b[?2004l\r"]
[32.770344, "o", "\u001b[?2004h"]
[32.77036, "o", "> +\r\n\u001b[?2004l\r"]
[32.770377, "o", "\u001b[?2004h> "]
[32.770482, "o", "+def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[32.770499, "o", "\u001b[?2004h"]
[32.770526, "o", "> "]
[32.770752, "o", "+    \"\"\"Return a ``DataFrame`` with the standardized columns used by the FAO‑56 calculation.\r\n\u001b[?2004l\r"]
[32.770769, "o", "\u001b[?2004h> "]
[32.770784, "o", "+\r\n\u001b[?2004l\r"]
[32.770801, "o", "\u001b[?2004h> "]
[32.770975, "o", "+    Columns: ``station_id, date, doy, tmax, tmin, ea, u2, rs``.\r\n\u001b[?2004l\r"]
[32.770993, "o", "\u001b[?2004h"]
[32.771008, "o", "> "]
[32.771028, "o", "+    \"\"\"\r\n\u001b[?2004l\r"]
[32.771045, "o", "\u001b[?2004h"]
[32.771061, "o", "> "]
[32.771225, "o", "+    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[32.771242, "o", "\u001b[?2004h> "]
[32.771328, "o", "+    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[32.771345, "o", "\u001b[?2004h> "]
[32.771361, "o", "+\r\n\u001b[?2004l\r"]
[32.771376, "o", "\u001b[?2004h"]
[32.771391, "o", "> "]
[32.771512, "o", "+    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[32.771529, "o", "\u001b[?2004h"]
[32.771544, "o", "> "]
[32.771783, "o", "+        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[32.7718, "o", "\u001b[?2004h> "]
[32.771816, "o", "+\r\n\u001b[?2004l\r"]
[32.771832, "o", "\u001b[?2004h> "]
[32.772101, "o", "+    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[32.772118, "o", "\u001b[?2004h> "]
[32.772179, "o", "+    if missing:\r\n\u001b[?2004l\r"]
[32.772196, "o", "\u001b[?2004h> "]
[32.77237, "o", "+        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[32.772388, "o", "\u001b[?2004h> "]
[32.772396, "o", "+\r\n"]
[32.772439, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[32.772581, "o", "+    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[32.772599, "o", "\u001b[?2004h> "]
[32.772675, "o", "+    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[32.772691, "o", "\u001b[?2004h> "]
[32.772809, "o", "+        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[32.772826, "o", "\u001b[?2004h"]
[32.772841, "o", "> "]
[32.772961, "o", "+        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[32.772979, "o", "\u001b[?2004h> "]
[32.773111, "o", "+        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[32.773128, "o", "\u001b[?2004h"]
[32.773147, "o", "> "]
[32.773268, "o", "+        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[32.773284, "o", "\u001b[?2004h> "]
[32.773412, "o", "+        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[32.773428, "o", "\u001b[?2004h"]
[32.773444, "o", "> "]
[32.773462, "o", "+    })\r\n\u001b[?2004l\r"]
[32.773479, "o", "\u001b[?2004h"]
[32.773494, "o", "> +\r\n"]
[32.77351, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.773525, "o", "> "]
[32.773767, "o", "+    # Actual vapour pressure (ea) – either from dew‑point or from min/max relative humidity.\r\n\u001b[?2004l\r"]
[32.773784, "o", "\u001b[?2004h"]
[32.7738, "o", "> "]
[32.773899, "o", "+    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[32.773915, "o", "\u001b[?2004h> "]
[32.774154, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[32.774174, "o", "\u001b[?2004h"]
[32.77419, "o", "> "]
[32.774213, "o", "+    else:\r\n\u001b[?2004l\r"]
[32.774233, "o", "\u001b[?2004h> "]
[32.774375, "o", "+        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[32.774392, "o", "\u001b[?2004h"]
[32.774407, "o", "> "]
[32.774467, "o", "+            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[32.774484, "o", "\u001b[?2004h> "]
[32.774557, "o", "+            df[\"tmin\"],\r\n\u001b[?2004l\r"]
[32.774575, "o", "\u001b[?2004h"]
[32.774592, "o", "> "]
[32.774701, "o", "+            raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[32.774718, "o", "\u001b[?2004h> "]
[32.774846, "o", "+            raw[\"rh_min_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[32.774876, "o", "\u001b[?2004h> "]
[32.774901, "o", "+        )\r\n\u001b[?2004l\r"]
[32.774918, "o", "\u001b[?2004h> "]
[32.774935, "o", "+\r\n\u001b[?2004l\r"]
[32.77495, "o", "\u001b[?2004h> "]
[32.77511, "o", "+    # Wind speed conversion to the standard 2 m height.\r\n\u001b[?2004l\r"]
[32.775126, "o", "\u001b[?2004h> "]
[32.775373, "o", "+    df[\"u2\"] = _convert_wind_to_2m(raw[\"wind_ms\"].astype(float), station.wind_height_m)\r\n\u001b[?2004l\r"]
[32.775388, "o", "\u001b[?2004h"]
[32.775402, "o", "> +\r\n\u001b[?2004l\r"]
[32.775418, "o", "\u001b[?2004h> "]
[32.775582, "o", "+    # Solar radiation conversion to MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[32.7756, "o", "\u001b[?2004h"]
[32.775616, "o", "> "]
[32.775854, "o", "+    df[\"rs\"] = _convert_radiation(raw[\"solar_rad\"].astype(float), station.radiation_units)\r\n\u001b[?2004l\r"]
[32.77587, "o", "\u001b[?2004h> "]
[32.775886, "o", "+\r\n\u001b[?2004l\r"]
[32.775903, "o", "\u001b[?2004h"]
[32.775918, "o", "> "]
