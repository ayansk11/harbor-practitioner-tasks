[48.515841, "o", "+These conversions make the pipeline robust for *any* station register that follows the formats described in the\r\n\u001b[?2004l\r"]
[48.515865, "o", "\u001b[?2004h> "]
[48.515918, "o", "+method document.\r\n\u001b[?2004l\r"]
[48.515941, "o", "\u001b[?2004h> "]
[48.515964, "o", "+\"\"\"\r\n\u001b[?2004l\r"]
[48.515985, "o", "\u001b[?2004h"]
[48.516005, "o", "> +\r\n\u001b[?2004l\r"]
