[428.633588, "o", "\u001b[?2004h> "]
[428.633675, "o", "        return radiation * 0.0864\r\n\u001b[?2004l\r"]
[428.633696, "o", "\u001b[?2004h"]
[428.633718, "o", "> "]
[428.633754, "o", "    return radiation\r\n\u001b[?2004l\r"]
[428.633775, "o", "\u001b[?2004h"]
[428.6338, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[428.633823, "o", "> "]
