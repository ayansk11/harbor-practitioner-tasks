[451.181097, "o", "    else:\r\n\u001b[?2004l\r"]
[451.181117, "o", "\u001b[?2004h> "]
[451.181266, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.181289, "o", "> "]
[451.181346, "o", "            df[\"tmax\"],\r\n\u001b[?2004l\r"]
[451.181365, "o", "\u001b[?2004h> "]
