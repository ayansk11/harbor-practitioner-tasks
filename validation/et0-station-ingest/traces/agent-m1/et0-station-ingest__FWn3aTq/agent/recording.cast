[58.680396, "o", "root@3deb0233-aa5a-462b-accb-d24e38e00525:/app# "]
[59.004675, "i", "python3 << 'EOF'\nimport pandas as pd\n\nref = pd.read_csv('/app/reference/metservice_et0_2025.csv')\nour = pd.read_csv('/app/output/et0.csv')\n\nfor sid in ['PAL', 'CDB']:\n    r = ref[ref.station_id == sid].set_index('date')['et0_mm_day']\n    o = our[our.station_id == sid].set_index('date')['et0_mm_day']\n    common = r.index.intersection(o.index)\n    diff = (r[common] - o[common]).abs()\n    print(f\"{sid}: n={len(common)}, max_diff={diff.max():.4f}, mean_diff={diff.mean():.4f}, within_0.03={bool((diff <= 0.03).all())}\")\nEOF\n"]
