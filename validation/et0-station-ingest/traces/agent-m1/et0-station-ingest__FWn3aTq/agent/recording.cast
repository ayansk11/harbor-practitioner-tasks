[9.957058, "o", "cat /app/et0/ingest.py\r\n"]
[9.95709, "o", "\u001b[?2004l\r"]
[9.958205, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\nimport os\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\r\n\r\ndef load_station(station, data_dir):\r\n    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    raw = pd.read_csv(path)\r\n    if station.humidity not in HUMIDITY_COLUMNS:\r\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    if missing:\r\n        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\r\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    df = pd.DataFrame({\r\n        \"station_id\": station.station_id,\r"]
[9.958216, "o", "\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n        \"doy\": dates.dt.dayofyear.astype(int),\r\n        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    })\r\n    if station.humidity == \"dewpoint\":\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    else:\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n                                                   raw[\"rh_min_pct\"].astype(float))\r\n    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\r\n    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\r\n    return df\r\n"]
[9.958405, "o", "\u001b[?2004h"]
[9.958428, "o", "root@3deb0233-aa5a-462b-accb-d24e38e00525:/app# "]
[10.286592, "i", "cat /app/et0/meta.py\n"]
[10.286727, "o", "cat /app/et0/meta.py\r\n"]
[10.286753, "o", "\u001b[?2004l\r"]
[10.287879, "o", "\"\"\"Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md).\"\"\"\r\nfrom dataclasses import dataclass\r\n\r\nimport yaml\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Station:\r\n    station_id: str\r\n    name: str\r\n    latitude: float          # decimal degrees, north positive\r\n    longitude: float\r\n    elevation_m: float\r\n    wind_height_m: float\r\n    radiation_units: str\r\n    humidity: str\r\n    network: str\r\n\r\n\r\ndef parse_latitude(value):\r\n    \"\"\"Latitude in decimal degrees.\r\n\r\n    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,\r\n    text with a hemisphere letter (\"36.95N\").\r\n    \"\"\"\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n    text = str(value).strip().upper()\r\n    return float(text.rstrip(\"NS\"))\r\n\r\n\r\ndef load_stations(path):\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        doc = yaml.safe_load(f)\r\n    stations = []\r\n    for rec in doc[\"stations\"]:\r\n        stations.append(Stati"]
[10.287922, "o", "on(\r\n            station_id=str(rec[\"id\"]),\r\n            name=str(rec.get(\"name\", \"\")),\r\n            latitude=parse_latitude(rec[\"latitude\"]),\r\n            longitude=float(rec[\"longitude\"]),\r\n            elevation_m=float(rec[\"elevation_m\"]),\r\n            wind_height_m=float(rec[\"wind_height_m\"]),\r\n            radiation_units=str(rec[\"radiation_units\"]),\r\n            humidity=str(rec[\"humidity\"]),\r\n            network=str(rec.get(\"network\", \"\")),\r\n        ))\r\n    return stations\r\n"]
[10.288099, "o", "\u001b[?2004h"]
[10.288131, "o", "root@3deb0233-aa5a-462b-accb-d24e38e00525:/app# "]
[10.615832, "i", "cat /app/et0/pipeline.py\n"]
[10.615946, "o", "cat /app/et0/pipeline.py\r\n"]
[10.616004, "o", "\u001b[?2004l\r"]
[10.617301, "o", "\"\"\"Daily ET0 for every station in a register.\r\n\r\n    python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0.csv\r\n\"\"\"\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56, ingest, meta\r\n\r\n\r\ndef run(stations_path, data_dir, out_path):\r\n    frames = []\r\n    for st in meta.load_stations(stations_path):\r\n        df = ingest.load_station(st, data_dir)\r\n        df[\"et0_mm_day\"] = fao56.et0_daily(df[\"tmax\"], df[\"tmin\"], df[\"u2\"], df[\"rs\"], df[\"ea\"], df[\"doy\"],\r\n                                           st.latitude, st.elevation_m)\r\n        frames.append(df[[\"station_id\", \"date\", \"et0_mm_day\"]])\r\n        print(f\"{st.station_id}: {len(df)} days, mean ET0 {df['et0_mm_day'].mean():.2f} mm/day\")\r\n    out = pd.concat(frames, ignore_index=True)\r\n    parent = os.path.dirname(out_path)\r\n    if parent:\r\n        os.makedirs(parent, exist_ok=True)\r\n    out.to_csv(out_path, index=False, float_format=\"%.3f\")\r\n    return out\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argpa"]
[10.617348, "o", "rse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    ap.add_argument(\"--stations\", required=True, help=\"station register (YAML)\")\r\n    ap.add_argument(\"--data\", required=True, help=\"folder with one <station_id>.csv per station\")\r\n    ap.add_argument(\"--out\", required=True, help=\"output CSV\")\r\n    args = ap.parse_args(argv)\r\n    run(args.stations, args.data, args.out)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[10.617532, "o", "\u001b[?2004hroot@3deb0233-aa5a-462b-accb-d24e38e00525:/app# "]
[10.941438, "i", "cat /app/et0/selfcheck.py\n"]
[10.941651, "o", "cat /app/et0/selfcheck.py\r\n\u001b[?2004l\r"]
[10.94268, "o", "\"\"\"Check fao56.et0_daily against the daily worked example of FAO-56 (chapter 4, Example 18).\r\n\r\n    python -m et0.selfcheck\r\n\r\nUccle (Brussels), 6 July, 50 deg 48 min N, 100 m: Tmax 21.5, Tmin 12.3 degC, RHmax 84 %, RHmin 63 %, sunshine 9.25 h,\r\nwind 2.078 m/s at 2 m (the book first converts its 10 m reading). The book's answer is ETo = 3.88 mm/day (3.9 rounded).\r\n\"\"\"\r\nimport sys\r\n\r\nfrom . import fao56\r\n\r\nBOOK_ET0 = 3.88\r\n\r\n\r\ndef main():\r\n    lat, elev, doy = 50.0 + 48.0 / 60.0, 100.0, 187\r\n    tmax, tmin, rh_max, rh_min, sunshine, u2 = 21.5, 12.3, 84.0, 63.0, 9.25, 2.078\r\n    ra, ws = fao56.extraterrestrial_radiation(lat, doy)\r\n    rs = (0.25 + 0.50 * sunshine / fao56.daylight_hours(ws)) * ra      # Angstrom formula (Eq. 35), as in the book\r\n    ea = fao56.actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min)\r\n    et0 = float(fao56.et0_daily(tmax, tmin, u2, rs, ea, doy, lat, elev))\r\n    ok = abs(et0 - BOOK_ET0) <= 0.01\r\n    print(f\"FAO-56 Example 18: Ra={float(ra):.2f} Rs={float(rs):.2f} ea={float(ea):.3f} E"]
[10.942728, "o", "T0={et0:.3f} \"\r\n          f\"(book {BOOK_ET0}) -> {'OK' if ok else 'MISMATCH'}\")\r\n    return 0 if ok else 1\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
