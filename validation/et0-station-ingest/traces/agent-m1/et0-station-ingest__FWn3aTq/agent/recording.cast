[45.221749, "i", "cat > /app/et0/meta.py << 'PYEOF'\n\"\"\"Station register: read the stations YAML into Station records (fields are described in docs/METHOD.md).\"\"\"\nfrom dataclasses import dataclass\n\nimport yaml\n\n\n@dataclass(frozen=True)\nclass Station:\n    station_id: str\n    name: str\n    latitude: float          # decimal degrees, north positive\n    longitude: float\n    elevation_m: float\n    wind_height_m: float\n    radiation_units: str\n    humidity: str\n    network: str\n\n\ndef parse_latitude(value):\n    \"\"\"Latitude in decimal degrees, north positive, south negative.\n\n    The register holds plain numbers (38.42, -31.85) and text with a\n    hemisphere letter (\"36.95N\", \"34.92S\").\n    \"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    text = str(value).strip().upper()\n    if text.endswith(\"S\"):\n        return -float(text[:-1])\n    if text.endswith(\"N\"):\n        return float(text[:-1])\n    return float(text)\n\n\ndef load_stations(path):\n    with open(path, encoding=\"utf-8\") as f:\n        doc = yaml.safe_load"]
[45.221782, "i", "(f)\n    stations = []\n    for rec in doc[\"stations\"]:\n        stations.append(Station(\n            station_id=str(rec[\"id\"]),\n            name=str(rec.get(\"name\", \"\")),\n            latitude=parse_latitude(rec[\"latitude\"]),\n            longitude=float(rec[\"longitude\"]),\n            elevation_m=float(rec[\"elevation_m\"]),\n            wind_height_m=float(rec[\"wind_height_m\"]),\n            radiation_units=str(rec[\"radiation_units\"]),\n            humidity=str(rec[\"humidity\"]),\n            network=str(rec.get(\"network\", \"\")),\n        ))\n    return stations\nPYEOF\n"]
[45.221897, "o", "cat > /app/et0/meta.py << 'PYEOF'\r\n"]
