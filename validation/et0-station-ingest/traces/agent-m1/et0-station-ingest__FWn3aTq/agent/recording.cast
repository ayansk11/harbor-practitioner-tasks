[22.725323, "o", "# Station register for the irrigation-advice ET0 run (see /app/docs/METHOD.md for every field).\r\nstations:\r\n  - id: VNT\r\n    name: Valle Norte\r\n    latitude: 38.42\r\n    longitude: -3.71\r\n    elevation_m: 85\r\n    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: rh_minmax\r\n    network: valley-agromet\r\n  - id: PAL\r\n    name: Paso Alto\r\n    latitude: \"36.95N\"\r\n    longitude: -3.02\r\n    elevation_m: 1840\r\n    wind_height_m: 10.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: rh_minmax\r\n    network: highland-synop\r\n  - id: CDB\r\n    name: Costa del Bajo\r\n    latitude: \"34.92S\"\r\n    longitude: 138.6\r\n    elevation_m: 48\r\n    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: dewpoint\r\n    network: southern-coast\r\n  - id: LGN\r\n    name: Laguna Grande\r\n    latitude: -31.85\r\n    longitude: 116.02\r\n    elevation_m: 420\r\n    wind_height_m: 3.0\r\n    radiation_units: \"W/m2\"\r\n    humidity: rh_minmax\r\n    network: southern-coast\r\n  - id: RSD\r\n    name: Ribera Seca\r\n    latitude: \"41.73N\"\r"]
