[69.90275, "i", "python - <<'PY'\nimport csv, collections\nref = {}\nwith open('reference/metservice_et0_2025.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        ref[(r['station_id'], r['date'])] = float(r['et0_mm_day'])\nwith open('/tmp/fixed-et0.csv', newline='') as f:\n    rows = list(csv.DictReader(f))\ng = collections.defaultdict(list)\nfor r in rows:\n    k = (r['station_id'], r['date'])\n    if k in ref:\n        g[r['station_id']].append(float(r['et0_mm_day']) - ref[k])\nprint('columns:', list(rows[0]), 'rows:', len(rows), 'unique:', len({(r['station_id'], r['date']) for r in rows}))\nfor sid, diffs in sorted(g.items()):\n    print(f'{sid}: n={len(diffs)} mean={sum(diffs)/len(diffs):+.3f} max_abs={max(map(abs,diffs)):.3f} within_0.03={sum(abs(x)<=0.03 for x in diffs)}/{len(diffs)}')\nPY\n"]
