[18.052751, "i", "python - <<'PY'\nimport csv\nref={}\nwith open('reference/metservice_et0_2025.csv') as f:\n    for r in csv.DictReader(f): ref[(r['station_id'],r['date'])]=float(r['et0_mm_day'])\nwith open('/tmp/current-et0.csv') as f:\n    rows=[r for r in csv.DictReader(f) if (r['station_id'],r['date']) in ref]\nprint('reference rows',len(ref),'stations',sorted({k[0] for k in ref}))\nfor r in rows:\n    ours=float(r['et0_mm_day']); expected=ref[(r['station_id'],r['date'])]\n    print(r['station_id'],r['date'],f'ours={ours:.3f}',f'ref={expected:.1f}',f'diff={ours-expected:+.3f}')\nPY\n"]
[18.052847, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
