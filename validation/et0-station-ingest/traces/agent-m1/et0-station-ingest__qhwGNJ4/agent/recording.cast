[44.246085, "o", "     1\t\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\n     2\timport os\r\n     3\t\r\n     4\timport pandas as pd\r\n     5\t\r\n     6\tfrom . import fao56\r\n     7\t\r\n     8\tBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n     9\t"]
[44.246132, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n    10\t\r\n    11\t\r\n    12\tdef load_station(station, data_dir):\r\n    13\t    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n    14\t    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    15\t    raw = pd.read_csv(path)\r\n    16\t    if station.humidity not in HUMIDITY_COLUMNS:\r\n    17\t        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    18\t    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    19\t    if missing:"]
[44.246179, "o", "\r\n    20\t        raise ValueError(f\"{path}: missing columns {missing}\")\r\n    21\t\r\n    22\t    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    23\t    df = pd.DataFrame({\r\n    24\t        \"station_id\": station.station_id,\r\n    25\t        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n    26\t        \"doy\": dates.dt.dayofyear.astype(int),\r\n    27\t        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n    28\t        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    29\t    })\r\n    30\t    if station.humidity == \"dewpoint\":\r\n    31\t        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    32\t    else:\r\n    33\t        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n    34\t                                                   raw[\"rh_min_pct\"].astype(float))\r\n    35\t    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\r\n"]
[44.246226, "o", "    36\t    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\r\n    37\t    return df\r\n"]
