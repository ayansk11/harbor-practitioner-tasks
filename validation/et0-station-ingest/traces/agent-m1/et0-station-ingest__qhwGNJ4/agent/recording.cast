[16.392286, "o", "nl -ba docs/METHOD.md | sed -n '141,300p'\r\n\u001b[?2004l\r"]
[16.394177, "o", "\u001b[?2004hroot@98254c38-6d92-484a-af3d-75f7f6376daa:/app# "]
[16.725753, "i", "for f in et0/__init__.py et0/meta.py et0/ingest.py et0/fao56.py et0/pipeline.py et0/selfcheck.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[16.726182, "o", "for f in et0/__init__.py et0/meta.py et0/ingest.py et0/fao56.py et0/pipeline.py et0/selfcheck.py; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[16.726246, "o", "===== et0/__init__.py =====\r\n"]
[16.727406, "o", "     1\t\"\"\"ET0 pipeline for the irrigation-advice service (FAO-56 Penman-Monteith, daily).\"\"\"\r\n     2\t__version__ = \"1.4.2\"\r\n"]
[16.727571, "o", "===== et0/meta.py =====\r\n"]
[16.728492, "o", "     1\t\"\"\"Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md).\"\"\"\r\n     2\tfrom dataclasses import dataclass\r\n     3\t\r\n     4\timport yaml\r\n     5\t"]
[16.728517, "o", "\r\n     6\t\r\n     7\t@dataclass(frozen=True)\r\n"]
[16.72854, "o", "     8\tclass Station:\r\n     9\t    station_id: str\r\n    10\t    name: str\r\n    11\t    latitude: float          # decimal degrees, north positive\r\n    12\t    longitude: float\r\n    13\t    elevation_m: float\r\n    14\t    wind_height_m: float\r\n    15\t    radiation_units: str\r\n    16\t    humidity: str\r\n    17\t    network: str\r\n    18\t\r\n    19"]
[16.728561, "o", "\t\r\n    20\tdef parse_latitude(value):\r\n    21\t    \"\"\"Latitude in decimal degrees.\r\n    22\t\r\n    23\t    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,\r\n    24\t    text with a hemisphere letter (\"36.95N\").\r\n    25\t    \"\"\"\r\n"]
[16.728585, "o", "    26\t    if isinstance(value, (int, float)):\r\n    27\t        return float(value)\r\n    28\t    text = str(value).strip().upper()\r\n    29\t    return float(text.rstrip(\"NS\"))\r\n    30\t\r\n    31\t\r\n    32\tdef load_stations(path):\r\n    33\t"]
[16.728613, "o", "    with open(path, encoding=\"utf-8\") as f:\r\n    34\t        doc = yaml.safe_load(f)\r\n    35\t    stations = []\r\n    36\t    for rec in doc[\"stations\"]:\r\n    37\t        stations.append(Station(\r\n    38\t            station_id=str(rec[\"id\"]),\r\n    39\t            name=str(rec.get(\"name\", \"\")),\r\n    40\t            latitude=parse_latitude(rec[\"latitude\"]),\r\n    41\t            longitude=float(rec[\"longitude\"]),\r\n"]
[16.728632, "o", "    42\t            elevation_m=float(rec[\"elevation_m\"]),\r\n    43\t            wind_height_m=float(rec[\"wind_height_m\"]),\r\n    44\t            radiation_units=str(rec[\"radiation_units\"]),\r\n    45\t            humidity=str(rec[\"humidity\"]),\r\n    46\t            network=str(rec.get(\"network\", \"\")),\r\n    47\t        ))\r\n"]
[16.728652, "o", "    48\t    return stations\r\n"]
[16.728772, "o", "===== et0/ingest.py =====\r\n"]
[16.72988, "o", "     1\t\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\n     2\timport os\r\n     3\t\r\n     4\timport pandas as pd\r\n     5\t\r\n"]
[16.729919, "o", "     6\tfrom . import fao56\r\n     7\t\r\n     8\tBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n     9\tHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n    10\t\r\n    11\t\r\n    12\tdef load_station(station, data_dir):\r\n    13\t"]
[16.729943, "o", "    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n    14\t    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    15\t    raw = pd.read_csv(path)\r\n    16\t    if station.humidity not in HUMIDITY_COLUMNS:\r\n    17\t        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    18\t    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    19\t    if missing:\r\n    20\t        raise ValueError(f\"{path}: missing columns {missing}\")\r\n    21\t\r\n    22\t    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    23\t    df = pd.DataFrame({\r\n    24\t        \"station_id\": station.station_id,\r\n    25\t        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n    26\t        \"doy\": dates.dt.dayofyear.astype(int),\r\n"]
[16.729968, "o", "    27\t        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n    28\t        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    29\t    })\r\n    30\t    if station.humidity == \"dewpoint\":\r\n    31\t        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    32\t    else:\r\n    33\t        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n    34\t                                                   raw[\"rh_min_pct\"].astype(float))\r\n    35\t    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\r\n"]
[16.729999, "o", "    36\t    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\r\n    37\t    return df\r\n"]
[16.730126, "o", "===== et0/fao56.py =====\r\n"]
[16.731109, "o", "     1\t\"\"\"FAO-56 Penman-Monteith reference evapotranspiration, daily time step.\r\n     2\t\r\n     3\tImplements the daily procedure of FAO Irrigation and Drainage Paper 56 (Allen et al., 1998), chapters 3 and 4, as\r\n"]
[16.731135, "o", "     4\twritten up in /app/docs/METHOD.md. Every function works on numpy arrays (one element per day).\r\n     5\t\r\n"]
[16.731159, "o", "     6\tInputs expected by et0_daily (already in standard form):\r\n     7\t    tmax, tmin   daily maximum and minimum air temperature [deg C]\r\n     8\t    u2           mean daily wind speed at 2 m above ground [m/s]\r\n     9\t    rs           incoming solar radiation [MJ m-2 day-1]\r\n    10\t    ea           actual vapour pressure [kPa] (see actual_vapour_pressure_*)\r\n    11\t    doy          day of the year, 1 = 1 January\r\n    12\t    latitude     decimal degrees, north positive, south negative\r\n    13\t    elevation    metres above sea level\r\n    14\t\"\"\"\r\n    15\timport numpy as np\r\n    16\t\r\n"]
[16.731186, "o", "    17\tSOLAR_CONSTANT = 0.0820        # MJ m-2 min-1\r\n    18\tSTEFAN_BOLTZMANN = 4.903e-9    # MJ K-4 m-2 day-1\r\n    19\tALBEDO = 0.23                  # hypothetical grass reference\r\n    20\t\r\n    21\t\r\n    22\tdef atmospheric_pressure(elevation):\r\n    23\t    \"\"\"Eq. 7, kPa.\"\"\"\r\n    24\t    return 101.3 * ((293.0 - 0.0065 * np.asarray(elevation, float)) / 293.0) ** 5.26\r\n    25\t\r\n"]
[16.731217, "o", "    26\t\r\n    27\tdef psychrometric_constant(pressure):\r\n    28\t    \"\"\"Eq. 8, kPa/degC.\"\"\"\r\n    29\t    return 0.665e-3 * pressure\r\n    30\t\r\n    31\t\r\n    32\tdef saturation_vapour_pressure(t):\r\n    33\t    \"\"\"Eq. 11, kPa.\"\"\"\r\n    34\t    t = np.asarray(t, float)\r\n"]
[16.731239, "o", "    35\t    return 0.6108 * np.exp(17.27 * t / (t + 237.3))\r\n    36\t\r\n    37\t\r\n    38\tdef vapour_pressure_slope(t):\r\n    39\t    \"\"\"Eq. 13, kPa/degC.\"\"\"\r\n    40\t    t = np.asarray(t, float)\r\n    41\t    return 4098.0 * saturation_vapour_pressure(t) / (t + 237.3) ** 2\r\n"]
[16.731258, "o", "    42\t\r\n    43\t\r\n    44\tdef actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min):\r\n    45\t    \"\"\"Eq. 17, kPa, from daily maximum and minimum relative humidity [%].\"\"\"\r\n    46\t    return (saturation_vapour_pressure(tmin) * np.asarray(rh_max, float) / 100.0\r\n    47\t"]
[16.731276, "o", "            + saturation_vapour_pressure(tmax) * np.asarray(rh_min, float) / 100.0) / 2.0\r\n    48\t\r\n    49\t\r\n    50\tdef actual_vapour_pressure_dewpoint(tdew):\r\n    51\t    \"\"\"Eq. 14, kPa, from the daily mean dewpoint temperature [degC].\"\"\"\r\n    52\t    return saturation_vapour_pressure(tdew)\r\n"]
[16.731296, "o", "    53\t\r\n    54\t\r\n    55\tdef extraterrestrial_radiation(latitude, doy):\r\n    56\t    \"\"\"Eqs. 21-25: Ra [MJ m-2 day-1] and the sunset hour angle ws [rad].\"\"\"\r\n    57\t    phi = np.deg2rad(np.asarray(latitude, float))\r\n    58\t    doy = np.asarray(doy, float)\r\n"]
[16.731316, "o", "    59\t    dr = 1.0 + 0.033 * np.cos(2.0 * np.pi * doy / 365.0)\r\n    60\t    decl = 0.409 * np.sin(2.0 * np.pi * doy / 365.0 - 1.39)\r\n    61\t    ws = np.arccos(np.clip(-np.tan(phi) * np.tan(decl), -1.0, 1.0))\r\n"]
[16.731341, "o", "    62\t    ra = (24.0 * 60.0 / np.pi) * SOLAR_CONSTANT * dr * (\r\n    63\t        ws * np.sin(phi) * np.sin(decl) + np.cos(phi) * np.cos(decl) * np.sin(ws))\r\n    64\t    return ra, ws\r\n    65\t\r\n    66\t\r\n    67\tdef daylight_hours(ws):\r\n    68\t    \"\"\"Eq. 34, hours.\"\"\"\r\n    69\t    return 24.0 / np.pi * ws\r\n    70\t\r\n"]
[16.731359, "o", "    71\t\r\n    72\tdef clear_sky_radiation(ra, elevation):\r\n    73\t    \"\"\"Eq. 37, MJ m-2 day-1.\"\"\"\r\n    74\t    return (0.75 + 2e-5 * np.asarray(elevation, float)) * ra\r\n    75\t\r\n    76\t\r\n    77\tdef net_longwave_radiation(tmax, tmin, ea, rs, rso):\r\n"]
[16.731378, "o", "    78\t    \"\"\"Eq. 39, MJ m-2 day-1. Rs/Rso is limited to 1.0.\"\"\"\r\n    79\t    rel = np.minimum(np.asarray(rs, float) / rso, 1.0)\r\n    80\t    tk4 = ((np.asarray(tmax, float) + 273.16) ** 4 + (np.asarray(tmin, float) + 273.16) ** 4) / 2.0\r\n    81\t    return STEFAN_BOLTZMANN * tk4 * (0.34 - 0.14 * np.sqrt(ea)) * (1.35 * rel - 0.35)\r\n    82\t\r\n    83\t\r\n"]
[16.731397, "o", "    84\tdef et0_daily(tmax, tmin, u2, rs, ea, doy, latitude, elevation):\r\n    85\t    \"\"\"Eq. 6, FAO-56 Penman-Monteith reference evapotranspiration [mm/day]; soil heat flux G = 0 (Eq. 42).\"\"\"\r\n    86\t    tmax = np.asarray(tmax, float)\r\n    87\t    tmin = np.asarray(tmin, float)\r\n    88\t    u2 = np.asarray(u2, float)\r\n"]
[16.731418, "o", "    89\t    rs = np.asarray(rs, float)\r\n    90\t    ea = np.asarray(ea, float)\r\n    91\t    tmean = (tmax + tmin) / 2.0\r\n    92\t    delta = vapour_pressure_slope(tmean)\r\n    93\t    gamma = psychrometric_constant(atmospheric_pressure(elevation))\r\n    94\t    es = (saturation_vapour_pressure(tmax) + saturation_vapour_pressure(tmin)) / 2.0\r\n    95\t    ra, _ = extraterrestrial_radiation(latitude, doy)\r\n"]
[16.731436, "o", "    96\t    rso = clear_sky_radiation(ra, elevation)\r\n    97\t    rns = (1.0 - ALBEDO) * rs\r\n    98\t    rnl = net_longwave_radiation(tmax, tmin, ea, rs, rso)\r\n    99\t    rn = rns - rnl\r\n   100\t    g = 0.0\r\n"]
[16.731456, "o", "   101\t    num = 0.408 * delta * (rn - g) + gamma * (900.0 / (tmean + 273.0)) * u2 * (es - ea)\r\n   102\t    den = delta + gamma * (1.0 + 0.34 * u2)\r\n   103\t    return num / den\r\n"]
[16.731584, "o", "===== et0/pipeline.py =====\r\n"]
[16.732728, "o", "     1\t\"\"\"Daily ET0 for every station in a register.\r\n     2\t\r\n     3\t    python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0.csv\r\n     4\t\"\"\"\r\n     5\timport argparse\r\n     6\timport os\r\n     7\timport sys\r\n     8\t\r\n     9\timport pandas as pd\r\n    10\t\r\n    11\tfrom . import fao56, ingest, meta\r\n    12\t\r\n    13\t\r\n    14\tdef run(stations_path, data_dir, out_path):\r\n    15\t    frames = []\r\n    16\t    for st in meta.load_stations(stations_path):\r\n    17\t        df = ingest.load_station(st, data_dir)\r\n    18\t        df[\"et0_mm_day\"] = fao56.et0_daily(df[\"tmax\"], df[\"tmin\"], df[\"u2\"], df[\"rs\"], df[\"ea\"], df[\"doy\"],\r\n    19\t                                           st.latitude, st.elevation_m)\r\n    20\t        frames.append(df[[\"station_id\", \"date\", \"et0_mm_day\"]])\r\n    21\t        print(f\"{st.station_id}: {len(df)} days, mean ET0 {df['et0_mm_day'].mean():.2f} mm/day\")\r\n    22\t    out = pd.concat(frames, ignore_index=True)\r\n    23\t    parent = os.path.dirname(out_path)\r\n    24\t    if p"]
[16.732759, "o", "arent:\r\n    25\t        os.makedirs(parent, exist_ok=True)\r\n    26\t    out.to_csv(out_path, index=False, float_format=\"%.3f\")\r\n    27\t    return out\r\n    28\t\r\n"]
[16.732779, "o", "    29\t\r\n    30\tdef main(argv=None):\r\n    31\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    32\t    ap.add_argument(\"--stations\", required=True, help=\"station register (YAML)\")\r\n    33\t    ap.add_argument(\"--data\", required=True, help=\"folder with one <station_id>.csv per station\")\r\n    34\t    ap.add_argument(\"--out\", required=True, help=\"output CSV\")\r\n    35\t    args = ap.parse_args(argv)\r\n    36\t    run(args.stations, args.data, args.out)\r\n    37\t    return 0"]
[16.732801, "o", "\r\n    38\t\r\n    39\t\r\n    40\tif __name__ == \"__main__\":\r\n    41\t    sys.exit(main())\r\n"]
[16.732933, "o", "===== et0/selfcheck.py =====\r\n"]
[16.733821, "o", "     1\t\"\"\"Check fao56.et0_daily against the daily worked example of FAO-56 (chapter 4, Example 18).\r\n     2\t\r\n     3\t    python -m et0.selfcheck\r\n     4\t\r\n     5\tUccle (Brussels), 6 July, 50 deg 48 min N, 100 m: Tmax 21.5, Tmin 12.3 degC, RHmax 84 %, RHmin 63 %, sunshine 9.25 h,\r\n"]
[16.733849, "o", "     6\twind 2.078 m/s at 2 m (the book first converts its 10 m reading). The book's answer is ETo = 3.88 mm/day (3.9 rounded).\r\n     7\t\"\"\"\r\n     8\timport sys\r\n"]
[16.733876, "o", "     9\t\r\n    10\tfrom . import fao56\r\n    11\t\r\n    12\tBOOK_ET0 = 3.88\r\n    13\t\r\n    14\t\r\n    15\tdef main():\r\n    16\t    lat, elev, doy = 50.0 + 48.0 / 60.0, 100.0, 187\r\n    17\t    tmax, tmin, rh_max, rh_min, sunshine, u2 = 21.5, 12.3, 84.0, 63.0, 9.25, 2.078\r\n"]
[16.733898, "o", "    18\t    ra, ws = fao56.extraterrestrial_radiation(lat, doy)\r\n    19\t    rs = (0.25 + 0.50 * sunshine / fao56.daylight_hours(ws)) * ra      # Angstrom formula (Eq. 35), as in the book\r\n    20\t    ea = fao56.actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min)\r\n    21\t    et0 = float(fao56.et0_daily(tmax, tmin, u2, rs, ea, doy, lat, elev))\r\n    22\t    ok = abs(et0 - BOOK_ET0) <= 0.01\r\n    23\t    print(f\"FAO-56 Example 18: Ra={float(ra):.2f} Rs={float(rs):.2f} ea={float(ea):.3f} ET0={et0:.3f} \"\r\n    24\t          f\"(book {BOOK_ET0}) -> {'OK' if ok else 'MISMATCH'}\")\r\n    25\t    return 0 if ok else 1\r\n    26\t\r\n    27\t\r\n"]
[16.733916, "o", "    28\tif __name__ == \"__main__\":\r\n    29\t    sys.exit(main())\r\n"]
[16.734084, "o", "\u001b[?2004h"]
