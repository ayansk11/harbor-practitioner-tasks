[49.513928, "o", "nl -ba et0/fao56.py\r\n"]
[49.513965, "o", "\u001b[?2004l\r"]
[49.515145, "o", "     1\t\"\"\"FAO-56 Penman-Monteith reference evapotranspiration, daily time step.\r\n     2\t\r\n     3\tImplements the daily procedure of FAO Irrigation and Drainage Paper 56 (Allen et al., 1998), chapters 3 and 4, as\r\n"]
[49.515172, "o", "     4\twritten up in /app/docs/METHOD.md. Every function works on numpy arrays (one element per day).\r\n     5\t\r\n     6\tInputs expected by et0_daily (already in standard form):\r\n     7\t    tmax, tmin   daily maximum and minimum air temperature [deg C]\r\n     8\t"]
[49.515201, "o", "    u2           mean daily wind speed at 2 m above ground [m/s]\r\n     9\t    rs           incoming solar radiation [MJ m-2 day-1]\r\n    10\t    ea           actual vapour pressure [kPa] (see actual_vapour_pressure_*)\r\n    11\t    doy          day of the year, 1 = 1 January\r\n    12\t    latitude     decimal degrees, north positive, south negative\r\n    13\t    elevation    metres above sea level\r\n    14\t\"\"\"\r\n    15\timport numpy as np\r\n    16"]
[49.515252, "o", "\t\r\n    17\tSOLAR_CONSTANT = 0.0820        # MJ m-2 min-1\r\n    18\tSTEFAN_BOLTZMANN = 4.903e-9    # MJ K-4 m-2 day-1\r\n    19\tALBEDO = 0.23                  # hypothetical grass reference\r\n    20\t\r\n    21\t\r\n    22\tdef atmospheric_pressure(elevation):\r\n    23\t    \"\"\"Eq. 7, kPa.\"\"\"\r\n    24\t    return 101.3 * ((293.0 - 0.0065 * np.asarray(elevation, float)) / 293.0) ** 5.26\r\n    25\t\r\n    26\t\r\n    27\tdef psychrometric_constant(pressure):\r\n    28\t    \"\"\"Eq. 8, kPa/degC.\"\"\"\r\n"]
[49.515278, "o", "    29\t    return 0.665e-3 * pressure\r\n    30\t\r\n    31\t\r\n    32\tdef saturation_vapour_pressure(t):\r\n    33\t    \"\"\"Eq. 11, kPa.\"\"\"\r\n    34\t    t = np.asarray(t, float)\r\n    35\t    return 0.6108 * np.exp(17.27 * t / (t + 237.3))\r\n    36\t\r\n    37\t\r\n    38\tdef vapour_pressure_slope(t):\r\n    39\t    \"\"\"Eq. 13, kPa/degC.\"\"\"\r\n    40\t    t = np.asarray(t, float)\r\n    41\t    return 4098.0 * saturation_vapour_pressure(t) / (t + 237.3) ** 2\r\n"]
[49.515303, "o", "    42\t\r\n    43\t\r\n    44\tdef actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min):\r\n    45\t    \"\"\"Eq. 17, kPa, from daily maximum and minimum relative humidity [%].\"\"\"\r\n    46\t    return (saturation_vapour_pressure(tmin) * np.asarray(rh_max, float) / 100.0\r\n    47\t            + saturation_vapour_pressure(tmax) * np.asarray(rh_min, float) / 100.0) / 2.0\r\n    48\t\r\n    49\t\r\n"]
[49.515327, "o", "    50\tdef actual_vapour_pressure_dewpoint(tdew):\r\n    51\t    \"\"\"Eq. 14, kPa, from the daily mean dewpoint temperature [degC].\"\"\"\r\n    52\t    return saturation_vapour_pressure(tdew)\r\n    53\t\r\n    54\t\r\n    55\tdef extraterrestrial_radiation(latitude, doy):\r\n    56\t    \"\"\"Eqs. 21-25: Ra [MJ m-2 day-1] and the sunset hour angle ws [rad].\"\"\"\r\n"]
[49.515351, "o", "    57\t    phi = np.deg2rad(np.asarray(latitude, float))\r\n    58\t    doy = np.asarray(doy, float)\r\n    59\t    dr = 1.0 + 0.033 * np.cos(2.0 * np.pi * doy / 365.0)\r\n    60\t    decl = 0.409 * np.sin(2.0 * np.pi * doy / 365.0 - 1.39)\r\n    61\t    ws = np.arccos(np.clip(-np.tan(phi) * np.tan(decl), -1.0, 1.0))\r\n    62\t    ra = (24.0 * 60.0 / np.pi) * SOLAR_CONSTANT * dr * (\r\n    63\t        ws * np.sin(phi) * np.sin(decl) + np.cos(phi) * np.cos(decl) * np.sin(ws))\r\n    64\t    return ra, ws\r\n    65"]
[49.515379, "o", "\t\r\n    66\t\r\n    67\tdef daylight_hours(ws):\r\n    68\t    \"\"\"Eq. 34, hours.\"\"\"\r\n    69\t    return 24.0 / np.pi * ws\r\n    70\t\r\n    71\t\r\n    72\tdef clear_sky_radiation(ra, elevation):\r\n    73\t    \"\"\"Eq. 37, MJ m-2 day-1.\"\"\"\r\n    74"]
[49.515401, "o", "\t    return (0.75 + 2e-5 * np.asarray(elevation, float)) * ra\r\n    75\t\r\n    76\t\r\n    77\tdef net_longwave_radiation(tmax, tmin, ea, rs, rso):\r\n    78\t    \"\"\"Eq. 39, MJ m-2 day-1. Rs/Rso is limited to 1.0.\"\"\"\r\n    79\t    rel = np.minimum(np.asarray(rs, float) / rso, 1.0)\r\n    80\t    tk4 = ((np.asarray(tmax, float) + 273.16) ** 4 + (np.asarray(tmin, float) + 273.16) ** 4) / 2.0\r\n"]
[49.515424, "o", "    81\t    return STEFAN_BOLTZMANN * tk4 * (0.34 - 0.14 * np.sqrt(ea)) * (1.35 * rel - 0.35)\r\n    82\t\r\n    83\t\r\n    84\tdef et0_daily(tmax, tmin, u2, rs, ea, doy, latitude, elevation):\r\n    85\t    \"\"\"Eq. 6, FAO-56 Penman-Monteith reference evapotranspiration [mm/day]; soil heat flux G = 0 (Eq. 42).\"\"\"\r\n    86\t    tmax = np.asarray(tmax, float)\r\n    87\t    tmin = np.asarray(tmin, float)\r\n"]
[49.51545, "o", "    88\t    u2 = np.asarray(u2, float)\r\n    89\t    rs = np.asarray(rs, float)\r\n    90\t    ea = np.asarray(ea, float)\r\n    91\t    tmean = (tmax + tmin) / 2.0\r\n    92\t    delta = vapour_pressure_slope(tmean)\r\n    93\t    gamma = psychrometric_constant(atmospheric_pressure(elevation))\r\n    94\t    es = (saturation_vapour_pressure(tmax) + saturation_vapour_pressure(tmin)) / 2.0\r\n    95\t    ra, _ = extraterrestrial_radiation(latitude, doy)\r\n"]
[49.515472, "o", "    96\t    rso = clear_sky_radiation(ra, elevation)\r\n    97\t    rns = (1.0 - ALBEDO) * rs\r\n    98\t    rnl = net_longwave_radiation(tmax, tmin, ea, rs, rso)\r\n    99\t    rn = rns - rnl\r\n   100\t    g = 0.0\r\n   101\t    num = 0.408 * delta * (rn - g) + gamma * (900.0 / (tmean + 273.0)) * u2 * (es - ea)\r\n   102\t    den = delta + gamma * (1.0 + 0.34 * u2)\r\n"]
[49.515487, "o", "   103\t    return num / den\r\n"]
[49.515699, "o", "\u001b[?2004h"]
[49.515728, "o", "root@98254c38-6d92-484a-af3d-75f7f6376daa:/app# "]
[49.829704, "i", "nl -ba et0/pipeline.py\n"]
[49.829826, "o", "nl -ba et0/pipeline.py\r\n\u001b[?2004l\r"]
[49.830842, "o", "     1\t\"\"\"Daily ET0 for every station in a register.\r\n     2\t\r\n     3\t    python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0.csv\r\n     4\t\"\"\"\r\n     5\timport argparse\r\n     6\timport os\r\n"]
[49.830878, "o", "     7\timport sys\r\n     8\t\r\n     9\timport pandas as pd\r\n    10\t\r\n"]
[49.830899, "o", "    11\tfrom . import fao56, ingest, meta\r\n    12\t\r\n    13\t\r\n    14\tdef run(stations_path, data_dir, out_path):\r\n    15\t    frames = []\r\n    16\t    for st in meta.load_stations(stations_path):\r\n    17\t        df = ingest.load_station(st, data_dir)\r\n    18\t        df[\"et0_mm_day\"] = fao56.et0_daily(df[\"tmax\"], df[\"tmin\"], df[\"u2\"], df[\"rs\"], df[\"ea\"], df[\"doy\"],\r\n    19\t                                           st.latitude, st.elevation_m)\r\n    20\t        frames.append(df[[\"station_id\", \"date\", \"et0_mm_day\"]])\r\n    21\t        print(f\"{st.station_id}: {len(df)} days, mean ET0 {df['et0_mm_day'].mean():.2f} mm/day\")\r\n    22\t    out = pd.concat(frames, ignore_index=True)\r\n    23"]
[49.830919, "o", "\t    parent = os.path.dirname(out_path)\r\n    24\t    if parent:\r\n    25\t        os.makedirs(parent, exist_ok=True)\r\n    26\t    out.to_csv(out_path, index=False, float_format=\"%.3f\")\r\n    27\t    return out\r\n    28\t\r\n    29\t\r\n    30\tdef main(argv=None):\r\n    31\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    32\t    ap.add_argument(\"--stations\", required=True, help=\"station register (YAML)\")\r\n    33\t    ap.add_argument(\"--data\", required=True, help=\"folder with one <station_id>.csv per station\")\r\n"]
[49.830935, "o", "    34\t    ap.add_argument(\"--out\", required=True, help=\"output CSV\")\r\n    35\t    args = ap.parse_args(argv)\r\n    36\t    run(args.stations, args.data, args.out)\r\n"]
[49.830951, "o", "    37\t    return 0\r\n    38\t\r\n    39\t\r\n    40\tif __name__ == \"__main__\":\r\n    41\t    sys.exit(main())\r\n"]
[49.83114, "o", "\u001b[?2004hroot@98254c38-6d92-484a-af3d-75f7f6376daa:/app# "]
[68.567131, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('et0/meta.py')\ns = p.read_text()\nold = '''    if isinstance(value, (int, float)):\n        return float(value)\n    text = str(value).strip().upper()\n    return float(text.rstrip(\"NS\"))\n'''\nnew = '''    if isinstance(value, (int, float)):\n        return float(value)\n    text = str(value).strip().upper()\n    if text.endswith(\"N\"):\n        return float(text[:-1])\n    if text.endswith(\"S\"):\n        return -float(text[:-1])\n    return float(text)\n'''\nif old not in s:\n    raise SystemExit('expected meta.py block not found')\np.write_text(s.replace(old, new))\n\np = Path('et0/ingest.py')\ns = p.read_text()\ns = s.replace('import os\\n', 'import math\\nimport os\\n')\nold = '''    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\n    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\n    return df\n'''\nnew = '''    # Eq. 47: convert the measured wind speed to the standard 2 m height.\n    if station.wind_height_m <= 0:\n        raise ValueError(f\"{station."]
[68.56725, "i", "station_id}: wind_height_m must be positive\")\n    wind_height = float(station.wind_height_m)\n    wind_factor = 4.87 / math.log(67.8 * wind_height - 5.42)\n    df[\"u2\"] = raw[\"wind_ms\"].astype(float) * wind_factor\n\n    if station.radiation_units == \"MJ/m2/day\":\n        df[\"rs\"] = raw[\"solar_rad\"].astype(float)\n    elif station.radiation_units == \"W/m2\":\n        # Daily mean irradiance to a daily total: 1 W/m2 over a day is 0.0864 MJ/m2.\n        df[\"rs\"] = raw[\"solar_rad\"].astype(float) * 0.0864\n    else:\n        raise ValueError(f\"{station.station_id}: unknown radiation units {station.radiation_units!r}\")\n    return df\n'''\nif old not in s:\n    raise SystemExit('expected ingest.py block not found')\np.write_text(s.replace(old, new))\nPY\n"]
