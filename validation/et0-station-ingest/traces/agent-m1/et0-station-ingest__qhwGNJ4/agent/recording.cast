[17.055794, "o", "echo '===== current output ====='; sed -n '1,12p' output/et0.csv; wc -l output/et0.csv; echo '===== selfcheck ====='; python -m et0.selfcheck; echo '===== pipeline current ====='; python -m et0.pipeline --stations config/stations.yaml --data data/raw --out /tmp/current-et0.csv; echo status=$?; sed -n '1,12p' /tmp/current-et0.csv\r\n\u001b[?2004l\r"]
