[8.708653, "o", "printf '\\n===== stations =====\\n'; cat config/stations.yaml; printf '\\n===== raw file samples =====\\n'; for f in data/raw/*.csv; do echo \"--- $f\"; sed -n '1,8p' \"$f\"; done; printf '\\n===== reference =====\\n'; sed -n '1,15p' reference/metservice_et0_2025.csv\r\n\u001b[?2004l\r"]
