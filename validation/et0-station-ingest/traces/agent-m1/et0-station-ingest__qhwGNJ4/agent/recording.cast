[112.864389, "o", "et0/fao56.py:4:written up in /app/docs/METHOD.md. Every function works on numpy arrays (one element per day).\r\n"]
[112.864428, "o", "et0/meta.py:1:\"\"\"Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md).\"\"\"\r\n"]
[112.865823, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\nimport math\r\nimport os\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\r\n\r\ndef load_station(station, data_dir):\r\n    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n"]
[112.865894, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    raw = pd.read_csv(path)\r\n    if station.humidity not in HUMIDITY_COLUMNS:\r\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    if missing:\r\n        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\r\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    df = pd.DataFrame({\r\n        \"station_id\": station.station_id,\r\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n        \"doy\": dates.dt.dayofyear.astype(int),\r\n        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    })\r\n    if station.humidity == \"dewpoint\":\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    else:\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n                              "]
[112.865936, "o", "                     raw[\"rh_min_pct\"].astype(float))\r\n    # Eq. 47: convert the measured wind speed to the standard 2 m height.\r\n    if station.wind_height_m <= 0:\r\n        raise ValueError(f\"{station.station_id}: wind_height_m must be positive\")\r\n    wind_height = float(station.wind_height_m)\r\n    wind_factor = 4.87 / math.log(67.8 * wind_height - 5.42)\r\n    df[\"u2\"] = raw[\"wind_ms\"].astype(float) * wind_factor\r\n\r\n    if station.radiation_units == \"MJ/m2/day\":\r\n        df[\"rs\"] = raw[\"solar_rad\"].astype(float)\r\n    elif station.radiation_units == \"W/m2\":\r\n        # Daily mean irradiance to a daily total: 1 W/m2 over a day is 0.0864 MJ/m2.\r\n        df[\"rs\"] = raw[\"solar_rad\"].astype(float) * 0.0864\r\n    else:\r\n        raise ValueError(f\"{station.station_id}: unknown radiation units {station.radiation_units!r}\")\r\n    return df\r\n"]
[112.867231, "o", "\r\n\r\ndef parse_latitude(value):\r\n    \"\"\"Latitude in decimal degrees.\r\n\r\n    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,\r\n    text with a hemisphere letter (\"36.95N\").\r\n"]
[112.867257, "o", "    \"\"\"\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n    text = str(value).strip().upper()\r\n    if text.endswith(\"N\"):\r\n"]
[112.86728, "o", "        return float(text[:-1])\r\n    if text.endswith(\"S\"):\r\n        return -float(text[:-1])\r\n    return float(text)\r\n\r\n\r\ndef load_stations(path):\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        doc = yaml.safe_load(f)\r\n    stations = []\r\n"]
[112.867301, "o", "    for rec in doc[\"stations\"]:\r\n"]
[112.867496, "o", "\u001b[?2004h"]
[112.867517, "o", "root@98254c38-6d92-484a-af3d-75f7f6376daa:/app# "]
[113.175328, "i", "python - <<'PY'\nimport csv, math, yaml\nwith open('config/stations.yaml') as f:\n    stations = yaml.safe_load(f)['stations']\n\ndef lat(v):\n    if isinstance(v, (int, float)):\n        return float(v)\n    s = str(v).strip().upper()\n    return (float(s[:-1]) if s.endswith('N') else -float(s[:-1]) if s.endswith('S') else float(s))\n\ndef e0(t):\n    return 0.6108 * math.exp(17.27 * t / (t + 237.3))\n\ndef et0(row, st):\n    lat_deg = lat(st['latitude'])\n    z = float(st['elevation_m'])\n    tmax, tmin = float(row['tmax_c']), float(row['tmin_c'])\n    tmean = (tmax + tmin) / 2\n    zw = float(st['wind_height_m'])\n    u2 = float(row['wind_ms']) * 4.87 / math.log(67.8 * zw - 5.42)\n    rs = float(row['solar_rad']) * (1.0 if st['radiation_units'] == 'MJ/m2/day' else 0.0864)\n    p = 101.3 * ((293 - 0.0065 * z) / 293) ** 5.26\n    gamma = 0.665e-3 * p\n    if st['humidity'] == 'dewpoint':\n        ea = e0(float(row['tdew_c']))\n    else:\n        ea = (e0(tmin) * float(row['rh_max_pct']) + e0(tmax) * float(row['rh_min_pct'])) / 200\n   "]
[113.175443, "i", " doy = dt.timetuple().tm_yday\n    phi = math.radians(lat_deg)\n    dr = 1 + 0.033 * math.cos(2 * math.pi * doy / 365)\n    decl = 0.409 * math.sin(2 * math.pi * doy / 365 - 1.39)\n    ws = math.acos(max(-1.0, min(1.0, -math.tan(phi) * math.tan(decl))))\n    ra = (24 * 60 / math.pi) * 0.0820 * dr * (\n        ws * math.sin(phi) * math.sin(decl) + math.cos(phi) * math.cos(decl) * math.sin(ws))\n    rso = (0.75 + 2e-5 * z) * ra\n    rel = min(rs / rso, 1.0)\n    rnl = 4.903e-9 * (((tmax + 273.16) ** 4 + (tmin + 273.16) ** 4) / 2) * (\n        0.34 - 0.14 * math.sqrt(ea)) * (1.35 * rel - 0.35)\n    rn = 0.77 * rs - rnl\n    delta = 4098 * e0(tmean) / (tmean + 237.3) ** 2\n    es = (e0(tmax) + e0(tmin)) / 2\n    return (0.408 * delta * rn + gamma * 900 / (tmean + 273) * u2 * (es - ea)) / (\n        delta + gamma * (1 + 0.34 * u2))\n\nexpected = {}\nfor st in stations:\n    sid = str(st['id'])\n    with open(f\"data/raw/{sid}.csv\", newline='') as f:\n        for row in csv.DictReader(f):\n            dt = __import__('datetime').date.fro"]
[113.175459, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[113.175508, "i", "misoformat(row['date'])\n            expected[(sid, row['date'])] = et0(row, st)\nwith open('output/et0.csv', newline='') as f:\n    got = {(r['station_id'], r['date']): float(r['et0_mm_day']) for r in csv.DictReader(f)}\nassert set(got) == set(expected), (len(got), len(expected), set(got) ^ set(expected))\ndiffs = [got[k] - expected[k] for k in expected]\nprint(f'independent comparison: rows={len(diffs)}, max_abs={max(map(abs,diffs)):.6f}')\nassert max(map(abs, diffs)) < 0.0006\n\nref = {}\nwith open('reference/metservice_et0_2025.csv', newline='') as f:\n    for r in csv.DictReader(f):\n        ref[(r['station_id'], r['date'])] = float(r['et0_mm_day'])\nrefdiffs = [got[k] - ref[k] for k in ref]\nprint(f'rounded met-service comparison: rows={len(refdiffs)}, min={min(refdiffs):+.3f}, max={max(refdiffs):+.3f}')\nassert all(-0.0500001 <= d <= 0.0500001 for d in refdiffs)\nPY\n"]
[113.175537, "o", " doy = dt.timetuple().tm_yday\r\n    phi = math.radians(lat_deg)\r\n    dr = 1 + 0.033 * math.cos(2 * math.pi * doy / 365)\r\n    decl = 0.409 * math.sin(2 * math.pi * doy / 365 - 1.39)\r\n    ws = math.acos(max(-1.0, min(1.0, -math.tan(phi) * math.tan(decl))))\r\n    ra = (24 * 60 / math.pi) * 0.0820 * dr * (\r\n        ws * math.sin(phi) * math.sin(decl) + math.cos(phi) * math.cos(decl) * math.sin(ws))\r\n    rso = (0.75 + 2e-5 * z) * ra\r\n    rel = m"]
