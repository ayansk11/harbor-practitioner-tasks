[153.081335, "i", "python - <<'PY'\nimport csv, collections\nref = {}\nwith open('reference/metservice_et0_2025.csv', newline='') as f:\n    for r in csv.DictReader(f): ref[(r['station_id'], r['date'])] = float(r['et0_mm_day'])\nrows = list(csv.DictReader(open('output/et0.csv', newline='')))\nd = {sid: [float(r['et0_mm_day']) - ref[(r['station_id'], r['date'])] for r in rows if r['station_id'] == sid] for sid in ('PAL', 'CDB')}\nassert len(rows) == 2920 and len({(r['station_id'], r['date']) for r in rows}) == 2920\nassert all(all(abs(x) <= 0.0500001 for x in diffs) for diffs in d.values())\nfor sid, diffs in d.items(): print(sid, 'reference-rounded max_abs=', round(max(map(abs, diffs)), 3))\nprint('structure and rounded-reference checks: OK')\nPY\npython -m et0.selfcheck\npython -m compileall -q et0\ngrep -RIn --exclude-dir='__pycache__' '/app' et0 || true\n"]
