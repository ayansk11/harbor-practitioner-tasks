[113.176882, "o", "> "]
[113.176905, "o", "def e0(t):\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.176928, "o", "> "]
[113.177066, "o", "    return 0.6108 * math.exp(17.27 * t / (t + 237.3))\r\n\u001b[?2004l\r"]
[113.177086, "o", "\u001b[?2004h"]
[113.177115, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[113.177139, "o", "> "]
[113.177161, "o", "def et0(row, st):\r\n\u001b[?2004l\r"]
[113.177186, "o", "\u001b[?2004h"]
[113.177208, "o", "> "]
[113.177279, "o", "    lat_deg = lat(st['latitude'])\r\n\u001b[?2004l\r"]
[113.1773, "o", "\u001b[?2004h"]
[113.177322, "o", "> "]
[113.177388, "o", "    z = float(st['elevation_m'])\r\n\u001b[?2004l\r"]
[113.177416, "o", "\u001b[?2004h> "]
[113.17757, "o", "    tmax, tmin = float(row['tmax_c']), float(row['tmin_c'])\r\n\u001b[?2004l\r"]
[113.177592, "o", "\u001b[?2004h"]
[113.177614, "o", "> "]
[113.177672, "o", "    tmean = (tmax + tmin) / 2\r\n\u001b[?2004l\r"]
[113.177694, "o", "\u001b[?2004h"]
[113.17772, "o", "> "]
[113.177792, "o", "    zw = float(st['wind_height_m'])\r\n\u001b[?2004l\r"]
[113.177814, "o", "\u001b[?2004h"]
[113.177835, "o", "> "]
[113.177998, "o", "    u2 = float(row['wind_ms']) * 4.87 / math.log(67.8 * zw - 5.42)\r\n\u001b[?2004l\r"]
[113.178023, "o", "\u001b[?2004h> "]
[113.178262, "o", "    rs = float(row['solar_rad']) * (1.0 if st['radiation_units'] == 'MJ/m2/day' else 0.0864)\r\n\u001b[?2004l\r"]
[113.178285, "o", "\u001b[?2004h> "]
[113.178426, "o", "    p = 101.3 * ((293 - 0.0065 * z) / 293) ** 5.26\r\n\u001b[?2004l\r"]
[113.178452, "o", "\u001b[?2004h> "]
[113.178516, "o", "    gamma = 0.665e-3 * p\r\n\u001b[?2004l\r"]
[113.178536, "o", "\u001b[?2004h> "]
[113.178648, "o", "    if st['humidity'] == 'dewpoint':\r\n\u001b[?2004l\r"]
[113.17867, "o", "\u001b[?2004h> "]
[113.178779, "o", "        ea = e0(float(row['tdew_c']))\r\n\u001b[?2004l\r"]
[113.178801, "o", "\u001b[?2004h"]
[113.178823, "o", "> "]
[113.178849, "o", "    else:\r\n\u001b[?2004l\r"]
[113.178864, "o", "\u001b[?2004h> "]
[113.179113, "o", "        ea = (e0(tmin) * float(row['rh_max_pct']) + e0(tmax) * float(row['rh_min_pct'])) / 200\r\n\u001b[?2004l\r"]
[113.179134, "o", "\u001b[?2004h"]
[113.179159, "o", "> "]
[113.17922, "o", "    doy = dt.timetuple().tm_yday\r\n\u001b[?2004l\r"]
[113.179243, "o", "\u001b[?2004h"]
[113.179265, "o", "> "]
[113.179329, "o", "    phi = math.radians(lat_deg)\r\n\u001b[?2004l\r"]
[113.179351, "o", "\u001b[?2004h"]
[113.179372, "o", "> "]
[113.179494, "o", "    dr = 1 + 0.033 * math.cos(2 * math.pi * doy / 365)\r\n\u001b[?2004l\r"]
[113.179515, "o", "\u001b[?2004h"]
[113.179537, "o", "> "]
[113.179671, "o", "    decl = 0.409 * math.sin(2 * math.pi * doy / 365 - 1.39)\r\n\u001b[?2004l\r"]
[113.179693, "o", "\u001b[?2004h"]
[113.179717, "o", "> "]
[113.17988, "o", "    ws = math.acos(max(-1.0, min(1.0, -math.tan(phi) * math.tan(decl))))\r\n\u001b[?2004l\r"]
[113.179901, "o", "\u001b[?2004h"]
[113.179923, "o", "> "]
[113.180031, "o", "    ra = (24 * 60 / math.pi) * 0.0820 * dr * (\r\n\u001b[?2004l\r"]
[113.180053, "o", "\u001b[?2004h"]
[113.180079, "o", "> "]
[113.180294, "o", "        ws * math.sin(phi) * math.sin(decl) + math.cos(phi) * math.cos(decl) * math.sin(ws))\r\n\u001b[?2004l\r"]
[113.180316, "o", "\u001b[?2004h"]
[113.180338, "o", "> "]
[113.180402, "o", "    rso = (0.75 + 2e-5 * z) * ra\r\n\u001b[?2004l\r"]
[113.180424, "o", "\u001b[?2004h> "]
[113.180503, "o", "    rel = min(rs / rso, 1.0)\r\n\u001b[?2004l\r"]
[113.180525, "o", "\u001b[?2004h"]
[113.180547, "o", "> "]
[113.18072, "o", "    rnl = 4.903e-9 * (((tmax + 273.16) ** 4 + (tmin + 273.16) ** 4) / 2) * (\r\n\u001b[?2004l\r"]
[113.180741, "o", "\u001b[?2004h"]
[113.180763, "o", "> "]
[113.180894, "o", "        0.34 - 0.14 * math.sqrt(ea)) * (1.35 * rel - 0.35)\r\n\u001b[?2004l\r"]
[113.180915, "o", "\u001b[?2004h"]
[113.180941, "o", "> "]
[113.180993, "o", "    rn = 0.77 * rs - rnl\r\n\u001b[?2004l\r"]
[113.181015, "o", "\u001b[?2004h> "]
[113.181146, "o", "    delta = 4098 * e0(tmean) / (tmean + 237.3) ** 2\r\n\u001b[?2004l\r"]
[113.181165, "o", "\u001b[?2004h"]
[113.181192, "o", "> "]
[113.181262, "o", "    es = (e0(tmax) + e0(tmin)) / 2\r\n\u001b[?2004l\r"]
[113.18129, "o", "\u001b[?2004h> "]
[113.1815, "o", "    return (0.408 * delta * rn + gamma * 900 / (tmean + 273) * u2 * (es - ea)) / (\r\n\u001b[?2004l\r"]
[113.181525, "o", "\u001b[?2004h> "]
[113.181627, "o", "        delta + gamma * (1 + 0.34 * u2))\r\n\u001b[?2004l\r"]
[113.181651, "o", "\u001b[?2004h> "]
[113.181678, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.181713, "o", "expected = {}\r\n\u001b[?2004l\r"]
[113.181741, "o", "\u001b[?2004h> "]
[113.181788, "o", "for st in stations:\r\n\u001b[?2004l\r"]
[113.181814, "o", "\u001b[?2004h> "]
[113.181875, "o", "    sid = str(st['id'])\r\n\u001b[?2004l\r"]
[113.181902, "o", "\u001b[?2004h> "]
[113.182044, "o", "    with open(f\"data/raw/{sid}.csv\", newline='') as f:\r\n\u001b[?2004l\r"]
[113.182069, "o", "\u001b[?2004h> "]
[113.182164, "o", "        for row in csv.DictReader(f):\r\n\u001b[?2004l\r"]
[113.182186, "o", "\u001b[?2004h"]
[113.182208, "o", "> "]
[113.182371, "o", "            dt = __import__('datetime').date.fromisoformat(row['date'])\r\n\u001b[?2004l\r"]
[113.182398, "o", "\u001b[?2004h> "]
[113.182539, "o", "            expected[(sid, row['date'])] = et0(row, st)\r\n\u001b[?2004l\r"]
[113.182559, "o", "\u001b[?2004h"]
[113.182591, "o", "> "]
[113.182678, "o", "with open('output/et0.csv', newline='') as f:\r\n\u001b[?2004l\r"]
[113.1827, "o", "\u001b[?2004h"]
[113.182722, "o", "> "]
[113.182937, "o", "    got = {(r['station_id'], r['date']): float(r['et0_mm_day']) for r in csv.DictReader(f)}\r\n\u001b[?2004l\r"]
[113.182959, "o", "\u001b[?2004h"]
[113.182986, "o", "> "]
[113.183187, "o", "assert set(got) == set(expected), (len(got), len(expected), set(got) ^ set(expected))\r\n\u001b[?2004l\r"]
[113.183209, "o", "\u001b[?2004h"]
[113.18323, "o", "> "]
[113.183334, "o", "diffs = [got[k] - expected[k] for k in expected]\r\n\u001b[?2004l\r"]
[113.183355, "o", "\u001b[?2004h"]
[113.183382, "o", "> "]
[113.183581, "o", "print(f'independent comparison: rows={len(diffs)}, max_abs={max(map(abs,diffs)):.6f}')\r\n\u001b[?2004l\r"]
[113.183603, "o", "\u001b[?2004h"]
[113.183625, "o", "> "]
[113.183701, "o", "assert max(map(abs, diffs)) < 0.0006\r\n\u001b[?2004l\r"]
[113.183722, "o", "\u001b[?2004h"]
[113.183743, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[113.183765, "o", "> "]
[113.183787, "o", "ref = {}\r\n\u001b[?2004l\r"]
[113.183808, "o", "\u001b[?2004h> "]
[113.183964, "o", "with open('reference/metservice_et0_2025.csv', newline='') as f:\r\n\u001b[?2004l\r"]
[113.183997, "o", "\u001b[?2004h"]
[113.184021, "o", "> "]
[113.184079, "o", "    for r in csv.DictReader(f):\r\n\u001b[?2004l\r"]
[113.184101, "o", "\u001b[?2004h"]
[113.184122, "o", "> "]
[113.184273, "o", "        ref[(r['station_id'], r['date'])] = float(r['et0_mm_day'])\r\n\u001b[?2004l\r"]
[113.184294, "o", "\u001b[?2004h"]
[113.184319, "o", "> "]
[113.184403, "o", "refdiffs = [got[k] - ref[k] for k in ref]\r\n\u001b[?2004l\r"]
[113.184424, "o", "\u001b[?2004h"]
[113.184449, "o", "> "]
[113.184724, "o", "print(f'rounded met-service comparison: rows={len(refdiffs)}, min={min(refdiffs):+.3f}, max={max(refdiffs):+.3f}')\r\n\u001b[?2004l\r"]
[113.184747, "o", "\u001b[?2004h"]
[113.184771, "o", "> "]
[113.184905, "o", "assert all(-0.0500001 <= d <= 0.0500001 for d in refdiffs)\r\n\u001b[?2004l\r"]
[113.184928, "o", "\u001b[?2004h"]
[113.184951, "o", "> PY\r\n\u001b[?2004l\r"]
[113.239402, "o", "independent comparison: rows=2920, max_abs=0.000500\r\n"]
[113.240689, "o", "rounded met-service comparison: rows=730, min=-0.050, max=+0.050\r\n"]
[113.244742, "o", "\u001b[?2004h"]
