[26.223705, "i", "sed -n '60,220p' docs/METHOD.md\n"]
[26.223841, "o", "sed -n '60,220p' docs/METHOD.md\r\n"]
[26.223866, "o", "\u001b[?2004l\r"]
[26.225173, "o", "## 3. Station register and raw files\r\n\r\n### 3.1 The register (`config/stations.yaml`)\r\nA YAML file with a list `stations`. Every station has every key below; there are no other forms than the ones listed.\r\n\r\n| Key | What it holds |\r\n"]
[26.225214, "o", "|---|---|\r\n| `id` | station code; the raw file is `<data folder>/<id>.csv` |\r\n| `name`, `network` | free text, not used in the calculation |\r\n| `latitude` | see 3.2 |\r\n| `longitude` | decimal degrees, east positive; not used by the daily method |\r\n| `elevation_m` | elevation above sea level in metres (z in Eqs. 7 and 37) |\r\n"]
[26.22524, "o", "| `wind_height_m` | height of the anemometer above ground in metres; see 3.3 |\r\n| `radiation_units` | unit of the `solar_rad` column; see 3.4 |\r\n| `humidity` | which humidity columns the raw file has; see 3.5 |\r\n\r\n### 3.2 Latitude\r\nTwo forms are used:\r\n- a number: signed decimal degrees, north positive, south negative (`38.42`, `-31.85`);\r\n- text: unsigned decimal degrees followed directly by the hemisphere letter `N` or `S` (`\"36.95N\"`, `\"34.92S\"`).\r\n  `\"34.92S\"` is the same place as `-34.92`.\r\n\r\n### 3.3 Wind sensor height\r\n`wind_ms` is the mean daily wind speed at the anemometer, which may be at any height (any positive value of\r\n`wind_height_m` between 1 m and 20 m; 2, 3 and 10 m are the most common). The equations need u2, the speed at 2 m.\r\nConvert with the logarithmic wind profile (Eq. 47), for every station:\r\n\r\n    u2 = uz * 4.87 / ln(67.8 z_w - 5.42)\r\n\r\nwhere uz is the measured speed and z_w the anemometer height in metres. At 10 m the factor is about 0.748; at 2 m it is\r\n1.000 (to three decimals).\r\n\r"]
[26.225258, "o", "\n### 3.4 Radiation units\r\n- `MJ/m2/day`: daily total incoming solar radiation, already Rs.\r\n- `W/m2`: daily mean solar irradiance. Multiply by 0.0864 to get Rs in MJ m-2 day-1 (1 W m-2 sustained for a day is\r\n  86 400 J m-2 = 0.0864 MJ m-2).\r\n\r\n### 3.5 Humidity\r\n- `rh_minmax`: columns `rh_max_pct` and `rh_min_pct` (daily maximum and minimum relative humidity, %); use Eq. 17.\r\n- `dewpoint`: column `tdew_c` (daily mean dewpoint temperature, deg C); use Eq. 14.\r\n\r\n"]
[26.225275, "o", "### 3.6 Raw daily files (`<data folder>/<id>.csv`)\r\nOne row per day, no gaps and no missing values. Columns: `date` (YYYY-MM-DD), `tmax_c`, `tmin_c`, the humidity\r\ncolumn(s) of 3.5, `wind_ms` (m/s at the anemometer height), `solar_rad` (in the station's `radiation_units`).\r\n\r\n## 4. Output\r\nCSV with a header row and the columns `station_id`, `date` (YYYY-MM-DD) and `et0_mm_day`: one row for every station\r\nand every day in the input. The pipeline writes three decimals.\r\n"]
[26.225489, "o", "\u001b[?2004h"]
[26.225513, "o", "root@98254c38-6d92-484a-af3d-75f7f6376daa:/app# "]
[26.562213, "i", "echo '===== meta.py ====='; cat et0/meta.py; echo '===== ingest.py ====='; cat et0/ingest.py\n"]
[26.562583, "o", "echo '===== meta.py ====='; cat et0/meta.py; echo '===== ingest.py ====='; cat et0/ingest.py\r\n"]
[26.562614, "o", "\u001b[?2004l\r"]
[26.562662, "o", "===== meta.py =====\r\n"]
[26.563808, "o", "\"\"\"Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md).\"\"\"\r\nfrom dataclasses import dataclass\r\n\r\nimport yaml\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Station:\r\n    station_id: str\r\n    name: str\r\n    latitude: float          # decimal degrees, north positive\r\n    longitude: float\r\n    elevation_m: float\r\n    wind_height_m: float\r\n    radiation_units: str\r\n    humidity: str\r\n    network: str\r\n\r\n\r\ndef parse_latitude(value):\r\n    \"\"\"Latitude in decimal degrees.\r\n\r\n    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,\r\n    text with a hemisphere letter (\"36.95N\").\r\n    \"\"\"\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n    text = str(value).strip().upper()\r\n    return float(text.rstrip(\"NS\"))\r\n\r\n\r\ndef load_stations(path):\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        doc = yaml.safe_load(f)\r\n    stations = []\r\n    for rec in doc[\"stations\"]:\r\n        stations.append(Stati"]
[26.56385, "o", "on(\r\n            station_id=str(rec[\"id\"]),\r\n            name=str(rec.get(\"name\", \"\")),\r\n            latitude=parse_latitude(rec[\"latitude\"]),\r\n            longitude=float(rec[\"longitude\"]),\r\n            elevation_m=float(rec[\"elevation_m\"]),\r\n            wind_height_m=float(rec[\"wind_height_m\"]),\r\n            radiation_units=str(rec[\"radiation_units\"]),\r\n            humidity=str(rec[\"humidity\"]),\r\n            network=str(rec.get(\"network\", \"\")),\r\n        ))\r\n    return stations\r\n"]
[26.563989, "o", "===== ingest.py =====\r\n"]
[26.564938, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\nimport os\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\r\n\r\ndef load_station(station, data_dir):\r\n    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    raw = pd.read_csv(path)\r\n    if station.humidity not in HUMIDITY_COLUMNS:\r\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    if missing:\r\n        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\r\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    df = pd.DataFrame({\r\n        \"station_id\": station.station_id,\r"]
[26.564968, "o", "\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n        \"doy\": dates.dt.dayofyear.astype(int),\r\n        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    })\r\n    if station.humidity == \"dewpoint\":\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    else:\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n                                                   raw[\"rh_min_pct\"].astype(float))\r\n    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\r\n    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\r\n    return df\r\n"]
[26.565165, "o", "\u001b[?2004h"]
[26.56518, "o", "root@98254c38-6d92-484a-af3d-75f7f6376daa:/app# "]
[26.891159, "i", "echo '===== fao56.py ====='; cat et0/fao56.py; echo '===== pipeline.py ====='; cat et0/pipeline.py\n"]
[26.891605, "o", "echo '===== fao56.py ====='; cat et0/fao56.py; echo '===== pipeline.py ====='; cat et0/pipeline.py\r\n\u001b[?2004l\r"]
[26.891683, "o", "===== fao56.py =====\r\n"]
[26.892767, "o", "\"\"\"FAO-56 Penman-Monteith reference evapotranspiration, daily time step.\r\n\r\nImplements the daily procedure of FAO Irrigation and Drainage Paper 56 (Allen et al., 1998), chapters 3 and 4, as\r\nwritten up in /app/docs/METHOD.md. Every function works on numpy arrays (one element per day).\r\n\r\nInputs expected by et0_daily (already in standard form):\r\n    tmax, tmin   daily maximum and minimum air temperature [deg C]\r\n    u2           mean daily wind speed at 2 m above ground [m/s]\r\n    rs           incoming solar radiation [MJ m-2 day-1]\r\n    ea           actual vapour pressure [kPa] (see actual_vapour_pressure_*)\r\n    doy          day of the year, 1 = 1 January\r\n    latitude     decimal degrees, north positive, south negative\r\n    elevation    metres above sea level\r\n\"\"\"\r\nimport numpy as np\r\n\r\nSOLAR_CONSTANT = 0.0820        # MJ m-2 min-1\r\nSTEFAN_BOLTZMANN = 4.903e-9    # MJ K-4 m-2 day-1\r\nALBEDO = 0.23                  # hypothetical grass reference\r\n\r\n\r\ndef atmospheric_pressure(elevation):\r\n    \"\"\"Eq. 7, kPa.\"\"\""]
[26.892803, "o", "\r\n    return 101.3 * ((293.0 - 0.0065 * np.asarray(elevation, float)) / 293.0) ** 5.26\r\n\r\n\r\ndef psychrometric_constant(pressure):\r\n    \"\"\"Eq. 8, kPa/degC.\"\"\"\r\n    return 0.665e-3 * pressure\r\n\r\n\r\ndef saturation_vapour_pressure(t):\r\n    \"\"\"Eq. 11, kPa.\"\"\"\r\n    t = np.asarray(t, float)\r\n    return 0.6108 * np.exp(17.27 * t / (t + 237.3))\r\n\r\n\r\ndef vapour_pressure_slope(t):\r\n    \"\"\"Eq. 13, kPa/degC.\"\"\"\r\n    t = np.asarray(t, float)\r\n    return 4098.0 * saturation_vapour_pressure(t) / (t + 237.3) ** 2\r\n\r\n\r\ndef actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min):\r\n    \"\"\"Eq. 17, kPa, from daily maximum and minimum relative humidity [%].\"\"\"\r\n    return (saturation_vapour_pressure(tmin) * np.asarray(rh_max, float) / 100.0\r\n            + saturation_vapour_pressure(tmax) * np.asarray(rh_min, float) / 100.0) / 2.0\r\n\r\n\r\ndef actual_vapour_pressure_dewpoint(tdew):\r\n    \"\"\"Eq. 14, kPa, from the daily mean dewpoint temperature [degC].\"\"\"\r\n    return saturation_vapour_pressure(tdew)\r\n\r\n\r\ndef extraterrestrial_radiation(latitu"]
[26.892834, "o", "de, doy):\r\n    \"\"\"Eqs. 21-25: Ra [MJ m-2 day-1] and the sunset hour angle ws [rad].\"\"\"\r\n    phi = np.deg2rad(np.asarray(latitude, float))\r\n    doy = np.asarray(doy, float)\r\n    dr = 1.0 + 0.033 * np.cos(2.0 * np.pi * doy / 365.0)\r\n    decl = 0.409 * np.sin(2.0 * np.pi * doy / 365.0 - 1.39)\r\n    ws = np.arccos(np.clip(-np.tan(phi) * np.tan(decl), -1.0, 1.0))\r\n    ra = (24.0 * 60.0 / np.pi) * SOLAR_CONSTANT * dr * (\r\n        ws * np.sin(phi) * np.sin(decl) + np.cos(phi) * np.cos(decl) * np.sin(ws))\r\n    return ra, ws\r\n\r\n\r\ndef daylight_hours(ws):\r\n    \"\"\"Eq. 34, hours.\"\"\"\r\n    return 24.0 / np.pi * ws\r\n\r\n\r\ndef clear_sky_radiation(ra, elevation):\r\n    \"\"\"Eq. 37, MJ m-2 day-1.\"\"\"\r\n    return (0.75 + 2e-5 * np.asarray(elevation, float)) * ra\r\n\r\n\r\ndef net_longwave_radiation(tmax, tmin, ea, rs, rso):\r\n    \"\"\"Eq. 39, MJ m-2 day-1. Rs/Rso is limited to 1.0.\"\"\"\r\n    rel = np.minimum(np.asarray(rs, float) / rso, 1.0)\r\n    tk4 = ((np.asarray(tmax, float) + 273.16) ** 4 + (np.asarray(tmin, float) + 273.16) ** 4) / 2.0\r\n   "]
[26.892861, "o", " return STEFAN_BOLTZMANN * tk4 * (0.34 - 0.14 * np.sqrt(ea)) * (1.35 * rel - 0.35)\r\n\r\n\r\ndef et0_daily(tmax, tmin, u2, rs, ea, doy, latitude, elevation):\r\n    \"\"\"Eq. 6, FAO-56 Penman-Monteith reference evapotranspiration [mm/day]; soil heat flux G = 0 (Eq. 42).\"\"\"\r\n    tmax = np.asarray(tmax, float)\r\n    tmin = np.asarray(tmin, float)\r\n    u2 = np.asarray(u2, float)\r\n    rs = np.asarray(rs, float)\r\n    ea = np.asarray(ea, float)\r\n    tmean = (tmax + tmin) / 2.0\r\n    delta = vapour_pressure_slope(tmean)\r\n    gamma = psychrometric_constant(atmospheric_pressure(elevation))\r\n    es = (saturation_vapour_pressure(tmax) + saturation_vapour_pressure(tmin)) / 2.0\r\n    ra, _ = extraterrestrial_radiation(latitude, doy)\r\n    rso = clear_sky_radiation(ra, elevation)\r\n    rns = (1.0 - ALBEDO) * rs\r\n    rnl = net_longwave_radiation(tmax, tmin, ea, rs, rso)\r\n    rn = rns - rnl\r\n    g = 0.0\r\n    num = 0.408 * delta * (rn - g) + gamma * (900.0 / (tmean + 273.0)) * u2 * (es - ea)\r\n    den = delta + gamma * (1.0 + 0.34 * u2)\r\n   "]
[26.892885, "o", " return num / den\r\n"]
[26.893022, "o", "===== pipeline.py =====\r\n"]
[26.89391, "o", "\"\"\"Daily ET0 for every station in a register.\r\n\r\n    python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0.csv\r\n\"\"\"\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56, ingest, meta\r\n\r\n\r\ndef run(stations_path, data_dir, out_path):\r\n    frames = []\r\n    for st in meta.load_stations(stations_path):\r\n        df = ingest.load_station(st, data_dir)\r\n        df[\"et0_mm_day\"] = fao56.et0_daily(df[\"tmax\"], df[\"tmin\"], df[\"u2\"], df[\"rs\"], df[\"ea\"], df[\"doy\"],\r\n                                           st.latitude, st.elevation_m)\r\n        frames.append(df[[\"station_id\", \"date\", \"et0_mm_day\"]])\r\n        print(f\"{st.station_id}: {len(df)} days, mean ET0 {df['et0_mm_day'].mean():.2f} mm/day\")\r\n"]
[26.893936, "o", "    out = pd.concat(frames, ignore_index=True)\r\n    parent = os.path.dirname(out_path)\r\n    if parent:\r\n        os.makedirs(parent, exist_ok=True)\r\n    out.to_csv(out_path, index=False, float_format=\"%.3f\")\r\n    return out\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    ap.add_argument(\"--stations\", required=True, help=\"station register (YAML)\")\r\n    ap.add_argument(\"--data\", required=True, help=\"folder with one <station_id>.csv per station\")\r\n    ap.add_argument(\"--out\", required=True, help=\"output CSV\")\r\n    args = ap.parse_args(argv)\r\n    run(args.stations, args.data, args.out)\r\n    return 0\r\n"]
[26.893974, "o", "\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[26.89413, "o", "\u001b[?2004h"]
[26.894152, "o", "root@98254c38-6d92-484a-af3d-75f7f6376daa:/app# "]
[27.225166, "i", "python - <<'PY'\nimport csv, collections, math\nref={}\nwith open('reference/metservice_et0_2025.csv', newline='') as f:\n    for r in csv.DictReader(f): ref[(r['station_id'],r['date'])]=float(r['et0_mm_day'])\nwith open('/tmp/current-et0.csv', newline='') as f:\n    rows=list(csv.DictReader(f))\nprint('current columns:', list(rows[0]) if rows else None)\nprint('current rows:', len(rows), 'unique station/day:', len({(r.get('station_id'),r.get('date')) for r in rows}))\ng=collections.defaultdict(list)\nfor r in rows:\n    k=(r['station_id'],r['date'])\n    if k in ref: g[r['station_id']].append(float(r['et0_mm_day'])-ref[k])\nfor sid in sorted(g):\n    d=g[sid]\n    print(f'{sid}: n={len(d)} mean_diff={sum(d)/len(d):+.3f} max_abs={max(map(abs,d)):.3f} within_0.03={sum(abs(x)<=0.03 for x in d)}/{len(d)}')\nPY\n"]
