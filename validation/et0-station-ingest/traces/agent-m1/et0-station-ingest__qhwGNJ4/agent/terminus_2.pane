    16	
    17	SOLAR_CONSTANT = 0.0820        # MJ m-2 min-1
    18	STEFAN_BOLTZMANN = 4.903e-9    # MJ K-4 m-2 day-1
    19	ALBEDO = 0.23                  # hypothetical grass reference
    20	
    21	
    22	def atmospheric_pressure(elevation):
    23	    """Eq. 7, kPa."""
    24	    return 101.3 * ((293.0 - 0.0065 * np.asarray(elevation, float)) / 293.0) ** 5.26
    25	
    26	
    27	def psychrometric_constant(pressure):
    28	    """Eq. 8, kPa/degC."""
    29	    return 0.665e-3 * pressure
    30	
