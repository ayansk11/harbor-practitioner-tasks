[?2004l[?2004hroot@98254c38-6d92-484a-af3d-75f7f6376daa:/app# for f in et0/__init__.py et0/meta.py et0/ingest.py et0/fao56.py et0/pipeline.py et0/selfcheck.py; do echo "===== $f ====="; nl -ba "$f"; done
[?2004l===== et0/__init__.py =====
     1	"""ET0 pipeline for the irrigation-advice service (FAO-56 Penman-Monteith, daily)."""
     2	__version__ = "1.4.2"
===== et0/meta.py =====
     1	"""Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md)."""
     2	from dataclasses import dataclass
     3	
     4	import yaml
     5	
     6	
     7	@dataclass(frozen=True)
     8	class Station:
     9	    station_id: str
    10	    name: str
    11	    latitude: float          # decimal degrees, north positive
    12	    longitude: float
    13	    elevation_m: float
    14	    wind_height_m: float
    15	    radiation_units: str
    16	    humidity: str
    17	    network: str
    18	
    19	
    20	def parse_latitude(value):
    21	    """Latitude in decimal degrees.
    22	
    23	    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,
    24	    text with a hemisphere letter ("36.95N").
    25	    """
    26	    if isinstance(value, (int, float)):
    27	        return float(value)
    28	    text = str(value).strip().upper()
    29	    return float(text.rstrip("NS"))
    30	
    31	
    32	def load_stations(path):
    33	    with open(path, encoding="utf-8") as f:
    34	        doc = yaml.safe_load(f)
    35	    stations = []
    36	    for rec in doc["stations"]:
    37	        stations.append(Station(
    38	            station_id=str(rec["id"]),
    39	            name=str(rec.get("name", "")),
    40	            latitude=parse_latitude(rec["latitude"]),
    41	            longitude=float(rec["longitude"]),
    42	            elevation_m=float(rec["elevation_m"]),
    43	            wind_height_m=float(rec["wind_height_m"]),
    44	            radiation_units=str(rec["radiation_units"]),
    45	            humidity=str(rec["humidity"]),
    46	            network=str(rec.get("network", "")),
    47	        ))
    48	    return stations
===== et0/ingest.py =====
     1	"""Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily."""
     2	import os
     3	
     4	import pandas as pd
     5	
     6	from . import fao56
     7	
     8	BASE_COLUMNS = ["date", "tmax_c", "tmin_c", "wind_ms", "solar_rad"]
     9	HUMIDITY_COLUMNS = {"rh_minmax": ["rh_max_pct", "rh_min_pct"], "dewpoint": ["tdew_c"]}
    10	
    11	
    12	def load_station(station, data_dir):
    13	    """Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units)."""
    14	    path = os.path.join(data_dir, f"{station.station_id}.csv")
    15	    raw = pd.read_csv(path)
    16	    if station.humidity not in HUMIDITY_COLUMNS:
    17	        raise ValueError(f"{station.station_id}: unknown humidity type {station.humidity!r}")
    18	    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]
    19	    if missing:
    20	        raise ValueError(f"{path}: missing columns {missing}")
    21	
    22	    dates = pd.to_datetime(raw["date"], format="%Y-%m-%d")
    23	    df = pd.DataFrame({
    24	        "station_id": station.station_id,
    25	        "date": dates.dt.strftime("%Y-%m-%d"),
    26	        "doy": dates.dt.dayofyear.astype(int),
    27	        "tmax": raw["tmax_c"].astype(float),
    28	        "tmin": raw["tmin_c"].astype(float),
    29	    })
    30	    if station.humidity == "dewpoint":
    31	        df["ea"] = fao56.actual_vapour_pressure_dewpoint(raw["tdew_c"].astype(float))
    32	    else:
    33	        df["ea"] = fao56.actual_vapour_pressure_rh(df["tmax"], df["tmin"], raw["rh_max_pct"].astype(float),
    34	                                                   raw["rh_min_pct"].astype(float))
    35	    df["u2"] = raw["wind_ms"].astype(float)          # m/s at 2 m
    36	    df["rs"] = raw["solar_rad"].astype(float)        # MJ m-2 day-1
    37	    return df
===== et0/fao56.py =====
     1	"""FAO-56 Penman-Monteith reference evapotranspiration, daily time step.
     2	
     3	Implements the daily procedure of FAO Irrigation and Drainage Paper 56 (Allen et al., 1998), chapters 3 and 4, as
     4	written up in /app/docs/METHOD.md. Every function works on numpy arrays (one element per day).
     5	
     6	Inputs expected by et0_daily (already in standard form):
     7	    tmax, tmin   daily maximum and minimum air temperature [deg C]
     8	    u2           mean daily wind speed at 2 m above ground [m/s]
     9	    rs           incoming solar radiation [MJ m-2 day-1]
    10	    ea           actual vapour pressure [kPa] (see actual_vapour_pressure_*)
    11	    doy          day of the year, 1 = 1 January
    12	    latitude     decimal degrees, north positive, south negative
    13	    elevation    metres above sea level
    14	"""
    15	import numpy as np
    16	
    17	SOLAR_CONSTANT = 0.0820        # MJ m-2 min-1
    18	STEFAN_BOLTZMANN = 4.903e-9    # MJ K-4 m-2 day-1
    19	ALBEDO = 0.23                  # hypothetical grass reference
    20	
    21	
    22	def atmospheric_pressure(elevation):
    23	    """Eq. 7, kPa."""
    24	    return 101.3 * ((293.0 - 0.0065 * np.asarray(elevation, float)) / 293.0) ** 5.26
    25	
    26	
    27	def psychrometric_constant(pressure):
    28	    """Eq. 8, kPa/degC."""
    29	    return 0.665e-3 * pressure
    30	
    31	
    32	def saturation_vapour_pressure(t):
    33	    """Eq. 11, kPa."""
    34	    t = np.asarray(t, float)
    35	    return 0.6108 * np.exp(17.27 * t / (t + 237.3))
    36	
    37	
    38	def vapour_pressure_slope(t):
    39	    """Eq. 13, kPa/degC."""
    40	    t = np.asarray(t, float)
    41	    return 4098.0 * saturation_vapour_pressure(t) / (t + 237.3) ** 2
    42	
    43	
    44	def actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min):
    45	    """Eq. 17, kPa, from daily maximum and minimum relative humidity [%]."""
    46	    return (saturation_vapour_pressure(tmin) * np.asarray(rh_max, float) / 100.0
    47	            + saturation_vapour_pressure(tmax) * np.asarray(rh_min, float) / 100.0) / 2.0
    48	
    49	
    50	def actual_vapour_pressure_dewpoint(tdew):
    51	    """Eq. 14, kPa, from the daily mean dewpoint temperature [degC]."""
    52	    return saturation_vapour_pressure(tdew)
    53	
    54	
    55	def extraterrestrial_radiation(latitude, doy):
    56	    """Eqs. 21-25: Ra [MJ m-2 day-1] and the sunset hour angle ws [rad]."""
    57	    phi = np.deg2rad(np.asarray(latitude, float))
    58	    doy = np.asarray(doy, float)
    59	    dr = 1.0 + 0.033 * np.cos(2.0 * np.pi * doy / 365.0)
    60	    decl = 0.409 * np.sin(2.0 * np.pi * doy / 365.0 - 1.39)
    61	    ws = np.arccos(np.clip(-np.tan(phi) * np.tan(decl), -1.0, 1.0))
    62	    ra = (24.0 * 60.0 / np.pi) * SOLAR_CONSTANT * dr * (
    63	        ws * np.sin(phi) * np.sin(decl) + np.cos(phi) * np.cos(decl) * np.sin(ws))
    64	    return ra, ws
    65	
    66	
    67	def daylight_hours(ws):
    68	    """Eq. 34, hours."""
    69	    return 24.0 / np.pi * ws
    70	
    71	
    72	def clear_sky_radiation(ra, elevation):
    73	    """Eq. 37, MJ m-2 day-1."""
    74	    return (0.75 + 2e-5 * np.asarray(elevation, float)) * ra
    75	
    76	
    77	def net_longwave_radiation(tmax, tmin, ea, rs, rso):
    78	    """Eq. 39, MJ m-2 day-1. Rs/Rso is limited to 1.0."""
    79	    rel = np.minimum(np.asarray(rs, float) / rso, 1.0)
    80	    tk4 = ((np.asarray(tmax, float) + 273.16) ** 4 + (np.asarray(tmin, float) + 273.16) ** 4) / 2.0
    81	    return STEFAN_BOLTZMANN * tk4 * (0.34 - 0.14 * np.sqrt(ea)) * (1.35 * rel - 0.35)
    82	
    83	
    84	def et0_daily(tmax, tmin, u2, rs, ea, doy, latitude, elevation):
    85	    """Eq. 6, FAO-56 Penman-Monteith reference evapotranspiration [mm/day]; soil heat flux G = 0 (Eq. 42)."""
    86	    tmax = np.asarray(tmax, float)
    87	    tmin = np.asarray(tmin, float)
    88	    u2 = np.asarray(u2, float)
    89	    rs = np.asarray(rs, float)
    90	    ea = np.asarray(ea, float)
    91	    tmean = (tmax + tmin) / 2.0
    92	    delta = vapour_pressure_slope(tmean)
    93	    gamma = psychrometric_constant(atmospheric_pressure(elevation))
    94	    es = (saturation_vapour_pressure(tmax) + saturation_vapour_pressure(tmin)) / 2.0
    95	    ra, _ = extraterrestrial_radiation(latitude, doy)
    96	    rso = clear_sky_radiation(ra, elevation)
    97	    rns = (1.0 - ALBEDO) * rs
    98	    rnl = net_longwave_radiation(tmax, tmin, ea, rs, rso)
    99	    rn = rns - rnl
   100	    g = 0.0
   101	    num = 0.408 * delta * (rn - g) + gamma * (900.0 / (tmean + 273.0)) * u2 * (es - ea)
   102	    den = delta + gamma * (1.0 + 0.34 * u2)
   103	    return num / den
===== et0/pipeline.py =====
     1	"""Daily ET0 for every station in a register.
     2	
     3	    python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0.csv
     4	"""
     5	import argparse
     6	import os
     7	import sys
     8	
     9	import pandas as pd
    10	
    11	from . import fao56, ingest, meta
    12	
    13	
    14	def run(stations_path, data_dir, out_path):
    15	    frames = []
    16	    for st in meta.load_stations(stations_path):
    17	        df = ingest.load_station(st, data_dir)
    18	        df["et0_mm_day"] = fao56.et0_daily(df["tmax"], df["tmin"], df["u2"], df["rs"], df["ea"], df["doy"],
    19	                                           st.latitude, st.elevation_m)
    20	        frames.append(df[["station_id", "date", "et0_mm_day"]])
    21	        print(f"{st.station_id}: {len(df)} days, mean ET0 {df['et0_mm_day'].mean():.2f} mm/day")
    22	    out = pd.concat(frames, ignore_index=True)
    23	    parent = os.path.dirname(out_path)
    24	    if parent:
    25	        os.makedirs(parent, exist_ok=True)
    26	    out.to_csv(out_path, index=False, float_format="%.3f")
    27	    return out
    28	
    29	
    30	def main(argv=None):
    31	    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    32	    ap.add_argument("--stations", required=True, help="station register (YAML)")
    33	    ap.add_argument("--data", required=True, help="folder with one <station_id>.csv per station")
    34	    ap.add_argument("--out", required=True, help="output CSV")
    35	    args = ap.parse_args(argv)
    36	    run(args.stations, args.data, args.out)
    37	    return 0
    38	
    39	
    40	if __name__ == "__main__":
    41	    sys.exit(main())
===== et0/selfcheck.py =====
     1	"""Check fao56.et0_daily against the daily worked example of FAO-56 (chapter 4, Example 18).
     2	
     3	    python -m et0.selfcheck
     4	
     5	Uccle (Brussels), 6 July, 50 deg 48 min N, 100 m: Tmax 21.5, Tmin 12.3 degC, RHmax 84 %, RHmin 63 %, sunshine 9.25 h,
     6	wind 2.078 m/s at 2 m (the book first converts its 10 m reading). The book's answer is ETo = 3.88 mm/day (3.9 rounded).
     7	"""
     8	import sys
     9	
    10	from . import fao56
    11	
    12	BOOK_ET0 = 3.88
    13	
    14	
    15	def main():
    16	    lat, elev, doy = 50.0 + 48.0 / 60.0, 100.0, 187
    17	    tmax, tmin, rh_max, rh_min, sunshine, u2 = 21.5, 12.3, 84.0, 63.0, 9.25, 2.078
    18	    ra, ws = fao56.extraterrestrial_radiation(lat, doy)
    19	    rs = (0.25 + 0.50 * sunshine / fao56.daylight_hours(ws)) * ra      # Angstrom formula (Eq. 35), as in the book
    20	    ea = fao56.actual_vapour_pressure_rh(tmax, tmin, rh_max, rh_min)
    21	    et0 = float(fao56.et0_daily(tmax, tmin, u2, rs, ea, doy, lat, elev))
    22	    ok = abs(et0 - BOOK_ET0) <= 0.01
    23	    print(f"FAO-56 Example 18: Ra={float(ra):.2f} Rs={float(rs):.2f} ea={float(ea):.3f} ET0={et0:.3f} "
    24	          f"(book {BOOK_ET0}) -> {'OK' if ok else 'MISMATCH'}")
    25	    return 0 if ok else 1
    26	
    27	
    28	if __name__ == "__main__":
    29	    sys.exit(main())
