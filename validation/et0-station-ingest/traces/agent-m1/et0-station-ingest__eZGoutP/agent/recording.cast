[22.607712, "o", "> "]
[22.607892, "o", "+    # ``station.radiation_units`` may be \"MJ/m2/day\" (already in the\r\n\u001b[?2004l\r"]
[22.607911, "o", "\u001b[?2004h"]
[22.607941, "o", "> "]
[22.608111, "o", "+    # correct units) or \"W/m2\" (daily mean irradiance). For the latter we\r\n\u001b[?2004l\r"]
[22.608127, "o", "\u001b[?2004h"]
[22.608144, "o", "> "]
[22.608372, "o", "+    # multiply by 0.0864 to obtain MJ m⁻² day⁻¹ (1 W m⁻² sustained for a\r\n\u001b[?2004l\r"]
[22.608387, "o", "\u001b[?2004h"]
[22.608406, "o", "> "]
[22.608553, "o", "+    # day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\r\n\u001b[?2004l\r"]
[22.608573, "o", "\u001b[?2004h"]
[22.608595, "o", "> "]
[22.608757, "o", "+    # ------------------------------------------------------------\r\n\u001b[?2004l\r"]
[22.608776, "o", "\u001b[?2004h"]
[22.608793, "o", "> "]
[22.608917, "o", "+    rs_raw = raw[\"solar_rad\"].astype(float)\r\n\u001b[?2004l\r"]
[22.608955, "o", "\u001b[?2004h"]
[22.608989, "o", "> "]
[22.609191, "o", "+    if station.radiation_units.lower() == \"w/m2\" or station.radiation_units.lower() == \"w/m^2\":\r\n\u001b[?2004l\r"]
[22.60921, "o", "\u001b[?2004h> "]
[22.609309, "o", "+        df[\"rs\"] = rs_raw * 0.0864\r\n\u001b[?2004l\r"]
[22.60933, "o", "\u001b[?2004h"]
[22.609351, "o", "> "]
[22.60937, "o", "+    else:\r\n\u001b[?2004l\r"]
[22.609391, "o", "\u001b[?2004h> "]
[22.609565, "o", "+        # Assume the value is already in MJ m⁻² day⁻¹.\r\n\u001b[?2004l\r"]
[22.609586, "o", "\u001b[?2004h> "]
[22.609668, "o", "+        df[\"rs\"] = rs_raw\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.609687, "o", "> "]
[22.609723, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[22.609742, "o", "\u001b[?2004h"]
[22.609765, "o", "> "]
[22.609791, "o", "PATCH\r\n\u001b[?2004l\r"]
[22.610183, "o", "bash: apply_patch: command not found\r\n"]
