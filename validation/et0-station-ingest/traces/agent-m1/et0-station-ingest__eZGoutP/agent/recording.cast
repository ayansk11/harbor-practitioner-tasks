[22.60333, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: et0/ingest.py\n@@\n-import os\n-\n-import pandas as pd\n-\n-from . import fao56\n+import os\n+\n+import pandas as pd\n+import numpy as np\n+\n+from . import fao56\n@@\n-    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\n-    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\n+    # ------------------------------------------------------------\n+    # Wind speed conversion (Eq. 47). The raw column ``wind_ms`` is the\n+    # measured speed at the anemometer height ``station.wind_height_m``.\n+    # Convert it to the standard 2 m height using the logarithmic wind\n+    # profile: u2 = uz * 4.87 / ln(67.8 * z_w - 5.42)\n+    # ------------------------------------------------------------\n+    uz = raw[\"wind_ms\"].astype(float)\n+    z_w = float(station.wind_height_m)\n+    # Guard against division by zero or log of non‑positive numbers.\n+    if z_w <= 0:\n+        raise ValueError(f\"{station.station_id}: wind_height_m must be > 0, got {z_w}\")\n+    conv"]
[22.603426, "i", "ersion_factor = 4.87 / np.log(67.8 * z_w - 5.42)\n+    df[\"u2\"] = uz * conversion_factor\n+\n+    # ------------------------------------------------------------\n+    # Solar radiation conversion.\n+    # ``station.radiation_units`` may be \"MJ/m2/day\" (already in the\n+    # correct units) or \"W/m2\" (daily mean irradiance). For the latter we\n+    # multiply by 0.0864 to obtain MJ m⁻² day⁻¹ (1 W m⁻² sustained for a\n+    # day = 86 400 J m⁻² = 0.0864 MJ m⁻²).\n+    # ------------------------------------------------------------\n+    rs_raw = raw[\"solar_rad\"].astype(float)\n+    if station.radiation_units.lower() == \"w/m2\" or station.radiation_units.lower() == \"w/m^2\":\n+        df[\"rs\"] = rs_raw * 0.0864\n+    else:\n+        # Assume the value is already in MJ m⁻² day⁻¹.\n+        df[\"rs\"] = rs_raw\n*** End Patch\nPATCH\n"]
