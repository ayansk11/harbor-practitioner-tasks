[39.195086, "i", "cat > et0/ingest.py <<'EOF'\n\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\nimport os\n\nimport pandas as pd\nimport numpy as np\n\nfrom . import fao56\n\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\n\n\ndef load_station(station, data_dir):\n    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\n    raw = pd.read_csv(path)\n    if station.humidity not in HUMIDITY_COLUMNS:\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\n    if missing:\n        raise ValueError(f\"{path}: missing columns {missing}\")\n\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\n    df = pd.DataFrame({\n        \"station_i"]
[39.195182, "i", "d\": station.station_id,\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\n        \"doy\": dates.dt.dayofyear.astype(int),\n        \"tmax\": raw[\"tmax_c\"].astype(float),\n        \"tmin\": raw[\"tmin_c\"].astype(float),\n    })\n    # Actual vapour pressure\n    if station.humidity == \"dewpoint\":\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\n    else:\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\n            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\n        )\n    # Wind speed conversion to 2 m height (Eq. 47)\n    uz = raw[\"wind_ms\"].astype(float)\n    z_w = float(station.wind_height_m)\n    if z_w <= 0:\n        raise ValueError(f\"{station.station_id}: wind_height_m must be > 0, got {z_w}\")\n    conv_factor = 4.87 / np.log(67.8 * z_w - 5.42)\n    df[\"u2\"] = uz * conv_factor\n    # Radiation conversion\n    rs_raw = raw[\"solar_rad\"].astype(float)\n    if station.radiation_units.lower() in (\"w/m2\", \"w/m^2\"):\n        df[\"rs\"] = rs_raw * 0.0864"]
[39.195209, "i", "\n    else:\n        df[\"rs\"] = rs_raw\n    return df\nEOF\n"]
[39.195231, "o", "cat > et0/ingest.py <<'EOF'\r\n\u001b[?2004l\r"]
[39.195277, "o", "\u001b[?2004h> "]
[39.195554, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\n\u001b[?2004l\r"]
[39.195584, "o", "\u001b[?2004h> "]
[39.195605, "o", "import os\r\n\u001b[?2004l\r"]
[39.195625, "o", "\u001b[?2004h"]
[39.195644, "o", "> \r\n\u001b[?2004l\r"]
[39.195663, "o", "\u001b[?2004h> "]
[39.19571, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[39.195727, "o", "\u001b[?2004h"]
[39.195746, "o", "> "]
[39.195789, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[39.195808, "o", "\u001b[?2004h"]
[39.195825, "o", "> \r\n\u001b[?2004l\r"]
[39.195846, "o", "\u001b[?2004h"]
[39.195897, "o", "> "]
[39.195925, "o", "from . import fao56\r\n\u001b[?2004l\r"]
[39.195965, "o", "\u001b[?2004h"]
[39.195994, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.196151, "o", "BASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\n\u001b[?2004l\r"]
[39.19617, "o", "\u001b[?2004h"]
[39.196188, "o", "> "]
[39.196401, "o", "HUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\u001b[?2004l\r"]
[39.196418, "o", "\u001b[?2004h"]
[39.196432, "o", "> \r\n\u001b[?2004l\r"]
[39.196447, "o", "\u001b[?2004h"]
[39.196462, "o", "> \r\n\u001b[?2004l\r"]
[39.196478, "o", "\u001b[?2004h> "]
[39.19657, "o", "def load_station(station, data_dir):\r\n\u001b[?2004l\r"]
[39.196588, "o", "\u001b[?2004h"]
[39.196606, "o", "> "]
[39.196882, "o", "    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n\u001b[?2004l\r"]
[39.196898, "o", "\u001b[?2004h"]
[39.196912, "o", "> "]
[39.197069, "o", "    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n\u001b[?2004l\r"]
[39.19709, "o", "\u001b[?2004h"]
[39.197104, "o", "> "]
[39.197173, "o", "    raw = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[39.19719, "o", "\u001b[?2004h"]
[39.197204, "o", "> "]
[39.197328, "o", "    if station.humidity not in HUMIDITY_COLUMNS:\r\n\u001b[?2004l\r"]
[39.197346, "o", "\u001b[?2004h"]
[39.197365, "o", "> "]
[39.197598, "o", "        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n\u001b[?2004l\r"]
[39.19762, "o", "\u001b[?2004h> "]
[39.197891, "o", "    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n\u001b[?2004l\r"]
[39.19791, "o", "\u001b[?2004h"]
[39.197924, "o", "> "]
[39.197958, "o", "    if missing:\r\n\u001b[?2004l\r"]
[39.197977, "o", "\u001b[?2004h"]
[39.197991, "o", "> "]
[39.198149, "o", "        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\u001b[?2004l\r"]
[39.19817, "o", "\u001b[?2004h"]
[39.198183, "o", "> \r\n"]
[39.198197, "o", "\u001b[?2004l\r"]
[39.198211, "o", "\u001b[?2004h> "]
[39.198359, "o", "    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n\u001b[?2004l\r"]
[39.198376, "o", "\u001b[?2004h"]
[39.19839, "o", "> "]
[39.19845, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[39.19847, "o", "\u001b[?2004h"]
[39.198483, "o", "> "]
[39.198589, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[39.198611, "o", "\u001b[?2004h"]
[39.198624, "o", "> "]
[39.198742, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[39.198759, "o", "\u001b[?2004h"]
[39.198773, "o", "> "]
[39.198908, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[39.198927, "o", "\u001b[?2004h"]
[39.198942, "o", "> "]
[39.199051, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[39.199067, "o", "\u001b[?2004h"]
[39.199081, "o", "> "]
[39.199195, "o", "        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[39.199212, "o", "\u001b[?2004h"]
[39.199226, "o", "> "]
[39.199244, "o", "    })\r\n"]
[39.199258, "o", "\u001b[?2004l\r"]
[39.199272, "o", "\u001b[?2004h> "]
[39.199347, "o", "    # Actual vapour pressure\r\n\u001b[?2004l\r"]
[39.199363, "o", "\u001b[?2004h"]
[39.199377, "o", "> "]
[39.199477, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[39.199492, "o", "\u001b[?2004h"]
[39.199511, "o", "> "]
[39.199722, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[39.199738, "o", "\u001b[?2004h"]
[39.199752, "o", "> "]
[39.199776, "o", "    else:\r\n\u001b[?2004l\r"]
[39.199801, "o", "\u001b[?2004h"]
[39.199815, "o", "> "]
[39.199952, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(\r\n\u001b[?2004l\r"]
[39.199983, "o", "\u001b[?2004h"]
[39.2, "o", "> "]
[39.200258, "o", "            df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float), raw[\"rh_min_pct\"].astype(float)\r\n\u001b[?2004l\r"]
[39.20028, "o", "\u001b[?2004h"]
[39.200294, "o", "> "]
[39.200313, "o", "        )\r\n\u001b[?2004l\r"]
[39.200331, "o", "\u001b[?2004h"]
[39.200345, "o", "> "]
[39.200474, "o", "    # Wind speed conversion to 2 m height (Eq. 47)\r\n\u001b[?2004l\r"]
[39.200491, "o", "\u001b[?2004h"]
[39.200506, "o", "> "]
[39.200601, "o", "    uz = raw[\"wind_ms\"].astype(float)\r\n\u001b[?2004l\r"]
[39.200617, "o", "\u001b[?2004h"]
[39.20063, "o", "> "]
[39.200732, "o", "    z_w = float(station.wind_height_m)\r\n\u001b[?2004l\r"]
[39.200749, "o", "\u001b[?2004h"]
[39.200765, "o", "> "]
[39.200805, "o", "    if z_w <= 0:\r\n\u001b[?2004l\r"]
[39.200822, "o", "\u001b[?2004h"]
[39.20084, "o", "> "]
[39.201066, "o", "        raise ValueError(f\"{station.station_id}: wind_height_m must be > 0, got {z_w}\")\r\n\u001b[?2004l\r"]
[39.201102, "o", "\u001b[?2004h> "]
[39.201228, "o", "    conv_factor = 4.87 / np.log(67.8 * z_w - 5.42)\r\n\u001b[?2004l\r"]
[39.201262, "o", "\u001b[?2004h> "]
[39.201334, "o", "    df[\"u2\"] = uz * conv_factor\r\n\u001b[?2004l\r"]
[39.201354, "o", "\u001b[?2004h"]
[39.201371, "o", "> "]
[39.201433, "o", "    # Radiation conversion\r\n\u001b[?2004l\r"]
[39.201453, "o", "\u001b[?2004h"]
[39.201473, "o", "> "]
[39.20158, "o", "    rs_raw = raw[\"solar_rad\"].astype(float)\r\n\u001b[?2004l\r"]
[39.201618, "o", "\u001b[?2004h"]
[39.201639, "o", "> "]
[39.201765, "o", "    if station.radiation_units.lower() in (\"w/m2\", \"w/m^2\"):\r\n\u001b[?2004l\r"]
[39.201782, "o", "\u001b[?2004h"]
[39.201796, "o", "> "]
[39.201892, "o", "        df[\"rs\"] = rs_raw * 0.0864\r\n\u001b[?2004l\r"]
[39.201914, "o", "\u001b[?2004h"]
[39.20193, "o", "> "]
[39.201947, "o", "    else:\r\n\u001b[?2004l\r"]
[39.201966, "o", "\u001b[?2004h> "]
[39.202039, "o", "        df[\"rs\"] = rs_raw\r\n\u001b[?2004l\r"]
[39.202055, "o", "\u001b[?2004h"]
[39.20207, "o", "> "]
[39.202106, "o", "    return df\r\n\u001b[?2004l\r"]
[39.202122, "o", "\u001b[?2004h"]
[39.202136, "o", "> "]
[39.202152, "o", "EOF\r\n\u001b[?2004l\r"]
[39.203503, "o", "\u001b[?2004h"]
[39.203517, "o", "root@287b5ab0-eeae-40bd-a493-8a7ef9e8de71:/app# "]
