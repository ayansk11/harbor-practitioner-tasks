[?2004l[?2004h> -    df["rs"] = raw["solar_rad"].astype(float)        # MJ m-2 day-1
[?2004l[?2004h> +    # ------------------------------------------------------------
[?2004l[?2004h> +    # Wind speed conversion (Eq. 47). The raw column ``wind_ms`` is the
[?2004l[?2004h> +    # measured speed at the anemometer height ``station.wind_height_m``.
[?2004l[?2004h> +    # Convert it to the standard 2 m height using the logarithmic wind
[?2004l[?2004h> +    # profile: u2 = uz * 4.87 / ln(67.8 * z_w - 5.42)
[?2004l[?2004h> +    # ------------------------------------------------------------
[?2004l[?2004h> +    uz = raw["wind_ms"].astype(float)
[?2004l[?2004h> +    z_w = float(station.wind_height_m)
[?2004l[?2004h> +    # Guard against division by zero or log of non‑positive numbers.
[?2004l[?2004h> +    if z_w <= 0:
[?2004l[?2004h> +        raise ValueError(f"{station.station_id}: wind_height_m must be > 0, got {z_w}")
[?2004l[?2004h> +    conversion_factor = 4.87 / np.log(67.8 * z_w - 5.42)
[?2004l[?2004h> +    df["u2"] = uz * conversion_factor
[?2004l[?2004h> +
[?2004l[?2004h> +    # ------------------------------------------------------------
[?2004l[?2004h> +    # Solar radiation conversion.
[?2004l[?2004h> +    # ``station.radiation_units`` may be "MJ/m2/day" (already in the
[?2004l[?2004h> +    # correct units) or "W/m2" (daily mean irradiance). For the latter we
[?2004l[?2004h> +    # multiply by 0.0864 to obtain MJ m⁻² day⁻¹ (1 W m⁻² sustained for a
[?2004l[?2004h> +    # day = 86 400 J m⁻² = 0.0864 MJ m⁻²).
[?2004l[?2004h> +    # ------------------------------------------------------------
[?2004l[?2004h> +    rs_raw = raw["solar_rad"].astype(float)
[?2004l[?2004h> +    if station.radiation_units.lower() == "w/m2" or station.radiation_units.lower() == "w/m^2":
[?2004l[?2004h> +        df["rs"] = rs_raw * 0.0864
[?2004l[?2004h> +    else:
[?2004l[?2004h> +        # Assume the value is already in MJ m⁻² day⁻¹.
[?2004l[?2004h> +        df["rs"] = rs_raw
[?2004l[?2004h> *** End Patch
