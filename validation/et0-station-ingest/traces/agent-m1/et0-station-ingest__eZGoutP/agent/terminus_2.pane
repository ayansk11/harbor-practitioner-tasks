[?2004l[?2004h> """Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md)."""
[?2004l[?2004h> from dataclasses import dataclass
[?2004l[?2004h> 
[?2004l[?2004h> import yaml
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass(frozen=True)
[?2004l[?2004h> class Station:
[?2004l[?2004h>     station_id: str
[?2004l[?2004h>     name: str
[?2004l[?2004h>     latitude: float          # decimal degrees, north positive
[?2004l[?2004h>     longitude: float
[?2004l[?2004h>     elevation_m: float
[?2004l[?2004h>     wind_height_m: float
[?2004l[?2004h>     radiation_units: str
[?2004l[?2004h>     humidity: str
[?2004l[?2004h>     network: str
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_latitude(value):
[?2004l[?2004h>     """Parse latitude values from the station register.
[?2004l[?2004h> 
[?2004l[?2004h>     The register may contain:
[?2004l[?2004h>     * A plain number (e.g. ``38.42`` or ``-31.85``) – positive is north, negative is south.
[?2004l[?2004h>     * A string with a hemisphere suffix, e.g. ``"36.95N"`` or ``"34.92S"`` – the suffix determines the sign.
[?2004l[?2004h> 
[?2004l[?2004h>     The original implementation stripped the ``N``/``S`` suffix but never applied a negative sign for southern
[?2004l[?2004h>     hemispheres, causing southern stations to be interpreted as northern. This function now correctly handles both
[?2004l[?2004h>     forms.
[?2004l[?2004h>     """
[?2004l[?2004h>     # Numeric values are already signed correctly.
[?2004l[?2004h>     if isinstance(value, (int, float)):
[?2004l[?2004h>         return float(value)
[?2004l[?2004h> 
[?2004l[?2004h>     # Work with a trimmed upper‑case string.
[?2004l[?2004h>     text = str(value).strip().upper()
[?2004l[?2004h>     if text.endswith("N"):
[?2004l[?2004h>         sign = 1
[?2004l[?2004h>         num_part = text[:-1]
[?2004l[?2004h>     elif text.endswith("S"):
[?2004l[?2004h>         sign = -1
[?2004l[?2004h>         num_part = text[:-1]
[?2004l[?2004h>     else:
[?2004l[?2004h>         sign = 1
[?2004l[?2004h>         num_part = text
[?2004l[?2004h>     try:
[?2004l[?2004h>         return sign * float(num_part)
[?2004l[?2004h>     except ValueError as exc:
[?2004l[?2004h>         raise ValueError(f"Invalid latitude value: {value!r}") from exc
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_stations(path):
[?2004l[?2004h>     with open(path, encoding="utf-8") as f:
[?2004l[?2004h>         doc = yaml.safe_load(f)
[?2004l[?2004h>     stations = []
[?2004l[?2004h>     for rec in doc["stations"]:
[?2004l[?2004h>         stations.append(Station(
[?2004l[?2004h>             station_id=str(rec["id"]),
[?2004l[?2004h>             name=str(rec.get("name", "")),
[?2004l[?2004h>             latitude=parse_latitude(rec["latitude"]),
[?2004l[?2004h>             longitude=float(rec["longitude"]),
[?2004l[?2004h>             elevation_m=float(rec["elevation_m"]),
[?2004l[?2004h>             wind_height_m=float(rec["wind_height_m"]),
[?2004l[?2004h>             radiation_units=str(rec["radiation_units"]),
[?2004l[?2004h>             humidity=str(rec["humidity"]),
[?2004l[?2004h>             network=str(rec.get("network", "")),
[?2004l[?2004h>         ))
[?2004l[?2004h>     return stations
[?2004l[?2004h> EOF
