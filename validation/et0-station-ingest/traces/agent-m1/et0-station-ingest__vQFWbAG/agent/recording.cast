[55.768261, "o", "# Station register for the irrigation-advice ET0 run (see /app/docs/METHOD.md for every field).\r\nstations:\r\n  - id: VNT\r\n    name: Valle Norte\r\n    latitude: 38.42\r\n    longitude: -3.71\r\n    elevation_m: 85\r\n    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: rh_minmax\r\n    network: valley-agromet\r\n  - id: PAL\r\n    name: Paso Alto\r\n    latitude: \"36.95N\"\r\n    longitude: -3.02\r\n    elevation_m: 1840\r\n    wind_height_m: 10.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: rh_minmax\r\n    network: highland-synop\r\n  - id: CDB\r\n    name: Costa del Bajo\r\n    latitude: \"34.92S\"\r\n    longitude: 138.6\r\n    elevation_m: 48\r\n    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: dewpoint\r\n    network: southern-coast\r\n  - id: LGN\r\n    name: Laguna Grande\r\n    latitude: -31.85\r\n    longitude: 116.02\r\n    elevation_m: 420\r\n    wind_height_m: 3.0\r\n    radiation_units: \"W/m2\"\r\n    humidity: rh_minmax\r\n    network: southern-coast\r\n  - id: RSD\r\n    name: Ribera Seca\r\n    latitude: \"41.73N\"\r"]
[55.768295, "o", "\n    longitude: -1.02\r\n    elevation_m: 230\r\n    wind_height_m: 2.0\r\n    radiation_units: \"W/m2\"\r\n    humidity: dewpoint\r\n    network: highland-synop\r\n  - id: MRS\r\n    name: Marisma\r\n    latitude: 35.1\r\n    longitude: -6.15\r\n    elevation_m: 12\r\n    wind_height_m: 3.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: rh_minmax\r\n    network: valley-agromet\r\n  - id: HLT\r\n    name: Altiplano Sur\r\n    latitude: \"33.40S\"\r\n    longitude: -70.55\r\n    elevation_m: 610\r\n    wind_height_m: 10.0\r\n    radiation_units: \"W/m2\"\r\n    humidity: dewpoint\r\n    network: highland-synop\r\n  - id: ARN\r\n    name: Arenales\r\n    latitude: 40.05\r\n    longitude: -4.4\r\n    elevation_m: 690\r\n    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: dewpoint\r\n    network: valley-agromet\r\n"]
[55.76845, "o", "\u001b[?2004h"]
[55.768475, "o", "root@cc4dd510-56e9-4b49-81ff-aecfebd8baca:/app# "]
[56.093053, "i", "cat et0/meta.py\n"]
[56.093153, "o", "cat et0/meta.py\r\n\u001b[?2004l\r"]
[56.094412, "o", "\"\"\"Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md).\"\"\"\r\nfrom dataclasses import dataclass\r\n\r\nimport yaml\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Station:\r\n    station_id: str\r\n    name: str\r\n    latitude: float          # decimal degrees, north positive\r\n    longitude: float\r\n    elevation_m: float\r\n    wind_height_m: float\r\n    radiation_units: str\r\n    humidity: str\r\n    network: str\r\n\r\n\r\ndef parse_latitude(value):\r\n    \"\"\"Latitude in decimal degrees.\r\n\r\n    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,\r\n    text with a hemisphere letter (\"36.95N\").\r\n    \"\"\"\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n    text = str(value).strip().upper()\r\n    return float(text.rstrip(\"NS\"))\r\n\r\n\r\ndef load_stations(path):\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        doc = yaml.safe_load(f)\r\n    stations = []\r\n    for rec in doc[\"stations\"]:\r\n        stations.append(Stati"]
[56.094482, "o", "on(\r\n            station_id=str(rec[\"id\"]),\r\n            name=str(rec.get(\"name\", \"\")),\r\n            latitude=parse_latitude(rec[\"latitude\"]),\r\n            longitude=float(rec[\"longitude\"]),\r\n            elevation_m=float(rec[\"elevation_m\"]),\r\n            wind_height_m=float(rec[\"wind_height_m\"]),\r\n            radiation_units=str(rec[\"radiation_units\"]),\r\n            humidity=str(rec[\"humidity\"]),\r\n            network=str(rec.get(\"network\", \"\")),\r\n        ))\r\n    return stations\r\n"]
[56.094595, "o", "\u001b[?2004h"]
[56.09462, "o", "root@cc4dd510-56e9-4b49-81ff-aecfebd8baca:/app# "]
[56.428157, "i", "cat et0/ingest.py\n"]
[56.428279, "o", "cat et0/ingest.py\r\n\u001b[?2004l\r"]
[56.429288, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\nimport os\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\r\n\r\ndef load_station(station, data_dir):\r\n    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    raw = pd.read_csv(path)\r\n    if station.humidity not in HUMIDITY_COLUMNS:\r\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    if missing:\r\n        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\r\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    df = pd.DataFrame({\r\n        \"station_id\": station.station_id,\r"]
[56.429304, "o", "\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n        \"doy\": dates.dt.dayofyear.astype(int),\r\n        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    })\r\n    if station.humidity == \"dewpoint\":\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    else:\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n                                                   raw[\"rh_min_pct\"].astype(float))\r\n    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\r\n    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\r\n    return df\r\n"]
[56.429486, "o", "\u001b[?2004h"]
[56.429515, "o", "root@cc4dd510-56e9-4b49-81ff-aecfebd8baca:/app# "]
[56.758782, "i", "cat et0/pipeline.py\n"]
[56.758908, "o", "cat et0/pipeline.py\r\n\u001b[?2004l\r"]
[56.760019, "o", "\"\"\"Daily ET0 for every station in a register.\r\n\r\n    python -m et0.pipeline --stations config/stations.yaml --data data/raw --out output/et0.csv\r\n\"\"\"\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56, ingest, meta\r\n\r\n\r\ndef run(stations_path, data_dir, out_path):\r\n    frames = []\r\n    for st in meta.load_stations(stations_path):\r\n        df = ingest.load_station(st, data_dir)\r\n        df[\"et0_mm_day\"] = fao56.et0_daily(df[\"tmax\"], df[\"tmin\"], df[\"u2\"], df[\"rs\"], df[\"ea\"], df[\"doy\"],\r\n                                           st.latitude, st.elevation_m)\r\n        frames.append(df[[\"station_id\", \"date\", \"et0_mm_day\"]])\r\n        print(f\"{st.station_id}: {len(df)} days, mean ET0 {df['et0_mm_day'].mean():.2f} mm/day\")\r\n    out = pd.concat(frames, ignore_index=True)"]
[56.76006, "o", "\r\n    parent = os.path.dirname(out_path)\r\n    if parent:\r\n        os.makedirs(parent, exist_ok=True)\r\n    out.to_csv(out_path, index=False, float_format=\"%.3f\")\r\n    return out\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    ap.add_argument(\"--stations\", required=True, help=\"station register (YAML)\")\r\n    ap.add_argument(\"--data\", required=True, help=\"folder with one <station_id>.csv per station\")\r\n    ap.add_argument(\"--out\", required=True, help=\"output CSV\")\r\n    args = ap.parse_args(argv)\r\n    run(args.stations, args.data, args.out)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[56.760237, "o", "\u001b[?2004hroot@cc4dd510-56e9-4b49-81ff-aecfebd8baca:/app# "]
[59.830081, "i", "cat config/stations.yaml\n"]
