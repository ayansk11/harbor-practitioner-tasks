[47.246444, "o", "cat et0/ingest.py\r\n\u001b[?2004l\r"]
[47.247442, "o", "\"\"\"Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily.\"\"\"\r\nimport os\r\n\r\nimport pandas as pd\r\n\r\nfrom . import fao56\r\n\r\nBASE_COLUMNS = [\"date\", \"tmax_c\", \"tmin_c\", \"wind_ms\", \"solar_rad\"]\r\nHUMIDITY_COLUMNS = {\"rh_minmax\": [\"rh_max_pct\", \"rh_min_pct\"], \"dewpoint\": [\"tdew_c\"]}\r\n\r\n\r\ndef load_station(station, data_dir):\r\n    \"\"\"Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units).\"\"\"\r\n    path = os.path.join(data_dir, f\"{station.station_id}.csv\")\r\n    raw = pd.read_csv(path)\r\n    if station.humidity not in HUMIDITY_COLUMNS:\r\n        raise ValueError(f\"{station.station_id}: unknown humidity type {station.humidity!r}\")\r\n    missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]\r\n    if missing:\r\n        raise ValueError(f\"{path}: missing columns {missing}\")\r\n\r\n    dates = pd.to_datetime(raw[\"date\"], format=\"%Y-%m-%d\")\r\n    df = pd.DataFrame({\r\n        \"station_id\": station.station_id,\r"]
[47.247476, "o", "\n        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n        \"doy\": dates.dt.dayofyear.astype(int),\r\n        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n    })\r\n    if station.humidity == \"dewpoint\":\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n    else:\r\n        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n                                                   raw[\"rh_min_pct\"].astype(float))\r\n    df[\"u2\"] = raw[\"wind_ms\"].astype(float)          # m/s at 2 m\r\n    df[\"rs\"] = raw[\"solar_rad\"].astype(float)        # MJ m-2 day-1\r\n    return df\r\n"]
[47.247665, "o", "\u001b[?2004hroot@cc4dd510-56e9-4b49-81ff-aecfebd8baca:/app# "]
[47.55688, "i", "cat et0/meta.py\n"]
[47.556987, "o", "cat et0/meta.py\r\n\u001b[?2004l\r"]
[47.55832, "o", "\"\"\"Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md).\"\"\"\r\nfrom dataclasses import dataclass\r\n\r\nimport yaml\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Station:\r\n    station_id: str\r\n    name: str\r\n    latitude: float          # decimal degrees, north positive\r\n    longitude: float\r\n    elevation_m: float\r\n    wind_height_m: float\r\n    radiation_units: str\r\n    humidity: str\r\n    network: str\r\n\r\n\r\ndef parse_latitude(value):\r\n    \"\"\"Latitude in decimal degrees.\r\n\r\n    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,\r\n    text with a hemisphere letter (\"36.95N\").\r\n    \"\"\"\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n    text = str(value).strip().upper()\r\n    return float(text.rstrip(\"NS\"))\r\n\r\n\r\ndef load_stations(path):\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        doc = yaml.safe_load(f)\r\n    stations = []\r\n    for rec in doc[\"stations\"]:\r\n        stations.append(Stati"]
[47.558346, "o", "on(\r\n            station_id=str(rec[\"id\"]),\r\n            name=str(rec.get(\"name\", \"\")),\r\n            latitude=parse_latitude(rec[\"latitude\"]),\r\n            longitude=float(rec[\"longitude\"]),\r\n            elevation_m=float(rec[\"elevation_m\"]),\r\n            wind_height_m=float(rec[\"wind_height_m\"]),\r\n            radiation_units=str(rec[\"radiation_units\"]),\r\n            humidity=str(rec[\"humidity\"]),\r\n            network=str(rec.get(\"network\", \"\")),\r\n        ))\r\n    return stations\r\n"]
