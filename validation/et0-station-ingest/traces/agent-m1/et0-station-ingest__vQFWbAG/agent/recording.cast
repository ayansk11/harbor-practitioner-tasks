[84.679636, "o", "    df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[84.679652, "o", "\u001b[?2004h"]
[84.679667, "o", "> "]
[84.679769, "o", "        \"station_id\": station.station_id,\r\n\u001b[?2004l\r"]
[84.679788, "o", "\u001b[?2004h"]
[84.67981, "o", "> "]
[84.679944, "o", "        \"date\": dates.dt.strftime(\"%Y-%m-%d\"),\r\n\u001b[?2004l\r"]
[84.67999, "o", "\u001b[?2004h"]
[84.680021, "o", "> "]
[84.680089, "o", "        \"doy\": dates.dt.dayofyear.astype(int),\r\n\u001b[?2004l\r"]
[84.68011, "o", "\u001b[?2004h> "]
[84.68023, "o", "        \"tmax\": raw[\"tmax_c\"].astype(float),\r\n\u001b[?2004l\r"]
[84.680249, "o", "\u001b[?2004h> "]
[84.680368, "o", "        \"tmin\": raw[\"tmin_c\"].astype(float),\r\n\u001b[?2004l\r"]
[84.680387, "o", "\u001b[?2004h> "]
[84.68041, "o", "    })\r\n\u001b[?2004l\r"]
[84.680427, "o", "\u001b[?2004h> "]
[84.680537, "o", "    if station.humidity == \"dewpoint\":\r\n\u001b[?2004l\r"]
[84.680555, "o", "\u001b[?2004h> "]
[84.680778, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_dewpoint(raw[\"tdew_c\"].astype(float))\r\n\u001b[?2004l\r"]
[84.680796, "o", "\u001b[?2004h> "]
[84.680843, "o", "    else:\r\n\u001b[?2004l\r"]
[84.680863, "o", "\u001b[?2004h"]
[84.680882, "o", "> "]
[84.681137, "o", "        df[\"ea\"] = fao56.actual_vapour_pressure_rh(df[\"tmax\"], df[\"tmin\"], raw[\"rh_max_pct\"].astype(float),\r\n\u001b[?2004l\r"]
[84.681155, "o", "\u001b[?2004h> "]
[84.681371, "o", "                                                   raw[\"rh_min_pct\"].astype(float))\r\n\u001b[?2004l\r"]
[84.681399, "o", "\u001b[?2004h> "]
[84.681419, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[84.681438, "o", "> "]
[84.68152, "o", "    # Wind speed conversion to 2m\r\n\u001b[?2004l\r"]
[84.68154, "o", "\u001b[?2004h"]
[84.681559, "o", "> "]
[84.68165, "o", "    uz = raw[\"wind_ms\"].astype(float)\r\n\u001b[?2004l\r"]
[84.68167, "o", "\u001b[?2004h> "]
[84.681757, "o", "    zw = station.wind_height_m\r\n\u001b[?2004l\r"]
[84.681775, "o", "\u001b[?2004h> "]
[84.68192, "o", "    df[\"u2\"] = uz * 4.87 / np.log(67.8 * zw - 5.42)\r\n\u001b[?2004l\r"]
[84.681944, "o", "\u001b[?2004h> "]
[84.681964, "o", "    \r\n\u001b[?2004l\r"]
[84.681985, "o", "\u001b[?2004h> "]
[84.682067, "o", "    # Solar radiation conversion\r\n\u001b[?2004l\r"]
[84.6821, "o", "\u001b[?2004h"]
[84.682121, "o", "> "]
[84.682203, "o", "    rs_raw = raw[\"solar_rad\"].astype(float)\r\n\u001b[?2004l\r"]
[84.68222, "o", "\u001b[?2004h> "]
[84.682337, "o", "    if station.radiation_units == \"W/m2\":\r\n\u001b[?2004l\r"]
[84.682359, "o", "\u001b[?2004h> "]
[84.682454, "o", "        df[\"rs\"] = rs_raw * 0.0864\r\n\u001b[?2004l\r"]
[84.682479, "o", "\u001b[?2004h> "]
[84.682507, "o", "    else:\r\n\u001b[?2004l\r"]
[84.682528, "o", "\u001b[?2004h"]
[84.682539, "o", "> "]
[84.682598, "o", "        df[\"rs\"] = rs_raw\r\n\u001b[?2004l\r"]
[84.682617, "o", "\u001b[?2004h> "]
[84.682647, "o", "        \r\n\u001b[?2004l\r"]
[84.682663, "o", "\u001b[?2004h> "]
[84.682711, "o", "    return df\r\n\u001b[?2004l\r"]
[84.68275, "o", "\u001b[?2004h"]
[84.682776, "o", "> EOF\r\n\u001b[?2004l\r"]
