[68.20919, "i", "cat et0/meta.py\n"]
[68.209306, "o", "cat et0/meta.py\r\n\u001b[?2004l\r"]
[68.210356, "o", "\"\"\"Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md).\"\"\"\r\nfrom dataclasses import dataclass\r\n\r\nimport yaml\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Station:\r\n    station_id: str\r\n    name: str\r\n    latitude: float          # decimal degrees, north positive\r\n    longitude: float\r\n    elevation_m: float\r\n    wind_height_m: float\r\n    radiation_units: str\r\n    humidity: str\r\n    network: str\r\n\r\n\r\ndef parse_latitude(value):\r\n    \"\"\"Latitude in decimal degrees.\r\n\r\n    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,\r\n    text with a hemisphere letter (\"36.95N\").\r\n    \"\"\"\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n"]
[68.210379, "o", "    text = str(value).strip().upper()\r\n    return float(text.rstrip(\"NS\"))\r\n\r\n\r\ndef load_stations(path):\r\n    with open(path, encoding=\"utf-8\") as f:\r\n        doc = yaml.safe_load(f)\r\n    stations = []\r\n    for rec in doc[\"stations\"]:\r\n        stations.append(Station(\r\n            station_id=str(rec[\"id\"]),\r\n            name=str(rec.get(\"name\", \"\")),\r\n            latitude=parse_latitude(rec[\"latitude\"]),\r\n            longitude=float(rec[\"longitude\"]),\r\n            elevation_m=float(rec[\"elevation_m\"]),\r\n            wind_height_m=float(rec[\"wind_height_m\"]),\r\n            radiation_units=str(rec[\"radiation_units\"]),\r\n            humidity=str(rec[\"humidity\"]),\r\n            network=str(rec.get(\"network\", \"\")),\r\n        ))\r\n"]
[68.210397, "o", "    return stations\r\n"]
[68.21057, "o", "\u001b[?2004h"]
[68.210589, "o", "root@cc4dd510-56e9-4b49-81ff-aecfebd8baca:/app# "]
[84.366698, "i", "cat <<EOF > et0/meta.py\n\"\"\"Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md).\"\"\"\nfrom dataclasses import dataclass\n\nimport yaml\n\n\n@dataclass(frozen=True)\nclass Station:\n    station_id: str\n    name: str\n    latitude: float          # decimal degrees, north positive\n    longitude: float\n    elevation_m: float\n    wind_height_m: float\n    radiation_units: str\n    humidity: str\n    network: str\n\n\ndef parse_latitude(value):\n    \"\"\"Latitude in decimal degrees.\n\n    The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,\n    text with a hemisphere letter (\"36.95N\").\n    \"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    text = str(value).strip().upper()\n    if text.endswith('S'):\n        return -float(text[:-1])\n    if text.endswith('N'):\n        return float(text[:-1])\n    return float(text)\n\n\ndef load_stations(path):\n    with open(path, encoding=\"utf-8\") as f:\n        doc = yam"]
[84.366796, "i", "l.safe_load(f)\n    stations = []\n    for rec in doc[\"stations\"]:\n        stations.append(Station(\n            station_id=str(rec[\"id\"]),\n            name=str(rec.get(\"name\", \"\")),\n            latitude=parse_latitude(rec[\"latitude\"]),\n            longitude=float(rec[\"longitude\"]),\n            elevation_m=float(rec[\"elevation_m\"]),\n            wind_height_m=float(rec[\"wind_height_m\"]),\n            radiation_units=str(rec[\"radiation_units\"]),\n            humidity=str(rec[\"humidity\"]),\n            network=str(rec.get(\"network\", \"\")),\n        ))\n    return stations\nEOF\n"]
