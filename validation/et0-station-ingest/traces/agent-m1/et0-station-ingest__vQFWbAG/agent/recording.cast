[67.897789, "o", " longitude: -70.55\r\n    elevation_m: 610\r\n    wind_height_m: 10.0\r\n    radiation_units: \"W/m2\"\r\n    humidity: dewpoint\r\n    network: highland-synop\r\n  - id: ARN\r\n    name: Arenales\r\n    latitude: 40.05\r\n    longitude: -4.4\r\n    elevation_m: 690\r\n    wind_height_m: 2.0\r\n    radiation_units: \"MJ/m2/day\"\r\n    humidity: dewpoint\r\n    network: valley-agromet\r\n"]
