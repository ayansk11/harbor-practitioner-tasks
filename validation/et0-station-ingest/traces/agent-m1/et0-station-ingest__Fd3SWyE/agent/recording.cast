[67.292654, "o", "> "]
[67.292833, "o", "        our[(row['station_id'], row['date'])] = float(row['et0_mm_day'])\r\n\u001b[?2004l\r"]
[67.29285, "o", "\u001b[?2004h"]
[67.292865, "o", "> "]
[67.292901, "o", "max_diff = 0\r\n\u001b[?2004l\r"]
[67.292922, "o", "\u001b[?2004h> "]
[67.292997, "o", "for k, v in ref.items():\r\n\u001b[?2004l\r"]
