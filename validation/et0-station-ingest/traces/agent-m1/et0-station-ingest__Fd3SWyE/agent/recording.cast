[67.291554, "i", "python3 -c \"\nimport csv\nref = {}\nwith open('/app/reference/metservice_et0_2025.csv') as f:\n    for row in csv.DictReader(f):\n        ref[(row['station_id'], row['date'])] = float(row['et0_mm_day'])\nour = {}\nwith open('/app/output/et0.csv') as f:\n    for row in csv.DictReader(f):\n        our[(row['station_id'], row['date'])] = float(row['et0_mm_day'])\nmax_diff = 0\nfor k, v in ref.items():\n    d = abs(v - our[k])\n    max_diff = max(max_diff, d)\n    if d > 0.05:\n        print(f'  {k}: ref={v} our={our[k]} diff={d:.3f}')\nprint(f'Reference rows: {len(ref)}, max abs diff: {max_diff:.4f}')\nprint(f'Total output rows: {len(our)}')\n\"\n"]
