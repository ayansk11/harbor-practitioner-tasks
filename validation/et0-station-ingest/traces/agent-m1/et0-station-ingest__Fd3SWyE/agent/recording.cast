[42.549007, "o", "def load_stations(path):\r\n\u001b[?2004l\r"]
[42.549029, "o", "\u001b[?2004h> "]
[42.549147, "o", "    with open(path, encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r"]
[42.549166, "o", "\u001b[?2004h"]
[42.549184, "o", "> "]
[42.549258, "o", "        doc = yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[42.549281, "o", "\u001b[?2004h> "]
[42.549333, "o", "    stations = []\r\n\u001b[?2004l\r"]
[42.549355, "o", "\u001b[?2004h> "]
[42.549443, "o", "    for rec in doc[\"stations\"]:\r\n\u001b[?2004l\r"]
[42.549466, "o", "\u001b[?2004h"]
[42.549487, "o", "> "]
[42.549565, "o", "        stations.append(Station(\r\n\u001b[?2004l\r"]
[42.549591, "o", "\u001b[?2004h> "]
[42.549687, "o", "            station_id=str(rec[\"id\"]),\r\n\u001b[?2004l\r"]
[42.549712, "o", "\u001b[?2004h> "]
[42.54982, "o", "            name=str(rec.get(\"name\", \"\")),\r\n\u001b[?2004l\r"]
[42.549842, "o", "\u001b[?2004h> "]
[42.549984, "o", "            latitude=parse_latitude(rec[\"latitude\"]),\r\n\u001b[?2004l\r"]
[42.550007, "o", "\u001b[?2004h> "]
[42.550134, "o", "            longitude=float(rec[\"longitude\"]),\r\n\u001b[?2004l\r"]
[42.550155, "o", "\u001b[?2004h"]
[42.550178, "o", "> "]
[42.550296, "o", "            elevation_m=float(rec[\"elevation_m\"]),\r\n\u001b[?2004l\r"]
[42.550328, "o", "\u001b[?2004h> "]
[42.550479, "o", "            wind_height_m=float(rec[\"wind_height_m\"]),\r\n\u001b[?2004l\r"]
[42.550498, "o", "\u001b[?2004h"]
[42.550519, "o", "> "]
[42.550677, "o", "            radiation_units=str(rec[\"radiation_units\"]),\r\n\u001b[?2004l\r"]
[42.550705, "o", "\u001b[?2004h> "]
[42.550825, "o", "            humidity=str(rec[\"humidity\"]),\r\n\u001b[?2004l\r"]
[42.550847, "o", "\u001b[?2004h"]
[42.550864, "o", "> "]
[42.550994, "o", "            network=str(rec.get(\"network\", \"\")),\r\n\u001b[?2004l\r"]
[42.551017, "o", "\u001b[?2004h> "]
[42.551061, "o", "        ))\r\n\u001b[?2004l\r"]
[42.551082, "o", "\u001b[?2004h"]
[42.551104, "o", "> "]
[42.551162, "o", "    return stations\r\n\u001b[?2004l\r"]
