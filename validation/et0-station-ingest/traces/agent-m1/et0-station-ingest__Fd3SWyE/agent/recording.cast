[67.292287, "o", "        ref[(row['station_id'], row['date'])] = float(row['et0_mm_day'])\r\n\u001b[?2004l\r"]
[67.292332, "o", "\u001b[?2004h> "]
[67.292357, "o", "our = {}\r\n\u001b[?2004l\r"]
[67.292375, "o", "\u001b[?2004h> "]
[67.292479, "o", "with open('/app/output/et0.csv') as f:\r\n\u001b[?2004l\r"]
[67.2925, "o", "\u001b[?2004h> "]
