[?2004hroot@aa011f43-6892-48a3-9173-349d2c218f01:/app# cat > /app/et0/meta.py << 'EOF'
[?2004l[?2004h> """Station register: read the stations YAML into Station records (fields are described in /app/docs/METHOD.md)."""
[?2004l[?2004h> from dataclasses import dataclass
[?2004l[?2004h> 
[?2004l[?2004h> import yaml
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass(frozen=True)
[?2004l[?2004h> class Station:
[?2004l[?2004h>     station_id: str
[?2004l[?2004h>     name: str
[?2004l[?2004h>     latitude: float          # decimal degrees, north positive
[?2004l[?2004h>     longitude: float
[?2004l[?2004h>     elevation_m: float
[?2004l[?2004h>     wind_height_m: float
[?2004l[?2004h>     radiation_units: str
[?2004l[?2004h>     humidity: str
[?2004l[?2004h>     network: str
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_latitude(value):
[?2004l[?2004h>     """Latitude in decimal degrees, north positive, south negative.
[?2004l[?2004h> 
[?2004l[?2004h>     The register holds plain numbers (38.42, -31.85) and, for stations imported from the synop and coast networks,
[?2004l[?2004h>     text with a hemisphere letter ("36.95N", "34.92S").
[?2004l[?2004h>     """
[?2004l[?2004h>     if isinstance(value, (int, float)):
[?2004l[?2004h>         return float(value)
[?2004l[?2004h>     text = str(value).strip().upper()
[?2004l[?2004h>     if text.endswith("S"):
[?2004l[?2004h>         return -float(text.rstrip("S"))
[?2004l[?2004h>     elif text.endswith("N"):
[?2004l[?2004h>         return float(text.rstrip("N"))
[?2004l[?2004h>     else:
[?2004l[?2004h>         return float(text)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_stations(path):
[?2004l[?2004h>     with open(path, encoding="utf-8") as f:
[?2004l[?2004h>         doc = yaml.safe_load(f)
[?2004l[?2004h>     stations = []
[?2004l[?2004h>     for rec in doc["stations"]:
[?2004l[?2004h>         stations.append(Station(
[?2004l[?2004h>             station_id=str(rec["id"]),
[?2004l[?2004h>             name=str(rec.get("name", "")),
[?2004l[?2004h>             latitude=parse_latitude(rec["latitude"]),
[?2004l[?2004h>             longitude=float(rec["longitude"]),
[?2004l[?2004h>             elevation_m=float(rec["elevation_m"]),
[?2004l[?2004h>             wind_height_m=float(rec["wind_height_m"]),
[?2004l[?2004h>             radiation_units=str(rec["radiation_units"]),
[?2004l[?2004h>             humidity=str(rec["humidity"]),
[?2004l[?2004h>             network=str(rec.get("network", "")),
[?2004l[?2004h>         ))
[?2004l[?2004h>     return stations
[?2004l[?2004h> EOF
[?2004l[?2004hroot@aa011f43-6892-48a3-9173-349d2c218f01:/app# cat > /app/et0/ingest.py << 'EOF'
[?2004l[?2004h> """Read one station's raw daily file and turn it into the standard daily inputs used by fao56.et0_daily."""
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> from . import fao56
[?2004l[?2004h> 
[?2004l[?2004h> BASE_COLUMNS = ["date", "tmax_c", "tmin_c", "wind_ms", "solar_rad"]
[?2004l[?2004h> HUMIDITY_COLUMNS = {"rh_minmax": ["rh_max_pct", "rh_min_pct"], "dewpoint": ["tdew_c"]}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def wind_speed_to_2m(uz, zw):
[?2004l[?2004h>     """Eq. 47: convert wind speed from height zw to 2 m using the logarithmic wind profile."""
[?2004l[?2004h>     return uz * 4.87 / np.log(67.8 * zw - 5.42)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_station(station, data_dir):
[?2004l[?2004h>     """Return a DataFrame with columns station_id, date, doy, tmax, tmin, ea, u2, rs (standard units)."""
[?2004l[?2004h>     path = os.path.join(data_dir, f"{station.station_id}.csv")
[?2004l[?2004h>     raw = pd.read_csv(path)
[?2004l[?2004h>     if station.humidity not in HUMIDITY_COLUMNS:
[?2004l[?2004h>         raise ValueError(f"{station.station_id}: unknown humidity type {station.humidity!r}")
[?2004l[?2004h>     missing = [c for c in BASE_COLUMNS + HUMIDITY_COLUMNS[station.humidity] if c not in raw.columns]
[?2004l[?2004h>     if missing:
[?2004l[?2004h>         raise ValueError(f"{path}: missing columns {missing}")
[?2004l[?2004h> 
[?2004l[?2004h>     dates = pd.to_datetime(raw["date"], format="%Y-%m-%d")
[?2004l[?2004h>     df = pd.DataFrame({
[?2004l[?2004h>         "station_id": station.station_id,
[?2004l[?2004h>         "date": dates.dt.strftime("%Y-%m-%d"),
[?2004l[?2004h>         "doy": dates.dt.dayofyear.astype(int),
[?2004l[?2004h>         "tmax": raw["tmax_c"].astype(float),
[?2004l[?2004h>         "tmin": raw["tmin_c"].astype(float),
[?2004l[?2004h>     })
[?2004l[?2004h>     if station.humidity == "dewpoint":
[?2004l[?2004h>         df["ea"] = fao56.actual_vapour_pressure_dewpoint(raw["tdew_c"].astype(float))
[?2004l[?2004h>     else:
[?2004l[?2004h>         df["ea"] = fao56.actual_vapour_pressure_rh(df["tmax"], df["tmin"], raw["rh_max_pct"].astype(float),
[?2004l[?2004h>                                                    raw["rh_min_pct"].astype(float))
[?2004l[?2004h>     # Convert wind speed from anemometer height to 2 m (Eq. 47)
[?2004l[?2004h>     df["u2"] = wind_speed_to_2m(raw["wind_ms"].astype(float), station.wind_height_m)
[?2004l[?2004h>     # Convert solar radiation to MJ m-2 day-1
[?2004l[?2004h>     rs = raw["solar_rad"].astype(float)
[?2004l[?2004h>     if station.radiation_units == "W/m2":
[?2004l[?2004h>         rs = rs * 0.0864
[?2004l[?2004h>     df["rs"] = rs
[?2004l[?2004h>     return df
